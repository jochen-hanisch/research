@article{pargmann_electronic_2024,
	title = {Electronic didactic assistance ({EDDA}) for lesson planning based on artificial intelligence: functionality, areas of application and research perspectives},
	volume = {38},
	issn = {09315020},
	shorttitle = {Electronic didactic assistance ({EDDA}) for lesson planning based on artificial intelligence},
	url = {https://www.vep-landau.de/produkt/empirische-paedagogik-2024-38-1-kap-6-digital/},
	doi = {10.62350/WLQO3003},
	abstract = {The use of AI systems is rapidly gaining importance both in the professional world and in vocational education and training. As a result, (prospective) teachers are required to take a closer look at AI and its application for teaching and learning processes. This article focuses on the potential of AI to assist teachers in designing lessons based on the fundamentals and functions of AI. We explore the question of how an AI-based learning platform can be designed to help develop lesson planning skills. The AI platform EDDA will be presented, which can be used to analyze lesson plans and materials during studies, in the preparatory service and in teaching practice. EDDA provides feedback on the implementation of selected didactic criteria of lesson planning and provides information for reflection and further development of lesson plans. EDDA also provides an infrastructure for further research into teaching and learning with AI.
          , 
            Der Einsatz von KI-Systemen gewinnt sowohl in der Berufswelt als auch in der Berufsbildung rasant an Bedeutung. In der Folge sind (angehende) Lehrkräfte gefordert, sich tiefergehend mit KI sowie deren Anwendung bei der Gestaltung von Lehr-Lern-Prozessen auseinanderzusetzen. Der Beitrag fokussiert auf Basis der Grundlagen und Funktionsweisen von KI die Potentiale von KI als Assistenz für Lehrkräfte bei der Unterrichtsgestaltung. Es wird der Frage nachgegangen, wie eine KI-basierte Lernplattform zur Unterstützung der Unterrichtsplanungskompetenz konzipiert werden kann. Vorgestellt wird dabei das KI-Projekt EDDA, das für die Analyse von Unterrichtsentwürfen und -materialien im Studium, im Vorbereitungsdienst und in der schulischen Berufstätigkeit eingesetzt werden kann. EDDA stellt Rückmeldungen zur Umsetzung ausgewählter didaktischer Merkmale der Unterrichtsplanung bereit und liefert Hinweise zur Reflexion und Weiterentwicklung der Entwürfe. Zudem bietet EDDA eine Infrastruktur für weitere Forschungen zum Lehren und Lernen mit KI.},
	language = {de-DE},
	number = {1},
	urldate = {2024-07-31},
	journal = {Empirische Pädagogik},
	author = {Pargmann, Julia and Leube, Anna and Berding, Florian and Riebenbauer, Elisabeth and Rebmann, Karin and Slopinski, Andreas and Gillert, Michael},
	month = jun,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Promotion:Relevanz:4, Promotion:Weiterführung, Promotion:FU3, \#2:Zeitschriftenartikel:online:Lernplattform, Promotion:S:11 Online Learning, Promotion:S:02 Online-Lernplattform, Promotion:Literaturverzeichnis},
	pages = {118--146},
	annote = {Analyse des Artikels „Die elektronisch-didaktische Assistenz (EDDA) zur Unterrichtsplanung auf Basis künstlicher Intelligenz: Funktionsweise, Anwendungsbereiche und Forschungsperspektiven“ von Pargmann et al. (2024).
1. Analyse
Hauptthemen und Ziele der Forschung
Der Artikel von Pargmann et al. (2024) untersucht das Potenzial der elektronisch-didaktischen Assistenz (EDDA), einem KI-basierten System, das Lehrkräfte bei der Unterrichtsplanung unterstützt. Das Hauptziel der Studie ist es, zu zeigen, wie EDDA dazu beitragen kann, die professionelle Kompetenz von Lehrkräften zu fördern, indem es wissenschaftlich fundiertes Feedback zur Qualität von Unterrichtsentwürfen und -materialien bietet.
Methoden und Datenquellen


Methoden: Der Artikel beschreibt die Entwicklung und Anwendung der EDDA-Plattform, die auf KI-gestütztem Natural Language Processing (NLP) basiert. EDDA nutzt ein BERT-Modell, das mit 5.983 Trainingsdatensätzen aus Unterrichtsentwürfen und -materialien trainiert wurde. Es bewertet den Erfüllungsgrad von 57 didaktischen Kriterien in Unterrichtsplanungen.


Datenquellen: Die Daten stammen aus Studien zu Unterrichtsentwürfen und Lehrmaterialien, einschließlich 884 Unterrichtsentwürfen, 420 Materialien aus Anhängen und 4.679 Schulbuchaufgaben.


Zentrale Forschungsergebnisse


Verbesserung der Unterrichtsqualität: EDDA bietet fundierte Rückmeldungen, die zur Weiterentwicklung von Unterrichtsentwürfen genutzt werden können, und unterstützt die Professionalisierung von Lehrkräften.


Integration von wissenschaftlichen Modellen: Die Plattform fördert die Verbindung zwischen wissenschaftlichen Modellen und der praktischen Unterrichtsplanung, was zur Verbesserung der Lehrqualität beiträgt.


Unterstützung in der Lehrkräftebildung: EDDA kann in allen Phasen der Lehrkräftebildung eingesetzt werden, um die Planungskompetenz von Lehrkräften zu verbessern.


2. Zusammenfassung
Die Studie stellt die elektronische didaktische Assistenz EDDA vor, die Lehrkräfte bei der Unterrichtsplanung unterstützt, indem sie wissenschaftlich fundierte Rückmeldungen zu didaktischen Merkmalen von Unterrichtsentwürfen bietet. Die Plattform nutzt ein BERT-Modell, das auf einer Vielzahl von Daten trainiert wurde, um den Erfüllungsgrad von 57 didaktischen Kriterien zu bewerten. EDDA zeigt Potenzial, die professionelle Kompetenz von Lehrkräften zu fördern und die Verbindung zwischen wissenschaftlichen Modellen und der Unterrichtspraxis zu stärken.
3. Kernaussagen


Verbesserung der Unterrichtsqualität: EDDA bietet fundierte Rückmeldungen zur Unterrichtsplanung, die zur Verbesserung der Lehrqualität beitragen können. (S. 120)


Wissenschaftliche Fundierung: Die Plattform nutzt wissenschaftliche Modelle, um fundierte Empfehlungen zur Unterrichtsplanung zu geben. (S. 127)


Anwendbarkeit in der Lehrkräftebildung: EDDA kann in verschiedenen Phasen der Lehrkräftebildung eingesetzt werden, um die Planungskompetenz zu stärken. (S. 140)


4. Argumentationslinien
Die Autoren argumentieren, dass EDDA als KI-basierte Assistenzplattform Lehrkräfte in ihrer professionellen Entwicklung unterstützen kann, indem sie wissenschaftlich fundierte Rückmeldungen zu Unterrichtsentwürfen bietet. Die Plattform fördert die Verbindung zwischen Theorie und Praxis, indem sie die Planungskompetenz von Lehrkräften stärkt und die Qualität der Unterrichtsplanung verbessert. EDDA bietet eine Infrastruktur für zukünftige Forschungen im Bereich des Lehrens und Lernens mit KI. (S. 140-142)
5. Verschlagwortung


Technologieintegration: Die Studie untersucht die Integration von KI-gestützter Technologie in den Unterrichtsplanungsprozess.


Lehr- und Lerneffektivität: Die Plattform zielt darauf ab, die Qualität der Unterrichtsplanung und damit die Effektivität des Lehrens und Lernens zu verbessern.


Forschungsansätze: Die Studie bietet Einblicke in die Entwicklung und Anwendung von KI-gestützten Assistenzsystemen in der Bildung.


6. Kategorisierung


Kerngedanke: Die Studie untersucht, wie eine KI-basierte Assistenzplattform die Unterrichtsplanung verbessern kann, indem sie wissenschaftlich fundierte Rückmeldungen zur Verfügung stellt und die Verbindung zwischen Theorie und Praxis stärkt. (S. 141)


7. Zuordnung zu Forschungsfragen


FU3: Wie sind Konzeption und relevante didaktische und bildungstechnologische Merkmale des systemisch-konstruktivistischen Learning-Management-Systems für Akteure im digitalen Bildungsraum von Gesundheitsberufen dargestellt?


Begründung: Die Studie untersucht die Konzeption und Anwendung einer KI-basierten Plattform zur Verbesserung der Unterrichtsplanung, die in verschiedenen Bildungskontexten relevant sein könnte.




8. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 4 (Die Studie bietet wichtige Einblicke in die Anwendung von KI zur Unterstützung der Unterrichtsplanung).


Zitierhäufigkeit und Einfluss: 3 (Die Studie ist eine neue Untersuchung, deren Einfluss sich noch entwickeln muss).


Aktualität: 5 (Die Studie ist aktuell und behandelt ein relevantes Thema in der Bildungstechnologie).


Gesamtbewertung: 4.0
Die Studie von Pargmann et al. (2024) zeigt das Potenzial der EDDA-Plattform, die Unterrichtsplanung durch KI-gestützte Rückmeldungen zu verbessern und die professionelle Kompetenz von Lehrkräften zu fördern. Die Verbindung von wissenschaftlichen Modellen und praktischer Anwendung wird als wesentlicher Beitrag zur Verbesserung der Lehrqualität angesehen.
},
	file = {Pargmann et al. - 2024 - Electronic didactic assistance (EDDA) for lesson p.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/XWUJ9QCH/Pargmann et al. - 2024 - Electronic didactic assistance (EDDA) for lesson p.pdf:application/pdf},
}

