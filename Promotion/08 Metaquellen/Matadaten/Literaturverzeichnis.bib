@inproceedings{koh_value_2023,
	title = {Value and {Challenges} in {Using} a {Collaborative} {Critical} {Reading} and {Learning} {Analytics} {System}: {A} {Cross}-{Case} {Analysis} of {Two} {High} {Schools}},
	shorttitle = {Value and {Challenges} in {Using} a {Collaborative} {Critical} {Reading} and {Learning} {Analytics} {System}},
	url = {https://repository.isls.org/handle/1/9201},
	doi = {10.22318/cscl2023.869864},
	abstract = {WiREAD+ is an augmented web-based collaborative critical reading and learning analytics environment that was developed to scaffold and engage students in collaborative dialogue around online texts. This paper reports on the trial of WiREAD+ for Grade 9 students in two high schools – School 1 (S1) with prior experience and School 2 (S2) that was new to the intervention design. We report on a cross-case analysis of the two schools, focusing on perceived ease of use and usefulness for learning, and reflect on the value and challenges of enacting WiREAD+ across schools of varying prior experience. Drawing from the findings of this cross-case analysis, we consider how we can support the wider adoption and deployment of the system across schools and settings by highlighting obstacles that new participants who might trial such new learning analytics systems might face.},
	language = {en-GB},
	urldate = {2023-12-30},
	booktitle = {Value and challenges in using a collaborative critical reading and learning analytics system: {A} cross-case analysis of two high schools},
	author = {Koh, Elizabeth and Jonathan, Christin and Lim, Fei Victor and Kadir, Munirah and Tan, Jennifer Pei-Ling},
	month = oct,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Promotion:FU2a, Promotion:Relevanz:4, Leraning:Analytics, \#b:Konferenz-Paper:online:learning, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU2a},
	pages = {233--236},
	annote = {Analyse der Studie "Value and Challenges in Using a Collaborative Critical Reading and Learning Analytics System: A Cross-Case Analysis of Two High Schools" von Elizabeth Koh, Christin Jonathan, Fei Victor Lim, Munirah Kadir und Jennifer Pei-Ling Tan
1. Analyse
Hauptthemen und Ziele der Forschung:
Die Studie von Elizabeth Koh und Kollegen (2023) untersucht den Nutzen und die Herausforderungen der Verwendung von WiREAD+, einem kollaborativen kritischen Lesesystem, das durch Lernanalytik unterstützt wird. Ziel ist es, die Wahrnehmungen der Benutzerfreundlichkeit und Nützlichkeit des Systems in zwei Schulen zu vergleichen und die Barrieren sowie die Vorteile der Implementierung in unterschiedlichen Bildungskontexten zu identifizieren. Das System soll den Aufbau von Wissen durch Zusammenarbeit und kritisches Denken bei Schülern fördern​.
Methoden und Datenquellen:


Methoden: Die Studie verwendet einen Mixed-Methods-Ansatz, der sowohl quantitative als auch qualitative Daten umfasst. Die quantitative Datenanalyse basierte auf Umfragen, die vor und nach der Einführung des Systems durchgeführt wurden, um die wahrgenommene Benutzerfreundlichkeit und Nützlichkeit zu messen. Die qualitative Analyse umfasste Fokusgruppendiskussionen und Interviews mit Schülern und Lehrern, um tiefere Einblicke in die Nutzungserfahrungen zu gewinnen​.


Datenquellen: Die Untersuchung wurde in zwei Schulen durchgeführt: School 1 (S1), die bereits Erfahrungen mit dem System hatte, und School 2 (S2), die neu in der Nutzung von WiREAD+ war. Insgesamt nahmen 280 Schüler und 8 Lehrer an der Studie teil​.


Zentrale Forschungsergebnisse:


Unterschiede in der Benutzerfreundlichkeit und Nützlichkeit: Schüler in S1 berichteten über eine höhere Benutzerfreundlichkeit und Nützlichkeit von WiREAD+ im Vergleich zu S2. Die Vertrautheit mit dem System und die längere Unterrichtszeit in S1 trugen zu diesen Unterschieden bei​.


Kritisches Denken und Zusammenarbeit: Beide Schulen erkannten den Wert des Systems für den Aufbau von Wissen durch Zusammenarbeit und die Förderung des kritischen Denkens. Das Tagging-System von WiREAD+ half den Schülern, ihre Gedanken zu organisieren und ihre kritischen Lesefähigkeiten zu verbessern​.


Herausforderungen bei der Einführung: In S2 traten technische Schwierigkeiten und Verständnisprobleme bei der Nutzung der Tags auf, was zu einer geringeren Wirksamkeit des Systems führte. Die Schüler benötigten mehr Unterstützung durch Lehrer, um das volle Potenzial des Systems auszuschöpfen​.


2. Zusammenfassung
Die Studie untersucht die Implementierung und Wirkung von WiREAD+, einem kollaborativen kritischen Lesesystem, an zwei Schulen. Die Ergebnisse zeigen, dass das System das kollaborative Lernen und kritische Denken der Schüler fördert, jedoch initiale technische und konzeptionelle Herausforderungen bestehen. Schüler in Schulen mit vorheriger Erfahrung und längerer Nutzung des Systems berichteten über eine höhere Benutzerfreundlichkeit und Nützlichkeit​.
3. Kernaussagen


Nutzen von WiREAD+: Das System fördert das kritische Denken und die Zusammenarbeit unter den Schülern und verbessert ihre Fähigkeit, Informationen zu organisieren und zu analysieren​.


Herausforderungen: Technische und konzeptionelle Herausforderungen können die Effektivität des Systems beeinträchtigen, insbesondere in Schulen ohne vorherige Erfahrungen​.


Wichtigkeit der Unterstützung: Die Rolle der Lehrer ist entscheidend, um Schülern zu helfen, die Herausforderungen der Nutzung neuer Systeme zu überwinden​.


4. Argumentationslinien
Die Autoren argumentieren, dass WiREAD+ eine effektive Plattform zur Förderung des kritischen Denkens und der Zusammenarbeit darstellt, jedoch eine angemessene Einführung und Unterstützung erforderlich ist, um die Herausforderungen der Implementierung zu überwinden. Sie betonen die Bedeutung von Lehrerschulungen und der Anpassung des Systems an die spezifischen Bedürfnisse der Schulen, um den maximalen Nutzen zu erzielen​.
5. Verschlagwortung


Kollaboratives Lernen: Untersuchung der Auswirkungen von WiREAD+ auf die Zusammenarbeit und das kritische Denken der Schüler.


Technologieintegration: Analyse der Nutzung von WiREAD+ als technologische Plattform zur Unterstützung des Lernens.


Lehr- und Lerneffektivität: Bewertung der Wirksamkeit von WiREAD+ zur Verbesserung der Lernprozesse.


6. Kategorisierung


Kerngedanke: Die Studie hebt hervor, dass WiREAD+ eine effektive Methode zur Förderung des kritischen Denkens und der Zusammenarbeit ist, erfordert jedoch eine angemessene Unterstützung und Einführung, um Herausforderungen zu überwinden​.


7. Zuordnung zu Forschungsfragen
Passendste Forschungsunterfrage:


FU2a: Welchen Effekt erläutern Lernende im digitalen Bildungsraum von Gesundheitsberufen bei der Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems?


Begründung: Die Untersuchung der Auswirkungen von WiREAD+ auf kritisches Denken und Zusammenarbeit liefert wertvolle Erkenntnisse für die Analyse der Wirkung von LMS im Bildungsbereich​.




8. Einordnung der Relevanz, Bewertungsskala


Relevanzbewertung: 4 - Relevant: Die Quelle liefert wichtige Informationen über die Implementierung und Nutzung von LMS zur Förderung des kritischen Denkens und der Zusammenarbeit.


},
	file = {Koh et al. - 2023 - Value and Challenges in Using a Collaborative Crit.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/3U2DXPVE/Koh et al. - 2023 - Value and Challenges in Using a Collaborative Crit.pdf:application/pdf},
}

@article{kusriani_needs_2024,
	title = {The needs for teaching media development physical education sports health (pjok) with an interactive e-book for primary school students},
	abstract = {This research aimed to determine the feasibility and the needs for developing digital-based teaching media in elementary schools, as an alternative teaching media in implementing physical education, sports, and health (PJOK) learning for Phase B students at SDN 13 Sitiung. This development was relevant to students’ learning needs in which students can utilize digital technology in the PJOK learning process. The presence of this interactive e-book is hoped to increase motivation and student learning outcomes and provide changes in the PJOK learning process which should be adapted to the learning needs of students and the digital era.},
	language = {en-GB},
	author = {Kusriani, Andri and Dewi, Muharika},
