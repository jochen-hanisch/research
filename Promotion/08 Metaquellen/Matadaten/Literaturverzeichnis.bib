@article{anselmann_lernfabriken_2022,
	title = {Lernfabriken als neuer {Lernraum} in der beruflichen {Bildung} – {Sachstandsanalyse} und {Potentiale}},
	issn = {1618-8543},
	shorttitle = {Lernfabriken als neuer {Lernraum} in der beruflichen {Bildung}},
	url = {https://www.bwpat.de/ausgabe/43/anselmann-etal},
	abstract = {Lernfabriken fungieren als komplexe Simulationen von realen Arbeits- und Produktionsabläufen, um insbesondere berufliche Handlungskompetenzen in einer „Industrie 4.0 typischen“ Facharbeit entwickeln zu können. Dabei stellen sie selbst cyberphysische Systeme dar, die an beruflichen Schulen zugleich als traditioneller Lernraum (Lernlabor) und virtueller/digitaler Lernraum zu gestalten sind („digitaler Zwilling“). Der für „digitales Lernen“ typischen räumlichen und zeitlichen Entgrenzung kann zunächst nicht entsprochen werden. Gleichwohl machen sie die Digitalität der veränderten Arbeitswelt zum Gegenstand beruflicher Lernprozesse. Dieser Beitrag reflektiert zunächst Lernfabriken als neuen Lernraum und den Anteil cyberphysischer Systeme darin. Anschließend werden anhand erster Ergebnisse einer empirischen Studie der erreichte Stand in der Implementierung und Konzeptentwicklung der beruflichen Lernfabriken an berufsbildenden Schulen in Süddeutschland aufgezeigt.},
	language = {de-DE},
	number = {43},
	urldate = {2023-02-20},
	journal = {Berufs- und Wirtschaftspädagogik - online},
	author = {Anselmann, Sebastian and Windelband, Lars and Faßhauer, Uwe},
	editor = {Büchter, Karin and Wilbers, Karl and Windelband, Lars and Gössling, Bernd},
	month = dec,
	year = {2022},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Technologieintegration, Systemanpassung, Promotion:Argumentation, Bildung, Multimedia, Promotion:FU3, Innovation, Schulentwicklung, \#9:Zeitschriftenartikel:digital:lernen, Lernfabrik, Promotion:S:09 Digital Lernen, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	annote = {Forschungsfragen
Hauptforschungsfrage Wie ist das Wirkgefüge des angewendeten Learning-Management-Systems auf Akteure im digitalen Bildungsraum von Gesundheitsberufen gestaltet?
Zuordnung der Quelle zu den passenden Forschungsfragen


FU1: Welche Akzeptanz und Nützlichkeit (Bedeutung) beschreiben Akteure im digitalen Bildungsraum von Gesundheitsberufen bei Anwendung eines Learning-Management-Systems?


Zuordnung: Die Untersuchung der Akzeptanz und Nützlichkeit von Lernfabriken in der beruflichen Bildung durch Lehrkräfte und Lernende zeigt auf, wie digitale Bildungsräume angenommen werden. Die Studie beschreibt die Integration und Nutzungshäufigkeit der Lernfabriken und die damit verbundenen Herausforderungen und Erfolge.


Zitat: "Die befragten beruflichen Schulen mit Lernfabrik 4.0 zeigen ein heterogenes Bild hinsichtlich (a) ihrer Größe, (b) der involvierten Abteilungen sowie (c) ihrer Personalentwicklung und Fortbildung." (S. 14).




FU2a: Welchen Effekt erläutern Lernende im digitalen Bildungsraum von Gesundheitsberufen bei der Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems?


Zuordnung: Die Ergebnisse zur Anwendung und Effektivität von Lernfabriken, insbesondere im Hinblick auf die Entwicklung von Fach- und Prozesskompetenzen, können auf die Wirkung von LMS auf Lernende übertragen werden. Hier werden die spezifischen Erfahrungen und Lernfortschritte der Teilnehmenden beschrieben.


Zitat: "Dabei stehen nicht nur die primär zu entwickelnden Fachkompetenzen im Umgang mit bestimmten Arbeitsaufgaben und der Umgang mit Arbeitsgegenständen im Vordergrund, sondern auch die Ausbildung und Aneignung u.a. der Teamkompetenz in der Zusammenarbeit in der Lernfabrik" (S. 2).




FU2b: Welche Effekt-Faktoren erläutern Lehrende im digitalen Bildungsraum von Gesundheitsberufen bei der Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems?


Zuordnung: Die Lehrenden beschreiben die Herausforderungen und positiven Effekte der Nutzung von Lernfabriken. Diese Faktoren können auch auf die Anwendung eines LMS übertragen werden, indem sie die didaktischen und methodischen Aspekte der Lehr- und Lernszenarien beleuchten.


Zitat: "Die Umsetzung und Anwendung von Lernfabriken stellt eine Herausforderung dar, besonders hinsichtlich der didaktischen Gestaltung und Integration in den Unterricht" (S. 20).




FU3: Wie sind Konzeption und relevante didaktische und bildungstechnologische Merkmale des systemisch-konstruktivistischen Learning-Management-Systems für Akteure im digitalen Bildungsraum von Gesundheitsberufen dargestellt?


