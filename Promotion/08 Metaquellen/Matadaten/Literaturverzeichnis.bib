@incollection{sud_k-means_2020,
	title = {The {K}-{Means} {Algorithm} {Evolution}},
	copyright = {https://creativecommons.org/licenses/by/3.0/legalcode},
	isbn = {978-1-83880-333-9 978-1-83880-334-6},
	url = {https://www.intechopen.com/books/introduction-to-data-science-and-machine-learning/the-em-k-em-means-algorithm-evolution},
	doi = {10.5772/intechopen.85447},
	abstract = {Clustering is one of the main methods for getting insight on the underlying nature and structure of data. The purpose of clustering is organizing a set of data into clusters, such that the elements in each cluster are similar and different from those in other clusters. One of the most used clustering algorithms presently is K-means, because of its easiness for interpreting its results and implementation. The solution to the K-means clustering problem is NP-hard, which justifies the use of heuristic methods for its solution. To date, a large number of improvements to the algorithm have been proposed, of which the most relevant were selected using systematic review methodology. As a result, 1125 documents on improvements were retrieved, and 79 were left after applying inclusion and exclusion criteria. The improvements selected were classified and summarized according to the algorithm steps: initialization, classification, centroid calculation, and convergence. It is remarkable that some of the most successful algorithm variants were found. Some articles on trends in recent years were included, concerning K-means improvements and its use in other areas. Finally, it is considered that the main improvements may inspire the development of new heuristics for K-means or other clustering algorithms.},
	language = {en},
	urldate = {2024-12-18},
	booktitle = {Introduction to {Data} {Science} and {Machine} {Learning}},
	publisher = {IntechOpen},
	author = {Pérez-Ortega, Joaquín and Nely Almanza-Ortega, Nelva and Vega-Villalobos, Andrea and Pazos-Rangel, Rodolfo and Zavala-Díaz, Crispín and Martínez-Rebollar, Alicia},
	editor = {Sud, Keshav and Erdogmus, Pakize and Kadry, Seifedine},
	month = mar,
	year = {2020},
	keywords = {Promotion:Ausschluss, \#5:Buchteil:e-learning, Methodologie, Promotion:04-04:4.4.4, Promotion:01-04 Analysemodell, Promotion:4.4.4 Dreidimenionale Clusteranalyse, Promotion:Literaturverzeichnis, Promotion:sec:mdaCV, Promotion:sec:Datenanalyse-Synthese, Promotion:chap:04-04},
	annote = {Analyse der Quelle: Pérez-Ortega et al. (2020): The K-Means Algorithm Evolution

1. Analyse
Hauptthemen und Ziele der Forschung
Die Forschungsarbeit analysiert die Entwicklung und Verbesserung des K-Means-Algorithmus im Bereich der Clusteranalyse. Ziel ist es, eine systematische Klassifikation von algorithmischen Verbesserungen zu liefern, die sich auf die vier Hauptschritte des K-Means-Verfahrens beziehen: Initialisierung, Klassifikation, Zentroidberechnung und Konvergenz.
Methoden und Datenquellen


Methodik: Systematische Literaturrecherche in vier renommierten Datenbanken (Springer Link, ACM, IEEE Xplore, ScienceDirect).


Datengrundlage: 1125 Artikel wurden identifiziert, 79 blieben nach Anwendung klar definierter Ein- und Ausschlusskriterien übrig (z. B. Sprache, Plagiate, Zitationshäufigkeit, Relevanz).


Zentrale Forschungsergebnisse


Initialisierung ist der häufigste Fokus von Verbesserungsarbeiten (38 Artikel), da die Anfangsbedingungen erheblichen Einfluss auf die Ergebnisqualität haben.


Klassifikation (33 Artikel) wurde insbesondere hinsichtlich Rechenaufwand optimiert.


Konvergenz wurde wenig untersucht, obwohl einige vielversprechende Heuristiken vorgestellt wurden, etwa zur frühzeitigen Beendigung des Algorithmus bei minimalen Verbesserungen.



2. Zusammenfassung
Die Arbeit untersucht die historische Entwicklung und algorithmische Optimierung des K-Means-Algorithmus durch eine systematische Literaturrecherche. Die Verbesserungen wurden nach Verfahrensschritt kategorisiert. Am meisten Aufmerksamkeit erhielten Initialisierungsstrategien, z. B. durch verbesserte Startpunktwahl. Der Beitrag bietet eine strukturierte Übersicht über 79 relevante Artikel und hebt aktuelle Forschungstrends wie parallele Implementierungen und neue Anwendungsfelder (z. B. Textanalyse) hervor.

3. Kernaussagen (mit Seitenangaben)


K-Means ist NP-schwer, weshalb Heuristiken notwendig sind (S. 2).


Die vier zentralen Schritte des Algorithmus sind Initialisierung, Klassifikation, Zentroidberechnung und Konvergenz (S. 6, Figure 1).


Die Initialisierung ist der kritischste Schritt für die Ergebnisqualität (S. 9).


Die Klassifikation ist der rechentechnisch aufwendigste Schritt (S. 11).


Nur wenige Arbeiten befassen sich mit Konvergenz, obwohl neue Heuristiken den Ressourcenverbrauch senken können (S. 13).


Neue Trends sind parallele Implementierungen und Anwendungen im Bereich natürlicher Sprache (S. 14).



4. Argumentationslinien


Die Autor*innen zeigen, dass K-Means als eine Familie von Algorithmen betrachtet werden kann (S. 3).


Aufgrund der NP-Schwere sind effiziente Heuristiken erforderlich; die Forschung konzentriert sich daher auf Optimierungen der Einzelschritte (S. 3–5).


Eine systematische Literaturrecherche ermöglicht es, gezielt Verbesserungen je Verfahrensschritt zu kategorisieren und vergleichbar zu machen (S. 8).


Durch die Einteilung in verschiedene Verbesserungsklassen (Initialisierung, Klassifikation, Konvergenz etc.) wird eine praxisorientierte Weiterverwendung möglich (S. 9–13).


Der Beitrag schließt mit einer kritischen Einordnung und Zukunftsperspektive zu neuen Anwendungsfeldern und parallelen Implementierungen (S. 14–15).



5. Verschlagwortung




Schlagwort


Begründung




Systemanpassung


Die Arbeit klassifiziert zahlreiche algorithmische Verbesserungen im Hinblick auf spezifische Problemstellungen und skaliert K-Means für große Datenmengen.




Forschungsansätze


Systematische Literaturrecherche mit klar definierten Kriterien, Kategorisierung algorithmischer Verbesserungen.




Technologieintegration


Bezüge zu Implementierungen in Weka, SPSS, Python, R und parallele Umsetzungen via MapReduce.




Lernsystemarchitektur


In der Perspektive übertragbar auf Cluster-Analysen in adaptiven Lernsystemen zur Gruppenerkennung und Personalisierung.




Bewertungsmethoden


Die Studie enthält umfassende Kriterien zur Bewertung von Verbesserungen: Rechenaufwand, Genauigkeit, Stabilität.





6. Kategorisierung
Kategorie: ForschungsansätzeBegründung: Der Text bietet eine methodologisch fundierte, systematische Literaturanalyse und Klassifikation algorithmischer Weiterentwicklungen in einem spezifischen Anwendungsfeld. Dies dient der Generierung neuer Forschungsstrategien zur Optimierung datenbasierter Prozesse.

7. Zuordnung zu Forschungsfrage
Zuordnung: FU7Forschungsunterfrage: Welche Inputs und Strategien werden als Erweiterung von Kausalgesetzen bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems durch Akteure im digitalen Bildungsraum von Gesundheitsberufen abgeleitet?
Begründung: Die Quelle stellt ein Paradigma algorithmischer Verbesserung durch systematische Strategien vor, das methodisch auf Kausalzusammenhänge und Optimierungsmechanismen übertragbar ist. Diese Denkfigur ist für FU7 besonders relevant, da sie aufzeigt, wie Optimierungsstrategien aus Analyse bestehender Performanzmuster abgeleitet werden können – auch über das konkrete Feld der Clusteranalyse hinaus.

8. Relevanzbewertung
Relevanz: 3 – Mittelmäßig relevantBegründung: Die Quelle bietet wertvolle methodische Einblicke in systematische Verbesserungsverfahren, ist aber nicht unmittelbar auf Bildungsmanagementsysteme bezogen. Ihre Relevanz ergibt sich aus der Übertragbarkeit der Methoden auf algorithmische Optimierungsprozesse in digitalen Lernsystemen.

[Eingabe]
},
	file = {Pérez-Ortega et al. - 2020 - The K -Means Algorithm Evolution:/Users/jochenhanisch-johannsen/Zotero/storage/7XJCGH6K/Pérez-Ortega et al. - 2020 - The K -Means Algorithm Evolution.pdf:application/pdf},
}

@incollection{smith_infofit_2025,
	address = {Cham},
	title = {{InfoFit} and {Beyond}: {AI} {Chatbots} as {EdTech} {Tools} for {Self}-{Regulated} {Learning} in {MOOCs}},
	volume = {15807},
	isbn = {978-3-031-93566-4 978-3-031-93567-1},
	shorttitle = {{InfoFit} and {Beyond}},
	url = {https://link.springer.com/10.1007/978-3-031-93567-1_4},
	doi = {10.1007/978-3-031-93567-1_4},
	abstract = {Massive Open Online Courses (MOOCs) have become essential for the democratization of education by providing accessible learning opportunities to broad audiences. However, their asynchronous and open structure is challenging for learning, especially in terms of maintaining engagement, and self-regulated learning (SRL) is necessary. This study investigates the integration of a retrieval-augmented-generation (RAG) chatbot into a MOOC and uses generative AI (genAI) to enhance learners’ SRL processes. The chatbot is based on Zimmermann’s SRL framework and is prepared for the MOOC content, basics of computer science. It is designed to support learners in the forethought, performance, and self-reﬂection phases by providing concise, context-speciﬁc responses. A mixed-method evaluation with 79 participants revealed high levels of satisfaction, with over 98\% of respondents recommending the chatbot for future courses. The chatbot proved eﬀective in supporting tasks such as summarization and concept clariﬁcation; however, its role in maintaining motivation emerged as a key area for further investigation. These ﬁndings underscore the transformative potential of AI chatbots in asynchronous learning environments, while also highlighting the importance of incorporating multimodal and motivational features to maximize educational technology (EdTech) impact.},
	language = {en},
	urldate = {2025-06-05},
	booktitle = {Learning and {Collaboration} {Technologies}},
	publisher = {Springer Nature Switzerland},
	author = {Brünner, Benedikt and Ebner, Martin},
	editor = {Smith, Brian K. and Borge, Marcela},
	year = {2025},
	note = {Series Title: Lecture Notes in Computer Science},
	keywords = {Promotion:Literaturanalyse, \#4:Buchteil:MOOC, Promotion:S:04 MOOC, Promotion:Literaturverzeichnis},
	pages = {45--60},
	file = {Brünner und Ebner - 2025 - InfoFit and Beyond AI Chatbots as EdTech Tools for Self-Regulated Learning in MOOCs:/Users/jochenhanisch-johannsen/Zotero/storage/A9Q7C6LY/Brünner und Ebner - 2025 - InfoFit and Beyond AI Chatbots as EdTech Tools for Self-Regulated Learning in MOOCs.pdf:application/pdf},
