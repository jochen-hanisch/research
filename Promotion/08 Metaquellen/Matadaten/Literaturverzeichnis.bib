  keywords = {0:Zeitschriftenartikel:digital:learning,Charité:Promotion,Datenschutz und IT-Sicherheit,Krisenreaktion im Bildungsbereich,Lehr- und Lerneffektivität,Lernsystemarchitektur,Promotion:Argumentation,Promotion:FU5,Promotion:Literaturanalyse,Promotion:Relevanz:5,Promotion:S:12 Digital Learning,Systemanpassung,Technologieintegration},
