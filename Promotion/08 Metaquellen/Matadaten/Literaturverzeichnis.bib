@article{gicheru_identifying_2023,
	title = {Identifying the need to institutionalize digital equity among faculty: the experience of the {Kenya} {Medical} {Training} {College}},
	volume = {8},
	issn = {2504-284X},
	shorttitle = {Identifying the need to institutionalize digital equity among faculty},
	url = {https://www.frontiersin.org/articles/10.3389/feduc.2023.1252842/full},
	doi = {10.3389/feduc.2023.1252842},
	abstract = {Background: The use of digital tools and applications in health professions education is increasing exponentially, however this has the potential to increase the digital inequities with the resulting effect of vulnerable groups facing an increased risk of digital exclusion. It is therefore important to approach digitalization with contextual determinants of the intended and unintended impact in mind. We present a perspective paper on digital equity, informed by lessons learnt at the Kenya Medical Training College (KMTC).
Methods: Using a case description methodology, we examined routine educational data collected from faculty at KMTC in November 2022. This included quantitative and qualitative data on access, ownership, utilization, confidence and skills to create, share, and exchange knowledge on the institution’s learning management system. We used these factors as the conceptual framework for understanding how faculty adopt digitalization in health professions education.
Results: 306 faculty responded to the survey (response rate 27.8\%) of whom 90.8 and 75.2\% had personal laptops at home and at work and 75.9\% had internet at work. 53.4\% (n  =  163) knew they had accounts created on the institution’s learning management system (LMS) majority of whom had basic skills and were able to perform skills such as logging in and accessing learning resources. However, a minority had advanced skills needed for teaching and learning in the LMS.
Conclusion: Medical education institutions in LMICs need to adopt programs to enhance digital literacy and monitoring of access, utilization and self-efficacy across all learner and faculty groups, to ensure that digital technologies reduce rather than exacerbate existing inequities.},
	language = {en-GB},
	urldate = {2024-06-28},
	journal = {Frontiers in Education},
	author = {Gicheru, Wagaki and Mwangi, Nyawira},
	month = nov,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Promotion:Kerngedanke, Promotion:Relevanz:4, Promotion:FU5, \#1:Zeitschriftenartikel:learning:management:system, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {1252842},
	annote = {Analyse des Artikels "Identifying the need to institutionalize digital equity among faculty: the experience of the Kenya Medical Training College" von Wagaki Gicheru und Nyawira Mwangi (2023)
1. Analyse
Hauptthemen und -ziele der Forschung: Der Artikel untersucht die Notwendigkeit, digitale Chancengleichheit unter den Lehrkräften am Kenya Medical Training College (KMTC) zu institutionalisieren. Ziel ist es, die digitalen Ungleichheiten zu identifizieren und Strategien zur Verbesserung der digitalen Kompetenzen und des Zugangs zu digitalen Ressourcen zu entwickeln.
Verwendete Methoden und Datenquellen:


Methodische Ansätze: Fallstudienbeschreibung und quantitative sowie qualitative Analyse von Daten, die im Rahmen einer Bedarfsanalyse der Lehrkräfte am KMTC im März 2023 erhoben wurden.


Werkzeuge und Datenquellen: Online-Umfrage, die über Google Forms an 1.100 Lehrkräfte verschickt wurde. Die Umfrage umfasste Fragen zu Geräten, Zugang zum Learning Management System (LMS) und den digitalen Fähigkeiten der Lehrkräfte.


Zentrale Forschungsergebnisse:


Digitale Ausstattung und Zugang: 90,8\% der Lehrkräfte besitzen persönliche Laptops, 75,2\% haben Zugang zu Computern und 75,9\% haben Internetzugang am Arbeitsplatz. Nur 53,4\% wussten, dass sie ein Konto im LMS haben.


Digitale Fähigkeiten: Die Mehrheit der Lehrkräfte verfügt über grundlegende Fähigkeiten im Umgang mit dem LMS, wie das Einloggen und den Zugang zu Lernressourcen. Fortgeschrittene Fähigkeiten, die für das Lehren und Lernen im LMS notwendig sind, sind jedoch gering. Nur 15\% der Lehrkräfte haben moderate bis hohe Zuversicht in ihre Fähigkeiten.


Herausforderungen: Die größten Herausforderungen für die Lehrkräfte waren Infrastruktur (54,9\%), digitale Fähigkeiten (32\%) und Schulungen (9,2\%).


2. Zusammenfassung
Kernpunkte des Artikels:


Problemstellung: Identifizierung der digitalen Ungleichheiten unter den Lehrkräften am KMTC und Entwicklung von Strategien zur Verbesserung der digitalen Kompetenzen und des Zugangs zu digitalen Ressourcen.


Methodik: Fallstudienbeschreibung und Analyse von Daten einer Online-Umfrage unter 1.100 Lehrkräften.


Hauptergebnisse: Hohe Besitzrate von Laptops und Internetzugang, aber geringe Nutzung fortgeschrittener digitaler Fähigkeiten und LMS-Funktionen. Notwendigkeit von Schulungen und Infrastrukturverbesserungen.


Schlussfolgerungen: Die Ergebnisse zeigen die Notwendigkeit, digitale Chancengleichheit zu institutionalisieren, um sicherzustellen, dass digitale Technologien bestehende Ungleichheiten nicht verschärfen.


