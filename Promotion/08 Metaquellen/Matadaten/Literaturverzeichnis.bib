@incollection{grave-gierlinger2023Usl,
  title = {Eine Untersuchung der Selbstwirksamkeitserwartung von Lehramtsstudierenden bezogen auf den Einsatz digitaler Technologien im Mathematikunterricht aus Perspektive der Control-Value Theory},
  booktitle = {Die Zukunft des MINT-Lernens – Band 1},
  author = {Grave-Gierlinger, Frederik and Jenßen, Lars and Eilerts, Katja},
  editor = {Roth, Jürgen and Baum, Michael and Eilerts, Katja and Hornung, Gabriele and Trefzger, Thomas},
