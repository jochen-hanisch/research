	volume = {63},
	issn = {0012-1924, 2190-622X},
	shorttitle = {Die {Facettenstruktur} des {Big} {Five} {Inventory} ({BFI})},
	url = {10.1026/0012-1924/a000161},
	doi = {10/gd82b7},
	abstract = {The facet structure (Soto \& John, 2009) developed and validated based on the original US version of the Big Five Inventory (BFI) was applied and validated for the German adaptation of the BFI based on three comprehensive samples: a student sample, a sample heterogeneous with regard to education, and a population-representative random sample. Results indicate that the 10 German BFI facets show substantial (a) reliabilities, (b) convergences between self- and partner ratings, and with the corresponding NEO-PI-R (NEO-Personality Inventory) and NEO-FFI (NEO-Five Factor Inventory) facet and domain scales, as well as (c) discriminant validity within and across domains that are all comparable in size to those reported for the original US version. Differential correlations with several sociodemographic and attitude measures proved the utility of using the BFI facets compared with the domain scales. These BFI facets offer researchers the opportunity to assess efficiently more specific aspects of the Big Five.},
	language = {de-DE},
	number = {1},
	urldate = {2020-07-12},
	journal = {Diagnostica},
	author = {Rammstedt, Beatrice and Danner, Daniel},
	month = jan,
	year = {2017},
	keywords = {Charité:Promotion, Dissertation:2.2.4, Promotion:2.2.5 Dispositionale Merkmale, Promotion:Literaturverzeichnis},
	pages = {70--84},
	file = {rammstedt_danner_2017_die_facettenstruktur_des_big_five_inventory_(bfi).pdf:/Users/jochenhanisch-johannsen/Zotero/storage/TN8A3P25/rammstedt_danner_2017_die_facettenstruktur_des_big_five_inventory_(bfi).pdf:application/pdf},
}

@article{wiechers_validierung_2025,
	title = {Validierung des {Deutschen} {Big} {Five} {Inventar}-2: {Konsistenz}, {Validität} und {Messinvarianz} der {Selbst}- und {Fremdberichtformen}},
	copyright = {https://creativecommons.org/licenses/by-nc/4.0},
	issn = {0012-1924, 2190-622X},
	shorttitle = {Validierung des {Deutschen} {Big} {Five} {Inventar}-2},
	url = {https://econtent.hogrefe.com/doi/10.1026/0012-1924/a000344},
	doi = {10.1026/0012-1924/a000344},
	abstract = {The current study examined the psychometric quality of the German Big Five Inventory-2 (BFI-2). By including ratings from well-informed acquaintances, we examined both the informant-rater and the self-rater formats. We directed the focus of the validation toward the internal consistency, the self-other agreement, the consensus of informant ratings, the structural, criterion, and incremental validity, and the measurement invariance across the rating perspectives. The sample consisted of 2 288 self-evaluations (61 \% female, age range: 14 – 89 years) and 932 informant evaluations (67 \% female, age range: 14 – 88 years); the latter stemmed mostly from well-informed partners, friends, and relatives. The analyses revealed satisfactory internal consistency, self-other agreement, and consensus. Structural equation models that considered both the self- and the informant-perspective confirmed the five-factor structure. Clear associations to criterion variables emerged, and the incremental value of the facet level was demonstrated in this respect. Finally, we confirmed partially strict measurement invariance across the rater perspectives. Thus, this study replicated previous validations of the self-rater format of the BFI-2 and also expanded them by highlighting the psychometric quality of the informant-rater format. We established the convergent and discriminant validity of different rater-perspectives and demonstrated the validity of the informant perspective for personality assessments using the BFI-2.},
	language = {de-DE},
	urldate = {2025-03-15},
	journal = {Diagnostica},
	author = {Wiechers, Yannik and Kandler, Christian},
	month = feb,
	year = {2025},
	keywords = {Charité:Promotion, Dissertation:2.2.4, Promotion:2.2.5 Dispositionale Merkmale, Promotion:Literaturverzeichnis},
	pages = {0012--1924/a000344},
	file = {Wiechers und Kandler - 2025 - Validierung des Deutschen Big Five Inventar-2 Konsistenz, Validität und Messinvarianz der Selbst- u:/Users/jochenhanisch-johannsen/Zotero/storage/HDRD9MJH/Wiechers und Kandler - 2025 - Validierung des Deutschen Big Five Inventar-2 Konsistenz, Validität und Messinvarianz der Selbst- u.pdf:application/pdf},
}

