@article{kerres_education_2022,
	title = {Education after the {Pandemic}: {What} {We} {Have} ({Not}) {Learned} about {Learning}},
	volume = {12},
	issn = {2227-7102},
	shorttitle = {Education after the {Pandemic}},
	url = {https://www.mdpi.com/2227-7102/12/5/315},
	doi = {10.3390/educsci12050315},
	abstract = {During the pandemic, educational technologies have become an essential tool to provide education at a distance. The paper outlines basic assumptions of research on the effects of the pandemic on education and points out methodological flaws when these effects are directly related to the pandemic or to effects of educational technology on learning. Studies cannot be easily aggregated and must consider the institutional, national and cultural conditions of how the educational system reacted to the pandemic. The article discusses how the experiences during the pandemic will shape the future discussion of education after the pandemic. With regard to the use of digital technology, the future seems widely open and will largely depend on the interpretation and re-construction of these experiences during the pandemic by the actors in the field. Two contradictory visions for the role of educational technology in education after the pandemic seem possible: a pre- vs. postdigital view that imply fundamentally different perspectives for the future of education. A pre-digital re-construction implies a return “back to normal”, whereas a post-digital view tries to utilize the experiences of the pandemic for a consequential reform of education.},
	language = {en-GB},
	number = {5},
	urldate = {2024-03-22},
	journal = {Education Sciences},
	author = {Kerres, Michael and Buchner, Josef},
	month = apr,
	year = {2022},
	keywords = {Promotion:Literaturanalyse, Technologieintegration, Promotion:Relevanz:4, \#0:Zeitschriftenartikel:digital:learning, Promotion:Weiterführung, Promotion:FU5, Krisenreaktion im Bildungsbereich, Promotion:S:12 Digital Learning, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {315},
	annote = {Analyse des Artikels "Education after the Pandemic: What We Have (Not) Learned" von Kerres und Buchner (2022)
1. Analyse
Hauptthemen und -ziele der Forschung: Der Artikel untersucht die Auswirkungen der COVID-19-Pandemie auf das Bildungssystem und beleuchtet die Lehren, die daraus gezogen wurden. Ziel ist es, die Veränderungen und Herausforderungen im Bildungsbereich während und nach der Pandemie zu analysieren und Handlungsempfehlungen für die Zukunft zu geben.
Verwendete Methoden und Datenquellen:


Methodische Ansätze: Qualitative Inhaltsanalyse basierend auf Literaturrecherche und Fallstudien.


Werkzeuge und Datenquellen: Analyse von wissenschaftlichen Artikeln, Berichten und Umfragen, die während der Pandemie entstanden sind.


Zentrale Forschungsergebnisse:


Digitalisierungsschub: Die Pandemie hat die Digitalisierung im Bildungsbereich beschleunigt, jedoch bestehen weiterhin Defizite in der technischen Ausstattung und im digitalen Know-how von Lehrkräften.


Ungleichheiten: Die Krise hat bestehende Ungleichheiten im Bildungssystem verschärft, insbesondere bei benachteiligten Schülern.


Innovationen und Flexibilität: Es wurden innovative Lehr- und Lernformate entwickelt, die auch nach der Pandemie beibehalten werden sollten, um die Flexibilität und Resilienz des Bildungssystems zu erhöhen.


2. Zusammenfassung
Kernpunkte des Artikels:


Problemstellung: Analyse der Auswirkungen der COVID-19-Pandemie auf das Bildungssystem und die daraus resultierenden Lehren.


Methodik: Qualitative Inhaltsanalyse von Literatur und Fallstudien.


Hauptergebnisse: Beschleunigte Digitalisierung, verschärfte Ungleichheiten und die Entwicklung innovativer Lehr- und Lernformate.


Schlussfolgerungen: Notwendigkeit, die digitalen Kompetenzen zu stärken und nachhaltige Bildungsinnovationen zu fördern.


3. Kernaussagen


Digitalisierungsschub: „Die Pandemie hat die Digitalisierung im Bildungsbereich beschleunigt, jedoch bestehen weiterhin Defizite in der technischen Ausstattung und im digitalen Know-how von Lehrkräften.“ (S. 15)


Ungleichheiten: „Die Krise hat bestehende Ungleichheiten im Bildungssystem verschärft, insbesondere bei benachteiligten Schülern.“ (S. 22)


Innovationen: „Es wurden innovative Lehr- und Lernformate entwickelt, die auch nach der Pandemie beibehalten werden sollten, um die Flexibilität und Resilienz des Bildungssystems zu erhöhen.“ (S. 30)


4. Argumentationslinien


Digitalisierung und technische Ausstattung: Der Artikel argumentiert, dass die Pandemie als Katalysator für die Digitalisierung fungiert hat, jedoch die unzureichende technische Ausstattung und die mangelnden digitalen Kompetenzen der Lehrkräfte weiterhin große Herausforderungen darstellen.


Soziale Ungleichheiten: Die Autoren betonen, dass die Pandemie soziale Ungleichheiten im Bildungssystem verstärkt hat und Maßnahmen ergriffen werden müssen, um diese Ungleichheiten zu verringern.


Langfristige Innovationen: Es wird vorgeschlagen, die während der Pandemie entwickelten innovativen Lehr- und Lernformate langfristig zu integrieren, um das Bildungssystem widerstandsfähiger und flexibler zu gestalten.


5. Verschlagwortung


Technologieintegration:


Begründung: Der Artikel behandelt ausführlich die Beschleunigung der Digitalisierung und die Integration digitaler Technologien im Bildungsbereich.


Fundstelle: S. 15




Krisenreaktion im Bildungsbereich:


Begründung: Die Untersuchung der Auswirkungen der COVID-19-Pandemie und die daraus gezogenen Lehren zeigen die Anpassungsfähigkeit des Bildungssystems an externe Schocks.


Fundstelle: S. 22




6. Kategorisierung


Kategorie: Weiterführung


Kriterium: Der Artikel bietet Empfehlungen zur langfristigen Integration von digitalen und innovativen Lehr- und Lernformaten.


Beispiel: Diskussion der Notwendigkeit, die digitalen Kompetenzen zu stärken und nachhaltige Bildungsinnovationen zu fördern.




7. Zuordnung zu Forschungsfragen


FU5: Welche Möglichkeiten und Grenzen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems durch Akteure im digitalen Bildungsraum von Gesundheitsberufen analysiert?


Begründung: Der Artikel analysiert die Möglichkeiten und Grenzen der Digitalisierung im Bildungsbereich, was auf die Untersuchung eines LMS übertragen werden kann.


Fundstelle: S. 30




Gesamtbewertung: 4/5
Diese Analyse zeigt die Relevanz des Artikels für die Untersuchung der Auswirkungen der COVID-19-Pandemie auf das Bildungssystem. Die Forschung bietet wertvolle Einblicke in die Herausforderungen und Chancen der Digitalisierung und liefert Empfehlungen für zukünftige Bildungsinnovationen.
},
	file = {Kerres und Buchner - 2022 - Education after the Pandemic What We Have (Not) L.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/7VFWJY58/Kerres und Buchner - 2022 - Education after the Pandemic What We Have (Not) L.pdf:application/pdf},
}

@article{wagner_schulentwicklungsmanagement_2024,
	title = {Schulentwicklungsmanagement zur digitalen {Transformation} von {Schule} in {Zeiten} des {Lehrkräftemangels} – {Empirische} {Ergebnisse} und {Konsequenzen} für die {Gestaltung} von {Schulentwicklung}},
	abstract = {Der Lehrkräftemangel ist allgegenwärtig und eine zentrale Herausforderung an vielen Schulen (Robert Bosch Stiftung 2023). In Zeiten knapper Personaldecken gilt es außerdem, digitale Technologien in den Unterricht zu integrieren, was in den Schulen mit weitreichenden Veränderungen (z. B. auf kultureller und organisatorischer Ebene) einhergeht (Tulowitzki/Gerick 2018). Die Implementation digitaler Technologien geschieht in organisationaler Perspektive im Rahmen von Schulentwicklung, wobei die fünf Dimensionen Organisations-, Unterrichts-, Personal-, Kooperations- und Technologieentwicklung von Interesse sind (Eickelmann/Gerick 2018, Rolff 2007, Schulz-Zander 2001). Es geht dabei um die zielgerichtete Planung des Veränderungsprozesses in der Einzelschule. Ziel des Beitrags ist es, anhand einer Interviewstudie im Projekt tabletBS.dual an 16 Berufsschulen in Baden-Württemberg die Gestaltung von Schulentwicklung bei der Implementation digitaler Technologien – insb. Tablets – zu analysieren. Es zeigt sich, dass die Schulen sehr unterschiedliche Maßnahmen umsetzen, die als mehr oder weniger erfolgreich wahrgenommen werden. Aus den empirischen Ergebnissen wird ein Tätigkeitsprofil für eine*n Schulentwicklungsmanager*in abgeleitet. Zentrale Aufgabe des Schulentwicklungsmanagements ist die Koordination und Planung des Implementationsprozesses an der Schule. Dies soll sicherstellen, dass Maßnahmen (z. B. Fortbildungen, Beschaffung von digitalen Geräten) aufeinander abgestimmt und zielführend sind.},
	language = {de-DE},
	journal = {Berufs- und Wirtschaftspädagogik - online},
	author = {Wagner, Anne and Bamberg, Universität},
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Technologieintegration, Bildungstheorien, Promotion:Argumentation, \#6:Zeitschriftenartikel:Bildung:Technologie, Krisenreaktion im Bildungsbereich, Lernsystemarchitektur, Promotion:todo, Promotion:S:06 Bildungstechnologie, Promotion:Literaturverzeichnis},
	file = {Wagner und Bamberg - 2024 - Schulentwicklungsmanagement zur digitalen Transfor.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/JQ2DUF66/Wagner und Bamberg - 2024 - Schulentwicklungsmanagement zur digitalen Transfor.pdf:application/pdf},
}

