@article{yang_ai_2023,
	title = {{AI} and {Big} {Data} in {Education}: {Learning} {Patterns} {Identification} and {Intervention} {Leads} to {Performance} {Enhancement}},
	volume = {3},
	issn = {2436-1712},
	shorttitle = {{AI} and {Big} {Data} in {Education}},
	url = {https://www.jstage.jst.go.jp/article/itel/3/1/3_3.1.Inv.p002/_article},
	doi = {10.12937/itel.3.1.Inv.p002},
	abstract = {Improving learning outcomes is always one of the key objectives of learning analytics (LA) and educational data mining (EDM). In recent years, many Massive Open Online Courses (MOOC) have been deployed and making it easier to collect learners’ data for further analysis. Naturally, leveraging AI to process such kind of big data becomes one of the main research streams to support education. In this paper, we collected data and deﬁned student learning patterns by leveraging online courses on Python programming and we then veriﬁed if their learning performance was inﬂuenced by diﬀerent learning patterns and interventions. We designed the intervention process, explored the impact of ﬁnal learning outcomes, and analyze Self-Regulated Learning (SRL) abilities. From the experimental results, we share the learning outcomes and the diﬀerence in SRL with detailed explanation based on diﬀerent groups.},
	language = {en-GB},
	number = {1},
	urldate = {2023-12-23},
	journal = {Information and Technology in Education and Learning},
	author = {Yang, Stephen J.H. and Lin, Chien-Chang and Huang, Anna Y.Q. and Lu, Owen H.T. and Hou, Chia-Chen and Ogata, Hiroaki},
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Bewertungsmethoden, Promotion:FU2a, Promotion:Relevanz:4, \#4:Zeitschriftenartikel:MOOC, Promotion:S:04 MOOC, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU2a},
	pages = {Inv--p002--Inv--p002},
	annote = {Analyse der Studie "AI and Big Data in Education: Learning Patterns Identification and Intervention Leads to Performance Enhancement" von Yang et al. (2023)
Hauptthemen und Ziele der Forschung:
Die Studie von Yang et al. (2023) befasst sich mit der Nutzung von Künstlicher Intelligenz (KI) und Big Data zur Identifikation von Lernmustern und der Durchführung von Interventionen, um die Lernleistung zu verbessern. Das zentrale Ziel der Forschung ist es, die Auswirkungen verschiedener Lernmuster und Interventionen auf die Lernergebnisse und die Fähigkeiten zur selbstregulierten Lernen (SRL) zu untersuchen. Die Autoren analysieren Daten von Online-Kursen in Python-Programmierung und bewerten den Einfluss unterschiedlicher Lernmuster auf die Lernleistung (S. 1).
Methoden und Datenquellen:
Die Studie verwendet eine Kombination aus maschinellem Lernen und Data-Mining-Techniken zur Analyse von Lernmustern. Daten wurden von 86 Studenten gesammelt, die einen Python-Programmierkurs an einer Universität in Taiwan besuchten. Die Teilnehmer wurden in eine Kontrollgruppe (46 Studenten) und eine Experimentalgruppe (40 Studenten) unterteilt. Verschiedene Online-Lernsysteme wie BookRoll, VisCode, Online Judge und ein Assessment-System wurden verwendet, um Daten zu erfassen. Der Motivated Strategies for Learning Questionnaire (MSLQ) wurde zur Messung der SRL-Fähigkeiten der Studierenden eingesetzt (S. 3-4).
Zentrale Forschungsergebnisse:


Unterschiede in den Lernergebnissen: Die Studie zeigt signifikante Unterschiede in den Lernergebnissen zwischen den Studenten mit verschiedenen Lernmustern. Insbesondere erzielten die aktiveren Gruppen (G3 und G4) bessere Post-Test-Ergebnisse als die inaktiveren Gruppen (G1 und G2) (S. 7).


Selbstreguliertes Lernen: Studenten mit unterschiedlichen Lernmustern wiesen signifikante Unterschiede in ihren SRL-Fähigkeiten auf. Die Gruppe G4 hatte höhere Fähigkeiten in Selbstregulation und Zeit- und Studienumgebung im Vergleich zu den anderen Gruppen (S. 8).


Effektivität von Interventionen: Die lernmusterbasierten Interventionen verbesserten signifikant die Lernleistung der Experimentalgruppe im Vergleich zur Kontrollgruppe. Die Experimentalgruppe zeigte höhere Post-Test-Ergebnisse und Verbesserungen in bestimmten Aspekten des SRL (S. 8-9).


Zusammenfassung
Die Studie von Yang et al. (2023) untersucht die Auswirkungen von KI und Big Data auf die Identifikation von Lernmustern und deren Einfluss auf die Lernleistung und SRL-Fähigkeiten der Studierenden. Die Ergebnisse zeigen, dass lernmusterbasierte Interventionen die Lernleistung signifikant verbessern können und dass unterschiedliche Lernmuster zu signifikanten Unterschieden in den SRL-Fähigkeiten führen.
Kernaussagen


Unterschiede in den Lernergebnissen: Es gibt signifikante Unterschiede in den Post-Test-Ergebnissen zwischen Studenten mit verschiedenen Lernmustern (S. 7).


Selbstreguliertes Lernen: Studenten mit höheren SRL-Fähigkeiten zeigten bessere Lernleistungen und höhere Engagement-Raten (S. 8).


Effektivität von Interventionen: Lernmusterbasierte Interventionen führen zu signifikanten Verbesserungen der Lernleistung und bestimmten Aspekten des SRL (S. 8-9).


Argumentationslinien
Die Autoren argumentieren, dass die Verwendung von KI und Big Data zur Identifikation von Lernmustern und zur Durchführung von Interventionen ein effektiver Ansatz ist, um die Lernleistung zu verbessern. Sie betonen die Bedeutung der Anpassung von Lernstrategien und Interventionen basierend auf den spezifischen Lernmustern der Studenten, um deren SRL-Fähigkeiten und Lernleistung zu optimieren (S. 10).
Verschlagwortung
Passendste Schlagworte und Begründungen:


Lehr- und Lerneffektivität: Die Studie untersucht, wie lernmusterbasierte Interventionen die Lernleistung und SRL-Fähigkeiten verbessern können (S. 8-9).


Technologieintegration: Die Nutzung von KI und Big Data zur Analyse von Lernmustern und zur Durchführung von Interventionen verdeutlicht die Integration fortschrittlicher Technologien in den Bildungsbereich (S. 1-2).


Bewertungsmethoden: Die Verwendung des MSLQ zur Messung der SRL-Fähigkeiten und die Analyse der Lernmuster sind innovative Methoden zur Bewertung der Bildungseffektivität (S. 3-4).


Kategorisierung


Kerngedanke: Die zentrale Idee der Studie ist die Nutzung von KI und Big Data zur Identifikation von Lernmustern und zur Durchführung von Interventionen, um die Lernleistung und SRL-Fähigkeiten der Studenten zu verbessern (S. 1).


Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU2a: Effekt-Faktoren für Lernende im digitalen Bildungsraum.


Begründung: Die Studie analysiert die Effekte von Lernmustern und Interventionen auf die Lernleistung und SRL-Fähigkeiten der Studierenden, was direkt die Frage nach den Effekt-Faktoren für Lernende im digitalen Bildungsraum betrifft (S. 7-9).
Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie untersucht umfassend die Auswirkungen von Lernmustern und Interventionen auf die Lernleistung und SRL-Fähigkeiten).


Zitierhäufigkeit und Einfluss: 4 (Die Studie ist umfassend und gut zitiert).


Aktualität: 5 (Die Studie ist von 2023 und behandelt ein aktuelles Thema).


Gesamtbewertung: 4.7
Schlussfolgerung
Die Studie zeigt, dass die Nutzung von KI und Big Data zur Identifikation von Lernmustern und zur Durchführung von Interventionen signifikante Vorteile für die Lernleistung und SRL-Fähigkeiten der Studenten bieten kann. Die Ergebnisse bieten wertvolle Einblicke und Empfehlungen für die zukünftige Gestaltung und Implementierung solcher Systeme in der digitalen Bildung.
},
	file = {Yang et al. - 2023 - AI and Big Data in Education Learning Patterns Id.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/CVZ8IWTR/Yang et al. - 2023 - AI and Big Data in Education Learning Patterns Id.pdf:application/pdf},
}

