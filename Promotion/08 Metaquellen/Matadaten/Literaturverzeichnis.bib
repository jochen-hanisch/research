@article{alqhtani_online_2021,
	title = {Online versus classroom teaching for medical students during {COVID}-19: measuring effectiveness and satisfaction},
	volume = {21},
	issn = {1472-6920},
	shorttitle = {Online versus classroom teaching for medical students during {COVID}-19},
	url = {https://bmcmededuc.biomedcentral.com/articles/10.1186/s12909-021-02888-1},
	doi = {10/gq3gsc},
	abstract = {Background: The COVID-19 pandemic and physical distancing have had a significant impact on the conversion of traditional teaching methods to online teaching methods, which although not uncommon in medical schools, has to date only been used for some aspects of the teaching process. Thus, we aimed to measure the effectiveness of e-learning during the COVID-19 pandemic, as well as medical students’ preferences regarding e-learning and classroom teaching, and the possibility of applying it post-pandemic.
Methods: A cross-sectional online survey of medical students (N = 376) in six medical schools was carried out after their second semester, from August 15 to 20, 2020. Ten parameters were measured for the effectiveness of elearning based on a 5-point Likert-scale and five parameters were measured for satisfaction.
Results: e-learning was more or equally effective in four parameters such as assignment submission and meeting individual needs, but less effective in six parameters, including building skills and knowledge, and interaction level. Satisfaction was either high or neutral in all five parameters.
Conclusions: Our findings have shown that e-learning can assist the teaching process in medical schools in some respects, but cannot be used for the entire teaching process.},
	language = {en-GB},
	number = {1},
	urldate = {2023-11-18},
	journal = {BMC Medical Education},
	author = {AlQhtani, Abdullh and AlSwedan, Nasser and Almulhim, Abdullelah and Aladwan, Raghad and Alessa, Yara and AlQhtani, Kholoud and Albogami, Malak and Altwairqi, Khalid and Alotaibi, Fahad and AlHadlaq, Abdulmajeed and Aldhafian, Osama},
	month = dec,
	year = {2021},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Promotion:Argumentation, Krisenreaktion im Bildungsbereich, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {452},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:AlQhtani et al. (2021) untersuchen die Wirksamkeit und Zufriedenheit von medizinischen Studierenden mit Online- im Vergleich zu Präsenzunterricht während der COVID-19-Pandemie. Das Ziel ist es, die Effektivität des E-Learning zu messen und studentische Präferenzen bezüglich E-Learning und traditionellem Unterricht zu bewerten.
Verwendete Methoden und Datenquellen:Die Studie führte eine querschnittliche Online-Umfrage unter 376 Medizinstudierenden aus sechs medizinischen Schulen durch. Die Effektivität des E-Learnings wurde anhand einer 5-Punkte-Likert-Skala über zehn Parameter gemessen, und die Zufriedenheit wurde über fünf Parameter bewertet.
Zentrale Forschungsergebnisse:E-Learning war in vier Parametern wie Aufgabenabgabe und individuelle Bedürfnisse gleich oder wirksamer, jedoch in sechs Parametern weniger wirksam, einschließlich Fähigkeiten und Wissenserwerb sowie Interaktionsniveau. Die Zufriedenheit war durchweg hoch oder neutral.
Zusammenfassung
Die Ergebnisse von AlQhtani et al. zeigen, dass E-Learning in einigen Aspekten die Lehrmethoden in medizinischen Schulen unterstützen kann, jedoch nicht für den gesamten Lehrprozess geeignet ist. Es wurden sowohl Stärken als auch Schwächen von E-Learning im Vergleich zum traditionellen Unterricht hervorgehoben.
Kernaussagen


"E-Learning erwies sich bei der Aufgabenabgabe und der Berücksichtigung individueller Bedürfnisse als gleich oder effektiver, zeigte jedoch Schwächen in der Fähigkeitsbildung und beim Wissenserwerb." (S. 3)


"Die allgemeine Zufriedenheit mit dem Online-Lernen war hoch, weist jedoch auf eine Präferenz für eine hybride Lernmethode hin." (S. 4)


Argumentationslinien


Die Ergebnisse unterstreichen, dass Online-Lernen bestimmte Vorteile bietet, insbesondere in Bezug auf Flexibilität und individuelle Anpassung, aber in Bezug auf interaktive und praktische Aspekte, die in der medizinischen Ausbildung entscheidend sind, Einschränkungen aufweist.


Es wird eine klare Notwendigkeit für eine ausgewogene Kombination aus Online- und Präsenzlehre deutlich, um die Qualität und Tiefe des medizinischen Lernens zu gewährleisten.


Verschlagwortung


Lehr- und Lerneffektivität: Die Studie zeigt auf, dass E-Learning effektiv sein kann, aber nicht alle Lehrziele vollständig erfüllt.


Technologieintegration: Die Notwendigkeit, technologische Lösungen im Bildungsbereich sinnvoll einzusetzen.


Krisenreaktion im Bildungsbereich: Die Anpassung der Lehrmethoden an die Pandemiebedingungen verdeutlicht die Flexibilität und Anpassungsfähigkeit des Bildungssystems.


Forschungsansätze: Die Verwendung von Umfragedaten zur Bewertung der Wirksamkeit und Zufriedenheit liefert wichtige Erkenntnisse für die Weiterentwicklung von Lehrmethoden.


Kategorie: Argumentation
Diese Studie liefert wichtige Argumente für eine differenzierte Betrachtung der Eignung von E-Learning in der medizinischen Ausbildung, indem sie zeigt, dass Online-Methoden in bestimmten Bereichen wirksam sein können, jedoch nicht alle Anforderungen des medizinischen Curriculums abdecken.
},
	file = {AlQhtani et al. - 2021 - Online versus classroom teaching for medical stude.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/C738P7LZ/AlQhtani et al. - 2021 - Online versus classroom teaching for medical stude.pdf:application/pdf},
}

@article{gaupp_effects_2016,
	title = {Effects of a case-based interactive e-learning course on knowledge and attitudes about patient safety: a quasi-experimental study with third-year medical students},
	volume = {16},
	issn = {1472-6920},
	shorttitle = {Effects of a case-based interactive e-learning course on knowledge and attitudes about patient safety},
	url = {http://bmcmededuc.biomedcentral.com/articles/10.1186/s12909-016-0691-4},
	doi = {10/f8v9qr},
	abstract = {Background: Patient safety (PS) is influenced by a set of factors on various levels of the healthcare system. Therefore, a systems-level approach and systems thinking is required to understand and improve PS. The use of e-learning may help to develop a systems thinking approach in medical students, as case studies featuring audiovisual media can be used to visualize systemic relationships in organizations. The goal of this quasi-experimental study was to determine if an e-learning can be utilized to improve systems thinking, knowledge, and attitudes towards PS.
Methods: A quasi-experimental, longitudinal within- subjects design was employed. Participants were 321 third-year medical students who received online surveys before and after they participated in an e-learning course on PS. Primary outcome measures where levels of systems thinking and attitudes towards PS. Secondary outcome measures were the improvement of PS specific knowledge through the e-learning course.
Results: Levels of systems thinking showed significant improvement (58.72 vs. 61.27; p {\textless} .001) after the e-learning. Student’s attitudes towards patient safety improved in several dimensions: After the course, students rated the influence of fatigue on safety higher (6.23 vs. 6.42, p {\textless} .01), considered patient empowerment more important (5.16 vs. 5.93, p {\textless} .001) and realized more often that human error is inevitable (5.75 vs. 5.97, p {\textless} .05). Knowledge on PS improved from 36.27 \% correct answers before to 76.45 \% after the e-learning (p {\textless} .001).
Conclusions: Our results suggest that e-learning can be used to teach PS. Attitudes towards PS improved on several dimensions. Furthermore, we were able to demonstrate that a specifically designed e-learning program can foster the development of conceptual frameworks such as systems thinking, which facilitates the understanding of complex socio-technical systems within healthcare organisations.},
	language = {en-GB},
	number = {1},
	urldate = {2023-11-18},
	journal = {BMC Medical Education},
	author = {Gaupp, Rainer and Körner, Mirjam and Fabry, Götz},
	month = dec,
	year = {2016},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {172},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:
Die Studie von Gaupp et al. (2016) untersucht die Auswirkungen eines fallbasierten, interaktiven E-Learning-Kurses auf das Wissen und die Einstellungen von Medizinstudenten zur Patientensicherheit. Ziel ist es, die Wirksamkeit von E-Learning bei der Förderung von Systemdenken und der Verbesserung der Sicherheitskultur in der medizinischen Ausbildung zu bewerten.
Verwendete Methoden und Datenquellen:
Die Studie verwendet ein quasi-experimentelles, longitudinales Design mit Vorher-Nachher-Messungen. Insgesamt nahmen 321 Medizinstudenten im dritten Studienjahr an dem E-Learning-Kurs teil. Die Hauptmessgrößen waren das Ausmaß des Systemdenkens und die Einstellungen zur Patientensicherheit, gemessen durch Online-Umfragen vor und nach dem Kurs. Sekundäre Messgrößen umfassten die Verbesserung spezifischen Wissens zur Patientensicherheit.
Zentrale Forschungsergebnisse:
Die Ergebnisse zeigen, dass das Systemdenken der Studierenden signifikant verbessert wurde (58,72 vs. 61,27; p {\textless} .001). Die Einstellungen der Studierenden zur Patientensicherheit verbesserten sich in mehreren Dimensionen, wie dem Einfluss von Müdigkeit auf die Sicherheit (6,23 vs. 6,42; p {\textless} .01) und der Bedeutung der Patientenbeteiligung (5,16 vs. 5,93; p {\textless} .001). Das Wissen zur Patientensicherheit stieg von 36,27 \% auf 76,45 \% (p {\textless} .001).
Zusammenfassung
Die Studie zeigt, dass fallbasiertes, interaktives E-Learning die Fähigkeiten und Einstellungen von Medizinstudenten zur Patientensicherheit erheblich verbessern kann. Dies unterstützt die Entwicklung von Systemdenken und fördert das Verständnis komplexer sozio-technischer Systeme im Gesundheitswesen.
Kernaussagen
	•	“Das Systemdenken der Studierenden verbesserte sich signifikant nach dem E-Learning-Kurs.” (S. 3)
	•	“Die Einstellungen der Studierenden zur Patientensicherheit verbesserten sich in mehreren Dimensionen, einschließlich der Bedeutung der Patientenbeteiligung und der Auswirkungen von Müdigkeit.” (S. 3)
	•	“Das Wissen zur Patientensicherheit stieg signifikant nach dem Kurs.” (S. 3)
Argumentationslinien
	•	Die Studie betont die Bedeutung von Systemdenken in der medizinischen Ausbildung zur Verbesserung der Patientensicherheit.
	•	Es wird argumentiert, dass E-Learning, insbesondere wenn es interaktiv und fallbasiert ist, ein effektives Mittel zur Vermittlung komplexer Themen wie Patientensicherheit darstellt.
Verschlagwortung
	•	Lehr- und Lerneffektivität: Die signifikanten Verbesserungen im Wissen und den Einstellungen zur Patientensicherheit zeigen die Wirksamkeit des E-Learnings.
	•	Technologieintegration: Die Studie verdeutlicht die erfolgreiche Integration von E-Learning in die medizinische Ausbildung.
	•	Systemanpassung: Anpassungen des Lehrplans zur Förderung von Systemdenken und Sicherheitskultur sind notwendig.
	•	Forschungsansätze: Die Anwendung eines quasi-experimentellen Designs und die Nutzung von Vorher-Nachher-Messungen bieten wertvolle Einblicke in die Wirksamkeit von Bildungsinterventionen.
Kategorie: Argumentation
Diese Studie liefert überzeugende Argumente für die Integration von fallbasiertem, interaktivem E-Learning in die medizinische Ausbildung zur Verbesserung der Patientensicherheit. Sie zeigt, dass durch gezielte Bildungsmaßnahmen das Systemdenken und die Sicherheitskultur bei Medizinstudenten gestärkt werden können.
},
	file = {Gaupp et al. - 2016 - Effects of a case-based interactive e-learning cou.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/HKSTXB8G/Gaupp et al. - 2016 - Effects of a case-based interactive e-learning cou.pdf:application/pdf},
}

@article{kirsch_caution_2023,
	title = {Caution with competitive gamification in medical education: unexpected results of a randomised cross-over study},
	volume = {23},
	issn = {1472-6920},
	shorttitle = {Caution with competitive gamification in medical education},
	url = {https://bmcmededuc.biomedcentral.com/articles/10.1186/s12909-023-04258-5},
	doi = {10/gs567c},
	abstract = {Background  To intrinsically motivate students in the long term, longitudinal e-learning systems combined with repeated testing and competitive gamification seem promising. The effects of this approach have never been closely examined in the field of evidence-based medicine. The authors investigated if a simple, competitive learning application enhances students’ risk competence and intrinsic motivation.
Methods  Participants were 5.-9. semester medical students (n = 48), recruited in an elective evidence-based medicine subject and randomly distributed to two groups (group 1: n = 23; group 2: n = 25). Both accessed a competitive evidence-based medicine quiz game. Following a cross-over design, each group practiced with one of two thematically different questionnaires A or B, before the allocation switched after one month. To analyse whether there was a measurable learning effect in the practiced topics, a paired t-test was performed with quantitative data from 3 e-tests. Students further reported their experience in evaluation surveys.
Results  Students’ improvements in e-test scores after training with the corresponding topics in the learning application can be attributed to chance. Even though the majority enjoyed playing and felt motivated to study, they invested a minimum of time and rejected competition.
Conclusion  The authors found no evidence for benefits of the investigated learning programme on students’ risk competence or on their internal motivation. The majority disapproved the competitive concept, indicating adverse side effects of the applied gamification element. To intrinsically motivate more students, prospective learning programmes should favour complex and collaborative programmes over simple and competitive ones.},
	language = {en-GB},
	number = {1},
	urldate = {2023-11-18},
	journal = {BMC Medical Education},
	author = {Kirsch, Jacqueline and Spreckelsen, Cord},
	month = apr,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Kollaboratives Lernen, Lehr- und Lerneffektivität, Technologieintegration, Promotion:Argumentation, Datenschutz und IT-Sicherheit, Krisenreaktion im Bildungsbereich, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {259},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:Kirsch und Spreckelsen (2023) untersuchen die Auswirkungen von wettbewerbsorientierter Gamifizierung auf die Lernmotivation und Risikokompetenz von Medizinstudierenden. Das Ziel der Studie war es, festzustellen, ob eine einfache, wettbewerbsorientierte Lernanwendung die intrinsische Motivation und das Risikoverständnis der Studierenden verbessern kann.
Verwendete Methoden und Datenquellen:Die Autoren führten eine randomisierte Cross-Over-Studie mit Medizinstudierenden durch, die ein wettbewerbsorientiertes Quizspiel im Bereich der evidenzbasierten Medizin nutzten. Die Daten wurden durch prä- und postinterventionelle E-Tests sowie durch Befragungen zur Selbsteinschätzung der Studierenden gesammelt.
Zentrale Forschungsergebnisse:Die Studie ergab, dass Verbesserungen in den E-Testergebnissen der Studierenden nicht signifikant waren und möglicherweise dem Zufall zuzuschreiben sind. Obwohl die Mehrheit der Studierenden angab, Spaß am Spiel gehabt zu haben und motiviert gewesen zu sein, lehnten sie den Wettbewerbsaspekt ab und investierten nur minimal Zeit in die Nutzung der Lernanwendung.
Zusammenfassung
Die Forschungsergebnisse deuten darauf hin, dass wettbewerbsorientierte Gamifizierung in der medizinischen Ausbildung möglicherweise nicht effektiv ist, um die Risikokompetenz oder die intrinsische Motivation der Studierenden zu verbessern. Die Mehrheit der Studierenden lehnte das wettbewerbsorientierte Konzept ab, was auf negative Nebeneffekte des angewandten Gamifizierungselements hinweist.
Kernaussagen


"Die Studie fand keine Beweise dafür, dass das untersuchte Lernprogramm die Risikokompetenz der Studierenden oder ihre intrinsische Motivation verbessert." (S. 2)


"Die Mehrheit der Studierenden lehnte das wettbewerbsorientierte Konzept ab, was auf negative Nebeneffekte des angewandten Gamifizierungselements hindeutet." (S. 3)


Argumentationslinien


Die Ergebnisse legen nahe, dass der Wettbewerbsaspekt, obwohl er anfangs als Motivationsfaktor gedacht war, tatsächlich demotivierend wirken kann und nicht zur Verbesserung der Lernergebnisse beiträgt.


Die Studie betont, dass zukünftige Lernprogramme eher komplexe und kollaborative Ansätze bevorzugen sollten, anstatt einfache und wettbewerbsorientierte Methoden.


Verschlagwortung


Lehr- und Lerneffektivität: Die Studie zeigt, dass wettbewerbsorientierte Gamifizierung möglicherweise nicht effektiv ist, um die Lerneffektivität zu steigern.


Technologieintegration: Obwohl Technologie genutzt wurde, um das Lernen zu gamifizieren, zeigt die Studie die Grenzen dieser Integration auf.


Kollaboratives Lernen: Die Ergebnisse unterstützen den Bedarf an mehr kollaborativen und weniger wettbewerbsorientierten Lernansätzen in der medizinischen Ausbildung.


Krisenreaktion im Bildungsbereich: Die Studie weist auf die Notwendigkeit hin, Bildungssysteme weiterzuentwickeln, um sie an die Bedürfnisse und Präferenzen der Lernenden anzupassen.


Datenschutz und IT-Sicherheit: Während nicht direkt thematisiert, bleibt der verantwortungsvolle Umgang mit Technologien und Daten eine implizite Anforderung.


Kategorie: Argumentation
Die Argumentation in dieser Studie zeigt, dass wettbewerbsorientierte Gamifizierung möglicherweise kontraproduktiv für die Förderung von Risikokompetenz und intrinsischer Motivation in der medizinischen Ausbildung ist. Sie betont die Notwendigkeit einer sorgfältigen Überprüfung und möglichen Neugestaltung von Lernstrategien, um negative psychologische Effekte zu vermeiden und effektivere Bildungsergebnisse zu erzielen.
},
	file = {Kirsch und Spreckelsen - 2023 - Caution with competitive gamification in medical e.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/NZ5ZQ3KS/Kirsch und Spreckelsen - 2023 - Caution with competitive gamification in medical e.pdf:application/pdf},
}

@article{luginbuehl_transforming_2023,
	title = {Transforming traditional physiotherapy hands-on skills teaching into video-based learning},
	volume = {23},
	issn = {1472-6920},
	url = {https://bmcmededuc.biomedcentral.com/articles/10.1186/s12909-023-04556-y},
	doi = {10/gs5667},
	abstract = {Background  Pandemic-induced restrictions forced curriculum transformation from on-site education to virtual learning options. This report describes this transition, the challenge of creating technology-enhanced learning for hands-on psychomotor skills teaching in physiotherapy, and students’ evaluations of the new technology-enhanced learning approach in Complex Decongestive Physiotherapy.
Methods  On-site theoretical background lectures were replaced with e-learning sessions. Faculty hands-on skills demonstrations for the entire class were replaced with video-recorded demonstrations. Videos included verbal and written instructions and were complemented with checklists guiding the students, training in pairs, through their learning tasks. A cross-sectional observational survey for teaching quality evaluated this new technology-enhanced learning approach and assessed students’ preference for traditional or video-based hands-on skills learning.
Results  Survey return rate was {\textgreater} 50\% (46 participating students). Teaching quality was rated between 1.5 ± 0.5 and 1.8 ± 0.4 (Likert scale from − 2 to + 2). Most students (66.7\%) preferred the new approach. They appreciated for example that videos were available all the time, enabling self-paced learning, providing an equally good view on skills demonstrations, and the convenience to be able to rewind, re-view, and use speed adjustment options.
Conclusions  Students preferred the new video-based learning of skills for Complex Decongestive Physiotherapy. Because in-class live skills demonstrations were omitted, faculty had more time to provide individual feedback and answer questions. The shift from teacher- to student-centered learning enabled students to control their own learning pace. The innovative program was maintained after pandemic-induced restrictions were lifted. The success of this approach should be tested in other physiotherapy settings and different educational institutions.},
	language = {en-GB},
	number = {1},
	urldate = {2023-11-18},
	journal = {BMC Medical Education},
	author = {Luginbuehl, Helena and Nabecker, Sabine and Greif, Robert and Zuber, Stefan and Koenig, Irene and Rogan, Slavko},
	month = sep,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Kollaboratives Lernen, Lehr- und Lerneffektivität, Technologieintegration, Promotion:Weiterführung, Datenschutz und IT-Sicherheit, Krisenreaktion im Bildungsbereich, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {624},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:Luginbuehl et al. (2023) beschäftigen sich mit der Umwandlung traditioneller, praktischer Physiotherapieausbildung in ein video-basiertes Lernformat. Die Studie zielt darauf ab, die Effektivität dieser neuen Lehrmethode zu bewerten, insbesondere wie sie den Erwerb von psychomotorischen Fähigkeiten in einem Online-Setting beeinflusst.
Verwendete Methoden und Datenquellen:Die Umstellung von traditionellem Unterricht auf video-basiertes Lernen wurde durch die COVID-19-Pandemie beschleunigt. Dabei wurden sowohl asynchrone E-Learning-Sitzungen als auch praktische Video-Demonstrationen eingesetzt. Zur Evaluation der Lehrqualität wurden Querschnittsbefragungen unter den Studierenden durchgeführt.
Zentrale Forschungsergebnisse:Die Studie ergab, dass die Mehrheit der Studierenden (66,7\%) das neue video-basierte Lernkonzept bevorzugte. Sie schätzten insbesondere die ständige Verfügbarkeit der Videos, die Möglichkeit, das Lerntempo selbst zu bestimmen, und die verbesserte Sichtbarkeit und Zugänglichkeit der Lehrinhalte.
Zusammenfassung
Die Forschungsergebnisse von Luginbuehl et al. unterstützen die Einführung von Technologie-gestützten Lehrmethoden in der Physiotherapieausbildung. Das video-basierte Lernformat ermöglichte den Studierenden eine effektivere und flexiblere Weise, praktische Fähigkeiten zu erlernen, was besonders während der Pandemie von Vorteil war.
Kernaussagen


"Studierende bevorzugen das neue video-basierte Lernformat aufgrund der ständigen Verfügbarkeit und der besseren Steuerung des Lernprozesses." (S. 3)


"Die technologiegestützte Methode führte zu einer verbesserten Sichtbarkeit der Lehrinhalte und erleichterte das individuelle Lernen." (S. 5)


Argumentationslinien


Die Studie zeigt, dass video-basierte Lernmethoden effektiv sind, um praktische Fähigkeiten zu vermitteln, und bietet eine flexible Alternative zu traditionellen Lehrmethoden.


Es wird hervorgehoben, dass durch den Wechsel zu einem studentenzentrierten Lernansatz die individuelle Betreuung und Feedback verbessert werden.


Verschlagwortung


Lehr- und Lerneffektivität: Das neue Lernkonzept verbesserte die Effizienz und Effektivität des Lernens durch den Einsatz von Technologie.


Technologieintegration: Die Integration von Videoinhalten in die Physiotherapieausbildung zeigt eine erfolgreiche Anwendung moderner Lehrtechnologien.


Kollaboratives Lernen: Trotz des individuellen Lernansatzes förderte das Konzept die Zusammenarbeit unter den Studierenden durch gemeinsame Diskussionen und Feedback-Sessions.


Krisenreaktion im Bildungsbereich: Die schnelle Anpassung an Online-Lernmethoden während der Pandemie zeigte die Relevanz und Notwendigkeit flexibler Lernansätze.


Datenschutz und IT-Sicherheit: Der Umgang mit persönlichen Daten und der Schutz der Privatsphäre der Studierenden in einem Online-Lernumfeld wurden als wichtig erachtet.


Kategorie: Weiterführung
Die positive Aufnahme und der Erfolg des video-basierten Lernformats in der Physiotherapieausbildung legen nahe, dass weitere Forschung in anderen Bereichen der medizinischen Ausbildung durchgeführt werden sollte. Es wäre sinnvoll, die Langzeitwirkungen und die Übertragbarkeit dieser Lehrmethoden auf andere Disziplinen zu untersuchen, um umfassende Bildungsinnovationen zu fördern.
},
	file = {Luginbuehl et al. - 2023 - Transforming traditional physiotherapy hands-on sk.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/AQYTBKDM/Luginbuehl et al. - 2023 - Transforming traditional physiotherapy hands-on sk.pdf:application/pdf},
}

@article{aida_impact_2023,
	title = {Impact of {E}-{Learning} {Orientation}, {Moodle} {Usage}, and {Learning} {Planning} on {Learning} {Outcomes} in {On}-{Demand} {Lectures}},
	volume = {13},
	issn = {2227-7102},
	url = {https://www.mdpi.com/2227-7102/13/10/1005},
	doi = {10/gswfrg},
	abstract = {The growing prominence of e-learning in education has led to the need for a comprehensive understanding of the factors inﬂuencing learning outcomes. This study aims to investigate the combined effects of e-learning orientation, Moodle usage, and learning planning on learning outcomes in the context of on-demand lectures. A sample of participants from the Department of Information Science and Engineering in the Faculty of Engineering completed questionnaires related to e-learning orientation, while Moodle usage data and learning planning information were collected. Correlation, principal component, cluster, and multiple regression analysis were conducted to examine the relationships between variables and their impact on learning outcomes. The results suggest that e-learning orientation did not exert a signiﬁcant inﬂuence on learning outcomes. However, Moodle usage and learning planning emerged as crucial factors. Increased engagement with Moodle, as indicated by higher clicks and utilization of its learning functionalities, was associated with improved learning outcomes. Additionally, effective learning planning, characterized by adherence to schedules and timely submissions, positively inﬂuenced learning outcomes. The results emphasize the importance of considering multiple factors, not just a single factor, for successful online learning. These ﬁndings provide valuable insights for optimizing learning outcomes in on-demand lectures.},
	language = {en-GB},
	number = {10},
	urldate = {2023-10-18},
	journal = {Education Sciences},
	author = {Aida, Saori},
	month = oct,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Systemanpassung, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {1005},
	annote = {Kernstudie identifiziert für das Forschungsprojekt "Wirkgefüge im digitalen Bildungsraum":


Titel: Impact of E-Learning Orientation, Moodle Usage, and Learning Planning on Learning Outcomes in On-Demand Lectures


Autorin: Aida, S.


Publiziert in: Education Sciences


Band/Volume: 13


Ausgabe: 10


Seiten: 1005


Jahr: 2023


DOI: https://doi.org/10/gswfrg


Beschreibung der Studie: Die Studie von Saori Aida untersucht den Einfluss der E-Learning-Orientierung, der Nutzung des Lernmanagementsystems Moodle und der Lernplanung auf die Lernergebnisse in On-Demand-Vorlesungen. Sie erforscht, wie diese Faktoren die Effektivität des Lernens in digitalen Bildungsformaten beeinflussen.
Bedeutung für das Forschungsprojekt: Diese Studie liefert wichtige Erkenntnisse darüber, wie die Strukturierung und Planung von E-Learning-Kursen die Lernergebnisse verbessern kann. Die Ergebnisse können dazu beitragen, effektivere Strategien für die Gestaltung von On-Demand-Lernangeboten zu entwickeln, die auf die Bedürfnisse und Präferenzen der Lernenden abgestimmt sind.
},
	file = {Aida - 2023 - Impact of E-Learning Orientation, Moodle Usage, an.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/EMFCN8YK/Aida - 2023 - Impact of E-Learning Orientation, Moodle Usage, an.pdf:application/pdf},
}

@article{martinez-garcia_evolution_2023,
	title = {Evolution and current state of research into {E}-learning},
	volume = {9},
	issn = {24058440},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2405844023082245},
	doi = {10/gsv83r},
	abstract = {This article aims to undertake a bibliometric review along with a conceptual and intellectual analysis of research on distance learning and e-learning. The purpose of this study is to focus on several academic fields and offer a comprehensive approach on how research on distance learning and e-learning has been approached since 1970. This work applies several bibliometric tech­ niques to assess the research evolution of topics addressed, the most productive authors and the most influential journals. The findings revealed an exponential increase of publications over the last 20 years, highlighting the evolution of topics. The research themes include four main groups: the first relates to pedagogical processes in terms of effectiveness, outcomes, learning strategies, interaction, and self-regulation; the second group includes aspects associated with ICT applied in distance education; the third group focuses on the perceived value, usefulness, acceptance, and satisfaction of e-learning; and the last group portrays the forced application of distance learning strategies to deal with the consequences of the pandemic. This work contributes to expanding the existing literature devoted to study the structure of research on e-learning. It analyses the most representative authors, institutions, and documents, and gathers the growing literature on elearning, from distance learning in the seventies until the implementation of online learning in the COVID-19 era.},
	language = {en-GB},
	number = {10},
	urldate = {2023-10-17},
	journal = {Heliyon},
	author = {Martinez-Garcia, Aitor and Horrach-Rosselló, Patricia and Mulet-Forteza, Carles},
	month = oct,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Datenschutz und IT-Sicherheit, Krisenreaktion im Bildungsbereich, \#5:Zeitschriftenartikel:e-learning, Kernstudie, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {e21016},
	annote = {Kernstudie identifiziert für das Forschungsprojekt "Wirkgefüge im digitalen Bildungsraum":


Titel: Evolution and current state of research into E-learning


Autoren: Martinez-Garcia, A., Horrach-Rosselló, P., \& Mulet-Forteza, C.


Publiziert in: Heliyon


Band/Volume: 9


Ausgabe: 10


Artikelnummer: e21016


Jahr: 2023


DOI: https://doi.org/10/gsv83r


Beschreibung der Studie: Die Studie von Martinez-Garcia, Horrach-Rosselló, und Mulet-Forteza bietet eine umfassende Analyse der Entwicklung und des aktuellen Forschungsstands im Bereich E-Learning. Sie untersucht die verschiedenen Phasen der E-Learning-Forschung und identifiziert Schlüsseltrends und Technologien, die die digitale Bildung vorantreiben.
Bedeutung für das Forschungsprojekt: Diese Studie ist besonders wertvoll, um die historische und gegenwärtige Forschungslage im Bereich des E-Learnings zu verstehen. Sie liefert einen kontextualisierten Überblick über die Methoden und Technologien, die die Effektivität von Online-Bildungsangeboten beeinflussen und könnte wichtige Impulse für die Gestaltung zukünftiger digitaler Lernumgebungen geben.
Diese Informationen sind dokumentiert und bilden eine wesentliche Grundlage für die weitere Erforschung und Diskussion der Rolle von E-Learning im Kontext Ihres Forschungsprojekts.
},
	file = {Martinez-Garcia et al. - 2023 - Evolution and current state of research into E-lea.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/VI37NFBA/Martinez-Garcia et al. - 2023 - Evolution and current state of research into E-lea.pdf:application/pdf},
}

@article{krowicki_evaluation_2023,
	title = {Evaluation eines {E}-{Learning}-{Programms} zur {Förderung} gesunder {Telearbeit}},
	issn = {0944-2502, 2198-0713},
	url = {https://link.springer.com/10.1007/s40664-023-00520-1},
	doi = {10/gsv8zm},
	abstract = {Background. Teleworking has increasingly become established as a working model by companies due to the change in the world of work and accelerated by the coronavirus disease 2019 (COVID-19) pandemic. Resources and requirements must be assessed from an occupational health perspective in order to support companies in the health-promoting implementation of teleworking. Methods. As part of this study ﬁve important ﬁelds of action were identiﬁed from the literature on the basis of which an e-learning program for healthy teleworking was developed. Subsequently, it was assessed whether this program has a positive impact on the mental health and ability to work of teleworkers. An administrative authority in Saxony-Anhalt was recruited for the study.},
	language = {de-DE},
	urldate = {2023-10-15},
	journal = {Zentralblatt für Arbeitsmedizin, Arbeitsschutz und Ergonomie},
	author = {Krowicki, Martin and Böckelmann, Irina},
	month = oct,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, Krisenreaktion im Bildungsbereich, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:Die Studie von Krowicki und Böckelmann (2023) evaluiert ein E-Learning-Programm, das darauf abzielt, gesunde Telearbeit zu fördern, insbesondere hinsichtlich psychischer Gesundheit und Arbeitsergonomie. Das Ziel ist es, die Effektivität dieses Programms im Hinblick auf die Verbesserung der Arbeitsbedingungen und die Verringerung von Belastungen bei Telearbeitern zu bewerten.
Verwendete Methoden und Datenquellen:Es wurde ein quasi-experimentelles Studiendesign angewandt, bei dem das E-Learning-Programm vor und nach der Implementierung auf seine Wirkung überprüft wurde. Die Datenerhebung erfolgte mittels standardisierter Fragebögen, einschließlich des Kurz-Fragebogens zur Arbeitsanalyse (KFZA), des Work-Ability-Index (WAI) und des Maslach Burnout Inventory (MBI).
Zentrale Forschungsergebnisse:Die Ergebnisse zeigen, dass das E-Learning-Programm keine signifikanten Verbesserungen in den gemessenen Parametern erzielte, obwohl eine Tendenz zur Zunahme der Arbeitsbelastung beobachtet wurde. Es gab keine signifikanten Änderungen im Prä-Post-Vergleich bei den Parametern der Arbeitsumgebung und des Burnout-Risikos.
Zusammenfassung
Krowicki und Böckelmann stellen fest, dass trotz der gut gemeinten Intervention das E-Learning-Programm nicht die erhofften signifikanten Verbesserungen erbrachte. Die Studie unterstreicht die Komplexität der Implementierung effektiver E-Learning-Lösungen für gesunde Telearbeit und die Notwendigkeit, solche Programme weiter zu entwickeln und anzupassen.
Kernaussagen


"Das E-Learning-Programm führte zu keiner signifikanten Verbesserung der psychischen Gesundheit und Arbeitsergonomie." (S. 9)


"Es wurde eine Tendenz zur Zunahme der Arbeitsbelastung nach der Durchführung des Programms beobachtet." (S. 12)


Argumentationslinien


Die Studie legt nahe, dass für die effektive Umsetzung von Gesundheitsförderungsprogrammen im Bereich der Telearbeit eine sorgfältigere Planung und eventuell eine Kombination mit Präsenzschulungen erforderlich sind.


Die Forschung zeigt, dass alleinige E-Learning-Interventionen möglicherweise nicht ausreichen, um nachhaltige Verbesserungen in der Arbeitsergonomie und psychischen Gesundheit zu erzielen.


Verschlagwortung


Lehr- und Lerneffektivität: Die Ergebnisse legen nahe, dass das E-Learning-Programm in seiner derzeitigen Form nicht effektiv genug ist, um die Lehrziele vollständig zu erreichen.


Technologieintegration: Die Studie zeigt die Integration von Technologie in die Gesundheitsförderung, betont jedoch auch die Grenzen dieser Ansätze ohne weitere Unterstützung.


Krisenreaktion im Bildungsbereich: Die schnelle Anpassung an Telearbeit durch E-Learning während der COVID-19-Pandemie wird thematisiert, wobei die Notwendigkeit von Verbesserungen hervorgehoben wird.


Systemanpassung: Die Notwendigkeit, Systeme zur Unterstützung gesunder Telearbeit anzupassen, wird durch die Ergebnisse unterstrichen.


Kategorie: Weiterführung
Angesichts der Herausforderungen und teilweise enttäuschenden Ergebnisse dieser Studie sollten zukünftige Forschungsarbeiten die Kombination von Online-Interventionen mit Präsenzschulungen unter realen Arbeitsbedingungen weiter untersuchen, um die Effektivität von E-Learning-Programmen zur Förderung gesunder Telearbeit zu verbessern.
Das sollte eine Argumentation sein, um auch die negativen Seiten von LMS zu beluchten
Vielen Dank für die Klarstellung. Ich werde die Analyse entsprechend unter der Kategorie "Argumentation" einordnen. Diese Kategorisierung erkennt an, dass die Studie von Krowicki und Böckelmann wichtige Argumente gegen die Annahme liefert, dass E-Learning-Programme stets effektiv sind, insbesondere in Bezug auf die Förderung gesunder Arbeitspraktiken in Telearbeitsumgebungen. Es wird gezeigt, dass ohne angemessene Unterstützung und Anpassungen solche Systeme potenziell sogar zu einer Zunahme von Belastungen führen können, was ein kritisches Argument für die sorgfältige Implementierung und Evaluation von Lernmanagementsystemen (LMS) darstellt.
},
	file = {Krowicki und Böckelmann - 2023 - Evaluation eines E-Learning-Programms zur Förderun.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/3BA848SF/Krowicki und Böckelmann - 2023 - Evaluation eines E-Learning-Programms zur Förderun.pdf:application/pdf},
}

@article{hejazi_effect_2023,
	title = {The {Effect} of {Practice} {Prescription} {E}-{Learning} {System} on {Learning} and {Motivation} of {Pharmacy} {Students}},
	issn = {2211-1662, 2211-1670},
	url = {https://link.springer.com/10.1007/s10758-023-09688-0},
	doi = {10/gsswbd},
	abstract = {Pharmacy education has seen a transformation with e-learning. Using a computer-supported collaborative learning environment has proven effective in achieving the learning objectives of the new curriculum in this field. The educational institutions offer the pharmacy internship course in the classroom and educational pharmacies in the presence of students. Because of Covid-19 restrictions, classes are being held online. Achieving the desired learning outcomes for this lesson can be challenging because of its practical and skill-based nature. As a result, creating customized learning experiences that align with the lesson’s objectives is crucial. This study was quasi-experimental and involved students who had selected an internship. The control group received traditional instruction, while the intervention group was taught using a combination of conventional education and an application. The learning outcomes were evaluated through learning and motivation tests using the MSLQ questionnaire. The intervention group had a mean score of 79 ± 0.117, while the control group had a mean score of 69 ± 0.195, showing that the intervention group had significantly higher learning (p {\textless} 0.05). Regarding motivation, the intervention group had a mean score of 110.4 ± 17.76, while the control group had a mean score of 113.94 ± 19.67, with no significant difference observed (p {\textgreater} 0.05). The application’s simulated pharmacy environment improved the conditions for trainees to read different prescription sheets, providing a realistic learning experience. Using the application increased students’ learning. Even though there was no significant variation in motivation between the two sets, students who used the app expressed a greater interest in education.},
	language = {en-GB},
	urldate = {2023-09-28},
	journal = {Technology, Knowledge and Learning},
	author = {Hejazi, Yamin and Emadzadeh, Setareh and Yavari, Mehri and Mastour, Haniye and Azad, Sajjad and Taherzadeh, Zhila},
	month = sep,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Kollaboratives Lernen, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, Bildung, Multimedia, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:Hejazi et al. (2023) untersuchen die Wirkung eines E-Learning-Systems für das Praktikum in der Pharmazie auf das Lernen und die Motivation von Pharmaziestudierenden. Sie evaluieren, wie eine web-basierte Applikation, die pharmazeutische Umgebungen simuliert, das Verständnis für medizinische Verschreibungen verbessert.
Verwendete Methoden und Datenquellen:Die Studie war quasi-experimentell und verglich eine Interventionsgruppe, die das E-Learning-System nutzte, mit einer Kontrollgruppe, die traditionellen Unterricht erhielt. Die Bewertung der Lernergebnisse erfolgte mittels Prüfungsergebnissen und die der Motivation durch den MSLQ-Fragebogen.
Zentrale Forschungsergebnisse:Es wurde festgestellt, dass die Interventionsgruppe signifikant bessere Lernergebnisse zeigte als die Kontrollgruppe, jedoch gab es keinen signifikanten Unterschied in der Motivation zwischen den Gruppen. Die Nutzung der App verbesserte die Fähigkeit der Studierenden, Verschreibungen zu lesen und zu verstehen, erheblich.
Zusammenfassung
Die Ergebnisse von Hejazi et al. belegen, dass die Integration von simulierten E-Learning-Plattformen in pharmazeutische Bildungsprogramme die Lerneffizienz steigern kann, auch wenn dies nicht notwendigerweise zu einer Erhöhung der Motivation führt. Diese Technologie ermöglicht eine realistischere und praktischere Lernerfahrung, die besonders in professionellen Kursen wie dem Pharmaziepraktikum von Nutzen ist.
Kernaussagen


"Die Verwendung der E-Learning-App führte zu einer signifikanten Verbesserung der Lernergebnisse im Vergleich zur traditionellen Lehrmethode." (S. 4)


"Es gab keinen signifikanten Unterschied in der Motivation zwischen den Studierenden der Interventions- und der Kontrollgruppe." (S. 3)


Argumentationslinien


Die Studie zeigt auf, dass technologiegestützte Lernumgebungen die Lerneffektivität erhöhen können, selbst wenn sie die Motivation nicht direkt beeinflussen.


Sie betont die Notwendigkeit, Bildungstechnologien sinnvoll einzusetzen, um die spezifischen Lernziele von professionellen Kursen effektiv zu unterstützen.


Verschlagwortung


Lehr- und Lerneffektivität: Die Ergebnisse unterstreichen die positive Wirkung der E-Learning-App auf das Verständnis und die Anwendung von Wissen in realen Szenarien.


Technologieintegration: Die Studie illustriert, wie digitale Lernwerkzeuge erfolgreich in professionelle Bildungsprogramme integriert werden können.


Systemanpassung: Die Anpassung des Lehrsystems an die Bedürfnisse der Studierenden durch die Implementierung von Technologie, die praxisnahe Erfahrungen simuliert.


Kollaboratives Lernen: Obwohl nicht direkt adressiert, unterstützt die Plattform durch ihre interaktive Natur möglicherweise kollaborative Lernansätze.


Kategorie: Weiterführung
Die Forschungsergebnisse legen nahe, dass weitere Untersuchungen notwendig sind, um die langfristigen Auswirkungen des Einsatzes solcher Technologien auf das Lernen und die professionelle Entwicklung zu verstehen. Es wäre sinnvoll, ähnliche Technologien in anderen Bereichen der medizinischen und pharmazeutischen Ausbildung einzusetzen, um deren breitere Anwendbarkeit und Wirksamkeit zu bewerten.
Ich ordne diese Quelle als Argumentation ein, da ich die Motivation als eine Grundlage der Wirkung ansehe
Verstanden, die Zuordnung dieser Studie zur Kategorie "Argumentation" ist nachvollziehbar, insbesondere wenn die Motivation als grundlegender Faktor für das Lernen betrachtet wird. Die Studie liefert wichtige Erkenntnisse darüber, wie technologiegestützte Lernumgebungen die Lerneffektivität beeinflussen können, auch wenn sie die Motivation nicht signifikant steigern. Dies bietet eine solide Grundlage für die Diskussion über die Rolle der Motivation und deren Beeinflussung durch E-Learning-Systeme in der Bildung.
},
	file = {Hejazi et al. - 2023 - The Effect of Practice Prescription E-Learning Sys.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/PIZLNUBL/Hejazi et al. - 2023 - The Effect of Practice Prescription E-Learning Sys.pdf:application/pdf},
}

@article{khamitova_innovative_2023,
	title = {Innovative {Learning} {Spaces} of {Higher} {Education}: a {Systematic} {Mapping} {Review} of {Themes}},
	issn = {8756-3894, 1559-7075},
	shorttitle = {Innovative {Learning} {Spaces} of {Higher} {Education}},
	url = {https://link.springer.com/10.1007/s11528-023-00892-4},
	doi = {10/gsr76g},
	abstract = {Current educational research and practice urge the reconceptualization of learning spaces' design, development, and usage. However, only some research studies address the formation of innovative learning spaces in higher education. This systematic mapping review (Grant \& Booth. Health Information \& Libraries Journal, 26, 91-108, 2009) focuses on identifying research trends and themes around innovative learning spaces in higher education and defining the innovative learning space as a concept. The analysis of 58 selected articles provides an overview of current literature with the identification of four themes such as 1) the design of the innovative learning spaces, 2) pedagogies employed in the innovative learning spaces, 3) students’ experiences in the innovative learning spaces, and 4) change management approaches towards the campus innovative learning space. The types of learning spaces influenced by the trends in pedagogy (towards constructivist approaches, such as active learning spaces) and technology (towards less physicality, such as hybrid learning spaces) are explored in this study. The analysis finalizes the challenges and recommendations for innovative learning space integration into campus teaching and learning experiences. It sets a foundation for further thematic analysis of innovative learning spaces literature.},
	language = {en-GB},
	urldate = {2023-09-22},
	journal = {TechTrends},
	author = {Khamitova, Aiman},
	month = sep,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, \#1:Zeitschriftenartikel:learning:management:system, Bildung, Multimedia, Krisenreaktion im Bildungsbereich, Lernsystemarchitektur, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	annote = {1. Analyse
Die Studie von Khamitova (2023) bietet eine systematische Übersicht zu innovativen Lernräumen in der Hochschulbildung, die Trends und Themen in diesem Bereich identifiziert. Der Schwerpunkt liegt darauf, wie diese Räume durch Technologieintegration und veränderte Lehrbedürfnisse geformt werden.
2. Zusammenfassung
Khamitova untersucht innovative Lernräume als multimodale, technologiegestützte physische und/oder hybride Lernumgebungen, die flexibel, kollaborativ und zukunftsorientiert sind. Die Analyse umfasst 58 Artikel, die vier Hauptthemen identifizieren: Design, pädagogische Ansätze, Schülererfahrungen und Change-Management-Ansätze in Bezug auf innovative Lernräume.
3. Kernaussagen


Definition und Konzeptualisierung: Innovative Lernräume werden als studentenzentrierte, technologieerweiterte Räume beschrieben, die flexibel auf die Bedürfnisse der Lernenden und Lehrenden reagieren (S. 2).


Themen und Forschungstrends: Die Studie zeigt, dass die meisten Forschungen sich auf das Design dieser Räume konzentrieren, gefolgt von den pädagogischen Methoden, die in diesen Räumen angewendet werden (S. 12-15).


Herausforderungen und Empfehlungen: Es gibt Herausforderungen in der Integration von innovativen Lernräumen, die eine sorgfältige Planung und Anpassung von Lehrmethoden erfordern, um deren Potenzial voll auszuschöpfen (S. 16-18).


4. Argumentationslinien


Bedeutung der Technologieintegration: Die Integration von Technologie ist zentral für die Entwicklung von Lernräumen, die Lehr- und Lernerfahrungen verbessern.


Change Management in Bildungseinrichtungen: Erfolgreiche Implementierung innovativer Lernräume erfordert wirksames Change Management, das alle Stakeholder einbezieht und auf pädagogische Exzellenz abzielt.


5. Verschlagwortung


Lernsystemarchitektur: Der Aufbau und die Gestaltung von Lernumgebungen, die technologisch fortgeschritten und anpassungsfähig sind.


Technologieintegration: Die zentrale Rolle der Technologie bei der Schaffung von Lernumgebungen, die effektives Lernen unterstützen.


Lehr- und Lerneffektivität: Die Verbesserung der Lehr- und Lernprozesse durch innovative Lernräume.


Krisenreaktion im Bildungsbereich: Anpassungsfähigkeit von Bildungseinrichtungen an neue Lehr- und Lernmethoden in Reaktion auf sich ändernde Bedingungen.


Forschungsansätze: Die systematische Untersuchung und Bewertung von Trends und Themen im Zusammenhang mit innovativen Lernräumen.


Diese Analyse unterstreicht die Bedeutung von innovativen Lernräumen in der Hochschulbildung und die Notwendigkeit, sowohl die technologischen als auch die pädagogischen Aspekte dieser Räume zu verstehen und zu optimieren.
},
	file = {Khamitova - 2023 - Innovative Learning Spaces of Higher Education a .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/C63Y6UKN/Khamitova - 2023 - Innovative Learning Spaces of Higher Education a .pdf:application/pdf},
}

@article{zurn_connect_2023,
	title = {„{Connect} {Rollout}“ – {Ein} {Simulationsspiel} zum {Projektmanagement}},
	abstract = {Successful project work requires a broad spectrum of methodological and social competences that must be combined with a high degree of understanding of complex situations and contexts. The International Project Management Association’s (IPMA) International Competence Baseline 4.0 (ICB4) offers a standardised competence framework, and the systems thinking approach provides an appropriate methodology for dealing with complexity. The business game presented here, “Connect Rollout”, focuses on acquiring competences in accordance with ICB4 and learning systems thinking methods in an international project environment. In this way, experience-based learning processes can be facilitated without risk, and the learning ability of each student can be increased.},
	language = {de-DE},
	journal = {Zeitschrift für Hochschulentwicklung},
	author = {Zürn, Siegfried and Costa, Ines DIAS},
	year = {2023},
	keywords = {Simulation, Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Weiterführung, \#1:Zeitschriftenartikel:learning:management:system, Bildung, Multimedia, Krisenreaktion im Bildungsbereich, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	annote = {1. Analyse
Die Studie von Zürn und Costa (2023) beschreibt die Entwicklung und den Einsatz des Simulationsspiels "Connect Rollout" zur Vermittlung von Projektmanagement-Kompetenzen unter Nutzung von Systemdenken. Dieses Simulationsspiel wurde speziell entworfen, um Studierenden der internationalen technischen Betriebswirtschaft praktische Erfahrungen in der Handhabung komplexer, grenzüberschreitender Projekte zu ermöglichen.
2. Zusammenfassung
"Connect Rollout" ist ein Planspiel, das in der Ausbildung zum internationalen Projektmanagement eingesetzt wird und darauf abzielt, Studierenden die erforderlichen Kompetenzen für die Durchführung großer Projekte zu vermitteln. Das Spiel verwendet das Konzept des Systemdenkens, um die Komplexität und Dynamik internationaler Projekte zu veranschaulichen. Es hilft den Teilnehmern, systemische Zusammenhänge und Wechselwirkungen in realen Projektsituationen zu verstehen und fördert gleichzeitig die Entwicklung von Problemlösungsstrategien.
3. Kernaussagen


Einsatz von Systemdenken: Das Spiel nutzt Systemdenken als Kernmethodik, um die Fähigkeiten zur Handhabung und Analyse komplexer Projekte zu entwickeln.


Erfahrungsbasiertes Lernen: "Connect Rollout" bietet eine immersive Lernerfahrung, die Studierende befähigt, theoretisches Wissen in einer risikofreien Umgebung praktisch anzuwenden.


Kompetenzentwicklung: Durch die Simulation erwerben die Studierenden umfassende Kompetenzen gemäß der International Competence Baseline 4.0 (ICB4), was sie auf reale internationale Projektmanagementaufgaben vorbereitet.


4. Argumentationslinien


Effektivität des Simulationsspiels: Die Autoren argumentieren, dass durch die realitätsnahe Simulation von Projektszenarien ein tiefgreifendes Verständnis für die Komplexität und Dynamik internationaler Projekte vermittelt wird.


Notwendigkeit praktischer Ausbildungsmethoden: Die Studie unterstreicht die Bedeutung praktischer Lehrmethoden in der Projektmanagementausbildung, insbesondere in einem internationalen Kontext.


5. Verschlagwortung


Systemanpassung: Anpassung von Lehrstrategien an komplexe und dynamische internationale Umgebungen.


Forschungsansätze: Integration von Systemdenken in die pädagogische Praxis zur Verbesserung der Projektmanagementausbildung.


Technologieintegration: Einsatz von digitalen Tools und Simulationen zur Veranschaulichung von Projektmanagementkonzepten.


Lehr- und Lerneffektivität: Verbesserung der Lehr- und Lerneffektivität durch simulationsbasierte Lehrmethoden.


Krisenreaktion im Bildungsbereich: Vorbereitung der Studierenden auf komplexe und unvorhersehbare Situationen in internationalen Projekten durch simulationsgestütztes Lernen.


Die Studie betont, wie wichtig es ist, moderne Lehrmethoden wie Simulationsspiele zu nutzen, um Studierenden die komplexen Fähigkeiten zu vermitteln, die sie benötigen, um in der globalisierten Welt von heute effektive Projektmanager zu sein.
},
	file = {Zürn und Costa - 2023 - „Connect Rollout“ – Ein Simulationsspiel zum Proje.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/NEZ55AAI/Zürn und Costa - 2023 - „Connect Rollout“ – Ein Simulationsspiel zum Proje.pdf:application/pdf},
}

