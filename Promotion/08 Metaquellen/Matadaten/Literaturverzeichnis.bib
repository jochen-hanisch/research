}

@article{ade_kooperative_2021,
	title = {Kooperative {Gestaltungsaufgaben} am {Tablet}: {Entwicklung} und {Erprobung} eines {Unterrichtsprojekts} für die {Grundschule}},
	volume = {42},
	issn = {1424-3636, 1424-3636},
	shorttitle = {Kooperative {Gestaltungsaufgaben} am {Tablet}},
	url = {10.21240/mpaed/42/2021.04.06.X},
	doi = {10/gksnx2},
	abstract = {Dem Einsatz digitaler Medien im Unterricht wird für kooperative Arbeitsformen ein Potenzial zur ‹Optimierung› der Lehr-Lernprozesse zugeschrieben. Aus der Perspektive der Unterrichtsforschung ist für grundschulbezogene Lehr-Lernprozesse zu klären, wie kooperatives Arbeiten mit digitalen Medien auf der Tiefenstruktur des Unterrichts durch lernprozessanregende Aufgaben sowie durch individuelle Lernunterstützung mithilfe von Kooperationsskripts unterstützt werden kann. Im vorliegenden Beitrag wird der Frage nachgegangen, wie kooperative Gestaltungsaufgaben am Tablet entwickelt werden können, um Schülerinnen und Schülern im Grundschulalter die kreative und reflektierte Gestaltung eines eigenen Medienbeitrags zu ermöglichen. Es wird ein iterativer, am Design-Based-Research-Ansatz angelehnter Entwicklungsprozess eines digital gestützten Unterrichtsprojekts für Kinder der dritten Klasse vorgestellt: Ausgehend von medienpädagogischen Überlegungen wurde eine Gestaltungsaufgabe am Tablet entwickelt und hinsichtlich des Grads der Lernunterstützung in zwei Varianten (V1, V2) mithilfe eines Kooperationsskripts erprobt. Die Ergebnisse der formativen Evaluation mittels halb-standardisierter Beobachtungen in fünf Grundschulklassen verweisen auf die grosse Bedeutsamkeit der Vorstrukturierung der Aufgabenstellung, die je nach Variation des Skripts eine stärkere Fokussierung der Kinder auf die sozialen Aushandlungsprozesse (V1) bzw. die inhaltliche Auseinandersetzung (V2) zeigt. Ausgehend von der Evaluation des Unterrichtsprojekts werden Chancen und Herausforderungen in Bezug auf die Merkmale der digital gestützten Gestaltungsaufgabe sowie hinsichtlich der Potenziale der Kooperationsskripts diskutiert.},
	language = {de-DE},
	urldate = {2021-06-20},
	journal = {MedienPädagogik: Zeitschrift für Theorie und Praxis der Medienbildung},
	author = {Ade, Larissa and Pohlmann-Rother, Sanna and Lange, Sarah Désirée},
	month = apr,
	year = {2021},
	note = {ZSCC: 0000000},
	keywords = {Promotion:Literaturanalyse, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:FU2a, Promotion:Relevanz:4, \#7:Zeitschriftenartikel:digital:Medien, Promotion:S:07 Digitale Medien, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU2a},
	pages = {85--107},
	annote = {Analyse der Studie "Kooperative Gestaltungsaufgaben am Tablet. Entwicklung und Erprobung eines Unterrichtsprojekts für die Grundschule" von Ade, Pohlmann-Rother und Lange (2021)
Hauptthemen und Ziele der Forschung:
Die Studie von Ade, Pohlmann-Rother und Lange (2021) untersucht die Entwicklung und Erprobung kooperativer Gestaltungsaufgaben am Tablet im Grundschulunterricht. Das Hauptziel der Forschung ist es, herauszufinden, wie solche Aufgaben entwickelt werden können, um Schülerinnen und Schüler im Grundschulalter zur kreativen und reflektierten Gestaltung eines eigenen Medienbeitrags zu befähigen. Der Fokus liegt auf der Erprobung zweier Varianten eines Kooperationsskripts und deren Auswirkungen auf die Lernprozesse und die soziale Interaktion der Schüler (S. 85-86).
Methoden und Datenquellen:
Die Studie basiert auf einem iterativen, am Design-Based-Research-Ansatz angelehnten Entwicklungsprozess. Das Unterrichtsprojekt wurde in fünf Grundschulklassen erprobt, wobei zwei Varianten des Kooperationsskripts getestet wurden. Daten wurden mittels halb-standardisierter Beobachtungen gesammelt und analysiert. Die Evaluation erfolgte durch Beobachtungen der Projektlehrkraft sowie der anwesenden Klassenlehrkräfte und studentischen Hilfskräfte, um eine umfassende Analyse der Unterrichtsprozesse zu gewährleisten (S. 86-88).
Zentrale Forschungsergebnisse:


Bedeutung der Vorstrukturierung: Die formative Evaluation zeigte, dass die Vorstrukturierung der Aufgabenstellung wesentlich für den Lernerfolg ist. Variante 1 (offenere Struktur) förderte stärker die sozialen Aushandlungsprozesse, während Variante 2 (strukturierter) die inhaltliche Arbeit und individuelle Verantwortlichkeit betonte (S. 88-90).


Unterstützung durch Kooperationsskripts: Beide Varianten der Kooperationsskripts unterstützten die Schüler bei der Gestaltung der multimedialen E-Books, jedoch mit unterschiedlichen Schwerpunkten. Variante 2 zeigte eine stärkere Unterstützung durch die Chef-Rollen und die vorgegebenen Dialogbausteine, was zu einer höheren individuellen Verantwortlichkeit führte (S. 90-92).


Reflexion und Peer-Feedback: Die Einbettung von Reflexionsphasen und Peer-Feedback förderte die Auseinandersetzung der Schüler mit den medialen Modi und deren Wirkweisen. Dies trug zur Verbesserung der Medienprodukte bei und unterstützte die Entwicklung der Medienkompetenz der Schüler (S. 92-93).


Zusammenfassung
Die Studie von Ade et al. (2021) untersucht die Entwicklung und Erprobung kooperativer Gestaltungsaufgaben am Tablet im Grundschulunterricht. Die Ergebnisse zeigen, dass die Vorstrukturierung der Aufgabenstellung und die Unterstützung durch Kooperationsskripts wesentlich für den Lernerfolg und die soziale Interaktion der Schüler sind. Die Reflexionsphasen und das Peer-Feedback tragen zur Verbesserung der Medienprodukte und zur Entwicklung der Medienkompetenz bei.
Kernaussagen


Bedeutung der Vorstrukturierung: Die Vorstrukturierung der Aufgabenstellung ist entscheidend für den Lernerfolg (S. 88-90).


Unterstützung durch Kooperationsskripts: Kooperationsskripts unterstützen die Schüler effektiv bei der Gestaltung der multimedialen E-Books, wobei unterschiedliche Schwerpunkte gesetzt werden (S. 90-92).


Reflexion und Peer-Feedback: Die Einbettung von Reflexionsphasen und Peer-Feedback fördert die Auseinandersetzung mit den medialen Modi und deren Wirkweisen (S. 92-93).


Argumentationslinien
Die Autoren argumentieren, dass die Vorstrukturierung der Aufgabenstellung und die Unterstützung durch Kooperationsskripts wesentlich für den Lernerfolg und die soziale Interaktion der Schüler sind. Sie heben hervor, dass Reflexionsphasen und Peer-Feedback wichtige Elemente sind, um die Medienkompetenz der Schüler zu fördern und die Qualität der Medienprodukte zu verbessern (S. 88-93).
Verschlagwortung
Passendste Schlagworte und Begründungen:


Kollaboratives Lernen: Die Studie untersucht die Nutzung kooperativer Gestaltungsaufgaben am Tablet zur Förderung der Zusammenarbeit und sozialen Interaktion der Schüler (S. 86-88).


Lehr- und Lerneffektivität: Die Ergebnisse zeigen, dass die Vorstrukturierung der Aufgabenstellung und die Unterstützung durch Kooperationsskripts die Lehr- und Lerneffektivität signifikant verbessern (S. 90-92).


Kategorisierung


Kerngedanke: Die zentrale Idee der Studie ist die Untersuchung der Entwicklung und Erprobung kooperativer Gestaltungsaufgaben am Tablet zur Förderung der kreativen und reflektierten Mediengestaltung im Grundschulunterricht (S. 85-86).


Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU2a: Effekt-Faktoren für Lernende im digitalen Bildungsraum.


Begründung: Die Studie analysiert die Effekte kooperativer Gestaltungsaufgaben und Kooperationsskripts auf die Lernprozesse und die soziale Interaktion der Schüler, was direkt die Frage nach den Effekt-Faktoren für Lernende im digitalen Bildungsraum betrifft (S. 86-90).
Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie untersucht umfassend die Entwicklung und Erprobung kooperativer Gestaltungsaufgaben am Tablet).


Zitierhäufigkeit und Einfluss: 4 (Die Studie basiert auf fundierten Methoden und ist gut dokumentiert).


Aktualität: 5 (Die Studie ist von 2021 und behandelt ein aktuelles Thema).


Gesamtbewertung: 5
Schlussfolgerung
Die Studie zeigt, dass die Vorstrukturierung der Aufgabenstellung und die Unterstützung durch Kooperationsskripts die Lehr- und Lerneffektivität sowie die soziale Interaktion der Schüler signifikant verbessern können. Reflexionsphasen und Peer-Feedback sind wichtige Elemente, um die Medienkompetenz der Schüler zu fördern und die Qualität der Medienprodukte zu verbessern. Die Ergebnisse bieten wertvolle Einblicke in die Entwicklung effektiver digital gestützter Unterrichtsformate im Grundschulbereich.
},
	file = {Ade et al. - 2021 - Kooperative Gestaltungsaufgaben am Tablet Entwick.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/2KEPWQ8W/Ade et al. - 2021 - Kooperative Gestaltungsaufgaben am Tablet Entwick.pdf:application/pdf},
}

@article{allert_optimierung_2021,
	title = {Optimierung als digital-kapitalistisch},
	volume = {42},
	issn = {1424-3636},
	url = {https://www.medienpaed.com/article/view/1113},
	doi = {10/gk5bfq},
	abstract = {This paper describes socio-material practices of digital nomads who live locationindependent and work online. Their business models are based on data-driven platforms. Optimizing oneself as an individual is understood as a key element of a digital capitalist logic. Based on an empirical study, the paper outlines digital capitalism as co-produced by individuals who do no longer understand themselves as citizens of specific states. Its main ideas can be traced back to the beginning of the development of the World Wide Web and what is called “new economy”.},
	language = {de-DE},
	urldate = {2021-07-08},
	journal = {MedienPädagogik: Zeitschrift für Theorie und Praxis der Medienbildung},
	author = {Allert, Heidrun},
	month = jun,
	year = {2021},
	note = {ZSCC: 0000000},
	keywords = {Promotion:Literaturanalyse, Promotion:FU4a, Technologieintegration, Systemanpassung, Promotion:Argumentation, Promotion:Relevanz:4, \#7:Zeitschriftenartikel:digital:Medien, Promotion:S:07 Digitale Medien, Promotion:Literaturverzeichnis},
	pages = {301--326},
	annote = {Analyse der Studie "Optimierung als digital-kapitalistisch" von Heidrun Allert (2021)
Hauptthemen und Ziele der Forschung:
Die Studie von Heidrun Allert (2021) untersucht die Optimierung des Individuums innerhalb einer digital-kapitalistischen Logik. Dabei betrachtet sie die Lebensweise von sogenannten digitalen Nomaden, die ortsunabhängig leben und online arbeiten. Diese Menschen generieren ihr Einkommen über datenbasierte, algorithmisch gesteuerte Plattformen. Die Studie zielt darauf ab, den Zusammenhang zwischen selbstermächtigendem Individualismus und Entstaatlichung aufzuzeigen und diese Praxisform als politisch zu rahmen (S. 301-302).
Methoden und Datenquellen:
Die Studie basiert auf einer empirischen Untersuchung in Form einer Online-Ethnographie. Dabei wurden die sozio-materiellen Praktiken von digitalen Nomaden analysiert, die ihre Lebensweise und Geschäftsmodelle auf Social Media teilen. Das Untersuchungsmaterial umfasst Instagram-Postings, YouTube-Videos, Podcasts und Blogbeiträge von insgesamt 51 Social Media Accounts. Die Datenerhebung erstreckte sich über sieben Monate von Februar bis August 2020 (S. 306-307).
Zentrale Forschungsergebnisse:


Optimierung des Individuums: Die Praxis der Selbstoptimierung wird als zentraler Bestandteil der digital-kapitalistischen Logik dargestellt. Digitale Nomaden nutzen Plattformen wie Amazon, AirBnB und Instagram, um ihre Sichtbarkeit und Reichweite zu maximieren und dadurch ihre Geschäftsmodelle zu optimieren (S. 304-305).


Entstaatlichung und Individualismus: Es wird ein starkes Misstrauen gegenüber staatlichen Institutionen und eine Ablehnung gesellschaftlicher Strukturen festgestellt. Die digitale Nomadenbewegung propagiert Eigenverantwortung, finanzielle Unabhängigkeit und eine Entkopplung von staatlicher Regulierung (S. 315-316).


Politische Dimension: Trotz des individuellen Rahmens dieser Lebensweise werden die Praktiken als hochpolitisch eingestuft. Sie tragen zur Verbreitung der Ideologie des digitalen Kapitalismus bei und formen neue kulturelle Muster und Praktiken, die tief in die Gesellschaft hineinwirken (S. 304-305).


Zusammenfassung
Die Studie von Heidrun Allert (2021) untersucht die Optimierung des Individuums innerhalb einer digital-kapitalistischen Logik anhand der Lebensweise digitaler Nomaden. Die Ergebnisse zeigen, dass diese Praktiken stark individualistisch und entstaatlichend sind, jedoch gleichzeitig politisch und kulturell bedeutsam. Die Selbstoptimierung und Nutzung datenbasierter Plattformen sind zentrale Elemente dieser Lebensweise.
Kernaussagen


Optimierung des Individuums: Die Selbstoptimierung wird als zentraler Bestandteil der digital-kapitalistischen Logik betrachtet (S. 304-305).


Entstaatlichung und Individualismus: Die digitale Nomadenbewegung lehnt staatliche Institutionen ab und propagiert Eigenverantwortung und finanzielle Unabhängigkeit (S. 315-316).


Politische Dimension: Die Praktiken der digitalen Nomaden sind hochpolitisch und formen neue kulturelle Muster und Praktiken (S. 304-305).


Argumentationslinien
Die Autorin argumentiert, dass die Selbstoptimierung und Entstaatlichung der digitalen Nomaden eng mit der Logik des digitalen Kapitalismus verknüpft sind. Sie betont, dass diese Praktiken politisch sind und neue kulturelle Muster formen, die tief in die Gesellschaft hineinwirken (S. 304-316).
Verschlagwortung
Passendste Schlagworte und Begründungen:


Technologieintegration: Die Untersuchung zeigt, wie digitale Nomaden datenbasierte Plattformen nutzen, um ihre Geschäftsmodelle zu optimieren und ihre Lebensweise zu gestalten (S. 304-305).


Systemanpassung: Die Studie verdeutlicht, wie digitale Nomaden ihre Lebensweise und Geschäftsmodelle flexibel an die Möglichkeiten und Grenzen der Plattformökonomie anpassen (S. 315-316).


Kategorisierung


Kerngedanke: Die zentrale Idee der Studie ist die Untersuchung der Optimierung des Individuums innerhalb einer digital-kapitalistischen Logik und der politischen Dimension dieser Praxisformen (S. 301-302).


Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU4a: Bildungswissenschaftliche Mechanismen bei Anwendung eines LMS.


Begründung: Die Studie analysiert die Mechanismen der Selbstoptimierung und der Nutzung digitaler Plattformen, was direkt die Frage nach den bildungswissenschaftlichen Mechanismen bei der Anwendung eines LMS betrifft (S. 304-305).
Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 4 (Die Studie untersucht relevante Mechanismen, geht aber nicht explizit auf Bildungssysteme ein).


Zitierhäufigkeit und Einfluss: 3 (Die Studie basiert auf fundierten Methoden, aber es fehlen umfassende empirische Daten zur Verallgemeinerung).


Aktualität: 5 (Die Studie ist von 2021 und behandelt ein aktuelles Thema).


Gesamtbewertung: 4
Schlussfolgerung
Die Studie zeigt, dass die Selbstoptimierung und die Nutzung datenbasierter Plattformen zentrale Elemente der digital-kapitalistischen Logik sind. Diese Praktiken sind politisch und formen neue kulturelle Muster, die tief in die Gesellschaft hineinwirken. Die Ergebnisse bieten wertvolle Einblicke in die Mechanismen des digitalen Kapitalismus und deren Auswirkungen auf individuelle Lebensweisen und gesellschaftliche Strukturen.
},
	file = {Allert - 2021 - Optimierung als digital-kapitalistisch.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/WFCIXJLX/Allert - 2021 - Optimierung als digital-kapitalistisch.pdf:application/pdf},
}

@article{wedler_selbstreferentialitat_2020,
	title = {Selbstreferentialität und {Historisierung} als {Werkzeuge} medialen {Handelns} im bildungswissenschaftlichen {Kontext}: {Zum} {Potenzial} populärer {Kultur} im {Erarbeitungsprozess} erklärender {Kurzfilme}},
	issn = {1424-3636, 1424-3636},
	shorttitle = {Selbstreferentialität und {Historisierung} als {Werkzeuge} medialen {Handelns} im bildungswissenschaftlichen {Kontext}},
	url = {10.21240/mpaed/jb17/2020.05.02.X},
	doi = {10/gg5cxb},
	abstract = {Due to the potential of digital teaching and learning formats, the didactic design of seminars, for example, is changing in such a way that the acquisition of knowledge increasingly adapts to the life environment of students. In the following article, the influence of an individual process of knowledge acquisition on the product will be shown by means of student works. The explanatory videos created by the students demonstrate with their transformed texts in combination with Pop Art Clips a current form of representation of Popular Culture and thus establish the state of the art, both visually and textually. The challenge in developing an explanatory video for a scientific discourse was to combine complex theory with a practical example to support the facts. In their videos, the students mostly rely on their own experiences, from which their understanding of the world also emerges. The storytelling shows how the performativity around the individual world and the process of subjectivation as a form of education contributes to the acquisition of knowledge in popular culture.},
	language = {de-DE},
	urldate = {2021-06-20},
	journal = {MedienPädagogik: Zeitschrift für Theorie und Praxis der Medienbildung},
	author = {Wedler, Katharina},
	month = may,
	year = {2020},
	note = {ZSCC: 0000001},
	keywords = {Promotion:Literaturanalyse, Promotion:FU4a, Promotion:Kerngedanke, Promotion:Relevanz:5, Bildungstheorien, \#0:Zeitschriftenartikel:digital:learning, Promotion:S:12 Digital Learning, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {217--243},
	annote = {Analyse der Studie "Selbstreferentialität und Historisierung als Werkzeuge medialen Handelns im bildungswissenschaftlichen Kontext. Zum Potenzial populärer Kultur im Erarbeitungsprozess erklärender Kurzfilme" von Katharina Wedler (2020)
Hauptthemen und Ziele der Forschung:
Die Studie von Katharina Wedler (2020) untersucht, wie Selbstreferentialität und Historisierung als Werkzeuge medialen Handelns im bildungswissenschaftlichen Kontext genutzt werden können. Das Hauptziel der Forschung ist es, das Potenzial populärer Kultur im Erarbeitungsprozess erklärender Kurzfilme aufzuzeigen. Die Autorin möchte demonstrieren, wie studentische Arbeiten in Form von Erklärvideos die Verbindung zwischen theoretischem Wissen und persönlicher Erfahrung herstellen und dadurch den Lernprozess bereichern (S. 217-218).
Methoden und Datenquellen:


Studentische Arbeiten: Analyse von Erklärvideos, die von Studierenden im Rahmen eines erziehungswissenschaftlichen Seminars erstellt wurden. Diese Videos dienen als Beispiel für die Anwendung von Selbstreferentialität und Historisierung (S. 218-219).


Theoretischer Rahmen: Anwendung des Konzepts der populären Kultur und dessen Rolle in der Wissensvermittlung. Bezug auf das TPACK-Modell (Technological Pedagogical Content Knowledge) zur Verknüpfung von Fachwissen, pädagogischem Wissen und technologischen Fähigkeiten (S. 225-226).


Zentrale Forschungsergebnisse:


Selbstreferentialität und Historisierung: Die Analyse zeigt, dass Studierende in ihren Erklärvideos häufig auf persönliche Erfahrungen zurückgreifen und diese mit theoretischen Konzepten verbinden. Dies fördert ein tieferes Verständnis und eine bessere Verankerung des Gelernten (S. 218-219).


Potenzial populärer Kultur: Die Nutzung populärer Kultur als Darstellungsform in den Erklärvideos hilft, komplexe theoretische Inhalte zugänglicher und verständlicher zu machen. Popkulturelle Elemente wie Storytelling und visuelle Gestaltung tragen zur Motivation und zum Engagement der Lernenden bei (S. 218-219).


Zusammenfassung
Die Studie von Katharina Wedler (2020) zeigt, dass Selbstreferentialität und Historisierung effektive Werkzeuge im bildungswissenschaftlichen Kontext sind, um den Lernprozess zu unterstützen. Die Integration populärer Kultur in Erklärvideos ermöglicht es den Studierenden, theoretisches Wissen mit persönlichen Erfahrungen zu verknüpfen und dadurch ein tieferes Verständnis zu entwickeln.
Kernaussagen


Selbstreferentialität und Historisierung: Diese Werkzeuge fördern die Verbindung zwischen theoretischem Wissen und persönlicher Erfahrung, was zu einem tieferen Verständnis führt (S. 218-219).


Populäre Kultur: Die Nutzung populärer Kultur in Erklärvideos macht theoretische Inhalte zugänglicher und motiviert die Lernenden (S. 218-219).


Argumentationslinien
Die Autorin argumentiert, dass Selbstreferentialität und Historisierung als didaktische Werkzeuge im digitalen Lernkontext genutzt werden können, um Lernprozesse zu unterstützen. Durch die Einbindung populärer Kultur in Erklärvideos können Studierende theoretische Konzepte besser verstehen und anwenden, da diese Methoden eine Brücke zwischen abstraktem Wissen und konkreter Erfahrung schlagen (S. 218-219).
Verschlagwortung
Passendste Schlagworte und Begründungen:


Bildungstheorien:


Die Studie untersucht, wie Selbstreferentialität und Historisierung als didaktische Werkzeuge zur Wissensvermittlung eingesetzt werden können (S. 218-219).




Lehr- und Lerneffektivität:


Die Ergebnisse zeigen, dass die Nutzung populärer Kultur in Erklärvideos die Lernmotivation und das Verständnis theoretischer Inhalte verbessert (S. 218-219).




Kategorisierung


Argumentation: Die Studie nutzt theoretische Konzepte und empirische Daten, um die These zu stützen, dass Selbstreferentialität und Historisierung effektive Werkzeuge zur Unterstützung des Lernprozesses im digitalen Bildungsumfeld sind (S. 218-219).


Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU4a: Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?


Begründung: Die Studie untersucht, wie didaktische Werkzeuge wie Selbstreferentialität und Historisierung im digitalen Bildungsumfeld angewendet werden können, um die Lernprozesse und -ergebnisse der Studierenden zu verbessern (S. 218-219).
Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie untersucht umfassend die Nutzung und Wirkung didaktischer Werkzeuge zur Unterstützung des Lernprozesses).


Zitierhäufigkeit und Einfluss: 4 (Die Studie ist methodisch stark und behandelt ein relevantes Thema, das potenziell oft zitiert wird).


Aktualität: 5 (Die Studie ist von 2020 und behandelt ein hochaktuelles Thema).


Gesamtbewertung: 4.67
Schlussfolgerung
Die Studie von Katharina Wedler (2020) zeigt, dass Selbstreferentialität und Historisierung effektive Werkzeuge im digitalen Lernkontext sind, um den Lernprozess zu unterstützen. Durch die Einbindung populärer Kultur in Erklärvideos können Studierende theoretische Konzepte besser verstehen und anwenden. Diese Methoden fördern die Verbindung zwischen abstraktem Wissen und konkreter Erfahrung, was zu einem tieferen Verständnis und einer höheren Lernmotivation führt.
},
	file = {Wedler - 2020 - Selbstreferentialität und Historisierung als Werkz.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/YPEQ68JT/Wedler - 2020 - Selbstreferentialität und Historisierung als Werkz.pdf:application/pdf},
}

@article{alberti_vanessa_digitale_2022,
	title = {Digitale {Kompetenzen} {Lehrender}. {Zur} {Möglichkeit} ihrer {Integration} in {Modelle} generisch pädagogischer {Kompetenzen} am {Beispiel} von {GRETA}},
	copyright = {Creative Commons Namensnennung 4.0 International},
	url = {https://www.pedocs.de/frontdoor.php?source_opus=24475},
	doi = {10/gp5j94},
	abstract = {Competent implementation of educational programs requires (adult) education, professional and didactic competences as well as technological and media education competences. Summarized here as digital competences, the last two are increasingly important against the backdrop of the COVID-19 pandemic. Yet how are digital and educational competences interrelated and what would such a competence model look like? This article deals with the relation between educational and digital competences and presents the possibility for integrated representation in a competence model for teachers of adult education and continuing education as exemplified by the GRETA competence model. The conceptual and empirical work should yield the GRETA competence model 2.0, which is viable for all adult education teachers. (DIPF/Orig.)},
	language = {de-DE},
	urldate = {2022-05-14},
	publisher = {Bundesministerium für Bildung, Wissenschaft und Forschung},
	author = {Alberti, Vanessa and Strauch, Anne and Brandt, Peter},
	month = may,
	year = {2022},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Promotion:Argumentation, Promotion:Relevanz:4, \#7:Zeitschriftenartikel:digital:Medien, Promotion:FU5, Bildung, Deutschland, Digitale Bildung, Germany, Professionalisierung, Professionalization, Kompetenz, Erwachsenenbildner, Media pedagogics, Medienpädagogik, Competency, Further education, Weiterbildung, Modell, Media competence, Media skills, Adult pedagogics, Erwachsenenpädagogik, Pedagogics for adults, Weiterbildner, Promotion:S:07 Digitale Medien, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU5},
	annote = {Analyse der Studie "Digitale Kompetenzen Lehrender. Zur Möglichkeit ihrer Integration in Modelle generisch pädagogischer Kompetenzen am Beispiel von GRETA" von Alberti, Strauch und Brandt (2022)
Hauptthemen und Ziele der Forschung:
Die Studie von Alberti, Strauch und Brandt (2022) untersucht die Integration digitaler Kompetenzen in bestehende Modelle pädagogischer Kompetenzen, speziell am Beispiel des GRETA-Kompetenzmodells. Das Hauptziel der Forschung ist es, ein umfassendes Kompetenzmodell zu entwickeln, das sowohl digitale als auch pädagogische Kompetenzen für Lehrende in der Erwachsenen- und Weiterbildung abdeckt. Der Fokus liegt darauf, die Anforderungen und Herausforderungen der Digitalisierung in die bestehenden pädagogischen Kompetenzmodelle zu integrieren (S. 1-2).
Methoden und Datenquellen:
Die Studie basiert auf einer qualitativen Inhaltsanalyse von Literatur und Materialien, die digitale Kompetenzen und deren Relevanz für die Erwachsenenbildung untersuchen. Es wurden 38 Artikel, Beiträge in Sammelbänden, Monografien, Handreichungen, Internetdokumente und Berichte ausgewertet. Die Analyse erfolgte mittels eines deduktiven und induktiven Kategoriensystems, das auf den Kompetenzaspekten und -facetten des GRETA-Modells basiert (S. 2-4).
Zentrale Forschungsergebnisse:


Passung digitaler und pädagogischer Kompetenzen: Die Analyse zeigte eine hohe Passung zwischen den digitalen Kompetenzanforderungen und den bestehenden pädagogischen Kompetenzen des GRETA-Modells. Digitale Kompetenzen lassen sich in die Kompetenzbereiche Berufspraktisches Wissen und Können, Fach- und feldspezifisches Wissen sowie Professionelle Selbststeuerung integrieren (S. 4-6).


Keine neuen Kompetenzaspekte: Es wurde festgestellt, dass keine neuen Kompetenzaspekte geschaffen werden müssen, sondern dass die bestehenden Facetten des GRETA-Modells durch digitale Inhalte ergänzt werden können. Dies verdeutlicht, dass digitale Kompetenzen als Erweiterung der bestehenden pädagogischen Kompetenzen betrachtet werden sollten (S. 6-7).


Notwendigkeit der Integration: Die Studie betont die Notwendigkeit, digitale Kompetenzen in die pädagogischen Kompetenzmodelle zu integrieren, um den Anforderungen der modernen Lehr-Lern-Szenarien gerecht zu werden. Diese Integration ist unerlässlich für die professionelle Entwicklung und die Praxis der Lehrenden in der Erwachsenenbildung (S. 7-8).


Zusammenfassung
Die Studie von Alberti et al. (2022) untersucht die Möglichkeit der Integration digitaler Kompetenzen in bestehende pädagogische Kompetenzmodelle am Beispiel des GRETA-Modells. Die Ergebnisse zeigen, dass digitale Kompetenzen eine Erweiterung der bestehenden pädagogischen Kompetenzen darstellen und sich nahtlos in die bestehenden Kompetenzbereiche integrieren lassen. Die Studie betont die Bedeutung dieser Integration für die professionelle Entwicklung der Lehrenden in der Erwachsenenbildung.
Kernaussagen


Passung digitaler und pädagogischer Kompetenzen: Die digitalen Kompetenzen lassen sich nahtlos in die bestehenden pädagogischen Kompetenzbereiche des GRETA-Modells integrieren (S. 4-6).


Keine neuen Kompetenzaspekte erforderlich: Digitale Kompetenzen sollten als Erweiterung der bestehenden pädagogischen Kompetenzen betrachtet werden (S. 6-7).


Notwendigkeit der Integration: Die Integration digitaler Kompetenzen ist entscheidend für die professionelle Entwicklung und Praxis der Lehrenden in der Erwachsenenbildung (S. 7-8).


Argumentationslinien
Die Autoren argumentieren, dass digitale Kompetenzen eng mit den pädagogischen Kompetenzen verknüpft sind und daher in bestehende Kompetenzmodelle integriert werden sollten. Sie betonen, dass diese Integration notwendig ist, um den Herausforderungen der Digitalisierung gerecht zu werden und die professionelle Entwicklung der Lehrenden zu unterstützen (S. 4-8).
Verschlagwortung
Passendste Schlagworte und Begründungen:


Lehr- und Lerneffektivität: Die Integration digitaler Kompetenzen in pädagogische Modelle zielt darauf ab, die Effektivität der Lehr- und Lernprozesse zu verbessern, indem Lehrende besser auf digitale Herausforderungen vorbereitet werden (S. 7-8).


Technologieintegration: Die Untersuchung der Einbindung digitaler Kompetenzen in bestehende Kompetenzmodelle verdeutlicht die Notwendigkeit und die Möglichkeiten der Technologieintegration in der Erwachsenenbildung (S. 1-2).


Kategorisierung


Kerngedanke: Die zentrale Idee der Studie ist die Untersuchung der Möglichkeit und Notwendigkeit der Integration digitaler Kompetenzen in bestehende pädagogische Kompetenzmodelle am Beispiel des GRETA-Modells (S. 1-2).


Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU5: Möglichkeiten und Grenzen eines LMS.


Begründung: Die Studie analysiert die Möglichkeiten der Integration digitaler Kompetenzen in bestehende Kompetenzmodelle und untersucht die damit verbundenen Herausforderungen, was direkt die Frage nach den Möglichkeiten und Grenzen eines LMS betrifft (S. 7-8).
Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie untersucht umfassend die Integration digitaler Kompetenzen in pädagogische Kompetenzmodelle).


Zitierhäufigkeit und Einfluss: 4 (Die Studie basiert auf fundierten Methoden und ist gut dokumentiert).


Aktualität: 5 (Die Studie ist von 2022 und behandelt ein aktuelles Thema).


Gesamtbewertung: 5
Schlussfolgerung
Die Studie zeigt, dass digitale Kompetenzen als Erweiterung der bestehenden pädagogischen Kompetenzen in die Kompetenzmodelle der Erwachsenenbildung integriert werden sollten. Diese Integration ist notwendig, um den Anforderungen der Digitalisierung gerecht zu werden und die professionelle Entwicklung der Lehrenden zu unterstützen. Die Ergebnisse bieten wertvolle Einblicke und Empfehlungen für die Weiterentwicklung von Kompetenzmodellen in der Erwachsenenbildung.
},
	file = {Alberti, Vanessa et al. - 2022 - Digitale Kompetenzen Lehrender. Zur Möglichkeit ih.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/7CH2KGDV/Alberti, Vanessa et al. - 2022 - Digitale Kompetenzen Lehrender. Zur Möglichkeit ih.pdf:application/pdf},
}

