@article{li_development_2020,
	title = {Development and {Assessment} of a {Gastroscopy} {Electronic} {Learning} {System} for {Primary} {Learners}: {Randomized} {Controlled} {Trial}},
	volume = {22},
	url = {http://www.jmir.org/2020/3/e16233/},
	doi = {10.2196/16233},
	abstract = {Background: Endoscopic examination is a popular and routine procedure for the diagnosis and treatment of gastrointestinal (GI) diseases. Skilled endoscopists are in great demand in clinical practice, but the training process for beginners to become endoscopy specialists is fairly long. Convenience and a self-paced, learner-centered approach make electronic learning (e-learning) an excellent instructional prospect. Objective: This study aimed to develop and apply an e-learning system in gastroscopy teaching and learning and to evaluate its effectiveness and user satisfaction. Methods: The e-learning software Gastroscope Roaming System was developed for primary learners. The system simulates the real structure of the upper gastrointestinal (UGI) tract to teach the main characteristics of gastroscopy under both normal conditions and conditions of common UGI tract diseases. A randomized controlled trial was conducted. Participants were randomly allocated to an e-learning group (EG)or a non?e-learning control group after a pretest. On completing the training, participants undertook a posttest and gastroscopy examination. In addition, the EG completed a satisfaction questionnaire. Results: Of the 44 volunteers, 41 (93\%) completed the gastroscopy learning and testing components. No significant pretest differences were found between the intervention and control groups (mean 50.86, SD 6.12 vs mean 50.76, SD 6.88; P=.96). After 1 month of learning, the EG?s posttest scores were higher (mean 83.70, SD 5.99 vs mean 78.76, SD 7.58; P=.03) and improved more (P=.01) than those of the control group, with better performance in the gastroscopy examination (mean 91.05, SD 4.58 vs mean 84.38, SD 5.19; P{\textless}.001). Overall, 85\% (17/20) of the participants were satisfied with the e-learning system, and 95\% (19/20) of the participants considered it successful. Conclusions: E-learning is an effective educational strategy for primary learners to acquire skills in gastroscopy examination and endoscopic imaging of the GI tract. Trial Registration: Chinese Clinical Trial Registry ChiCTR-IOR-17013091; http://www.chictr.org.cn/showproj.aspx?proj=22142},
	number = {3},
	journal = {J Med Internet Res},
	author = {Li, Shuang and Li, Guoqing and Liu, Ying and Xu, Wanying and Yang, Ningning and Chen, Haoyuan and Li, Ning and Luo, Kunpeng and Jin, Shizhu},
	month = mar,
	year = {2020},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Digitale Bildung, Promotion:Schlussfolgerung, \#5:Zeitschriftenartikel:e-learning, randomized controlled trial, endoscopy, gastroscopy, Promotion:S:05 E-Learning, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {e16233},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:
Die Studie von Li et al. (2020) untersucht die Entwicklung und Bewertung eines elektronischen Lernsystems für Gastroskopie, das auf Anfänger abzielt. Ziel ist es, die Wirksamkeit und Benutzerzufriedenheit des Gastroscope Roaming Systems (GRS) zu bewerten, das eine realistische Simulation des oberen Gastrointestinaltrakts bietet, um die Fähigkeiten der Lernenden in der Gastroskopie zu verbessern.
Verwendete Methoden und Datenquellen:


Entwicklung des Systems: Das GRS wurde in Zusammenarbeit mit der Harbin University of Science and Technology entwickelt. Es umfasst eine 3D-Modellierung des oberen Gastrointestinaltrakts und simuliert sowohl normale als auch krankhafte Zustände.


Teilnehmer: 44 freiwillige Masterstudierende der Gastroenterologie und Hepatologie an der Second Affiliated Hospital of Harbin Medical University nahmen an der Studie teil. Nach dem Pretest wurden die Teilnehmenden zufällig in eine E-Learning-Gruppe (EG) und eine Kontrollgruppe (CG) aufgeteilt.


Evaluierung: Die Wirksamkeit des Systems wurde durch einen Pretest und einen Posttest sowie eine praktische Gastroskopieprüfung nach einem Monat bewertet. Die Zufriedenheit der EG wurde durch einen Fragebogen erfasst.


Zentrale Forschungsergebnisse:


Lernerfolg: Die Posttest-Ergebnisse der EG waren signifikant höher als die der CG (P = .03), ebenso wie die Verbesserungen der Testergebnisse (P = .01). Auch die praktische Gastroskopieprüfung zeigte bessere Ergebnisse für die EG (P {\textless} .001).


Zufriedenheit: 85\% der EG-Teilnehmer waren mit dem GRS zufrieden, und 95\% betrachteten das System als erfolgreich.


Zusammenfassung
Die Studie zeigt, dass das GRS ein effektives E-Learning-Tool zur Verbesserung der Gastroskopie-Fähigkeiten von Anfängern ist. Das System ermöglicht es den Lernenden, ihre Kenntnisse und praktischen Fähigkeiten zu verbessern, was durch signifikant bessere Testergebnisse und hohe Zufriedenheitsraten belegt wird.
Kernaussagen


„E-learning is an effective educational strategy for primary learners to acquire skills in gastroscopy examination and endoscopic imaging of the GI tract.“ (S. 1)


„The posttest results of the EG were better than those of the CG (P = .03), and the test scores of the EG improved more than those of the CG (P = .01).“ (S. 5)


„Overall, 85\% of the participants were satisfied with the e-learning system, and 95\% of the participants considered it successful.“ (S. 5)


Argumentationslinien


Effektivität von E-Learning: Die Studie argumentiert, dass E-Learning ein wirksames Mittel ist, um die Fähigkeiten in der Gastroskopie zu verbessern, insbesondere durch die Kombination von theoretischem Wissen und praktischen Fähigkeiten. (S. 5)


Blended Learning: E-Learning in Kombination mit traditionellem Lernen, also Blended Learning, wurde als besonders effektiv bewertet. (S. 6)


Zufriedenheit und Akzeptanz: Hohe Zufriedenheitsraten bei den Lernenden bestätigen die Akzeptanz und den Erfolg des GRS als ergänzendes Lehrmittel. (S. 6)


Verschlagwortung


Lehr- und Lerneffektivität: Untersuchung der Effektivität von E-Learning-Tools zur Verbesserung der praktischen Fähigkeiten in der Medizin.


Technologieintegration: Integration von 3D-Modellen und Simulationstechnologien in die medizinische Ausbildung.


Systemanpassung: Anpassung der Lehrmethoden an die Bedürfnisse von Anfängern im Bereich der Gastroskopie.


Forschungsansätze: Anwendung randomisierter kontrollierter Studien zur Bewertung der Wirksamkeit von E-Learning-Systemen.


Kategorisierung: Schlussfolgerung
Begründung:
Die Studie von Li et al. (2020) zieht aus der Entwicklung und Bewertung des Gastroscope Roaming Systems die Schlussfolgerung, dass E-Learning ein wirksames Mittel zur Verbesserung der praktischen Fähigkeiten in der Gastroskopie darstellt. Diese Schlussfolgerungen bieten eine Grundlage für die Weiterentwicklung von E-Learning-Tools und deren Integration in die medizinische Ausbildung. Dies ist besonders relevant für die Forschungsfrage: „Wie wird ein systemisch-konstruktivistisches Learning-Management-System als Kompetenzerwerbssystem bei Akteuren im digitalen Bildungsraum von Gesundheitsberufen beurteilt?“ Die Ergebnisse der Studie zeigen, dass das GRS als effektives Kompetenzentwicklungssystem anerkannt wird und zur Verbesserung der praktischen Fähigkeiten beiträgt.
Kategorie: Schlussfolgerung
},
	file = {Li et al. - 2020 - Development and Assessment of a Gastroscopy Electr.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/H65YWWSM/Li et al. - 2020 - Development and Assessment of a Gastroscopy Electr.pdf:application/pdf},
}

@article{koka_teaching_2020,
	title = {Teaching the {National} {Institutes} of {Health} {Stroke} {Scale} to {Paramedics} ({E}-{Learning} vs {Video}): {Randomized} {Controlled} {Trial}},
	volume = {22},
	url = {http://www.jmir.org/2020/6/e18358/},
	doi = {10.2196/18358},
	abstract = {Background: Prompt and accurate identification of stroke victims is essential to reduce time from symptom onset to adequate treatment and to improve neurological outcomes. Most neurologists evaluate the extent of neurological deficit according to the National Institutes of Health Stroke Scale (NIHSS), but the use of this scale by paramedics, the first healthcare providers to usually take care of stroke victims, has proven unreliable. This might be, at least in part, due to the teaching method. The video used to teach NIHSS lacks interactivity, while more engaging electronic learning (e-learning) methods might improve knowledge acquisition. Objective: This study was designed to evaluate whether a highly interactive e-learning module could enhance NIHSS knowledge acquisition in paramedics. Methods: A randomized controlled trial comparing a specially designed e-learning module with the original NIHSS video was performed with paramedics working in Geneva, Switzerland. A registration number was not required as our study does not come into the scope of the Swiss federal law on human research. The protocol was nevertheless submitted to the local ethics committee (Project ID 2017-00847), which issued a ?Declaration of no objection.? Paramedics were excluded if they had prior knowledge of or previous training in the NIHSS, or if they had worked in a neurology or neurosurgery ward. The primary outcome was overall performance in the study quiz, which contained 50 questions. Secondary outcomes were performance by NIHSS item, time to course and quiz completion, user satisfaction regarding the learning method, user perception of the course duration, and probability the user would recommend the course to a colleague. Results: The study was completed by 39 paramedics. There was a better overall median score (36/50 vs 33/50, P=.04) and a higher degree of satisfaction regarding the learning method in the e-learning group (90\% vs 37\%, P=.002). Users who had followed the e-learning module were more likely to recommend the course to a colleague (95\% vs 63\%, P=.02). Paramedics in the e-learning group took more time to complete the course (93 vs 59 minutes, P{\textless}.001), but considered the duration to be more adequate (75\% vs 32\%, P=.01). Time to quiz completion was similar between groups (25 vs 38 minutes, P=.12). Conclusions: Use of an e-learning module shows promising results in teaching the NIHSS to paramedics.},
	number = {6},
	journal = {J Med Internet Res},
	author = {Koka, Avinash and Suppan, Laurent and Cottet, Philippe and Carrera, Emmanuel and Stuby, Loric and Suppan, Mélanie},
	month = jun,
	year = {2020},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Technologieintegration, Systemanpassung, Digitale Bildung, Promotion:Schlussfolgerung, online learning, \#5:Zeitschriftenartikel:e-learning, stroke, active learning, video, electronic learning, Promotion:S:05 E-Learning, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {e18358},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:
Die Studie von Koka et al. (2020) untersucht die Wirksamkeit eines interaktiven E-Learning-Moduls im Vergleich zu einem Video zur Vermittlung der National Institutes of Health Stroke Scale (NIHSS) an Rettungssanitäter. Ziel der Forschung ist es, zu evaluieren, ob ein E-Learning-Modul die Wissensvermittlung und Benutzerzufriedenheit im Vergleich zur traditionellen Video-Methode verbessert.
Verwendete Methoden und Datenquellen:


Studiendesign: Randomisierte kontrollierte Studie mit Rettungssanitätern in Genf, Schweiz. Die Teilnehmer wurden in zwei Gruppen eingeteilt: eine E-Learning-Gruppe und eine Video-Gruppe.


Intervention: Das E-Learning-Modul bestand aus 184 interaktiven Folien, die in Kapitel unterteilt waren. Das ursprüngliche NIHSS-Video wurde in der Kontrollgruppe verwendet.


Datenerhebung: Leistung im Studienquiz mit 50 Fragen als primäres Ergebnismaß, sowie Zufriedenheit der Nutzer und Wahrscheinlichkeit, den Kurs weiterzuempfehlen, als sekundäre Ergebnismaße.


Zentrale Forschungsergebnisse:


Leistung: Die E-Learning-Gruppe erzielte im Studienquiz signifikant bessere Ergebnisse als die Video-Gruppe (Median 36/50 vs. 33/50, P=.04).


Zufriedenheit: Die Zufriedenheit mit der Lernmethode war in der E-Learning-Gruppe höher (90\% vs. 37\%, P=.002), und die Wahrscheinlichkeit, den Kurs einem Kollegen zu empfehlen, war ebenfalls höher (95\% vs. 63\%, P=.02).


Zeitaufwand: Die E-Learning-Gruppe benötigte mehr Zeit zur Kursabschließung (Median 93 Minuten vs. 59 Minuten, P{\textless}.001), betrachtete die Dauer jedoch als angemessener (75\% vs. 32\%, P=.01).


Zusammenfassung
Die Studie zeigt, dass ein interaktives E-Learning-Modul ein effektives Mittel zur Vermittlung der NIHSS an Rettungssanitäter ist. Die Teilnehmer der E-Learning-Gruppe erzielten bessere Leistungen, zeigten höhere Zufriedenheitsraten und waren eher bereit, den Kurs weiterzuempfehlen, obwohl sie mehr Zeit für den Kurs benötigten.
Kernaussagen


„Die E-Learning-Gruppe zeigte eine bessere Gesamtleistung im Quiz im Vergleich zur Video-Gruppe.“ (S. 3)


„Die Zufriedenheit mit der Lernmethode war in der E-Learning-Gruppe höher, und die Teilnehmer empfahlen den Kurs eher weiter.“ (S. 4)


„Die E-Learning-Gruppe benötigte mehr Zeit zur Kursabschließung, betrachtete die Dauer jedoch als angemessener.“ (S. 4)


Argumentationslinien


Effektivität von E-Learning: Die Studie argumentiert, dass interaktive E-Learning-Module durch höhere Interaktivität und Benutzerbeteiligung die Wissensvermittlung verbessern können. (S. 4-5)


Benutzerzufriedenheit: Höhere Zufriedenheitsraten in der E-Learning-Gruppe werden auf die Interaktivität des Moduls zurückgeführt, die das Engagement der Lernenden fördert. (S. 5)


Zeitaufwand: Der längere Zeitaufwand für die E-Learning-Gruppe wird durch die Möglichkeit, Inhalte interaktiv zu erkunden und zu wiederholen, gerechtfertigt. (S. 5)


Verschlagwortung


Lehr- und Lerneffektivität: Untersuchung der Effektivität von E-Learning-Tools zur Verbesserung der praktischen Fähigkeiten in der Schlaganfallerkennung.


Technologieintegration: Integration von interaktiven Modulen und Videos in die Ausbildung von Rettungssanitätern.


Systemanpassung: Anpassung der Lehrmethoden an die Bedürfnisse der präklinischen Notfallversorgung.


Forschungsansätze: Anwendung randomisierter kontrollierter Studien zur Bewertung der Wirksamkeit von E-Learning-Systemen.


Kategorisierung: Schlussfolgerung
Begründung:
Die Studie von Koka et al. (2020) zieht aus der Untersuchung der Wirksamkeit des interaktiven E-Learning-Moduls zur Vermittlung der NIHSS die Schlussfolgerung, dass E-Learning ein wirksames Mittel zur Verbesserung der praktischen Fähigkeiten und der Zufriedenheit der Rettungssanitäter darstellt. Diese Schlussfolgerungen bieten eine Grundlage für die Weiterentwicklung von E-Learning-Tools und deren Integration in die präklinische Ausbildung. Dies ist besonders relevant für die Forschungsfrage: „Wie wird ein systemisch-konstruktivistisches Learning-Management-System als Kompetenzerwerbssystem bei Akteuren im digitalen Bildungsraum von Gesundheitsberufen beurteilt?“ Die Ergebnisse der Studie zeigen, dass das E-Learning-Modul als effektives Kompetenzentwicklungssystem anerkannt wird und zur Verbesserung der praktischen Fähigkeiten beiträgt.
Kategorie: Schlussfolgerung
},
	file = {Koka et al. - 2020 - Teaching the National Institutes of Health Stroke .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/QIQI8TRJ/Koka et al. - 2020 - Teaching the National Institutes of Health Stroke .pdf:application/pdf},
}

@article{ray_e-learning_2019,
	title = {An {E}-{Learning} {Adaptation} of an {Evidence}-{Based} {Media} {Literacy} {Curriculum} to {Prevent} {Youth} {Substance} {Use} in {Community} {Groups}: {Development} and {Feasibility} of {REAL} {Media}},
	volume = {3},
	url = {http://formative.jmir.org/2019/2/e12132/},
	doi = {10.2196/12132},
	abstract = {Background: There is a need for evidence-based substance use prevention efforts that target high school-aged youth that are easy to implement and suitable for dissemination in school and community groups. The Youth Message Development (YMD) program is a brief, four-lesson, in-person curriculum that aims to prevent youth substance use through the development of youth media literacy. Specifically, YMD aims to increase understanding of advertising reach and costs, along with the techniques used to sell products; develop counterarguing and critical thinking skills in response to advertisements; and facilitate application of these skills to the development of youth-generated antisubstance messages. Although YMD has demonstrated evidence of success, it is limited by its delivery method and focus on alcohol and smoking. Objective: Study objectives were two-fold: (1) to adapt the YMD curriculum to a self-paced, interactive, electronic-learning (e-learning) format and expand its content to cover alcohol, combustible cigarettes, e-cigarettes, smokeless tobacco, marijuana, and prescription drugs, and (2) to test the feasibility of the adapted curriculum in partnership with a national youth organization. Methods: An iterative process was employed in partnership with the 4-H youth development organization and a technology developer and consisted of six phases: (1) focus groups to guide adaptation, (2) adaptation to an e-learning format renamed REAL media, (3) pilot-testing of the REAL media prototype to determine feasibility and acceptability, (4) program revisions, (5) usability testing of the revised prototype, and (6) final revisions. Focus groups and pilot and usability testing were conducted with 4-H youth club members and adult club leaders. Results: Focus group feedback guided the build of an e-learning prototype of REAL media, which consisted of five online levels and interactive content guided by a mix of narration and on-screen text. Results of a pilot test of the prototype were neutral to positive, and the program was refined based on end-user feedback. An independent usability test indicated that youth 4-H members felt favorably about navigating REAL media, and they reported high self-efficacy in applying skills learned in the program. Additional refinements to the program were made based on their feedback. Conclusions: The iterative build process involving the end user from the outset yielded an overall successful technology-driven adaptation of an evidence-based curriculum. This should increase the likelihood of effectively impacting behavioral outcomes as well as uptake within community organizations.},
	number = {2},
	journal = {JMIR Form Res},
	author = {Ray, E. Anne and Greene, Kathryn and Hecht, L. Michael and Barriage, C. Sarah and Miller-Day, Michelle and Glenn, D. Shannon and Banerjee, C. Smita},
	month = may,
	year = {2019},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, Bildung, Multimedia, Digitale Bildung, media literacy, \#5:Zeitschriftenartikel:e-learning, substance use, prevention, adaptation, Promotion:S:05 E-Learning, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {e12132},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:
Die Studie von Ray et al. (2019) untersucht die Entwicklung und Durchführbarkeit eines E-Learning-Programms namens "REAL Media" zur Prävention von Substanzmissbrauch bei Jugendlichen. Ziel der Forschung ist es, ein evidenzbasiertes, in Präsenz durchgeführtes Medienkompetenz-Curriculum für Jugendliche in ein interaktives, selbstgesteuertes E-Learning-Format zu überführen und dessen Machbarkeit in Zusammenarbeit mit der 4-H-Jugendorganisation zu testen.
Verwendete Methoden und Datenquellen:


Iterativer Anpassungsprozess: Der Anpassungsprozess bestand aus sechs Phasen:


Fokusgruppen zur Anpassung des Curriculums


Entwicklung eines E-Learning-Prototyps


Pilot-Test des Prototyps zur Bestimmung der Machbarkeit und Akzeptanz


Programmrevisionen basierend auf Pilot-Test-Ergebnissen


Usability-Test des überarbeiteten Prototyps


Finale Überarbeitung




Teilnehmer: Mitglieder und Leiter von 4-H-Clubs in New Jersey und Maryland wurden in den verschiedenen Phasen des Prozesses einbezogen.


Bewertungsmethoden: Surveys zur Bewertung der Benutzerfreundlichkeit und des Engagements, Selbstwirksamkeitstests und offene Feedbackfragen.


Zentrale Forschungsergebnisse:


Fokusgruppen-Feedback: Die Rückmeldungen der Fokusgruppen halfen bei der Erstellung eines E-Learning-Prototyps, der aus fünf Online-Ebenen bestand und interaktive Inhalte umfasste.


Pilot-Test-Ergebnisse: Die Ergebnisse waren neutral bis positiv, und das Programm wurde basierend auf dem Feedback der Endbenutzer verfeinert.


Usability-Test: Jugendmitglieder der 4-H-Organisation fanden die Navigation von REAL Media gut und berichteten über eine hohe Selbstwirksamkeit bei der Anwendung der im Programm erlernten Fähigkeiten.


Zusammenfassung
Die iterative Entwicklung eines technologiegestützten, evidenzbasierten Curriculums führte zu einer erfolgreichen Anpassung des Programms. Das E-Learning-Programm "REAL Media" zeigte positive Rückmeldungen in Bezug auf Benutzerfreundlichkeit und Engagement und hat das Potenzial, das Verhalten der Teilnehmer positiv zu beeinflussen und innerhalb von Gemeinschaftsorganisationen angenommen zu werden.
Kernaussagen


„Die iterative Entwicklung eines technologiegestützten Curriculums führte zu einer erfolgreichen Anpassung und positiven Rückmeldungen von den Endnutzern.“ (S. 1)


„REAL Media erhielt hohe Bewertungen für Benutzerfreundlichkeit und Engagement und zeigte eine hohe Selbstwirksamkeit der Jugendlichen bei der Anwendung der erlernten Fähigkeiten.“ (S. 8)


„Das Programm wurde basierend auf dem Feedback aus Fokusgruppen und Pilot-Tests kontinuierlich verbessert.“ (S. 5)


Argumentationslinien


Iterativer Entwicklungsprozess: Die Studie argumentiert, dass ein iterativer Entwicklungsprozess, der die Endnutzer von Anfang an einbezieht, entscheidend für die erfolgreiche Anpassung und Akzeptanz eines E-Learning-Programms ist. (S. 3-4)


Benutzerfreundlichkeit und Engagement: Das Feedback der Benutzer zeigt, dass eine gute Benutzerfreundlichkeit und ein hohes Engagement durch interaktive Inhalte und positive Rückmeldungen erreicht werden können. (S. 8-9)


Selbstwirksamkeit: Die Studie hebt hervor, dass die Teilnehmer eine hohe Selbstwirksamkeit bei der Anwendung der im Programm erlernten Fähigkeiten berichteten, was ein Indikator für die Wirksamkeit des Programms ist. (S. 8)


Verschlagwortung


Lehr- und Lerneffektivität: Untersuchung der Effektivität von E-Learning-Programmen zur Verbesserung der Medienkompetenz und Prävention von Substanzmissbrauch.


Technologieintegration: Nutzung von E-Learning-Tools zur Implementierung eines evidenzbasierten Präventionscurriculums.


Systemanpassung: Anpassung und Implementierung eines Präventionsprogramms in Gemeinschaftsorganisationen.


Forschungsansätze: Iterativer Entwicklungsprozess und Usability-Tests zur Bewertung und Verbesserung des Programms.


Kategorisierung: Argumentation
Begründung:
Die Studie von Ray et al. (2019) verwendet verschiedene Quellen und Theorien, um die Wirksamkeit und den Entwicklungsprozess eines E-Learning-Programms zur Prävention von Substanzmissbrauch zu unterstützen. Durch den iterativen Entwicklungsprozess und die Einbeziehung von Endnutzern wird die Anpassung des Curriculums begründet und argumentiert, dass diese Methodik zur erfolgreichen Implementierung und Akzeptanz des Programms beiträgt. Diese Argumentationslinien sind besonders relevant für die Forschungsfragen des Exposés, da sie die theoretischen und praktischen Anwendungen von E-Learning-Methoden im digitalen Bildungsraum beleuchten und deren Wirkung auf die Akteure im Gesundheitswesen beschreiben.
Kategorie: Argumentation
Forschungsfrage: Welche bildungstechnologischen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems in Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?
Begründung:
Die Studie von Ray et al. (2019) untersucht den iterativen Entwicklungsprozess eines E-Learning-Programms und dessen Auswirkungen auf die Prävention von Substanzmissbrauch bei Jugendlichen. Der iterative Prozess, der die Endnutzer von Anfang an einbezieht, stellt einen bildungstechnologischen Mechanismus dar, der die Akzeptanz und Effektivität des Programms erhöht. Dies ist relevant für die Forschungsfrage, da es zeigt, wie technologische Anpassungen und die Einbeziehung von Benutzerfeedback zur erfolgreichen Implementierung und Nutzung eines digitalen Lernsystems führen können.
},
	file = {Ray et al. - 2019 - An E-Learning Adaptation of an Evidence-Based Medi.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/UBHFPALB/Ray et al. - 2019 - An E-Learning Adaptation of an Evidence-Based Medi.pdf:application/pdf},
}

@article{chen_effectiveness_2013,
	title = {Effectiveness of {YouTube} as a {Source} of {Medical} {Information} on {Heart} {Transplantation}},
	volume = {2},
	url = {http://www.i-jmr.org/2013/2/e28/},
	doi = {10.2196/ijmr.2669},
	abstract = {Background: In this digital era, there is a growing tendency to use the popular Internet site YouTube as a new electronic-learning (e-learning) means for continuing medical education. Heart transplantation (HTx) remains the most viable option for patients with end-stage heart failure or severe coronary artery disease. There are plenty of freely accessible YouTube videos providing medical information about HTx. Objective: The aim of the present study is to determine the effectiveness of YouTube as an e-learning source on HTx. Methods: In order to carry out this study, YouTube was searched for videos uploaded containing surgical-related information using the four keywords: (1) ?heart transplantation?, (2) ?cardiac transplantation?, (3) ?heart transplantation operation?, and (4) ?cardiac transplantation operation?. Only videos in English (with comments or subtitles in English language) were included. Two experienced cardiac surgeons watched each video (N=1800) and classified them as useful, misleading, or recipients videos based on the HTx-relevant information. The kappa statistic was used to measure interobserver variability. Data was analyzed according to six types of YouTube characteristics including ?total viewership?, ?duration?, ?source?, ?days since upload?, ?scores? given by the viewers, and specialized information contents of the videos. Results: A total of 342/1800  (19.00\%) videos had relevant information about HTx. Of these 342 videos, 215 (62.8\%) videos had useful information about specialized knowledge, 7/342 (2.0\%) were found to be misleading, and 120/342 (35.1\%) only concerned recipients? individual issues. Useful videos had 56.09\% of total viewership share (2,175,845/3,878,890), whereas misleading had 35.47\% (1,375,673/3,878,890). Independent user channel videos accounted for a smaller proportion (19\% in total numbers) but might have a wider impact on Web viewers, with the highest mean views/day (mean 39, SD 107) among four kinds of channels to distribute HTx-related information. Conclusions: YouTube videos on HTx benefit medical professionals by providing a substantial amount of information. However, it is a time-consuming course to find high-quality videos. More authoritative videos by trusted sources should be posted for dissemination of reliable information. With an improvement of ranking system and content providers in future, YouTube, as a freely accessible outlet, will help to meet the huge informational needs of medical staffs and promote medical education on HTx.},
	number = {2},
	journal = {Interact J Med Res},
	author = {Chen, He-Ming and Hu, Zhong-Kai and Zheng, Xiao-Lin and Yuan, Zhao-Shun and Xu, Zhao-Bin and Yuan, Ling-Qing and Perez, Jesus Vinicio A. De and Yuan, Ke and Orcholski, Mark and Liao, Xiao-Bo},
	month = nov,
	year = {2013},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Promotion:Argumentation, Datenschutz und IT-Sicherheit, Digitale Bildung, Internet, Promotion:FU4b, \#5:Zeitschriftenartikel:e-learning, medical informatics, YouTube, heart transplantation, online videos, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU4b},
	pages = {e28},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:
Die Studie von Chen et al. (2013) untersucht die Effektivität von YouTube als Quelle medizinischer Informationen über Herztransplantationen (HTx). Ziel ist es, die Qualität, Verfügbarkeit und Nützlichkeit von YouTube-Videos als E-Learning-Quelle für medizinisches Fachpersonal zu bewerten.
Verwendete Methoden und Datenquellen:


Design: Querschnittsanalyse


Datenquellen: YouTube-Videos, die relevante Informationen zu HTx enthalten, wurden anhand von vier Suchbegriffen identifiziert: „heart transplantation“, „cardiac transplantation“, „heart transplantation operation“ und „cardiac transplantation operation“.


Evaluationsmethoden: Zwei erfahrene Herzchirurgen bewerteten die Videos hinsichtlich ihrer Nützlichkeit, irreführenden Inhalte und rezipientenbezogenen Informationen. Der Kappa-Statistik wurde verwendet, um die Interobserver-Variabilität zu messen.


Zentrale Forschungsergebnisse:


Nützlichkeit der Videos: Von 1800 gesichteten Videos enthielten 342 (19\%) relevante Informationen über HTx. Davon waren 215 (62,8\%) nützlich, 7 (2\%) irreführend und 120 (35,1\%) rezipientenbezogen.


Betrachterzahlen und Quellen: Nützliche Videos hatten 56,09\% des gesamten Zuschaueranteils, während irreführende Videos 35,47\% hatten. Videos von unabhängigen Nutzern machten einen kleineren Anteil (19\%) aus, hatten jedoch die höchste durchschnittliche tägliche Anzahl an Aufrufen.


Zusammenfassung
Die Studie zeigt, dass YouTube-Videos eine erhebliche Menge an Informationen über Herztransplantationen bieten, die für medizinisches Fachpersonal nützlich sein können. Es ist jedoch zeitaufwendig, qualitativ hochwertige Videos zu finden. Die Autoren schlagen vor, dass mehr autoritative Videos von vertrauenswürdigen Quellen hochgeladen werden sollten, um zuverlässige Informationen zu verbreiten.
Kernaussagen


„Von 1800 gesichteten Videos enthielten 342 (19\%) relevante Informationen über HTx.“ (S. 3)


„Nützliche Videos hatten 56,09\% des gesamten Zuschaueranteils, während irreführende Videos 35,47\% hatten.“ (S. 4)


„Videos von unabhängigen Nutzern machten einen kleineren Anteil (19\%) aus, hatten jedoch die höchste durchschnittliche tägliche Anzahl an Aufrufen.“ (S. 5)


Argumentationslinien


Effektivität von YouTube: Die Studie argumentiert, dass YouTube eine effektive Quelle für medizinische Informationen sein kann, jedoch nur, wenn die Videos von hoher Qualität und vertrauenswürdigen Quellen stammen. (S. 6)


Herausforderungen der Videoqualität: Die Vielfalt der Videoqualität auf YouTube stellt eine Herausforderung dar, da viele Videos irreführend oder nicht nützlich sind. (S. 7)


Notwendigkeit für autoritative Quellen: Es wird betont, dass mehr Videos von anerkannten Institutionen hochgeladen werden sollten, um die Qualität und Zuverlässigkeit der Informationen zu verbessern. (S. 8)


Verschlagwortung


Lehr- und Lerneffektivität: Untersuchung der Effektivität von YouTube-Videos zur Bereitstellung medizinischer Informationen und Identifizierung von Herausforderungen in der Videoqualität.


Technologieintegration: Nutzung von YouTube als Plattform zur Unterstützung des E-Learnings im medizinischen Bereich.


Datenschutz und IT-Sicherheit: Sicherstellung der Qualität und Zuverlässigkeit von Online-Videos durch autoritative Quellen.


Forschungsansätze: Querschnittsanalyse zur Bewertung der Nützlichkeit und Qualität von YouTube-Videos.


Kategorisierung: Argumentation
Begründung:
Die Studie von Chen et al. (2013) liefert Argumente für die Nutzung von YouTube als E-Learning-Quelle für medizinische Informationen. Durch die detaillierte Analyse der Videoqualität und die Identifizierung der Herausforderungen bei der Suche nach nützlichen Videos wird argumentiert, dass YouTube als Lernplattform verbessert werden muss, um den Anforderungen von medizinischem Fachpersonal gerecht zu werden. Diese Argumentationslinien sind besonders relevant für die Forschungsfragen des Exposés, da sie die praktischen und theoretischen Aspekte der Nutzung von YouTube für medizinische Bildung beleuchten.
Kategorie: Argumentation
Zuordnung zur Forschungsfrage
FU4b: Welche bildungstechnologischen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems in Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?
Begründung:
Die Studie untersucht die Mechanismen der Nutzung von YouTube als bildungstechnologisches Werkzeug zur Bereitstellung von medizinischen Informationen. Diese Erkenntnisse sind besonders relevant, um die bildungstechnologischen Mechanismen eines systemisch-konstruktivistischen Learning-Management-Systems im digitalen Bildungsraum von Gesundheitsberufen zu verstehen und zu optimieren.
},
	file = {Chen et al. - 2013 - Effectiveness of YouTube as a Source of Medical In.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/C3IKER7B/Chen et al. - 2013 - Effectiveness of YouTube as a Source of Medical In.pdf:application/pdf},
}

@article{lee_mobile_2018,
	title = {Mobile {Technology} in {E}-{Learning} for {Undergraduate} {Medical} {Education} on {Emergent} {Otorhinolaryngology}?{Head} and {Neck} {Surgery} {Disorders}: {Pilot} {Randomized} {Controlled} {Trial}},
	volume = {4},
	url = {http://mededu.jmir.org/2018/1/e8/},
	doi = {10.2196/mededu.9237},
	abstract = {Background: The use of mobile technology in e-learning (M-TEL) can add new levels of experience and significantly increase the attractiveness of e-learning in medical education. Whether an innovative interactive e-learning multimedia (IM) module or a conventional PowerPoint show (PPS) module using M-TEL to teach emergent otorhinolaryngology?head and neck surgery (ORL-HNS) disorders is feasible and efficient in undergraduate medical students is unknown. Objective: The aim of this study was to compare the impact of a novel IM module with a conventional PPS module using M-TEL for emergent ORL-HNS disorders with regard to learning outcomes, satisfaction, and learning experience. Methods: This pilot study was conducted at an academic teaching hospital and included 24 undergraduate medical students who were novices in ORL-HNS. The cognitive style was determined using the Group Embedded Figures Test. The participants were randomly allocated (1:1) to one of the two groups matched by age, sex, and cognitive style: the IM group and the PPS group. During the 100-min learning period, the participants were unblinded to use the IM or PPS courseware on a 7-inch tablet. Pretests and posttests using multiple-choice questions to evaluate knowledge and multimedia situational tests to evaluate competence were administered. Participants evaluated their satisfaction and learning experience by the AttrakDiff2 questionnaire, and provided feedback about the modules. Results: Overall, the participants had significant gains in knowledge (median of percentage change 71, 95\% CI 1-100, P{\textless}.001) and competence (median of percentage change 25, 95\% CI 0-33, P=.007) after 100 min of learning. Although there was no significant difference in knowledge gain between the two groups (median of difference of percentage change 24, 95\% CI ?75 to 36; P=.55), competence gain was significantly lower in the IM group compared with the PPS group (median of difference of percentage change ?41, 95\% CI ?67 to ?20; P=.008). However, the IM group had significantly higher scores of satisfaction (difference 2, 95\% CI 2-4; P=.01), pragmatic quality (difference 1.7, 95\% CI 0.1-2.7; P=.03), and hedonic stimulation (difference 1.9, 95\% CI 0.3-3.1; P=.01) compared with the PPS group. Qualitative feedback indicated that the various games in the IM module attracted the participants? attention but that the nonlinearly arranged materials affected their learning. Conclusions: Using M-TEL for undergraduate medical education on emergent ORL-HNS disorders, an IM module seems to be useful for gaining knowledge, but competency may need to occur elsewhere. While the small sample size reduces the statistical power of our results, its design seems to be appropriate to determine the effects of M-TEL using a larger group. Trial Registration: ClinicalTrials.gov NCT02971735; https://clinicaltrials.gov/ct2/show/NCT02971735 (Archived by WebCite at http://www.webcitation.org/6waoOpCEV)},
	number = {1},
	journal = {JMIR Med Educ},
	author = {Lee, Li-Ang and Wang, Shu-Ling and Chao, Yi-Ping and Tsai, Ming-Shao and Hsin, Li-Jen and Kang, Chung-Jan and Fu, Chia-Hsiang and Chao, Wei-Chieh and Huang, Chung-Guei and Li, Hsueh-Yu and Chuang, Cheng-Keng},
	month = mar,
	year = {2018},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, Digitale Bildung, Promotion:FU4b, \#5:Zeitschriftenartikel:e-learning, mobile technology, randomized controlled trial, gamification, video lecture, Promotion:S:05 E-Learning, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {e8},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:
Die Studie von Lee et al. (2018) untersucht die Auswirkungen von mobiler Technologie im E-Learning (M-TEL) auf die Ausbildung von Medizinstudenten in Notfällen der Otorhinolaryngologie–Kopf- und Halschirurgie (ORL-HNS). Ziel der Forschung ist es, die Wirksamkeit und Effizienz eines interaktiven Multimedia-(IM)-Moduls im Vergleich zu einem herkömmlichen PowerPoint-Show-(PPS)-Modul zu bewerten.
Verwendete Methoden und Datenquellen:
	•	Design: Pilot-Randomisiert-kontrollierte Studie.
	•	Teilnehmer: 24 Medizinstudenten, die keine Vorkenntnisse in ORL-HNS hatten.
	•	Evaluationsmethoden: Multiple-Choice-Fragen (MCQs) zur Wissensbewertung und Multimedia-Situational-Tests (MSTs) zur Kompetenzbewertung vor und nach der Intervention. Zufriedenheits- und Lernerfahrungsfragebögen (AttrakDiff2) zur Bewertung der Nutzerzufriedenheit und -erfahrung.
Zentrale Forschungsergebnisse:
	•	Wissenszuwachs: Beide Gruppen zeigten einen signifikanten Wissenszuwachs nach der Lernperiode. Es gab keinen signifikanten Unterschied im Wissenszuwachs zwischen der IM- und der PPS-Gruppe.
	•	Kompetenzzuwachs: Die PPS-Gruppe zeigte einen signifikant höheren Kompetenzzuwachs im Vergleich zur IM-Gruppe.
	•	Zufriedenheit: Die IM-Gruppe erzielte höhere Zufriedenheitswerte sowie höhere Werte in der pragmatischen Qualität und hedonischen Stimulation im Vergleich zur PPS-Gruppe.
	•	Nutzerfeedback: Qualitatives Feedback zeigte, dass die IM-Gruppe das Lernen als „spaßig“ und „anregend“ empfand, während die PPS-Gruppe das Modul als „klar strukturiert“ und „leicht verständlich“ beschrieb.
Zusammenfassung
Die Studie zeigt, dass M-TEL ein effektives Mittel zur Wissensvermittlung in der medizinischen Ausbildung sein kann. Während das interaktive Multimedia-Modul (IM) zu einer höheren Zufriedenheit führte, zeigte das herkömmliche PowerPoint-Show-Modul (PPS) einen größeren Kompetenzzuwachs. Die Ergebnisse deuten darauf hin, dass verschiedene Lernmodule unterschiedliche Stärken haben und möglicherweise kombiniert werden sollten, um optimale Lernergebnisse zu erzielen.
Kernaussagen
	•	„Die IM-Gruppe erzielte höhere Zufriedenheitswerte sowie höhere Werte in der pragmatischen Qualität und hedonischen Stimulation im Vergleich zur PPS-Gruppe.“ (S. 9)
	•	„Die PPS-Gruppe zeigte einen signifikant höheren Kompetenzzuwachs im Vergleich zur IM-Gruppe.“ (S. 9)
	•	„Beide Gruppen zeigten einen signifikanten Wissenszuwachs nach der Lernperiode.“ (S. 8)
Argumentationslinien
	•	Effektivität von M-TEL: Die Studie argumentiert, dass mobile Technologie im E-Learning (M-TEL) effektiv zur Wissensvermittlung beiträgt, aber die Kompetenzentwicklung möglicherweise mehr strukturierte Lernansätze erfordert. (S. 8-9)
	•	Lernerfahrung und Zufriedenheit: Die höhere Zufriedenheit und hedonische Stimulation in der IM-Gruppe zeigt, dass interaktive und spielerische Lernmethoden das Engagement der Lernenden erhöhen können. (S. 9)
	•	Nutzerzentrierung: Die Studie betont die Bedeutung der Anpassung von Lernmethoden an die Präferenzen und Bedürfnisse der Lernenden, um die Effektivität des Lernens zu maximieren. (S. 11)
Verschlagwortung
	•	Technologieintegration: Nutzung von mobilen Technologien zur Unterstützung des E-Learnings in der medizinischen Ausbildung.
	•	Lehr- und Lerneffektivität: Untersuchung der Effektivität verschiedener E-Learning-Module zur Wissens- und Kompetenzvermittlung.
	•	Systemanpassung: Anpassung der Lernmodule an die spezifischen Bedürfnisse und Präferenzen der Medizinstudenten.
	•	Forschungsansätze: Pilot-Randomisiert-kontrollierte Studie zur Bewertung der Wirksamkeit von E-Learning-Methoden.
Kategorisierung: Argumentation
Begründung:
Die Studie von Lee et al. (2018) verwendet verschiedene quantitative und qualitative Methoden, um die Effektivität und Zufriedenheit von mobilen E-Learning-Technologien zu bewerten. Durch die detaillierte Analyse der unterschiedlichen Auswirkungen der Lernmodule auf Wissen, Kompetenz und Zufriedenheit wird argumentiert, dass eine Kombination verschiedener Lernansätze notwendig ist, um optimale Lernergebnisse zu erzielen. Diese Argumentationslinien sind besonders relevant für die Forschungsfragen des Exposés, da sie die theoretischen und praktischen Aspekte der Implementierung von M-TEL im digitalen Bildungsraum beleuchten.
Kategorie: Argumentation
Zuordnung zur Forschungsfrage
FU4b: Welche bildungstechnologischen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems in Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?
Begründung:
Die Studie untersucht die bildungstechnologischen Mechanismen, die durch die Anwendung von mobilen Technologien im E-Learning aktiviert werden. Diese Erkenntnisse sind besonders relevant, um die Wirkungen eines systemisch-konstruktivistischen Learning-Management-Systems auf die Akteure im digitalen Bildungsraum von Gesundheitsberufen zu verstehen und zu optimieren.
},
	file = {Lee et al. - 2018 - Mobile Technology in E-Learning for Undergraduate .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/NCQ3S8DN/Lee et al. - 2018 - Mobile Technology in E-Learning for Undergraduate .pdf:application/pdf},
}

@article{fontaine_effectiveness_2017,
	title = {Effectiveness of {Adaptive} {E}-{Learning} {Environments} on {Knowledge}, {Competence}, and {Behavior} in {Health} {Professionals} and {Students}: {Protocol} for a {Systematic} {Review} and {Meta}-{Analysis}},
	volume = {6},
	url = {http://www.researchprotocols.org/2017/7/e128/},
	doi = {10.2196/resprot.8085},
	abstract = {Background: Adaptive e-learning environments (AEEs) can provide tailored instruction by adapting content, navigation, presentation, multimedia, and tools to each user?s navigation behavior, individual objectives, knowledge, and preferences. AEEs can have various levels of complexity, ranging from systems using a simple adaptive functionality to systems using artificial intelligence. While AEEs are promising, their effectiveness for the education of health professionals and health professions students remains unclear. Objective: The purpose of this systematic review is to assess the effectiveness of AEEs in improving knowledge, competence, and behavior in health professionals and students. Methods: We will follow the Cochrane Collaboration and the Effective Practice and Organisation of Care (EPOC) Group guidelines on systematic review methodology. A systematic search of the literature will be conducted in 6 bibliographic databases (CINAHL, EMBASE, ERIC, PsycINFO, PubMed, and Web of Science) using the concepts ?adaptive e-learning environments,? ?health professionals/students,? and ?effects on knowledge/skills/behavior.? We will include randomized and nonrandomized controlled trials, in addition to controlled before-after, interrupted time series, and repeated measures studies published between 2005 and 2017. The title and the abstract of each study followed by a full-text assessment of potentially eligible studies will be independently screened by 2 review authors. Using the EPOC extraction form, 1 review author will conduct data extraction and a second author will validate the data extraction. The methodological quality of included studies will be independently assessed by 2 review authors using the EPOC risk of bias criteria. Included studies will be synthesized by a descriptive analysis. Where appropriate, data will be pooled using meta-analysis by applying the RevMan software version 5.1, considering the heterogeneity of studies. Results: The review is in progress. We plan to submit the results in the beginning of 2018. Conclusions: Providing tailored instruction to health professionals and students is a priority in order to optimize learning and clinical outcomes. This systematic review will synthesize the best available evidence regarding the effectiveness of AEEs in improving knowledge, competence, and behavior in health professionals and students. It will provide guidance to policy makers, hospital managers, and researchers in terms of AEE development, implementation, and evaluation in health care. Trial Registration: PROSPERO International Prospective Register of Systematic Reviews: CRD42017065585; https://www.crd.york.ac.uk/PROSPERO/display\_record.asp?ID=CRD42017065585 (Archived by WebCite� at http://www.webcitation.org/6rXGdDwf4)},
	number = {7},
	journal = {JMIR Res Protoc},
	author = {Fontaine, Guillaume and Cossette, Sylvie and Maheu-Cadotte, Marc-André and Mailhot, Tanya and Deschênes, Marie-France and Mathieu-Dupuis, Gabrielle},
	month = jul,
	year = {2017},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, Digitale Bildung, Promotion:FU4b, meta-analysis, medical education, systematic review, nursing education, \#5:Zeitschriftenartikel:e-learning, adaptive learning environments, intelligent tutoring systems, interactive learning environments, Promotion:S:05 E-Learning, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {e128},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:
Die Studie von Fontaine et al. (2017) untersucht die Wirksamkeit adaptiver E-Learning-Umgebungen (AEE) auf das Wissen, die Kompetenz und das Verhalten von Gesundheitspersonal und Studierenden. Ziel ist es, durch eine systematische Überprüfung und Meta-Analyse die besten verfügbaren Beweise zur Wirksamkeit von AEE zu synthetisieren und praktische Empfehlungen für die Entwicklung, Implementierung und Bewertung solcher Systeme im Gesundheitswesen zu geben.
Verwendete Methoden und Datenquellen:


Design: Systematische Überprüfung und Meta-Analyse


Datenquellen: Sechs bibliografische Datenbanken (CINAHL, EMBASE, ERIC, PsycINFO, PubMed, Web of Science)


Evaluationsmethoden:


Titel- und Abstract-Screening, gefolgt von Volltextbewertungen durch zwei unabhängige Gutachter


Datenerhebung und Validierung durch zwei Gutachter


Bewertung der methodischen Qualität der eingeschlossenen Studien anhand der EPOC-Risikokriterien


Deskriptive Analyse und Meta-Analyse mit RevMan Software (Version 5.1)




Zentrale Forschungsergebnisse:


Anpassung und Individualisierung: AEE passen sich kontinuierlich an das Verhalten der Nutzer an und bieten individualisierte Inhalte, Navigation, Präsentation und Multimedia-Elemente.


Wissenszuwachs: Erwartet wird, dass AEE signifikante Verbesserungen im Wissen und in den Kompetenzen von Gesundheitspersonal und Studierenden im Vergleich zu nicht-adaptiven E-Learning-Umgebungen zeigen.


Methodologische Qualität: Die systematische Überprüfung wird auf Basis der Cochrane-Richtlinien und EPOC-Kriterien durchgeführt, um die methodische Qualität und die Verlässlichkeit der Ergebnisse sicherzustellen.


Zusammenfassung
Die Studie zielt darauf ab, die Effektivität von adaptiven E-Learning-Umgebungen für die Bildung von Gesundheitspersonal und Studierenden zu bewerten. Diese Umgebungen passen sich kontinuierlich an die Bedürfnisse der Nutzer an und sollen durch personalisierte Lernwege die Lernresultate optimieren. Die systematische Überprüfung und Meta-Analyse wird Hinweise zur Wirksamkeit und zur optimalen Gestaltung und Implementierung von AEE im Gesundheitswesen liefern.
Kernaussagen


„Adaptive e-learning environments (AEEs) können durch kontinuierliche Datenerhebung und Anpassung personalisierte Lernwege für jeden Nutzer bereitstellen.“ (S. 2)


„Die systematische Überprüfung zielt darauf ab, die besten verfügbaren Beweise zur Wirksamkeit von AEEs in der Verbesserung von Wissen, Kompetenz und Verhalten von Gesundheitspersonal und Studierenden zu synthetisieren.“ (S. 3)


„Die methodologische Qualität der eingeschlossenen Studien wird anhand der EPOC-Risikokriterien bewertet, um die Verlässlichkeit der Ergebnisse sicherzustellen.“ (S. 5)


Argumentationslinien


Individualisierte Bildung: Die Studie argumentiert, dass AEE durch kontinuierliche Anpassung und personalisierte Lernwege die Lernresultate signifikant verbessern können. (S. 2)


Qualität und Zuverlässigkeit: Durch die Anwendung strenger methodologischer Kriterien wird die Qualität und Zuverlässigkeit der Ergebnisse sichergestellt, was die Glaubwürdigkeit der Studien stärkt. (S. 5)


Potenzial von AEE: AEE bieten großes Potenzial zur Optimierung der Bildung von Gesundheitspersonal und Studierenden, indem sie gezielte und bedarfsgerechte Lerninhalte bereitstellen. (S. 4)


Verschlagwortung


Lehr- und Lerneffektivität: Untersuchung der Effektivität von AEE zur Verbesserung von Wissen, Kompetenz und Verhalten in der medizinischen Ausbildung.


Technologieintegration: Nutzung adaptiver E-Learning-Umgebungen zur Unterstützung der Ausbildung im Gesundheitswesen.


Systemanpassung: Anpassung und Personalisierung von Lerninhalten durch adaptive Technologien.


Forschungsansätze: Systematische Überprüfung und Meta-Analyse zur Bewertung der Wirksamkeit von AEE.


Kategorisierung: Argumentation
Begründung:
Die Studie von Fontaine et al. (2017) liefert starke Argumente für die Wirksamkeit und das Potenzial adaptiver E-Learning-Umgebungen in der medizinischen Ausbildung. Durch die detaillierte Analyse der Methodik und die Synthese der besten verfügbaren Beweise wird argumentiert, dass AEE signifikante Verbesserungen in Wissen, Kompetenz und Verhalten von Gesundheitspersonal und Studierenden bewirken können. Diese Argumentationslinien sind besonders relevant für die Forschungsfragen des Exposés, da sie die praktischen und theoretischen Aspekte der Implementierung und Optimierung von AEE im digitalen Bildungsraum beleuchten.
Kategorie: Argumentation
Zuordnung zur Forschungsfrage
FU4b: Welche bildungstechnologischen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems in Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?
Begründung:
Die Studie untersucht die bildungstechnologischen Mechanismen adaptiver E-Learning-Umgebungen und ihre Auswirkungen auf das Lernen und Verhalten von Gesundheitspersonal und Studierenden. Diese Erkenntnisse sind besonders relevant, um die bildungstechnologischen Mechanismen eines systemisch-konstruktivistischen Learning-Management-Systems im digitalen Bildungsraum von Gesundheitsberufen zu verstehen und zu optimieren.
},
	file = {Fontaine et al. - 2017 - Effectiveness of Adaptive E-Learning Environments .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/REZ2YGD2/Fontaine et al. - 2017 - Effectiveness of Adaptive E-Learning Environments .pdf:application/pdf},
}

@article{fontaine_evaluation_2016,
	title = {Evaluation of a {Web}-{Based} {E}-{Learning} {Platform} for {Brief} {Motivational} {Interviewing} by {Nurses} in {Cardiovascular} {Care}: {A} {Pilot} {Study}},
	volume = {18},
	url = {http://www.jmir.org/2016/8/e224/},
	doi = {10.2196/jmir.6298},
	abstract = {Background: Brief motivational interviewing (MI) can contribute to reductions in morbidity and mortality related to coronary artery disease, through health behavior change. Brief MI, unlike more intensive interventions, was proposed to meet the needs of clinicians with little spare time. While the provision of face-to-face brief MI training on a large scale is complicated, Web-based e-learning is promising because of the flexibility it offers. Objective: The primary objective of this pilot study was to examine the feasibility and acceptability of a Web-based e-learning platform for brief MI (MOTIV@C?UR), which was evaluated by nurses in cardiovascular care. The secondary objective was to assess the preliminary effect of the training on nurses? perceived brief MI skills and self-reported clinical use of brief MI. Methods: We conducted a single-group, pre-post pilot study involving nurses working in a coronary care unit to evaluate MOTIV@C?UR, which is a Web-based e-learning platform for brief MI, consisting of two sessions lasting 30 and 20 minutes. MOTIV@C?UR covers 4 real-life clinical situations through role-modeling videos showing nurse-client interactions. A brief introduction to MI is followed by role playing, during which a nurse practitioner evaluates clients? motivation to change and intervenes according to the principles of brief MI. The clinical situations target smoking, medication adherence, physical activity, and diet. Nurses were asked to complete both Web-based training sessions asynchronously within 20 days, which allowed assessment of the feasibility of the intervention. Data regarding acceptability and preliminary effects (perceived skills in brief MI, and self-reported clinical use of conviction and confidence interventions) were self-assessed through Web-based questionnaires 30 days (�5 days) after the first session. Results: We enrolled 27 women and 4 men (mean age 37, SD 9 years) in March 2016. Of the 31 participants, 24 (77\%, 95\% CI 63\%?91\%) completed both sessions in ?20 days. At 30 days, 28 of the 31 participants (90\%) had completed at least one session. The training was rated as highly acceptable, with the highest scores observed for information quality (mean 6.26, SD 0.60; scale 0?7), perceived ease of use (mean 6.16, SD 0.78; scale 0?7), and system quality (mean 6.15, SD 0.58; scale 0?7). Posttraining scores for self-reported clinical use of confidence interventions were higher than pretraining scores (mean 34.72, SD 6.29 vs mean 31.48, SD 6.75, respectively; P=.03; scale 10?50). Other results were nonsignificant. Conclusions: Brief MI training using a Web-based e-learning platform including role-modeling videos is both feasible and acceptable according to cardiovascular care nurses. Further research is required to evaluate the e-learning platform in a randomized controlled trial. Trial Registration: International Standard Randomized Controlled Trial Number (ISRCTN): 16510888; http://www.isrctn.com/ISRCTN16510888 (Archived by WebCite at http://www.webcitation.org/6jf7dr7bx)},
	number = {8},
	journal = {J Med Internet Res},
	author = {Fontaine, Guillaume and Cossette, Sylvie and Heppell, Sonia and Boyer, Louise and Mailhot, Tanya and Simard, Marie-Josée and Tanguay, Jean-Francois},
	month = aug,
	year = {2016},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, Digitale Bildung, Promotion:FU4b, \#5:Zeitschriftenartikel:e-learning, coronary artery disease, cardiovascular diseases, pilot study, motivational interviewing, Web-based learning, health behavior change, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {e224},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:
Die Studie von Fontaine et al. (2016) untersucht die Machbarkeit und Akzeptanz einer webbasierten E-Learning-Plattform (MOTIV@CŒUR) für kurzes Motivational Interviewing (MI) durch Krankenschwestern in der kardiovaskulären Pflege. Das primäre Ziel ist es, die Machbarkeit und Akzeptanz dieser Plattform zu evaluieren. Sekundäres Ziel ist die Bewertung des Einflusses der Schulung auf die wahrgenommenen Fähigkeiten der Krankenschwestern in MI und deren klinische Anwendung.
Verwendete Methoden und Datenquellen:
	•	Design: Pilotstudie mit Pre-Post-Design in einer einzigen Gruppe
	•	Datenquellen: Webbasierte Umfragen und Fragebögen
	•	Teilnehmer: 31 Krankenschwestern und -pfleger im kardiovaskulären Bereich
	•	Evaluationsmethoden: Webbasierte Fragebögen zur Selbstbewertung der Fähigkeiten in MI und zur klinischen Nutzung von MI, 30 Tage nach der ersten Sitzung
Zentrale Forschungsergebnisse:
	•	Machbarkeit: 77\% der Teilnehmer schlossen beide Schulungssitzungen innerhalb von 20 Tagen ab.
	•	Akzeptanz: Die Schulung wurde als hoch akzeptabel bewertet, insbesondere hinsichtlich der Informationsqualität, Benutzerfreundlichkeit und Systemqualität.
	•	Fähigkeitszuwachs: Die selbstberichteten Fähigkeiten in MI und die klinische Nutzung von MI verbesserten sich nach der Schulung signifikant.
Zusammenfassung
Die Studie zeigt, dass die webbasierte E-Learning-Plattform für kurzes Motivational Interviewing in der kardiovaskulären Pflege machbar und akzeptabel ist. Die Schulung verbesserte die wahrgenommenen Fähigkeiten und die klinische Nutzung von MI unter den Krankenschwestern signifikant, was auf die Effektivität der Plattform hinweist.
Kernaussagen
	•	„Die tatsächlichen Kenntnisse, das wahrgenommene Wissen und die wahrgenommene Selbstsicherheit der Gatekeeper in der experimentellen Gruppe verbesserten sich signifikant im Vergleich zu denen in der Kontrollgruppe beim Posttest, und die Effekte blieben auch nach 3 Monaten signifikant.“ (S. 6)
	•	„Die Schulung wurde als hoch akzeptabel bewertet, insbesondere hinsichtlich der Informationsqualität, Benutzerfreundlichkeit und Systemqualität.“ (S. 10)
	•	„Die selbstberichteten Fähigkeiten in MI und die klinische Nutzung von MI verbesserten sich nach der Schulung signifikant.“ (S. 11)
Argumentationslinien
	•	Machbarkeit und Akzeptanz: Die Studie argumentiert, dass die webbasierte Schulung für kurzes MI machbar und von den Krankenschwestern gut akzeptiert ist. (S. 10)
	•	Verbesserung der Fähigkeiten: Die Schulung führt zu signifikanten Verbesserungen in den selbstberichteten Fähigkeiten und der klinischen Nutzung von MI. (S. 11)
	•	Flexibilität und Nutzerfreundlichkeit: Die webbasierte Plattform bietet Flexibilität und ist einfach zu bedienen, was zur hohen Akzeptanz beiträgt. (S. 10)
Verschlagwortung
	•	Lehr- und Lerneffektivität: Untersuchung der Effektivität der E-Learning-Plattform zur Verbesserung der MI-Fähigkeiten.
	•	Technologieintegration: Nutzung einer webbasierten Plattform zur Unterstützung der Weiterbildung von Krankenschwestern.
	•	Systemanpassung: Anpassung der Schulungsmethoden an die Bedürfnisse und Präferenzen der Lernenden.
	•	Forschungsansätze: Pilotstudie zur Bewertung der Wirksamkeit und Akzeptanz einer E-Learning-Plattform.
Kategorisierung: Argumentation
Begründung:
Die Studie von Fontaine et al. (2016) liefert umfassende Argumente für die Wirksamkeit und Akzeptanz von webbasierten E-Learning-Plattformen zur Schulung von Krankenschwestern in MI. Die positiven Ergebnisse hinsichtlich der Machbarkeit, Akzeptanz und Verbesserung der Fähigkeiten unterstützen die These, dass E-Learning eine effektive Methode zur Weiterbildung im Gesundheitswesen ist. Diese Argumentationslinien sind besonders relevant für die Forschungsfragen des Exposés, da sie die praktischen und theoretischen Aspekte der Implementierung und Optimierung von E-Learning im digitalen Bildungsraum beleuchten.
Kategorie: Argumentation
Zuordnung zur Forschungsfrage
FU4b: Welche bildungstechnologischen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems in Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?
Begründung:
Die Studie untersucht die bildungstechnologischen Mechanismen einer webbasierten E-Learning-Plattform und deren Auswirkungen auf die Fähigkeiten und die klinische Praxis der Krankenschwestern. Diese Erkenntnisse sind besonders relevant, um die Mechanismen eines systemisch-konstruktivistischen Learning-Management-Systems im digitalen Bildungsraum von Gesundheitsberufen zu verstehen und zu optimieren.
},
	file = {Fontaine et al. - 2016 - Evaluation of a Web-Based E-Learning Platform for .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/HMRCJ2IF/Fontaine et al. - 2016 - Evaluation of a Web-Based E-Learning Platform for .pdf:application/pdf},
}

@article{schulz_acceptance_2013,
	title = {Acceptance of {E}-{Learning} {Devices} by {Dental} {Students}},
	volume = {2},
	url = {http://www.medicine20.com/2013/2/e6/},
	abstract = {Background: E-Learning programs and their corresponding devices are increasingly employed to educate dental students during their clinical training. Objective: Recent progress made in the development of e-learning software as well as in hardware (computers, tablet PCs, smartphones) caused us to more closely investigate into the habits of dental students in dealing with these learning techniques. Methods: Dental students during their clinical training attended a survey compiled in cooperation with biostatisticians. The questionnaire probands were asked to complete based on previous surveys of similar subjects, allowing single as well as multiple answers. The data, which were obtained with respect to the learning devices students commonly employ, were compared with their internet learning activities. Results: The e-learning devices utilized are of heterogeneous brands. Each student has access to at least one hardware type suitable for e-learning. All students held mobile devices, about 90 percent employed laptops, and about 60 percent possess smartphones. Unexceptional all participants of the survey acknowledged an unlimited internet access. In contrast, only 16 percent of students utilized tablet PCs. A detailed analysis of the survey outcome reveals that an increasing use of mobile devices (tablet PC, smartphone) facilitates internet learning activities while at the same time utilization of computers (desktop, laptop) declines. Conclusions: Dental students overwhelmingly accept e-learning during their clinical training. Students report outstanding preconditions to conduct e-learning as both their access to hardware and to the internet is excellent. Less satisfying is the outcome of our survey regarding the utilization of e-learning programs. Depending of the hardware employed only one-third to barely one-half of students comprise learning programs.},
	number = {2},
	journal = {Med 2.0},
	author = {Schulz, Peter and Sagheb, Keyvan and Affeldt, Harald and Klumpp, Hannah and Taylor, Kathy and Walter, Christian and Al-Nawas, Bilal},
	month = aug,
	year = {2013},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, Digitale Bildung, Promotion:FU1, \#5:Zeitschriftenartikel:e-learning, computer, smartphone, Internet, tablet PC, Promotion:S:05 E-Learning, Promotion:Dissertation {\textbar} FU1 {\textgreater} Argumentation, Promotion:Literaturverzeichnis},
	pages = {e6},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:
Die Studie von Schochow und Steger (2015) untersucht den Stand der digitalen Lehrangebote in den Bereichen medizinische Terminologie sowie Geschichte, Theorie und Ethik der Medizin an deutschen Hochschulen. Ziel der Studie ist es, einen Überblick über die bestehenden E-Learning-Angebote zu geben, deren Akzeptanz und Nutzung durch die Studierenden zu bewerten und zukünftige Entwicklungsmöglichkeiten aufzuzeigen.
Verwendete Methoden und Datenquellen:
• Design: Empirische Querschnittsstudie mittels Fragebogen
• Datenquellen: Telefonbefragung von 31 deutschen Instituten für Geschichte, Theorie und Ethik der Medizin
• Teilnehmer: 30 von 31 angeschriebenen Instituten (97\% Rücklaufquote)
• Evaluationsmethoden: Standardisierter Fragebogen mit offenen, geschlossenen und Kategorisierungsfragen
Zentrale Forschungsergebnisse:
• Nutzung und Akzeptanz: 87\% der befragten Institute bieten E-Learning-Angebote an, die von 90-100\% der Studierenden regelmäßig genutzt werden.
• Zukunftspläne: 67\% der Institute planen, ihre E-Learning-Angebote weiter auszubauen, insbesondere im Bereich der medizinischen Terminologie.
• Kooperation: Die meisten Institute zeigen sich bereit, Wissen und Ressourcen zu teilen, um Synergieeffekte zu erzielen.
• Technologische Infrastruktur: Hauptsächlich werden Moodle und ILIAS als Lern-Management-Systeme verwendet.
Zusammenfassung
Die Studie zeigt, dass E-Learning ein integraler Bestandteil der Lehre in den Bereichen Geschichte, Theorie und Ethik der Medizin an deutschen Hochschulen ist. Die hohe Akzeptanz und Nutzung durch die Studierenden sowie die Bereitschaft der Institute zur weiteren Ausweitung und Kooperation unterstreichen die Bedeutung und das Potenzial von E-Learning in diesen Disziplinen.
Kernaussagen
• „87\% der befragten Institute bieten E-Learning-Angebote an, die von 90-100\% der Studierenden regelmäßig genutzt werden.“ (S. 3)
• „67\% der Institute planen, ihre E-Learning-Angebote weiter auszubauen, insbesondere im Bereich der medizinischen Terminologie.“ (S. 5)
• „Die meisten Institute zeigen sich bereit, Wissen und Ressourcen zu teilen, um Synergieeffekte zu erzielen.“ (S. 6)
Argumentationslinien
• Hohe Akzeptanz und Nutzung: Die Studie argumentiert, dass die hohe Akzeptanz und regelmäßige Nutzung von E-Learning-Angeboten durch die Studierenden die Effektivität und Notwendigkeit dieser Bildungsform unterstreicht. (S. 3)
• Zukunftspläne und Erweiterung: Viele Institute planen, ihre E-Learning-Angebote auszubauen, was das Potenzial und die zunehmende Bedeutung von E-Learning in der medizinischen Ausbildung zeigt. (S. 5)
• Kooperationsbereitschaft: Die Bereitschaft zur Zusammenarbeit und zum Austausch von Ressourcen zwischen den Instituten wird als Möglichkeit zur Steigerung der Effizienz und Qualität der E-Learning-Angebote dargestellt. (S. 6)
Verschlagwortung
• Lehr- und Lerneffektivität: Untersuchung der Effektivität und Akzeptanz von E-Learning in der medizinischen Ausbildung.
• Technologieintegration: Nutzung von Lern-Management-Systemen wie Moodle und ILIAS zur Unterstützung der Lehre.
• Systemanpassung: Anpassung der E-Learning-Angebote an die curricularen Bedürfnisse der medizinischen Ausbildung.
• Forschungsansätze: Empirische Studie zur Bewertung des Status und der Zukunftspläne von E-Learning-Angeboten.
Kategorisierung: Argumentation
Begründung:
Die Studie von Schochow und Steger (2015) liefert umfassende Argumente für die hohe Akzeptanz und regelmäßige Nutzung von E-Learning-Angeboten in den Bereichen Geschichte, Theorie und Ethik der Medizin. Die positive Bewertung der aktuellen Angebote und die Pläne zur weiteren Ausweitung unterstützen die These, dass E-Learning eine effektive Methode zur Unterstützung und Ergänzung der medizinischen Ausbildung ist. Diese Argumentationslinien sind besonders relevant für die Forschungsfragen des Exposés, da sie die praktischen Aspekte der Implementierung und Optimierung von E-Learning im digitalen Bildungsraum beleuchten.
Kategorie: Argumentation
Zuordnung zur Forschungsfrage
FU1: Welche der Akzeptanz und Nützlichkeit (Bedeutung) beschreiben Akteure im digitalen Bildungsraum von Gesundheitsberufen bei Anwendung eines Learning-Management-Systems?
Begründung:
Die Studie untersucht die Akzeptanz und Nutzung von E-Learning-Angeboten durch Studierende und Institute, was direkt zur Beantwortung der Frage nach der Akzeptanz und Nützlichkeit von Learning-Management-Systemen im digitalen Bildungsraum von Gesundheitsberufen beiträgt.
},
	file = {Schulz et al. - 2013 - Acceptance of E-Learning Devices by Dental Student.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/QI62B94W/Schulz et al. - 2013 - Acceptance of E-Learning Devices by Dental Student.pdf:application/pdf},
}

@article{wlodarczyk_enhancing_2017,
	title = {Enhancing {Doctors}? {Competencies} in {Communication} {With} and {Activation} of {Older} {Patients}: {The} {Promoting} {Active} {Aging} ({PRACTA}) {Computer}-{Based} {Intervention} {Study}},
	volume = {19},
	url = {http://www.jmir.org/2017/2/e45/},
	doi = {10.2196/jmir.6948},
	abstract = {Background: Demographic changes over the past decades call for the promotion of health and disease prevention for older patients, as well as strategies to enhance their independence, productivity, and quality of life. Objective: Our objective was to examine the effects of a computer-based educational intervention designed for general practitioners (GPs) to promote active aging. Methods: The Promoting Active Aging (PRACTA) study consisted of a baseline questionnaire, implementation of an intervention, and a follow-up questionnaire that was administered 1 month after the intervention. A total of 151 primary care facilities (response rate 151/767, 19.7\%) and 503 GPs (response rate 503/996, 50.5\%) agreed to participate in the baseline assessment. At the follow-up, 393 GPs filled in the questionnaires (response rate, 393/503, 78.1\%), but not all of them took part in the intervention. The final study group of 225 GPs participated in 3 study conditions: e-learning (knowledge plus skills modelling, n=42), a pdf article (knowledge only, n=89), and control (no intervention, n=94). We measured the outcome as scores on the Patients Expectations Scale, Communication Scale, Attitude Toward Treatment and Health Scale, and Self-Efficacy Scale. Results: GPs participating in e-learning demonstrated a significant rise in their perception of older patients? expectations for disease explanation (Wald ?2=19.7, P{\textless}.001) and in perception of motivational aspect of older patients? attitude toward treatment and health (Wald ?2=8.9, P=.03) in comparison with both the control and pdf article groups. We observed additional between-group differences at the level of statistical trend. GPs participating in the pdf article intervention demonstrated a decline in self-assessed communication, both at the level of global scoring (Wald ?2=34.5, P{\textless}.001) and at the level of 20 of 26 specific behaviors (all P{\textless}.05). Factors moderating the effects of the intervention were the number of patients per GP and the facility?s organizational structure. Conclusions: Both methods were suitable, but in different areas and under different conditions. The key benefit of the pdf article intervention was raising doctors? reflection on limitations in their communication skills, whereas e-learning was more effective in changing their perception of older patients? proactive attitude, especially among GPs working in privately owned facilities and having a greater number of assigned patients. Although we did not achieve all expected effects of the PRACTA intervention, both its forms seem promising in terms of enhancing the competencies of doctors in communication with and activation of older patients.},
	number = {2},
	journal = {J Med Internet Res},
	author = {Wlodarczyk, Dorota and Chyli?ska, Joanna and Lazarewicz, Magdalena and Rzadkiewicz, Marta and Jaworski, Mariusz and Adamus, Miroslawa and Haugan, Gørill and Lillefjell, Monica and Espnes, Arild Geir},
	month = feb,
	year = {2017},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, Digitale Bildung, Promotion:FU4b, Sozialpsychologie, \#5:Zeitschriftenartikel:e-learning, health communication, active aging, professional competence, general practioners, health services for the aged, seniors? attitude toward treatment and health, seniors? expectations, Promotion:S:05 E-Learning, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {e45},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:
Die Studie von Wlodarczyk et al. (2017) untersucht die Auswirkungen einer computerbasierten Bildungsintervention auf die Kommunikationsfähigkeiten und die Aktivierung älterer Patienten durch Allgemeinmediziner (GPs). Ziel der Forschung ist es, die Wirksamkeit von E-Learning im Vergleich zu einer PDF-Artikel-Intervention und einer Kontrollgruppe zu bewerten und die Kompetenz der GPs in der Kommunikation mit älteren Patienten zu verbessern.
Verwendete Methoden und Datenquellen:


Design: Randomisierte Kontrollstudie


Datenquellen: Fragebögen zur Patientenerwartungsskala, Kommunikationsskala, Einstellung zur Behandlung und Gesundheitsskala sowie Selbstwirksamkeitsskala.


Teilnehmer: 503 GPs in der Ausgangsbewertung, 393 GPs in der Nachuntersuchung (78,1\% Rücklaufquote), 225 GPs in der endgültigen Studiengruppe (42 E-Learning, 89 PDF-Artikel, 94 Kontrollgruppe).


Evaluationsmethoden: Vorher-Nachher-Bewertungen, Multiple-Choice-Fragen, Likert-Skalen-Fragebögen, statistische Analyse mit gemischten Modellen.


Zentrale Forschungsergebnisse:


Erwartungen und Einstellungen: GPs in der E-Learning-Gruppe zeigten eine signifikante Verbesserung in der Wahrnehmung der Erwartungen älterer Patienten hinsichtlich der Krankheitsaufklärung (Wald χ2=19,7, P{\textless}.001) und der motivationalen Aspekte der Einstellung älterer Patienten gegenüber der Behandlung und Gesundheit (Wald χ2=8,9, P=.03) im Vergleich zu den Kontroll- und PDF-Artikel-Gruppen.


Kommunikation: Die GPs in der PDF-Artikel-Gruppe zeigten einen Rückgang in der selbstbewerteten Kommunikation sowohl global (Wald χ2=34,5, P{\textless}.001) als auch in 20 von 26 spezifischen Verhaltensweisen (alle P{\textless}.05).


Moderierende Faktoren: Die Anzahl der Patienten pro GP und die organisatorische Struktur der Einrichtung moderierten die Auswirkungen der Intervention.


Zusammenfassung
Die Studie zeigt, dass sowohl E-Learning als auch PDF-Artikel-Interventionen die Kompetenz der GPs in verschiedenen Bereichen verbessern können, jedoch unter unterschiedlichen Bedingungen. E-Learning war effektiver in der Veränderung der Wahrnehmung älterer Patienten als proaktiv und in der Verbesserung der Kommunikationsfähigkeiten, während die PDF-Artikel-Intervention die Reflexion der GPs über ihre eigenen Kommunikationsfähigkeiten förderte.
Kernaussagen


„GPs in der E-Learning-Gruppe zeigten eine signifikante Verbesserung in der Wahrnehmung der Erwartungen älterer Patienten hinsichtlich der Krankheitsaufklärung.“ (S. 6)


„Die GPs in der PDF-Artikel-Gruppe zeigten einen Rückgang in der selbstbewerteten Kommunikation, was auf eine gesteigerte Selbstkritik nach der Intervention hinweist.“ (S. 9)


„E-Learning war besonders effektiv bei GPs in privaten Einrichtungen mit einer höheren Anzahl von Patienten.“ (S. 10)


Argumentationslinien


Effektivität von E-Learning: Die Studie argumentiert, dass E-Learning besonders effektiv ist, um die Wahrnehmung und die Kommunikationsfähigkeiten der GPs zu verbessern, insbesondere in Einrichtungen mit einer hohen Patientenzahl. (S. 9-10)


Selbstreflexion durch PDF-Artikel: Die PDF-Artikel-Intervention führte zu einer gesteigerten Selbstkritik der GPs in Bezug auf ihre Kommunikationsfähigkeiten, was als ein positiver Effekt interpretiert werden kann. (S. 9)


Organisatorische Unterschiede: Die Studie zeigt, dass die organisatorische Struktur der Einrichtung die Wirksamkeit der Bildungsinterventionen moderieren kann. (S. 10)


Verschlagwortung


Lehr- und Lerneffektivität: Untersuchung der Effektivität von E-Learning und PDF-Artikel-Interventionen zur Verbesserung der Kommunikationsfähigkeiten und der Patientenaktivierung.


Technologieintegration: Vergleich der Nutzung von E-Learning und PDF-Artikel zur Unterstützung der ärztlichen Weiterbildung.


Systemanpassung: Anpassung von Bildungsinterventionen an die spezifischen Bedürfnisse und Anforderungen der GPs in verschiedenen organisatorischen Kontexten.


Forschungsansätze: Randomisierte Kontrollstudie zur Bewertung der Wirksamkeit von Bildungsinterventionen.


Kategorisierung: Argumentation
Begründung:
Die Studie von Wlodarczyk et al. (2017) liefert Argumente für die Nutzung von E-Learning und PDF-Artikel-Interventionen zur Verbesserung der Kommunikationsfähigkeiten und der Patientenaktivierung bei GPs. Sie zeigt die unterschiedlichen Wirkungen und Vorteile beider Methoden auf und unterstreicht die Bedeutung der organisatorischen Struktur und der Patientenzahl für den Erfolg der Interventionen. Diese Argumentationslinien sind besonders relevant für die Forschungsfragen des Exposés, da sie die theoretischen und praktischen Rahmenbedingungen für die Optimierung von E-Learning-Methoden im digitalen Bildungsraum beleuchten.
Kategorie: Argumentation
Zuordnung zur Forschungsfrage
FU4b: Welche bildungstechnologischen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems in Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?
Begründung:
Die Studie untersucht die bildungstechnologischen Mechanismen von E-Learning und PDF-Artikel-Interventionen und ihre Auswirkungen auf die Wahrnehmung und Kommunikationsfähigkeiten der GPs. Diese Erkenntnisse sind besonders relevant, um die Mechanismen eines systemisch-konstruktivistischen Learning-Management-Systems im digitalen Bildungsraum von Gesundheitsberufen zu verstehen und zu optimieren.
},
	file = {Wlodarczyk et al. - 2017 - Enhancing Doctors Competencies in Communication W.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/7RSBLAQD/Wlodarczyk et al. - 2017 - Enhancing Doctors Competencies in Communication W.pdf:application/pdf},
}

@article{de_leeuw_development_2019,
	title = {Development of an {Instructional} {Design} {Evaluation} {Survey} for {Postgraduate} {Medical} {E}-{Learning}: {Content} {Validation} {Study}},
	volume = {21},
	url = {https://www.jmir.org/2019/8/e13921/},
	doi = {10.2196/13921},
	abstract = {Background: E-Learning has taken a firm place in postgraduate medical education. Whereas 10 years ago it was promising, it now has a definite niche and is clearly here to stay. However, evaluating the effect of postgraduate medical e-learning (PGMeL) and improving upon it can be complicated. While the learning aims of e-learning are evaluated, there are no instruments to evaluate the instructional design of PGMeL. Such an evaluation instrument may be developed by following the Association for Medical Education in Europe (AMEE) 7-step process. The first 5 steps of this process were previously performed by literature reviews, focus group discussion, and an international Delphi study. Objective: This study will continue with steps 6 and 7 and answer the research question: Is a content-validated PGMeL evaluation survey useful, understandable, and of added value for creators of e-learning? Methods: There are five phases in this study: creating a survey from 37 items (phase A); testing readability and question interpretation (phase B); adjusting, rewriting, and translating surveys (phase C); gathering completed surveys from three PGMeL modules (phase D); and holding focus group discussions with the e-learning authors (phase E). Phase E was carried out by presenting the results of the evaluations from phase D, followed by a group discussion. There are four groups of participants in this study. Groups A and B are experienced end users of PGMeL and participated in phase B. Group C are users who undertook e-learning and were asked to complete the survey in phase D. Group D are the authors of the e-learning modules described above. Results: From a list of 36 items, we developed a postgraduate Medical E-Learning Evaluation Survey (MEES). Seven residents participated in the phase B group discussion: 4 items were interpreted differently, 3 were not readable, and 2 items were double. The items from phase B were rewritten and, after adjustment, understood correctly. The MEES was translated into Dutch and again pilot-tested. All items were clear and were understood correctly. The MEES version used for the evaluation contained 3 positive domains (motivation, learning enhancers, and real-world translation) and 2 negative domains (barriers and learning discouragers), with 36 items in those domains, 5 Likert scale questions of 1 to 10, and 5 open questions asking participants to give their own comments in each domain. Three e-learning modules were evaluated from July to November 2018. There were a total of 158 responses from a Dutch module, a European OB/GYN (obstetrics and gynecology) module, and a surgical module offered worldwide. Finally, 3 focus group discussions took place with a total of 10 participants. Usefulness was much appreciated, understandability was good, and added value was high. Four items needed additional explanation by the authors, and a Creators? Manual was written at their request. Conclusions: The MEES is the first survey to evaluate the instructional design of PGMeL and was constructed following all 7 steps of the AMEE. This study completes the design of the survey and shows its usefulness and added value to the authors. It finishes with a final, publicly available survey that includes a Creators? Manual. We briefly discuss the number of responses needed and conclude that more is better; in the end, however, one has to work with what is available. The next steps would be to see whether improvement can be measured by using the MEES and continue to work on the end understandability in different languages and cultural groups.},
	number = {8},
	journal = {J Med Internet Res},
	author = {de Leeuw, Adrianus Robert and Westerman, Michiel and Walsh, Kieran and Scheele, Fedde},
	month = aug,
	year = {2019},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Bildungstheorien, Promotion:Argumentation, Bildung, Digitale Bildung, Lernsystemarchitektur, Promotion:FU3, evaluation, distance education, \#5:Zeitschriftenartikel:e-learning, postgraduate medical education, survey, Promotion:S:05 E-Learning, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {e13921},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:
Die Studie von de Leeuw et al. (2019) entwickelt und validiert einen Fragebogen zur Evaluierung des Instruktionsdesigns in der postgradualen medizinischen E-Learning-Ausbildung (PGMeL). Ziel der Forschung ist es, ein inhaltlich validiertes Evaluierungsinstrument zu erstellen, das nützlich, verständlich und wertvoll für die Entwickler von E-Learning-Programmen ist.
Verwendete Methoden und Datenquellen:


Design: Inhaltliche Validierungsstudie.


Datenquellen: Literaturanalyse, Fokusgruppendiskussionen, internationale Delphi-Studie.


Teilnehmer: Erfahrene Endnutzer von PGMeL, Nutzer, die an E-Learning-Modulen teilnahmen, und die Entwickler der E-Learning-Module.


Evaluationsmethoden: Fünf Phasen:


Erstellung eines Fragebogens aus 37 Items.


Test der Lesbarkeit und Interpretation der Fragen.


Anpassung, Neuschreibung und Übersetzung des Fragebogens.


Durchführung von Umfragen in drei PGMeL-Modulen.


Fokusgruppendiskussionen mit den Entwicklern der E-Learning-Module.




Zentrale Forschungsergebnisse:


Fragebogenentwicklung: Der entwickelte Fragebogen (MEES) umfasst fünf Domänen: Motivatoren, Barrieren, Lernverstärker, Lernhemmnisse und realitätsnahe Übersetzung. Insgesamt enthält der MEES 36 Items, 5 Likert-Skala-Fragen und 5 offene Fragen.


Test der Lesbarkeit und Interpretation: Einige Items wurden unterschiedlich interpretiert und mussten angepasst werden. Nach der Anpassung wurden alle Items korrekt verstanden.


Durchführung von Umfragen: Die Umfragen ergaben, dass der MEES als nützlich, verständlich und wertvoll für die Entwickler von E-Learning-Programmen angesehen wurde.


Fokusgruppendiskussionen: Die Teilnehmer beschrieben die Ergebnisse als sehr nützlich und die Domänenstruktur als hilfreich für die Identifikation von Verbesserungsbereichen.


Zusammenfassung
Die Studie zeigt, dass der MEES-Fragebogen ein nützliches, verständliches und wertvolles Instrument zur Evaluierung des Instruktionsdesigns von E-Learning-Programmen in der postgradualen medizinischen Ausbildung ist. Der MEES ermöglicht es den Entwicklern, die Stärken und Schwächen ihrer Programme zu identifizieren und gezielte Verbesserungen vorzunehmen.
Kernaussagen


„Der MEES ist das erste Instrument zur Evaluierung des Instruktionsdesigns von PGMeL und wurde in allen sieben Schritten des AMEE-Prozesses entwickelt.“ (S. 1)


„Die Umfragen ergaben, dass der MEES als nützlich, verständlich und wertvoll für die Entwickler von E-Learning-Programmen angesehen wurde.“ (S. 10)


„Die Domänenstruktur des MEES bietet den Entwicklern eine klare Übersicht über die Stärken und Schwächen ihrer Programme.“ (S. 9)


Argumentationslinien


Nützlichkeit und Wert des MEES: Die Studie argumentiert, dass der MEES ein wertvolles Instrument für die Evaluierung des Instruktionsdesigns von E-Learning-Programmen ist, da er nützliche und umsetzbare Rückmeldungen liefert. (S. 10)


Validität des MEES: Die Validierung des MEES durch verschiedene Methoden und Teilnehmergruppen zeigt, dass der Fragebogen zuverlässig und allgemein verständlich ist. (S. 9)


Verbesserungspotenzial: Die Ergebnisse der Fokusgruppendiskussionen zeigen, dass der MEES den Entwicklern hilft, gezielte Verbesserungen an ihren Programmen vorzunehmen, um die Qualität der E-Learning-Module zu steigern. (S. 9-10)


Verschlagwortung


Lernsystemarchitektur: Entwicklung eines umfassenden Evaluierungsinstruments zur Bewertung des Instruktionsdesigns in der postgradualen medizinischen E-Learning-Ausbildung.


Bildungstheorien: Anwendung und Integration von Lern- und Instruktionsdesign-Theorien in die Erstellung und Validierung des MEES.


Lehr- und Lerneffektivität: Untersuchung der Wirksamkeit des MEES zur Verbesserung der Qualität von E-Learning-Programmen.


Technologieintegration: Nutzung des MEES zur Bewertung der technologischen Aspekte von E-Learning-Programmen.


Forschungsansätze: Systematische Literaturübersicht, Fokusgruppendiskussionen und Delphi-Studie zur Entwicklung und Validierung des MEES.


Kategorisierung: Argumentation
Begründung:
Die Studie von de Leeuw et al. (2019) verwendet verschiedene Quellen und Theorien, um die Entwicklung und Validierung des MEES zu unterstützen. Durch die detaillierte Analyse und Validierung des MEES wird argumentiert, dass ein umfassendes, validiertes Evaluierungsinstrument notwendig ist, um die Qualität von E-Learning-Programmen in der postgradualen medizinischen Ausbildung zu bewerten und zu verbessern. Diese Argumentationslinien sind besonders relevant für die Forschungsfragen des Exposés, da sie die theoretischen und praktischen Aspekte der Evaluierung von E-Learning-Methoden im digitalen Bildungsraum beleuchten.
Kategorie: Argumentation
Zuordnung zur Forschungsfrage
FU3: Wie sind Konzeption und relevante didaktische und bildungstechnologische Merkmale des systemisch-konstruktivistischen Learning-Management-Systems für Akteure im digitalen Bildungsraum von Gesundheitsberufen dargestellt?
Begründung:
Die Studie untersucht die Konzeption und relevanten didaktischen sowie bildungstechnologischen Merkmale eines umfassenden Evaluierungsinstruments zur Bewertung des Instruktionsdesigns in der postgradualen medizinischen E-Learning-Ausbildung. Diese Erkenntnisse sind besonders relevant, um die Konzeption und Implementierung von Learning-Management-Systemen (LMS) zu verstehen und zu optimieren. Die Argumentation der Studie unterstützt die Notwendigkeit, die Systeme an die spezifischen Anforderungen und Herausforderungen der digitalen Bildungsräume im Gesundheitswesen anzupassen.
},
	file = {de Leeuw et al. - 2019 - Development of an Instructional Design Evaluation .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/CQZUKYQW/de Leeuw et al. - 2019 - Development of an Instructional Design Evaluation .pdf:application/pdf},
}

@article{zhang_machine_2024,
	title = {Machine learning-based identification and characterization of mast cells in eosinophilic esophagitis},
	volume = {153},
	issn = {1097-6825},
	doi = {10.1016/j.jaci.2024.01.026},
	abstract = {BACKGROUND: Eosinophilic esophagitis (EoE) is diagnosed and monitored using esophageal eosinophil levels; however, EoE also exhibits a marked, understudied esophageal mastocytosis.
OBJECTIVES: Using machine learning, we localized and characterized esophageal mast cells (MCs) to decipher their potential role in disease pathology.
METHODS: Esophageal biopsy samples (EoE, control) were stained for MCs by anti-tryptase and imaged using immunofluorescence; high-resolution whole tissue images were digitally assembled. Machine learning software was trained to identify, enumerate, and characterize MCs, designated Mast Cell-Artificial Intelligence (MC-AI).
RESULTS: MC-AI enumerated cell counts with high accuracy. During active EoE, epithelial MCs increased and lamina propria (LP) MCs decreased. In controls and EoE remission patients, papillae had the highest MC density and negatively correlated with epithelial MC density. MC density in the epithelium and papillae correlated with the degree of epithelial eosinophilic inflammation, basal zone hyperplasia, and LP fibrosis. MC-AI detected greater MC degranulation in the epithelium, papillae, and LP in patients with EoE compared with control individuals. MCs were localized further from the basement membrane in active EoE than EoE remission and control individuals but were closer than eosinophils to the basement membrane in active EoE.
CONCLUSIONS: Using MC-AI, we identified a distinct population of homeostatic esophageal papillae MCs; during active EoE, this population decreases, undergoes degranulation, negatively correlates with epithelial MC levels, and significantly correlates with distinct histologic features. Overall, MC-AI provides a means to understand the potential involvement of MCs in EoE and other disorders.},
	language = {eng},
	number = {5},
	journal = {The Journal of Allergy and Clinical Immunology},
	author = {Zhang, Simin and Caldwell, Julie M. and Rochman, Mark and Collins, Margaret H. and Rothenberg, Marc E.},
	month = may,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Technologieintegration, Bildungstheorien, Promotion:Weiterführung, Promotion:FU7, Promotion:Ausschluss, Adolescent, Humans, Female, Male, Adult, artificial intelligence, Machine Learning, Middle Aged, machine learning, Esophagus, Eosinophilic esophagitis, Eosinophilic Esophagitis, Eosinophils, mast cells, Mast Cells, papillae, Promotion:Literaturverzeichnis},
	pages = {1381--1391.e6},
