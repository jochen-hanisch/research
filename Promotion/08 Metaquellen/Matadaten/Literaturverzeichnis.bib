  pmcid = {PMC10990773},
  keywords = {0:Zeitschriftenartikel:digital:learning,Aged,Aged 80 and over,Bewertungsmethoden,Charité:Promotion,Community dwelling older adults,COVID-19,Datenschutz und IT-Sicherheit,Female,Focus study groups,Humans,Learning,Lehr- und Lerneffektivität,Male,Pandemics,Pilot Projects,Promotion:FU5,Promotion:Literaturanalyse,Promotion:Relevanz:4,Promotion:S:12 Digital Learning,Promotion:Weiterführung,Reliable health information,Smart tablets training intervention,Tablets,Technologieintegration},
