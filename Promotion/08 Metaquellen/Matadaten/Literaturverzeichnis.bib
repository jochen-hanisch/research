	keywords = {Charité:Promotion, Promotion:Literaturanalyse, Forschungsansätze, Technologieintegration, Bewertungsmethoden, Systemanpassung, Promotion:Relevanz:4, Promotion:Weiterführung, Promotion:FU7, \#b:Buchteil:online:learning, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {57--64},
