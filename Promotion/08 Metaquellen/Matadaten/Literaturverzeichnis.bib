	pages = {1039--1060},
	file = {Scheiter - 2021 - Lernen und Lehren mit digitalen Medien Eine Stand.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/BJSSFD2K/Scheiter - 2021 - Lernen und Lehren mit digitalen Medien Eine Stand.pdf:application/pdf},
