@article{al-jasmi_hunter_2010,
	title = {Hunter disease {eClinic}:interactive, computer-assisted, problem-based approach to independent learning about a rare genetic disease},
	volume = {10},
	issn = {1472-6920},
	shorttitle = {Hunter disease {eClinic}},
	url = {https://bmcmededuc.biomedcentral.com/articles/10.1186/1472-6920-10-72},
	doi = {10/d4hh3q},
	abstract = {Background: Computer-based teaching (CBT) is a well-known educational device, but it has never been applied systematically to the teaching of a complex, rare, genetic disease, such as Hunter disease (MPS II). Aim: To develop interactive teaching software functioning as a virtual clinic for the management of MPS II. Implementation and Results: The Hunter disease eClinic, a self-training, user-friendly educational software program, available at the Lysosomal Storage Research Group (http://www.lysosomalstorageresearch.ca), was developed using the Adobe Flash multimedia platform. It was designed to function both to provide a realistic, interactive virtual clinic and instantaneous access to supporting literature on Hunter disease. The Hunter disease eClinic consists of an eBook and an eClinic. The eClinic is the interactive virtual clinic component of the software. Within an environment resembling a real clinic, the trainee is instructed to perform a medical history, to examine the patient, and to order appropriate investigation. The program provides clinical data derived from the management of actual patients with Hunter disease. The eBook provides instantaneous, electronic access to a vast collection of reference information to provide detailed background clinical and basic science, including relevant biochemistry, physiology, and genetics. In the eClinic, the trainee is presented with quizzes designed to provide immediate feedback on both trainee effectiveness and efficiency. User feedback on the merits of the program was collected at several seminars and formal clinical rounds at several medical centres, primarily in Canada. In addition, online usage statistics were documented for a 2-year period. Feedback was consistently positive and confirmed the practical benefit of the program. The online English-language version is accessed daily by users from all over the world; a Japanese translation of the program is also available. Conclusions: The Hunter disease eClinic employs a CBT model providing the trainee with realistic clinical problems, coupled with comprehensive basic and clinical reference information by instantaneous access to an electronic textbook, the eBook. The program was rated highly by attendees at national and international presentations. It provides a potential model for use as an educational approach to other rare genetic diseases.},
	language = {en-GB},
	number = {1},
	urldate = {2023-11-18},
	journal = {BMC Medical Education},
	author = {Al-Jasmi, Fatma and Moldovan, Laura and Clarke, Joe Tr},
	month = dec,
	year = {2010},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Weiterführung, \#1:Zeitschriftenartikel:learning:management:system, Krisenreaktion im Bildungsbereich, Lernsystemarchitektur, Promotion:FU3, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {72},
	annote = {Analyse des Artikels "Al-Jasmi et al. - 2010 - Hunter disease eClinic interactive, computer-assisted learning"
1. Analyse:
Hauptthemen und -ziele der Forschung: Der Artikel "Hunter disease eClinic interactive, computer-assisted learning" von Al-Jasmi et al. befasst sich mit der Entwicklung und Implementierung eines interaktiven eClinic-Lernsystems zur Ausbildung im Bereich der seltenen genetischen Erkrankung Mucopolysaccharidosis Typ II (Hunter-Syndrom). Das Ziel der Forschung ist es, ein effektives und interaktives Lernmittel zu schaffen, das medizinische Fachkräfte in der Diagnose und Behandlung von Patienten mit seltenen genetischen Krankheiten schult.
Verwendete Methoden und Datenquellen: Die eClinic besteht aus zwei Hauptkomponenten: der eClinic selbst, die interaktive Fallstudien bietet, und dem eBook, das umfangreiche theoretische und klinische Informationen bereitstellt. Die Fallstudien basieren auf realen Patientendaten und decken die gesamte klinische Untersuchung ab, einschließlich Anamnese, körperliche Untersuchung, Laboruntersuchungen und Management. Die Autoren haben umfangreiche Quellen und Fachliteratur genutzt, um die Inhalte des eBooks zu entwickeln, und haben durch Animationen und interaktive Werkzeuge die Lerninhalte aufbereitet .
Zentrale Forschungsergebnisse: Das Programm kombiniert die Stärken virtueller Patientenmanagementprobleme mit dem Zugriff auf umfangreiche elektronische Ressourcen. Es fördert einen konstruktivistischen Wissenstransfer, indem es reale Probleme in den Lernraum bringt und Leistungsfeedback bietet. Der Einsatz realer Fallstudien und Animationen verbessert die Langzeitgedächtnisbildung und das Engagement der Lernenden. Eine der wesentlichen Erkenntnisse ist, dass die visuelle Darstellung und die Benutzerfreundlichkeit des eClinics die Lernmotivation und -effizienz signifikant steigern .
2. Zusammenfassung:
Kernpunkte des Artikels:


Problemstellung: Mangel an umfassender und aktueller Ausbildung für seltene genetische Krankheiten wie das Hunter-Syndrom in der medizinischen Ausbildung.


Methodik: Entwicklung eines interaktiven eClinic-Lernsystems mit realen Fallstudien und umfangreichen eBook-Ressourcen.


Hauptergebnisse: Verbesserte Lernmotivation und -effizienz durch interaktive Fallstudien und visuell ansprechende Lernmaterialien.


Schlussfolgerungen: Das eClinic-Lernsystem ist ein effektives Werkzeug zur Ausbildung im Bereich seltener genetischer Krankheiten und fördert einen konstruktivistischen Wissenstransfer.


3. Kernaussagen:


Die eClinic bietet eine interaktive Lernumgebung, die auf realen Patientendaten basiert und die klinische Praxis simuliert (S. 4-7).


Das eBook ergänzt die eClinic durch umfassende theoretische und klinische Informationen, die durch Animationen und Hyperlinks unterstützt werden (S. 5-8).


Die visuelle Darstellung und Benutzerfreundlichkeit des Systems erhöhen die Lernmotivation und -effizienz (S. 6-9) .


4. Argumentationslinien:


Die Autoren argumentieren, dass die Integration von realen Patientendaten und interaktiven Fallstudien die Lernmotivation und -effizienz erhöht (S. 5-7).


Sie stützen ihre Argumentation auf die Prinzipien des konstruktivistischen Lernens und die Anwendung dieser Prinzipien im eClinic-Lernsystem (S. 7-8).


Die Effektivität des Systems wird durch die positive Rückmeldung der Nutzer und die Übertragbarkeit der gelernten Inhalte auf reale klinische Szenarien unterstrichen (S. 9) .


5. Verschlagwortung:


Lernsystemarchitektur: Die detaillierte Beschreibung der Struktur und Funktionalität des eClinic-Lernsystems zeigt die Bedeutung einer durchdachten Architektur für effektives Lernen (S. 4-8).


Bildungstheorien: Anwendung der konstruktivistischen Lerntheorie zur Gestaltung des Lernprozesses und zur Förderung eines tiefen Verständnisses (S. 7-8).


Lehr- und Lerneffektivität: Verbesserte Lernergebnisse und Motivation durch interaktive und visuell ansprechende Lernmaterialien (S. 6-9).


Technologieintegration: Kombination von interaktiven Fallstudien und umfangreichen eBook-Ressourcen zeigt die effektive Integration verschiedener Technologien in das Lernsystem (S. 5-8).


Forschungsansätze: Methodologische Diskussion der Prinzipien des konstruktivistischen Lernens und deren Anwendung im eClinic-System (S. 7-8) .


6. Kategorisiere: Kerngedanke
Begründung: Die zentrale Idee des Artikels ist die Anwendung eines interaktiven, konstruktivistischen Lernsystems zur Verbesserung der medizinischen Ausbildung im Bereich seltener genetischer Krankheiten. Dieser Kerngedanke durchzieht die gesamte Argumentation und die methodologische Umsetzung des eClinic-Programms.
7. Zuordnung zu Forschungsfragen:
Passendste Forschungsfrage: FU3: "Wie sind Konzeption und relevante didaktische und bildungstechnologische Merkmale des systemisch-konstruktivistischen Learning-Management-Systems für Akteure im digitalen Bildungsraum von Gesundheitsberufen dargestellt?"
Begründung: Der Artikel beschreibt detailliert die Konzeption des eClinic-Lernsystems, einschließlich der Integration von realen Patientendaten, interaktiven Fallstudien und umfangreichen eBook-Ressourcen. Die Anwendung der konstruktivistischen Lerntheorie und die didaktischen Prinzipien, die in die Entwicklung des Systems eingeflossen sind, werden ausführlich diskutiert. Dies entspricht genau der Fragestellung nach der Konzeption und den didaktischen und bildungstechnologischen Merkmalen des Systems.
},
	file = {Al-Jasmi et al. - 2010 - Hunter disease eClinicinteractive, computer-assis.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/LWLIE27Y/Al-Jasmi et al. - 2010 - Hunter disease eClinicinteractive, computer-assis.pdf:application/pdf},
}

@article{benamer_relationship_2023,
	title = {The relationship of online pre-recorded neurology mini-lectures to medical student assessment: a pilot study},
	volume = {23},
	issn = {1472-6920},
	shorttitle = {The relationship of online pre-recorded neurology mini-lectures to medical student assessment},
	url = {https://bmcmededuc.biomedcentral.com/articles/10.1186/s12909-023-04185-5},
	doi = {10/gs569d},
	abstract = {Introduction  eLearning has become an essential part of medical education. However, there is a lack of published research on student engagement with online pre-recorded mini-lectures and its relation to assessment. The aim of this pilot study is to explore the relationship between newly introduced neurology pre-recorded mini-lectures and undergraduate medical students engagement and assessment. This may encourage the wider use of mini-lectures in undergraduate medical curricula.
Methods  The engagement of medical students with 48 online pre-recorded neurology mini-lectures was assessed through a Learning Management System. To measure engagement, data was stratified according to the number of watched/downloaded mini-lectures. A point system was used (out of 5): − 1 point = watching/downloading 0–10 mini-lectures, 2 points = watching/downloading 11–20 mini-lectures, 3 points = watching/downloading 21–30 minilectures, 4 points = watching/downloading 31–40 mini-lectures and, 5 points = watching/downloading 41–48 minilectures. The students’ engagement was correlated with their neurology assessments [Objective Structured Clinical Examination (OSCE), and knowledge-based assessment 10 Multiple Choice Questions (MCQs) and one 10-mark Short Answer Question, (SAQ)], internal medicine grade and annual grade point average (GPA) using the Pearson correlation coefficient.
Results  The mean engagement of 34, Year 5, medical students is 3.9/5. There is a significant positive correlation between engagement and internal medicine grade (r = 0.35, p = 0.044). There is a moderate correlation between engagement and neurology OSCE (r = 0.23), annual Year 5 GPA (r = 0.23), neurology knowledge-based score (r = 0.22) and composite neurology knowledge/OSCE (r = 0.27). The knowledge-based assessment included SAQ and MCQs: there was a moderate correlation with SAQ (r = 0.30), but a weak negative correlation with the MCQs (r =-0.11). Subgroups analysis comparing the top- and low- or non- engaging students made these weaker correlations stronger.
Conclusion  This pilot study indicates a high rate of engagement with an online pre-recorded mini-lectures resource and evidence of moderate correlation between engagement and assessment. Online pre-recorded mini-lectures should be used more in delivering the curriculum contents of the clinical clerkships. Further studies are needed to evaluate the relation and the impact of the mini-lectures on assessment.},
	language = {en-GB},
	number = {1},
	urldate = {2023-11-18},
	journal = {BMC Medical Education},
	author = {Benamer, Hani Ts and Stanley, Adrian G},
	month = apr,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Bildungstheorien, Promotion:Argumentation, \#1:Zeitschriftenartikel:learning:management:system, Lernsystemarchitektur, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {225},
	annote = {1. Analyse
Hauptthemen und -ziele der Forschung: Die Studie analysiert den Einfluss des Engagements von Medizinstudierenden bei online vorab aufgezeichneten Mini-Vorlesungen auf ihre Leistung in neurologischen Bewertungen. Ziel ist es, die Wirksamkeit von eLearning in der medizinischen Ausbildung zu bestimmen (S. 2).
Verwendete Methoden und Datenquellen: Es wurde ein Learning Management System (LMS) verwendet, um das Engagement der Studierenden zu erfassen. Die Bewertung der Studierenden erfolgte durch verschiedene Prüfungsformate, einschließlich OSCE und Multiple-Choice-Fragen (MCQs) (S. 3).
Zentrale Forschungsergebnisse: Es wurde eine moderate Korrelation zwischen dem Engagement der Studierenden und ihren Leistungen festgestellt. Besonders die aktive Nutzung der Mini-Vorlesungen korrelierte mit besseren Noten in internen Medizinkursen und spezifischen neurologischen Bewertungen (S. 3-4).
2. Zusammenfassung
Die Studie zeigt, dass eine aktive Beteiligung an online verfügbaren Mini-Vorlesungen mit verbesserten Leistungen in neurologischen Bewertungen korreliert. Diese Erkenntnisse unterstützen den weiteren Einsatz von eLearning-Ressourcen in medizinischen Curricula, insbesondere in klinischen Fachbereichen.
3. Kernaussagen


Engagement und Leistung: Studierende, die sich intensiver mit den Mini-Vorlesungen auseinandersetzten, erzielten bessere Ergebnisse in den Bewertungen (S. 3).


Einsatz von LMS: Das LMS ermöglichte eine effektive Überwachung und Analyse des Lernengagements (S. 2-3).


Kurzformat der Inhalte: Die kurze Dauer der Mini-Vorlesungen trug wahrscheinlich zur höheren Engagementrate bei (S. 4).


4. Argumentationslinien
Die Studie verwendet empirische Daten, um die Hypothese zu stützen, dass digitale Lernformate die Lerneffektivität erhöhen können. Durch den Einsatz eines systematischen Bewertungssystems wurde gezeigt, dass eine direkte Verbindung zwischen dem Engagement der Studierenden und ihren akademischen Leistungen besteht.
5. Verschlagwortung


Lernsystemarchitektur: Das LMS zeigt eine spezifische Architektur für das Management von Lernressourcen, was eine effektive Überwachung des Engagements ermöglicht (S. 3).


Bildungstheorien: Die Nutzung von Mini-Vorlesungen basiert auf der Annahme, dass kürzere, fokussierte Inhalte eine effektivere Lernerfahrung bieten, was theoretische Überlegungen zur Informationsaufnahme und -verarbeitung widerspiegelt (S. 4).


Lehr- und Lerneffektivität: Die Studie demonstriert, wie digitale Lehrmethoden die Lerneffektivität durch verbesserte Leistungsbewertungen steigern können (S. 4).


Technologieintegration: Die Integration des LMS und der Einsatz von Mini-Vorlesungen in das medizinische Curriculum illustrieren, wie Technologie effektiv in die Lehre integriert werden kann (S. 2-3).


Diese Schlagwörter wurden sorgfältig ausgewählt, um die relevanten Aspekte der Studie hervorzuheben und deren wissenschaftliche Bedeutung zu betonen.
},
	file = {Benamer und Stanley - 2023 - The relationship of online pre-recorded neurology .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/9H5I4FNC/Benamer und Stanley - 2023 - The relationship of online pre-recorded neurology .pdf:application/pdf},
}

@article{barnard-ashton_integration_2017,
	title = {The integration of blended learning into an occupational therapy curriculum: a qualitative reflection},
	volume = {17},
	issn = {1472-6920},
	shorttitle = {The integration of blended learning into an occupational therapy curriculum},
	url = {http://bmcmededuc.biomedcentral.com/articles/10.1186/s12909-017-0977-1},
	doi = {10/gckwwg},
	abstract = {Background: This paper presents a critical reflection of the integration of Blended Learning (BL) into an undergraduate occupational therapy curriculum which was delivered through Problem Based Learning (PBL).
Method: This is a qualitative reflection of a Participatory Action Research (PAR) study using Brookfield’s model for critical reflection of an educator’s practice. The model uses four ‘lenses’ through which to focus enquiry: Lens 1) our autobiography as a learner of practice; Lens 2) our learners’ eyes; Lens 3) our colleagues’ experiences; and Lens 4) the theoretical literature. Grounded theory analysis was applied to the data.
Results: The factors that contributed to successful integration of technology and e-Learning into an existing curriculum, the hurdles that were navigated along the way, and how these influenced decisions and innovation are explored. The core categories identified in the data were “drivers of change” and “outcomes of BL integration”. Key situations and pivotal events are highlighted for their role in the process that led to the project maturing. Each lens reflects the successes and hurdles experienced during the study.
Conclusion: Brookfield’s model provides an objective method of reflection which showed that despite the hurdles, e-Learning was successfully integrated into the curriculum.},
	language = {en-GB},
	number = {1},
	urldate = {2023-11-18},
	journal = {BMC Medical Education},
	author = {Barnard-Ashton, Paula and Rothberg, Alan and McInerney, Patricia},
	month = dec,
	year = {2017},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, Promotion:FU3, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {135},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:
Die Studie von Barnard-Ashton et al. (2017) reflektiert die Integration von Blended Learning (BL) in ein Curriculum für Ergotherapie. Ziel der Studie ist es, die Faktoren und Herausforderungen zu identifizieren, die den Erfolg der Integration von Technologie und E-Learning in ein bestehendes Curriculum beeinflussen, sowie die erzielten Ergebnisse zu analysieren.
Verwendete Methoden und Datenquellen:
	•	Design: Qualitative Reflexion im Rahmen einer Partizipativen Aktionsforschung (PAR)
	•	Datenquellen: Brookfields Modell der kritischen Reflexion durch vier Linsen: Autobiografie des Lerners, Sichtweise der Lernenden, Erfahrungen der Kollegen und theoretische Literatur
	•	Teilnehmer: Studierende und Dozenten der Ergotherapie
	•	Evaluationsmethoden: Grounded Theory-Analyse, Interviews, Fokusgruppen, Umfragen und anekdotische Kommentare
Zentrale Forschungsergebnisse:
	•	Treiber des Wandels: Faktoren wie Teamzusammenhalt, kollaborative Entscheidungsfindung und Unterstützung durch das Management trugen maßgeblich zum Erfolg bei.
	•	Ergebnisse der BL-Integration: Die Studie identifizierte verbesserte Kommunikation, Transparenz des Curriculums, effiziente Ressourcennutzung und positive Auswirkungen auf die Lernenden als zentrale Ergebnisse.
	•	Herausforderungen: Technische Probleme, Infrastruktur und anfängliche Zurückhaltung der Dozenten waren Herausforderungen, die überwunden werden mussten.
Zusammenfassung
Die Studie zeigt, dass die Integration von Blended Learning in ein Ergotherapie-Curriculum erfolgreich war, obwohl verschiedene Hürden überwunden werden mussten. Die Anwendung von Brookfields Reflexionsmodell half, die Perspektiven aller Beteiligten zu berücksichtigen und die wesentlichen Treiber des Wandels und die positiven Ergebnisse zu identifizieren.
Kernaussagen
	•	„Die Studie identifizierte verbesserte Kommunikation, Transparenz des Curriculums, effiziente Ressourcennutzung und positive Auswirkungen auf die Lernenden als zentrale Ergebnisse.“ (S. 10)
	•	„Die größten Herausforderungen waren technische Probleme, Infrastruktur und anfängliche Zurückhaltung der Dozenten.“ (S. 9)
	•	„Teamzusammenhalt und kollaborative Entscheidungsfindung trugen maßgeblich zum Erfolg bei.“ (S. 10)
Argumentationslinien
	•	Treiber des Wandels: Die Studie argumentiert, dass Teamzusammenhalt, kollaborative Entscheidungsfindung und Managementunterstützung zentrale Treiber des erfolgreichen Wandels waren. (S. 10)
	•	Herausforderungen und Lösungen: Technische Probleme und anfängliche Zurückhaltung der Dozenten wurden durch kontinuierliche Unterstützung und Schulung überwunden. (S. 9)
	•	Ergebnisse: Die Integration von BL führte zu verbesserter Kommunikation, Transparenz des Curriculums und effizienter Ressourcennutzung, was den Lernenden zugutekam. (S. 10)
Verschlagwortung
	•	Lehr- und Lerneffektivität: Untersuchung der Effektivität von Blended Learning zur Verbesserung der Lernprozesse in der Ergotherapie.
	•	Technologieintegration: Nutzung von E-Learning und Blended Learning zur Unterstützung der Ausbildung in der Ergotherapie.
	•	Systemanpassung: Anpassung der Lehrmethoden an die Bedürfnisse und Präferenzen der Lernenden.
	•	Forschungsansätze: Partizipative Aktionsforschung zur Bewertung der Wirksamkeit von Blended Learning.
Kategorisierung: Argumentation
Begründung:
Die Studie von Barnard-Ashton et al. (2017) liefert umfassende Argumente für die Wirksamkeit und Herausforderungen der Integration von Blended Learning in ein Ergotherapie-Curriculum. Die detaillierte Analyse der Treiber des Wandels und der positiven Ergebnisse unterstützt die These, dass Blended Learning eine effektive Methode zur Verbesserung der Lehr- und Lernprozesse ist. Diese Argumentationslinien sind besonders relevant für die Forschungsfragen des Exposés, da sie die praktischen und theoretischen Aspekte der Implementierung und Optimierung von Blended Learning im digitalen Bildungsraum beleuchten.
Kategorie: Argumentation
Zuordnung zur Forschungsfrage
FU3: Wie sind Konzeption und relevante didaktische und bildungstechnologische Merkmale des systemisch-konstruktivistischen Learning-Management-Systems für Akteure im digitalen Bildungsraum von Gesundheitsberufen dargestellt?
Begründung:
Die Studie untersucht die Konzeption und didaktischen Merkmale der Integration von Blended Learning in das Ergotherapie-Curriculum und deren Auswirkungen auf die Lernenden und Dozenten. Diese Erkenntnisse sind besonders relevant, um die Merkmale eines systemisch-konstruktivistischen Learning-Management-Systems im digitalen Bildungsraum von Gesundheitsberufen zu verstehen und zu optimieren.
},
	file = {Barnard-Ashton et al. - 2017 - The integration of blended learning into an occupa.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/Z2TSW6V5/Barnard-Ashton et al. - 2017 - The integration of blended learning into an occupa.pdf:application/pdf},
