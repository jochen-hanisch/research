@article{gerhard_opportunities_2023,
	title = {Opportunities to learn, technological pedagogical knowledge, and personal factors of pre-service teachers: understanding the link between teacher education program characteristics and student teacher learning outcomes in times of digitalization},
	volume = {26},
	issn = {1434-663X, 1862-5215},
	shorttitle = {Opportunities to learn, technological pedagogical knowledge, and personal factors of pre-service teachers},
	url = {https://link.springer.com/10.1007/s11618-023-01162-y},
	doi = {10/gs39c7},
	abstract = {Despite the need to foster pre-service teacher competence with respect to information and communication technology (ICT) integration in school during the current era of digitalization, scientiﬁc understanding of the correlation between the relevant characteristics of teacher education programs and student teachers’ learning outcomes remains limited. This paper thus examines the relationship between student teachers’ opportunities to learn (OTL) and technological pedagogical knowledge (TPK) with the aim of obtaining insights into their learning processes and the effectiveness of teachers’ preparation upon completing their bachelor studies. A sample of 338 student teachers in their 6th semester at the University of Cologne was used. Findings from path modeling reveal that measures of OTL relate to TPK. While no direct effect of technological pedagogical OTL on TPK was identiﬁed, an indirect effect between conventional pedagogical OTL and TPK, mediated by student teachers’ general pedagogical knowledge (GPK) was found. Among the personal factors that affect student teachers, their motivation for using ICT reveals a direct effect on TPK. Further factors, such as gender and teacher education program type have no effect on TPK. The ﬁndings will be discussed in relation to expectations of teacher education effectiveness.},
	language = {en-GB},
	number = {3},
	urldate = {2023-11-08},
	journal = {Zeitschrift für Erziehungswissenschaft},
	author = {Gerhard, Kristina and Jäger-Biela, Daniela J. and König, Johannes},
	month = jun,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:FU4a, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, \#0:Zeitschriftenartikel:digital:learning, Promotion:S:12 Digital Learning, Promotion:Literaturverzeichnis, Promotion:sec:A-2},
	pages = {653--676},
	annote = {Analyse der Studie "Opportunities to learn, technological pedagogical knowledge, and personal factors of pre-service teachers: Understanding the link between teacher education program characteristics and student teacher learning outcomes in times of digitalization" von Gerhard et al. (2023)
1. Hauptthemen und Ziele der Forschung
Die Studie von Gerhard et al. (2023) untersucht die Zusammenhänge zwischen den Lerngelegenheiten (Opportunities to Learn, OTL) in der Lehrerausbildung, dem technologisch-pädagogischen Wissen (Technological Pedagogical Knowledge, TPK) und den persönlichen Faktoren von Lehramtsstudierenden. Das Hauptziel ist es, ein besseres Verständnis darüber zu gewinnen, wie Merkmale von Lehrerausbildungsprogrammen in Zeiten der Digitalisierung mit den Lernergebnissen der Studierenden zusammenhängen.
2. Methoden und Datenquellen
Methoden:


Die Studie verwendet ein Pfadmodell, um die Beziehungen zwischen den OTL, dem allgemeinen pädagogischen Wissen (General Pedagogical Knowledge, GPK), dem TPK und persönlichen Faktoren der Studierenden zu analysieren.


Es wurden Daten von 338 Lehramtsstudierenden im sechsten Semester an der Universität zu Köln erhoben. Die Datenerhebung erfolgte im Sommer 2021 während der COVID-19-Pandemie.


Datenquellen:


Die Daten basieren auf einem standardisierten Testinstrument, das von einem interdisziplinären Forscherteam entwickelt wurde, um das TPK der Lehramtsstudierenden zu messen. Zusätzlich wurden Selbstberichte der Studierenden zu ihren Lerngelegenheiten und Motivationen erhoben.


3. Zentrale Forschungsergebnisse


Zusammenhang zwischen OTL und TPK:


Es konnte kein direkter Effekt der technologisch-pädagogischen OTL auf das TPK festgestellt werden. Stattdessen zeigte sich ein indirekter Effekt zwischen den pädagogischen OTL und dem TPK, vermittelt durch das allgemeine pädagogische Wissen (GPK).




Einfluss persönlicher Faktoren:


Die Motivation der Studierenden, Informations- und Kommunikationstechnologien (IKT) im Unterricht einzusetzen, zeigte einen direkten Effekt auf das TPK. Andere persönliche Faktoren wie Geschlecht oder der Typ des Lehramtsstudiengangs hatten keinen Einfluss auf das TPK.




Bedeutung des GPK:


Das GPK erwies sich als wichtiger Prädiktor für das TPK und zeigt, dass dieses Wissen als Basis für die Entwicklung von TPK im Rahmen der Lehrerausbildung dient.




4. Zusammenfassung
Die Studie untersucht, wie Lerngelegenheiten in der Lehrerausbildung und persönliche Faktoren das technologisch-pädagogische Wissen von Lehramtsstudierenden beeinflussen. Die Ergebnisse zeigen, dass allgemeines pädagogisches Wissen eine wichtige Grundlage für die Entwicklung von technologisch-pädagogischem Wissen darstellt und dass die Motivation zur Nutzung von IKT einen positiven Einfluss auf dieses Wissen hat.
5. Kernaussagen


Indirekte Wirkung von OTL: Pädagogische OTL beeinflussen das TPK indirekt durch das allgemeine pädagogische Wissen (GPK). (S. 660)


Einfluss der Motivation: Die Motivation zur Nutzung von IKT zeigt einen direkten Effekt auf das TPK. (S. 668)


6. Argumentationslinien
Die Autoren argumentieren, dass das TPK von Lehramtsstudierenden stark von ihrem allgemeinen pädagogischen Wissen und ihrer Motivation zur Nutzung von IKT abhängt. Sie betonen die Notwendigkeit, die OTL in der Lehrerausbildung stärker auf die Vermittlung von technologisch-pädagogischem Wissen auszurichten, um die digitale Kompetenz zukünftiger Lehrkräfte zu fördern. (S. 670-671)
7. Verschlagwortung


Technologieintegration: Die Studie befasst sich mit der Integration von IKT in die Lehrerausbildung und deren Einfluss auf das technologisch-pädagogische Wissen.


Lehr- und Lerneffektivität: Untersucht wird die Effektivität der Lehrerausbildung in Bezug auf die Vermittlung von TPK und GPK.


Forschungsansätze: Die Anwendung von Pfadmodellen zur Untersuchung der Beziehungen zwischen OTL, GPK, TPK und persönlichen Faktoren der Lehramtsstudierenden.


8. Kategorisierung
Kerngedanke: Die Studie hebt hervor, dass das allgemeine pädagogische Wissen eine zentrale Rolle bei der Entwicklung von technologisch-pädagogischem Wissen spielt und dass die Motivation der Studierenden zur Nutzung von IKT ein Schlüsselfaktor für den Erfolg in der Lehrerausbildung ist. (S. 670)
9. Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU4a: Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?


Begründung: Die Studie untersucht bildungswissenschaftliche Mechanismen, wie die Lerngelegenheiten (OTL) und deren Einfluss auf das TPK, was relevante Einblicke in die Wirkung von Ausbildungsmerkmalen auf das Lernen bietet.


10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie bietet wertvolle Erkenntnisse zur Bedeutung von Lerngelegenheiten und persönlicher Motivation für die Entwicklung von TPK).


Zitierhäufigkeit und Einfluss: 4 (Die Studie ist relativ neu, aber das Thema ist hochrelevant für die Bildungsforschung).


Aktualität: 5 (Veröffentlichung im Jahr 2023, also sehr aktuell).


Gesamtbewertung: 4.7
11. Schlussfolgerung
Die Studie von Gerhard et al. (2023) verdeutlicht die Bedeutung der Lerngelegenheiten und der Motivation der Studierenden für die Entwicklung von technologisch-pädagogischem Wissen in der Lehrerausbildung. Die Ergebnisse legen nahe, dass ein stärkerer Fokus auf die Vermittlung von TPK in der Lehrerausbildung notwendig ist, um zukünftige Lehrkräfte auf die digitalen Anforderungen des modernen Bildungswesens vorzubereiten.
},
	file = {Gerhard et al. - 2023 - Opportunities to learn, technological pedagogical .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/JLW5D8RF/Gerhard et al. - 2023 - Opportunities to learn, technological pedagogical .pdf:application/pdf},
}

@inproceedings{pauls_partizipatives_2023,
	title = {Ein partizipatives {Konzept} für die {Technikentwick}- lung unter {Beteiligung} von {Pflegestudierenden} als {Co}-{Forschende}},
	abstract = {Die Digitalisierung beeinflusst neben den Arbeitsprozessen zunehmend auch die Rollen und Qualifikationsanforderungen von Pflegefachpersonen. Die Kompetenzen der unterschiedlichen Abschlüsse sind noch unzureichend aufeinander abgestimmt und spezifische Aufgabenfelder im Bereich der Digitalisierung und Technik fehlen. Eine stärkende Rolle im Entwicklungsprozess von Technologien könnte ein Tätigkeitsbereich sein, um zukünftig neue Lösungen nutzer*innenorientiert entwickeln und in der Pflegepraxis implementieren zu können. Anhand mehrerer Schritte wurde interdisziplinär im Projekt Data-DrivenHealth ein partizipatives Konzept entwickelt, dass unterschiedliche Beteiligungsformen ermöglicht. Ein zentrales Element hierbei ist die aktive Einbindung von Pflegestudierenden als Co-Forschende. Neben beteiligten Kliniken und Pflegefachpersonen aus unterschiedlichen Einrichtungen, sollen Studierende nach theoretischen Inhalten anwendungsbezogene Kompetenzen in einem Forschungsprojekt erlernen.},
	language = {de-DE},
	author = {Pauls, Alexander and Bruns, Fenja and Cobus, Vanessa and Dietsche, Stefan and Fleßner, Jannik and Wallhoff, Frank and Koppelin, Frauke},
	month = sep,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Kollaboratives Lernen, Technologieintegration, Systemanpassung, Promotion:Relevanz:4, Promotion:Weiterführung, Promotion:FU4b, \#9:Konferenz-Paper:digital:lernen, Promotion:S:09 Digital Lernen, Promotion:Literaturverzeichnis},
	annote = {Analyse der Studie "Ein partizipatives Konzept für die Technikentwicklung unter Beteiligung von Pflegestudierenden als Co-Forschende" von Pauls et al. (2023)
1. Hauptthemen und Ziele der Forschung
Die Studie von Pauls et al. (2023) untersucht ein partizipatives Konzept zur Technikentwicklung, das Pflegestudierende als Co-Forschende einbezieht. Ziel der Studie ist es, digitale und technische Kompetenzen der Pflegestudierenden zu fördern, indem sie aktiv in den Entwicklungsprozess von Technologien für die klinische Pflegepraxis eingebunden werden. Dieses Vorgehen soll Akzeptanzprobleme und Innovationsbarrieren minimieren und nutzer*innenorientierte technologische Lösungen entwickeln.
2. Methoden und Datenquellen
Methoden:


Die Entwicklung des partizipativen Konzepts erfolgte in drei Schritten:


Zuordnung der Pflegepraxis zu Beteiligungsformen nach dem Modell von Chung \& Lounsbury (2007).


Integration des Human-centered Design (HCD) Prozesses zur Identifikation passender Methoden in einem interdisziplinären Team.


Abgleich der Entwicklungsphasen mit dem Studiengangscurriculum der Pflegestudierenden, um eine enge Verknüpfung von Theorie und Praxis sicherzustellen.




Datenquellen:


Die Studie basiert auf Daten aus dem Projekt Data-Driven-Health ("DEAL"), das von November 2022 bis Oktober 2025 läuft. Eingebunden sind Studierende des Studiengangs Angewandte Pflegewissenschaft sowie Vertreter*innen aus der klinischen Praxis in Niedersachsen.


3. Zentrale Forschungsergebnisse


Partizipative Einbindung von Studierenden:


Studierende wurden erfolgreich in den Technikentwicklungsprozess eingebunden, wodurch sie praktische digitale und methodische Kompetenzen erlangten, die für die spätere Pflegepraxis von Bedeutung sind.




Reduzierung von Innovationsbarrieren:


Die aktive Beteiligung von Pflegestudierenden als Co-Forschende trug dazu bei, Akzeptanzprobleme und Innovationsbarrieren bei der Entwicklung neuer Technologien für die Pflegepraxis zu reduzieren.




Human-centered Design:


Der Einsatz des HCD-Prozesses ermöglichte eine nutzer*innenorientierte Entwicklung der Technologien, die den tatsächlichen Bedürfnissen der Pflegefachkräfte entsprechen.




4. Zusammenfassung
Die Studie beschreibt die Entwicklung und Umsetzung eines partizipativen Konzepts zur Technikentwicklung in der Pflegepraxis. Die Einbindung von Pflegestudierenden als Co-Forschende führte zu einer stärkeren Praxisnähe und Akzeptanz bei der Entwicklung neuer Technologien, was zu einer Verringerung von Innovationsbarrieren beiträgt. Der HCD-Prozess wurde erfolgreich integriert, um nutzerzentrierte technologische Lösungen zu schaffen.
5. Kernaussagen


Partizipatives Konzept: Die Einbindung von Pflegestudierenden als Co-Forschende fördert digitale und methodische Kompetenzen und reduziert Akzeptanzprobleme bei der Entwicklung neuer Technologien. (S. 174)


Nutzerzentrierte Entwicklung: Der Human-centered Design Prozess ermöglichte eine bedarfsgerechte Technikentwicklung. (S. 176)


6. Argumentationslinien
Die Autoren argumentieren, dass die aktive Einbindung von Studierenden als Co-Forschende im Entwicklungsprozess nicht nur deren Kompetenzen stärkt, sondern auch entscheidend dazu beiträgt, dass die entwickelten Technologien besser an die Bedürfnisse der Pflegepraxis angepasst sind und somit auf höhere Akzeptanz stoßen. (S. 178)
7. Verschlagwortung


Technologieintegration: Die Studie befasst sich mit der Integration technischer Lösungen in die Pflegepraxis unter Einbezug der Nutzer*innen.


Systemanpassung: Es wird erörtert, wie Studiengänge und Forschungsprojekte angepasst werden können, um digitale Kompetenzen der Studierenden zu fördern.


Kollaboratives Lernen: Die Zusammenarbeit zwischen Studierenden und Praxispartnern wird als Methode zur Kompetenzförderung und Akzeptanzsteigerung betrachtet.


8. Kategorisierung
Weiterführung: Die Studie zeigt auf, dass die partizipative Einbindung von Studierenden als Co-Forschende ein Modell für zukünftige Bildungs- und Technikentwicklungsprojekte sein kann, um die Akzeptanz und Wirksamkeit technischer Innovationen in der Pflegepraxis zu steigern. (S. 181)
9. Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU4b: Welche technisch-gestalterischen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?


Begründung: Die Studie untersucht, wie technologische und didaktische Mechanismen in der Pflegebildung und -praxis erfolgreich integriert werden können.


10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie liefert relevante Erkenntnisse zur Integration digitaler Kompetenzen in die Pflegeausbildung).


Zitierhäufigkeit und Einfluss: 4 (Die Studie ist aktuell und behandelt ein bedeutendes Thema in der Pflegebildung und -technologieentwicklung).


Aktualität: 5 (Veröffentlichung im Jahr 2023, daher sehr aktuell).


Gesamtbewertung: 4.7
11. Schlussfolgerung
Die Studie von Pauls et al. (2023) zeigt, dass ein partizipatives Konzept, das Pflegestudierende als Co-Forschende einbezieht, eine vielversprechende Methode ist, um digitale Kompetenzen zu fördern und gleichzeitig Akzeptanzprobleme bei der Einführung neuer Technologien in der Pflegepraxis zu minimieren. Dieses Modell bietet wertvolle Impulse für die Weiterentwicklung der Pflegeausbildung und -praxis.
},
	file = {Pauls et al. - Ein partizipatives Konzept für die Technikentwick-.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/Y75FA7AV/Pauls et al. - Ein partizipatives Konzept für die Technikentwick-.pdf:application/pdf},
}

@article{kuhlmann_digitale_2023,
	title = {Digitale {Hochschullehre} für {Alle} gestalten: {Ergebnisse} einer {Lehrendenbefragung} an vier {Hochschulen}},
	issn = {1424-3636},
	shorttitle = {Digitale {Hochschullehre} für {Alle} gestalten},
	url = {https://www.medienpaed.com/article/view/1730},
	doi = {10/gsr76k},
	abstract = {The increasing heterogeneity of students and advancing digitization processes at German universities are creating new challenges for teaching. Teachers in particular, as the main actors, are facing new challenges. An empirical study conducted in the spring of 2022 at four German universities provides new insights into how teachers meet the requirements of digital teaching that is accessible to all students. In this context, the knowledge, attitudes and experience of teachers, especially in their interdependencies, prove to be central. A central role in this context is played by the significance of an anticipated additional effort in the implementation of digital, accessible teaching. This can be explained by a lack of knowledge and experience, which influences the attitude of teachers. For the realization of a university for all, it is therefore necessary to provide teachers with support and further training opportunities to qualify them for the new challenges they face in implementing digital, accessible teaching.},
	language = {de-DE},
	urldate = {2023-09-22},
	journal = {MedienPädagogik: Zeitschrift für Theorie und Praxis der Medienbildung},
	author = {Kuhlmann, Judith and Günter, Jule and Kamin, Anna-Maria},
	month = sep,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Systemanpassung, \#7:Zeitschriftenartikel:digital:Medien, Promotion:FU4b, Promotion:S:07 Digitale Medien, Promotion:Literaturverzeichnis},
	pages = {169--182},
	annote = {Analyse der Studie "Digitale Hochschullehre für Alle gestalten. Ergebnisse einer Lehrendenbefragung an vier Hochschulen" von Kuhlmann et al. (2023)
1. Hauptthemen und Ziele der Forschung
Die Studie von Kuhlmann et al. (2023) untersucht die Herausforderungen und Bedarfe von Lehrenden bei der Umsetzung digitaler und barrierefreier Hochschullehre an vier deutschen Hochschulen. Im Mittelpunkt steht die Frage, wie Lehrende auf die zunehmende Heterogenität der Studierenden und die fortschreitende Digitalisierung der Hochschulbildung reagieren. Ziel der Studie ist es, Erkenntnisse zu generieren, die helfen, digitale Lehre für alle Studierenden zugänglich zu gestalten, und spezifische Unterstützungs- und Weiterbildungsmaßnahmen für Lehrende zu entwickeln.
2. Methoden und Datenquellen
Methoden:


Die Studie basiert auf einer empirischen Erhebung, die im Frühjahr 2022 durchgeführt wurde. Es wurden sowohl quantitative als auch qualitative Methoden angewendet.


Die quantitative Erhebung erfolgte durch einen standardisierten Online-Fragebogen, an dem 179 Lehrende teilnahmen. Die qualitative Erhebung beinhaltete 30- bis 60-minütige Interviews mit sechs Lehrenden, die sich auf ihre Erfahrungen und Herausforderungen in der digitalen Lehre konzentrierten.


Datenquellen:


Die Daten stammen von Lehrenden aus verschiedenen Positionen (Professoren, wissenschaftliche Mitarbeiter, Lehrbeauftragte) und Disziplinen an vier Hochschulen, die am Verbundprojekt SHUFFLE beteiligt waren.


3. Zentrale Forschungsergebnisse


Wissen über digitale Barrierefreiheit:


Die Mehrheit der Lehrenden ordnet ihr Wissen über digitale Barrierefreiheit als mittelfristig ein, wobei viele Aspekte bekannt sind, aber tiefere Kenntnisse fehlen. Nur wenige Lehrende sehen sich als Experten auf diesem Gebiet.




Einstellung gegenüber digitaler Barrierefreiheit:


Es bestehen Bedenken hinsichtlich des Mehraufwands (zeitlich, technisch, didaktisch) bei der Umsetzung digitaler Barrierefreiheit. Trotz dieser Bedenken zeigen viele Lehrende eine grundsätzlich positive Einstellung und sind bereit, sich weiterzubilden.




Erfahrungen mit digitaler Barrierefreiheit:


Lehrende haben unterschiedliche Erfahrungsniveaus in der Umsetzung digitaler Barrierefreiheit, wobei die meisten bisher keine umfangreiche Ausbildung in diesem Bereich absolviert haben. Es wird ein erheblicher Weiterbildungsbedarf identifiziert.




4. Zusammenfassung
Die Studie beleuchtet die Herausforderungen, mit denen Lehrende bei der Umsetzung digitaler, barrierefreier Lehre konfrontiert sind. Die Ergebnisse zeigen, dass Lehrende zwar ein gewisses Grundwissen und Interesse an digitaler Barrierefreiheit haben, aber tiefere Kenntnisse und praktische Erfahrungen fehlen. Es besteht ein Bedarf an zielgerichteten Weiterbildungsangeboten, um die technische, didaktische und strategische Umsetzung digitaler Barrierefreiheit zu fördern.
5. Kernaussagen


Wissenslücken: Nur wenige Lehrende haben vertieftes Wissen über digitale Barrierefreiheit, was die Umsetzung erschwert. (S. 174)


Einstellung zum Mehraufwand: Viele Lehrende fürchten den zeitlichen und technischen Mehraufwand, der mit der Umsetzung digitaler Barrierefreiheit verbunden ist. (S. 176)


Weiterbildungsbedarf: Die Mehrheit der Lehrenden ist bereit, sich weiterzubilden, um die Anforderungen digitaler Barrierefreiheit besser zu erfüllen. (S. 178)


6. Argumentationslinien
Die Autoren argumentieren, dass die Umsetzung digitaler Barrierefreiheit in der Hochschullehre eine systematische Unterstützung der Lehrenden erfordert. Sie betonen die Notwendigkeit von Fort- und Weiterbildungsmaßnahmen, um das Wissen der Lehrenden zu erweitern und ihre Fähigkeiten in der barrierefreien Gestaltung digitaler Lehrveranstaltungen zu stärken. (S. 180)
7. Verschlagwortung


Technologieintegration: Die Studie befasst sich mit der Integration digitaler Technologien in die Hochschullehre und deren barrierefreie Gestaltung.


Lehr- und Lerneffektivität: Die Untersuchung der Effektivität von Lehrmethoden und der Umsetzung barrierefreier digitaler Lehre steht im Vordergrund.


Systemanpassung: Es wird erörtert, wie Hochschulen ihre Lehrsysteme an die Bedarfe einer heterogenen und digitalisierten Studierendenschaft anpassen können.


8. Kategorisierung
Kerngedanke: Die Studie zeigt, dass zur Umsetzung einer barrierefreien digitalen Hochschullehre ein erheblicher Bedarf an Weiterbildung und Unterstützung der Lehrenden besteht, um die vielfältigen Anforderungen zu erfüllen. (S. 181)
9. Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU4b: Welche technisch-gestalterischen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?


Begründung: Die Studie untersucht die technischen und didaktischen Herausforderungen bei der Umsetzung digitaler Barrierefreiheit, die für die Anpassung von Lernmanagementsystemen relevant sind.


10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie liefert wichtige Erkenntnisse zur Umsetzung digitaler Barrierefreiheit in der Hochschullehre).


Zitierhäufigkeit und Einfluss: 4 (Die Studie ist relevant und aktuell, da sie im Jahr 2023 veröffentlicht wurde).


Aktualität: 5 (Die Ergebnisse sind brandaktuell und reflektieren die neuesten Entwicklungen in der Hochschullehre).


Gesamtbewertung: 4.7
11. Schlussfolgerung
Die Studie von Kuhlmann et al. (2023) verdeutlicht die Notwendigkeit einer systematischen Unterstützung und Weiterbildung der Lehrenden, um die Herausforderungen der digitalen Barrierefreiheit in der Hochschullehre zu meistern. Die Ergebnisse liefern wichtige Impulse für die Entwicklung von Maßnahmen, die eine zugängliche Hochschullehre für alle Studierenden gewährleisten können.
},
	file = {Kuhlmann et al. - 2023 - Digitale Hochschullehre für Alle gestalten Ergebn.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/F36597IP/Kuhlmann et al. - 2023 - Digitale Hochschullehre für Alle gestalten Ergebn.pdf:application/pdf},
}

@article{ryan_systematic_2023,
	title = {Systematic literature review as a digital collaborative research-like learning activity: a case study},
	issn = {1360-2357, 1573-7608},
	shorttitle = {Systematic literature review as a digital collaborative research-like learning activity},
	url = {https://link.springer.com/10.1007/s10639-023-11997-x},
	doi = {10/gskbjs},
	abstract = {Within the higher education sector, the principle of student-active and researchbased education are established in strategy documents and action plans, but at the same time there is an ongoing debate about what is meant by research-based learning and how it can be applied in practical teaching contexts. The aim of this empirical study is to explore inclusion of research elements in higher education. The study introduces the concept of using systematic literature review (SLR) and digital collaboration as a learning method, and addresses how to succeed with digital collaborative systematic literature review as a research-like learning activity in higher education. An exploratory multiple case design is used, with participatory observation technique and thematic analysis. A practical contribution of this study is an example of how SLR is well-suited to do collective research-like learning activities. The main contribution is that the higher education teacher needs integrated knowledge, including research competence in addition to the traditional link between professional, didactic and technological competence. A model for research-like learning is proposed, which illustrates the need for research knowledge in relation to the technological pedagogical content knowledge.},
	language = {en-GB},
	urldate = {2023-07-25},
	journal = {Education and Information Technologies},
	author = {Ryan, Anne Wally and Kolås, Line and Nilsen, Anders Grov and Almås, Aslaug Grov},
	month = jul,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Promotion:Relevanz:4, \#0:Zeitschriftenartikel:digital:learning, Promotion:FU5, Promotion:S:12 Digital Learning, Promotion:Literaturverzeichnis},
	annote = {Analyse des wissenschaftlichen Artikels "Systematic literature review as a digital collaborative research-like learning activity: a case study" von Anne Wally Ryan et al. (2023).
1. Analyse
Hauptthemen und Ziele der Forschung
Der Artikel untersucht die Anwendung von systematischen Literaturübersichten (SLR) als kollaborative und forschungsähnliche Lernaktivität in der Hochschulbildung. Das Ziel der Studie ist es, herauszufinden, wie SLR in digitalen, studentisch-aktiven Lernumgebungen erfolgreich implementiert werden kann, um die Forschungskompetenzen der Studierenden zu fördern.
Methoden und Datenquellen
Die Studie verwendet ein exploratives Multi-Case-Design und setzt auf partizipative Beobachtung sowie thematische Analyse. Drei Fallstudien an zwei norwegischen Hochschulen wurden ausgewählt, um die Anwendung von SLR in verschiedenen Fächern und auf verschiedenen Bildungsniveaus zu untersuchen. Die Daten wurden durch direkte Beobachtung und die Analyse der studentischen Interaktionen und Ergebnisse gesammelt.
Zentrale Forschungsergebnisse


Komplexe Kompetenzanforderungen an Lehrende: Die erfolgreiche Durchführung von SLR als Lernaktivität erfordert von Lehrenden umfassende Kompetenzen, die über die traditionelle didaktische und technologische Kompetenz hinausgehen und auch Forschungskompetenz einschließen. (S. 5)


Relevanz und Nutzen von SLR: Die Studierenden empfanden die Methodik als relevant und nützlich für ihre eigene Forschung, insbesondere in Bezug auf Bachelor- und Masterarbeiten. (S. 4)


Herausforderungen bei der digitalen Zusammenarbeit: Die Nutzung digitaler Tools für die Zusammenarbeit war nicht immer optimal, insbesondere bei der gemeinsamen Bearbeitung großer Dokumente, was teilweise zu technischen und organisatorischen Problemen führte. (S. 4)


2. Zusammenfassung
Der Artikel untersucht, wie systematische Literaturübersichten als forschungsähnliche Lernaktivität in der Hochschulbildung eingesetzt werden können. Die Studie zeigt, dass eine erfolgreiche Implementierung von SLR eine umfassende Kompetenz der Lehrenden in den Bereichen Didaktik, Technologie und Forschung erfordert. Die Studierenden empfanden SLR als nützlich, insbesondere in Bezug auf ihre Abschlussarbeiten, obwohl technische Herausforderungen bei der digitalen Zusammenarbeit auftraten.
3. Kernaussagen


Erweiterte Kompetenzanforderungen: Lehrende benötigen neben pädagogischen und technologischen Kompetenzen auch Forschungskompetenzen, um SLR erfolgreich als Lernaktivität zu implementieren. (S. 5)


Nützlichkeit von SLR: Die Studierenden schätzen die Relevanz und den Nutzen der SLR-Methodik, insbesondere für ihre Abschlussarbeiten. (S. 4)


Herausforderungen in der digitalen Zusammenarbeit: Die Nutzung digitaler Tools brachte technische und organisatorische Herausforderungen mit sich, die die Zusammenarbeit teilweise erschwerten. (S. 4)


4. Argumentationslinien
Die Autoren argumentieren, dass systematische Literaturübersichten eine wertvolle Methode sind, um Studierende in die Forschungspraxis einzuführen. Sie betonen jedoch, dass die effektive Nutzung dieser Methode eine integrierte Kompetenz der Lehrenden erfordert, die sowohl technologische als auch forschungsbezogene Aspekte umfasst. Gleichzeitig wird auf die Notwendigkeit hingewiesen, die technischen Tools für die digitale Zusammenarbeit sorgfältig auszuwählen und anzupassen, um den Erfolg der Lernaktivitäten zu gewährleisten. (S. 6)
5. Verschlagwortung


Lehr- und Lerneffektivität: Untersuchung der Effektivität von SLR als forschungsähnliche Lernaktivität in der Hochschulbildung.


Technologieintegration: Nutzung und Herausforderungen digitaler Tools für die Zusammenarbeit bei SLR.


Forschungsansätze: Methodologische Ansätze zur Integration von Forschungselementen in den Lernprozess.


6. Kategorisierung
Kerngedanke: Der Artikel beleuchtet, wie systematische Literaturübersichten als kollaborative und forschungsähnliche Lernaktivität in der Hochschulbildung eingesetzt werden können, und betont die Notwendigkeit erweiterter Kompetenzen der Lehrenden in Forschung und Technologie. (S. 6)
7. Zuordnung zu Forschungsfragen
Passendste Forschungsunterfrage: FU5 - Welche Möglichkeiten und Grenzen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems durch Akteure im digitalen Bildungsraum von Gesundheitsberufen analysiert?
Begründung: Die Studie untersucht, wie forschungsbasierte Lernmethoden wie SLR in digitale Lernumgebungen integriert werden können, was relevante Erkenntnisse für die Weiterentwicklung von Learning-Management-Systemen bietet.
8. Einordnung der Relevanz
Relevanzbewertung: 4 - RelevantDie Quelle bietet wertvolle Einsichten in die Implementierung von forschungsähnlichen Lernaktivitäten und die Herausforderungen digitaler Zusammenarbeit in der Hochschulbildung, was von Bedeutung für die Gestaltung effektiver Lernumgebungen ist.
Diese strukturierte Analyse bietet eine detaillierte Übersicht über den Artikel und zeigt seine Relevanz für die Förderung von Forschungskompetenzen und die Integration digitaler Zusammenarbeit in der Hochschulbildung auf.
},
	file = {Ryan et al. - 2023 - Systematic literature review as a digital collabor.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/DXYGKK9E/Ryan et al. - 2023 - Systematic literature review as a digital collabor.pdf:application/pdf},
}

@inproceedings{lean_rise_2023,
	address = {Valencia, Spain},
	title = {The rise in learnification and self-exploitation in online learning},
	url = {https://library.iated.org/view/LEAN2023RIS},
	doi = {10/gr3wxd},
	abstract = {The pursuit of student-centred lifelong learning and its subsidiary goals of self-regulated learning and selfdirection have often been pitted in direct opposition to notions of the teacher and teacher-centred education and learning. While the push towards student-centred learning signals a movement away from top-down, dictatorial teaching towards allowing students to focus on their own needs and goals, it is also part of a greater social shift away from traditional forms of authority in terms of both power and knowledge. This development has been expedited by digital technology use and can be seen in the adoption of online learning-specific teaching and learning frameworks, Computer Supported Collaborative Learning systems, and other platforms. The development of student-centred pedagogies is partly a result of educational institutions' emphasis on the demands of the fourth industrial revolution. Therefore, a critical analysis of the adoption and adaptation of frameworks for student-centred learning is paramount in order to understand how student-centred learning may impact adult education in practice. This paper initially draws from Biesta's (1, 2) critique of "learnification" in education and Han's (3, 4) notion of the self-exploiting individual to argue that the role of the student is changing, that students are becoming self-exploiting individuals that decreasingly require teachers' facilitation of learning and leadership acts to move forward in learning as they are increasingly capable of self-discipline, self-regulation, and self-direction. It then argues that this process is supported by digital tools and online learning, highlighting the development of particular online learning frameworks and tools. Finally, it argues for critical reflection on frameworks for online learning, making the point that educators should step back and evaluate the ways in which allegedly emancipatory approaches and tools are being utilised in higher education.},
	language = {en-GB},
	urldate = {2023-04-07},
	author = {Lean, Graham and Barber, Wendy},
	month = mar,
	year = {2023},
