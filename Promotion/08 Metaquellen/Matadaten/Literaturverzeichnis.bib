@inproceedings{zender2023Vrf,
  title = {Virtual Reality für den Schulunterricht?!},
  author = {Zender, Raphael and Schaefer, Caterina and Leonhardt, Thiemo and Bergner, Nadine and Buchner, Josef and Wiesche, David},
  date = {2023},
  publisher = {Gesellschaft für Informatik e.V.},
