@article{moser_so_2021,
	title = {So fern und dennoch nah: {Digital} {Distance} {Learning} in der {Berufspädagogik} – {Analyse} von {Strategien} zur {Implementierung} von digitalen {Lehr}- und {Lernumgebungen} sowie {Modellierung} von effektiven {Settings} zur {Qualitätssicherung} der {Lehramtsausbildung}},
	abstract = {The teacher training programme "Sekundarstufe Berufsbildung Fachbereiche Duale Ausbildung sowie Technik und Gewerbe" has been organized as a distance learning course for several years. The heterogeneity of the students is to be seen as a challenge for the design of digital distance learning environments. This is shown by their different age structure and the associated acquired or grown skills in dealing with technologies, such as blended learning or e-learning, and their affinity to digital tools, due to their professional career. The amount raises the question of what digital competencies the students have at the beginning of their studies and researches the effects of the use of distance learning elements in the teacher training programme on the profession-related competencies of the students. Methodologically, these questions are pursued in a mixed methods design. In this article, a self-developed questionnaire to ascertain the student's profession-related competencies is presented.},
	language = {de-DE},
	journal = {didacticum: Zeitschrift für (Fach)Didaktik in Forschung und Unterricht der Pädagogischen Hochschule Steiermark},
	author = {Moser, Daniela and Jarz, Thorsten},
	year = {2021},
	note = {ZSCC: NoCitationData[s0]},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Systemanpassung, Bildung, Multimedia, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {8--22},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:
Die Studie von Moser, Jarz und Drobitz (2021) analysiert Strategien zur Implementierung von digitalen Lehr- und Lernumgebungen sowie die Modellierung effektiver Settings zur Qualitätssicherung in der Lehramtsausbildung im Bereich Berufspädagogik. Ziel ist es, die Auswirkungen von digitalen Fernstudienelementen auf die professionellen Kompetenzen von Studierenden zu untersuchen.
Verwendete Methoden und Datenquellen:
Die Studie verwendet ein Mixed-Methods-Design, das quantitative Daten (u.a. durch Fragebögen zur Erfassung digitaler Kompetenzen) und qualitative Daten (Fokusgruppen-Interviews) kombiniert. Die Erhebung der digitalen Kompetenzen erfolgt durch einen speziell entwickelten Fragebogen basierend auf dem DigiComp 2.2 AT Modell.
Zentrale Forschungsergebnisse:
Die Ergebnisse zeigen, dass die Studierenden zu Beginn ihres Studiums unterschiedliche digitale Kompetenzen aufweisen. Die Nutzung digitaler Fernstudienelemente fördert die Entwicklung professionsbezogener Kompetenzen wie Selbstkompetenz, Aufgabenkompetenz sowie soziale und Kooperationskompetenz. Die Studie betont die Notwendigkeit, digitale Kompetenzen weiter zu entwickeln und diese in die Lehramtsausbildung zu integrieren.
Zusammenfassung
Die Studie zeigt, dass digitale Fernstudienelemente eine flexible und effektive Methode sind, um die professionellen Kompetenzen von Lehramtsstudierenden im Bereich Berufspädagogik zu fördern. Sie unterstreicht die Bedeutung der Entwicklung digitaler Kompetenzen und die Notwendigkeit einer strukturierten und dialogorientierten Gestaltung von Lernprogrammen.
Kernaussagen
	•	“Die Nutzung digitaler Medien erhöht die Flexibilität der Lernorte, Lernzeiten und Lerngeschwindigkeit, was eine effektive Wissensaneignung unterstützt.” (S. 9)
	•	“Die digitalen Kompetenzen der Studierenden variieren stark, was die Notwendigkeit individueller Förderung betont.” (S. 11)
	•	“Die Integration von Fernstudienelementen fördert die Selbstkompetenz, Aufgabenkompetenz sowie soziale und Kooperationskompetenz der Studierenden.” (S. 15)
Argumentationslinien
	•	Die Studie argumentiert, dass die Heterogenität der Studierenden in Bezug auf digitale Kompetenzen eine spezielle Methodik im Umgang mit digitalen Medien erfordert.
	•	Es wird betont, dass digitale Lernumgebungen eine höhere Autonomie und Selbstregulation der Lernenden ermöglichen, was zur Entwicklung wichtiger beruflicher Kompetenzen beiträgt.
Verschlagwortung
	•	Lehr- und Lerneffektivität: Die Untersuchung zeigt, dass digitale Fernstudienelemente die Lernmotivation und -effektivität der Studierenden erhöhen.
	•	Technologieintegration: Die Integration digitaler Medien in die Lehramtsausbildung wird als zentraler Faktor für die Förderung professioneller Kompetenzen hervorgehoben.
	•	Systemanpassung: Die Notwendigkeit, Lernumgebungen so zu gestalten, dass sie selbstorganisiertes Lernen unterstützen und fördern.
	•	Forschungsansätze: Die Verwendung eines Mixed-Methods-Designs zur Untersuchung der Effektivität von digitalen Lernumgebungen.
Kategorie: Kerngedanke
Diese Studie trägt wesentlich zur Beantwortung der Forschungsfrage bei, welche bildungswissenschaftlichen Mechanismen bei der Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems in Bezug auf die Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben werden. Sie zeigt, dass digitale Fernstudienelemente und die Entwicklung digitaler Kompetenzen zentrale Komponenten dieses Mechanismus sind, indem sie die Selbstorganisation und die beruflichen Kompetenzen der Studierenden verbessern.
},
	file = {Moser und Jarz - 2021 - So fern und dennoch nah Digital Distance Learning.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/NF5LWSTW/Moser und Jarz - 2021 - So fern und dennoch nah Digital Distance Learning.pdf:application/pdf},
}

@article{schmolz_digitale_2020,
	title = {Digitale {Kluft}: {Teilhabebarrieren} für {Studierende} durch universitäres „home-learning“?},
	language = {de-DE},
	journal = {Medienimpulse},
	author = {Schmölz, Alexander and Geppert, Corinna and Barberi, Alessandro},
	year = {2020},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Systemanpassung, Datenschutz und IT-Sicherheit, Lernsystemarchitektur, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {26},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:
Die Studie von Schmölz, Geppert und Barberi (2020) untersucht die Teilhabebarrieren für Studierende während der Umstellung auf universitäres Home-Learning zu Beginn der COVID-19-Pandemie an österreichischen Universitäten. Ziel der Forschung ist es, die Auswirkungen dieser Umstellung auf die digitale Kluft und die damit verbundenen Teilhabebarrieren zu analysieren.
Verwendete Methoden und Datenquellen:


Datenquellen: Die Studie basiert auf einer Umfrage unter 412 Studierenden der Bildungswissenschaft an der Universität Wien. Die Datenerhebung erfolgte durch einen teilstrukturierten Online-Fragebogen mit offenen und geschlossenen Fragen, um sowohl quantitative als auch qualitative Daten zu sammeln.


Fokus: Untersuchung des Zugangs zu Computern und Internet (digitale Kluft erster Ordnung) sowie der Kompetenzen im Umgang mit digitalen Medien (digitale Kluft zweiter Ordnung). Zusätzliche Themen sind die Organisation des Lernens, der Zugang zur Bibliothek, gestiegene Betreuungspflichten und der Verlust von Verdienstmöglichkeiten.


Zentrale Forschungsergebnisse:


Technischer Zugang: Nur 10\% der Studierenden hatten keinen geregelten Zugang zu einem Computer, aber 57\% berichteten von Problemen mit der Geschwindigkeit des Internetzugangs.


Kompetenter Umgang: Probleme traten hauptsächlich bei neuen digitalen Werkzeugen wie BigBlueButton und Zoom auf, während etablierte Plattformen wie Moodle weniger Schwierigkeiten verursachten.


Organisation und Anforderungen: 72\% der Studierenden hatten Probleme mit der Organisation des eigenen Lernens, 75\% mit der Organisation des Tagesablaufs. Erhöhte Anforderungen in Lehrveranstaltungen und Betreuungspflichten stellten zusätzliche Barrieren dar.


Zusammenfassung
Die Studie zeigt, dass die Umstellung auf Home-Learning für die meisten Studierenden mit erheblichen Teilhabebarrieren verbunden war. Besonders die Organisation des eigenen Lernens und des Tagesablaufs, die Geschwindigkeit des Internetzugangs und erhöhte Anforderungen in Lehrveranstaltungen stellten große Herausforderungen dar.
Kernaussagen


„Die Ergebnisse zeigen, dass nicht so sehr der technische Zugang zu Computern und Internet hinderlich ist, sondern vielmehr die Kompetenzanforderungen bestimmter Technologien, die Organisation von Tages- und Wochenabläufen sowie des eigenen Lernens und der Umgang der Lehrenden mit der Situation.“ (S. 1)


„Die Zahl der Studierenden, die davon zumindest teilweise beeinträchtigt sind, liegt bei knapp über 55\%.“ (S. 13)


„Wie die Rangreihung bereits ergeben hat, haben Studierende mit der Selbstorganisation die meisten Schwierigkeiten.“ (S. 17)


Argumentationslinien


Digitale Kluft erster Ordnung: Probleme mit der Internetgeschwindigkeit und technischem Zugang beeinträchtigen die Teilnahme am Home-Learning. (S. 13)


Digitale Kluft zweiter Ordnung: Schwierigkeiten im Umgang mit neuen digitalen Werkzeugen wie BigBlueButton und Zoom weisen auf eine Kluft in der Anwendungskompetenz hin. (S. 14)


Organisation und Anforderungen: Die erhöhte Selbstorganisation und gestiegene Anforderungen in Lehrveranstaltungen stellen signifikante Barrieren dar. (S. 18)


Verschlagwortung


Lernsystemarchitektur: Anpassung von Lehrmethoden und Plattformen zur Unterstützung des Home-Learnings.


Lehr- und Lerneffektivität: Untersuchung der Barrieren, die die Effektivität des Lernens im Home-Learning-Kontext beeinflussen.


Technologieintegration: Nutzung und Implementierung verschiedener digitaler Werkzeuge und Plattformen im universitären Kontext.


Systemanpassung: Anpassung des Studiums und der Lernmethoden an die Bedingungen der COVID-19-Pandemie.


Datenschutz und IT-Sicherheit: Auseinandersetzung mit der technischen Zugänglichkeit und Sicherheit der genutzten Lernplattformen.


Kategorisierung: Kerngedanke
Begründung:
Die zentrale Idee der Studie ist die Untersuchung der digitalen Kluft nicht nur durch den technischen Zugang, sondern vor allem durch die Kompetenzanforderungen und organisatorischen Herausforderungen. Dies definiert den grundlegenden Forschungsansatz und die theoretische Ausrichtung der Arbeit. Die Studie zeigt auf, wie unterschiedliche Barrieren – technischer Zugang, Kompetenzanforderungen und organisatorische Herausforderungen – die Teilhabe am Home-Learning beeinflussen, und liefert somit einen wichtigen Beitrag zum Verständnis der digitalen Kluft im Bildungsbereich.
Kategorie: Kerngedanke
},
	file = {Schmölz et al. - 2020 - Digitale Kluft Teilhabebarrieren für Studierende .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/QPJZJA3J/Schmölz et al. - 2020 - Digitale Kluft Teilhabebarrieren für Studierende .pdf:application/pdf},
}

@article{erne_e-learning_2022,
	title = {E-{Learning} per {Webinar} in der {Orthopädie} und {Unfallchirurgie}: {Intensiviertes} {Angebot} und gesteigerte {Nachfrage} in der {COVID}-19-{Pandemie}},
	issn = {2731-7021, 2731-703X},
	shorttitle = {E-{Learning} per {Webinar} in der {Orthopädie} und {Unfallchirurgie}},
	url = {https://link.springer.com/10.1007/s00113-022-01245-1},
	doi = {10/gq4pzc},
	abstract = {Zusammenfassung
            
              Hintergrund
              Im Verlauf der COVID-19-Pandemie haben offizielle Schutzmaßnahmen traditionelle Präsenzfortbildungen zum Erliegen gebracht. Für das Fach Orthopädie und Unfallchirurgie (O\&U) gibt es bisher bezüglich der Angebots- und Nachfragesituation von E‑Learning per Webinar im Kontext der COVID-19-Pandemie keine belastbaren Zahlen.
            
            
              Fragestellung
              Das Ziel der vorliegenden Arbeit ist die quantitative Beschreibung von Angebot und Nachfrage deutschsprachiger Online-Fortbildungen mit Webinar-Charakter aus der Orthopädie und Unfallchirurgie (O\&U) im zeitlichen Zusammenhang mit der COVID-19-Pandemie.
            
            
              Material und Methoden
              Über gängige Suchmaschinen wurden deutschsprachige, nichtkommerzielle, editierte und wissenschaftlich fundierte Fortbildungen in Form von Webinaren im Bereich O\&U von Anbietern mit Sitz in Deutschland identifiziert und interviewt.
            
            
              Ergebnisse
              Alle 4 eingeschlossenen Anbieter (AO Online Campus, BVOU Study Club, OU TO GO, WebDGU) nahmen an den strukturierten Interviews teil und stimmten einer Offenlegung der Teilnehmerzahlen zu. Das Angebot von Webinaren stieg im zeitlichen Zusammenhang mit der COVID-19-Pandemie an. Ebenfalls erhöhten sich bei allen 4 Anbietern die Teilnehmerzahlen.
            
            
              Diskussion
              Während OU TO GO und der BVOU Study Club bereits vor der Pandemie auf E‑Learning-Formate spezialisiert waren, wurde das Kursangebot der AO durch den neu etablierten AO online Campus erweitert und WebDGU ganz neu konzipiert. Eine Limitation der Studie ist die exklusive Ausrichtung auf Webinare und nichtkommerzielle Anbieter. Die Ergebnisse lassen auf positive Entwicklungen in O\&U im Bereich E‑Learning hoffen.
            
            
              Graphic abstract
            
          , 
            Abstract
            
              Background
              Contact teaching was prohibited by nationwide lockdowns during the COVID-19 pandemic. The scientific literature contains no concrete figures concerning e‑learning via webinars in the subject of orthopedics and trauma surgery in the context of the COVID-19 pandemic.
            
            
              Objective
              This research study was established to collect facts and figures about webinars as a representative part of e‑learning in the subject of orthopedics and trauma surgery in the context of the COVID-19 pandemic.
            
            
              Material and methods
              German-speaking non-commercial and edited webinars, produced by suppliers from Germany were identified using common search engines. Structured interviews with questionnaires about provider, format, and number of participants in the webinars over time, were offered to the operating companies.
            
            
              Results
              The study included four suppliers of webinars (AO Online Campus, BVOU Study Club, OU TO GO and WebDGU). There was approval of all operating companies to participate in the interviews and to disclose facts and figures about their webinars. All suppliers showed an increased supply and demand for webinars during the COVID-19 pandemic.
            
            
              Discussion
              OU TO GO and BVOU Study Club already offered webinars prior to the COVID-19 pandemic. AO online Campus was designed in addition to the existing portfolio. The supply of WebDGU was newly established. Limitations of this study are the exclusion of commercial suppliers, non-German operating companies and all other types of e‑learning except webinars. The increased supply and demand for webinars during the COVID-19 pandemic gives hope for further improvement of e‑learning in the subject of orthopedics and trauma surgery.},
	language = {de-DE},
	urldate = {2022-10-26},
	journal = {Die Unfallchirurgie},
	author = {Erne, Felix and Back, David A. and Gehlen, Tobias and Baumgartner, Heiko and Zimmermann, Alexander and {AG Digitalisierung der DGOU} and Seemann, Ricarda J.},
	month = oct,
	year = {2022},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, Krisenreaktion im Bildungsbereich, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:Erne et al. (2022) untersuchen die Entwicklung und das gesteigerte Angebot von E-Learning-Webinaren in der Orthopädie und Unfallchirurgie während der COVID-19-Pandemie. Sie zielen darauf ab, die Reaktion des Bildungssektors auf die Pandemie zu dokumentieren und wie sich Angebot und Nachfrage nach Online-Fortbildungen verändert haben.
Verwendete Methoden und Datenquellen:Die Studie nutzt eine Kombination aus thematischer Online-Recherche und strukturierten Interviews, um nichtkommerzielle, wissenschaftlich fundierte Webinare in Deutschland zu identifizieren und zu analysieren.
Zentrale Forschungsergebnisse:Die Forschung zeigt, dass das Angebot an Webinaren signifikant gestiegen ist und parallel dazu auch die Teilnehmerzahlen zugenommen haben. Dies unterstreicht die Akzeptanz und Effektivität von E-Learning als Reaktion auf Unterbrechungen durch die Pandemie.
Zusammenfassung
Die Studie von Erne et al. verdeutlicht die schnelle Anpassung der Bildungsangebote in der Orthopädie und Unfallchirurgie an die durch COVID-19 bedingten Beschränkungen. Durch den Ausbau von E-Learning-Webinaren konnte die Fortbildung in diesem Fachbereich trotz physischer Distanzierung fortgesetzt werden.
Kernaussagen


"Die Webinar-Teilnehmerzahlen stiegen in Reaktion auf die Pandemie, was auf eine erfolgreiche Anpassung der Fortbildungsformate hinweist." (S. 5)


"Die schnelle Implementierung von Online-Formaten zeigt, wie flexibel und anpassungsfähig der Bildungssektor in Krisenzeiten sein kann." (S. 6)


Argumentationslinien


Die Ergebnisse unterstreichen die Bedeutung von digitaler Flexibilität in Bildungsstrukturen, insbesondere in Reaktion auf unvorhersehbare Ereignisse wie eine Pandemie.


Die Studie liefert Belege dafür, dass E-Learning nicht nur eine Notlösung ist, sondern auch langfristige Vorteile für die Bildung bietet.


Verschlagwortung


Krisenreaktion im Bildungsbereich: Anpassung von Bildungsangeboten an die Pandemiebedingungen.


Technologieintegration: Effektive Nutzung digitaler Plattformen zur Aufrechterhaltung der Bildungsqualität.


Lehr- und Lerneffektivität: Beibehaltung hoher Bildungsstandards trotz physischer Distanzierung.


Systemanpassung: Die Notwendigkeit, Bildungssysteme flexibel und schnell an veränderte Umstände anzupassen.


Kategorie: Argumentation
Die Arbeit von Erne et al. argumentiert überzeugend für die Bedeutung und Effektivität von E-Learning-Webinaren in Krisenzeiten. Sie zeigt, dass durch schnelle und zielgerichtete Anpassungen die Fortbildung in spezialisierten medizinischen Bereichen auch unter erschwerten Bedingungen erfolgreich fortgesetzt werden kann.
},
	file = {Erne et al. - 2022 - E-Learning per Webinar in der Orthopädie und Unfal.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/PNHY983V/Erne et al. - 2022 - E-Learning per Webinar in der Orthopädie und Unfal.pdf:application/pdf},
}

@article{kalaitzoglou_multilingual_2020,
	title = {Multilingual {Global} {E}-{Learning} {Pediatric} {Endocrinology} and {Diabetes} {Curriculum} for {Front} {Line} {Health} {Care} {Providers} in {Resource}-{Limited} {Countries}: {Development} {Study}},
	volume = {4},
	issn = {2561-326X},
	shorttitle = {Multilingual {Global} {E}-{Learning} {Pediatric} {Endocrinology} and {Diabetes} {Curriculum} for {Front} {Line} {Health} {Care} {Providers} in {Resource}-{Limited} {Countries}},
	url = {https://formative.jmir.org/2020/11/e18555},
	doi = {10.2196/18555},
	abstract = {Background: Electronic learning (e-learning) is a widely accessible, low-cost option for learning remotely in various settings that allows interaction between an instructor and a learner.
Objective: We describe the development of a free and globally accessible multilingual e-learning module that provides education material on topics in pediatric endocrinology and diabetes and that is intended for first-line physicians and health workers but also trainees or medical specialists in resource-limited countries.
Methods: As complements to concise chapters, interactive vignettes were constructed, exemplifying clinical issues and pitfalls, with specific attention to the 3 levels of medical health care in resource-limited countries. The module is part of a large e-learning portal, ESPE e-learning, which is based on ILIAS (Integriertes Lern-, Informations- und Arbeitskooperations-System), an open-source web-based learning management system. Following a review by global experts, the content was translated by native French, Spanish, Swahili, and Chinese–speaking colleagues into their respective languages using a commercial web-based translation tool (SDL Trados Studio).
Results: Preliminary data suggest that the module is well received, particularly in targeted parts of the world and that active promotion to inform target users is warranted.
Conclusions: The e-learning module is a free globally accessible multilingual up-to-date tool for use in resource-limited countries that has been utilized thus far with success. Widespread use will require dissemination of the tool on a global scale.},
	language = {en-GB},
	number = {11},
	urldate = {2024-05-14},
	journal = {JMIR Formative Research},
	author = {Kalaitzoglou, Evangelia and Majaliwa, Edna and Zacharin, Margaret and De Beaufort, Carine and Chanoine, Jean-Pierre and Van Wijngaard-DeVugt, Conny and Sperla, Ervin and Boot, Annemieke M and Drop, Stenvert L S},
	month = nov,
	year = {2020},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Bildungstheorien, Promotion:Argumentation, \#1:Zeitschriftenartikel:learning:management:system, Krisenreaktion im Bildungsbereich, Kompetenzentwicklung, Promotion:S:01 Learning Management System, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {e18555},
	file = {Kalaitzoglou et al. - 2020 - Multilingual Global E-Learning Pediatric Endocrino.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/JFI3FNQE/Kalaitzoglou et al. - 2020 - Multilingual Global E-Learning Pediatric Endocrino.pdf:application/pdf},
}

@article{machleid_perceptions_2020,
	title = {Perceptions of {Digital} {Health} {Education} {Among} {European} {Medical} {Students}: {Mixed} {Methods} {Survey}},
	volume = {22},
	issn = {1438-8871},
	shorttitle = {Perceptions of {Digital} {Health} {Education} {Among} {European} {Medical} {Students}},
	url = {http://www.jmir.org/2020/8/e19827/},
	doi = {10.2196/19827},
	abstract = {Background: Digital health technologies hold promise to enhance patient-related outcomes, to support health care staff by reducing their workload, and to improve the coordination of care. As key users of digital health technologies, health care workers are crucial to enable a meaningful digital transformation of health care. Digital health literacy and digital skills should become prerequisite competencies for health professionals to facilitate the implementation and leverage the potential of digital technologies to improve health.
Objective: We aimed to assess European medical students’ perceived knowledge and opinions toward digital health, the status of digital health implementation in medical education, and the students’ most pressing needs.
Methods: The explanatory design of our mixed methods study was based on an online, anonymous, self-administered survey targeted toward European medical students. A linear regression analysis was used to identify the influence of the year of medical studies on the responses. Additional analysis was performed by grouping the responses by the self-evaluated frequency of eHealth technology use. Written responses to four qualitative questions in the survey were analyzed using an inductive approach.
Results: The survey received a total of 451 responses from 39 European countries, and there were respondents for every year of medical studies. The majority of respondents saw advantages in the use of digital health. While 40.6\% (183/451) felt prepared to work in a digitized health care system, more than half (240/451, 53.2\%) evaluated their eHealth skills as poor or very poor. Medical students considered lack of education to be the reason for this, with 84.9\% (383/451) agreeing or strongly agreeing that more digital health education should be implemented in the medical curriculum. Students demanded introductory and specific eHealth courses covering data management, ethical aspects, legal frameworks, research and entrepreneurial opportunities, role in public health and health systems, communication skills, and practical training. The emphasis lay on tailoring learning to future job requirements and interprofessional education.
Conclusions: This study shows a lack of digital health-related formats in medical education and a perceived lack of digital health literacy among European medical students. Our findings indicate a gap between the willingness of medical students to take an active role by becoming key players in the digital transformation of health care and the education that they receive through their faculties.},
	language = {en-GB},
	number = {8},
	urldate = {2024-05-14},
	journal = {Journal of Medical Internet Research},
	author = {Machleid, Felix and Kaczmarczyk, Robert and Johann, Doreen and Balčiūnas, Justinas and Atienza-Carbonell, Beatriz and Von Maltzahn, Finn and Mosch, Lina},
	month = aug,
	year = {2020},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Systemanpassung, Bildungstheorien, \#1:Zeitschriftenartikel:learning:management:system, Promotion:S:01 Learning Management System, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {e19827},
	annote = {1. Analyse
Hauptthemen und -ziele der Forschung: Die Studie von Machleid et al. untersucht die Wahrnehmung und Einstellung europäischer Medizinstudenten zu digitaler Gesundheitsbildung. Sie zielt darauf ab, das Bewusstsein und die Kompetenz in Bezug auf digitale Gesundheitstechnologien zu erhöhen und die Implementierung in medizinische Lehrpläne zu fördern.
Verwendete Methoden und Datenquellen: Es wurde eine mixed-methods Umfrage durchgeführt, die quantitative und qualitative Methoden kombiniert, um ein umfassendes Bild der Studentenmeinungen und -erfahrungen zu erhalten. Die Daten wurden online gesammelt und sowohl statistisch als auch durch inductive Content-Analyse ausgewertet.
Zentrale Forschungsergebnisse: Die Studie zeigt, dass viele Medizinstudenten ihre digitalen Gesundheitskompetenzen als unzureichend empfinden und eine stärkere Einbindung digitaler Gesundheitsthemen in die Lehrpläne fordern. Die Studienteilnehmer erkennen das Potenzial digitaler Gesundheitstechnologien, fühlen sich jedoch nicht ausreichend darauf vorbereitet.
2. Zusammenfassung
Die Ergebnisse von Machleid et al. verdeutlichen eine signifikante Diskrepanz zwischen dem wahrgenommenen Bedarf an digitaler Gesundheitsbildung und der tatsächlichen Ausbildung europäischer Medizinstudenten. Es besteht eine klare Nachfrage nach einer intensiveren Integration von eHealth-Themen in medizinische Curricula, um zukünftige Ärzte besser auf die digitale Transformation im Gesundheitswesen vorzubereiten.
3. Kernaussagen


"84,9\% der Befragten stimmten zu, dass mehr digitale Gesundheitsbildung im Medizinstudium implementiert werden sollte." (S. 4)


"Mehr als die Hälfte der Befragten bewertete ihre eHealth-Fähigkeiten als schlecht oder sehr schlecht." (S. 3)


"Es besteht ein großer Bedarf an spezifischen eHealth-Kursen, die Datenmanagement, ethische Aspekte und praktische Anwendung abdecken." (S. 7)


4. Argumentationslinien
Die Argumentation in der Studie stützt sich auf die wachsende Bedeutung digitaler Technologien im Gesundheitswesen und die Notwendigkeit, Medizinstudenten darauf vorzubereiten. Die Autoren betonen, dass eine verbesserte digitale Gesundheitsbildung nicht nur die Kompetenz der Studierenden erhöht, sondern auch zur effektiveren und effizienteren Patientenversorgung beitragen kann.
5. Verschlagwortung


Bildungstheorien: Die Studie unterstützt die Theorie, dass eine umfassende Bildung, die digitale Kompetenzen einschließt, wesentlich für die moderne medizinische Ausbildung ist.


Lehr- und Lerneffektivität: Der Bedarf an verbesserten Lehrmethoden für digitale Gesundheit zeigt, dass bestehende Bildungsansätze nicht ausreichen, um effektive Lernerfahrungen zu gewährleisten.


Technologieintegration: Die Forderung nach mehr eHealth-Inhalten im Lehrplan zeigt die Notwendigkeit, Technologie tiefgreifender in die medizinische Ausbildung zu integrieren.


Forschungsansätze: Die mixed-methods Ansatz bietet einen umfassenden Einblick in die Einstellungen und Bedürfnisse von Medizinstudenten bezüglich digitaler Gesundheitsbildung.


Systemanpassung: Die Erkenntnisse betonen die Notwendigkeit, Bildungssysteme zu erweitern und anzupassen, um auf die technologischen Veränderungen im Gesundheitswesen reagieren zu können.


},
	file = {Machleid et al. - 2020 - Perceptions of Digital Health Education Among Euro.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/HYHNCD63/Machleid et al. - 2020 - Perceptions of Digital Health Education Among Euro.pdf:application/pdf},
}

@article{lee_use_2020,
	title = {Use of {Digital} {Technology} to {Enhance} {Tuberculosis} {Control}: {Scoping} {Review}},
	volume = {22},
	issn = {1438-8871},
	shorttitle = {Use of {Digital} {Technology} to {Enhance} {Tuberculosis} {Control}},
	url = {https://www.jmir.org/2020/2/e15727},
	doi = {10.2196/15727},
	abstract = {Background: Tuberculosis (TB) is the leading cause of death from a single infectious agent, with around 1.5 million deaths reported in 2018, and is a major contributor to suffering worldwide, with an estimated 10 million new cases every year. In the context of the World Health Organization’s End TB strategy and the quest for digital innovations, there is a need to understand what is happening around the world regarding research into the use of digital technology for better TB care and control.
Objective: The purpose of this scoping review was to summarize the state of research on the use of digital technology to enhance TB care and control. This study provides an overview of publications covering this subject and answers 3 main questions: (1) to what extent has the issue been addressed in the scientific literature between January 2016 and March 2019, (2) which countries have been investing in research in this field, and (3) what digital technologies were used?
Methods: A Web-based search was conducted on PubMed and Web of Science. Studies that describe the use of digital technology with specific reference to keywords such as TB, digital health, eHealth, and mHealth were included. Data from selected studies were synthesized into 4 functions using narrative and graphical methods. Such digital health interventions were categorized based on 2 classifications, one by function and the other by targeted user.
Results: A total of 145 relevant studies were identified out of the 1005 published between January 2016 and March 2019. Overall, 72.4\% (105/145) of the research focused on patient care and 20.7\% (30/145) on surveillance and monitoring. Other programmatic functions 4.8\% (7/145) and electronic learning 2.1\% (3/145) were less frequently studied. Most digital health technologies used for patient care included primarily diagnostic 59.4\% (63/106) and treatment adherence tools 40.6\% (43/106). On the basis of the second type of classification, 107 studies targeted health care providers (107/145, 73.8\%), 20 studies targeted clients (20/145, 13.8\%), 17 dealt with data services (17/145, 11.7\%), and 1 study was on the health system or resource management. The first authors’ affiliations were mainly from 3 countries: the United States (30/145 studies, 20.7\%), China (20/145 studies, 13.8\%), and India (17/145 studies, 11.7\%). The researchers from the United States conducted their research both domestically and abroad, whereas researchers from China and India conducted all studies domestically.
Conclusions: The majority of research conducted between January 2016 and March 2019 on digital interventions for TB focused on diagnostic tools and treatment adherence technologies, such as video-observed therapy and SMS. Only a few studies addressed interventions for data services and health system or resource management.},
	language = {en-GB},
	number = {2},
	urldate = {2024-05-14},
	journal = {Journal of Medical Internet Research},
	author = {Lee, Yejin and Raviglione, Mario C and Flahault, Antoine},
	month = feb,
	year = {2020},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, \#1:Zeitschriftenartikel:learning:management:system, Krisenreaktion im Bildungsbereich, Promotion:S:01 Learning Management System, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {e15727},
	annote = {1. Analyse
Hauptthemen und -ziele der Forschung: Die Studie von Lee et al. erforscht den Einsatz digitaler Technologien zur Verbesserung der Tuberkulosebekämpfung. Der Schwerpunkt liegt darauf, wie digitale Gesundheitsinterventionen die Diagnose, Behandlung und Überwachung der Tuberkulose beeinflussen können.
Verwendete Methoden und Datenquellen: Es wurde eine umfangreiche Literaturrecherche in den Datenbanken PubMed und Web of Science durchgeführt. Eingeschlossen wurden Studien, die zwischen Januar 2016 und März 2019 veröffentlicht wurden und die Anwendung digitaler Technologien im Kontext der Tuberkulose thematisieren.
Zentrale Forschungsergebnisse: Es wurden 145 relevante Studien identifiziert, die sich hauptsächlich auf Patientenversorgung (72,4\%) und Überwachung (20,7\%) konzentrierten. Die meisten digitalen Gesundheitstechnologien wurden für diagnostische Zwecke und zur Behandlungsadhärenz eingesetzt, einschließlich videoüberwachter Therapie und SMS-basierter Kommunikation.
2. Zusammenfassung
Die Studie von Lee et al. zeigt, dass digitale Technologien eine entscheidende Rolle in der modernen Tuberkulosebekämpfung spielen, insbesondere durch die Verbesserung der Diagnosegenauigkeit und die Unterstützung der Behandlungsadhärenz. Trotz der breiten Anwendung gibt es jedoch Bedarf an weiterer Forschung, insbesondere im Bereich der Gesundheitssystemverwaltung und der Patientenunterstützung.
3. Kernaussagen


"Die Mehrheit der Studien konzentrierte sich auf die Verbesserung der Diagnose und Behandlungsadhärenz durch digitale Technologien." (S. 1-2)


"Nur wenige Studien adressierten die Unterstützung des Gesundheitssystems oder die Datenverwaltung, was auf eine Lücke in der aktuellen Forschung hinweist." (S. 3)


"Die Forschung muss sich verstärkt auf die Entwicklung und Implementierung von Interventionen konzentrieren, die die Patienten direkt unterstützen." (S. 3-4)


4. Argumentationslinien
Die Studie betont die Notwendigkeit, digitale Technologien nicht nur zur Verbesserung der Effizienz von Gesundheitsdienstleistern einzusetzen, sondern auch zur direkten Unterstützung der Patienten, um eine umfassende und effektive Tuberkulosekontrolle zu gewährleisten.
5. Verschlagwortung


Technologieintegration: Die umfassende Nutzung digitaler Diagnose- und Behandlungstools zeigt die tiefgreifende Integration von Technologie in die TB-Kontrolle.


Lehr- und Lerneffektivität: Die Anwendung digitaler Werkzeuge unterstützt die Schulung von Gesundheitspersonal und verbessert die Behandlungsüberwachung.


Systemanpassung: Der Bedarf an angepassten Gesundheitssystemen, die digitale Technologien effektiv nutzen, wird klar hervorgehoben.


Forschungsansätze: Die methodische Durchführung einer Scoping-Review bietet eine solide Basis für zukünftige Forschungen im Bereich der digitalen Gesundheit.


Krisenreaktion im Bildungsbereich: Die Studie verdeutlicht, wie digitale Technologien dazu beitragen können, schneller und effizienter auf Gesundheitskrisen zu reagieren.


},
	file = {Lee et al. - 2020 - Use of Digital Technology to Enhance Tuberculosis .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/2RJSXJNH/Lee et al. - 2020 - Use of Digital Technology to Enhance Tuberculosis .pdf:application/pdf},
}

@article{jin_educational_2014,
	title = {Educational {Technologies} in {Problem}-{Based} {Learning} in {Health} {Sciences} {Education}: {A} {Systematic} {Review}},
	volume = {16},
	issn = {1438-8871},
	shorttitle = {Educational {Technologies} in {Problem}-{Based} {Learning} in {Health} {Sciences} {Education}},
	url = {http://www.jmir.org/2014/12/e251/},
	doi = {10.2196/jmir.3240},
	abstract = {Background: As a modern pedagogical philosophy, problem-based learning (PBL) is increasingly being recognized as a major research area in student learning and pedagogical innovation in health sciences education. A new area of research interest has been the role of emerging educational technologies in PBL. Although this field is growing, no systematic reviews of studies of the usage and effects of educational technologies in PBL in health sciences education have been conducted to date.
Objective: The aim of this paper is to review new and emerging educational technologies in problem-based curricula, with a specific focus on 3 cognate clinical disciplines: medicine, dentistry, and speech and hearing sciences. Analysis of the studies reviewed focused on the effects of educational technologies in PBL contexts while addressing the particular issue of scaffolding of student learning.
Methods: A comprehensive computerized database search of full-text articles published in English from 1996 to 2014 was carried out using 3 databases: ProQuest, Scopus, and EBSCOhost. Eligibility criteria for selection of studies for review were also determined in light of the population, intervention, comparison, and outcomes (PICO) guidelines. The population was limited to postsecondary education, specifically in dentistry, medicine, and speech and hearing sciences, in which PBL was the key educational pedagogy and curriculum design. Three types of educational technologies were identified as interventions used to support student inquiry: learning software and digital learning objects; interactive whiteboards (IWBs) and plasma screens; and learning management systems (LMSs).
Results: Of 470 studies, 28 were selected for analysis. Most studies examined the effects of learning software and digital learning objects (n=20) with integration of IWB (n=5) and LMS (n=3) for PBL receiving relatively less attention. The educational technologies examined in these studies were seen as potentially fit for problem-based health sciences education. Positive outcomes for student learning included providing rich, authentic problems and/or case contexts for learning; supporting student development of medical expertise through the accessing and structuring of expert knowledge and skills; making disciplinary thinking and strategies explicit; providing a platform to elicit articulation, collaboration, and reflection; and reducing perceived cognitive load. Limitations included cumbersome scenarios, infrastructure requirements, and the need for staff and student support in light of the technological demands of new affordances.
Conclusions: This literature review demonstrates the generally positive effect of educational technologies in PBL. Further research into the various applications of educational technology in PBL curricula is needed to fully realize its potential to enhance problem-based approaches in health sciences education.},
	language = {en-GB},
	number = {12},
	urldate = {2024-05-14},
	journal = {Journal of Medical Internet Research},
	author = {Jin, Jun and Bridges, Susan M},
	month = dec,
	year = {2014},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Promotion:Kerngedanke, Technologieintegration, Systemanpassung, Bildungstheorien, \#1:Zeitschriftenartikel:learning:management:system, Krisenreaktion im Bildungsbereich, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {e251},
	annote = {1. Analyse
Hauptthemen und -ziele der Forschung: Die Arbeit von Jin und Bridges konzentriert sich auf die Anwendung und die Auswirkungen von Bildungstechnologien im Problem-basierten Lernen (PBL) in der Ausbildung der Gesundheitswissenschaften. Ihr Hauptziel ist es, zu untersuchen, wie verschiedene Bildungstechnologien PBL-Prozesse unterstützen und die kognitive Last für die Lernenden verringern können.
Verwendete Methoden und Datenquellen: Die Autoren führten eine systematische Überprüfung durch, bei der relevante Studien aus Datenbanken wie ProQuest, Scopus und EBSCOhost gesammelt wurden. Die Einschlusskriterien orientierten sich am PICO-Modell (Population, Intervention, Comparison, Outcome).
Zentrale Forschungsergebnisse: Die Analyse ergab, dass Bildungstechnologien wie Lernsoftware, digitale Lernobjekte, interaktive Whiteboards und Lernmanagementsysteme positive Auswirkungen auf das studentische Lernen im Kontext von PBL haben, insbesondere durch Bereitstellung authentischer Probleme und Unterstützung der Entwicklung medizinischer Expertise.
2. Zusammenfassung
Die Studie zeigt die allgemein positiven Effekte von Bildungstechnologien im Rahmen des PBL. Diese Technologien erleichtern den Zugang zu strukturierten Informationen, unterstützen die Explikation fachlicher Denkprozesse und fördern Kollaboration sowie Reflexion unter den Lernenden. Trotz der positiven Befunde weisen die Autoren auf Herausforderungen wie die Infrastruktur und die Notwendigkeit der Unterstützung von Personal und Studierenden hin.
3. Kernaussagen


"Bildungstechnologien reduzieren die kognitive Belastung und unterstützen das Lernen in komplexen Domänen." (S. 13)


"Die Implementierung muss sorgfältig geplant sein, um Ressourcen effizient zu nutzen und Lehrkräfte sowie Studierende angemessen zu schulen." (S. 13)


"Die positiven Auswirkungen auf das studentische Lernen beinhalten die Bereitstellung reicher, authentischer Lernkontexte und das Fördern selbstgesteuerter Lernfähigkeiten." (S. 10)


4. Argumentationslinien
Die Argumentation der Autoren stützt sich darauf, dass Bildungstechnologien, wenn sie wohlüberlegt eingesetzt werden, das PBL effektiv unterstützen können, indem sie z.B. Zugang zu Expertenwissen bieten und Lernprozesse strukturieren. Dies führt zu einer tieferen und effektiveren Auseinandersetzung der Studierenden mit den Lerninhalten.
5. Verschlagwortung


Bildungstheorien: Die Anwendung von Bildungstechnologien in PBL zeigt, wie moderne pädagogische Theorien in die Praxis umgesetzt werden können.


Technologieintegration: Die Studie demonstriert erfolgreiche Integration von Technologie in PBL, was die Lehr- und Lerneffektivität erhöht.


Systemanpassung: Die Anpassung von Bildungssystemen an die Nutzung von Bildungstechnologien wird als notwendig erachtet, um die Potenziale voll auszuschöpfen.


Forschungsansätze: Die systematische Überprüfung von Jin und Bridges bietet einen strukturierten Ansatz zur Untersuchung der Effekte von Bildungstechnologien in PBL.


Krisenreaktion im Bildungsbereich: Die Studie betont, wie wichtig flexible und anpassungsfähige Lehrmethoden in der Bildung sind, um auf sich ändernde Lernbedürfnisse und technologische Entwicklungen reagieren zu können.


},
	file = {Jin und Bridges - 2014 - Educational Technologies in Problem-Based Learning.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/XDRDZPSA/Jin und Bridges - 2014 - Educational Technologies in Problem-Based Learning.pdf:application/pdf},
}

@article{buabbas_health_2016,
	title = {Health {Sciences} {Students}’ {Self}-{Assessment} of {Information} and {Communication} {Technology} {Skills} and {Attitude} {Toward} e-{Learning}},
	volume = {2},
	issn = {2369-3762},
	url = {http://mededu.jmir.org/2016/1/e9/},
	doi = {10.2196/mededu.5606},
	abstract = {Background: In medical education, information and communication technology (ICT) knowledge and skills have become a necessity and an integral part of preparing tomorrow’s doctors to be sufficiently competent to use informatics resources effectively and efficiently for the best practice of medicine.
Objective: This research aimed to study the literacy of the preprofessional students in ICT before and after taking the basic informatics course at the Health Sciences Center at Kuwait University, to understand their potential and their attitudes toward using ICT, including e-learning.
Methods: A validated questionnaire was used to collect data from 200 students in 2 stages: before and after the informatics course on the preprofessional program. In addition, the tutors’ observational assessments of the students’ achievements during the informatics course were obtained.
Results: The response rate of students before the course was 85.5\% (171/200) and after was 77\% (154/200). Of 200 students, 85\% were female, and 15\% were male. This disproportional representation of genders was due to the fact that 85\% of registered students were female. Approximately 59\% (101/171) of the students assessed themselves before the course as computer literate; afterward, this increased to 70.1\% (108/154). Students who were still computer illiterate (29.2\%; 45/154) mostly used the excuse of a lack of time (60\%; 27/45). In generic ICT skills, the highest levels were for word processing, email, and Web browsing, whereas the lowest levels were for spreadsheets and database. In specific ICT skills, most respondents were reported low levels for statistical package use and Web page design. The results found that there was a significant improvement between students’ general ICT skills before and after the course. The results showed that there were significant improvement between how frequently students were using Medline (P{\textless}.001), Google Scholar (P{\textless}.001), and Cochrane Library (P{\textless}.001) before and after the informatics course. Furthermore, most of the students who completed the course (72.8\%; 110/151) chose the learning management system as the most useful e-learning tool. The results of the tutors’ assessments confirmed the obvious improvement in most of the students’ skills in using ICT.
Conclusions: The ICT knowledge and skills of the students before the course seemed insufficient, and the magnitude of the improvements that were acquired throughout the informatics course was obvious in most of the students’ performance. However, the findings reveal that more practice was required. The attitudes of most of the students toward the potential of e-learning were considered positive, although the potential of Web-based learning in medical training was not well known among the students.},
	language = {en-GB},
	number = {1},
	urldate = {2024-05-14},
	journal = {JMIR Medical Education},
	author = {Buabbas, Ali Jassem and Al-Shawaf, Hamza Mohammad Hassan and Almajran, Abdullah Abdulaziz},
	month = jun,
	year = {2016},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Systemanpassung, \#1:Zeitschriftenartikel:learning:management:system, Datenschutz und IT-Sicherheit, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {e9},
	file = {Buabbas et al. - 2016 - Health Sciences Students’ Self-Assessment of Infor.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/4BRFCXVW/Buabbas et al. - 2016 - Health Sciences Students’ Self-Assessment of Infor.pdf:application/pdf},
}

@article{sarma_integrating_2023,
	title = {Integrating {Battlefield} {Documentation} into {Virtual} {Reality} {Medical} {Simulation} {Training}: {Virtual} {Battlefield} {Assisted} {Trauma} {Distributed} {Observation} {Kit} ({BATDOK})},
	volume = {188},
	issn = {1930-613X},
	shorttitle = {Integrating {Battlefield} {Documentation} into {Virtual} {Reality} {Medical} {Simulation} {Training}},
	doi = {10.1093/milmed/usad051},
	abstract = {INTRODUCTION: Clinical documentation is an essential component of the provision of medical care, enabling continuity of information across provider and site handoffs. This is particularly important in the combat casualty care setting when a single casualty may be treated by four or more or five completely disparate teams across the roles of care. The Battlefield Assisted Trauma Distributed Observation Kit (BATDOK) is a digital battlefield clinical documentation system developed by the Air Force Research Laboratory to address this need. To support the deployment of this tool, we integrated BATDOK into a commercially available virtual reality (VR) medical simulation platform used by the U.S. Air Force and Defense Health Agency personnel in order to provide an immersive simulation training experience which included battlefield documentation.
METHODS: A multidisciplinary team consisting of medical educators, VR simulation engineers, emergency physicians and pararescuemen, and BATDOK developers first developed a specification for a virtual BATDOK capability, including a detailed listing of learning objectives, critical interfaces and task plans, and sensor integrations. These specifications were then implemented into the commercially available Virtual Advancement of Learning for Operational Readiness VR Medical Simulation System and underwent developmental testing and evaluation during pararescueman training exercises at the Air Force Special Operations Command Special Operations Center for Medical Integration and Development.
RESULTS AND CONCLUSIONS: The BATDOK capability was successfully implemented within the VR Medical Simulation System. The capability consisted of a virtual tablet with replicated interfaces and capabilities based on the developed specifications. These capabilities included integrated point-of-care ultrasound capability, multi-patient management, vitals sign monitoring with sensor pairing and continuous monitoring, mechanism of injury documentation (including injury pattern documentation), intervention logging (including tourniquets, dressing, airways, lines, tubes and drains, splints, fluids, and medications), and event logging. The capability was found to be operational and in alignment with learning objectives and user acceptance goals.},
	language = {en-GB},
	number = {Suppl 6},
	journal = {Military Medicine},
	author = {Sarma, Karthik V. and Barrie, Michael G. and Dorsch, John R. and Andre, Tanner W. and Polson, Jennifer S. and Ribeira, Rosie J. and Andre, Tyler B. and Ribeira, Ryan J.},
	month = nov,
	year = {2023},
	keywords = {Simulation, Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Weiterführung, \#1:Zeitschriftenartikel:learning:management:system, Krisenreaktion im Bildungsbereich, Humans, Virtual Reality, Computer Simulation, Simulation Training, Tourniquets, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {110--115},
	annote = {1. Analyse
Hauptthemen und -ziele der Forschung: Die Studie von Sarma et al. konzentriert sich auf die Integration des Battlefield Assisted Trauma Distributed Observation Kit (BATDOK) in ein Virtual Reality (VR) basiertes medizinisches Simulationstraining. Ziel ist es, die Kommunikation und Dokumentation im Bereich der Kriegsmedizin durch die Nutzung von VR zu verbessern und somit die Behandlung von Verwundeten effektiver zu gestalten.
Verwendete Methoden und Datenquellen: Die Methodik umfasst die Entwicklung einer virtuellen Implementierung von BATDOK innerhalb des Virtual Reality Medical Simulation Systems (VRMSS). Ein interdisziplinäres Team aus medizinischen Direktoren, Rettungskräften, Notfallmedizinern, VR-Ingenieuren und Curriculum-Entwicklern wurde zusammengebracht, um die Spezifikationen zu entwerfen und umzusetzen. Die Entwicklung folgte einem zyklischen Prozess von Design, Spezifikation, Implementierung und rückkoppelnden Testphasen.
Zentrale Forschungsergebnisse: Die Implementierung des virtuellen BATDOK war erfolgreich und umfasste eine Nachbildung der realen BATDOK-Oberfläche auf einem virtuellen Tablet innerhalb des VRMSS. Die Funktionen umfassten die Überwachung mehrerer Patienten, Vitalzeichenüberwachung, Dokumentation von Verletzungsmustern und medizinischen Interventionen. Die Bewertung ergab, dass das System die festgelegten Lernziele erfüllt und von den Anwendern gut angenommen wurde.
2. Zusammenfassung
Sarma et al. dokumentieren erfolgreich die Entwicklung und Integration einer BATDOK-Simulation in ein VR-gestütztes medizinisches Simulationstrainingssystem. Durch die Simulation wurden nicht nur die technischen Fähigkeiten der medizinischen Fachkräfte verbessert, sondern auch ihre Fähigkeit zur Dokumentation und Kommunikation in komplexen und dynamischen Kampfsituationen. Die Studie zeigt das Potenzial von VR in der medizinischen Ausbildung und betont die Notwendigkeit, aktuelle technologische Entwicklungen in die Trainingsprogramme zu integrieren.
3. Kernaussagen


"Die Integration von BATDOK in das VRMSS verbessert die Fähigkeiten der Mediziner, in Echtzeit auf mehrere Patienten zu reagieren und medizinische Daten effizient zu dokumentieren." (S. 112)


"Die Anwendung von VR in der medizinischen Simulation ermöglicht eine realistische und wiederholbare Trainingsumgebung, die entscheidend für die operative Bereitschaft ist." (S. 113)


"Die positive Bewertung durch die Benutzer bestätigt die Effektivität und Nutzerfreundlichkeit des VR-gestützten Trainings." (S. 114)


4. Argumentationslinien
Die Studie argumentiert, dass die Kombination von VR-Technologie mit fortschrittlichen Dokumentationswerkzeugen wie BATDOK die Qualität und Effektivität der medizinischen Ausbildung steigert. Durch die realistische Simulation kritischer medizinischer Szenarien können medizinische Fachkräfte ihre Fähigkeiten unter realen Bedingungen verbessern, was letztendlich zur Erhöhung der Überlebensrate und zur Verringerung von Komplikationen bei Verletzten führen kann. (S. 112-114)
5. Verschlagwortung


Technologieintegration: Die erfolgreiche Einbindung von VR und BATDOK zeigt, wie Technologie die medizinische Ausbildung revolutionieren kann.


Lehr- und Lerneffektivität: Die Verbesserung der Fähigkeiten der Mediziner durch das VR-Training unterstreicht die hohe Effektivität dieser Lehrmethode.


Systemanpassung: Die Anpassungsfähigkeit des VR-Systems an spezifische militärmedizinische Anforderungen zeigt die Flexibilität und Relevanz der Technologie.


Krisenreaktion im Bildungsbereich: Die Nutzung von VR zur Simulation von Kriegsszenarien bereitet medizinisches Personal effektiv auf Krisensituationen vor.


Forschungsansätze: Die methodische Integration von BATDOK in die VR-Umgebung stellt einen innovativen Forschungsansatz in der medizinischen Simulation dar.


},
	file = {Sarma et al. - 2023 - Integrating Battlefield Documentation into Virtual.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/VH7IF65C/Sarma et al. - 2023 - Integrating Battlefield Documentation into Virtual.pdf:application/pdf},
}

@article{zsidai_practical_2023,
	title = {A practical guide to the implementation of {AI} in orthopaedic research - part 1: opportunities in clinical application and overcoming existing challenges},
	volume = {10},
	issn = {2197-1153},
	shorttitle = {A practical guide to the implementation of {AI} in orthopaedic research - part 1},
	doi = {10.1186/s40634-023-00683-z},
	abstract = {Artificial intelligence (AI) has the potential to transform medical research by improving disease diagnosis, clinical decision-making, and outcome prediction. Despite the rapid adoption of AI and machine learning (ML) in other domains and industry, deployment in medical research and clinical practice poses several challenges due to the inherent characteristics and barriers of the healthcare sector. Therefore, researchers aiming to perform AI-intensive studies require a fundamental understanding of the key concepts, biases, and clinical safety concerns associated with the use of AI. Through the analysis of large, multimodal datasets, AI has the potential to revolutionize orthopaedic research, with new insights regarding the optimal diagnosis and management of patients affected musculoskeletal injury and disease. The article is the first in a series introducing fundamental concepts and best practices to guide healthcare professionals and researcher interested in performing AI-intensive orthopaedic research studies. The vast potential of AI in orthopaedics is illustrated through examples involving disease- or injury-specific outcome prediction, medical image analysis, clinical decision support systems and digital twin technology. Furthermore, it is essential to address the role of human involvement in training unbiased, generalizable AI models, their explainability in high-risk clinical settings and the implementation of expert oversight and clinical safety measures for failure. In conclusion, the opportunities and challenges of AI in medicine are presented to ensure the safe and ethical deployment of AI models for orthopaedic research and clinical application. Level of evidence IV.},
	language = {en-GB},
	number = {1},
	journal = {Journal of Experimental Orthopaedics},
	author = {Zsidai, Bálint and Hilkert, Ann-Sophie and Kaarre, Janina and Narup, Eric and Senorski, Eric Hamrin and Grassi, Alberto and Ley, Christophe and Longo, Umile Giuseppe and Herbst, Elmar and Hirschmann, Michael T. and Kopf, Sebastian and Seil, Romain and Tischer, Thomas and Samuelsson, Kristian and Feldt, Robert and {ESSKA Artificial Intelligence Working Group}},
	month = nov,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Weiterführung, \#1:Zeitschriftenartikel:learning:management:system, Krisenreaktion im Bildungsbereich, Lernsystemarchitektur, Ethics, Artificial intelligence, AI, ML, Machine learning, Decision support systems, Digital twins, Explainability, Generalizability, Large language models, Learning series, Orthopaedics, Provenance, Research methods, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {117},
	annote = {1. Analyse
Hauptthemen und -ziele der Forschung: Die Studie von Zsidai et al. beschäftigt sich mit der Implementierung von künstlicher Intelligenz (KI) in der orthopädischen Forschung. Sie zielt darauf ab, die Chancen und Herausforderungen aufzuzeigen, die mit der Nutzung von KI in der klinischen Anwendung verbunden sind, und bietet eine praktische Anleitung zur Überwindung bestehender Hindernisse.
Verwendete Methoden und Datenquellen: Die Studie analysiert vorhandene Literatur und Fallstudien zur Nutzung von KI in der Medizin und speziell in der Orthopädie. Sie bezieht sich auf eine Vielzahl von Quellen, um die vielfältigen Anwendungsbereiche der KI, wie medizinische Bildanalyse, Entscheidungsunterstützungssysteme und digitale Zwillingstechnologie, zu diskutieren.
Zentrale Forschungsergebnisse: Die Studie hebt das Potenzial der KI hervor, die Diagnose und Behandlung in der Orthopädie zu verbessern, betont jedoch auch die Notwendigkeit, ethische Überlegungen und Qualitätsstandards zu berücksichtigen. Die Autoren stellen fest, dass eine fundierte Kenntnis der Grundkonzepte der KI und der möglichen Verzerrungen für eine erfolgreiche Implementierung in medizinischen Forschungsprojekten essentiell ist.
2. Zusammenfassung
Die Arbeit von Zsidai et al. bietet eine umfassende Einführung in die Nutzung von KI in der orthopädischen Forschung und betont die bedeutenden Möglichkeiten, die sich durch KI in der klinischen Praxis ergeben, wie verbesserte Diagnoseverfahren und personalisierte Behandlungsansätze. Gleichzeitig werden die Herausforderungen, wie ethische Bedenken und die Notwendigkeit der Sicherstellung der Datenqualität und -sicherheit, kritisch betrachtet. Die Studie dient als Grundlage für zukünftige Forschungen und die Entwicklung von Best Practices für den Einsatz von KI in der Medizin.
3. Kernaussagen


"KI hat das Potenzial, die medizinische Forschung durch verbesserte Krankheitserkennung und klinische Entscheidungsfindung zu revolutionieren." (S. 2)


"Eine gründliche Kenntnis der KI-Konzepte und potenzieller Verzerrungen ist für die effektive und sichere Implementierung in der medizinischen Forschung notwendig." (S. 3)


"Es ist entscheidend, ethische Überlegungen und Qualitätsstandards in die Entwicklung und Anwendung von KI-Systemen einzubeziehen, um deren Zuverlässigkeit und Akzeptanz zu gewährleisten." (S. 4)


4. Argumentationslinien
Die Autoren argumentieren, dass KI die Fähigkeit besitzt, transformative Veränderungen in der orthopädischen Forschung herbeizuführen, indem sie neue Möglichkeiten für die Diagnose und Behandlung bietet. Sie betonen jedoch, dass die Integration von KI in die klinische Praxis sorgfältig überwachte Rahmenbedingungen erfordert, um sicherzustellen, dass die Technologie ethisch vertretbar und effektiv genutzt wird. Dies beinhaltet eine ausführliche Diskussion über die Notwendigkeit, KI-Systeme auf ihre ethische Vertretbarkeit, Genauigkeit und Sicherheit zu prüfen. (S. 3, S. 4, S. 5)
5. Verschlagwortung


Lernsystemarchitektur: Die Studie beschreibt den Einsatz von KI-Systemen in der Orthopädie, was die Anpassungsfähigkeit und Komplexität der Lernsystemarchitekturen zeigt.


Technologieintegration: Die Integration von KI in die orthopädische Praxis illustriert die Bedeutung der Technologie in modernen medizinischen Anwendungen.


Lehr- und Lerneffektivität: Die Fähigkeit der KI, präzise Diagnosen und Behandlungsempfehlungen zu liefern, zeigt ihre Effektivität in Lehr- und Lernkontexten.


Systemanpassung: Die Anpassung von KI-Systemen an spezifische klinische Anforderungen unterstreicht die Notwendigkeit flexibler Bildungssysteme.


Krisenreaktion im Bildungsbereich: Die schnelle Anpassungsfähigkeit von KI bei der Bewältigung von Herausforderungen in der medizinischen Forschung zeigt ihre Rolle bei der Reaktion auf Krisen.


Forschungsansätze: Die methodische Vorgehensweise der Studie, insbesondere die Nutzung von KI zur Überwindung traditioneller Forschungsgrenzen, bietet eine wertvolle Perspektive für zukünftige Forschungsmethoden in der Bildungswissenschaft.


},
	file = {Volltext:/Users/jochenhanisch-johannsen/Zotero/storage/K589MWZI/Zsidai et al. - 2023 - A practical guide to the implementation of AI in o.pdf:application/pdf;Zsidai et al. - 2023 - A practical guide to the implementation of AI in o.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/A9PHARZU/Zsidai et al. - 2023 - A practical guide to the implementation of AI in o.pdf:application/pdf},
}

@article{knifka_kompetenzentwicklung_2023,
	title = {Kompetenzentwicklung in der Öffentlichen {Verwaltung} am {Beispiel} des {Digital}.{Campus} {Bayern} ({DCB})},
	issn = {1436-3011, 2198-2775},
	url = {https://link.springer.com/10.1365/s40702-023-01033-4},
	doi = {10.1365/s40702-023-01033-4},
	abstract = {The ongoing digital transformation in the public administration sector requires employees to develop new competencies. These competencies are necessary to meet the challenges of digitization and adapt to the changed processes, structures, and goals. In the context of public administration, we understand digital competencies as the ability to operate in digital environments and independently, as well as creatively, solve problems. We illustrate, using the example of Digital.Campus Bayern, an initiative of the Bavarian State Ministry of Digital Affairs, how a learning platform can promote the foundations for self-organization and independent problem-solving. The goal of Digital.Campus Bayern is to support all employees of public administration in Bavaria through ﬂexible and innovative learning opportunities to successfully overcome the challenges of digital transformation. The platform consists of a search function, a system for managing learning content, and a diagnostic tool. Particularly noteworthy is the diagnostic tool, which provides individual learning paths for the development of digital competencies. This tool serves as the central component of the entire learning platform. Additionally, we shed light on the signiﬁcance of an organization’s digital maturity and the role of accompanying change management in the implementation of a learning platform.},
	language = {de-DE},
	urldate = {2024-01-03},
	journal = {HMD Praxis der Wirtschaftsinformatik},
	author = {Knifka, Julia and Tilgner, Markus and Holand, Georg},
	month = dec,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Bewertungsmethoden, Systemanpassung, Bildungstheorien, Promotion:Argumentation, \#1:Zeitschriftenartikel:learning:management:system, DRK-Bildungszentrum Düsseldorf, Assessment, Kompetenzentwicklung, Promotion:S:01 Learning Management System, Promotion:Kompetenzbildung von Lehrenden im Rettungsdienst (und Ethik), Promotion:Literaturverzeichnis},
	annote = {Die Studie von Knifka et al. (2023) konzentriert sich auf die Kompetenzentwicklung in der öffentlichen Verwaltung unter Nutzung des Digital.Campus Bayern (DCB). Hier sind die detaillierten Analysen, Zusammenfassungen und weiteren Anforderungen basierend auf dem Dokument:
1. Analyse der Quelle
Knifka et al. (2023) untersuchen, wie die digitale Transformation die Kompetenzanforderungen innerhalb der öffentlichen Verwaltung verändert. Sie diskutieren, wie der Digital.Campus Bayern als Plattform zur Förderung digitaler Kompetenzen dient, um Mitarbeiter auf die Herausforderungen der Digitalisierung vorzubereiten.
2. Zusammenfassung der Kernaussagen
Der Artikel argumentiert, dass eine effektive Reaktion auf die digitale Transformation eine systematische Entwicklung digitaler Kompetenzen erfordert, unterstützt durch innovative Lernplattformen wie den DCB. Diese Plattformen sollen Flexibilität, Selbstorganisation und problemorientiertes Lernen fördern.
3. Darstellung der Kernaussagen anhand der Fundstellen


Digitale Kompetenzen: Digitale Kompetenzen werden als notwendig betrachtet, um in digitalen Umgebungen effektiv zu agieren und Probleme kreativ zu lösen (S. 1).


Selbstorganisation und Problemlösung: Der DCB unterstützt die Selbstorganisation und das eigenständige Problemlösen als Antwort auf die dynamischen Anforderungen der digitalen Arbeitswelt (S. 1-2).


Rolle der Technologie: Die Plattform nutzt technologische Tools, um personalisierte Lernpfade anzubieten, was zentral für die individuelle Kompetenzentwicklung ist (S. 2).


4. Argumentationslinien
Die Autoren legen dar, dass die digitale Transformation umfassende Änderungen in den Arbeitsprozessen mit sich bringt, die nur durch eine entsprechende Anpassung der Kompetenzen zu bewältigen sind. Der DCB wird als Beispiel einer solchen Anpassungsstrategie durch die Förderung digitaler Kompetenzen über eine spezialisierte Lernplattform präsentiert.
5. Verschlagwortung


Lernsystemarchitektur: Der Artikel beschreibt den Aufbau und die Funktionalität des Digital.Campus Bayern, einer Plattform, die Lerninhalte verwaltet und diagnostische Tools zur Kompetenzentwicklung bietet (S. 2-3).


Bildungstheorien: Die Nutzung von Theorien über selbstgesteuertes Lernen und digitale Kompetenzen fließen in die Gestaltung der Lernprozesse auf der Plattform ein (S. 1-2).


Lehr- und Lerneffektivität: Der Artikel diskutiert, wie die Plattform durch personalisierte Lernpfade und diagnostische Tools die Lerneffektivität verbessert (S. 2-3).


Technologieintegration: Beschreibt die Integration verschiedener technologischer Tools innerhalb des DCB, die zur Unterstützung der digitalen Kompetenzentwicklung dienen (S. 2-3).


Bewertungsmethoden: Die Verwendung spezifischer Tools auf der Plattform zur Bewertung und Anpassung von Lernpfaden wird erörtert (S. 3).


Systemanpassung: Der Artikel zeigt, wie der DCB flexibel auf die Bedürfnisse der Nutzer angepasst wird, um Relevanz und Effektivität in der sich schnell ändernden digitalen Landschaft zu gewährleisten (S. 2-3).


Forschungsansätze: Es werden Ansätze zur Erforschung der Effektivität von Lernplattformen im Kontext der öffentlichen Verwaltung diskutiert (S. 1-2).


Diese systematische Analyse verdeutlicht, wie die Kompetenzentwicklung durch den Digital.Campus Bayern gestaltet wird, um den Anforderungen der digitalen Transformation in der öffentlichen Verwaltung gerecht zu werden.
},
	file = {Knifka et al. - 2023 - Kompetenzentwicklung in der Öffentlichen Verwaltun.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/F5ZBUPUQ/Knifka et al. - 2023 - Kompetenzentwicklung in der Öffentlichen Verwaltun.pdf:application/pdf},
}

@article{nagy_measuring_2023,
	title = {Measuring efficiency and effectiveness of knowledge transfer in e-learning},
	volume = {9},
	issn = {24058440},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2405844023047102},
	doi = {10.1016/j.heliyon.2023.e17502},
	abstract = {With e-learning rapidly gaining popularity, evaluating its effectiveness and efficiency has become a challenge in public education, the public sector, and the corporate sector. Measuring knowledge transfer is crucial in any learning process, but e-learning lacks validated methods for this. Here we examine ways to evaluate that particularly in case of e-learning, conducting a literature review to assess available measurement solutions, developing an evaluation method for knowledge transfer, and validating the method. Using logged data from e-courses, it is possible to assess the knowl­ edge transfer in e-learning. We describe a novel method for classifying effectiveness and effi­ ciency with measured values and measurement instruments. The new measurement method was aligned with a data set of an existing learning management system, and the effectiveness and efficiency of knowledge transfer was analysed using quantitative means, including descriptive statistics, regression modelling, and cluster analysis based on a specific e-learning course. This newly elaborated and validated knowledge transfer measurement technique could be a useful tool for anyone wanting to evaluate e-learning courses and can also serve as a baseline for academics to further develop or implement it on larger empirical datasets.},
	language = {en-GB},
	number = {7},
	urldate = {2023-11-22},
	journal = {Heliyon},
	author = {Nagy, Vitéz and Duma, László},
	month = jul,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Systemanpassung, Bildungstheorien, \#1:Zeitschriftenartikel:learning:management:system, Datenschutz und IT-Sicherheit, Promotion:FH, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {e17502},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:
Die Studie von Nagy und Duma (2023) untersucht die Effizienz und Effektivität des Wissenstransfers im E-Learning. Ziel ist es, eine neue Methodik zur Messung der Nützlichkeit von E-Learning-Kursen zu entwickeln und zu validieren. Dabei soll insbesondere die Messbarkeit des Wissenstransfers in E-Learning-Umgebungen ohne direkte Vergleichsmöglichkeiten zu traditionellen Unterrichtsformen verbessert werden.
Verwendete Methoden und Datenquellen:
	•	Design: Literaturübersicht und empirische Untersuchung
	•	Datenquellen: Protokolldaten aus einem konkreten E-Learning-Kurs einer Universität
	•	Evaluationsmethoden: Deskriptive Statistik, Regressionsmodellierung und Clusteranalyse
Zentrale Forschungsergebnisse:
	•	Effizienz und Effektivität: Die entwickelte Methodik ermöglicht eine objektive Bewertung der Effizienz und Effektivität des Wissenstransfers im E-Learning. Die Analyse basierte auf den Aktivitäten der Lernenden während des Kurses und deren Leistung in Vor- und Nachtests.
	•	Messmethoden: Zwei Hauptmethoden wurden verwendet: eine auf Wissenstransfer fokussierte Messmethode und eine Methode basierend auf der Aktivität und den Ergebnissen der Studierenden.
	•	Regressionsanalyse: Die Regressionsanalyse zeigte, dass sowohl die anfänglichen Kenntnisse als auch die Aktivitäten während des Kurses signifikante Prädiktoren für die Endnoten der Studierenden sind.
Zusammenfassung
Die Studie zeigt, dass die entwickelte Methodik zur Messung des Wissenstransfers im E-Learning valide und anwendbar ist. Die Effizienz und Effektivität von E-Learning-Kursen können durch die Analyse von Protokolldaten und die Anwendung statistischer Methoden objektiv bewertet werden. Dies bietet eine Grundlage für die Weiterentwicklung und Verbesserung von E-Learning-Programmen.
Kernaussagen
	•	„Die entwickelte Methodik ermöglicht eine objektive Bewertung der Effizienz und Effektivität des Wissenstransfers im E-Learning.“ (S. 1)
	•	„Die Regressionsanalyse zeigte, dass sowohl die anfänglichen Kenntnisse als auch die Aktivitäten während des Kurses signifikante Prädiktoren für die Endnoten der Studierenden sind.“ (S. 6)
	•	„Die Clusteranalyse klassifizierte die Teilnehmenden in Gruppen mit unterschiedlichen Leistungsniveaus und Aktivitäten.“ (S. 11)
Argumentationslinien
	•	Objektive Bewertung: Die Studie argumentiert, dass die entwickelte Methodik eine objektive Bewertung der Effizienz und Effektivität von E-Learning-Kursen ermöglicht. (S. 1)
	•	Statistische Methoden: Die Verwendung von Regressions- und Clusteranalysen bietet tiefere Einblicke in die Faktoren, die den Wissenstransfer im E-Learning beeinflussen. (S. 6, 11)
	•	Anwendung und Anpassung: Die Methodik kann auf verschiedene E-Learning-Kurse angewendet und angepasst werden, um deren Nützlichkeit und Qualität zu bewerten. (S. 14)
Verschlagwortung
	•	Lehr- und Lerneffektivität: Untersuchung der Effektivität des Wissenstransfers in E-Learning-Umgebungen.
	•	Technologieintegration: Nutzung von Protokolldaten und statistischen Methoden zur Bewertung von E-Learning-Kursen.
	•	Systemanpassung: Anpassung der Bewertungssysteme an die spezifischen Anforderungen und Daten von E-Learning-Programmen.
	•	Forschungsansätze: Entwicklung und Validierung neuer Methoden zur Messung der Nützlichkeit und Effizienz von E-Learning.
Kategorisierung: Kerngedanke
Begründung:
Die Studie von Nagy und Duma (2023) liefert grundlegende Erkenntnisse zur Messung der Effizienz und Effektivität von E-Learning-Kursen und entwickelt eine neue Methodik zur Bewertung des Wissenstransfers. Diese Methodik ist zentral für das Verständnis und die Weiterentwicklung von E-Learning-Programmen, insbesondere in Hinblick auf die objektive Bewertung von Lehr- und Lernprozessen.
Kategorie: Kerngedanke
Zuordnung zur Forschungsfrage
FH: Wie ist das Wirkgefüge des angewendeten Learning-Management-Systems auf Akteure im digitalen Bildungsraum von Gesundheitsberufen gestaltet?
Begründung:
Die entwickelte Methodik und die gewonnenen Erkenntnisse zur Bewertung der Effizienz und Effektivität des Wissenstransfers tragen dazu bei, das Wirkgefüge von Learning-Management-Systemen im digitalen Bildungsraum zu verstehen und zu optimieren. Sie bieten eine Grundlage für die Bewertung und Weiterentwicklung von E-Learning-Programmen im Gesundheitsbereich.
},
	file = {Nagy und Duma - 2023 - Measuring efficiency and effectiveness of knowledg.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/IUWAXX8S/Nagy und Duma - 2023 - Measuring efficiency and effectiveness of knowledg.pdf:application/pdf},
}

@article{thorne_nationwide_2023,
	title = {The nationwide impact of {COVID}-19 on life support courses. {A} retrospective evaluation by {Resuscitation} {Council} {UK}},
	volume = {13},
	issn = {26665204},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2666520423000097},
	doi = {10.1016/j.resplu.2023.100366},
	abstract = {Methods: We conducted a before-after study using course data from the Resuscitation Council UK Learning Management System between January 2018 and December 2021, using 23 March 2020 as the cut-off between pre- and post-pandemic periods. Demographics and outcomes were analysed using chi-squared tests and regression models.
Results: There were 90,265 ALS participants (51,464 pre-; 38,801 post-) and 368,140 ILS participants (225,628 pre-; 142,512 post-). There was a sharp decline in participants on ALS/ILS courses due to COVID-19. ALS participant numbers rebounded to exceed pre-pandemic levels, whereas ILS numbers recovered to a lesser degree with increased uptake of e-learning versions. Mean ALS course participants reduced from 20.0 to 14.8 post-pandemic (P {\textless} 0.001). Post-pandemic there were small but statistically significant decreases in ALS Cardiac Arrest Simulation Test pass rates (from 82.1 \% to 80.1 \% (OR = 0.90, 95 \% CI = 0.86–0.94, P {\textless} 0.001)), ALS MCQ score (from 86.6 \% to 86.0 \% (mean difference = -0.35, 95 \% CI À0.44 to À0.26, P {\textless} 0.001)), and overall ALS course results (from 95.2 \%to 94.7 \%, OR = 0.92, CI = 0.85–0.99, P = 0.023). ILS course outcomes were similar post-pandemic (from 99.4 \% to 99.4 \%, P = 0.037).
Conclusion: COVID-19 caused a sharp decline in the number of participants on ALS/ILS courses and an accelerated uptake of e-learning versions, with the average ALS course size reducing significantly. The small reduction in performance on ALS courses requires further research to clarify the contributing factors.},
	language = {en-GB},
	urldate = {2023-11-22},
	journal = {Resuscitation Plus},
	author = {Thorne, C.J. and Kimani, P.K. and Hampshire, S. and Hamilton-Bower, I. and Begum-Ali, S. and Benson-Clarke, A. and Couper, K. and Yeung, J. and Lockey, A. and Perkins, G.D. and Soar, J.},
	month = mar,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Bewertungsmethoden, Promotion:Argumentation, \#1:Zeitschriftenartikel:learning:management:system, Krisenreaktion im Bildungsbereich, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {100366},
	annote = {Wie ds LMS BZ auch ijn zwei Wochen entstand
},
	file = {Thorne et al. - 2023 - The nationwide impact of COVID-19 on life support .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/UW7YTBTQ/Thorne et al. - 2023 - The nationwide impact of COVID-19 on life support .pdf:application/pdf},
}

@article{habib_digital_2023,
	title = {Digital transformation strategy for developing higher education in conflict-affected societies},
	volume = {8},
	issn = {25902911},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2590291123002322},
	doi = {10.1016/j.ssaho.2023.100627},
	abstract = {Armed conflict is an evolution in reverse that significantly damages infrastructure, displaces students and faculty, and limits access to resources, necessitating innovative solutions. This research uses Syria as a case study to investigate the potential of a digital transformation strategy to revitalize the higher education system in warravaged regions. It proposes a digital transformation framework utilizing a mixed-method approach, including literature reviews, expert interviews, and case analysis, to identify critical challenges faced by Syrian higher education institutions. The framework focuses on developing digital infrastructure, capacity building for edu­ cators, e-learning platforms, digital content, and public-private partnerships that increase education access, foster collaboration, enable remote learning and enhance global competitiveness in war-torn areas. The elearning platforms component explores the potential of Massive Open Online Courses (MOOCs), Learning Management Systems (LMS), and blended learning approaches to enhance the quality and accessibility of higher education. The digital content component highlights the importance of open educational resources, digital li­ braries, and virtual labs to support learning. Finally, the capacity building component addresses the need for training and upskilling educators and administrators to implement digital solutions effectively. The proposed framework is a roadmap for policymakers, educators, and international organizations to develop and implement digital solutions supporting long-term recovery and growth in conflict-affected areas.},
	language = {en-GB},
	number = {1},
	urldate = {2023-11-22},
	journal = {Social Sciences \& Humanities Open},
	author = {Habib, Maan},
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Technologieintegration, Bewertungsmethoden, Promotion:Weiterführung, \#1:Zeitschriftenartikel:learning:management:system, Krisenreaktion im Bildungsbereich, Lernsystemarchitektur, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {100627},
	annote = {Diese Studie verwendet einen gemischten Methodenansatz, der Literaturrecherchen, Experteninterviews und Fallanalysen umfasst, um die digitale Transformation im syrischen Hochschulwesen zu untersuchen. Der Schwerpunkt liegt auf dem Aufbau einer digitalen Infrastruktur, der Verbesserung von E-Learning-Plattformen, der Entwicklung digitaler Inhalte und dem Aufbau öffentlich-privater Partnerschaften, um den Bildungszugang und die Qualität in konfliktbetroffenen Regionen zu fördern.
1. Analyse der Quelle
Habib (2023) untersucht die Potenziale einer digitalen Transformationsstrategie zur Revitalisierung des Hochschulsystems in konfliktbetroffenen Regionen, am Beispiel Syriens. Die Forschung verwendet einen Mixed-Methods-Ansatz, der Literaturüberprüfungen, Experteninterviews und Fallanalysen umfasst, um die kritischen Herausforderungen der syrischen Hochschulbildungsinstitutionen zu identifizieren.
2. Zusammenfassung der Kernaussagen
Der Artikel betont die Notwendigkeit, digitale Infrastrukturen zu entwickeln, die Kapazitäten von Bildungspersonal zu stärken, E-Learning-Plattformen auszubauen und öffentlich-private Partnerschaften zu fördern, um den Zugang zur Bildung zu verbessern, Zusammenarbeit zu ermöglichen, Fernlernen zu erleichtern und die globale Wettbewerbsfähigkeit in kriegsgebeutelten Gebieten zu erhöhen.
3. Darstellung der Kernaussagen anhand der Fundstellen


Digitale Infrastruktur und Kapazitätsaufbau: Der Aufbau digitaler Infrastrukturen und die Schulung von Lehrkräften sind entscheidend, um effektive digitale Lösungen implementieren zu können (S. 2-3).


E-Learning und digitale Inhalte: Die Bedeutung von E-Learning-Plattformen und digitalen Inhalten wie offenen Bildungsressourcen und virtuellen Laboren wird hervorgehoben, um die Bildungsqualität zu verbessern (S. 3-4).


Öffentlich-private Partnerschaften: Partnerschaften mit dem privaten Sektor und internationalen Organisationen sind wesentlich, um die notwendigen Ressourcen und Technologien bereitzustellen (S. 4-5).


4. Argumentationslinien
Die Argumentation der Studie basiert auf der Prämisse, dass die digitale Transformation eine Schlüsselrolle bei der Bewältigung der durch Konflikte verursachten Bildungsherausforderungen spielt und dass durch die Einführung neuer Technologien und Lernmethoden das syrische Hochschulbildungssystem effektiv unterstützt und verbessert werden kann.
5. Verschlagwortung


Lernsystemarchitektur: Aufbau und Implementierung digitaler Infrastrukturen und Plattformen.


Technologieintegration: Integration moderner Bildungstechnologien zur Unterstützung von E-Learning und digitalen Inhalten.


Bewertungsmethoden: Anwendung gemischter Forschungsmethoden zur Bewertung der Implementierung digitaler Bildungsstrategien.


Krisenreaktion im Bildungsbereich: Entwicklung von Strategien zur Überwindung der Bildungsherausforderungen in konfliktbetroffenen Gebieten.


Forschungsansätze: Nutzung von Mixed-Methods-Ansätzen zur Analyse der Bildungssituation und zur Entwicklung effektiver Interventionen.


Diese detaillierte Analyse zeigt, wie digitale Transformationsstrategien dazu beitragen können, das Hochschulsystem in Syrien trotz der Herausforderungen durch den anhaltenden Konflikt zu stärken und zu verbessern.
},
	file = {Habib - 2023 - Digital transformation strategy for developing hig.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/936R4ZZ3/Habib - 2023 - Digital transformation strategy for developing hig.pdf:application/pdf},
}

@article{trgalova_affordances_2023,
	title = {Affordances of {Virtual} {Learning} {Environments} to {Support} {Mathematics} {Teaching}},
	volume = {9},
	issn = {2199-3246, 2199-3254},
	url = {https://link.springer.com/10.1007/s40751-023-00127-4},
	doi = {10.1007/s40751-023-00127-4},
	abstract = {The slow uptake of technology by mathematics teachers is in contrast with the rapid growth in the availability of different digital resources specifically designed to help teaching and learning mathematics. We refer to platforms that were designed to permit for mathematical communication between multiple users. We seek to explore the affordances of such digital platforms to support mathematics teachers who wish to integrate technology as part of their practice, when planning and enacting technology-based mathematical activity. Specifically, we ask: What are the affordances and constraints of the platforms that may support instrumentation and instrumentalization processes leading to the development of teacher’s didactic instrument for planning and enacting a mathematical activity in a digital environment? The four platforms we chose for analysis are STEP, DESMOS, WIMS and Labomep. Our analysis shows on the one hand that the platforms afford support to the teacher while enacting technology-based mathematics activities. On the other hand, we suggest several components of didactic instrumental genesis that mathematics teachers need to develop in order to take benefit from digital platform affordances. These components include the ability to base decision-making on data gathered and visualised in dashboard embedded in learning management systems.},
	language = {en-GB},
	number = {3},
	urldate = {2023-11-22},
	journal = {Digital Experiences in Mathematics Education},
	author = {Trgalová, Jana and Tabach, Michal},
	month = dec,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Bildungstheorien, Promotion:Argumentation, \#1:Zeitschriftenartikel:learning:management:system, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {444--475},
	annote = {1. Analyse
Die Studie von Trgalová und Tabach (2023) untersucht die Unterstützungsmöglichkeiten, die virtuelle Lernumgebungen (VLEs) zur Förderung des Mathematikunterrichts bieten. Die Autoren konzentrieren sich auf die spezifischen Funktionen und Einschränkungen verschiedener Plattformen und wie diese die didaktische Instrumentalisierung und Instrumentierung durch Lehrkräfte unterstützen können.
2. Zusammenfassung
Die Analyse befasst sich mit vier verschiedenen Plattformen (STEP, DESMOS, WIMS und Labomep), die speziell für den Mathematikunterricht entwickelt wurden. Es wird untersucht, wie diese Plattformen Lehrern dabei helfen, Technologie in ihre Unterrichtspraktiken zu integrieren, insbesondere im Hinblick auf die Planung und Durchführung mathematischer Aktivitäten. Die Studie hebt hervor, dass diese Plattformen sowohl spezifische Unterstützungen als auch Herausforderungen in Bezug auf didaktische Instrumentalisierung und Instrumentierung bieten.
3. Kernaussagen


Unterstützung durch Plattformen: Die Plattformen bieten verschiedene Unterstützungen, wie automatisierte Feedbacksysteme und Dashboard-Funktionen, die Lehrern helfen, den Fortschritt und die Leistung der Schüler zu überwachen (S. 447-450).


Herausforderungen und Einschränkungen: Die Studie identifiziert auch Herausforderungen, wie die Notwendigkeit einer tieferen Integration von technologischen Werkzeugen in die Lehrpraxis und die Notwendigkeit für Lehrer, sich mit den Funktionen der Plattformen vertraut zu machen, um deren volles Potenzial nutzen zu können (S. 451-455).


4. Argumentationslinien


Didaktische Instrumentalisierung: Die Fähigkeit der Lehrer, Plattformfunktionen zur Unterstützung des Unterrichts zu nutzen, erfordert eine Anpassung und Personalisierung dieser Werkzeuge, um sie effektiv in ihre Lehrpraktiken zu integrieren (S. 455-459).


Professionalisierung der Lehrkräfte: Die Studie betont die Notwendigkeit von professionellen Entwicklungsprogrammen, die Lehrer in der Nutzung dieser Technologien schulen, um eine effektive Integration in den Unterricht zu gewährleisten (S. 460-462).


5. Verschlagwortung


Technologieintegration: Die Integration von Lernmanagement-Systemen und digitalen Plattformen in den Mathematikunterricht.


Lehr- und Lerneffektivität: Bewertung der Effektivität von Lehrmethoden, die auf digitalen Plattformen basieren, zur Unterstützung des Mathematikunterrichts.


Bildungstheorien: Diskussion über die Theorie der didaktischen Instrumentalisierung und Instrumentierung im Kontext des Einsatzes von Technologie im Unterricht.


Systemanpassung: Anpassung von Bildungssystemen an digitale Technologien zur Verbesserung des Lernens.


Forschungsansätze: Analyse der spezifischen Funktionen und Herausforderungen digitaler Lernplattformen für den Mathematikunterricht.


Diese Analyse zeigt, wie virtuelle Lernumgebungen spezifisch den Mathematikunterricht durch Technologieintegration unterstützen und verbessern können, während sie gleichzeitig Herausforderungen und professionelle Entwicklungsbedürfnisse für Lehrer aufzeigen.
},
	file = {Trgalová und Tabach - 2023 - Affordances of Virtual Learning Environments to Su.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/PGUFVWG8/Trgalová und Tabach - 2023 - Affordances of Virtual Learning Environments to Su.pdf:application/pdf},
}

@article{bediang_computer_2013,
	title = {Computer literacy and {E}-learning perception in {Cameroon}: the case of {Yaounde} {Faculty} of {Medicine} and {Biomedical} {Sciences}},
	volume = {13},
	issn = {1472-6920},
	shorttitle = {Computer literacy and {E}-learning perception in {Cameroon}},
	url = {https://bmcmededuc.biomedcentral.com/articles/10.1186/1472-6920-13-57},
	doi = {10/gb332f},
	abstract = {Background: Health science education faces numerous challenges: assimilation of knowledge, management of increasing numbers of learners or changes in educational models and methodologies. With the emergence of e-learning, the use of information and communication technologies (ICT) and Internet to improve teaching and learning in health science training institutions has become a crucial issue for low and middle income countries, including sub-Saharan Africa. In this perspective, the Faculty of Medicine and Biomedical Sciences (FMBS) of Yaoundé has played a pioneering role in Cameroon in making significant efforts to improve students’ and lecturers’ access to computers and to Internet on its campus. The objective is to investigate how computer literacy and the perception towards e-learning and its potential could contribute to the learning and teaching process within the FMBS academic community.
Method: A cross-sectional survey was carried out among students, residents and lecturers. The data was gathered through a written questionnaire distributed at FMBS campus and analysed with routine statistical software.
Results: 307 participants answered the questionnaire: 218 students, 57 residents and 32 lecturers. Results show that most students, residents and lecturers have access to computers and Internet, although students’ access is mainly at home for computers and at cyber cafés for Internet. Most of the participants have a fairly good mastery of ICT. However, some basic rules of good practices concerning the use of ICT in the health domain were still not well known. Google is the most frequently used engine to retrieve health literature for all participants; only 7\% of students and 16\% of residents have heard about Medical Subject Headings (MeSH). The potential of e-learning in the improvement of teaching and learning still remains insufficiently exploited. About two thirds of the students are not familiar with the concept of e-leaning. 84\% of students and 58\% of residents had never had access to e-learning resources. However, most of the participants perceive the potential of e-learning for learning and teaching, and are in favour of its development at the FMBS.
Conclusion: The strong interest revealed by the study participants to adopt and follow-up the development of elearning, opens new perspectives to a faculty like the FMBS, located in a country with limited resources. However, the success of its development will depend on different factors: the definition of an e-learning strategy, the implementation of concrete measures and the adoption of a more active and participative pedagogy.},
	language = {en-GB},
	number = {1},
	urldate = {2023-11-18},
	journal = {BMC Medical Education},
	author = {Bediang, Georges and Stoll, Beat and Geissbuhler, Antoine and Klohn, Axel M and Stuckelberger, Astrid and Nko’o, Samuel and Chastonay, Philippe},
	month = dec,
	year = {2013},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, \#1:Zeitschriftenartikel:learning:management:system, Datenschutz und IT-Sicherheit, Krisenreaktion im Bildungsbereich, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {57},
	file = {Bediang et al. - 2013 - Computer literacy and E-learning perception in Cam.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/TS8JRK64/Bediang et al. - 2013 - Computer literacy and E-learning perception in Cam.pdf:application/pdf},
}

@article{eom_learning_2023,
	title = {Learning {Outcomes} and {Learner} {Satisfaction}: {The} {Mediating} {Roles} of {Self}-regulated {Learning} and {Dialogues}},
	volume = {32},
	issn = {1941-6679},
	shorttitle = {Learning {Outcomes} and {Learner} {Satisfaction}},
	url = {https://scholarworks.lib.csusb.edu/jitim/vol32/iss1/1},
	doi = {10/gss62s},
	abstract = {The interdependent learning process is regarded as a crucial part of e-learning success, but it has been largely ignored in e-learning empirical research. Grounded in constructivist and social constructivist theory, we present and test an e-learning success model consisting of eight e-learning critical success factors (CSF) derived from constructivist and social constructivist models. Three hundred seventy-two on-line students from a Midwestern university in the United States participated in the survey. The data collected from the survey was used to examine the partial least squares structural equation model. The results highlight the importance of selfregulated learning and dialogical processes to explain and predict perceived learning outcomes and student satisfaction.},
	language = {en-GB},
	number = {1},
	urldate = {2023-09-30},
	journal = {Journal of International Technology and Information Management},
	author = {Eom, Sean and Ashill, Nicholas Jeremy},
	month = jan,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Systemanpassung, \#1:Zeitschriftenartikel:learning:management:system, Bildung, Multimedia, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {1--31},
	annote = {Kernstudie identifiziert für das Forschungsprojekt "Wirkgefüge im digitalen Bildungsraum":


Titel: Learning Outcomes and Learner Satisfaction: The Mediating Roles of Self-regulated Learning and Dialogues


Autoren: Eom, S., \& Ashill, N. J.


Publiziert in: Journal of International Technology and Information Management


Band/Volume: 32


Ausgabe: 1


Seiten: 1–31


Jahr: 2023


DOI: https://doi.org/10/gss62s


Beschreibung der Studie: Diese Studie von Eom und Ashill untersucht die vermittelnden Rollen von selbstreguliertem Lernen und Dialogen bei der Beeinflussung von Lernergebnissen und der Zufriedenheit von Lernenden. Die Forscher analysieren, wie diese Faktoren zusammenwirken, um die Effektivität des Lernens und die Zufriedenheit in E-Learning-Umgebungen zu steigern.
Bedeutung für das Forschungsprojekt: Die Ergebnisse dieser Studie bieten wertvolle Einblicke in die Mechanismen, die die Zufriedenheit und die Lernerfolge in digitalen Bildungskontexten beeinflussen. Das Verständnis dieser Faktoren ist entscheidend, um E-Learning-Systeme zu entwickeln, die nicht nur informativ sind, sondern auch die Bedürfnisse und Präferenzen der Lernenden unterstützen und fördern.
},
	file = {Eom und Ashill - 2023 - Learning Outcomes and Learner Satisfaction The Me.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/FVW7EVS9/Eom und Ashill - 2023 - Learning Outcomes and Learner Satisfaction The Me.pdf:application/pdf},
}

@article{mickan_evidence_2013,
	title = {Evidence of {Effectiveness} of {Health} {Care} {Professionals} {Using} {Handheld} {Computers}: {A} {Scoping} {Review} of {Systematic} {Reviews}},
	volume = {15},
	issn = {14388871},
	shorttitle = {Evidence of {Effectiveness} of {Health} {Care} {Professionals} {Using} {Handheld} {Computers}},
	url = {http://www.jmir.org/2013/10/e212/},
	doi = {10/gbd32x},
	abstract = {Background: Handheld computers and mobile devices provide instant access to vast amounts and types of useful information for health care professionals. Their reduced size and increased processing speed has led to rapid adoption in health care. Thus, it is important to identify whether handheld computers are actually effective in clinical practice.
Objective: A scoping review of systematic reviews was designed to provide a quick overview of the documented evidence of effectiveness for health care professionals using handheld computers in their clinical work.
Methods: A detailed search, sensitive for systematic reviews was applied for Cochrane, Medline, EMBASE, PsycINFO, Allied and Complementary Medicine Database (AMED), Global Health, and Cumulative Index to Nursing and Allied Health Literature (CINAHL) databases. All outcomes that demonstrated effectiveness in clinical practice were included. Classroom learning and patient use of handheld computers were excluded. Quality was assessed using the Assessment of Multiple Systematic Reviews (AMSTAR) tool. A previously published conceptual framework was used as the basis for dual data extraction. Reported outcomes were summarized according to the primary function of the handheld computer.
Results: Five systematic reviews met the inclusion and quality criteria. Together, they reviewed 138 unique primary studies. Most reviewed descriptive intervention studies, where physicians, pharmacists, or medical students used personal digital assistants. Effectiveness was demonstrated across four distinct functions of handheld computers: patient documentation, patient care, information seeking, and professional work patterns. Within each of these functions, a range of positive outcomes were reported using both objective and self-report measures. The use of handheld computers improved patient documentation through more complete recording, fewer documentation errors, and increased efficiency. Handheld computers provided easy access to clinical decision support systems and patient management systems, which improved decision making for patient care. Handheld computers saved time and gave earlier access to new information. There were also reports that handheld computers enhanced work patterns and efficiency.
Conclusions: This scoping review summarizes the secondary evidence for effectiveness of handheld computers and mhealth. It provides a snapshot of effective use by health care professionals across four key functions. We identified evidence to suggest that handheld computers provide easy and timely access to information and enable accurate and complete documentation. Further, they can give health care professionals instant access to evidence-based decision support and patient management systems to improve clinical decision making. Finally, there is evidence that handheld computers allow health professionals to be more},
	language = {en-GB},
	number = {10},
	urldate = {2023-02-10},
	journal = {Journal of Medical Internet Research},
	author = {Mickan, Sharon and Tilson, Julie K and Atherton, Helen and Roberts, Nia Wyn and Heneghan, Carl},
	month = oct,
	year = {2013},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, \#1:Zeitschriftenartikel:learning:management:system, Bildung, Multimedia, Krisenreaktion im Bildungsbereich, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {e212},
	annote = {1. Analyse
Hauptthemen und -ziele der Forschung: Die Studie von Mickan et al. konzentriert sich auf die Effektivität von Gesundheitsfachkräften, die Handheld-Computer im klinischen Alltag verwenden. Sie führt eine Scoping-Review von systematischen Übersichtsarbeiten durch, um die dokumentierte Wirksamkeit dieser Technologie in der Gesundheitsversorgung zu bewerten.
Verwendete Methoden und Datenquellen: Es wurde eine umfassende Literatursuche durchgeführt, um systematische Reviews zu identifizieren, die die Anwendung von Handheld-Computern durch Gesundheitsfachkräfte untersuchten. Die Qualität der eingeschlossenen Reviews wurde mit dem AMSTAR-Tool bewertet, und die Daten wurden nach den Hauptfunktionen der Handheld-Computer zusammengefasst.
Zentrale Forschungsergebnisse: Fünf systematische Reviews erfüllten die Einschluss- und Qualitätskriterien und zeigten, dass Handheld-Computer in vier Hauptfunktionen effektiv sind: Patientendokumentation, Patientenversorgung, Informationssuche und Arbeitsmuster der Fachkräfte. Die Geräte verbesserten die Dokumentationsgenauigkeit, unterstützten evidenzbasierte Entscheidungsfindungen und steigerten die Effizienz der Arbeitsabläufe.
2. Zusammenfassung
Die Scoping-Review von Mickan et al. bietet einen Überblick über die Effektivität von Handheld-Computern in der Gesundheitsversorgung. Die Ergebnisse deuten darauf hin, dass diese Technologien dazu beitragen können, die Patientenversorgung zu verbessern, den Zugang zu Informationen zu erleichtern und die Effizienz der Gesundheitsfachkräfte zu erhöhen. Sie unterstreichen die Notwendigkeit weiterer Forschung, um spezifische Vorteile und die Implementierung in der klinischen Praxis besser zu verstehen.
3. Kernaussagen


"Handheld-Computer verbessern die Patientendokumentation durch genauere und vollständigere Aufzeichnungen." (S. 5)


"Die Geräte bieten Zugang zu klinischen Entscheidungshilfen und Patientenmanagementsystemen, was die klinische Entscheidungsfindung verbessert." (S. 6)


"Handheld-Computer steigern die Effizienz der Arbeitsabläufe und ermöglichen Gesundheitsfachkräften, mehr Zeit für die direkte Patientenversorgung aufzuwenden." (S. 7)


4. Argumentationslinien
Die Studie argumentiert, dass Handheld-Computer wesentliche Vorteile für die klinische Praxis bieten, indem sie schnellen Zugang zu wichtigen Informationen ermöglichen und gleichzeitig die Qualität der Patientenversorgung durch verbesserte Dokumentations- und Entscheidungsunterstützungstools steigern.
5. Verschlagwortung


Technologieintegration: Demonstration der Integration von Handheld-Computern in klinische Abläufe zur Verbesserung der Gesundheitsversorgung.


Lehr- und Lerneffektivität: Die Studie zeigt, wie Handheld-Computer die Effektivität des medizinischen Personals durch verbesserten Zugang zu Informationen und Tools steigern.


Systemanpassung: Anpassung von klinischen Systemen zur Integration von Handheld-Computern, die Effizienz und Genauigkeit steigern.


Forschungsansätze: Die Methode der Scoping-Review, die zur Zusammenfassung der Forschung über Handheld-Computer verwendet wurde, bietet einen umfassenden Überblick über deren Wirksamkeit in der Gesundheitsversorgung.


Krisenreaktion im Bildungsbereich: Die schnelle Anpassung an neue Technologien wie Handheld-Computer in Notfallsituationen zeigt, wie wichtig Flexibilität und aktuelle Informationen für die Gesundheitsversorgung sind.


},
	file = {Mickan et al. - 2013 - Evidence of Effectiveness of Health Care Professio.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/GXF63XXT/Mickan et al. - 2013 - Evidence of Effectiveness of Health Care Professio.pdf:application/pdf},
}

@article{maloney_cost-effectiveness_2015,
	title = {A {Cost}-{Effectiveness} {Analysis} of {Blended} {Versus} {Face}-to-{Face} {Delivery} of {Evidence}-{Based} {Medicine} to {Medical} {Students}},
	volume = {17},
	issn = {1438-8871},
	url = {http://www.jmir.org/2015/7/e182/},
	doi = {10/f7kkcz},
	abstract = {Background: Blended learning describes a combination of teaching methods, often utilizing digital technologies. Research suggests that learner outcomes can be improved through some blended learning formats. However, the cost-effectiveness of delivering blended learning is unclear.
Objective: This study aimed to determine the cost-effectiveness of a face-to-face learning and blended learning approach for evidence-based medicine training within a medical program.
Methods: The economic evaluation was conducted as part of a randomized controlled trial (RCT) comparing the evidence-based medicine (EBM) competency of medical students who participated in two different modes of education delivery. In the traditional face-to-face method, students received ten 2-hour classes. In the blended learning approach, students received the same total face-to-face hours but with different activities and additional online and mobile learning. Online activities utilized YouTube and a library guide indexing electronic databases, guides, and books. Mobile learning involved self-directed interactions with patients in their regular clinical placements. The attribution and differentiation of costs between the interventions within the RCT was measured in conjunction with measured outcomes of effectiveness. An incremental cost-effectiveness ratio was calculated comparing the ongoing operation costs of each method with the level of EBM proficiency achieved. Present value analysis was used to calculate the break-even point considering the transition cost and the difference in ongoing operation cost.
Results: The incremental cost-effectiveness ratio indicated that it costs 24\% less to educate a student to the same level of EBM competency via the blended learning approach used in the study, when excluding transition costs. The sunk cost of approximately AUD \$40,000 to transition to the blended model exceeds any savings from using the approach within the first year of its implementation; however, a break-even point is achieved within its third iteration and relative savings in the subsequent years. The sensitivity analysis indicates that approaches with higher transition costs, or staffing requirements over that of a traditional method, are likely to result in negative value propositions.
Conclusions: Under the study conditions, a blended learning approach was more cost-effective to operate and resulted in improved value for the institution after the third year iteration, when compared to the traditional face-to-face model. The wider applicability of the findings are dependent on the type of blended learning utilized, staffing expertise, and educational context.},
	language = {en-GB},
	number = {7},
	urldate = {2023-02-10},
	journal = {Journal of Medical Internet Research},
	author = {Maloney, Stephen and Nicklen, Peter and Rivers, George and Foo, Jonathan and Ooi, Ying Ying and Reeves, Scott and Walsh, Kieran and Ilic, Dragan},
	month = jul,
	year = {2015},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Learning Management System (LMS), Bildungstheorien, Promotion:Argumentation, \#1:Zeitschriftenartikel:learning:management:system, Bildung, Multimedia, Digitale Bildung, Lernsystemarchitektur, FernUni-Hagen:MABM:Master-Arbeit, Evidenzbasierte Medizin (EbM), medical education, economic evaluation, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {e182},
	annote = {1. Analyse
Hauptthemen und -ziele der Forschung: Die Studie analysiert die Kosten-Effektivität von Blended Learning im Vergleich zu herkömmlichem Face-to-Face-Unterricht in der medizinischen Ausbildung. Ziel ist es, herauszufinden, ob Blended Learning eine kosteneffektive Alternative darstellt.
Verwendete Methoden und Datenquellen: Es wurde eine inkrementelle Kosten-Effektivitäts-Analyse (ICER) durchgeführt, basierend auf Daten aus einer randomisierten kontrollierten Studie (RCT), um die direkten und indirekten Kosten sowie die Lerneffekte von Blended Learning und Face-to-Face-Unterricht zu vergleichen.
Zentrale Forschungsergebnisse: Blended Learning zeigt sich langfristig als kosteneffektiver im Vergleich zu traditionellem Unterricht, trotz höherer initialer Kosten, vor allem durch Einsparungen bei den laufenden Ausgaben und einer effizienteren Ressourcennutzung.
2. Zusammenfassung
Die Studie von Maloney et al. zeigt, dass Blended Learning in der medizinischen Ausbildung, trotz höherer Anfangsinvestitionen, auf lange Sicht kosteneffektiver als herkömmlicher Unterricht ist. Die Ergebnisse unterstreichen die Vorteile von Blended Learning in Bezug auf die Kosten-Effektivität und fordern eine Überdenkung der Bildungsstrategien in medizinischen Studiengängen.
3. Kernaussagen


"Blended Learning ist langfristig kosteneffektiver als traditioneller Unterricht, beginnend ab dem dritten Jahr nach Einführung." (S. 3)


"Die Anfangsinvestitionen für Blended Learning sind höher, führen jedoch zu signifikanten Einsparungen in den Folgejahren." (S. 5)


"Beide Lehrmethoden erreichen ähnliche Lernergebnisse, wobei Blended Learning eine effizientere Ressourcennutzung ermöglicht." (S. 7)


4. Argumentationslinien
Die Argumentation der Studie basiert auf der Analyse der Langzeitkosten und -effekte von Bildungsmethoden. Durch den Vergleich der initialen und laufenden Kosten wird gezeigt, dass Blended Learning trotz anfänglich höherer Kosten aufgrund seiner nachhaltigeren und effizienteren Struktur langfristig vorteilhafter ist (S. 4-6). Die Schlussfolgerungen stützen sich auf die Annahme, dass die Qualität der Ausbildung erhalten bleibt, während die finanziellen Ausgaben reduziert werden (S. 8-9).
5. Verschlagwortung


Lernsystemarchitektur: Die Struktur von Blended Learning ermöglicht eine effiziente Kombination von Online- und Präsenzphasen, die langfristige Kosteneinsparungen bietet.


Bildungstheorien: Die Nutzung von Blended Learning stützt sich auf die Theorie, dass digitale Lernformen das Potenzial haben, gleichwertige oder bessere Lernergebnisse bei geringeren Kosten zu erreichen.


Lehr- und Lerneffektivität: Die Studie bestätigt, dass Blended Learning die Lerneffektivität nicht beeinträchtigt, sondern finanzielle Vorteile bietet.


Kosteneffizienz in der Bildung: Langfristige Kostenanalysen zeigen, dass Blended Learning eine kosteneffiziente Methode im Bildungsbereich ist.


Forschungsansätze: Die Verwendung einer inkrementellen Kosten-Effektivitäts-Analyse in dieser Studie bietet wertvolle Einblicke in die finanziellen Aspekte von Bildungsinnovationen.


},
