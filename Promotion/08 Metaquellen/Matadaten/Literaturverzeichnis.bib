	author = {Kreidl, Christian},
	year = {2011},
	keywords = {Charité:Promotion, Promotion:Literaturanalyse, Bildung, Multimedia, FernUni-Hagen:MABM:M3, \#5:Buch:e-learning, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
