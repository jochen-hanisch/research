@article{suryani_initial_2024,
	title = {An initial user model design for adaptive interface development in learning management system based on cognitive load},
	volume = {26},
	issn = {1435-5558, 1435-5566},
	url = {https://link.springer.com/10.1007/s10111-024-00772-8},
	doi = {10.1007/s10111-024-00772-8},
	abstract = {The cognitive aspect is crucial in developing interactive and adaptive systems, including learning management systems (LMS). By understanding human cognitive processes, developers can create adaptive systems that are sustainably used by targeted users. Cognitive traits need to be explored to become part of the user model, especially especially to develop an LMS with an adaptive interface based on cognitive load. However, there is limited research exploring the correlation between cognitive load and adaptive interfaces, as well as the visualization of information, within online learning settings, including those specifically within LMS platforms. Additionally, a lack of understanding of cognitive processes renders the use of LMS static and unable to adapt to learners’ abilities. Therefore, information regarding the specific characteristics or model of cognitive load that accurately represent LMS users as triggers for adaptive interfaces needs to be further examined. A total of four experts in the cognitive field were interviewed. The interview process was conducted in a semi-structured manner to obtain information about problems in the use of e-learning, the nature of cognitive, and the process of capturing cognitive load during learning using LMS. By using a soft system methodology, the results from the interviews are mapped into a cognitive load-based LMS user model design. The initial model design includes information on working memory capacity, task performance (time, true/false rate), learning behavior (learner log), physiological (in a lab scale), and self-reporting (Likert scale). This model design is a promising first step towards a more technical process in developing adaptive and interactive systems.},
	language = {en-GB},
	number = {4},
	urldate = {2025-01-01},
	journal = {Cognition, Technology \& Work},
	author = {Suryani, Mira and Sensuse, Dana Indra and Santoso, Harry Budi and Aji, Rizal Fathoni and Hadi, Setiawan and Suryono, Ryan Randy and {Kautsarina}},
	month = nov,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, \#1:Zeitschriftenartikel:learning:management:system, Lernsystemarchitektur, Promotion:FU3, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU3},
	pages = {653--672},
	annote = {Analyse der Studie „An Initial User Model Design for Adaptive Interface Development in Learning Management System Based on Cognitive Load“ von Suryani et al. (2024)

1. Hauptthemen und Ziele der Forschung
Die Studie befasst sich mit der Entwicklung eines adaptiven Benutzer*innenmodells für ein Learning-Management-System (LMS) auf Basis der kognitiven Belastung (Cognitive Load, CL). Ziel ist es, ein Modell zu entwerfen, das adaptive Schnittstellen für Lernmanagementsysteme ermöglicht, indem es die kognitive Belastung der Lernenden erfasst und analysiert.
Zentrale Forschungsfragen:


Wie kann die kognitive Belastung in einem LMS effektiv gemessen und modelliert werden?


Welche Benutzer*innenmerkmale sind für ein adaptives Interface relevant?


Wie kann ein kognitiv gesteuertes LMS Lernprozesse optimieren und an individuelle Bedürfnisse anpassen?



2. Methoden und Datenquellen
Methoden:
Die Studie verwendet eine qualitative Forschungsmethode basierend auf der Soft Systems Methodology (SSM) zur Entwicklung eines nutzendenzentrierten Modells:


Interviews mit vier Expert*innen aus dem Bereich der kognitiven Wissenschaften, um


Probleme bei der Nutzung von LMS zu identifizieren,


kognitive Belastungsprozesse zu verstehen,


Methoden zur Erfassung der kognitiven Belastung zu diskutieren.




Semi-strukturierte Interviews zur Erhebung von Daten zur Nutzung von LMS.


Kategorisierung von kognitiven Belastungsindikatoren in:


Arbeitsgedächtniskapazität,


Aufgabenleistung (Bearbeitungszeit, Fehlerquote),


Lernverhalten (Log-Daten aus dem LMS),


physiologische Messungen (EEG, Herzfrequenz) im Labormaßstab,


Selbsteinschätzungen mittels Likert-Skala.




Datenquellen:


Fokusgruppen und Interviews mit Expert*innen aus der Kognitionswissenschaft.


Vergleich mit existierenden theoretischen Modellen der kognitiven Belastung (Sweller, 1994; Paas \& Van Merriënboer, 1994).


Literaturanalyse zur adaptiven Benutzer*innenmodellierung in LMS.



3. Zentrale Forschungsergebnisse


Kognitive Belastung kann durch verschiedene Indikatoren in LMS erfasst werden


Kombination aus Leistungsdaten, Verhaltensmustern, physiologischen Signalen und subjektiven Einschätzungen.


LMS können so entwickelt werden, dass sie automatisch auf hohe kognitive Belastung reagieren.




Individuelle Unterschiede in der kognitiven Belastung beeinflussen Lernprozesse


Studierende mit geringer Arbeitsgedächtniskapazität benötigen andere Interface-Anpassungen als Studierende mit hoher Kapazität.


Adaptive Benutzer*innenmodelle sollten Motivation und Vorwissen einbeziehen, um Überlastung zu vermeiden.




LMS müssen adaptive Schnittstellen bieten, um Überforderung zu reduzieren


Dynamische Anpassung der Informationspräsentation (z. B. Reduktion extrinsischer Belastung durch klare UI-Strukturen).


Personalisierte Lernstrategien zur Optimierung der kognitiven Ressourcen der Nutzenden.





4. Zusammenfassung
Die Studie zeigt, dass die Entwicklung eines adaptiven LMS auf Basis der kognitiven Belastung essenziell ist, um Lernprozesse effektiver zu gestalten. Durch die Kombination aus Verhaltensdaten, Selbsteinschätzungen und physiologischen Messungen kann ein nutzendenzentriertes Modell geschaffen werden, das die kognitive Belastung kontinuierlich analysiert und adaptive Maßnahmen ergreift.

5. Kernaussagen


„Die Erfassung der kognitiven Belastung in LMS ist essenziell für die Entwicklung adaptiver Lernumgebungen.“(S. 661)


„Ein effektives LMS muss sich an die individuellen kognitiven Merkmale der Nutzenden anpassen, um Überforderung zu vermeiden.“ (S. 665)


„Die Kombination aus Leistungsdaten, Verhaltensmustern und physiologischen Signalen ermöglicht eine präzisere Modellierung der kognitiven Belastung.“ (S. 667)



6. Argumentationslinien
Die Studie argumentiert, dass die Anpassung von LMS an kognitive Prozesse die Lernqualität signifikant verbessert:


Grundannahme: Standardisierte LMS sind nicht ausreichend an individuelle kognitive Bedürfnisse angepasst. (S. 653)


Empirischer Beleg: Die Studie zeigt, dass adaptive Schnittstellen Lernüberlastung reduzieren und den Lernerfolg steigern. (S. 670)


Didaktische Implikationen: Ein LMS sollte dynamische Anpassungen an den individuellen Lernprozess vornehmen, um Lernmotivation und Verstehensprozesse zu verbessern. (S. 672)



7. Verschlagwortung




Schlagwort


Begründung




Technologieintegration


Die Studie untersucht, wie kognitive Belastungsmessungen in LMS integriert werden können, um adaptive Lernumgebungen zu schaffen.




Lernsystemarchitektur


Entwicklung eines Benutzer*innenmodells, das die Architektur von LMS um adaptive Schnittstellen erweitert.




Lehr- und Lerneffektivität


Adaptive LMS-Interfaces verbessern die kognitive Verarbeitung und steigern die Effektivität des Lernprozesses.





8. Kategorisierung
Kategorie: Kerngedanke


Kriterium: Die Studie stellt ein grundlegendes Modell für die Anpassung von LMS basierend auf kognitiver Belastung vor.


Beispiel: Durch eine Kombination aus kognitiven Belastungsmessungen und adaptiven UI-Anpassungen kann das LMS individuell auf Lernende reagieren. (S. 670)



9. Zuordnung zu einer Forschungsunterfrage (FU)
Passendste Forschungsunterfrage: FU3„Wie sind Konzeption und relevante didaktische und bildungstechnologische Merkmale des systemisch-konstruktivistischen Learning-Management-Systems für Akteure im digitalen Bildungsraum von Gesundheitsberufen dargestellt?“
Begründung:Die Studie untersucht, wie LMS durch adaptive Benutzer*innenmodelle verbessert werden können, indem sie kognitive Belastung erfassen und darauf reagieren. Die Erkenntnisse sind hochrelevant für die didaktische und bildungstechnologische Gestaltung von LMS im Gesundheitsbereich, insbesondere für kompetenzbasierte, individualisierte Lernumgebungen.

10. Relevanzbewertung (1–5)
Relevanz: 5


Direkte Anwendbarkeit: Die Forschung liefert eine fundierte Grundlage für die Weiterentwicklung adaptiver LMS im Gesundheitsbereich.


Technologieübertragbarkeit: Die kognitiv gesteuerte Benutzer*innenmodellierung kann auf verschiedene Bildungskontexte übertragen werden.


Innovationspotenzial: Die Studie bietet eine methodische Basis für die Entwicklung von LMS mit kognitiven Belastungsanpassungen, was für den digitalen Bildungsraum besonders relevant ist.


},
	file = {Suryani et al. - 2024 - An initial user model design for adaptive interface development in learning management system based:/Users/jochenhanisch-johannsen/Zotero/storage/DEJGP3D4/Suryani et al. - 2024 - An initial user model design for adaptive interface development in learning management system based.pdf:application/pdf},
}

@article{cabi_relationship_2024,
	title = {The relationship between academic performance and the interaction patterns of online students in learning management system},
	issn = {1360-2357, 1573-7608},
	url = {https://link.springer.com/10.1007/s10639-024-13168-y},
	doi = {10.1007/s10639-024-13168-y},
	abstract = {Learning Management System (LMS) can track student interactions with digital learning resources during an online learning activity. Learners with different goals, motivations and preferences may exhibit different behaviours when accessing these materials. These different behaviours may further affect their learning performance. The purpose of this study is to examine the relationship between students’ interaction behaviours in online learning activities and their academic performance. In this study, including 214 students, the LMS was used for sharing course content, communicating with students, and conducting evaluations. At the end of the 14-week teaching period, the tracking data, which were obtained from the learning activities of the students, were analysed. A two-step clustering analysis was carried out to categorise students’ interactions with learning activities. Thus, it was determined that they had low, moderate, and high interactions, respectively. The normal distribution and homogeneity of variances of the variables were checked. ANOVA was used when assumptions were met, and the Kruskal-Wallis test was used when assumptions were met. A significant difference was found between the different behaviour clusters and students’ academic performance. This study showed that students with high levels of interaction according to behaviour patterns also performed well academically. In addition, students’ expectations and motivations for the course were collected and examined using a questionnaire.},
	language = {en-GB},
	urldate = {2025-01-01},
	journal = {Education and Information Technologies},
	author = {Cabı, Emine},
	month = nov,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Bewertungsmethoden, \#1:Zeitschriftenartikel:learning:management:system, Lernsystemarchitektur, Promotion:FU6, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	annote = {Analyse der Studie „The Relationship Between Academic Performance and the Interaction Patterns of Online Students in Learning Management Systems“ von Cabı (2024)

1. Hauptthemen und Ziele der Forschung
Die Studie untersucht die Zusammenhänge zwischen den Interaktionsmustern von Lernenden in einem Learning Management System (LMS) und ihrer akademischen Leistung. Dabei wird analysiert, inwiefern unterschiedliche Verhaltensweisen beim Zugang zu digitalen Lernmaterialien und der Interaktion mit der Plattform Einfluss auf den Lernerfolg haben.
Zentrale Forschungsfragen:


Welche Interaktionsmuster lassen sich bei Lernenden in einem LMS identifizieren?


Gibt es einen signifikanten Zusammenhang zwischen Interaktionsverhalten und akademischer Leistung?


Welche Erwartungen und Motivationen haben Lernende mit unterschiedlichen Interaktionsmustern gegenüber dem Lernumfeld?



2. Methoden und Datenquellen
Methoden:
Die Studie nutzt eine Mixed-Methods-Analyse, bestehend aus:


LMS-Tracking-Daten: Erhebung von Daten zu Zugriffen, abgeschlossenen Aktivitäten und eingereichten Aufgaben über einen Zeitraum von 14 Wochen.


Cluster-Analyse: Klassifikation der Lernenden anhand ihrer Interaktionsmuster (niedrig, moderat, hoch).


Statistische Analysen (ANOVA, Kruskal-Wallis-Test): Untersuchung des Zusammenhangs zwischen Interaktionsgruppen und akademischer Leistung.


Fragebögen: Erfassung der Erwartungen, Motivation und Lernbedarfe der Lernenden.


Datenquellen:


214 Studierende aus verschiedenen Fachrichtungen.


LMS-Daten zu Zugriffen, Aktivitäten und Einreichungen.


Bewertung der akademischen Leistung anhand von Prozess- und Produktbewertungen (Aufgaben und Abschlussprüfung).


Fragebögen mit Likert-Skala und offenen Fragen zur Erfassung der Lernmotivation.



3. Zentrale Forschungsergebnisse


Drei Interaktionsmuster im LMS konnten identifiziert werden


Cluster 1 (niedrige Interaktion): Minimale Nutzung des LMS, geringe Teilnahme an Aufgaben.


Cluster 2 (moderate Interaktion): Mittlere Aktivität in Lernmodulen und bei Aufgaben.


Cluster 3 (hohe Interaktion): Hohe Teilnahme an Aktivitäten und intensive Nutzung des LMS.




Signifikanter Zusammenhang zwischen Interaktion und akademischer Leistung


Studierende mit hoher Interaktion erzielten signifikant bessere akademische Leistungen.


ANOVA-Test bestätigt eine starke Korrelation zwischen Interaktionsverhalten und Notendurchschnitt (p {\textless} 0,001).




Erwartungen der Lernenden an das LMS variieren je nach Interaktionsmuster


Studierende mit niedriger Interaktion wünschen sich mehr Erinnerungen und Anleitungen.


Studierende mit moderater Interaktion fordern schnellere Bewertungen und detailliertes Feedback.


Studierende mit hoher Interaktion bevorzugen mehr interaktive Elemente und eine stärkere Einbindung in die Kursgestaltung.





4. Zusammenfassung
Die Studie zeigt, dass Lernende mit hoher LMS-Interaktion signifikant bessere akademische Leistungen erzielen. Interaktionsmuster beeinflussen die Erwartungen und Motivationen der Studierenden, wobei gering aktive Lernende strukturelle Unterstützung benötigen und hochaktive Lernende von kollaborativen und interaktiven Lernangeboten profitieren.

5. Kernaussagen


„Studierende mit hoher Interaktion in einem LMS erzielen signifikant bessere akademische Leistungen als gering interagierende Studierende.“ (S. 10)


„Lernende mit niedriger Interaktion wünschen sich mehr unterstützende Maßnahmen wie Erinnerungen und verlängerte Fristen.“ (S. 12)


„Die Nutzung von Learning Analytics kann helfen, gefährdete Studierende frühzeitig zu identifizieren und gezielt zu unterstützen.“ (S. 14)



6. Argumentationslinien
Die Studie argumentiert, dass Interaktionsmuster in einem LMS ein Schlüsselfaktor für den akademischen Erfolg sind:


Grundannahme: LMS-Daten ermöglichen es, Lernverhalten präzise zu analysieren und zu optimieren. (S. 2)


Empirischer Beleg: Statistische Analysen zeigen eine signifikante Korrelation zwischen LMS-Nutzung und Lernerfolg. (S. 8)


Didaktische Implikationen: Hochschulen sollten Learning Analytics nutzen, um personalisierte Lernunterstützung bereitzustellen. (S. 15)



7. Verschlagwortung




Schlagwort


Begründung




Lernsystemarchitektur


Die Studie untersucht, wie LMS-Interaktionsdaten zur Optimierung von Lernprozessen genutzt werden können.




Lehr- und Lerneffektivität


Es wird nachgewiesen, dass hohe Interaktion mit dem LMS zu besseren akademischen Leistungen führt.




Bewertungsmethoden


Die Forschung nutzt Learning Analytics und statistische Verfahren zur Untersuchung von Lernmustern.





8. Kategorisierung
Kategorie: Kerngedanke


Kriterium: Die Studie zeigt, dass Interaktionsmuster in LMS ein zentraler Faktor für akademischen Erfolg sind.


Beispiel: Hochschulen sollten Learning Analytics nutzen, um frühzeitig individuelle Lernstrategien zu optimieren. (S. 14)



9. Zuordnung zu einer Forschungsunterfrage (FU)
Passendste Forschungsunterfrage: FU6„Wie wird ein systemisch-konstruktivistisches Learning-Management-System als Kompetenzerwerbssystem bei Akteuren im digitalen Bildungsraum von Gesundheitsberufen beurteilt?“
Begründung:Die Studie liefert fundierte Erkenntnisse darüber, wie Interaktionsmuster in LMS Lernprozesse und Kompetenzerwerb beeinflussen. Diese Ergebnisse sind direkt übertragbar auf die Gesundheitsbildung, da adaptive und personalisierte LMS-Ansätze die Kompetenzentwicklung unterstützen können.

10. Relevanzbewertung (1–5)
Relevanz: 5


Direkte Anwendbarkeit: Die Studie liefert empirische Beweise für die Bedeutung von LMS-Interaktionen für den akademischen Erfolg.


Technologieübertragbarkeit: Die Erkenntnisse lassen sich auf digitale Bildungsplattformen in verschiedenen Disziplinen anwenden.


Forschungsrelevanz: Die Untersuchung zeigt, wie Learning Analytics und Clustering zur Optimierung von LMS-gestützten Lernprozessen genutzt werden können.


},
	file = {Cabı - 2024 - The relationship between academic performance and the interaction patterns of online students in lea:/Users/jochenhanisch-johannsen/Zotero/storage/UGZD8EGG/Cabı - 2024 - The relationship between academic performance and the interaction patterns of online students in lea.pdf:application/pdf},
}

