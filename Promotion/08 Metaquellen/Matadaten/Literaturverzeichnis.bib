}

@article{giannakos_promise_2024,
	title = {The promise and challenges of generative {AI} in education},
	issn = {0144-929X, 1362-3001},
	url = {https://www.tandfonline.com/doi/full/10.1080/0144929X.2024.2394886},
	doi = {10.1080/0144929X.2024.2394886},
	abstract = {Generative artificial intelligence (GenAI) tools, such as large language models (LLMs), generate natural language and other types of content to perform a wide range of tasks. This represents a significant technological advancement that poses opportunities and challenges to educational research and practice. This commentary brings together contributions from nine experts working in the intersection of learning and technology and presents critical reflections on the opportunities, challenges, and implications related to GenAI technologies in the context of education. In the commentary, it is acknowledged that GenAI’s capabilities can enhance some teaching and learning practices, such as learning design, regulation of learning, automated content, feedback, and assessment. Nevertheless, we also highlight its limitations, potential disruptions, ethical consequences, and potential misuses. The identified avenues for further research include the development of new insights into the roles human experts can play, strong and continuous evidence, human-centric design of technology, necessary policy, and support and competence mechanisms. Overall, we concur with the general skeptical optimism about the use of GenAI tools such as LLMs in education. Moreover, we highlight the danger of hastily adopting GenAI tools in education without deep consideration of the efficacy, ecosystem-level implications, ethics, and pedagogical soundness of such practices.},
	language = {en-GB},
	urldate = {2024-11-03},
	journal = {Behaviour \& Information Technology},
	author = {Giannakos, Michail and Azevedo, Roger and Brusilovsky, Peter and Cukurova, Mutlu and Dimitriadis, Yannis and Hernandez-Leo, Davinia and Järvelä, Sanna and Mavrikis, Manolis and Rienties, Bart},
	month = sep,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Technologieintegration, Bewertungsmethoden, Promotion:Weiterführung, Datenschutz und IT-Sicherheit, Promotion:FU6, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis, Promotion:sec:Methodenkritik-Absicherung, Promotion:sec:A-9-FU6, Promotion:chap:04-04},
	pages = {1--27},
	annote = {{\textless}!-- codex:methodenkritik:04-04 --{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Methodenkritik (Anschlussstelle: GenAI als Analyse-/Synthesehilfe, Governance, Validierungslogik){\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}p{\textgreater}Der Beitrag liefert mir eine argumentative Brücke, um GenAI-Einsatz als methodisch kontrollbedürftige Intervention zu rahmen: Sobald GenAI Funktionen in Analyse- und Designprozesse (hier exemplarisch: Problemidentifikation, Elaborationsschritte) einspeisen, muss die Arbeitsgruppe die Kernlimitierungen (insb. Halluzinationen und Bias) aktiv mitdenken und prüfen, ob die erzeugten Outputs tatsächlich die "Essenz" der Diskussion bzw. des Materials abbilden. Für mein Vorgehen ist das ein direktes Argument für eine explizite Prüf- und Dokumentationslogik (Gegenlesen am Primärtext, Kriterienraster, Protokollierung von Entscheidungen), statt GenAI als bequeme Abkürzung in der Argumentation zu behandeln. (Giannakos et al., 2024, S. 13){\textless}/p{\textgreater}{\textless}p{\textgreater}Der Text schärft zudem eine oft unterschätzte Risikoebene, die für Forschungsarbeit operativ relevant ist: Die Wiederverwendung bzw. das Hochladen sensibler bzw. kommerziell relevanter Inhalte in GenAI-Plattformen wird als konkretes Risiko beschrieben, weil Kontrollverlust über Nutzung, Weiterverwertung und Rechte droht. Das stützt in meiner Methodik die Notwendigkeit, Datenflüsse (welche Inhalte wohin) zu begrenzen und die Tool-Nutzung in datenschutz- und urheberrechtlich robuste Bahnen zu legen. (Giannakos et al., 2024, S. 12){\textless}/p{\textgreater}{\textless}p{\textgreater}Im Kern fordert der Beitrag, technische und organisatorische Sicherungen nicht als "Nice-to-have", sondern als Designanforderung zu behandeln: Systeme sollen aktiv Defizite in Transparenz, Accountability, Privacy, Fairness sowie Bias reduzieren; flankierend wird ein Policy-Frame als notwendig markiert. Damit kann ich methodisch begründen, warum ich Governance-Elemente (Leitplanken, Offenlegung, Audit-Trail, Rollen- und Verantwortungszuweisung) als Teil der Methodik mitführe, statt sie in ein reines Ethikkapitel auszulagern. (Giannakos et al., 2024, S. 22){\textless}/p{\textgreater}{\textless}p{\textgreater}Schließlich liefert der Beitrag ein starkes Argument gegen vorschnelle Validitätsbehauptungen: Es wird explizit gefordert, nicht bei "human-likeness"-Checks oder punktuellen Leistungsbenchmarks stehen zu bleiben, sondern langfristige (longitudinal) Evaluationen der Effekte und Kompetenzen zu verlangen. Das stützt meinen Anspruch, KI-gestützte Schritte nur als heuristische Verdichtung zu führen, deren Wert sich erst im Zusammenspiel mit empirischer Triangulation und regelgeleiteter Nachprüfung stabilisiert. (Giannakos et al., 2024, S. 15){\textless}/p{\textgreater}},
	annote = {Hier ist die strukturierte Analyse und Zusammenfassung des Artikels „Guiding the design and implementation of interactive public displays in educational settings“ von Müller et al. (2024):

Analyse
1. Hauptthemen und Ziele der Forschung


Hauptthemen:


Erforschung der Potenziale und Herausforderungen interaktiver öffentlicher Displays (IPDs) im Bildungsbereich.


Entwicklung von Designzielen für die Implementierung von IPDs in Schulen, um Benutzerakzeptanz, soziale Interaktionen und Zusammenarbeit zu fördern.




Ziele:


Bereitstellung von Leitlinien zur Gestaltung von IPDs für Bildungsumgebungen.


Untersuchung, wie IPDs in bestehende Schulstrukturen integriert werden können.




2. Methoden und Datenquellen


Methoden:


Drei Co-Design-Workshops mit Lehrkräften und zwei Feldstudien in schwedischen Schulen.


Analyse von Benutzerinteraktionen, Umfragen und Interviews mit Schüler:innen und Lehrkräften.




Datenquellen:


Log-Daten von IPD-Interaktionen, Beobachtungen, Interviews mit 16 Schüler:innen und 19 Fragebögen.




3. Zentrale Forschungsergebnisse


Designziele:


Kombination formaler und informeller Aktivitäten.


Förderung spielerischer und kooperativer Interaktionen.


Integration in bestehende schulische Praktiken und Nutzung vorhandener technischer Infrastruktur.




Einsatz in Schulen:


Interaktive Anwendungen wie Quizze und Video-Bewertungen wurden positiv bewertet.


Technologische Barrieren und inhaltliche Relevanz beeinflussten die Nutzung negativ.




Herausforderungen:


Geringe Aufmerksamkeit für die Displays (Display Blindness).


Bedarf an stärkerer Integration in schulische Aktivitäten und bessere Kommunikation der Interaktivität.





Zusammenfassung
Der Artikel analysiert interaktive öffentliche Displays (IPDs) und schlägt Designziele vor, um deren Einsatz in Schulen zu optimieren. Die Studie hebt hervor, dass IPDs Lernaktivitäten außerhalb des Klassenzimmers bereichern können, indem sie soziale Interaktion und spielerisches Lernen fördern. Herausforderungen bestehen jedoch in der Integration in schulische Abläufe und der Kommunikation der Systemfunktionen an die Benutzer.

Kernaussagen


Designziele für IPDs: Sieben Ziele wurden definiert, darunter die Verbindung formaler und informeller Aktivitäten sowie die Nutzung bestehender Infrastruktur (S. 840-843).


Förderung sozialer Interaktionen: Quiz-Apps und Video-Interaktionen unterstützen kollaboratives Lernen (S. 832-835).


Barrieren für die Nutzung: Geringes Bewusstsein für Interaktivität und technische Hürden verringern die Akzeptanz (S. 836-838).



Argumentationslinien


Hauptthese: Interaktive öffentliche Displays können als zusätzliche Lernressourcen genutzt werden, benötigen jedoch klare Integration und benutzerfreundliches Design.


Unterstützende Evidenz: Beobachtungen zeigen, dass Displays in sozialen Kontexten effektiv sein können, wenn sie passend positioniert und gestaltet sind (S. 839-841).


Implikationen: Lehrkräfte spielen eine Schlüsselrolle bei der Förderung der Nutzung und der Integration von IPDs (S. 845-846).



Verschlagwortung


Technologieintegration: Einbindung digitaler Displays in schulische Lernaktivitäten.


Kollaboratives Lernen: Förderung von Gruppeninteraktionen und spielerischem Lernen.


Lehr- und Lerneffektivität: Evaluation von IPDs zur Steigerung des Engagements.



Kategorisierung
Kategorie: WeiterführungBegründung: Der Artikel liefert praktische Empfehlungen für die Weiterentwicklung und Implementierung von IPDs in Schulen und erweitert bestehende Ansätze der Technologieintegration.

Zuordnung zu Forschungsfragen


Passendste Forschungsfrage: FU4b: Welche technisch-gestalterischen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen LMS im Bezug auf die Wirkung auf Akteure im digitalen Bildungsraum beschrieben?


Begründung: Der Artikel untersucht technologische und didaktische Aspekte interaktiver Displays, die auf LMS übertragen werden können.



Relevanzbewertung


Aktualität: 5 (Veröffentlichung 2024, hoch relevant).


Direkte Relevanz: 4 (Wichtige Einblicke in die Gestaltung und Nutzung digitaler Lernressourcen).


Gesamtbewertung: 4 (Relevante Grundlage für die Digitalisierung in Bildungseinrichtungen).


},
	file = {Giannakos et al. - 2024 - The promise and challenges of generative AI in education:/Users/jochenhanisch-johannsen/Zotero/storage/MBIIBEIT/Giannakos et al. - 2024 - The promise and challenges of generative AI in education.pdf:application/pdf},
}

@article{mulyono_exploring_2024,
	title = {Exploring the influence of {EFL} teachers’ informal digital learning on creative classroom instruction: a cross-sectional study},
	abstract = {This study addresses the limited exploration in the literature regarding the influence of EFL teachers’ informal digital learning of English (IDLE) on their creativity in Indonesian EFL classroom instructions. Using a cross-sectional survey design, data were collected from 244 Indonesian EFL teachers, encompassing both pre-service and in-service teachers. Through multiple regression analysis and Rasch modelling analysis, the study evaluated the association between teachers’ IDLE participation, demographics, and their teaching creativity. Findings of the present study revealed that Indonesian EFL pre-service and in-service teachers actively participate in Informal Digital Learning of English (IDLE), which impacts their teaching creativity. Nearly half (49.18\%) engage strongly in activities like listening to English songs and watching YouTube videos, while 36.88\% moderately engage in online educational content and social media conversations. A smaller group (13.93\%) shows lower engagement in IDLE. The regression analysis revealed that while IDLE significantly predicted teaching creativity (p {\textless} 0.001), demographic factors did not indicate a substantial influence on creativity in teaching practices. Additionally, a Rasch-Wright map analysis unveiled that over half of the participants displayed strong creativity in teaching, with a notable inclination among younger teachers towards innovative and student-centered pedagogical strategies. The findings of the current study highlight the need for further exploration into the dynamics between informal digital learning, demographics, and creative teaching approaches, emphasizing the potential for fostering innovative pedagogical practices in language education.},
	language = {en-GB},
	author = {Mulyono, Herri},
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:FU4a, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	annote = {Analyse der Studie "Exploring the influence of EFL teachers’ informal digital learning on creative classroom instruction: A cross-sectional study" von Mulyono et al. (2024)
1. Hauptthemen und Ziele der Forschung
Die Studie untersucht den Einfluss informeller digitaler Lernpraktiken (IDLE - Informal Digital Learning of English) auf die Kreativität von Englischlehrkräften im Unterricht. Ziel ist es, die Beziehung zwischen der Teilnahme an IDLE-Aktivitäten und der kreativen Lehrpraxis von Englischlehrkräften in Indonesien zu analysieren. Die Forschung richtet sich sowohl an angehende als auch erfahrene Lehrkräfte und untersucht, wie IDLE ihre kreativen Fähigkeiten im Klassenzimmer fördert​.
2. Methoden und Datenquellen


Studiendesign: Die Untersuchung basiert auf einer Querschnittserhebung und verwendet ein Multiple-Regression-Modell sowie Rasch-Modelle zur Datenanalyse. Es wurde ein Fragebogen mit 32 Items auf einer Likert-Skala verwendet, um die IDLE-Teilnahme und kreative Lehrpraktiken zu bewerten. Der Fragebogen wurde auf Indonesisch übersetzt, um die Verständlichkeit zu erhöhen.


Datenquellen: Die Daten wurden von 244 Englischlehrkräften in Indonesien erhoben, darunter 130 angehende und 114 berufstätige Lehrkräfte. Die Lehrkräfte nahmen über soziale Medien wie WhatsApp, Instagram und Facebook an der Umfrage teil​.


3. Zentrale Forschungsergebnisse


Hohe IDLE-Teilnahme: Fast die Hälfte der Lehrkräfte (49,18\%) zeigte eine hohe Beteiligung an IDLE-Aktivitäten, wie das Hören englischsprachiger Musik und das Ansehen englischsprachiger YouTube-Videos, was auf eine große Begeisterung für informelles digitales Lernen hindeutet.


Signifikanter Einfluss von IDLE auf kreative Lehrpraktiken: Die Ergebnisse zeigen, dass IDLE signifikant zur Förderung kreativer Lehrpraktiken beiträgt, während demografische Faktoren wie Alter und Berufserfahrung keine signifikanten Auswirkungen auf die Kreativität im Unterricht hatten.


Unterschiede in der Lehrkreativität je nach Lehrerstatus: Die Rasch-Wright-Analyse ergab, dass jüngere Lehrkräfte ({\textless}30 Jahre) sowie solche mit weniger als 5 Jahren Berufserfahrung tendenziell kreativere, schülerzentrierte Ansätze verfolgten als ältere und erfahrenere Lehrkräfte​.


4. Zusammenfassung
Die Studie verdeutlicht, dass IDLE eine Schlüsselrolle bei der Förderung der kreativen Lehrfähigkeiten von EFL-Lehrkräften in Indonesien spielt. Die Ergebnisse zeigen, dass IDLE-Teilnahme positiv mit kreativem Unterricht verknüpft ist, insbesondere bei jüngeren Lehrkräften, die bereit sind, innovative Ansätze zu verfolgen.
5. Kernaussagen


IDLE fördert Kreativität: Die Teilnahme an informellen digitalen Lernaktivitäten korreliert positiv mit kreativen Unterrichtspraktiken, was auf den Nutzen von IDLE für die Entwicklung kreativer Lehransätze hinweist (S. 9)​.


Alter und Erfahrung spielen eine untergeordnete Rolle: Während IDLE signifikant zur Kreativität beiträgt, zeigten demografische Merkmale keine starke direkte Wirkung auf kreative Unterrichtspraktiken (S. 10)​.


6. Argumentationslinien
Die Autoren argumentieren, dass IDLE eine kostengünstige und zugängliche Möglichkeit für Lehrkräfte bietet, ihre Unterrichtspraktiken zu bereichern und ihre Kreativität zu fördern. Sie betonen die Notwendigkeit, informelles Lernen als wichtige Ergänzung zu formalen Fortbildungsangeboten zu betrachten und hervorzuheben, dass technologische Ressourcen die Innovationsfähigkeit im Klassenzimmer stärken können​.
7. Verschlagwortung


Lehr- und Lerneffektivität: Untersuchung, wie IDLE zur Verbesserung der Lehrqualität und Kreativität beitragen kann.


Technologieintegration: Nutzung digitaler Ressourcen für selbstgesteuertes Lernen und kreative Lehrpraktiken.


Forschungsansätze: Analyse von IDLE als bedeutender Bestandteil in der beruflichen Entwicklung und Kreativitätsförderung von Lehrkräften.


8. Kategorisierung
Kerngedanke: Der zentrale Gedanke der Studie ist, dass IDLE eine effektive Methode zur Förderung der Kreativität im Unterricht darstellt, unabhängig von demografischen Faktoren wie Alter und Berufserfahrung (S. 11)​.
9. Zuordnung zu der passendsten Forschungsunterfrage
FU4a: „Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?“


Begründung: Die Arbeit untersucht bildungswissenschaftliche Mechanismen, die das kreative Potenzial und selbstgesteuerte Lernprozesse durch IDLE fördern.


10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie liefert zentrale Erkenntnisse zur Rolle von IDLE bei der Kreativitätsförderung).


Zitierhäufigkeit und Einfluss: 4 (Relevantes Thema, jedoch mit einem Fokus auf Englischunterricht in Indonesien).


Aktualität: 5 (Veröffentlichung im Jahr 2024, sehr aktuell und relevant für digitale Bildungsstrategien).


Gesamtbewertung: 4.7
11. Schlussfolgerung
Die Studie von Mulyono et al. (2024) zeigt, dass informelles digitales Lernen ein wertvolles Instrument zur Förderung der kreativen Lehrkompetenzen von Englischlehrkräften ist. Die Erkenntnisse unterstreichen, dass IDLE eine sinnvolle Ergänzung zu formellen Lehransätzen darstellt und zur Weiterentwicklung innovativer, schülerzentrierter Unterrichtsmethoden beitragen kann​.
},
	file = {Mulyono - 2024 - Exploring the influence of EFL teachers’ informal .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/C2GYLYS7/Mulyono - 2024 - Exploring the influence of EFL teachers’ informal .pdf:application/pdf},
}

@article{seno_promises_2020,
	title = {The {Promises} and {Challenges} of {Collaborative} {Online} {Learning} towards {Authentic} {Assessment} in the {Tertiary} {Level}},
	abstract = {This present pandemic has brought us in many ways to our knees. It has spared no one - rich, poor or middle class; those who are in the cities or in the rural areas. Without doubt all sectors in society are affected and possibly been changed forever. They say we have to get used to the “new normal”. Yet, we dare to say, we will be the “better normal”.},
	language = {en-GB},
	author = {Seño, Reuel Rito Narag},
	year = {2020},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Promotion:Relevanz:4, Promotion:FU1, Promotion:S:11 Online Learning, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Dissertation {\textbar} FU1 {\textgreater} Kerngedanke, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU1},
	annote = {Hier ist die detaillierte Analyse der Studie „The Promises and Challenges of Collaborative Online Learning towards Authentic Assessment in the Tertiary Level“ von Reuel Rito Narag Seño:
1. Hauptthemen und Ziele der Forschung
Die Studie von Seño untersucht die Potenziale und Herausforderungen des kollaborativen Online-Lernens für authentische Bewertungen im tertiären Bildungsbereich. Im Kontext der COVID-19-Pandemie wird die Notwendigkeit einer „neuen Normalität“ in der Bildung hervorgehoben. Das Hauptziel besteht darin, aufzuzeigen, wie kollaborative Online-Lernstrategien als authentische Bewertungspraktiken fungieren und die Lernerfahrung in virtuellen Klassenzimmern verbessern können.
2. Methoden und Datenquellen
Die Forschung folgt der „See-Judge-Act“-Methode (auch bekannt als pastorale Spirale), die Situationen durch Analyse, Zielsetzung und Programmierung strukturiert bewertet. Sie basiert auf den praktischen Erfahrungen des Autors im Einsatz kollaborativer Lernstrategien und umfasst Beobachtungen und Rückmeldungen von Studierenden und Lehrenden. Eine Umfrage unter 330 Studierenden und neun Lehrkräften ergänzt die Datengrundlage und beleuchtet Vor- und Nachteile sowie Empfehlungen für kollaboratives Lernen.
3. Zentrale Forschungsergebnisse


Vorteile des kollaborativen Lernens: Studierende und Lehrende berichteten von positiven Effekten wie gesteigerter Zusammenarbeit, besserer Kommunikation und gestärktem Verantwortungsbewusstsein. Insbesondere betonten die Studierenden die Förderung der sozialen Kompetenzen und die höhere Qualität der gemeinschaftlich erarbeiteten Ergebnisse.


Herausforderungen: Zu den Herausforderungen zählen Konflikte aufgrund von Persönlichkeitsunterschieden, ungleiche Beiträge der Gruppenmitglieder (z. B. „Trittbrettfahrer“) und technische Hürden wie Internetverbindungsprobleme. Die Notwendigkeit einer klaren Aufgabenverteilung und kontinuierlichen Überwachung durch die Lehrkraft wird hervorgehoben.


Authentische Bewertung: Kollaboratives Lernen fördert authentische Bewertungen, indem Studierende aktiv an ihrer eigenen Bewertung teilnehmen und sich auf reale Probleme und Aufgaben vorbereiten. Die Methodik unterstützt das Ziel, Studierende zu befähigen, Kompetenzen zu erwerben, die über das bloße Wissen hinausgehen.


4. Zusammenfassung
Die Studie von Seño analysiert das Potenzial und die Herausforderungen des kollaborativen Online-Lernens zur Schaffung authentischer Bewertungsansätze im Kontext der Pandemie. Sie zeigt, dass kollaborative Lernstrategien nicht nur die Interaktivität fördern, sondern auch eine realistische und praxisnahe Bewertung ermöglichen, die als "Best Practice" für die Lehre in der „neuen Normalität“ gilt.
5. Kernaussagen


Authentische Bewertung: Authentische Bewertung soll die realen Kompetenzen der Studierenden abbilden und erfordert Innovation und kritisches Denken (S. 1-4).


Vorteile kollaborativer Lernstrategien: Kollaborative Online-Lernmethoden fördern die sozialen und kommunikativen Kompetenzen der Studierenden und verbessern die Qualität der eingereichten Arbeiten (S. 6).


Herausforderungen des kollaborativen Lernens: Die Studie dokumentiert technische und zwischenmenschliche Herausforderungen und hebt hervor, dass eine klare Aufgabenverteilung und Monitoring wichtig sind (S. 8-9).


6. Argumentationslinien
Die Argumentation basiert auf der Prämisse, dass kollaboratives Lernen authentische Bewertungsansätze schafft, indem es die aktive Einbindung der Studierenden in den Bewertungsprozess fördert. Durch empirische Beobachtungen und Befragungen veranschaulicht Seño, dass kollaborative Strategien die Verbindung zur Praxis verbessern und Lernende auf komplexe berufliche Herausforderungen vorbereiten. Der Autor betont, dass technische und strukturelle Anpassungen erforderlich sind, um kollaboratives Online-Lernen effektiv zu gestalten (S. 3-6, 8-10).
7. Verschlagwortung


Authentische Bewertung: Die Diskussion konzentriert sich stark auf die Schaffung authentischer Bewertungsmethoden durch kollaboratives Lernen.


Kollaboratives Lernen: Die Studie beschreibt den Einsatz kollaborativer Lernstrategien zur Förderung von sozialem Lernen und Gruppenarbeit.


Technologieintegration: Die Verwendung von Online-Plattformen wie Zoom, Google Meet und Teams zur Umsetzung kollaborativer Lernformate zeigt die Integration digitaler Technologien im Bildungsbereich.


Bewertungsmethoden: Das Paper diskutiert authentische Bewertungsansätze, die die Fähigkeiten der Lernenden realitätsnah und praxisorientiert abbilden sollen.


8. Kategorisierung
Kerngedanke: Die zentrale Hypothese der Arbeit ist, dass kollaborative Online-Lernansätze eine authentische Bewertung ermöglichen, die über traditionelle Prüfungen hinausgeht und reale Kompetenzen der Studierenden abbildet (S. 1-4).
9. Zuordnung zur passenden Forschungsfrage
FU1 – Akzeptanz und Nützlichkeit eines LMS im digitalen Bildungsraum: Die Studie beschreibt die Akzeptanz und die wahrgenommenen Vorteile von kollaborativem Online-Lernen im tertiären Bildungsbereich und analysiert, inwiefern diese Methode die Authentizität und Relevanz der Bewertung fördert.
10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 – Die Arbeit liefert wichtige Erkenntnisse zu kollaborativem Lernen und authentischer Bewertung, was einen wertvollen Beitrag zur digitalen Bildung darstellt.


Zitierhäufigkeit und Einfluss: 3 – Die Relevanz ist hoch im Kontext der Online-Bildungspraxis, auch wenn die spezifischen Erfahrungen des Autors einen begrenzten Rahmen abdecken.


Aktualität: 5 – Die Diskussion des „neuen Normalzustands“ in der Bildung ist hochaktuell und zukunftsweisend.




10. Schlussfolgerung
Die Studie schließt, dass kollaborative Lernstrategien im digitalen Bildungsbereich eine wertvolle Ergänzung darstellen, um praxisnahe Bewertungsansätze zu schaffen. Diese Strategien fördern sowohl die soziale als auch die kognitive Entwicklung der Studierenden und ermöglichen eine realistische Kompetenzmessung. Trotz der Herausforderungen, wie technische und zwischenmenschliche Hürden, empfiehlt der Autor kollaboratives Lernen als „Best Practice“, die durch klare Anleitung und Monitoring effektiver gestaltet werden kann.Gesamtbewertung: 4.3
},
	file = {Seño - The Promises and Challenges of Collaborative Onlin.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/JVJFVFDZ/Seño - 2020 - The Promises and Challenges of Collaborative Online Learning towards Authentic Assessment in the Ter.pdf:application/pdf},
}

@article{sharma_carry-forward_2024,
	title = {Carry-forward effect: providing proactive scaffolding to learning processes},
	issn = {0144-929X, 1362-3001},
	shorttitle = {Carry-forward effect},
	url = {https://www.tandfonline.com/doi/full/10.1080/0144929X.2024.2411592},
	doi = {10.1080/0144929X.2024.2411592},
	abstract = {Multimodal data enables us to capture the cognitive and affective states of students to provide a holistic understanding of learning processes in a wide variety of contexts. With the use of sensing technology, we can capture learners’ states in near real-time and support learning. Moreover, multimodal data allows us to obtain early predictions of learning performance, and support learning in a timely manner. In this contribution, we utilise the notion of ‘carry forward effect’, an inferential and predictive modelling approach that utilises multimodal data measurements detrimental to learning performance to provide timely feedback suggestions. Carry forward effect can provide a way to prioritise conflicting feedback suggestions in a multimodal databased scaffolding tool. We showcase the empirical proof of the carry forward effect with the use of three different learning scenarios: game-based learning, individual debugging, and collaborative debugging.},
	language = {en-GB},
	urldate = {2024-10-18},
	journal = {Behaviour \& Information Technology},
	author = {Sharma, Kshitij and Giannakos, Michail},
	month = oct,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:FU4a, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Dreidimensionale Unsicherheitsrelation, Emotionale Unsicherheit, Kognitve Unsicherheit, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {1--40},
	annote = {Here is the complete analysis of the paper "Carry-forward effect: providing proactive scaffolding to learning processes" by Sharma and Giannakos (2024):
1. Hauptthemen und Ziele der Forschung
Die Studie von Sharma und Giannakos (2024) untersucht den "Carry Forward Effect" (CFE) in digitalen Lernumgebungen und analysiert, wie multimodale Daten (z. B. Augenbewegungen, physiologische Messungen) genutzt werden können, um Lernprozesse zu unterstützen. Ziel ist es, ein intelligentes System zu entwickeln, das proaktives Feedback basierend auf CFE bereitstellt und so das Lernen in verschiedenen Kontexten (z. B. Spiel-basiertes Lernen, Problemlösen) verbessert.
2. Methoden und Datenquellen
Die Forschung basiert auf drei Studien:


Erste Studie: Ein bewegungsbasiertes Lernspiel, bei dem Daten wie Augenbewegungen und physiologische Signale (z. B. Herzfrequenz) erfasst wurden.


Zweite Studie: Individuelles Debuggen von Programmcode, wobei Augenbewegungsdaten und Systemprotokolle analysiert wurden.


Dritte Studie: Kollaboratives Debuggen, das multimodale Daten (Augenbewegungen, physiologische Daten) erfasste.


Die Datensätze wurden durch mobile Sensoren, Eye-Tracking-Geräte und Empatica E4-Armbänder erhoben. In allen Studien wurden die Teilnehmerdaten anonymisiert und im Einklang mit den Datenschutzrichtlinien erhoben.
3. Zentrale Forschungsergebnisse


Carry Forward Effect (CFE): Der CFE beschreibt die Fähigkeit einer multimodalen Messung, Lernleistungen in verschiedenen Phasen des Problemlösens vorherzusagen. Die Autoren fanden heraus, dass bestimmte kognitive und physiologische Messungen (z. B. kognitive Belastung, Herzfrequenz) signifikante Prädiktoren für den Lernerfolg in allen untersuchten Phasen darstellen.


Anwendung von CFE: Der CFE bietet einen Ansatz zur Priorisierung von Feedback. Messungen, die einen "Perfect CFE" zeigen (d.h., konsistente Prädiktion in allen Phasen), haben eine höhere Priorität als solche mit "Pseudo CFE".


Entwicklung eines intelligenten Systems: Basierend auf den Ergebnissen schlagen die Autoren ein Framework vor, das Echtzeit-Feedback priorisiert und dynamische Unterstützung bereitstellt, um Lernprozesse effektiv zu steuern.


4. Zusammenfassung
Die Arbeit zeigt, dass multimodale Daten wie Augenbewegungen und physiologische Signale zur Verbesserung der Lernergebnisse genutzt werden können. Durch die Analyse des CFE wird ein Framework vorgeschlagen, das die Reihenfolge der Feedbackvergabe priorisiert, um Lernende effizient zu unterstützen und auf ihre Bedürfnisse einzugehen.
5. Kernaussagen


Cognitive Load als Prädiktor: Die kognitive Belastung ist in allen drei Studien ein stabiler Prädiktor für den Lernerfolg (S. 17).


Herzfrequenzvariabilität: Die Herzfrequenz zeigt in bewegungsbasierten Spielen einen perfekten CFE und ist ein wichtiger Indikator für die Anpassung der Schwierigkeit im Spielverlauf (S. 18).


Sakkaden-Geschwindigkeit: Die Sakkaden-Geschwindigkeit ist ein Indikator für die wahrgenommene Schwierigkeit und zeigt in Debugging-Aufgaben einen perfekten CFE (S. 19).


6. Argumentationslinien
Die Autoren argumentieren, dass der CFE ein wirksames Instrument zur Verbesserung der Lernergebnisse ist, indem er den Einsatz von Feedback priorisiert. Sie heben hervor, dass das Verständnis und die Anwendung des CFE in verschiedenen Lernkontexten eine differenzierte Unterstützung der Lernenden ermöglicht (S. 20-21).
7. Verschlagwortung


Technologieintegration: Die Studie behandelt die Integration von Sensortechnologie und multimodaler Datenerfassung zur Verbesserung der Lehr- und Lernprozesse.


Lehr- und Lerneffektivität: Die Wirksamkeit der Lernprozesse wird anhand der kognitiven und physiologischen Daten gemessen, um eine gezielte Unterstützung zu ermöglichen.


Kollaboratives Lernen: Die Untersuchung des CFE im Kontext des kollaborativen Debuggens zeigt, wie Gruppenprozesse durch Technologie unterstützt werden können.


8. Kategorisierung
Kerngedanke: Der zentrale Gedanke der Studie ist, dass multimodale Messungen wie kognitive Belastung und physiologische Daten systematisch genutzt werden können, um den Lernerfolg vorherzusagen und Feedback dynamisch zu priorisieren (S. 19).
9. Zuordnung zu Forschungsfragen


Passendste Forschungsunterfrage: FU4a – „Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?“


Begründung: Die Studie untersucht die Mechanismen der Unterstützung durch Technologie und Sensoren, um Lernprozesse zu analysieren und zu verbessern, was im Kontext digitaler Bildungsräume relevant ist.




10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Arbeit bietet wesentliche Erkenntnisse über die Priorisierung und Anwendung von multimodalem Feedback in digitalen Lernumgebungen).


Zitierhäufigkeit und Einfluss: 4 (Die Studie ist sehr aktuell und behandelt ein hochrelevantes Thema in der Bildungsforschung).


Aktualität: 5 (Veröffentlichung im Jahr 2024).


Gesamtbewertung: 4.7
11. Schlussfolgerung
Die Studie zeigt, dass der Carry Forward Effect (CFE) in verschiedenen Lernkontexten wirksam genutzt werden kann, um Lernergebnisse zu verbessern. Die Autoren betonen die Bedeutung von multimodalem Feedback und schlagen ein Framework vor, das es ermöglicht, die Unterstützung von Lernenden gezielt und effizient zu gestalten.
Diese strukturierte Analyse bietet tiefergehende Einblicke in das Thema und unterstützt die systematische Organisation der Forschungsliteratur.
},
	file = {Sharma und Giannakos - 2024 - Carry-forward effect providing proactive scaffold.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/BBCG6FXL/Sharma und Giannakos - 2024 - Carry-forward effect providing proactive scaffold.pdf:application/pdf},
}

@article{chen_using_2024,
	title = {Using peer feedback to improve critical thinking in computer‐supported collaborative argumentation: {An} exploratory study},
	issn = {0266-4909, 1365-2729},
	shorttitle = {Using peer feedback to improve critical thinking in computer‐supported collaborative argumentation},
	url = {https://onlinelibrary.wiley.com/doi/10.1111/jcal.13078},
	doi = {10.1111/jcal.13078},
	abstract = {Background: Critical thinking is one of the 21st Century competencies for students. While previous research acknowledges the potential of peer feedback to enhance critical thinking skills, particularly within computer-supported collaborative learning (CSCL) environments, there is limited understanding of which specific aspects of critical thinking are improved through peer feedback and how various components of critical thinking are interrelated within a CSCL environment in K-12 education contexts.},
	language = {en-GB},
	urldate = {2024-10-17},
	journal = {Journal of Computer Assisted Learning},
	author = {Chen, Wenli and Hu, Hua and Lyu, Qianru and Zheng, Lishan},
	month = oct,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:FU4a, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {jcal.13078},
	annote = {Analyse der Studie "Using peer feedback to improve critical thinking in computer-supported collaborative argumentation: An exploratory study" von Chen et al. (2024)
1. Hauptthemen und Ziele der Forschung
Die Studie untersucht die Auswirkungen von Peer-Feedback auf die kritischen Denkfähigkeiten von Sekundarschüler
im Rahmen einer computerunterstützten kollaborativen Argumentationsumgebung (CSCA). Ziel der Studie ist es, zu erforschen, wie spezifische Aspekte des kritischen Denkens durch Peer-Feedback gefördert werden und wie verschiedene Dimensionen des Denkens miteinander verknüpft sind. Ein besonderer Fokus liegt auf der Anwendung von Epistemic Network Analysis (ENA) zur detaillierten Analyse der Entwicklung der Denkfähigkeiten vor und nach dem Peer-Feedback​.

2. Methoden und Datenquellen


Studiendesign: Die Studie verwendet ein Mixed-Methods-Design. Für die qualitative Analyse wurde Newmans Framework zur Bewertung des kritischen Denkens herangezogen, um die Tiefgründigkeit der Argumentationen zu analysieren. Die quantitative Methode der Epistemic Network Analysis (ENA) wurde eingesetzt, um die Muster der Co-Occurence von kritischen Denkfähigkeiten zu untersuchen.


Datenquellen: Die Teilnehmer
waren Sekundarschüler
in Singapur, die in sieben Gruppen an CSCA-Aktivitäten auf der AppleTree-Plattform teilnahmen. Die Schüler
wurden dreimal in Peer-Feedback-Aktivitäten eingebunden, die zu einem unterschiedlichen Argumentationsthema stattfanden​.


3. Zentrale Forschungsergebnisse


Verbesserungen im kritischen Denken: Peer-Feedback förderte das kritische Denken der Schüler
in mehreren Aspekten, darunter Relevanz, Rechtfertigung, Klarheit und Breite des Verständnisses. Allerdings zeigten die Dimensionen der praktischen Anwendbarkeit und des kritischen Assessments keine signifikante Verbesserung.


Veränderungen in den Co-Occurrence-Mustern: Nach dem Peer-Feedback zeigten sich in den Argumentationsnetzwerken der Schüler
ausgeprägte Verbindungen zwischen Relevanz und Rechtfertigung, was auf eine intensivere Reflexion und Kohärenz in den Argumenten hinweist. Die Struktur der Argumente war durch klarere und umfangreichere Verknüpfungen gekennzeichnet​.


4. Zusammenfassung
Die Studie zeigt, dass Peer-Feedback in einer CSCA-Umgebung die kritischen Denkfähigkeiten der Schüler
deutlich fördert. Die Verbesserung ist insbesondere in den Bereichen Justifikation und Klarheit spürbar, während praktische Anwendbarkeit und kritische Bewertung unverändert bleiben. Die Autoren unterstreichen die Bedeutung, Peer-Feedback als pädagogische Strategie zu nutzen, um die Entwicklung höherer Denkfähigkeiten zu unterstützen.

5. Kernaussagen


Bedeutung von Peer-Feedback: Peer-Feedback fördert eine tiefere Reflexion und das Verständnis für relevante und wichtige Aspekte in Argumenten (S. 5).


Breite und Klarheit: Nach dem Peer-Feedback verbesserten sich die Breite des Verständnisses und die Klarheit der Argumente signifikant (S. 9).


Begrenzte Verbesserungen in kritischen Bewertungen: Trotz der Vorteile des Peer-Feedbacks zeigte sich keine signifikante Verbesserung im Bereich der kritischen Bewertung, was auf notwendige pädagogische Anpassungen hinweist (S. 11)​.


6. Argumentationslinien
Die Autoren argumentieren, dass Peer-Feedback in der Lage ist, spezifische Dimensionen des kritischen Denkens zu fördern, indem es die Schüler
dazu anregt, ihre Argumente klarer und umfassender zu gestalten. Sie betonen die Bedeutung eines strukturierten Peer-Feedbacks, das sich auf die Stärkung argumentativer Fähigkeiten konzentriert und die Reflexion sowie die Fähigkeit zur Rechtfertigung unterstützt​.

7. Verschlagwortung


Kollaboratives Lernen: Untersuchung der Rolle von Peer-Feedback in der Förderung kollaborativer Argumentationsfähigkeiten.


Lehr- und Lerneffektivität: Analyse der Effektivität von Peer-Feedback zur Verbesserung des kritischen Denkens in einer CSCA-Umgebung.


Technologieintegration: Einsatz von CSCA-Technologien zur Förderung des kollaborativen und kritischen Denkens in digitalen Umgebungen.


8. Kategorisierung
Kerngedanke: Die Studie beleuchtet die Bedeutung von Peer-Feedback zur Förderung des kritischen Denkens und zeigt auf, dass kollaborative Lernmethoden gezielt zur Entwicklung von Reflexions- und Argumentationsfähigkeiten beitragen können (S. 12)​.
9. Zuordnung zur passendsten Forschungsunterfrage
FU4a: „Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?“


Begründung: Die Untersuchung von Peer-Feedback als Mechanismus zur Verbesserung des kritischen Denkens und der Argumentationsfähigkeiten zeigt Parallelen zur Förderung bildungswissenschaftlicher Mechanismen in digitalen Lernumgebungen.


10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie liefert wesentliche Einblicke in die Förderung des kritischen Denkens und der Reflexionsfähigkeiten durch kollaboratives Lernen).


Zitierhäufigkeit und Einfluss: 4 (Hochrelevantes Thema mit starker methodischer Grundlage, aber begrenzt durch das Fehlen einer Kontrollgruppe).


Aktualität: 5 (Veröffentlichung 2024, sehr aktuell und relevant im Kontext des digitalen kollaborativen Lernens).


Gesamtbewertung: 4.7
11. Schlussfolgerung
Die Studie von Chen et al. (2024) zeigt, dass Peer-Feedback das kritische Denken in einer CSCA-Umgebung signifikant verbessert und dass diese Methode Schüler
hilft, breitere und kohärentere Argumentationsstrukturen zu entwickeln. Die Autoren empfehlen, Peer-Feedback gezielt in Unterrichtskontexte zu integrieren, um die kritischen Denkfähigkeiten von Schülernachhaltig zu fördern​.
},
	file = {Chen et al. - 2024 - Using peer feedback to improve critical thinking i.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/Z9F6PQDW/Chen et al. - 2024 - Using peer feedback to improve critical thinking i.pdf:application/pdf},
}

@article{chen_exploring_2024,
	title = {Exploring students' computer‐supported collaborative argumentation with socio‐scientific issues},
	issn = {0266-4909, 1365-2729},
	url = {https://onlinelibrary.wiley.com/doi/10.1111/jcal.13073},
	doi = {10.1111/jcal.13073},
	abstract = {Background: This study examined the effect of computer-supported collaborative argumentation (CSCA) on secondary school students' understanding of socioscientific issues (SSI). Engaging students in collaborative argumentation is known to help with deepening their understanding of SSI.},
	language = {en-GB},
	urldate = {2024-10-17},
	journal = {Journal of Computer Assisted Learning},
	author = {Chen, Wenli and Han, Yiting and Tan, Jesmine and Chai, Aileen Siew Cheng and Lyu, Qianru and {Lyna}},
	month = oct,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:FU4a, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {jcal.13073},
	annote = {Analyse der Studie "Exploring students' computer-supported collaborative argumentation with socio-scientific issues" von Chen et al. (2024)
1. Hauptthemen und Ziele der Forschung
Diese Studie untersucht die Wirkung von computerunterstützter kollaborativer Argumentation (CSCA) auf das Verständnis sozio-wissenschaftlicher Themen (SSI) bei Sekundarschüler
. Ziel ist es, zu erforschen, wie CSCA-Techniken, insbesondere das grafisch basierte „AppleTree“-System, die Argumentationsfähigkeiten und die Fähigkeit zur Betrachtung multipler Perspektiven verbessern können, um so das tiefere Verständnis und das kritische Denken in Bezug auf komplexe gesellschaftliche Fragestellungen zu fördern​.

2. Methoden und Datenquellen


Studiendesign: Die Studie nutzt ein Mixed-Methods-Design, bei dem sowohl quantitative als auch qualitative Daten erhoben werden. Epistemic Network Analysis (ENA) wurde zur Analyse von Argumentationsmustern genutzt, während eine qualitative Analyse zur Untersuchung der Interaktionen und des Engagements der Schüler
bei der Argumentationsentwicklung durchgeführt wurde.


Datenquellen: 122 Schüler
in Singapur, aufgeteilt in 3 Schulklassen, nahmen an der Studie teil. Sie argumentierten in Gruppen zu sozio-wissenschaftlichen Fragen auf der „AppleTree“-Plattform. Dabei wurden Argumentationsartefakte sowie Interaktionsdaten während der Phasen der Argumentationsentwicklung gesammelt und analysiert​.


3. Zentrale Forschungsergebnisse


Verbesserung der Argumentationsfähigkeiten: Die Ergebnisse zeigen eine signifikante Verbesserung der Argumentationsqualität durch die CSCA-Methodik, insbesondere bei der Einbindung multipler Perspektiven und der logischen Strukturierung von Argumenten.


Dynamische Argumentationsmuster: Schüler
zeigten im Laufe der Argumentationsphasen zunehmend komplexere Verbindungen zwischen Argumenten, die sowohl unterstützende als auch gegensätzliche Beweise integrierten. Diese Veränderungen weisen auf eine verbesserte Fähigkeit hin, unterschiedliche Standpunkte zu erkennen und in die Argumentation einzubinden.


Effektives Peer-Feedback: Das Peer-Feedback half den Schüler
, ihre Argumentationsstrategien weiterzuentwickeln, indem sie gezielt Rückmeldungen zur Begründung und zum Perspektivenwechsel erhielten​.


4. Zusammenfassung
Die Studie zeigt, dass CSCA in der Lage ist, kritische Denk- und Argumentationsfähigkeiten bei Schüler
zu fördern, insbesondere durch die strukturierte Einbindung von Peer-Feedback und die grafische Darstellung von Argumenten. Diese Methode ermöglichte es den Schüler, komplexe sozio-wissenschaftliche Fragen tiefgreifend zu analysieren und multiple Perspektiven in ihre Argumentationen zu integrieren.

5. Kernaussagen


Verbesserte Perspektiveneinbindung: Schüler
entwickelten durch CSCA bessere Fähigkeiten zur Integration multipler Perspektiven (S. 4)​.


Nutzen grafischer Argumentationsstrukturen: Die graphische Darstellung unterstützte die Schüler
dabei, ihre Argumentationsstrukturen logisch und kohärent aufzubauen (S. 7)​.


Peer-Feedback als Lernunterstützung: Das strukturierte Peer-Feedback ermöglichte den Schüler
, ihre Argumente zu verfeinern und die Komplexität ihrer Gedankengänge zu erhöhen (S. 8)​.


6. Argumentationslinien
Die Autoren argumentieren, dass CSCA durch die Kombination grafischer Darstellungen und systematischen Peer-Feedbacks das kritische Denken fördert. Sie unterstreichen, dass die Methode besonders effektiv ist, um Schüler
darin zu unterstützen, divergente Perspektiven zu erkennen und in kohärente Argumentationsstrukturen zu integrieren​.

7. Verschlagwortung


Kollaboratives Lernen: Untersuchung der Rolle von CSCA bei der Förderung von Interaktionen und dem Austausch unterschiedlicher Perspektiven.


Technologieintegration: Analyse, wie digitale Plattformen zur strukturierten Argumentation eingesetzt werden können, um sozio-wissenschaftliche Themen zu bearbeiten.


Lehr- und Lerneffektivität: CSCA wurde als wirksame Methode zur Verbesserung des kritischen Denkens und der Argumentationsfähigkeiten im Unterricht analysiert.


8. Kategorisierung
Kerngedanke: Die Studie betont, dass die strukturelle und grafisch unterstützte Peer-Interaktion durch CSCA einen signifikanten Einfluss auf die Argumentationsfähigkeiten und die Perspektivenvielfalt der Schüler
hat, insbesondere bei der Auseinandersetzung mit sozio-wissenschaftlichen Themen (S. 9)​.

9. Zuordnung zu der passendsten Forschungsunterfrage
FU4a: „Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?“


Begründung: Die Studie untersucht bildungswissenschaftliche Mechanismen zur Förderung kollaborativer und kritischer Argumentationsprozesse und zeigt, wie diese in einer digitalen Lernumgebung gefördert werden können.


10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Arbeit bietet umfassende Erkenntnisse zu den Mechanismen der kollaborativen Argumentation).


Zitierhäufigkeit und Einfluss: 4 (Relevantes Thema mit fundierter methodischer Grundlage, jedoch durch die Kontexteinschränkung auf den SSI-Bereich limitiert).


Aktualität: 5 (Veröffentlichung 2024, sehr aktuell und relevant im Bereich der digitalen Bildung).


Gesamtbewertung: 4.7
11. Schlussfolgerung
Die Studie von Chen et al. (2024) demonstriert, dass CSCA ein wertvolles Werkzeug zur Förderung kritischen Denkens und zur Entwicklung von Argumentationsfähigkeiten darstellt. Die Methode bietet den Schüler
die Möglichkeit, divergente Perspektiven zu erforschen und in kohärente Argumentationen zu integrieren, was insbesondere in sozio-wissenschaftlichen Kontexten von Bedeutung ist. Die Autoren empfehlen, diese Methode weiter zu integrieren und spezifische Anpassungen an die Bedürfnisse und Ziele des jeweiligen Unterrichts vorzunehmen​.
},
	file = {Chen et al. - 2024 - Exploring students' computer‐supported collaborati.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/I5PKGQ7N/Chen et al. - 2024 - Exploring students' computer‐supported collaborati.pdf:application/pdf},
}

@article{noauthor_samaru_2024,
	title = {Samaru {Journal} of {Information} {Studies} {Vol}. 24(1){B} 2024},
	volume = {24},
	abstract = {This study examined the journey of historically marginalized students in gaining epistemological access and achieving success within the context of an elite private university in Nigeria. Through the lens of Morphogenetic and Affordance Theories, the research delves into how educational technologies provided opportunities and support for these students. However, this study showcases how the affordance of educational technologies, including digital learning platforms, online resources, and communication tools, has empowered marginalized students to overcome obstacles and thrive academically. By adopting a morphogenetic approach perspective, the research elucidates the dynamic interplay between technological affordances, social structures, and individual agency in shaping the educational experiences and achievements of historically marginalized students. Through a critical realist case study, the study highlights the transformative potential of educational technologies in promoting equity, inclusivity, and academic success within higher education institutions. The findings contribute to a deeper understanding of the complex interactions between technology, education, and social justice, offering insights for policymakers, educators, and practitioners striving to create more inclusive and equitable learning environments. The study concludes that educating marginalized students helps build the capacity to leverage advantage from digital resources and information in safe, secure, and sustainable ways. This study recommended that constant interaction between students-students, and students-teachers should be maintained.},
	language = {en-GB},
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Forschungsansätze, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Systemanpassung, Promotion:FU6, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	annote = {Analyse der Studie "Explaining How Historically Marginalized Students in an Elite Private University in Nigeria Gained Epistemological Access and Succeeded through the Affordances of Educational Technologies" von Bukhari Badamasi, Tijjani Abubakar, Hayatu Musa Mohammed und Habibu Mohammed (2024)
1. Hauptthemen und Ziele der Forschung
Die Studie untersucht, wie historisch marginalisierte Studierende an einer Elite-Privatuniversität in Nigeria epistemologischen Zugang und akademischen Erfolg durch die Nutzung bildungstechnologischer Ressourcen erreichen konnten. Im Fokus stehen die theoretischen Ansätze der Morphogenese und der Affordance-Theorie, um zu verdeutlichen, wie Bildungsressourcen zu Inklusion und Erfolg beitragen. Ziel der Forschung ist es, die Wechselwirkungen zwischen sozialen Strukturen, individueller Handlungsfähigkeit und den Möglichkeiten digitaler Lerntechnologien zu analysieren, um Bildungszugang und Gleichberechtigung zu fördern​.
2. Methoden und Datenquellen


Studiendesign: Die Untersuchung folgt einem kritischen realistischen Fallstudiendesign und basiert auf qualitativen strukturierten Interviews mit marginalisierten Studierenden.


Datenquellen: Die Daten stammen aus Interviews mit sieben Hausa-Fulani-Studierenden an der American University of Nigeria, die sozioökonomische Herausforderungen überwinden mussten, um akademisch erfolgreich zu sein. Die morphogenetische und Affordance-Theorie dient als theoretische Grundlage zur Analyse der Wirkmechanismen bildungstechnologischer Unterstützung für epistemologischen Zugang​.


3. Zentrale Forschungsergebnisse


Herausforderungen durch infrastrukturelle Defizite: Marginalisierte Studierende kämpfen mit unzuverlässiger Infrastruktur, insbesondere hinsichtlich Stromversorgung und Internetverfügbarkeit, die den Zugang zu digitalen Lernressourcen stark einschränkt.


Ressourcenoptimierung und Peer-Support: Studierende kompensieren fehlende Mittel durch Zusammenarbeit und den Zugang zu kostenlosen Online-Ressourcen, wie Open Educational Resources und Plattformen wie Coursera.


Nutzen der digitalen Lernangebote: Die Studierenden profitieren von digitalen Lernumgebungen, die Zugang zu akademischen Ressourcen und interaktive Lernmöglichkeiten bieten. Durch eine Kombination aus persönlicher Resilienz und Unterstützung durch die Universität gelingt es ihnen, epistemologischen Zugang zu etablieren und akademischen Erfolg zu erreichen​.


4. Zusammenfassung
Die Studie verdeutlicht, dass bildungstechnologische Ressourcen eine wesentliche Rolle im Bildungsaufstieg marginalisierter Studierender spielen. Trotz infrastruktureller und sozioökonomischer Hindernisse ermöglichten digitale Lernplattformen und das Gemeinschaftsgefühl unter den Studierenden die Bewältigung ihrer akademischen Herausforderungen und förderten ihren Erfolg.
5. Kernaussagen


Sozioökonomische Hürden: Infrastrukturelle und finanzielle Barrieren begrenzen den Zugang zu Bildungstechnologien für marginalisierte Studierende erheblich (S. 46).


Bildungstechnologien als Unterstützung für soziales Lernen: Digitale Lernressourcen, einschließlich Open Educational Resources und Plattformen wie Coursera, bieten eine zugängliche Alternative für Studierende mit begrenzten finanziellen Mitteln (S. 47).


Peer-Support und Resilienz: Durch Zusammenarbeit und geteilte Ressourcen überwinden marginalisierte Studierende strukturelle Hindernisse und schaffen es, erfolgreich akademischen Zugang zu erlangen (S. 48)​.


6. Argumentationslinien
Die Autoren argumentieren, dass Bildungstechnologien in Nigeria eine entscheidende Rolle für den Zugang zu akademischem Wissen und die Förderung von Chancengleichheit spielen. Sie betonen die Notwendigkeit, digitale Technologien an die spezifischen Herausforderungen marginalisierter Studierender anzupassen und die Infrastrukturen in benachteiligten Regionen zu verbessern. Es wird hervorgehoben, dass Peer-Netzwerke und persönliche Resilienz entscheidende Faktoren für den Erfolg dieser Studierenden sind​.
7. Verschlagwortung


Technologieintegration: Die Studie zeigt, wie Bildungstechnologien erfolgreich in das Bildungsumfeld marginalisierter Studierender integriert werden, um Barrieren abzubauen und den Lernprozess zu unterstützen.


Systemanpassung: Untersuchung der notwendigen Anpassungen von Bildungssystemen und Technologien an die spezifischen Bedürfnisse sozioökonomisch benachteiligter Studierender.


Forschungsansätze: Anwendung der Morphogenetischen Theorie und der Affordance-Theorie zur Untersuchung der Auswirkungen von Bildungstechnologien auf benachteiligte Studierende.


8. Kategorisierung
Kerngedanke: Die zentrale Idee der Studie besteht darin, dass Bildungstechnologien durch epistemologischen Zugang eine Brücke zu Chancengleichheit und sozialer Mobilität für historisch benachteiligte Gruppen schaffen können, wobei die spezifischen kontextuellen und strukturellen Herausforderungen betont werden, die marginalisierte Studierende überwinden müssen (S. 50)​.
9. Zuordnung zur passendsten Forschungsunterfrage
FU6: „Wie wird ein systemisch-konstruktivistisches Learning-Management-System als Kompetenzerwerbssystem bei Akteuren im digitalen Bildungsraum von Gesundheitsberufen beurteilt?“


Begründung: Die Arbeit bietet Einblicke in den Einsatz von Bildungstechnologien zur Unterstützung des Kompetenzaufbaus in benachteiligten sozialen Gruppen und deren Wirkung auf soziale Inklusion und Bildungserfolg.


10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Relevante Einsichten zur Förderung des Zugangs und des Bildungserfolgs durch digitale Technologien in benachteiligten Gruppen).


Zitierhäufigkeit und Einfluss: 4 (Fundierte und umfassende Studie, die wertvolle Erkenntnisse für Bildungsstrategien bietet).


Aktualität: 5 (Veröffentlichung im Jahr 2024, hochaktuell im Kontext sozialer Inklusion und digitaler Bildung).


Gesamtbewertung: 4.7
11. Schlussfolgerung
Die Studie von Badamasi et al. (2024) zeigt, dass Bildungstechnologien das Potenzial haben, benachteiligten Studierenden in Nigeria den Zugang zu akademischem Wissen und sozialer Mobilität zu erleichtern. Sie fordert eine an den Kontext angepasste Implementierung von digitalen Technologien und hebt die Bedeutung von Peer-Support und Resilienz als zentrale Faktoren für den akademischen Erfolg marginalisierter Studierender hervor​.
},
	file = {2024 - Samaru Journal of Information Studies Vol. 24(1)B .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/HP6A9WY3/2024 - Samaru Journal of Information Studies Vol. 24(1)B .pdf:application/pdf},
}

@article{chen_supporting_2024,
	title = {Supporting learning performance improvement: {Role} of online group assessment},
	issn = {1360-2357, 1573-7608},
	shorttitle = {Supporting learning performance improvement},
	url = {https://link.springer.com/10.1007/s10639-024-12907-5},
	doi = {10.1007/s10639-024-12907-5},
	abstract = {Though online peer assessment is recognized as a critical factor in enhancing learning performance, pedagogical strategies and analysis of students’ peer assessment at the group level, rather than the individual level, are underexplored. Online group assessment (OGA) focuses on assessing peer-group work in an online environment. A total of 64 student teachers participated in this study, where they were divided into multiple groups of four. Each group was required to collaborate on completing an instructional design and engage in OGA activities. We utilized the Technological Pedagogical Content Knowledge (TPACK) scale to assess the instructional designs of student teachers, evaluating their ability to integrate technology, pedagogy, and content knowledge. In this research, we consider the TPACK scores of each group’s instructional design as their learning performance. The correlations between providing, receiving, and responding to comments and group learning performance were explored by adopting a mixed methods approach. The results indicated that OGA enhanced group learning performance. Providing comments was more associated with improved group learning performance than receiving and responding to them. Furthermore, providing informative comments was more associated with group learning performance than providing other types of comments. In addition, innovative responses were positively associated with group learning performance, while uptake responses were negatively associated with group learning performance. Finally, the discussion and suggestions of intervention for different stages of OGA are provided to help design and implement OGA activities in the future.},
	language = {en-GB},
	urldate = {2024-08-02},
	journal = {Education and Information Technologies},
	author = {Chen, Fengjuan and Zhang, Si and Liu, Qingtang and Yu, Shufan and Li, Xiaojuan and Zheng, Xinxin},
	month = jul,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:FU4a, Promotion:Kerngedanke, Promotion:Relevanz:5, Bewertungsmethoden, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	annote = {Hier ist die strukturierte Analyse und Zusammenfassung des Artikels „Supporting learning performance improvement: Role of online group assessment“ von Chen et al. (2024):

Analyse
1. Hauptthemen und Ziele der Forschung


Hauptthemen:


Analyse der Wirksamkeit von Online Group Assessments (OGA) im Vergleich zu individuellen Peer Assessments (OPA).


Untersuchung der kognitiven und qualitativen Auswirkungen von Feedbackphasen (Kommentieren, Empfangen und Antworten) auf die Lernleistung.




Ziele:


Evaluation der Gruppendynamik und -leistung in der Lehrerausbildung durch das Technological Pedagogical Content Knowledge (TPACK)-Framework.


Bestimmung der optimalen Feedbackstrategien zur Verbesserung der Lernleistung.




2. Methoden und Datenquellen


Methoden:


Mixed-Methods-Ansatz: Quantitative (t-Tests, lineare Regression) und qualitative Analysen (Interviewkodierung).


Einsatz von Online-Plattformen wie QQ und Xiaoya zur Unterstützung von Gruppenkommunikation und Peer-Assessments.




Datenquellen:


64 Lehramtsstudierende in 16 Gruppen.


Vergleich der Qualität von Lehrdesigns vor und nach OGA anhand des TPACK-Frameworks.




3. Zentrale Forschungsergebnisse


Verbesserung der Lernleistung:


TPACK-Scores stiegen signifikant nach OGA (Pre-OGA M = 18,19; Post-OGA M = 23,13; p {\textless} 0,001).


Der Prozess des Feedbackgebens hatte den größten Einfluss auf die Gruppenleistung.




Qualität von Kommentaren:


„Informative“ Kommentare führten zu höheren Lernergebnissen als „suggestive“ oder „verifizierende“ Kommentare.




Antwortverhalten:


„Innovative“ Antworten auf Kommentare waren mit einer Verbesserung der Gruppenleistung korreliert, während „Uptake“-Antworten (direkte Übernahme) negativ assoziiert waren.





Zusammenfassung
Die Studie zeigt, dass Online Group Assessments eine effektive Methode sind, um die Lernleistung von Gruppen in der Lehrerausbildung zu verbessern. Die Ergebnisse belegen, dass besonders das aktive Feedbackgeben und innovative Antworten auf erhaltenes Feedback entscheidend für den Lernerfolg sind. Die Kombination aus qualitativen Kommentaren und interaktiver Zusammenarbeit ermöglicht eine tiefere kognitive Verarbeitung und bessere Gruppendynamik.

Kernaussagen


Bedeutung des Feedbackgebens: Feedbackgeben führt zu kritischerem Denken und verbessert die Qualität der Lehrdesigns (S. 12-13).


Hochwertige Kommentare: Informative Kommentare haben die größte Wirkung auf die kognitive Entwicklung und Gruppenleistung (S. 14).


Innovatives Antworten: Kritisches und kreatives Eingehen auf Kommentare ist effektiver als reine Übernahme (S. 15).



Argumentationslinien


Hauptthese: OGA verbessert die Lernleistung durch kollaboratives Feedback und gezielte Interaktionen.


Unterstützende Evidenz: Statistisch signifikante Verbesserungen in TPACK-Scores belegen die Effektivität von OGA (S. 16).


Implikationen: Lehrkräfte sollten auf die Qualität von Kommentaren und Antworten achten, um nachhaltige Lernerfolge zu erzielen (S. 17).



Verschlagwortung


Kollaboratives Lernen: Förderung von Gruppendynamik und kritischem Denken durch OGA.


Bewertungsmethoden: Analyse der Effizienz von Feedbackphasen in Gruppen.


Lehr- und Lerneffektivität: Verbesserung der Lernleistung durch strukturierte Zusammenarbeit und Feedback.



Kategorisierung
Kategorie: KerngedankeBegründung: Der Artikel fokussiert sich auf die zentralen Mechanismen, die zur Verbesserung der Gruppenlernleistung durch OGA führen.

Zuordnung zu Forschungsfragen


Passendste Forschungsfrage: FU4a: Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen LMS im Bezug auf die Wirkung auf Akteure im digitalen Bildungsraum beschrieben?


Begründung: Die Studie untersucht, wie Feedbackprozesse und kollaborative Methoden die Lernleistung im digitalen Bildungsraum beeinflussen.



Relevanzbewertung


Aktualität: 5 (Veröffentlichung 2024, hoch relevant).


Direkte Relevanz: 5 (Zentrale Erkenntnisse zur Effektivität von OGA in Bildungskontexten).


Gesamtbewertung: 5 (Wesentlich für digitale Lern- und Bewertungsmethoden).


},
	file = {Chen et al. - 2024 - Supporting learning performance improvement Role .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/IQX7GFRC/Chen et al. - 2024 - Supporting learning performance improvement Role .pdf:application/pdf},
}

@article{alfakhry_psychometric_2024,
	title = {Psychometric properties of the {Arabic} version of {PHEEM} applied on a sample of medical residents in {Syria}},
	volume = {24},
	issn = {1472-6920},
	url = {https://bmcmededuc.biomedcentral.com/articles/10.1186/s12909-024-05731-5},
	doi = {10.1186/s12909-024-05731-5},
	abstract = {Background  The clinical learning environment (CLE) plays a crucial role in shaping the learning experiences and professional development of medical professionals. Understanding and optimising this environment is essential for improving doctors’ knowledge acquisition, clinical skills, and overall well-being. The development of the Postgraduate Hospital Educational Environment Measure (PHEEM) and its translation to numerous languages has been a milestone in clinical education. Even though PHEEM was recently translated into Arabic, its psychometric properties in this form remain unevaluated. Therefore, this study aims to conduct a comprehensive psychometric analysis of the Arabic version of the PHEEM questionnaire. Methods  This is a cross-sectional questionnaire survey validation study. The defined population were medical residents in Damascus, Syria. A paper-based survey as well as an online-based one were conducted using several nonprobability sampling methods namely, convenience, river and, snowball sampling between June 15, 2023, and June 21, 2023. Both exploratory (EFA) and confirmatory (CFA) factor analyses were conducted. Several psychometric criteria were applied including scree plot, eigenvalue {\textgreater} 1.5 and the ‘proportion of variance accounted for’ criterion. Results  A total of 543 participants completed the questionnaire (56.9\% female). Kaiser-Meyer-Olkin measure for sample adequacy was high (0.937) and the P-value for Bartlett’s test was {\textless} 0.001. EFA revealed five meaningful factors which were labelled: perception of teachers, learner’s engagement and social participation, external regulation, work culture, and living conditions. These factors had the following eigenvalues: 12.6, 2.18, 2.03, 1.86, and 1.41 respectively, with a total explained variance of 43.45\%. Cronbach’s Alpha was 0.938. CFA confirmed the model structure of EFA (SRMR = 0.067 and RMSEA = 0.066). The Average Variance Explained (AVE) value of any given factor was {\textgreater} 0.7. Discussion  The Arabic PHEEM inventory demonstrated satisfactory psychometric properties. The extracted domains are of theoretical relevance to the psychosocial-material conceptual framework for learning environment. Nonetheless, this validation was performed in the Syrian context; therefore, future studies in other Arabic countries are recommended to support the applicability of Arabic PHEEM in the wide Arab World.},
	language = {en-GB},
	number = {1},
	urldate = {2024-08-02},
	journal = {BMC Medical Education},
	author = {Alfakhry, Ghaith and Kodmani, Rama and Almasri, Imad Addin},
	month = jul,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Lehr- und Lerneffektivität, Promotion:FU4a, Promotion:Kerngedanke, Promotion:Relevanz:5, Bewertungsmethoden, Systemanpassung, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {728},
	annote = {Hier ist die strukturierte Analyse und Zusammenfassung des Artikels „Psychometric properties of the Arabic version of PHEEM applied on a sample of medical residents in Syria“ von Alfakhry et al. (2024):

Analyse
1. Hauptthemen und Ziele der Forschung


Hauptthemen:


Bewertung der psychometrischen Eigenschaften der arabischen Version des Postgraduate Hospital Educational Environment Measure (PHEEM).


Untersuchung, wie diese Version für die Bewertung klinischer Lernumgebungen in der arabischen Welt geeignet ist.




Ziele:


Durchführung von Exploratory (EFA) und Confirmatory Factor Analysis (CFA), um die Validität und Zuverlässigkeit der arabischen PHEEM-Version zu bewerten.


Identifikation relevanter Faktoren, die das Lernen und die Erfahrungen von medizinischen Fachkräften in klinischen Umgebungen beeinflussen.




2. Methoden und Datenquellen


Methoden:


Querschnittsstudie mit 543 medizinischen Fachkräften in Damaskus, Syrien.


Datenerhebung durch Online- und Papierfragebögen (nicht-probabilistische Sampling-Methoden).


Anwendung von EFA und CFA zur Bestimmung der internen Struktur und der Passung des Modells.




Datenquellen:


Antworten von Ärzten in Weiterbildung aus neun großen Krankenhäusern.


Erhebung von demografischen Daten und PHEEM-Antworten auf einer Likert-Skala.




3. Zentrale Forschungsergebnisse


EFA-Ergebnisse:


Extraktion von fünf Faktoren: Wahrnehmung der Lehrenden, Engagement und soziale Teilnahme der Lernenden, externe Regulation, Arbeitskultur und Lebensbedingungen.


Diese Faktoren erklärten zusammen 43,45 \% der Varianz.




CFA-Ergebnisse:


Bestätigung der Fünf-Faktor-Struktur (RMSEA = 0.066; SRMR = 0.067).


Hohe interne Konsistenz der 36 Items (Cronbach's Alpha = 0.938).




Praktische Erkenntnisse:


Die arabische Version des PHEEM bietet eine valide und zuverlässige Grundlage zur Bewertung klinischer Lernumgebungen in Syrien.


Die spezifischen kulturellen und organisatorischen Kontexte der Region wurden berücksichtigt.





Zusammenfassung
Der Artikel evaluiert die arabische Version des PHEEM-Instruments zur Messung klinischer Lernumgebungen. Mit der Extraktion von fünf relevanten Faktoren und der Bestätigung der Modellstruktur durch CFA zeigt die Studie, dass die arabische PHEEM-Version ein geeignetes Werkzeug ist, um die Wahrnehmung von Lehrqualität, sozialen und organisatorischen Bedingungen sowie Lebensumständen in klinischen Bildungskontexten zu bewerten.

Kernaussagen


Relevante Faktoren: Wahrnehmung der Lehrenden ist der wichtigste Faktor für die Lernumgebung, gefolgt von sozialen und organisatorischen Aspekten (S. 5-6).


Hohe Validität und Zuverlässigkeit: Die psychometrischen Eigenschaften erfüllen internationale Standards und machen die arabische PHEEM-Version zu einem robusten Instrument (S. 8).


Kulturelle Relevanz: Die Ergebnisse betonen die Bedeutung lokaler Anpassungen und kultureller Kontexte in der Anwendung solcher Instrumente (S. 9).



Argumentationslinien


Hauptthese: Die arabische Version von PHEEM ist ein valides und reliables Instrument zur Bewertung klinischer Lernumgebungen und fördert die Entwicklung zielgerichteter Interventionen.


Unterstützende Evidenz: Die psychometrische Analyse zeigt hohe Zuverlässigkeit und Passung des Modells (S. 6-7).


Implikationen: Weitere Studien in anderen arabischen Ländern könnten die Übertragbarkeit und Anwendung des Instruments erweitern (S. 10-11).



Verschlagwortung


Bewertungsmethoden: Entwicklung und Validierung von Instrumenten zur Messung von Lernumgebungen.


Lehr- und Lerneffektivität: Wahrnehmung der Lehrqualität und deren Einfluss auf die klinische Ausbildung.


Systemanpassung: Anpassung von Bewertungsinstrumenten an kulturelle und organisatorische Kontexte.



Kategorisierung
Kategorie: KerngedankeBegründung: Der Artikel liefert grundlegende Einsichten zur Messung und Bewertung von klinischen Lernumgebungen und deren kulturellen Adaptionen.

Zuordnung zu Forschungsfragen


Passendste Forschungsfrage: FU4a: Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen LMS im Bezug auf die Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?


Begründung: Die Studie analysiert Faktoren, die die Wahrnehmung und Effektivität klinischer Lernumgebungen beeinflussen, was auf digitale Lernkontexte übertragbar ist.



Relevanzbewertung


Aktualität: 5 (Veröffentlichung 2024, hoch aktuell).


Direkte Relevanz: 5 (Wichtige Erkenntnisse für die Messung von Lernumgebungen in der Gesundheitsausbildung).


Gesamtbewertung: 5 (Essentiell für die Bildungsforschung und -praxis).


},
	file = {Alfakhry et al. - 2024 - Psychometric properties of the Arabic version of P.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/KGIN4939/Alfakhry et al. - 2024 - Psychometric properties of the Arabic version of P.pdf:application/pdf},
}

@article{angelo_technology_2024,
	title = {Technology {Use} {Factoring} into {Virtual} {Group} {Performance}},
	issn = {0887-4417, 2380-2057},
	url = {https://www.tandfonline.com/doi/full/10.1080/08874417.2024.2382219},
	doi = {10.1080/08874417.2024.2382219},
	abstract = {Virtual teams have become common in business, and their continued growth warrants examina­ tion as to the characteristics that contribute to their success. Much of the research acknowledges use of technology as a key element of virtual group success, but quantitative analysis of the independent and dependent variables that contribute to that success is lacking. To be more precise in the examination of variables contributing to project success, and to communicate more effectively with regard to this research, we need to operationally define these contributing factors. Using measurable variables this research examines the effect of technology use on team success with a business plan and cost risk benefit analysis. More granular examination of success variables in virtual groups will make us more precise in understanding and replicating research as well as groups success. This learning exercise predicates on the precepts of social constructivism.},
	language = {en-GB},
	urldate = {2024-08-02},
	journal = {Journal of Computer Information Systems},
	author = {Angelo, Raymond},
	month = jul,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Promotion:FU3, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {1--9},
	file = {Angelo - 2024 - Technology Use Factoring into Virtual Group Perfor.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/QGWF6MAF/Angelo - 2024 - Technology Use Factoring into Virtual Group Perfor.pdf:application/pdf},
}

@article{trentepohl_self-regulation_2023,
	title = {Self-regulation of resources in higher education: {Strategic} learning behaviour mediates the effect of learning strategy knowledge on academic performance},
	copyright = {https://creativecommons.org/licenses/by-nc-nd/4.0},
	issn = {1010-0652, 1664-2910},
	shorttitle = {Self-regulation of resources in higher education},
	url = {https://econtent.hogrefe.com/doi/10.1024/1010-0652/a000374},
	doi = {10.1024/1010-0652/a000374},
	abstract = {Resource-management learning strategies are particularly important for performance in higher education. Despite this consideration, the current state of research still lacks evidence on the precise interplay of the different learning process components that affect academ­ ic performance. The aim of the present study was to test a mediation model derived from process theories of self-regulated learning, in which students' knowledge about resource-management strategies impacts their academic performance via its behavioural manifestations. N = 106 university students took part in an online course over the period of one semester. Students' resource-management strategy knowledge was assessed at the beginning of the semester, and their use of resource-management strategies was observed via log data of their learning behaviour during the semester while learning through the online course. Academic performance was assessed on the basis of an exam at the end of the semester. The mediation model was tested for three different resource-management strategies: time management, effort regulation, and help seeking. There was a significant indirect effect of strategy knowledge via strategy use on academic performance for all learning strategies considered. We conclude that students' strategic learning behaviour is an indispensable link in the relationship between their strategy know­ ledge and academic performance, and discuss implications for research and training practice.},
	language = {en-GB},
	urldate = {2024-07-21},
	journal = {Zeitschrift für Pädagogische Psychologie},
	author = {Trentepohl, Sebastian and Waldeyer, Julia and Fleischer, Jens and Roelle, Julian and Leutner, Detlev and Wirth, Joachim},
	month = dec,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Bewertungsmethoden, Systemanpassung, Promotion:FU5, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {1010--0652/a000374},
	annote = {Analyse der Studie "Self-regulation of resources in higher education: Strategic learning behaviour mediates the effect of learning strategy knowledge on academic performance" von Trentepohl et al. (2023)
1. Hauptthemen und Ziele der Forschung
Die Studie untersucht die Rolle des selbstregulierten Lernens, speziell im Bereich des Ressourcenmanagements, und wie das Wissen über Lernstrategien die akademische Leistung beeinflusst. Ein zentrales Ziel ist es, ein Mediationsmodell zu testen, in dem das Wissen der Studierenden über Ressourcenmanagementstrategien durch deren tatsächliches Lernverhalten vermittelt auf die Leistung wirkt. Der Fokus liegt auf drei Strategien: Zeitmanagement, Anstrengungsregulation und Hilfesuche​.
2. Methoden und Datenquellen


Studiendesign: Die Studie folgt einem korrelativen Design mit mehreren Messzeitpunkten über ein Semester. Die Probanden (n = 106) nahmen an einem Online-Kurs teil, in dem ihr Strategiewissen zu Beginn und ihr Lernverhalten während des Semesters erfasst wurde.


Datenquellen: Die erhobenen Daten umfassen Logdaten zu Lernaktivitäten, das Strategiewissen der Studierenden sowie deren akademische Leistung, gemessen durch eine Abschlussprüfung​.


3. Zentrale Forschungsergebnisse


Strategiewissen als Basis für Leistung: Es zeigte sich, dass das Wissen über Ressourcenmanagementstrategien (Zeitmanagement, Anstrengungsregulation, Hilfesuche) positiv mit der tatsächlichen Anwendung dieser Strategien korreliert.


Vermittlungseffekt des Lernverhaltens: Das Lernverhalten der Studierenden vermittelt den Zusammenhang zwischen Strategiewissen und akademischer Leistung; das Wissen allein hatte ohne angemessene Anwendung keinen signifikanten Effekt.


Bedeutung der Strategien: Die Untersuchung zeigt, dass das systematische Anwenden der Ressourcenmanagementstrategien die Leistung erheblich steigern kann, wobei Zeitmanagement und Anstrengungsregulation besonders effektiv waren​.


4. Zusammenfassung
Die Studie bestätigt, dass das bloße Wissen über Ressourcenmanagementstrategien nicht ausreicht, um die akademische Leistung zu verbessern; es ist die strategische Nutzung dieses Wissens, die einen positiven Einfluss hat. Dieses Wissen ist daher für die Planung und Umsetzung effektiver Lernstrategien unverzichtbar.
5. Kernaussagen


Mediation durch Lernverhalten: Das Lernverhalten vermittelt signifikant zwischen dem Strategiewissen und der Leistung (S. 9).


Stärkung durch Zeitmanagement und Anstrengungsregulation: Diese beiden Strategien korrelieren am stärksten mit der Leistung und sind daher von zentraler Bedeutung für die Verbesserung der Studienergebnisse (S. 10)​.


6. Argumentationslinien
Die Autoren argumentieren, dass die Förderung selbstregulierter Lernstrategien zu einem verbesserten Studienerfolg führt. Durch die systematische Umsetzung und das Wissen über solche Strategien können Studierende ihre Lernergebnisse optimieren. Die Ergebnisse unterstreichen die Bedeutung von Lernstrategietrainings, die auf die praktische Anwendung von Strategiewissen ausgerichtet sind​.
7. Verschlagwortung


Lehr- und Lerneffektivität: Die Untersuchung der Wirksamkeit von Lernstrategien und deren Auswirkungen auf die akademische Leistung.


Bewertungsmethoden: Die Messung von Ressourcenmanagementstrategien durch ein umfassendes Mediationsmodell zur Bestimmung ihrer Effekte.


Systemanpassung: Anpassung von Lernmanagementsystemen zur Unterstützung selbstregulierter Lernprozesse.


8. Kategorisierung
Kerngedanke: Die Studie hebt hervor, dass der selbstregulierte Einsatz von Ressourcenmanagementstrategien eine entscheidende Rolle in der akademischen Leistung spielt und dass die Verinnerlichung und Anwendung dieses Wissens durch Lernstrategietraining verbessert werden kann (S. 11)​.
9. Zuordnung zur passendsten Forschungsunterfrage
FU5: „Welche Möglichkeiten und Grenzen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems durch Akteure im digitalen Bildungsraum von Gesundheitsberufen analysiert?“


Begründung: Die Arbeit bietet Einblicke in die Bedingungen und Anforderungen effektiver Ressourcenmanagementstrategien und ihre Bedeutung für Lernmanagementsysteme.


10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Lieferung wesentlicher Erkenntnisse zur Wirksamkeit und Implementierung von Lernstrategien).


Zitierhäufigkeit und Einfluss: 4 (Wichtige und umfassende Studie zur Bewertung selbstregulierter Lernstrategien).


Aktualität: 5 (Veröffentlichung 2023, hochaktuell und relevant).


Gesamtbewertung: 4.7
11. Schlussfolgerung
Die Studie von Trentepohl et al. (2023) zeigt, dass Ressourcenmanagementstrategien wie Zeitmanagement und Anstrengungsregulation die akademische Leistung maßgeblich beeinflussen. Die Forschungsergebnisse betonen die Notwendigkeit praktischer Trainings in Ressourcenmanagementstrategien, um Studierenden die Anwendung ihres Strategiewissens in realen Lernkontexten zu erleichtern​.
},
	file = {Trentepohl et al. - 2023 - Self-regulation of resources in higher education .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/65ML2UGK/Trentepohl et al. - 2023 - Self-regulation of resources in higher education .pdf:application/pdf},
}

@article{babik_systematic_2024,
	title = {A systematic review of educational online peer-review and assessment systems: charting the landscape},
	volume = {72},
	issn = {1042-1629, 1556-6501},
	shorttitle = {A systematic review of educational online peer-review and assessment systems},
	url = {https://link.springer.com/10.1007/s11423-024-10349-x},
	doi = {10.1007/s11423-024-10349-x},
	abstract = {Over the past two decades, there has been an explosion of innovation in software tools that encapsulate and expand the capabilities of the widely used student peer assessment. While the affordances and pedagogical impacts of traditional in-person, “paper-and-pencil” peer assessment have been studied extensively and are relatively well understood, computerized (online) peer assessment introduced not only shifts in scalability and efficiency, but also entirely new capabilities and forms of social learning interactions, instructor leverage, and distributed cognition, that still need to be researched and systematized. Despite the ample research on traditional peer assessment and evidence of its efficacy, common vocabulary and shared understanding of online peer-assessment system design, including the variety of methods, techniques, and implementations, is still missing. We present key findings of a comprehensive survey based on a systematic research framework for examining and generalizing affordances and constraints of online peer-assessment systems. This framework (a) provides a foundation of a design-science metatheory of online peer assessment, (b) helps structure the discussion of user needs and design options, and (c) informs educators and system design practitioners. We identified two major themes in existing and potential research—orientation towards scaffolded learning vs. exploratory learning and system maturity. We also outlined an agenda for future studies.},
	language = {en-GB},
	number = {3},
	urldate = {2024-07-21},
	journal = {Educational technology research and development},
	author = {Babik, Dmytro and Gehringer, Edward and Kidd, Jennifer and Sunday, Kristine and Tinapple, David and Gilbert, Steven},
	month = jun,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Forschungsansätze, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Bewertungsmethoden, Promotion:FU5, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU5},
	pages = {1653--1689},
	annote = {
Analyse der Studie "A systematic review of educational online peer-review and assessment systems: Charting the landscape" von Dmytro Babik et al. (2024)
1. Hauptthemen und Ziele der Forschung
Diese systematische Überprüfung untersucht die verschiedenen Designaspekte und funktionalen Merkmale von Online-Peer-Review- und Assessment-Systemen (OPRA), die zur Unterstützung von Lernprozessen entwickelt wurden. Ziel der Forschung ist es, eine strukturierte Analyse der funktionalen Möglichkeiten und Einschränkungen dieser Systeme zu erstellen und damit eine Grundlage für ein Design-Science-Metatheorie zu schaffen, die Entwickler, Pädagogen und Bildungstechnologen informiert​.
2. Methoden und Datenquellen


Studiendesign: Die Überprüfung folgt einem umfassenden systematischen Rahmenwerk, das durch eine Analyse existierender Studien, Systembewertungen und Fokusgruppendiskussionen mit Entwicklern und Nutzern gestützt wird.


Datenquellen: Die Daten für diese Überprüfung umfassen wissenschaftliche Literatur über OPRA-Systeme seit den 1990er Jahren, wobei der Schwerpunkt auf Systemen nach Einführung von Web 2.0 liegt. Durch eine Auswahl wichtiger Studien und Systeme wurde ein detailliertes Verständnis über Designmerkmale, Nutzeranforderungen und Lernimplikationen entwickelt​.


3. Zentrale Forschungsergebnisse


Designvariationen in OPRA-Systemen: Die Studie identifiziert wesentliche Merkmale, darunter Bewertungsrubriken, Feedback-Formate, Anonymitätsstufen und Aggregationsmethoden für Peer-Bewertungen. Ein Schwerpunkt liegt auf den divergierenden Systemdesigns, die auf unterschiedliche pädagogische Bedürfnisse abgestimmt sind.


Nutzerorientierte Systemgestaltung: Die Untersuchung betont, dass erfolgreiche OPRA-Systeme an die spezifischen Bedürfnisse der Benutzer angepasst werden müssen, wie z. B. Flexibilität für komplexe Workflows versus Benutzerfreundlichkeit für geringere technische Vorkenntnisse.


Herausforderungen der Systemimplementierung: Trotz der Potenziale zur Skalierung und Effizienzsteigerung durch OPRA-Systeme bleiben Herausforderungen, insbesondere hinsichtlich der Integration benutzerfreundlicher Schnittstellen und der Konsistenz von Bewertungsprozessen, bestehen. Die Studie schlägt Verbesserungen vor, die die Qualität und Zuverlässigkeit von Peer-Bewertungen in OPRA-Systemen sichern sollen​.


4. Zusammenfassung
Die systematische Überprüfung von Babik et al. beleuchtet die Designvielfalt von OPRA-Systemen und bietet eine Orientierungshilfe für zukünftige Systementwicklungen. Durch die Identifizierung zentraler Designanforderungen wird die Arbeit eine nützliche Ressource für Entwickler und Pädagogen sein, um OPRA-Systeme effektiver zu gestalten und zu implementieren.
5. Kernaussagen


Systematische Designkriterien für OPRA: OPRA-Systeme müssen sowohl funktionale als auch pädagogische Anforderungen erfüllen, um die Benutzererfahrung und die Qualität des Peer-Reviews zu verbessern (S. 1655).


Nutzerzentrierte Flexibilität: Systeme, die flexibel gestaltet sind, zeigen eine erhöhte Nutzerzufriedenheit und fördern interaktive Lernumgebungen (S. 1658).


Verbesserungsbedarf in Usability und Bewertungsqualität: Die Entwicklung benutzerfreundlicher Schnittstellen und die Sicherstellung von Bewertungskonsistenz sind entscheidend für die Akzeptanz von OPRA-Systemen (S. 1664)​.


6. Argumentationslinien
Die Autoren argumentieren, dass OPRA-Systeme maßgeblich zur Effizienz und Skalierbarkeit des Peer-Assessment beitragen, jedoch eine sorgfältige Designabstimmung benötigen, um eine Balance zwischen Benutzerfreundlichkeit und Flexibilität zu erreichen. Sie heben hervor, dass die Integration digitaler Funktionen, wie Anonymität und Feedback-Optionen, entscheidend für die pädagogische Wirkung und Akzeptanz dieser Systeme ist​.
7. Verschlagwortung


Technologieintegration: Analyse der technologischen Möglichkeiten zur Verbesserung der Peer-Bewertungen und deren systematische Integration.


Bewertungsmethoden: Untersuchung der verschiedenen Bewertungsmethoden und Feedback-Systeme innerhalb der OPRA-Designs.


Forschungsansätze: Entwicklung eines strukturierten Metatheorie-Rahmenwerks, das zukünftige Forschungs- und Designentscheidungen leiten soll.


8. Kategorisierung
Kerngedanke: Die Studie unterstreicht die zentrale Idee, dass OPRA-Systeme durch ein sorgfältig ausgearbeitetes Design die Qualität und Effizienz von Peer-Reviews in Bildungssettings signifikant verbessern können und hebt die Notwendigkeit eines strukturierten Ansatzes zur Gestaltung und Evaluierung dieser Systeme hervor (S. 1667)​.
9. Zuordnung zur passendsten Forschungsunterfrage
FU5: „Welche Möglichkeiten und Grenzen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems durch Akteure im digitalen Bildungsraum von Gesundheitsberufen analysiert?“


Begründung: Die Arbeit bietet Einsichten in die Gestaltung und Begrenzungen digitaler Peer-Review-Systeme und deren Potenzial zur Unterstützung und Begrenzung von Lernprozessen in verschiedenen Bildungsumgebungen.


10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Erheblich für das Verständnis der Integration und Effektivität digitaler Peer-Bewertungssysteme).


Zitierhäufigkeit und Einfluss: 4 (Wichtige systematische Übersicht für Entwickler und Bildungstechnologen, jedoch ohne empirische Validierung der einzelnen Systeme).


Aktualität: 5 (Veröffentlichung 2024, sehr aktuell im Bereich digital unterstützter Lerntechnologien).


Gesamtbewertung: 4.7
11. Schlussfolgerung
Babik et al. (2024) zeigen, dass OPRA-Systeme durch eine sorgfältige Gestaltung erhebliche Vorteile für die Bildungspraxis bieten können, insbesondere im Hinblick auf die Effizienz und Qualität von Peer-Bewertungen. Die Studie liefert eine fundierte Grundlage für zukünftige Systemdesigns und hebt die Relevanz eines strukturierten und nutzerzentrierten Ansatzes bei der Gestaltung digitaler Bewertungssysteme hervor​.
},
	file = {Babik et al. - 2024 - A systematic review of educational online peer-rev.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/CA5ZZ22U/Babik et al. - 2024 - A systematic review of educational online peer-rev.pdf:application/pdf},
}

@article{peramunugamage_design_2024,
	title = {Design of {Moodle}-based collaborative learning activities to enhance student interactions},
	copyright = {https://www.emerald.com/insight/site-policies},
	issn = {1858-3431, 2414-6994},
	url = {https://www.emerald.com/insight/content/doi/10.1108/AAOUJ-06-2023-0079/full/html},
	doi = {10.1108/AAOUJ-06-2023-0079},
	abstract = {Purpose – This article explores the impact of systematically designed online collaborative activities in two engineering undergraduate modules and key considerations for student interaction in Moodle. Design/methodology/approach – The educational design research approach was chosen to improve educational practices through iterative needs analysis, design, development and implementation. The study followed design-based research (DBR) approach, with a mixed-method research design used to uncover the critical factors in designing, developing and implementing online collaborative learning activities for improving student interaction. Two iterative cycles of online collaborative learning activities were implemented using the Moodle learning management system for two modules of an engineering undergraduate degree programme at a state university in Sri Lanka.},
	language = {en-GB},
	urldate = {2024-06-30},
	journal = {Asian Association of Open Universities Journal},
	author = {Peramunugamage, Anuradha and Ratnayake, Uditha W. and Karunanayaka, Shironica P. and Jayawardena, Chulantha L.},
	month = jul,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Promotion:FU2a, Lernsystemarchitektur, \#a:Zeitschriftenartikel:online:lernen, Promotion:S:10 Online Lernen, Promotion:Literaturverzeichnis},
	annote = {Analyse des Artikels "Design of Moodle-based Collaborative Learning Activities to Enhance Student Interactions" von Peramunugamage et al. (2024)
1. Analyse
Hauptthemen und -ziele der Forschung: Der Artikel untersucht die Auswirkungen systematisch gestalteter kollaborativer Online-Aktivitäten auf die Interaktionen der Studierenden in zwei ingenieurwissenschaftlichen Modulen. Ziel ist es, Schlüsselüberlegungen für die Gestaltung kollaborativer Lernaktivitäten in Moodle zu identifizieren, um die Interaktionen zwischen Studierenden zu verbessern.
Verwendete Methoden und Datenquellen:


Methodische Ansätze: Design-Based Research (DBR) Ansatz mit einem Mixed-Methods-Design.


Werkzeuge und Datenquellen: Zwei iterativen Zyklen kollaborativer Lernaktivitäten wurden implementiert, die Moodle als Lernmanagementsystem verwendeten. Daten wurden durch Online-Fragebögen, Fokusgruppendiskussionen und Moodle-Log-Aufzeichnungen gesammelt.


Zentrale Forschungsergebnisse:


Erhöhte Motivation: Studierende zeigten eine erhöhte Motivation für kollaborative Aktivitäten und hatten keine wesentlichen Schwierigkeiten beim Zugriff auf Materialien oder Anweisungen.


Verbesserte Interaktionen: Die Gestaltung der Lernaktivitäten hatte einen signifikanten Einfluss auf das Niveau der Interaktion zwischen Lernoberfläche und Lerninhalten.


Effektivität von Wikis: Eine höhere Anzahl von Interaktionen auf der Wiki-Seite verbesserte die Interaktionen zwischen den Lernenden, was auf klare Anweisungen und reduzierte Komplexität im Vergleich zu früheren Moodle-Aktivitäten zurückzuführen war.


2. Zusammenfassung
Kernpunkte des Artikels:


Problemstellung: Untersuchung der Auswirkungen systematisch gestalteter kollaborativer Online-Aktivitäten auf die Interaktionen der Studierenden in Moodle.


Methodik: Design-Based Research Ansatz mit zwei iterativen Zyklen von Lernaktivitäten.


Hauptergebnisse: Erhöhte Motivation und verbesserte Interaktionen zwischen den Studierenden durch klar gestaltete Online-Aktivitäten.


Schlussfolgerungen: Angemessen gestaltete Online-Aktivitäten können die Motivation der Studierenden steigern und die Kommunikation, Zusammenarbeit und das Gemeinschaftsgefühl unter den Studierenden verbessern.


3. Kernaussagen


Erhöhte Motivation: „Students had demonstrated increased motivation for collaborative activities, and they had not experienced any significant difficulties in accessing materials or instructions.“ (S. 1)


Verbesserte Interaktionen: „The design of learning activities has a greater influence on determining the level of interaction between the learner interface and the learner content.“ (S. 1)


Effektivität von Wikis: „A higher number of interactions on the wiki page improved learner-learner interactions, likely due to clear instructions and reduced complexities compared to previous Moodle activities.“ (S. 1)


4. Argumentationslinien


Bedeutung der Gestaltung: Der Artikel argumentiert, dass die Gestaltung der Lernaktivitäten einen wesentlichen Einfluss auf die Interaktionen der Studierenden hat.


Nutzen von Wikis: Es wird betont, dass klar gestaltete Wiki-Aktivitäten die Interaktionen zwischen den Lernenden verbessern können.


Motivation durch Kollaboration: Die Studie zeigt, dass kollaborative Lernaktivitäten die Motivation der Studierenden erhöhen.


5. Verschlagwortung


Lernsystemarchitektur


Begründung: Der Artikel behandelt die Gestaltung von Moodle-basierten kollaborativen Lernaktivitäten, was für die Architektur digitaler Lernsysteme relevant ist.


Fundstelle: S. 1




Kollaboratives Lernen


Begründung: Die Studie untersucht die Auswirkungen kollaborativer Lernaktivitäten auf die Interaktionen der Studierenden.


Fundstelle: S. 1




Lehr- und Lerneffektivität


Begründung: Die Ergebnisse zeigen, dass klar gestaltete kollaborative Aktivitäten die Motivation und Interaktionen der Studierenden verbessern.


Fundstelle: S. 1




6. Kategorisierung


Kategorie: Kerngedanke


Kriterium: Der Artikel liefert zentrale Ideen zur Gestaltung und Wirkung kollaborativer Lernaktivitäten in Moodle.


Beispiel: Diskussion der Bedeutung der Aktivitätsgestaltung für die Interaktionen der Studierenden.




7. Zuordnung zu Forschungsfragen


FU2a: Welchen Effekt erläutern Lernende im digitalen Bildungsraum von Gesundheitsberufen bei der Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems?


Begründung: Der Artikel untersucht die Auswirkungen von Moodle-basierten kollaborativen Aktivitäten auf die Interaktionen und Motivation der Studierenden.


Fundstelle: S. 1




8. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5/5


Der Artikel bietet detaillierte Einblicke in die Gestaltung und Auswirkungen kollaborativer Lernaktivitäten in Moodle, die direkt relevant für die Forschungsfrage sind.




Zitierhäufigkeit und Einfluss des Artikels: 4/5


Die Studie ist aufgrund ihres systematischen Ansatzes und der relevanten Ergebnisse wahrscheinlich einflussreich in akademischen Kreisen.




Aktualität des Artikels: 5/5


Veröffentlicht im Jahr 2024, ist der Artikel hochaktuell und bezieht sich auf die neuesten Entwicklungen in kollaborativen Lernaktivitäten.




Gesamtbewertung: 5/5
Diese Analyse zeigt die hohe Relevanz des Artikels für die Untersuchung der Gestaltung und Wirkung kollaborativer Lernaktivitäten in Moodle und bietet wertvolle Einblicke für zukünftige Forschungen und Praktiken.
},
	file = {Peramunugamage et al. - 2024 - Design of Moodle-based collaborative learning acti.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/6SVN56PZ/Peramunugamage et al. - 2024 - Design of Moodle-based collaborative learning acti.pdf:application/pdf},
}

