  annotation = {http://web.archive.org/web/20200422112322/https://www.tandfonline.com/doi/abs/10.1207/S15326985EP3801\_2},
  file = {/Users/jochen_hanisch-johannsen/Zotero/storage/JWSGN3PZ/van_merrienboer_et_al_2003_taking_the_load_off_a_learner's_mind.pdf}
