@article{feigl_elisabeth_homo_2022,
	title = {Homo {Hapticus} ade? {Ein} {Nachdenken} über die {Bedeutung} von {Haptik}, {Körperlichkeit} und {Wahrnehmung} in {Zeiten} zunehmend digitalisierten {Lernens} und {Lehrens}},
	copyright = {Creative Commons Namensnennung 4.0 International},
	shorttitle = {Homo {Hapticus} ade?},
	url = {https://www.pedocs.de/frontdoor.php?source_opus=24484},
	doi = {10/gp5j97},
	abstract = {Before the COVID-19 pandemic, teaching and learning were primarily analog. Educational offerings were designed as diverse combinations of knowledge transfer, physical activities and social cooperation. The learner's body and its sensory perceptions in a social setting played a central role. In the online space, however, there is a danger of "disembodiment" because of a loss of physical proximity and direct social contact. Furthermore, sensory impressions are often missing from the learning process. Haptics especially is easily lost during online learning because pressing buttons, clicking a mouse and swiping a screen do not replace the experience of feeling a (learning) object in one's hands. This article examines the role that physicality and sensory perception - especially haptics - play in the learning process. It concludes by reflecting on how to better reach people as physical beings in online education.  (DIPF/Orig.)},
	language = {de-DE},
	urldate = {2022-05-14},
	publisher = {Bundesministerium für Bildung, Wissenschaft und Forschung},
	author = {Feigl, Elisabeth},
	month = may,
	year = {2022},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:FU4a, Promotion:Argumentation, Bildung, Digitale Bildung, Digitalisierung, Digitalization, Krisenreaktion im Bildungsbereich, Virtual learning, On line, Online, Learning process, Lernprozess, Adult training, Erwachsenenbildung, \#9:Zeitschriftenartikel:digital:lernen, Wissensvermittlung, Corporeality, Haptik, Körperlichkeit, Leib, Sinneseindruck, Promotion:S:09 Digital Lernen, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	annote = {Argumentationsgrundlage für das Erleben und Empfinden der digitalen Welt
},
	file = {Feigl, Elisabeth - 2022 - Homo Hapticus ade Ein Nachdenken über die Bedeutu.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/LKABBVCF/Feigl, Elisabeth - 2022 - Homo Hapticus ade Ein Nachdenken über die Bedeutu.pdf:application/pdf},
}

@article{mayer_einstellungen_2023,
	title = {Einstellungen von {Lehrpersonen} zu digitalen {Medien} und die effektive {Nutzung} einer {Suchmaschine} ({KANSAS})},
	issn = {2235-0977, 2235-0985},
	url = {https://econtent.hogrefe.com/doi/10.1024/2235-0977/a000396},
	doi = {10/grncx9},
	abstract = {Background: Teachers in the field of basic education and language skills promotion need learning material that is adapted to the heterogeneous needs and interests of learners in terms of both content and language. Digital tools can help to simplify teaching / learning processes. KANSAS is a search engine created to support teachers in researching language learning texts. In the present online evaluation, we investigated the usefulness of the search engine for lesson planning and whether teachers' attitudes toward digital media have an impact on their work outcomes. Method: A total of 27 teachers created lesson plans based on a text researched with KANSAS, which were then evaluated in terms of various quality criteria. Multiple hierarchical regression analyses were used to examine the extent to which attitudes toward digital media influence the quality of the lesson plans. Results: The average ratings of lesson designs are in a medium to high range. In terms of attitudes, only the added value of digital media assessed by the teachers is related to one of the evaluation criteria. Discussion: Overall, KANSAS is suitable for text research and lesson planning, but there are also desiderata. The quality of lesson plans is mostly independent of teachers' attitudes towards digital media, but this result could be biased by the selective sample.},
	language = {de-DE},
	urldate = {2023-01-16},
	journal = {Lernen und Lernstörungen},
	author = {Mayer, Nadine and Jambor-Fahlen, Simone and Kholin, Mareike},
	month = jan,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Promotion:Argumentation, \#9:Zeitschriftenartikel:digital:lernen, Promotion:FU1, Promotion:S:09 Digital Lernen, Promotion:Dissertation {\textbar} FU1 {\textgreater} Argumentation, Promotion:Literaturverzeichnis},
	pages = {2235--0977/a000396},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:
Die Studie von Mayer et al. (2023) untersucht die Einstellungen von Lehrpersonen zu digitalen Medien und deren Einfluss auf die Nutzung der Suchmaschine KANSAS zur Unterrichtsplanung im Bereich der Grundbildung und Sprachförderung. Ziel ist es, zu verstehen, inwiefern digitale Tools wie KANSAS hilfreich für die Unterrichtsplanung sind und ob die Einstellungen der Lehrkräfte gegenüber digitalen Medien die Qualität ihrer Unterrichtsentwürfe beeinflussen.
Verwendete Methoden und Datenquellen:


Design: Online-Evaluation


Datenquellen: 27 Lehrkräfte, die Unterrichtsentwürfe auf Basis von KANSAS recherchierten Texten erstellten


Evaluationsmethoden: Multiple hierarchische Regression, Fragebögen zur Erfassung der Einstellungen zu digitalen Medien


Zentrale Forschungsergebnisse:


Nutzung von KANSAS: Die durchschnittlichen Bewertungen der Unterrichtsentwürfe lagen im mittleren bis hohen Bereich.


Einfluss der Einstellungen: Nur der von den Lehrkräften eingeschätzte Mehrwert digitaler Medien hing mit einem der Bewertungskriterien (inhaltliche Passung der Texte) zusammen.


Unabhängigkeit der Arbeitsergebnisse: Die meisten Arbeitsergebnisse waren unabhängig von den Einstellungen zu digitalen Medien, was jedoch durch die selektive Stichprobe verzerrt sein könnte.


Zusammenfassung
Die Studie zeigt, dass KANSAS ein nützliches Werkzeug für die Textrecherche und Unterrichtsplanung ist. Während die Einstellungen der Lehrkräfte zu digitalen Medien größtenteils keinen Einfluss auf die Qualität der Unterrichtsentwürfe hatten, wurde ein Zusammenhang zwischen dem eingeschätzten Mehrwert digitaler Medien und der inhaltlichen Passung der Texte festgestellt. Dies deutet darauf hin, dass positive Einstellungen zu digitalen Medien die Auswahl passender Unterrichtsmaterialien begünstigen können.
Kernaussagen


„Die Materialien zielen darauf ab, dass Lehrkräfte die vielfältigen Ursachen von Motivationsproblemen ihrer Schüler*innen kennen und verstehen lernen.“ (S. 130)


„Der Reflexionsleitfaden soll Lehrkräfte dazu befähigen, sich den individuellen motivationalen Bedarfen in heterogenen Klassenstrukturen in der Praxis anzunähern.“ (S. 132)


„Das informierende Feedback unterstützt das eigene Lernen, indem es Informationen gibt, die die Kompetenzen des Lernenden und das eigenständige Lernen anregen.“ (S. 140)


Argumentationslinien


Nutzung von KANSAS: KANSAS unterstützt die Lehrkräfte effektiv bei der Suche nach geeigneten Sprachlerntexten für den Unterricht. (S. 2)


Einstellungen und Nutzung: Positive Einstellungen zu digitalen Medien begünstigen die Auswahl passender Unterrichtsmaterialien, was die Qualität der Unterrichtsentwürfe verbessern kann. (S. 8)


Unabhängigkeit der Qualität: Die Qualität der Unterrichtsentwürfe ist größtenteils unabhängig von den Einstellungen zu digitalen Medien, was auf die Benutzerfreundlichkeit von KANSAS hinweist. (S. 7)


Verschlagwortung


Lehr- und Lerneffektivität: Untersuchung der Effektivität digitaler Tools zur Unterstützung der Unterrichtsplanung.


Technologieintegration: Nutzung und Bewertung der Suchmaschine KANSAS im Bildungskontext.


Forschungsansätze: Empirische Untersuchung des Zusammenhangs zwischen Einstellungen zu digitalen Medien und der Nutzung digitaler Werkzeuge.


Kategorisierung: Argumentation
Begründung:
Die Arbeit von Mayer et al. (2023) liefert empirische Belege dafür, dass KANSAS ein nützliches Werkzeug für die Unterrichtsplanung ist und zeigt auf, wie Einstellungen zu digitalen Medien die Auswahl von Unterrichtsmaterialien beeinflussen können. Diese Argumentationslinie unterstützt die Forschungsfragen des Exposés, indem sie die praktischen Implikationen der Nutzung digitaler Tools im Bildungswesen beleuchtet.
Kategorie: Argumentation
Zuordnung zur Forschungsfrage
FU1: Welche der Akzeptanz und Nützlichkeit (Bedeutung) beschreiben Akteure im digitalen Bildungsraum von Gesundheitsberufen bei Anwendung eines Learning-Management-Systems?
Begründung:
Die Untersuchung der Einstellungen von Lehrkräften zu digitalen Medien und deren Einfluss auf die Nutzung von KANSAS bietet wertvolle Erkenntnisse darüber, wie Akzeptanz und Nützlichkeit digitaler Tools im Bildungswesen wahrgenommen werden. Diese Erkenntnisse sind besonders relevant für die Bewertung der Akzeptanz und Nützlichkeit von Learning-Management-Systemen im digitalen Bildungsraum von Gesundheitsberufen.
},
	file = {Mayer et al. - 2023 - Einstellungen von Lehrpersonen zu digitalen Medien.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/DIFSCLPU/Mayer et al. - 2023 - Einstellungen von Lehrpersonen zu digitalen Medien.pdf:application/pdf},
}

