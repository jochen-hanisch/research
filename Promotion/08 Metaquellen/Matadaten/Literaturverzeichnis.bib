	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, Promotion:Relevanz:4, \#7:Zeitschriftenartikel:digital:Medien, Promotion:FU6, ⛔ No DOI found, Promotion:S:07 Digitale Medien, Promotion:Literaturverzeichnis},
	pages = {30},
