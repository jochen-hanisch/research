@article{viberg_exploring_2024-1,
	title = {Exploring the nature of peer feedback: {An} epistemic network analysis approach},
	issn = {0266-4909, 1365-2729},
	shorttitle = {Exploring the nature of peer feedback},
	url = {https://onlinelibrary.wiley.com/doi/10.1111/jcal.13035},
	doi = {10.1111/jcal.13035},
	abstract = {Background Study: Peer feedback has been used as an effective instructional strategy to enhance students' learning in higher education.
Objectives: This paper reports on the findings of an explorative study that aimed to increase our understanding of the nature and role of peer feedback in the students' learning process in a computer-supported collaborative learning (CSCL) setting. Exploring what types of feedback are used, and how they relate to each other and are related to academic performance has important implications for students and teachers.
Methods: This study was conducted in the higher education setting. It used a dataset consisting of student peer feedback messages (N = 2444) and grades from 231 students who participated in a large engineering course. Using qualitative methods, peer feedback was coded inductively. Epistemic network analysis (ENA) was used to analyse the relation between peer feedback types and performance.
Results: Based on the five types of peer feedback (i.e., ‘management’, ‘cognition’ ‘affect’, ‘interpersonal factors’ and ‘suggestions for improvements’), the results of the ENA showed that student feedback categories ‘management’, ‘cognition’ and ‘affect’ were positively related to student performance at the formative assessment phase.
Conclusions: The findings and the ENA visualizations also show that ‘suggestions for improvement’ and ‘interpersonal factors’ were not a significant part of student learning in peer assessment and feedback in the studied context.},
	language = {en-GB},
	urldate = {2024-07-13},
	journal = {Journal of Computer Assisted Learning},
	author = {Viberg, Olga and Baars, Martine and Mello, Rafael Ferreira and Weerheim, Niels and Spikol, Daniel and Bogdan, Cristian and Gasevic, Dragan and Paas, Fred},
	month = jul,
	year = {2024},
	keywords = {Feedback, Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Bewertungsmethoden, Promotion:Schlussfolgerung, Promotion:FU2b, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU2b},
	pages = {jcal.13035},
	annote = {Analyse des Artikels „Exploring the Nature of Peer Feedback: An Epistemic Network Analysis Approach“ von Viberg et al. (2024)

1. Analyse
Hauptthemen und Ziele der Forschung


Thema: Analyse der Natur und Wirkung von Peer-Feedback (PF) in einem computer-supported collaborative learning (CSCL)-Setting.


Ziel: Untersuchung der Zusammenhänge zwischen verschiedenen Feedback-Typen und der akademischen Leistung von Studierenden in einer kollaborativen Lernumgebung.


Verwendete Methoden und Datenquellen


Methodik:


Qualitative Inhaltsanalyse: Kodierung von 2.444 Peer-Feedback-Nachrichten aus einem ingenieurwissenschaftlichen Kurs.


Epistemic Network Analysis (ENA): Untersuchung der Korrelation zwischen Feedback-Typen und der studentischen Leistung.


Untersuchung der Feedback-Kategorien:


Management (z. B. Organisation der Zusammenarbeit)


Kognition (z. B. inhaltliche Anmerkungen)


Affekt (z. B. emotionale Unterstützung)


Interpersonelle Faktoren (z. B. soziale Dynamiken)


Verbesserungsvorschläge (z. B. direkte Empfehlungen)






Datenquellen:


231 Studierende eines ingenieurwissenschaftlichen Studiengangs.


Bewertung der Leistungsdaten durch formative und summative Assessments.




Zentrale Forschungsergebnisse


Korrelation zwischen Feedback-Typen und Leistung:


Die Kategorien „Management“, „Kognition“ und „Affekt“ waren positiv mit den Leistungen der Studierenden im formativen Assessment korreliert.


„Interpersonelle Faktoren“ und „Verbesserungsvorschläge“ hatten keinen signifikanten Einfluss auf die Leistung.




Formative vs. summative Bewertung:


Formatives Feedback zeigte einen stärkeren Effekt auf die Leistung als summatives Feedback.


Studierende mit hoher Leistung gaben mehr kognitives und managementbezogenes Feedback als leistungsschwächere Studierende.




Feedback-Qualität beeinflusst die Lernergebnisse:


Detailliertes, kognitiv anspruchsvolles Feedback führte zu besseren Leistungen als allgemeines oder affektives Feedback.





2. Zusammenfassung
Die Studie untersucht, wie verschiedene Typen von Peer-Feedback das Lernen in einer digitalen kollaborativen Umgebung beeinflussen. Basierend auf einer Epistemic Network Analysis (ENA) zeigt sich, dass kognitives und managementbezogenes Feedback die Leistung von Studierenden signifikant verbessern. Interpersonelles Feedback und Verbesserungsvorschläge hingegen hatten keinen direkten Effekt. Die Ergebnisse betonen die Bedeutung einer gezielten Förderung qualitativ hochwertigen Peer-Feedbacks, um kollaboratives Lernen effektiver zu gestalten.

3. Kernaussagen


Kognitives und organisatorisches Feedback fördert den Lernerfolg – Studierende, die detailliertes Feedback zu Inhalt und Struktur gaben, erzielten bessere Leistungen (S. 6).


Formatives Feedback ist wirksamer als summatives Feedback – Korrekturen und Kommentare während des Lernprozesses hatten eine stärkere Wirkung auf die Leistung als abschließende Bewertungen (S. 7).


Affektives und interpersonelles Feedback haben nur begrenzten Einfluss – Während soziale Unterstützung geschätzt wird, hat sie keinen signifikanten Effekt auf die akademische Leistung (S. 8).



4. Argumentationslinien


Theorie: Bezug auf die Epistemic Network Analysis (ENA) zur Untersuchung der Korrelationen zwischen Peer-Feedback-Typen und Leistung (S. 5).


Empirische Evidenz: Die Analyse von 2.444 Feedback-Nachrichten zeigt, dass kognitiv anspruchsvolles Feedback leistungsfördernd wirkt (S. 7).


Praktische Relevanz: Empfehlung zur Förderung strukturierter Peer-Feedback-Prozesse zur Verbesserung kollaborativen Lernens (S. 9).



5. Verschlagwortung


Kollaboratives Lernen: Untersuchung der Interaktionen zwischen Studierenden in einer computerunterstützten Lernumgebung.


Bewertungsmethoden: Analyse der Wirksamkeit von formativen und summativen Peer-Feedback-Prozessen.


Lehr- und Lerneffektivität: Untersuchung der Auswirkungen verschiedener Feedback-Typen auf die akademische Leistung.



6. Kategorisierung
Kategorie: Schlussfolgerung


Begründung: Die Studie zieht aus einer datenbasierten Analyse klare Schlussfolgerungen zur Bedeutung verschiedener Feedback-Typen für den Lernerfolg (S. 10).



7. Zuordnung zu Forschungsfragen
Passendste Forschungsunterfrage: FU2b: „Welche Effekt-Faktoren erläutern Lehrende im digitalen Bildungsraum von Gesundheitsberufen bei der Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems?“


Begründung: Die Studie untersucht, wie Peer-Feedback als didaktisches Instrument in digitalen Lernplattformen zur Verbesserung der Lernleistung genutzt werden kann (S. 8).



8. Relevanzbewertung


Direkte Relevanz: 5 (Bietet wertvolle Erkenntnisse zur Strukturierung von Feedback-Prozessen in digitalen Lernumgebungen).


Aktualität: 5 (Veröffentlichung 2024, hochaktuell).


Zitierhäufigkeit: 4 (Wichtige Erkenntnisse, aber spezifisch auf kollaborative Lernformate begrenzt).


Gesamtbewertung: 5

Soll ich spezifische Aspekte wie die methodische Umsetzung der Epistemic Network Analysis oder die qualitativen Erkenntnisse weiter vertiefen?
},
	file = {Viberg et al. - 2024 - Exploring the nature of peer feedback An epistemi.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/T9FZ5CSU/Viberg et al. - 2024 - Exploring the nature of peer feedback An epistemi.pdf:application/pdf},
}

@article{darici_are_2023,
	title = {Are stereotypes in decline? {The} portrayal of female anatomy in e‐learning},
	volume = {16},
	issn = {1935-9772, 1935-9780},
	shorttitle = {Are stereotypes in decline?},
	url = {https://anatomypubs.onlinelibrary.wiley.com/doi/10.1002/ase.2211},
	doi = {10.1002/ase.2211},
	abstract = {Sex and gender bias in anatomy learning materials are considered a “hidden obstacle” to gender equity in medical curricula. The purpose of this study was to investigate whether quantitative sex and gender biases do exist in popular anatomy e-­learning platforms and compare the results with those found in contemporary textbooks and atlases. A systematic content-­analysis was performed on N = 3767 images published from 2008 to 2021 in which sex/gender could be identified by considering technical aspects of illustration and various intersectional categories. E-­learning platforms took into account an appropriate representation of the female body and presented even more females (n = 932/1412; 66\%), more frequently from a ventral/anterior (χ2 = 26, P {\textless} 0.001) and whole-­body perspective (χ2 = 27, P {\textless} 0.001). This was in contrast to German anatomy books, where the results pointed to a significant sex and gender bias. For example, all books assessed underrepresented females (n = 707/2355; 30\%) and placed them in stereotypical sex-­specific context (χ2 = 348, P {\textless} 0.001), showing them more often from a caudal/inferior (χ2 = 99, P {\textless} 0.001) and internal (χ2 = 132, P {\textless} 0.001) perspective. Altogether, the visual representation of sex and gender in anatomical curricula is still biased and the stereotypical perceptions of human anatomy seem to be a global issue. However, the increasing use of electronic learning platforms, which gradually replace traditional books is changing the way the male and female body is depicted, which might offer new opportunities for reducing stereotypes in anatomy education.},
	language = {en-GB},
	number = {4},
	urldate = {2024-03-09},
	journal = {Anatomical Sciences Education},
	author = {Darici, Dogus and Schneider, Agnes Yüeh‐Dan and Missler, Markus and Pfleiderer, Bettina},
	month = jul,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:FU4a, Technologieintegration, Promotion:Relevanz:4, Promotion:Weiterführung, Außergewöhnlich 🟣, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {720--732},
	file = {Darici et al. - 2023 - Are stereotypes in decline The portrayal of femal.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/G86LAMHW/Darici et al. - 2023 - Are stereotypes in decline The portrayal of femal.pdf:application/pdf},
}

@article{taghizade_integrating_2023,
	title = {Integrating {Community} of {Inquiry} {Framework} {Principles} {With} {Flipped} {Classroom} {Pedagogy} to {Enhance} {Students}’ {Perceived} {Presence} {Sense}, {Self}-{Regulated} {Learning}, and {Learning} {Performance} in {Preservice} {Teacher} {Education}},
	volume = {24},
	issn = {1492-3831},
	url = {https://www.irrodl.org/index.php/irrodl/article/view/7005},
	doi = {10.19173/irrodl.v24i4.7005},
	abstract = {The purpose of this study was to assess the effectiveness of integrating community of inquiry (COI) framework principles with flipped classroom pedagogy to enhance students’ perceived presence sense, selfregulated learning, and learning performance. A quasi-experimental study was conducted to examine whether integrating COI framework principles with flipped classrooms could enhance college students’ perceived presence sense, self-regulated learning, and learning performance. The participants were 64 third-year male college students in an online course at a teacher education university in Iran in 2021. The study employed the COI Survey, the online self-regulated learning questionnaire (OLSQ), and a teachermade test to measure learning performance. The results indicated significant between-group differences in perceived presence sense, self-regulated learning, and learning performance (p {\textless} 0.001). Integrating COI framework principles with flipped classroom pedagogy was an effective approach to enhancing perceived presence sense, self-regulated learning, and learning performance among teacher education students.},
	language = {en-GB},
	number = {4},
	urldate = {2023-12-09},
	journal = {The International Review of Research in Open and Distributed Learning},
	author = {Taghizade, Abbas and Azimi, Esmaeil and Mahmoodian, Hassan and Akhash, Salman},
	month = dec,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Promotion:FU2a, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {154--173},
	annote = {Analyse des Artikels „Integrating Community of Inquiry Framework Principles With Flipped Classroom Pedagogy to Enhance Students’ Perceived Presence Sense, Self-Regulated Learning, and Learning Performance in Preservice Teacher Education“ von Taghizade et al. (2023)

1. Analyse
Hauptthemen und Ziele der Forschung


Thema: Integration des Community of Inquiry (COI) Frameworks mit der Flipped Classroom-Pädagogik, um die Selbstregulation, soziale Präsenz und Lernleistung von Studierenden im Lehramtsstudium zu verbessern.


Ziel: Untersuchung, ob die Kombination von COI-Prinzipien mit dem Flipped Classroom die Lernleistung und die selbstregulierten Lernstrategien der Studierenden positiv beeinflusst.


Verwendete Methoden und Datenquellen


Methodik:


Quasi-experimentelle Studie mit einer Kontroll- und einer Experimentalgruppe.


64 Lehramtsstudierende in einem Online-Kurs einer Universität in Iran.


Interventionsgruppe: Flipped Classroom-Modell mit COI-Integration.


Kontrollgruppe: Konventionelles Flipped Classroom-Modell.


Datenerhebung:


COI-Survey zur Messung von kognitiver, sozialer und Lehrpräsenz.


Online Self-Regulated Learning Questionnaire (OSLQ) zur Erfassung von Selbstregulationsstrategien.


Leistungstest zur Messung der akademischen Leistung.




Datenanalyse: Multivariate Varianzanalysen (MANCOVA, ANCOVA) zur Untersuchung von Gruppenunterschieden.




Zentrale Forschungsergebnisse


Höhere Werte für Lehr-, soziale und kognitive Präsenz in der COI-Gruppe:


Lehrpräsenz: +35,3 \% höher als in der Kontrollgruppe.


Soziale Präsenz: +25,1 \% Verbesserung gegenüber der konventionellen Methode.


Kognitive Präsenz: +24,9 \% Zuwachs (S. 161).




Bessere Selbstregulierte Lernfähigkeiten in der COI-Gruppe:


85,15 Punkte vs. 73,45 Punkte in der Kontrollgruppe (p {\textless} 0.05) (S. 162).




Signifikante Verbesserung der Lernleistung:


Post-Test-Werte der COI-Gruppe: 17,3 vs. 15,96 in der Kontrollgruppe (p {\textless} 0.05) (S. 163).




Bessere Interaktion und Kollaboration durch COI:


Studierende gaben an, dass sie sich stärker in Diskussionen einbrachten und der soziale Austausch gefördert wurde.





2. Zusammenfassung
Diese Studie untersucht, wie das Community of Inquiry (COI) Framework mit dem Flipped Classroom kombiniert werden kann, um die Lernleistung und Selbstregulation von Studierenden zu verbessern. Die Ergebnisse zeigen, dass Lehr-, soziale und kognitive Präsenz in der COI-Gruppe signifikant höher waren. Die Studierenden entwickelten bessere Selbstregulationsstrategien, und ihre Lernleistung war signifikant verbessert. Das COI-Modell ermöglichte zudem eine stärkere soziale Interaktion, was die kollaborative Wissenskonstruktion förderte.

3. Kernaussagen


COI steigert die Selbstregulation: Studierende der COI-Gruppe entwickelten bessere Lernstrategien (S. 162).


Verbesserte soziale Interaktion: Durch COI hatten Studierende mehr Gelegenheiten zur Interaktion und Reflexion (S. 160).


Höhere Lernleistung durch COI: Die Kombination aus Flipped Classroom und COI führte zu besseren akademischen Ergebnissen (S. 163).



4. Argumentationslinien


Theorie: Bezugnahme auf das Community of Inquiry Framework (Garrison et al., 2001) zur Förderung von Online-Kollaboration (S. 159).


Empirische Evidenz: Signifikante Verbesserungen in den COI-Skalen, Selbstregulation und Lernleistung (S. 161–163).


Praktische Relevanz: Empfehlung für die Integration von COI-Prinzipien in digitale Lernplattformen, um Reflexion und Interaktion zu fördern (S. 165).



5. Verschlagwortung


Kollaboratives Lernen: COI fördert die soziale, kognitive und Lehrpräsenz.


Lehr- und Lerneffektivität: Kombination von Flipped Classroom und COI verbessert die Selbstregulation und Lernleistung.


Lernsystemarchitektur: Entwicklung eines hybriden didaktischen Designs zur Optimierung digitaler Lehrformate.



6. Kategorisierung
Kategorie: Kerngedanke


Begründung: Die Studie zeigt, dass die Integration von COI und Flipped Classroom ein innovativer Ansatzzur Optimierung digitaler Lernprozesse ist (S. 164).



7. Zuordnung zu Forschungsfragen
Passendste Forschungsunterfrage: FU2a: „Welchen Effekt erläutern Lernende im digitalen Bildungsraum von Gesundheitsberufen bei der Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems?“


Begründung: Die Studie untersucht, wie ein konstruktivistisches Modell (COI) die Selbstregulation und soziale Interaktion von Lernenden verbessert (S. 163).



8. Relevanzbewertung


Direkte Relevanz: 5 (Hochrelevante Studie zur Optimierung von Learning-Management-Systemen mit COI).


Aktualität: 5 (Veröffentlichung 2023, hochaktuell).


Zitierhäufigkeit: 4 (Starke theoretische Fundierung, spezifisch für Lehramtsstudiengänge, aber übertragbar).


Gesamtbewertung: 5
},
	file = {Taghizade et al. - 2023 - Integrating Community of Inquiry Framework Princip.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/JCAPYPC8/Taghizade et al. - 2023 - Integrating Community of Inquiry Framework Princip.pdf:application/pdf;Taghizade et al. - 2023 - Integrating Community of Inquiry Framework Princip.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/VGR7SXFC/Taghizade et al. - 2023 - Integrating Community of Inquiry Framework Princip.pdf:application/pdf},
}

@article{naamati-schneider_enhancing_2023,
	title = {Enhancing collaborative learning in health management education: an investigation of {Padlet}-mediated interventions and the influence of flexible thinking},
	volume = {23},
	issn = {1472-6920},
	shorttitle = {Enhancing collaborative learning in health management education},
	url = {https://bmcmededuc.biomedcentral.com/articles/10.1186/s12909-023-04796-y},
	doi = {10/gs5658},
	abstract = {This study had three primary goals. First, it aimed to craft an intervention program centered around collaborative learning enabled by Padlet. Second, it aimed to gauge the perceptions of health management students regard‑ing this intervention and how it affected their collaborative learning experiences. Additionally, the third objective of the study aimed to investigate how students’ flexible thinking within the learning process might shape their perceptions of the advantages derived from this instructional activity within the domain of online collaborative learning. Data for the analysis were gathered from 100 Israeli undergraduate students by two measurements: Flexible thinking in learning and Student perceptions of collaborative learning via Padlet. The intervention program included several stages. First, the students discussed the pedagogic objective of using Padlet. In the second stage, the students were presented with ill-structured problems related to the course content. Each group had to choose one prob‑lem and analyze it from three perspectives discussed in the course—healthcare provider, patient, and organization. Next, the students presented and explained their solutions employing the shared knowledge base. The final work was presented in different formats using various technologies. The PLS-SEM analysis has corroborated our hypoth‑esis that students’ flexible thinking might positively contribute to their perception of Padlet utilization. According to the empirical model, in general, students who perceived themselves as more flexible were found more receptive to utilizing the proposed technological tool (Padlet) and hence tended to appreciate its function as a collaborative learning platform enabler. This study mainly underscores the important role flexible thinking plays in motivating man‑agers and medical professionals to embrace innovative technologies or methods for teamwork, that could enable them to weigh arguments, seek alternative solutions to authentic problems, and adjust their approaches effectively and collaboratively as new challenges emerge.},
	language = {en-GB},
	number = {1},
	urldate = {2023-11-18},
	journal = {BMC Medical Education},
	author = {Naamati-Schneider, Lior and Alt, Dorit},
	month = nov,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Promotion:FU2a, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU2a},
	pages = {846},
	annote = {Analyse des Artikels „Enhancing collaborative learning in health management education: an investigation of Padlet-mediated interventions and the influence of flexible thinking“ von Naamati-Schneider und Alt (2023)

1. Analyse
Hauptthemen und Ziele der Forschung


Thema: Untersuchung der Effektivität von Padlet-gestütztem kollaborativem Lernen im Bereich des Gesundheitsmanagements.


Ziel: Analyse, wie flexibles Denken die Wahrnehmung von Studierenden hinsichtlich der Nutzung digitaler Plattformen wie Padlet beeinflusst und welche Auswirkungen dies auf kollaborative Lernprozesse hat.


Verwendete Methoden und Datenquellen


Methodik:


Entwicklung eines Interventionsprogramms mit Padlet zur Förderung von Online-Kollaboration.


Zwei Messungen bei 100 Studierenden:


Flexible Thinking in Learning (FTL) – Bewertung der Fähigkeit, sich an neue Lernmethoden anzupassen.


Student Perceptions of Collaborative Learning via Padlet (SPCLP) – Wahrnehmung der Studierenden zu kollaborativen Lernprozessen.




Einsatz eines PLS-SEM Modells (Partial Least Squares Structural Equation Modeling) zur Analyse der Daten.




Datenquellen:


Studierende eines Gesundheitsmanagement-Studiengangs (58 \% im zweiten Jahr, 42 \% im dritten Jahr).


Bewertung von Gruppenprojekten, die mit Padlet durchgeführt wurden.




Zentrale Forschungsergebnisse


Flexibles Denken beeinflusst die Wahrnehmung kollaborativen Lernens: Studierende, die sich als flexibel wahrnehmen, schätzen Padlet stärker als effektives Werkzeug für kollaboratives Lernen.


Positiver Effekt von Padlet auf kollaboratives Lernen: Die Studierenden berichteten von höherer Motivation, besserer Organisation und gesteigerter Interaktion mit Peers.


Technologieakzeptanz als Schlüsselfaktor: Studierende mit hoher Akzeptanz neuer Technologien profitieren stärker von digitalen Kollaborationsplattformen.



2. Zusammenfassung
Die Studie untersucht den Einsatz von Padlet als Plattform für kollaboratives Lernen in der Gesundheitsmanagement-Ausbildung. Flexibles Denken wurde als Schlüsselfaktor identifiziert, der die Wahrnehmung und Akzeptanz von Padlet beeinflusst. Die Ergebnisse zeigen, dass Studierende mit hoher kognitiver Anpassungsfähigkeit stärker von Padlet profitieren, da sie die Plattform effektiver für die Interaktion und den Wissensaustausch nutzen. Die Studie betont die Bedeutung digitaler Werkzeuge für die Förderung von Teamarbeit und Problemlösungskompetenzen.

3. Kernaussagen


Flexibles Denken fördert kollaborative Lernprozesse: Studierende mit hoher kognitiver Flexibilität nutzen Padlet effektiver (S. 6).


Technologieakzeptanz korreliert mit Lernerfolg: Studierende, die neue Technologien positiv bewerten, profitieren stärker von Padlet-gestütztem Lernen (S. 8).


Digitale Plattformen steigern die Interaktion: Der Austausch von Wissen in Gruppen wurde durch Padlet verbessert (S. 10).



4. Argumentationslinien


Theorie: Bezugnahme auf Flexible Thinking Theory (Spiro \& Jehng, 1990) zur Erklärung der Adaptivität in digitalen Lernumgebungen (S. 5).


Empirische Evidenz: Die statistische Analyse zeigt signifikante Korrelationen zwischen flexiblem Denken und der wahrgenommenen Effektivität von Padlet (S. 9).


Praktische Relevanz: Empfehlungen zur Förderung kollaborativen Lernens durch digitale Plattformen (S. 12).



5. Verschlagwortung


Kollaboratives Lernen: Untersuchung der Nutzung von Padlet zur Verbesserung kollaborativer Lernprozesse.


Lehr- und Lerneffektivität: Bewertung der Effizienz von digitalen Tools für Teamarbeit und Wissensaustausch.


Technologieintegration: Analyse der Implementierung von Padlet in gesundheitswissenschaftlichen Studiengängen.



6. Kategorisierung
Kategorie: Kerngedanke


Begründung: Die Studie hebt hervor, dass flexibles Denken eine zentrale Rolle bei der Nutzung digitaler Plattformen spielt und somit für das Verständnis kollaborativen Lernens essenziell ist (S. 11).



7. Zuordnung zu Forschungsfragen
Passendste Forschungsunterfrage: FU2a: „Welchen Effekt erläutern Lernende im digitalen Bildungsraum von Gesundheitsberufen bei der Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems?“


Begründung: Die Studie untersucht, wie Studierende kollaborative Lernplattformen wahrnehmen und welche Faktoren ihre Nutzung beeinflussen (S. 9–10).



8. Relevanzbewertung


Direkte Relevanz: 5 (Hoch relevante Untersuchung zu kollaborativem Lernen und Technologieakzeptanz).


Aktualität: 5 (Veröffentlichung 2023, hochaktuell).


Zitierhäufigkeit: 4 (Relevanter Beitrag zur digitalen Bildung, jedoch spezifisch auf Padlet begrenzt).


Gesamtbewertung: 5

},
