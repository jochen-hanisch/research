@article{autenrieth_lehren_2020,
	title = {Lehren und {Lernen} mit und über {Medien} in {Kooperation} von {Schule}, {Hochschule} und {Museen}: {Am} {Beispiel} des {Projekts} ‹{Reuchlin} digital›},
	issn = {1424-3636, 1424-3636},
	shorttitle = {Lehren und {Lernen} mit und über {Medien} in {Kooperation} von {Schule}, {Hochschule} und {Museen}},
	url = {10.21240/mpaed/jb17/2020.05.21.X},
	doi = {10/gksnzz},
	abstract = {This article introduces the development project ‘Reuchlin digital’ (RD). The project aims for the further development of ‘Museum Johannes Reuchlin’ (MJR) in the southern German town of Pforzheim. MJR is a museum dedicated to the humanist Johannes Reuchlin who lived during the time of the invention of printing. Johannes Reuchlin advocated tolerance and stood for the exploration of the unknown. These principles are guiding project development. RD works at the intersection of cultural education (in both school and extracurricular activities), media education and teacher training. The project is related to practice but includes evaluative elements leveraging both qualitative and quantitative methods. The article aims to outline theoretical and conceptual aspects of RD and conveys important preliminary results. RD resides at the Pforzheim cultural office and is funded by the city itself, the Baden-Wuerttemberg innovation fund, the ‘Arbeitsstelle literatische Museen BW’ and cooperates with different institutions (University of Education Ludwigsburg, Medien- und Filmgesellschaft BW and a number of schools). One of the main project goals is the exploration of new and action-oriented learning paths guided by creative, critical and reflexive methods of media production for the museum as an extracurricular learning environment. Visual, auditory and audio-visual expressions are playing a key role in this cultural, aesthetic and media related appropriation of the museal space.},
	language = {de-DE},
	urldate = {2021-06-20},
	journal = {MedienPädagogik: Zeitschrift für Theorie und Praxis der Medienbildung},
	author = {Autenrieth, Daniel and Baumbusch, Claudia and Marquardt, Anja},
	month = aug,
	year = {2020},
	keywords = {Promotion:Literaturanalyse, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Bildungstheorien, Promotion:FU3, \#9:Zeitschriftenartikel:digital:lernen, Promotion:S:09 Digital Lernen, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {531--563},
	annote = {1. Analyse
Identifizierung und Beschreibung der Hauptthemen und -ziele der Forschung
Hauptthemen:


Lehren und Lernen mit und über Medien in Kooperation von Schule, Hochschule und Museen


Das Projekt „Reuchlin digital“ als praxisbezogenes Entwicklungsprojekt


Integration kultureller Bildung, Medienpädagogik und Lehramtsausbildung


Hauptziele:


Förderung der aktiv-produktiven, kreativen und kritisch-reflexiven Nutzung digitaler Medien in schulischen und außerschulischen Kontexten


Entwicklung und Erprobung neuer Lernwege durch die Kooperation verschiedener Institutionen


Vermittlung visueller, auditiver und audiovisueller Ausdrucksformen zur Bereicherung des Lernens


Erkennung der verwendeten Methoden und Datenquellen
Methoden:


Literatur- und Diskursanalyse


Empirische Evaluation durch qualitative und quantitative Methoden


Praxisbezogene Umsetzung und iterative Entwicklung von Lernformaten


Datenquellen:


Theoretische Konzepte und Modelle aus der Medienpädagogik, kulturellen Bildung und Lehramtsausbildung


Erfahrungsberichte und empirische Daten aus dem Projekt „Reuchlin digital“


Erklärung der zentralen Forschungsergebnisse
Zentrale Ergebnisse:


Digitale Medien und die Kooperation von Schule, Hochschule und Museen bieten neue Möglichkeiten für kulturelle und medienpädagogische Bildung.


Das Projekt „Reuchlin digital“ zeigt, dass interdisziplinäre Kooperation und die Nutzung digitaler Medien zu innovativen Lernformaten führen können.


Die Vermittlung visueller, auditiver und audiovisueller Ausdrucksformen erweitert die Bildungsangebote und fördert die kritische Auseinandersetzung mit Medien.


2. Zusammenfassung
Problemstellung: Wie können digitale Medien in der Zusammenarbeit von Schule, Hochschule und Museen genutzt werden, um neue Lernwege zu eröffnen und kulturelle Bildung zu fördern?
Methodik: Literatur- und Diskursanalyse, empirische Evaluation und praxisbezogene Umsetzung im Projekt „Reuchlin digital“.
Hauptergebnisse:


Digitale Medien und interdisziplinäre Kooperationen ermöglichen innovative Lernformate.


Visuelle, auditive und audiovisuelle Ausdrucksformen bereichern die Bildungsangebote.


Das Projekt „Reuchlin digital“ zeigt erfolgreiche Ansätze zur Integration von Medienpädagogik und kultureller Bildung.


Schlussfolgerungen: Die Nutzung digitaler Medien in der Zusammenarbeit von Schule, Hochschule und Museen bietet vielfältige Möglichkeiten zur Förderung kultureller und medienpädagogischer Bildung. Projekte wie „Reuchlin digital“ können als Modell für weitere Entwicklungen dienen.
3. Kernaussagen
Wichtige Aussagen und Befunde:


Neue Lernwege durch digitale Medien: Das Projekt „Reuchlin digital“ zeigt, wie digitale Medien neue und innovative Lernwege eröffnen können (S. 532).


Kooperation als Erfolgsfaktor: Die Zusammenarbeit von Schule, Hochschule und Museen ist entscheidend für die erfolgreiche Umsetzung und Entwicklung neuer Bildungsformate (S. 533).


Förderung von Medienkompetenz: Die Nutzung und Vermittlung visueller, auditiver und audiovisueller Ausdrucksformen trägt wesentlich zur Förderung der Medienkompetenz bei (S. 540).


4. Argumentationslinien
Aufbau der Argumente:


Einführung: Darstellung der Bedeutung digitaler Medien und der interdisziplinären Kooperation im Bildungsbereich (S. 531-532).


Hauptteil: Analyse der theoretischen und konzeptionellen Überlegungen des Projekts „Reuchlin digital“ und Präsentation der praktischen Umsetzung und Zwischenergebnisse (S. 533-540).


Schluss: Diskussion der Potenziale und Herausforderungen digitaler Medien in der kulturellen Bildung und Empfehlungen für die Praxis (S. 541-542).


5. Verschlagwortung


Lehr- und Lerneffektivität: Begründung: Der Artikel untersucht, wie digitale Medien und interdisziplinäre Kooperationen die Effektivität von Lehr- und Lernprozessen verbessern können.


Technologieintegration: Begründung: Der Artikel behandelt die Integration digitaler Medien in Bildungsprojekte und die damit verbundenen technischen und didaktischen Herausforderungen.


Bildungstheorien: Begründung: Der Artikel diskutiert theoretische Konzepte aus der Medienpädagogik und kulturellen Bildung im Kontext digitaler Medien.


Kollaboratives Lernen: Begründung: Der Artikel thematisiert, wie durch die Kooperation von Schule, Hochschule und Museen kollaborative Lernprozesse gefördert werden können.


6. Kategorisiere
Kategorie: Kerngedanke
Kriterium: Zentrale Ideen oder Hypothesen, die den grundlegenden Forschungsansatz oder die theoretische Ausrichtung definieren.
Beispiel: Der Artikel argumentiert, dass die interdisziplinäre Zusammenarbeit und die Nutzung digitaler Medien neue und effektive Lernwege eröffnen können, und stützt diese These durch das Projekt „Reuchlin digital“.
7. Zuordnung zu Forschungsfragen
Passende Forschungsfrage: FU3: Wie sind Konzeption und relevante didaktische und bildungstechnologische Merkmale des systemisch-konstruktivistischen Learning-Management-Systems für Akteure im digitalen Bildungsraum von Gesundheitsberufen dargestellt?
Begründung: Der Artikel untersucht die didaktische und technologische Gestaltung digitaler Lernformate und die interdisziplinäre Kooperation zur Förderung des Lernens, was auf die Frage nach den didaktischen und bildungstechnologischen Merkmalen von Learning-Management-Systemen zutrifft.
},
	file = {Autenrieth et al. - 2020 - Lehren und Lernen mit und über Medien in Kooperati.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/WHTSTQ95/Autenrieth et al. - 2020 - Lehren und Lernen mit und über Medien in Kooperati.pdf:application/pdf},
}

@article{gold_wir_2020,
	title = {„{Wir} mussten uns erst einmal eingrooven.“},
	volume = {Vol. 2 No. 6},
	copyright = {Creative Commons Attribution Share Alike 4.0 International},
	url = {https://www.pflb-journal.de/index.php/pflb/article/view/3939},
	doi = {10/ghzqbt},
	abstract = {Die Ausbreitung der COVID-19-Pandemie hat in Nordrhein-Westfalen am 16.03.2020 zu allgemeinen Schulschließungen geführt. Von einem Tag auf den nächsten waren die Lehrkräfte gefordert, ihre Kommunikation mit den Schüler*innen und ihre Lernunterstützung auf Distanz auszuüben. Die Eltern sahen sich gleichzeitig vor der Herausforderung, ihre Kinder ganztägig zu Hause zu betreuen und beim Lernen zu unterstützen. Die Begriffe Distance Learning und Homeschooling fanden schnell Einzug in den allgemeinen Sprachgebrauch. In diesem Beitrag werden Ergebnisse einer qualitativen Befragung vorgestellt, in der rund drei Wochen nach den Schulschließungen sowohl Eltern als auch Lehrkräfte einer Schule zu ihren Erfahrungen mit den verschiedenen Aufgaben der ersten Wochen befragt wurden. Ein Fokus wurde dabei auf den Einsatz von digitalen Medien und Konzepten als Instrumenten von Kommunikation und Lernunterstützung auf Distanz gelegt. Beleuchtet wird, welche Aspekte der vielschichtigen Herausforderungen von den beiden Akteursgruppen Eltern und Lehrkräfte thematisiert werden und wie der eigene Umgang mit diesen Herausforderungen dargestellt wird.},
	language = {de-DE},
	urldate = {2021-02-06},
	journal = {PraxisForschungLehrer*innenBildung. Zeitschrift für Schul- und Professionsentwicklung.},
	publisher = {PraxisForschungLehrer*innenBildung. Zeitschrift für Schul- und Professionsentwicklung.},
	author = {Gold, Johanna and Kaiser, Sabine and Hartmann, Ulrich and Wittbrock, Albert},
	month = dec,
	year = {2020},
	note = {Artwork Size: 123-138},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Bildungstheorien, Promotion:Argumentation, Krisenreaktion im Bildungsbereich, \#9:Zeitschriftenartikel:digital:lernen, Promotion:FU1, Promotion:S:09 Digital Lernen, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Dissertation {\textbar} FU1 {\textgreater} Argumentation, Promotion:Literaturverzeichnis},
	pages = {123--138},
	annote = {1. Analyse
Identifizierung und Beschreibung der Hauptthemen und -ziele der Forschung
Hauptthemen:


Distance Learning und Homeschooling während der COVID-19-Pandemie


Perspektiven von Eltern und Lehrkräften


Herausforderungen und Lösungen bei der Implementierung digitaler Lernmethoden


Hauptziele:


Untersuchung der Erfahrungen von Eltern und Lehrkräften mit Distance Learning und Homeschooling


Analyse der eingesetzten digitalen Medien und Konzepte zur Lernunterstützung


Aufzeigen von Herausforderungen und Erfolgsfaktoren beim Umgang mit Distance Learning und Homeschooling


Erkennung der verwendeten Methoden und Datenquellen
Methoden:


Qualitative Befragung von Eltern und Lehrkräften


Leitfadengestützte Online-Befragungen


Qualitative Inhaltsanalyse zur Auswertung der Antworten


Datenquellen:


Eltern und Lehrkräfte der Laborschule Bielefeld


Theoretische Konzepte zu Distance Learning und Homeschooling


Erfahrungsberichte und empirische Daten aus den Befragungen


Erklärung der zentralen Forschungsergebnisse
Zentrale Ergebnisse:


Eltern und Lehrkräfte mussten sich erst an die neue Situation des Distance Learnings gewöhnen und Anpassungsstrategien entwickeln.


Digitale Medien und Kommunikationsplattformen spielten eine zentrale Rolle bei der Aufrechterhaltung der Bildungsprozesse.


Es gab Unterschiede in der Umsetzung und Akzeptanz der digitalen Lernangebote, abhängig von den technischen Voraussetzungen und der Medienkompetenz der Beteiligten.


Die Pflege pädagogischer Beziehungen war auch im digitalen Raum von großer Bedeutung und stellte eine Herausforderung dar.


2. Zusammenfassung
Problemstellung: Wie haben Eltern und Lehrkräfte das Distance Learning und Homeschooling während der COVID-19-Pandemie erlebt und welche digitalen Medien und Konzepte wurden genutzt, um die Lernunterstützung aufrechtzuerhalten?
Methodik: Qualitative Befragung von Eltern und Lehrkräften mittels Leitfragen und anschließender qualitativer Inhaltsanalyse der Antworten.
Hauptergebnisse:


Eltern und Lehrkräfte mussten sich an die neue Situation anpassen und entwickelten verschiedene Strategien zur Bewältigung der Herausforderungen.


Digitale Medien und Kommunikationsplattformen waren zentral für die Lernunterstützung und die Pflege pädagogischer Beziehungen.


Die Akzeptanz und Effektivität der digitalen Lernangebote variierten je nach technischen Voraussetzungen und Medienkompetenz.


Schlussfolgerungen: Die Pandemie hat die Bedeutung digitaler Medien und der Pflege pädagogischer Beziehungen im Distance Learning verdeutlicht. Es bedarf weiterer Maßnahmen zur Unterstützung von Eltern und Lehrkräften sowie zur Verbesserung der technischen Infrastruktur und Medienkompetenz.
3. Kernaussagen
Wichtige Aussagen und Befunde:


Anpassung an Distance Learning: Eltern und Lehrkräfte mussten sich an die neuen Anforderungen des Distance Learnings gewöhnen und entwickelten verschiedene Strategien zur Anpassung (S. 124-125).


Rolle digitaler Medien: Digitale Medien und Kommunikationsplattformen waren entscheidend für die Aufrechterhaltung der Bildungsprozesse und die Pflege pädagogischer Beziehungen (S. 126-127).


Unterschiede in der Akzeptanz: Es gab erhebliche Unterschiede in der Akzeptanz und Effektivität der digitalen Lernangebote, abhängig von technischen Voraussetzungen und Medienkompetenz (S. 128-129).


4. Argumentationslinien
Aufbau der Argumente:


Einführung: Darstellung der Bedeutung von Distance Learning und Homeschooling während der Pandemie (S. 123-124).


Hauptteil: Analyse der Erfahrungen von Eltern und Lehrkräften, Herausforderungen und eingesetzte digitale Medien (S. 125-129).


Schluss: Diskussion der langfristigen Konsequenzen und Empfehlungen für die Praxis (S. 130-133).


5. Verschlagwortung


Lehr- und Lerneffektivität: Begründung: Der Artikel untersucht, wie Distance Learning und digitale Medien die Effektivität des Lernens und Lehrens während der Pandemie beeinflusst haben.


Technologieintegration: Begründung: Der Artikel behandelt die Implementierung und Nutzung digitaler Medien und Kommunikationsplattformen im schulischen Kontext.


Krisenreaktion im Bildungsbereich: Begründung: Der Artikel beschreibt die Reaktionen und Anpassungen des Bildungssystems auf die Herausforderungen der COVID-19-Pandemie.


Bildungstheorien: Begründung: Der Artikel diskutiert theoretische Konzepte zu Distance Learning und Homeschooling und deren Umsetzung in der Praxis.


6. Kategorisiere
Kategorie: Argumentation
Kriterium: Nutzung von Quellen oder Theorien zur Unterstützung oder Widerlegung einer These oder Fragestellung.
Beispiel: Der Artikel argumentiert, dass digitale Medien und die Pflege pädagogischer Beziehungen entscheidend für den Erfolg von Distance Learning sind, und stützt diese These durch empirische Daten und theoretische Konzepte.
7. Zuordnung zu Forschungsfragen
Passende Forschungsfrage: FU1: Welche Akzeptanz und Nützlichkeit (Bedeutung) beschreiben Akteure im digitalen Bildungsraum von Gesundheitsberufen bei Anwendung eines Learning-Management-Systems?
Begründung: Der Artikel untersucht die Akzeptanz und Nützlichkeit digitaler Lernmanagementsysteme und Kommunikationsplattformen während der Pandemie, was direkt auf die Forschungsfrage FU1 zutrifft.
},
	file = {gold_et_al_2020_„wir_mussten_uns_erst_einmal_eingrooven.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/9EULIPGJ/gold_et_al_2020_„wir_mussten_uns_erst_einmal_eingrooven.pdf:application/pdf},
}

@article{totter_zwischen_2020,
	title = {Zwischen traditionellem {Schulbuch} und hybridem {Lehrmittel}: {Bedingungen}, {Möglichkeiten} und {Herausforderungen} von {Lernen} und {Lehren} in einer digitalen {Welt}},
