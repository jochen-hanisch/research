	keywords = {Charité:Promotion, Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Promotion:Argumentation, \#1:Zeitschriftenartikel:learning:management:system, Datenschutz und IT-Sicherheit, Lernsystemarchitektur, Leraning:Analytics, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {jcal.12893},
