	issn = {1424-3636, 1424-3636},
	doi = {10/gr3tgb},
	abstract = {Für die lernförderliche Einbindung digitaler Medien in schulische Lehr-Lern-Situationen sollten angehende Lehrkräfte neben mediendidaktischen sowie medienerzieherischen Kompetenzen auch über medienbezogene motivationale und volitionale Dispositionen verfügen. Insbesondere Einstellungen und selbsteingeschätzte Kompetenzen sind Einflussfaktoren auf die Motivation zur Mediennutzung. Auf Basis einer Sekundäranalyse wird daher in diesem Beitrag die wechselseitige Entwicklung dieser Dispositionen für verschiedene medienbezogene Kompetenzfacetten von N = 269 Lehramtsstudierenden längsschnittlich untersucht, die ein fünfmonatiges Langzeitpraktikum während der Massnahmen zur Eindämmung der CoViD-19-Pandemie im Wintersemester 2020/2021 absolviert haben. Diese Zeit ging mit vermehrten medienbezogenen Lerngelegenheiten einher. Die Ergebnisse zeigen, dass sich die Einstellungen der angehenden Lehrkräfte hinsichtlich der Mediennutzung kaum veränderten, sich selbsteingeschätzte Medienkompetenzen und medienbezogene Motivation hingegen mit kleinem bis mittlerem Effekt positiv entwickelten. Cross-Lagged-Panel-Analysen zeigen zudem, dass sich eine hohe motivationale Orientierung in Bezug auf die Mediennutzung zu Beginn des Langzeitpraktikums positiv auf die Entwicklung selbsteingeschätzter Kompetenzen auswirkte, allerdings nicht in allen in der Analyse betrachteten Kompetenzfacetten.},
	language = {de-DE},
	journal = {MedienPädagogik: Zeitschrift für Theorie und Praxis der Medienbildung},
	author = {Vogelsang, Christoph and Caruso, Carina and Seifert, Andreas and Schwabl, Franziska},
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Technologieintegration, Promotion:FU2a, Promotion:Argumentation, \#7:Zeitschriftenartikel:digital:Medien, Bildung, Multimedia, Krisenreaktion im Bildungsbereich, Promotion:S:07 Digitale Medien, Promotion:Literaturverzeichnis},
	file = {Vogelsang et al. - 2023 - Wie entwickeln sich medienbezogene Einstellungen, .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/GCVTE9KW/Vogelsang et al. - 2023 - Wie entwickeln sich medienbezogene Einstellungen, .pdf:application/pdf},
}

@article{liyanagunawardena_massive_2014,
	title = {Massive {Open} {Online} {Courses} on {Health} and {Medicine}: {Review}},
	volume = {16},
	url = {http://www.jmir.org/2014/8/e191/},
	doi = {10.2196/jmir.3439},
	abstract = {Background: Massive open online courses (MOOCs) have become immensely popular in a short span of time. However, there is very little research exploring MOOCs in the discipline of health and medicine. Objective: We aim to provide a review of MOOCs related to health and medicine offered by various MOOC platforms in 2013, by analyzing and comparing the various offerings, their target audience, typical length of course, and credentials offered. We also discuss opportunities and challenges presented by MOOCs in health and medicine. Methods: Health and medicine?related MOOCs were gathered using several methods to ensure the richness and completeness of data. Identified MOOC platform websites were used to gather the lists of offerings. In parallel, these MOOC platforms were contacted to access official data on their offerings. Two MOOC aggregator sites (Class Central and MOOC List) were also consulted to gather data on MOOC offerings. Eligibility criteria were defined to concentrate on the courses that were offered in 2013 and primarily on the subject of health and medicine. All language translations in this paper were done using Google Translate. Results: The search identified 225 courses, of which 98 were eligible for the review. Over half (58\%, 57/98) of the MOOCs considered were offered on the Coursera platform, and 94\% (92/98) of all the MOOCs were offered in English. Universities offered 90 MOOCs, and the John Hopkins University offered the largest number of MOOCs (12/90). Only three MOOCs were offered by developing countries (China, West Indies, and Saudi Arabia). The duration of MOOCs varied from 3-20 weeks with an average length of 6.7 weeks. On average, MOOCs expected a participant to work on the material for 4.2 hours a week. Verified certificates were offered by 14 MOOCs, while three others offered other professional recognition. Conclusions: The review presents evidence to suggest that MOOCs can be used as a way to provide continuous medical education. It also shows the potential of MOOCs as a means of increasing health literacy among the public.},
	number = {8},
	urldate = {2024-06-16},
	journal = {J Med Internet Res},
	author = {Liyanagunawardena, Rekha Tharindu and Williams, Ann Shirley},
	month = aug,
	year = {2014},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:4, Promotion:FU5, Digitale Bildung, Krisenreaktion im Bildungsbereich, education, \#4:Zeitschriftenartikel:MOOC, computer-assisted instruction, continuing education, health education, Promotion:S:04 MOOC, Promotion:Literaturverzeichnis},
	pages = {e191},
	annote = {Analyse der Studie "Massive Open Online Courses on Health and Medicine: Review" von Tharindu Rekha Liyanagunawardena und Shirley Ann Williams (2014)
Hauptthemen und Ziele der Forschung:
Die Studie von Liyanagunawardena und Williams (2014) bietet eine umfassende Überprüfung von MOOCs (Massive Open Online Courses) im Bereich Gesundheit und Medizin, die im Jahr 2013 angeboten wurden. Ziel ist es, die verschiedenen Angebote zu analysieren und zu vergleichen, die Zielgruppen zu identifizieren, die typische Kurslänge und die angebotenen Zertifikate zu ermitteln sowie die Chancen und Herausforderungen von MOOCs im Bereich Gesundheit und Medizin zu diskutieren (S. 1).
Methoden und Datenquellen:
Die Autoren sammelten Daten zu MOOCs im Bereich Gesundheit und Medizin, indem sie verschiedene MOOC-Plattformen und Aggregator-Websites konsultierten und die Plattformanbieter direkt kontaktierten. Insgesamt wurden 225 Kurse identifiziert, von denen 98 in die Überprüfung einbezogen wurden. Die Kurse wurden hinsichtlich ihrer Dauer, der erwarteten Arbeitszeit pro Woche und der angebotenen Zertifikate analysiert (S. 2).
Zentrale Forschungsergebnisse:


Verteilung der Kurse: Über die Hälfte der betrachteten MOOCs (58\%) wurden auf der Plattform Coursera angeboten. Die meisten Kurse (94\%) wurden in Englisch angeboten. Nur drei MOOCs stammten aus Entwicklungsländern (China, Westindien und Saudi-Arabien) (S. 3-4).


Kursdauer und Arbeitsaufwand: Die Dauer der MOOCs variierte zwischen 3 und 20 Wochen, wobei die durchschnittliche Dauer 6,7 Wochen betrug. Im Durchschnitt erwarteten die Kurse einen wöchentlichen Arbeitsaufwand von 4,2 Stunden (S. 4-5).


Zertifikate und Anerkennung: Vierzehn MOOCs boten verifizierte Zertifikate an, während drei weitere professionelle Anerkennungen anboten. Einige Kurse boten auch Credits für die kontinuierliche berufliche Weiterbildung an (S. 5-6).


Zusammenfassung
Die Studie zeigt, dass MOOCs im Bereich Gesundheit und Medizin eine wertvolle Ressource für die kontinuierliche medizinische Bildung und die Erhöhung der Gesundheitskompetenz in der Öffentlichkeit darstellen können. MOOCs bieten eine flexible und zugängliche Möglichkeit, sich Wissen in spezialisierten Bereichen anzueignen und berufliche Qualifikationen zu verbessern.
Kernaussagen


Verbreitung und Sprache: Die meisten MOOCs im Bereich Gesundheit und Medizin werden auf englischsprachigen Plattformen angeboten, hauptsächlich auf Coursera (S. 3-4).


Flexibilität und Umfang: MOOCs bieten flexible Lernmöglichkeiten mit variabler Dauer und Arbeitsbelastung, was sie zu einer attraktiven Option für kontinuierliche Bildung macht (S. 4-5).


Berufliche Anerkennung: Eine signifikante Anzahl von MOOCs bietet verifizierte Zertifikate und Credits für berufliche Weiterbildung, was ihre Relevanz für Fachkräfte im Gesundheitswesen unterstreicht (S. 5-6).


Argumentationslinien
Die Autoren argumentieren, dass MOOCs eine bedeutende Rolle in der medizinischen Ausbildung und der öffentlichen Gesundheitsbildung spielen können. Sie betonen die Notwendigkeit, die Barrieren für den Zugang zu MOOCs zu überwinden, insbesondere in Entwicklungsländern, und schlagen vor, dass Partnerschaften mit Experten aus diesen Ländern die Vielfalt und Relevanz der angebotenen Kurse erhöhen könnten (S. 7-8).
Verschlagwortung
Passendste Schlagworte und Begründungen:


Lehr- und Lerneffektivität: Die Studie untersucht die Effektivität von MOOCs zur beruflichen Weiterbildung im Gesundheitswesen (S. 5-6).


Forschungsansätze: Die methodische Analyse der MOOCs und deren Angebote stellt einen neuen Ansatz zur Bewertung von Online-Bildungsressourcen dar (S. 2).


Krisenreaktion im Bildungsbereich: MOOCs bieten eine flexible Möglichkeit, Bildung in Zeiten von Krisen, wie Pandemien, zugänglich zu machen (S. 7).


Kategorisierung


Kerngedanke: Die Studie präsentiert die zentrale Idee, dass MOOCs eine wertvolle Ressource für die kontinuierliche medizinische Bildung und die Erhöhung der Gesundheitskompetenz darstellen (S. 2).


Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU5: Möglichkeiten und Grenzen eines LMS.


Begründung: Die Studie analysiert die Möglichkeiten und Herausforderungen der Implementierung und Nutzung von MOOCs im Gesundheitswesen, was direkt die Frage nach den Möglichkeiten und Grenzen eines LMS betrifft (S. 7-8).
Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie untersucht die Nutzung von MOOCs zur medizinischen Ausbildung und öffentlichen Gesundheitsbildung).


Zitierhäufigkeit und Einfluss: 4 (Die Studie ist umfassend und gut zitiert).


Aktualität: 4 (Die Studie ist von 2014, bietet aber grundlegende und relevante Erkenntnisse).


Gesamtbewertung: 4.3
Schlussfolgerung
Die Studie zeigt, dass MOOCs eine bedeutende Rolle in der kontinuierlichen medizinischen Bildung und der Erhöhung der Gesundheitskompetenz spielen können. Sie bieten flexible und zugängliche Lernmöglichkeiten, die sowohl für Fachkräfte im Gesundheitswesen als auch für die allgemeine Öffentlichkeit von Nutzen sind. Die Ergebnisse bieten wertvolle Einblicke und Empfehlungen für die Gestaltung und Implementierung von MOOCs im Bereich Gesundheit und Medizin.
},
	file = {Liyanagunawardena und Williams - 2014 - Massive Open Online Courses on Health and Medicine.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/S3NBTWGQ/Liyanagunawardena und Williams - 2014 - Massive Open Online Courses on Health and Medicine.pdf:application/pdf},
}

@article{alturkistani_massive_2020,
	title = {Massive {Open} {Online} {Course} {Evaluation} {Methods}: {Systematic} {Review}},
	volume = {22},
	url = {https://www.jmir.org/2020/4/e13851},
	doi = {10.2196/13851},
	abstract = {Background: Massive open online courses (MOOCs) have the potential to make a broader educational impact because many learners undertake these courses. Despite their reach, there is a lack of knowledge about which methods are used for evaluating these courses. Objective: The aim of this review was to identify current MOOC evaluation methods to inform future study designs. Methods: We systematically searched the following databases for studies published from January 2008 to October 2018: (1) Scopus, (2) Education Resources Information Center, (3) IEEE (Institute of Electrical and Electronic Engineers) Xplore, (4) PubMed, (5) Web of Science, (6) British Education Index, and (7) Google Scholar search engine. Two reviewers independently screened the abstracts and titles of the studies. Published studies in the English language that evaluated MOOCs were included. The study design of the evaluations, the underlying motivation for the evaluation studies, data collection, and data analysis methods were quantitatively and qualitatively analyzed. The quality of the included studies was appraised using the Cochrane Collaboration Risk of Bias Tool for randomized controlled trials (RCTs) and the National Institutes of Health?National Heart, Lung, and Blood Institute quality assessment tool for cohort observational studies and for before-after (pre-post) studies with no control group. Results: The initial search resulted in 3275 studies, and 33 eligible studies were included in this review. In total, 16 studies used a quantitative study design, 11 used a qualitative design, and 6 used a mixed methods study design. In all, 16 studies evaluated learner characteristics and behavior, and 20 studies evaluated learning outcomes and experiences. A total of 12 studies used 1 data source, 11 used 2 data sources, 7 used 3 data sources, 4 used 2 data sources, and 1 used 5 data sources. Overall, 3 studies used more than 3 data sources in their evaluation. In terms of the data analysis methods, quantitative methods were most prominent with descriptive and inferential statistics, which were the top 2 preferred methods. In all, 26 studies with a cross-sectional design had a low-quality assessment, whereas RCTs and quasi-experimental studies received a high-quality assessment. Conclusions: The MOOC evaluation data collection and data analysis methods should be determined carefully on the basis of the aim of the evaluation. The MOOC evaluations are subject to bias, which could be reduced using pre-MOOC measures for comparison or by controlling for confounding variables. Future MOOC evaluations should consider using more diverse data sources and data analysis methods. International Registered Report Identifier (IRRID): RR2-10.2196/12087},
	number = {4},
	urldate = {2024-06-16},
	journal = {J Med Internet Res},
	author = {Alturkistani, Abrar and Lam, Ching and Foley, Kimberley and Stenfors, Terese and Blum, R. Elizabeth and Van Velthoven, Helena Michelle and Meinert, Edward},
	month = apr,
	year = {2020},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Bewertungsmethoden, Promotion:Argumentation, Promotion:Relevanz:4, Promotion:FU5, online learning, \#4:Zeitschriftenartikel:MOOC, learning, computer-assisted instruction, Promotion:S:04 MOOC, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {e13851},
	annote = {Analyse der Studie "Massive Open Online Course Evaluation Methods: Systematic Review" von Abrar Alturkistani et al. (2020)
Hauptthemen und Ziele der Forschung:
Die Studie von Alturkistani et al. (2020) zielt darauf ab, die aktuellen Methoden zur Evaluierung von MOOCs systematisch zu überprüfen, um zukünftige Studiendesigns zu informieren. Ziel ist es, eine umfassende Übersicht über die verwendeten Evaluationsmethoden zu geben, die Motivation hinter den Evaluationen zu verstehen und die Qualität der Evaluationsstudien zu bewerten (S. 1).
Methoden und Datenquellen:
Die Autoren durchsuchten systematisch mehrere Datenbanken, darunter Scopus, PubMed und Web of Science, nach Studien, die zwischen Januar 2008 und Oktober 2018 veröffentlicht wurden. Insgesamt wurden 3275 Studien identifiziert, von denen 33 in die Überprüfung einbezogen wurden. Die Studien wurden hinsichtlich ihres Designs, der verwendeten Datensammlungs- und Analysemethoden sowie der Qualität bewertet (S. 2).
Zentrale Forschungsergebnisse:


Verteilung der Evaluationsmethoden: Von den 33 eingeschlossenen Studien verwendeten 16 ein quantitatives Studiendesign, 11 ein qualitatives Design und 6 ein Mixed-Methods-Design. Die meisten Studien verwendeten deskriptive und inferenzstatistische Methoden zur Datenanalyse (S. 3-4).


Häufig verwendete Datensammlungsmethoden: Die am häufigsten verwendeten Datensammlungsmethoden waren Umfragen, Learning Management System (LMS)-Daten, Quizdaten und Interviews. Einige Studien verwendeten auch Fokusgruppen und Social-Media-Beiträge als Datenquellen (S. 5-6).


Qualität der Studien: Die meisten Studien wiesen aufgrund von Bias eine niedrige Qualität auf. Nur randomisierte kontrollierte Studien (RCTs) und quasi-experimentelle Studien erhielten eine hohe Qualitätsbewertung. Studien, die Vorher-Nachher-Messungen verwendeten, hatten ein geringeres Bias-Risiko (S. 7-8).


Zusammenfassung
Die Studie zeigt, dass die Evaluationsmethoden für MOOCs sehr vielfältig sind und oft mit methodischen Herausforderungen und Bias behaftet sind. Es gibt keine einheitliche Methode zur Evaluierung von MOOCs, was teilweise auf die unterschiedlichen Ziele der Evaluationen zurückzuführen ist. Die Autoren empfehlen, zukünftige MOOC-Evaluationen sorgfältig zu planen und eine Kombination aus quantitativen und qualitativen Methoden zu verwenden, um umfassendere Einblicke zu erhalten.
Kernaussagen


Vielfalt der Methoden: MOOCs werden mit einer Vielzahl von Methoden evaluiert, wobei quantitative Methoden dominieren (S. 3-4).


Qualitätsbewertung: Viele Evaluationsstudien leiden unter methodischen Schwächen und Bias, was ihre Aussagekraft einschränkt (S. 7-8).


Empfehlungen für zukünftige Studien: Es wird empfohlen, vielfältige Datensammlungs- und Analysemethoden zu verwenden und dabei Bias zu minimieren (S. 9-10).


Argumentationslinien
Die Autoren argumentieren, dass die Evaluationsmethoden von MOOCs verbessert werden müssen, um verlässlichere und aussagekräftigere Ergebnisse zu erzielen. Sie betonen die Bedeutung einer sorgfältigen Planung und die Notwendigkeit, Bias zu kontrollieren. Zukünftige Studien sollten eine Kombination aus quantitativen und qualitativen Methoden verwenden, um ein umfassenderes Bild der Effektivität von MOOCs zu erhalten (S. 9-10).
Verschlagwortung
Passendste Schlagworte und Begründungen:


Bewertungsmethoden: Die Studie untersucht die verschiedenen Methoden zur Evaluierung von MOOCs und deren Effektivität (S. 1-2).


Forschungsansätze: Die systematische Überprüfung der Evaluationsmethoden stellt einen methodologischen Ansatz dar, um die Qualität und Aussagekraft der Evaluationsstudien zu verbessern (S. 9-10).


Kategorisierung


Argumentation: Die Studie verwendet systematische Überprüfungen und qualitative und quantitative Analysen, um die Methoden zur Evaluierung von MOOCs zu bewerten und Empfehlungen für zukünftige Studien zu geben (S. 9-10).


Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU5: Möglichkeiten und Grenzen eines LMS.


Begründung: Die Studie analysiert die Möglichkeiten und Herausforderungen der Evaluierung von MOOCs, was direkt die Frage nach den Möglichkeiten und Grenzen eines LMS betrifft (S. 9-10).
Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie untersucht umfassend die Methoden zur Evaluierung von MOOCs).


Zitierhäufigkeit und Einfluss: 4 (Die Studie ist umfassend und gut zitiert).


Aktualität: 4 (Die Studie ist von 2020 und behandelt ein aktuelles Thema).


Gesamtbewertung: 4.3
Schlussfolgerung
Die Studie zeigt, dass die Evaluationsmethoden für MOOCs vielfältig sind, aber oft methodische Schwächen aufweisen. Es wird empfohlen, zukünftig vielfältige und sorgfältig geplante Evaluationsmethoden zu verwenden, um verlässlichere und aussagekräftigere Ergebnisse zu erzielen. Die Kombination aus quantitativen und qualitativen Methoden kann dazu beitragen, ein umfassenderes Bild der Effektivität von MOOCs zu erhalten und deren Potenzial besser zu verstehen.
},
	file = {Alturkistani et al. - 2020 - Massive Open Online Course Evaluation Methods Sys.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/UXF37NFD/Alturkistani et al. - 2020 - Massive Open Online Course Evaluation Methods Sys.pdf:application/pdf},
}

@article{kononowicz_virtual_2015,
	title = {Virtual {Patients} in a {Behavioral} {Medicine} {Massive} {Open} {Online} {Course} ({MOOC}): {A} {Case}-{Based} {Analysis} of {Technical} {Capacity} and {User} {Navigation} {Pathways}},
	volume = {1},
	url = {http://mededu.jmir.org/2015/2/e8/},
	doi = {10.2196/mededu.4394},
	abstract = {Background: Massive open online courses (MOOCs) have been criticized for focusing on presentation of short video clip lectures and asking theoretical multiple-choice questions. A potential way of vitalizing these educational activities in the health sciences is to introduce virtual patients. Experiences from such extensions in MOOCs have not previously been reported in the literature. Objective: This study analyzes technical challenges and solutions for offering virtual patients in health-related MOOCs and describes patterns of virtual patient use in one such course. Our aims are to reduce the technical uncertainty related to these extensions, point to aspects that could be optimized for a better learner experience, and raise prospective research questions by describing indicators of virtual patient use on a massive scale. Methods: The Behavioral Medicine MOOC was offered by Karolinska Institutet, a medical university, on the EdX platform in the autumn of 2014. Course content was enhanced by two virtual patient scenarios presented in the OpenLabyrinth system and hosted on the VPH-Share cloud infrastructure. We analyzed web server and session logs and a participant satisfaction survey. Navigation pathways were summarized using a visual analytics tool developed for the purpose of this study. Results: The number of course enrollments reached 19,236. At the official closing date, 2317 participants (12.1\% of total enrollment) had declared completing the first virtual patient assignment and 1640 (8.5\%) participants confirmed completion of the second virtual patient assignment. Peak activity involved 359 user sessions per day. The OpenLabyrinth system, deployed on four virtual servers, coped well with the workload. Participant survey respondents (n=479) regarded the activity as a helpful exercise in the course (83.1\%). Technical challenges reported involved poor or restricted access to videos in certain areas of the world and occasional problems with lost sessions. The visual analyses of user pathways display the parts of virtual patient scenarios that elicited less interest and may have been perceived as nonchallenging options. Analyzing the user navigation pathways allowed us to detect indications of both surface and deep approaches to the content material among the MOOC participants. Conclusions: This study reported on first inclusion of virtual patients in a MOOC. It adds to the body of knowledge by demonstrating how a biomedical cloud provider service can ensure technical capacity and flexible design of a virtual patient platform on a massive scale. The study also presents a new way of analyzing the use of branched virtual patients by visualization of user navigation pathways. Suggestions are offered on improvements to the design of virtual patients in MOOCs.},
	number = {2},
	urldate = {2024-06-16},
	journal = {JMIR Medical Education},
	author = {Kononowicz, A. Andrzej and Berman, H. Anne and Stathakarou, Natalia and McGrath, Cormac and Barty?ski, Tomasz and Nowakowski, Piotr and Malawski, Maciej and Zary, Nabil},
	month = sep,
	year = {2015},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Promotion:Argumentation, Promotion:Relevanz:4, Promotion:FU5, \#4:Zeitschriftenartikel:MOOC, education, medical, computer-assisted instruction, medical informatics applications, Promotion:S:04 MOOC, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU5},
	pages = {e8},
	annote = {Analyse der Studie "Virtual Patients in a Behavioral Medicine Massive Open Online Course (MOOC): A Case-Based Analysis of Technical Capacity and User Navigation Pathways" von Kononowicz et al. (2015)
Hauptthemen und Ziele der Forschung:
Die Studie von Kononowicz et al. (2015) untersucht die technische Kapazität und die Benutzerpfade bei der Nutzung virtueller Patienten in einem verhaltensmedizinischen MOOC. Ziel ist es, die technischen Herausforderungen und Lösungen für die Bereitstellung virtueller Patienten in MOOCs zu analysieren und die Nutzungsmuster dieser virtuellen Patienten zu beschreiben. Die Autoren möchten damit die technische Unsicherheit reduzieren und Aspekte identifizieren, die für eine bessere Lernerfahrung optimiert werden könnten (S. 1).
Methoden und Datenquellen:
Der Behavioral Medicine MOOC wurde vom Karolinska Institutet im Herbst 2014 auf der EdX-Plattform angeboten. Der Kurs wurde durch zwei virtuelle Patientenszenarien erweitert, die im OpenLabyrinth-System präsentiert und auf der VPH-Share-Cloud-Infrastruktur gehostet wurden. Die Daten wurden durch Webserver- und Sitzungsprotokolle sowie eine Teilnehmerzufriedenheitsumfrage gesammelt. Die Navigationspfade wurden mit einem speziell entwickelten Visual-Analytics-Tool analysiert (S. 3-4).
Zentrale Forschungsergebnisse:


Nutzerbeteiligung und Serverauslastung: Der Kurs hatte 19.236 Einschreibungen. Am offiziellen Kursende hatten 2.317 Teilnehmer (12,1 \%) die erste und 1.640 Teilnehmer (8,5 \%) die zweite virtuelle Patientenaufgabe abgeschlossen. Der Spitzenwert lag bei 359 Nutzersitzungen pro Tag. Das OpenLabyrinth-System bewältigte die Arbeitslast gut (S. 6-8).


Technische Herausforderungen: Berichtet wurden eingeschränkter Zugang zu Videos in bestimmten Regionen und gelegentliche Probleme mit verlorenen Sitzungen. Die visuelle Analyse der Benutzerpfade zeigte Bereiche der virtuellen Patientenszenarien, die weniger Interesse weckten und möglicherweise als nicht herausfordernd empfunden wurden (S. 9-11).


Teilnehmerzufriedenheit: 83,1 \% der Befragten bewerteten die Aktivität als hilfreiche Übung im Kurs. Technische Herausforderungen betrafen hauptsächlich den Zugang zu Videos und Internetverbindungsprobleme (S. 12).


Zusammenfassung
Die Studie zeigt, dass die Einbindung virtueller Patienten in MOOCs technisch machbar ist und von den Teilnehmern positiv aufgenommen wird. Technische Herausforderungen können durch den Einsatz von Cloud-Infrastrukturen und gezielte Verbesserungen im Design der virtuellen Patienten bewältigt werden.
Kernaussagen


Technische Machbarkeit: Die Einbindung virtueller Patienten in MOOCs ist technisch realisierbar und kann große Nutzerzahlen bewältigen (S. 8).


Teilnehmerzufriedenheit: Die Mehrheit der Teilnehmer bewertet die Nutzung virtueller Patienten als hilfreich (S. 12).


Optimierungspotenzial: Bereiche mit geringem Interesse und technische Probleme wurden identifiziert und bieten Potenzial für zukünftige Verbesserungen (S. 11).


Argumentationslinien
Die Autoren argumentieren, dass virtuelle Patienten eine wertvolle Ergänzung für MOOCs darstellen, da sie interaktives Lernen und klinisches Denken fördern. Die Verwendung von Cloud-Infrastrukturen wird als effiziente Lösung zur Bewältigung der technischen Anforderungen empfohlen (S. 13-14).
Verschlagwortung
Passendste Schlagworte und Begründungen:


Technologieintegration: Die Studie untersucht die technische Integration von virtuellen Patienten in MOOCs (S. 8).


Lehr- und Lerneffektivität: Die Nutzung virtueller Patienten fördert das interaktive Lernen und klinische Denkprozesse (S. 12).


Forschungsansätze: Die Studie verwendet innovative Methoden der Visual Analytics zur Analyse von Benutzerpfaden (S. 11).


Kategorisierung


Kerngedanke: Die Studie präsentiert die zentrale Idee der Nutzung virtueller Patienten zur Verbesserung des Lernens in MOOCs und die technische Machbarkeit dieser Integration (S. 8).


Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU5: Möglichkeiten und Grenzen eines LMS.


Begründung: Die Studie analysiert die technischen Möglichkeiten und Herausforderungen bei der Integration virtueller Patienten in MOOCs, was direkt die Frage nach den Möglichkeiten und Grenzen eines LMS betrifft (S. 13-14).
Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie untersucht umfassend die Integration und Nutzung virtueller Patienten in MOOCs).


Zitierhäufigkeit und Einfluss: 4 (Die Studie ist umfassend und gut zitiert).


Aktualität: 4 (Die Studie ist von 2015 und bietet relevante Erkenntnisse).


Gesamtbewertung: 4.3
Schlussfolgerung
Die Studie zeigt, dass die Einbindung virtueller Patienten in MOOCs technisch machbar und von den Teilnehmern positiv bewertet wird. Durch den Einsatz von Cloud-Infrastrukturen können technische Herausforderungen bewältigt werden. Die Ergebnisse bieten wertvolle Einblicke und Empfehlungen für die zukünftige Gestaltung und Implementierung virtueller Patienten in MOOCs.
},
