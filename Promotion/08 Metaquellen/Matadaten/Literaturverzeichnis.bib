	editor = {Frasson, Claude and Mylonas, Phivos and Troussas, Christos},
	year = {2023},
	doi = {10.1007/978-3-031-32883-1_56},
	note = {Series Title: Lecture Notes in Computer Science},
	keywords = {Charité:Promotion, Promotion:Literaturanalyse, \#4:Buchteil:MOOC, Promotion:S:04 MOOC, Promotion:Literaturverzeichnis},
	pages = {638--650},
	file = {Shiga und Morimoto - 2023 - Joint Topic Model with Selected Side Information f.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/GW3AE3UZ/Shiga und Morimoto - 2023 - Joint Topic Model with Selected Side Information f.pdf:application/pdf},
