@article{park_ai_2024,
	title = {{AI} deception: {A} survey of examples, risks, and potential solutions},
	volume = {5},
	issn = {26663899},
	shorttitle = {{AI} deception},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S266638992400103X},
	doi = {10.1016/j.patter.2024.100988},
	abstract = {This paper argues that a range of current AI systems have learned how to deceive humans. We deﬁne deception as the systematic inducement of false beliefs in the pursuit of some outcome other than the truth. We ﬁrst survey empirical examples of AI deception, discussing both special-use AI systems (including Meta’s CICERO) and general-purpose AI systems (including large language models). Next, we detail several risks from AI deception, such as fraud, election tampering, and losing control of AI. Finally, we outline several potential solutions: ﬁrst, regulatory frameworks should subject AI systems that are capable of deception to robust risk-assessment requirements; second, policymakers should implement bot-or-not laws; and ﬁnally, policymakers should prioritize the funding of relevant research, including tools to detect AI deception and to make AI systems less deceptive. Policymakers, researchers, and the broader public should work proactively to prevent AI deception from destabilizing the shared foundations of our society.},
	language = {en},
	number = {5},
	urldate = {2024-05-15},
	journal = {Patterns},
	author = {Park, Peter S. and Goldstein, Simon and O’Gara, Aidan and Chen, Michael and Hendrycks, Dan},
	month = may,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Systemanpassung, Datenschutz und IT-Sicherheit, Promotion:Literaturverzeichnis},
	pages = {100988},
	annote = {Kernstudie identifiziert für das Forschungsprojekt "Wirkgefüge im digitalen Bildungsraum":


Titel: AI deception: A survey of examples, risks, and potential solutions


Autoren: Park, P. S., Goldstein, S., O’Gara, A., Chen, M., \& Hendrycks, D.


Publiziert in: Patterns


Band/Volume: 5


Ausgabe: 5


Artikelnummer: 100988


Jahr: 2024


DOI: https://doi.org/10.1016/j.patter.2024.100988


Beschreibung der Studie: Die Studie bietet eine umfassende Untersuchung der Täuschung durch künstliche Intelligenz, indem sie Beispiele, Risiken und mögliche Lösungen aufzeigt. Die Autoren analysieren verschiedene Szenarien, in denen KI-Systeme irreführend eingesetzt werden könnten und diskutieren die potenziellen Gefahren sowie Strategien, um diese Risiken zu minimieren.
Bedeutung für das Forschungsprojekt: Obwohl diese Studie nicht direkt auf digitale Bildungsräume abzielt, bietet sie wichtige Einsichten in ethische Überlegungen und Sicherheitsfragen, die für die Entwicklung und Implementierung von KI-gestützten Lernsystemen relevant sind. Das Verständnis der Risiken von KI-Täuschungen ist entscheidend, um robuste und vertrauenswürdige digitale Bildungsplattformen zu schaffen.
Diese Informationen sind dokumentiert und dienen als wichtige Grundlage für die Evaluierung der Sicherheits- und Ethikstandards in Bezug auf den Einsatz von KI in Bildungstechnologien innerhalb Ihres Forschungsprojekts.
},
