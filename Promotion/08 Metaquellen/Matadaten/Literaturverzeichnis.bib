@article{gruning_funfdimensionale_2022,
	title = {Fünfdimensionale überarbeitete {Neugier}-{Skala} ({5DCR})},
	url = {https://zis.gesis.org/DoiId/zis320_exz},
	doi = {10.6102/ZIS320_EXZ},
	abstract = {Die überarbeitete fünfdimensionale Neugier-Skala (5DCR) von Kashdan et al. (2020) ist das umfangreichste bisher verfügbare Neugier-Inventar. Die 5DCR misst sechs Facetten der Neugier mit jeweils vier Items: Enthusiasmus zu erkunden, Deprivationsintoleranz, Stresstoleranz, generelle soziale Neugier, spezielle soziale Neugier, Suche nach Nervenkitzel. Die Skala wurde ins Deutsche adaptiert und an der deutschsprachigen Bevölkerung (N = 485; Grüning \&amp; Lechner, 2022) validiert. Die Reliabilität der sechs Facetten des 5DCR, die faktorielle Validität sowie die konvergente und diskriminante Validität wurden bestätigt. Das Instrument zeigt mindestens teilweise skalare Messinvarianz über Alter, Geschlecht, Bildung und verschiedene Länder (d.h. im Vergleich mit dem Vereinigten Königreich).},
	language = {de-DE},
	urldate = {2024-03-25},
	journal = {Zusammenstellung sozialwissenschaftlicher Items und Skalen (ZIS)},
