	author = {Thimmappa, B H S},
	year = {2025},
	keywords = {Charité:Promotion, Promotion:Literaturanalyse, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Technologieintegration, Systemanpassung, Bildungstheorien, Promotion:Weiterführung, Promotion:FU7, \#5:Zeitschriftenartikel:e-learning, Promotion:Literaturverzeichnis},
