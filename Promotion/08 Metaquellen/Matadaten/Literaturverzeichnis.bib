@article{gisch_odipus_2020,
	title = {Ödipus vs. {Big}-{Five}: {Kann} eine psychoanalytisch fundierte {Persönlichkeitsdiagnostik} einen inkrementellen {Beitrag} über die {Big}-{Five}-{Persönlichkeitsfacetten} hinaus zur {Vorhersage} von psychischer {Gesundheit} und {Zufriedenheit} am {Arbeitsplatz} liefern?},
