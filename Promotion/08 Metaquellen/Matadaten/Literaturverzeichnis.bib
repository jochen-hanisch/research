  author = {Schmitz-Feldhaus, Carmen},
  namea = {Teaching Trends: Offen für neue Wege – Digitale Medien in der Hochschule (2014 : Oldenburg (Oldenburg))},
  nameatype = {collaborator},
  date = {2020-02-21},
  publisher = {Waxmann},
  doi = {10/grsthj},
  url = {https://www.pedocs.de/frontdoor.php?source_opus=18464},
  urldate = {2023-02-17},
  abstract = {Als einleitender Beitrag dieses Abschnittes vermittelt der Beitrag von Carmen Schmitz-Feldhaus einen Einblick in die Zielgruppe der sogenannten "nicht traditionellen Studierenden“ (NTS). Neben einer grundlegenden Beschreibung dieser Zielgruppe untersucht die Autorin die Defizithypothese nach Teichler und Wolter, nach der NTS eher im Studium scheitern als traditionelle Studierende (TS). Dabei nutzt sie den Fragebogen zum Sense of Coherence, welcher misst, inwieweit das Leben für Personen verstehbar und handhabbar ist. Die Ergebnisse geben Hinweise darauf, dass sich die Gruppe der NTS nicht als homogener Körper beschreiben lässt und die individuellen Charakteristika bei mediengestützten Angeboten sehr spezifisch zu berücksichtigen sind. (DIPF/Orig.)},
  langid = {ngerman},
  keywords = {7:Zeitschriftenartikel:digital:Medien,Academic studies,Barrierefreiheit,Bedeutsamkeit,Befragung,Behinderung,Bildung,Bildungsbiografie,Charité:Promotion,Deficit,Defizit,Digitale Bildung,Empirical study,Empirische Untersuchung,Handhabung,Handicap,Hochschule,Hypothese,Informations- und Kommunikationsmedien,Kompetenz,Krisenreaktion im Bildungsbereich,Lehr- und Lerneffektivität,Likert Scales,Likert-Skala,Male student,Media competence,Media skills,On line,Online,Promotion:02-01_Q2,Promotion:02-01_Q3,Promotion:FU5,Promotion:Literaturanalyse,Promotion:Relevanz:4,Promotion:S:07 Digitale Medien,Promotion:Weiterführung,Regression analysis,Regressionsanalyse,School career,Student,Studium,Systemanpassung,Target group,Varianzanalyse,Verstehen,Zielgruppe},
