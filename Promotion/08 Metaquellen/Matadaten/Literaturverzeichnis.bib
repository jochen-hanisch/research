@article{ali_supporting_2023,
	title = {Supporting self-directed learning and self-assessment using {TeacherGAIA}, a generative {AI} chatbot application: {Learning} approaches and prompt engineering},
	issn = {2373-5082, 2373-5090},
	shorttitle = {Supporting self-directed learning and self-assessment using {TeacherGAIA}, a generative {AI} chatbot application},
	url = {https://www.tandfonline.com/doi/full/10.1080/23735082.2023.2258886},
	doi = {10/gss62t},
	abstract = {Self-directed learning and self-assessment require student respon­ sibility over learning needs, goals, processes, and outcomes. However, this student-led learning can be challenging to achieve in a classroom limited by a one-to-many teacher-led instruction. We, thus, have designed and prototyped a generative artificial intelligence chatbot application (GAIA), named TeacherGAIA, that can be used to asynchronously support students in their selfdirected learning and self-assessment outside the classroom. We first identified diverse constructivist learning approaches that align with, and promote, student-led learning. These included knowl­ edge construction, inquiry-based learning, self-assessment, and peer teaching. The in-context learning abilities of large language model (LLM) from OpenAI were then leveraged via prompt engi­ neering to steer interactions supporting these different learning approaches. These interactions contrasted with ChatGPT, OpenAI’s chatbot which by default engaged in the traditional transmissionist mode of learning reminiscent of teacher-led instruction. Preliminary design, prompt engineering and prototyping suggested fidelity to the learning approaches, cognitive guidance, and social-emotional support, all of which were implemented in a generative AI manner without pre-specified rules or “hard-coding”. Other affordances of TeacherGAIA are discussed and future development outlined. We anticipate TeacherGAIA to be a useful application for teachers in facilitating self-directed learning and self-assessment among K-12 students.},
	language = {en-GB},
	urldate = {2023-09-30},
	journal = {Learning: Research and Practice},
	author = {Ali, Farhan and Choy, Doris and Divaharan, Shanti and Tay, Hui Yong and Chen, Wenli},
	month = sep,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Technologieintegration, Bildungstheorien, Promotion:Argumentation, Promotion:FU6, GPT, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {1--13},
	file = {Ali et al. - 2023 - Supporting self-directed learning and self-assessm.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/PR49HAKQ/Ali et al. - 2023 - Supporting self-directed learning and self-assessm.pdf:application/pdf},
}

@article{mauroux_mobile_2014,
	title = {Mobile and {Online} {Learning} {Journal}: {Effects} on {Apprentices}’ {Reflection} in {Vocational} {Education} and {Training}},
	volume = {7},
	issn = {1874-785X, 1874-7868},
	shorttitle = {Mobile and {Online} {Learning} {Journal}},
	url = {10.1007/s12186-014-9113-0},
	doi = {10/f552qb},
	language = {en-GB},
	number = {2},
	urldate = {2020-11-11},
	journal = {Vocations and Learning},
	author = {Mauroux, Laetitia and Könings, Karen D. and Zufferey, Jessica Dehler and Gurtner, Jean-Luc},
	month = jul,
	year = {2014},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Bewertungsmethoden, Promotion:FU6, UTAUT-Modell, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {215--239},
	annote = {Analyse der Studie „Mobile and Online Learning Journal: Effects on Apprentices’ Reflection in Vocational Education and Training“ von Mauroux et al. (2014)

1. Hauptthemen und Ziele der Forschung
Die Studie untersucht die Einführung und Nutzung eines mobilen und online-basierten Lernjournals (MOLJ) im beruflichen Bildungsbereich. Ziel ist es, zu analysieren, wie Lernende das System verwenden, welche Faktoren die Akzeptanz beeinflussen und ob das System zur Förderung der Reflexion über betriebliche Lernprozesse beiträgt​Mauroux2014\_Article\_Mob….
Zentrale Forschungsfragen:


Wie nutzen Auszubildende das mobile und Online-Lernjournal in ihrer Ausbildung?


Welche Faktoren beeinflussen die Akzeptanz und Nutzung des Lernjournals durch die Auszubildenden?


Wie trägt das Lernjournal zur Reflexion und Selbstregulierung im Lernprozess bei?



2. Methoden und Datenquellen
Methoden:


Mixed-Methods-Ansatz: Kombination aus quantitativen und qualitativen Methoden.


Empirische Untersuchung mit 16 Auszubildenden im Bäckerhandwerk.


Erfassung der Nutzung des Lernjournals:


Protokollierung der Nutzungshäufigkeit und Art der Nutzung (z. B. Rezeptbuch, Reflexionsseite, Fotoaufnahme).


Fragebögen zur Messung der wahrgenommenen Nützlichkeit und Nutzerakzeptanz.


Semi-strukturierte Interviews zur Untersuchung der individuellen Erfahrungen der Auszubildenden mit dem MOLJ.




Datenquellen:


Interaktionsprotokolle innerhalb des Lernjournals (z. B. Anzahl der erstellten Rezepte, hochgeladenen Bilder, Reflexionsbeiträge).


Befragung der Lernenden zur Wahrnehmung des Systems (Skalen zu Benutzerfreundlichkeit, Motivation, Reflexion).


Interviews mit Auszubildenden zur detaillierten Exploration der Nutzungserfahrungen​Mauroux2014\_Article\_Mob….



3. Zentrale Forschungsergebnisse


Vier Typen von Nutzenden konnten identifiziert werden:


Multifunktionale Nutzer: Verwenden alle Funktionen des MOLJ intensiv.


Reflexionsnutzer: Nutzen besonders die Reflexionskomponenten und Selbstbewertung.


Bild-Dokumentierende Nutzer: Verwenden das System primär zur Erfassung visueller Eindrücke.


Geringe Nutzer: Setzen das MOLJ kaum oder nur sehr selektiv ein.




Faktoren, die die Nutzung des MOLJ beeinflussen:


Technologische Faktoren: Benutzerfreundlichkeit und technische Zugänglichkeit (z. B. Bedienbarkeit von Smartphones in der Bäckerei).


Motivation der Lernenden: Je höher das Interesse an Technologie und Reflexion, desto intensiver die Nutzung.


Unterstützung durch Ausbildende: Lernende, die regelmäßig Feedback von ihren Ausbildern erhielten, nutzten das System signifikant häufiger.


Integration in den betrieblichen Alltag: Die Notwendigkeit, das System als integralen Bestandteil der Ausbildung zu sehen, wurde als essenziell erachtet​Mauroux2014\_Article\_Mob….




Wahrgenommene Vorteile des MOLJ:


Unterstützung der Reflexion über Arbeitsprozesse.


Erleichterung der Dokumentation und Speicherung von betrieblichen Erfahrungen.


Bessere Verbindung zwischen schulischem und betrieblichem Lernen.




Herausforderungen und Verbesserungsbedarf:


Mangelnde Nutzung der Reflexionskomponente durch einige Lernende.


Fehlendes Feedback von Vorgesetzten mindert die Nutzungsmotivation.


Notwendigkeit einer strukturierten Integration des Systems in die Ausbildung.





4. Zusammenfassung
Die Studie zeigt, dass das mobile und onlinebasierte Lernjournal (MOLJ) in der beruflichen Bildung eine wertvolle Unterstützung zur Reflexion und Selbstregulierung bietet. Die Nutzung ist jedoch stark von technischen, motivationalen und organisationalen Faktoren abhängig. Besonders wichtig ist die aktive Einbindung von Ausbildenden und die Bereitstellung von Feedback, um eine langfristige Akzeptanz und Nutzung zu fördern​Mauroux2014\_Article\_Mob….

5. Kernaussagen


„Die Akzeptanz des mobilen Lernjournals hängt maßgeblich von der Unterstützung durch Ausbilder ab.“ (S. 220)


„Die Reflexion über betriebliche Erfahrungen wird durch strukturierte digitale Lernjournale gefördert, jedoch nicht automatisch umgesetzt.“ (S. 222)


„Ein Mangel an technischer Akzeptanz oder wahrgenommenem Nutzen kann die Nutzungshäufigkeit erheblich reduzieren.“ (S. 225)



6. Argumentationslinien
Die Studie argumentiert, dass digitale Lernjournale nur dann effektiv sind, wenn sie aktiv in den Lernprozess integriert und von Ausbildenden unterstützt werden:


Grundannahme: Reflexion und Selbstregulierung sind wesentliche Bestandteile des beruflichen Lernens. (S. 215)


Empirischer Beleg: Lernende mit hohem Feedback-Erhalt und positiver Einstellung zur Technologie nutzten das MOLJ signifikant häufiger. (S. 221)


Didaktische Implikationen: Die Implementierung digitaler Lernjournale sollte mit gezielten Schulungen für Lernende und Lehrende kombiniert werden. (S. 227)



7. Verschlagwortung




Schlagwort


Begründung




Technologieintegration


Untersuchung der Implementierung und Akzeptanz eines digitalen Lernjournals.




Lehr- und Lerneffektivität


Analyse der Auswirkungen auf Reflexion und Selbstregulierung im Lernprozess.




Bewertungsmethoden


Systematische Evaluierung der Nutzung und Effektivität des MOLJ durch quantitative und qualitative Methoden.





8. Kategorisierung
Kategorie: Kerngedanke


Kriterium: Die Studie beleuchtet elementare Mechanismen der Reflexionsförderung und Selbstregulierung in digitalen Lernumgebungen.


Beispiel: Das MOLJ ermöglicht eine strukturierte Reflexion über betriebliche Lernprozesse, wenn es aktiv genutzt wird. (S. 220)



9. Zuordnung zu einer Forschungsunterfrage (FU)
Passendste Forschungsunterfrage: FU6„Wie wird ein systemisch-konstruktivistisches Learning-Management-System als Kompetenzerwerbssystem bei Akteuren im digitalen Bildungsraum von Gesundheitsberufen beurteilt?“
Begründung:Die Studie untersucht, wie digitale Lernjournale die Reflexion und Selbstregulierung unterstützen, was direkte Parallelen zur systemisch-konstruktivistischen Gestaltung von LMS in der Gesundheitsbildung aufweist​Mauroux2014\_Article\_Mob….

10. Relevanzbewertung (1–5)
Relevanz: 5


Direkte Anwendbarkeit: Die Studie liefert wertvolle Erkenntnisse zur Nutzung und Optimierung digitaler Lernjournale im Bildungsbereich.


Technologieübertragbarkeit: Die Ergebnisse sind hochrelevant für LMS in der beruflichen und akademischen Ausbildung.


Innovationspotenzial: Die Erkenntnisse könnten zur Weiterentwicklung interaktiver Reflexions- und Feedbacksysteme in digitalen Bildungsplattformen beitragen.


},
	file = {Mauroux2014_Article_MobileAndOnlineLearningJournal.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/BPA4C65R/Mauroux2014_Article_MobileAndOnlineLearningJournal.pdf:application/pdf},
}

@article{van_merrienboer_taking_2003,
	title = {Taking the {Load} {Off} a {Learner}'s {Mind}: {Instructional} {Design} for {Complex} {Learning}},
	volume = {38},
	issn = {0046-1520, 1532-6985},
	shorttitle = {Taking the {Load} {Off} a {Learner}'s {Mind}},
	url = {https://www.tandfonline.com/doi/full/10.1207/S15326985EP3801_2},
	doi = {10.1207/S15326985EP3801_2},
	abstract = {Complex learning aims at the integration of knowledge, skills and attitudes; the coordination of qualitatively different constituent skills, and the transfer of what is learned to daily life or work settings. Recent instructional theories stress authentic learning tasks as the driving force for learning, but due to the complexity of those tasks learning may be hampered by the limited processing capacity of the human mind. This article presents a framework for scaffolding practice and just-in-time information presentation, aiming to effectively control cognitive load. It briefly describes a design model for complex learning consistent with cognitive load theory. Theoretical and practical implications of the presented framework are discussed.},
	language = {en-GB},
	number = {1},
	urldate = {2020-04-22},
	journal = {Educational Psychologist},
	author = {van Merrienboer, Jeroen J. G. and Kirschner, Paul A. and Kester, Liesbeth},
	month = jan,
	year = {2003},
	note = {http://web.archive.org/web/20200422112322/https://www.tandfonline.com/doi/abs/10.1207/S15326985EP3801\_2},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Bewertungsmethoden, Bildungstheorien, Promotion:Argumentation, Lernsystemarchitektur, Promotion:FU3, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {5--13},
	annote = {Analyse des Artikels „Taking the Load off a Learner's Mind: Instructional Design for Complex Learning“ von van Merriënboer et al. (2003)
1. Hauptthemen und Ziele der Forschung
Der Artikel untersucht die Herausforderungen und Lösungsansätze im Kontext komplexer Lernprozesse, insbesondere im Hinblick auf die Begrenzungen der menschlichen kognitiven Verarbeitungskapazität. Die Autoren präsentieren das 4C/ID-Modell (Four-Component Instructional Design) als theoretischen und praktischen Rahmen, der auf der Cognitive Load Theory (CLT) basiert. Ziel ist es, Lernumgebungen zu entwickeln, die die kognitive Belastung minimieren und gleichzeitig den Lerntransfer optimieren. Die drei Kernbereiche des Artikels sind:


Scaffolding Whole-Task Practice: Unterstützung durch abgestufte Aufgaben (von einfach zu komplex) und Beispiele (worked-out examples).


Just-in-Time Information Presentation: Zeitpunktgenaue Bereitstellung unterstützender und prozeduraler Informationen.


Instruktionsdesign: Ein systematisches Modell, das sowohl theoretische als auch praktische Erkenntnisse integriert.


2. Methoden und Datenquellen


Theoretischer Rahmen: Die Autoren verwenden die Cognitive Load Theory, die zwischen intrinsischer, extrinsischer und lernfördernder (germaner) kognitiver Belastung unterscheidet.


Designansatz: Das 4C/ID-Modell umfasst vier zentrale Komponenten:


Lernaufgaben: Authentische, ganzheitliche Aufgaben, die stufenweise in ihrer Komplexität gesteigert werden.


Unterstützende Informationen: Vorbereitendes Wissen, das für die Bearbeitung einer Aufgabenklasse erforderlich ist.


Prozedurale Informationen: Schritt-für-Schritt-Anleitungen, die während der Aufgabenbearbeitung bereitgestellt werden.


Teilaufgabenübungen: Automatisierung spezifischer Fertigkeiten durch isolierte Wiederholung.




3. Zentrale Forschungsergebnisse


Scaffolding Whole-Task Practice:


Komplexe Lernaufgaben werden durch vereinfachte Versionen eingeführt, um die intrinsische kognitive Belastung zu reduzieren.


Unterstützende Methoden wie worked-out examples und completion tasks minimieren die extrinsische Belastung und fördern die Schema-Konstruktion.


Die schrittweise Reduktion der Unterstützung („Fading“) erhöht die Selbstständigkeit der Lernenden.




Just-in-Time Information Presentation:


Supportive Information: Informationen mit hoher Komplexität werden vor Beginn der Bearbeitung bereitgestellt, um kognitive Überlastung zu vermeiden.


Procedural Information: Einfache, schrittweise Anweisungen werden bei Bedarf während der Bearbeitung gegeben, um die Aufmerksamkeit zu fokussieren.




Instruktionsdesign (4C/ID-Modell):


Lernaufgaben folgen einer „simple-to-complex“-Sequenzierung und integrieren unterstützende Informationen nahtlos.


Relevante Informationen werden just-in-time bereitgestellt, um sowohl den Lernprozess als auch die Leistung zu optimieren.





Zusammenfassung
Der Artikel liefert ein theoretisch fundiertes Modell zur Gestaltung von Lernumgebungen, das die Problematik der kognitiven Überlastung adressiert. Mit dem 4C/ID-Modell zeigen die Autoren, wie authentische und komplexe Lernaufgaben durch gezielte Unterstützung strukturiert und erleichtert werden können. Dies führt zu einem effektiveren und nachhaltigen Lernen, das auf den Transfer in reale Anwendungssituationen abzielt.

Kernaussagen


Ganzheitliche Lernaufgaben fördern den Transfer: Authentische und praxisnahe Aufgaben unterstützen die Integration von Wissen, Fähigkeiten und Einstellungen. (S. 3-5)


Kognitive Entlastung durch Unterstützung: Worked-out examples und completion tasks erleichtern den Einstieg und fördern die Schema-Konstruktion. (S. 9-10)


Optimale Informationszeitpunkte: Supportive Information vor der Bearbeitung und prozedurale Informationen während der Bearbeitung reduzieren extrinsische Belastung. (S. 15-17)


Fading von Unterstützungsmechanismen: Die stufenweise Reduktion von Hilfen fördert die Selbstständigkeit der Lernenden. (S. 10-12)



Argumentationslinien
Die Autoren argumentieren, dass die Begrenzung der kognitiven Verarbeitungskapazität durch geeignete Maßnahmen wie Scaffolding und just-in-time Informationsbereitstellung überwunden werden kann. Das 4C/ID-Modell verbindet kognitive Theorie mit praktikablen Designprinzipien, die insbesondere für das Lernen komplexer Fertigkeiten relevant sind. (S. 19-20)

Verschlagwortung


Lernsystemarchitektur:Begründung: Das 4C/ID-Modell liefert eine detaillierte Struktur, wie Lernsysteme durch sequenzierte Aufgabenklassen und adaptive Unterstützung gestaltet werden können, um kognitive Belastung zu reduzieren und den Transfer zu fördern. (S. 18)


Bildungstheorien:Begründung: Der Artikel basiert auf der Cognitive Load Theory und integriert Prinzipien aus der konstruktivistischen Lernforschung, wie z. B. das Scaffolding und die Gestaltung von ganzheitlichen Aufgaben. (S. 4-5)


Lehr- und Lerneffektivität:Begründung: Die beschriebenen Methoden, wie worked-out examples und Just-in-Time-Information, zielen darauf ab, die Effektivität von Lernprozessen durch die Optimierung kognitiver Ressourcen zu steigern. (S. 9-10)


Bewertungsmethoden:Begründung: Das Modell beinhaltet systematische Ansätze zur Bewertung von Lernaufgaben und deren kognitiver Belastung, um den Lernfortschritt zu fördern. (S. 12-13)



Kategorisierung
Kerngedanke: Effektive Lernumgebungen für komplexes Lernen erfordern ein integriertes Design, das kognitive Belastung minimiert und den Lerntransfer maximiert. (S. 20)

Zuordnung zur Forschungsunterfrage
Passendste Forschungsunterfrage:FU3: „Wie sind Konzeption und relevante didaktische und bildungstechnologische Merkmale des systemisch-konstruktivistischen Learning-Management-Systems für Akteure im digitalen Bildungsraum dargestellt?“
Begründung: Das 4C/ID-Modell bietet eine fundierte Grundlage für die Gestaltung von Lernumgebungen, insbesondere durch die Kombination aus systemischer Unterstützung und progressiver Komplexitätssteigerung, was direkt auf digitale Bildungssysteme anwendbar ist.

Relevanzbewertung


Hoch relevant (5): Der Artikel liefert fundierte theoretische und praktische Ansätze zur Gestaltung von Lernumgebungen, die direkt auf digitale Bildungssysteme übertragbar sind.


},
