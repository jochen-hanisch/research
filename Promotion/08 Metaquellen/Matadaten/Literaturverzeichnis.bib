@incollection{fuhrer_wege_2023,
	address = {Tübingen},
	series = {Schriftenreihe 2 der {Tübingen} {School} of {Education}},
	title = {Wege zu neuen {Bewertungssystemen} in der {Hochschullehre}: {Gameful} {Learning} und {Pädagogische} {Psychologie}},
	isbn = {978-3-946552-91-8},
	url = {https://publikationen.uni-tuebingen.de/xmlui/bitstream/handle/10900/144580/Relativität%20und%20Normativität%20von%20Beurteilungen.pdf?sequence=1&isAllowed=y},
	abstract = {Christian Fischer und Johanna Grad diskutieren in ihrem Beitrag "Wege zu neuen Bewertungssystemen in der Hochschullehre: Gameful Learning und Pädagogische Psychologie" die Einführung innovativer Lehr- und Bewertungsmethoden an Hochschulen.

Gameful Learning als innovativer Ansatz: Gameful Learning kombiniert Prinzipien des Game-Designs mit pädagogischer Psychologie und ist in Selbstbestimmungstheorie und Konstruktivismus verankert. Es zielt darauf ab, das Engagement, die intrinsische Motivation und die Lernerfolge der Studierenden zu verbessern, indem vielseitige Lernumgebungen geschaffen werden, die Autonomie, soziales Zugehörigkeitsgefühl und Kompetenz der Lernenden fördern.
Traditionelle Bewertungssysteme vs. Gameful Learning: Im Gegensatz zu traditionellen Bewertungssystemen, die sich auf normierte Kriterien und summative Evaluationen wie Klausuren und Tests stützen, erlaubt Gameful Learning den Studierenden, ihren Lernerfolg durch eine Vielzahl von Aktivitäten zu gestalten und zu beeinflussen. Beispielsweise können sie Punkte durch verschiedene Aktivitäten sammeln, um eine bestimmte Note zu erreichen.
Elemente des Gameful Learnings:
Autonomie: Studierende können aus verschiedenen Aufgaben wählen, um Punkte zu sammeln.
Soziale Zugehörigkeit: Gameful Learning fördert Gruppenarbeit und Kollaboration und betont aktives Lernen.
Kompetenz: Aufgaben bieten unterschiedliche Schwierigkeitsgrade und Herausforderungen und ermöglichen individuelle Lernerfahrungen.
Beispiel für Gameful Learning: Das Lernmanagement-System GradeCraft unterstützt diese Methode und bietet Funktionen wie einen Grade Predictor, der Studierenden hilft, ihren Lernweg zu planen und zu überwachen.
Positive Effekte von Gameful Learning: Studien zeigen, dass Studierende in Gameful Learning-Kursen bessere Noten erzielen, aktiver sind und ein stärkeres Gefühl der Kontrolle über ihre Bewertung haben. Diese Methode wird als fairer und effektiver im Vergleich zu herkömmlichen Notensystemen wahrgenommen.
Insgesamt argumentieren Fischer und Grad, dass Gameful Learning das Potenzial hat, die Lehr- und Lernprozesse im Hochschulbereich zu verbessern und zu unterstützen.},
	language = {de-DE},
	urldate = {2024-01-21},
	booktitle = {Relativität und {Normativität} von {Beurteilungen}: {Fachübergreifende} und fachspezifische {Analysen}},
	author = {Fischer, Christian and Grad, Johanna},
	editor = {Führer, Carolin and Magirius, Marco and Bohl, Thorsten and Grewe, Bernd-Stefan and Polleichtner, Wolfgang and Ulfat, Fahimah},
	year = {2023},
	keywords = {BZPG, Promotion:Literaturanalyse, Notfallsanitäter, \#1:Buchteil:learning:management:system, Prüfung, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {107--111},
}

@article{chen_early_2024,
	title = {Early detection of nasopharyngeal carcinoma through machine-learning-driven prediction model in a population-based healthcare record database},
	volume = {13},
	issn = {2045-7634},
	doi = {10.1002/cam4.7144},
	abstract = {OBJECTIVE: Early diagnosis and treatment of nasopharyngeal carcinoma (NPC) are vital for a better prognosis. Still, because of obscure anatomical sites and insidious symptoms, nearly 80\% of patients with NPC are diagnosed at a late stage. This study aimed to validate a machine learning (ML) model utilizing symptom-related diagnoses and procedures in medical records to predict nasopharyngeal carcinoma (NPC) occurrence and reduce the prediagnostic period.
MATERIALS AND METHODS: Data from a population-based health insurance database (2001-2008) were analyzed, comparing adults with and without newly diagnosed NPC. Medical records from 90 to 360 days before diagnosis were examined. Five ML algorithms (Light Gradient Boosting Machine [LGB], eXtreme Gradient Boosting [XGB], Multivariate Adaptive Regression Splines [MARS], Random Forest [RF], and Logistics Regression [LG]) were evaluated for optimal early NPC detection. We further use a real-world data of 1 million individuals randomly selected for testing the final model. Model performance was assessed using AUROC. Shapley values identified significant contributing variables.
RESULTS: LGB showed maximum predictive power using 14 features and 90 days before diagnosis. The LGB models achieved AUROC, specificity, and sensitivity were 0.83, 0.81, and 0.64 for the test dataset, respectively. The LGB-driven NPC predictive tool effectively differentiated patients into high-risk and low-risk groups (hazard ratio: 5.85; 95\% CI: 4.75-7.21). The model-layering effect is valid.
CONCLUSIONS: ML approaches using electronic medical records accurately predicted NPC occurrence. The risk prediction model serves as a low-cost digital screening tool, offering rapid medical decision support to shorten prediagnostic periods. Timely referral is crucial for high-risk patients identified by the model.},
	language = {eng},
	number = {7},
	journal = {Cancer Medicine},
	author = {Chen, Jeng-Wen and Lin, Shih-Tsang and Lin, Yi-Chun and Wang, Bo-Sian and Chien, Yu-Ning and Chiou, Hung-Yi},
	month = apr,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Promotion:Ausschluss, Humans, Adult, Machine Learning, Delivery of Health Care, Early Detection of Cancer, head and neck cancer, machine learning, nasopharyngeal carcinoma, Nasopharyngeal Carcinoma, Nasopharyngeal Neoplasms, prediagnostic, Promotion:S19, Promotion:S:19 Machine Learning, Promotion:Literaturverzeichnis},
	pages = {e7144},
	annote = {Analyse der Studie: "Early detection of nasopharyngeal carcinoma through machine-learning-driven prediction model in a population-based healthcare record database" von Chen et al. (2024)

1. Analyse
Hauptthemen und Ziele der Forschung
Die Studie von Chen et al. (2024) fokussiert auf die frühzeitige Erkennung des Nasopharynxkarzinoms (NPC) durch maschinelles Lernen (ML). Ziel ist es, ein prädiktives Modell zu entwickeln, das auf Basis von elektronischen Gesundheitsakten (EMR) Symptome und Prozeduren analysiert, um NPC frühzeitig zu erkennen und die prädiagnostische Periode zu verkürzen – insbesondere in endemischen Regionen wie Taiwan, wo über 80 \% der Fälle erst im Spätstadium diagnostiziert werdenChen et al. - 2024 - Ea….
Verwendete Methoden und Datenquellen


Datenquelle: National Health Insurance Research Database (NHIRD), Taiwan (2001–2008).


Studienpopulation: 22.186 Patientenakten, darunter NPC-Fälle und entsprechende Kontrollgruppe, in 1:1-Matching-Verfahren ausgewählt.


ML-Modelle: Fünf Algorithmen wurden verglichen: LightGBM, XGBoost, MARS, Random Forest, Logistische Regression.


Feature-Sets: Kombinationen aus demografischen Daten, ICD-9-Codes, klinischen Prozeduren und Laborwerten (insgesamt 14 Variablen im optimalen Modell).


Evaluation: AUROC, Spezifität, Sensitivität, SHAP-Werte zur Interpretation, Validierung auf unabhängiger Testkohorte (1 Million Personen)Chen et al. - 2024 - Ea….


Zentrale Forschungsergebnisse


Bester Algorithmus: LightGBM mit AUROC 0.83, Spezifität 0.81, Sensitivität 0.64.


Wichtige Prädiktoren: Alter, Geschlecht, nasale und auditive Symptome, Blutungszeichen, Kopfschmerz, Diagnosen und Behandlungsmaßnahmen im HNO-Bereich.


Validierung: Modell konnte Hochrisikopatienten identifizieren (Hazard Ratio 5.85), fünfjähriger Inzidenzunterschied signifikant.


Implikation: Das Modell ist kostengünstig, skalierbar und eignet sich zur Integration in nationale Systeme wie das „My Health Bank“-Portal für bevölkerungsweite ScreeningsChen et al. - 2024 - Ea….



2. Zusammenfassung
Die Studie entwickelt und validiert ein ML-basiertes Vorhersagemodell zur frühzeitigen Detektion von NPC auf Basis taiwanesischer EMR-Daten. Sie analysiert Daten aus 90 Tagen vor der Diagnose mit nur 14 erklärbaren Variablen. Das beste Modell (LightGBM) zeigt hohe prädiktive Leistung (AUROC 0.83). Die Autoren empfehlen den Einsatz zur Verbesserung der Zweitprävention und zur Verkürzung der Diagnosedauer – insbesondere in Hochrisikogebieten ohne etablierte Screening-Infrastruktur.

3. Kernaussagen


Frühe Diagnose von NPC ist kritisch: 80 \% der Patienten werden im Spätstadium diagnostiziert (S. 2–3).


ML-Modell kann NPC mit hoher Genauigkeit vorhersagen: LightGBM mit AUROC 0.83 bei nur 14 Variablen (S. 6–7).


Häufigste Prädiktoren: Alter, Geschlecht, HNO-spezifische Symptome (S. 6).


Modell geeignet für nationale Integration: z. B. in "My Health Bank" zur personalisierten Risikobewertung (S. 8–9).


Limitationen: Generalisierbarkeit eingeschränkt, da Taiwan-spezifische Datenstruktur; keine genetischen/Umweltfaktoren integriert (S. 9).



4. Argumentationslinien


Problemstellung: Hohe NPC-Spätdiagnosequote aufgrund unspezifischer Symptome und mangelnder Früherkennungssysteme (S. 3).


Methodologischer Lösungsansatz: EMR-Daten bieten symptombezogene Diagnosemuster, die ML auswerten kann (S. 3–4).


Modellvalidierung: Fea\_comb3 mit 14 Variablen optimal bzgl. klinischer Umsetzbarkeit und Performance (S. 5–6).


Interpretation mit SHAP: Modell ist erklärbar, variable Bedeutung nachvollziehbar (S. 6).


Anwendung: Modell für kosteneffiziente, großflächige Vorsorge nutzbar, besonders in Hochrisikopopulationen (S. 8).


Grenzen und Weiterentwicklung: Notwendigkeit zukünftiger Kohortenstudien mit erweiterten Risikofaktoren (S. 9).



5. Verschlagwortung


Technologieintegration: Einsatz von ML-Algorithmen in digitale Gesundheitsakten zur prädiktiven Modellierung.


Bewertungsmethoden: Einsatz von AUROC, SHAP, Sensitivität/Spezifität zur Leistungsbeurteilung.


Lehr- und Lerneffektivität: Indirekt relevant – zeigt, wie datenbasierte Systeme in der medizinischen Aus- und Weiterbildung zu diagnostischem Denken beitragen können.


Systemanpassung: Das Modell nutzt bestehende Systeme (NHIRD, My Health Bank) und zeigt Skalierbarkeit.


Forschungsansätze: Beispiel für interdisziplinären Forschungsansatz mit Methoden aus Medizin, Informatik und Epidemiologie.



6. Kategorisierung
Kategorie:Argumentation

Der Text nutzt eine gut strukturierte Argumentationslinie zur Rechtfertigung eines datengetriebenen Früherkennungsmodells, das mit existierenden Versorgungsstrukturen und ohne invasive Diagnostik praktikabel umsetzbar ist. Die Autoren belegen die Effektivität mit robusten Datenanalysen und kontrastieren diese mit Limitierungen bisheriger Verfahren.


7. Zuordnung zu Forschungsunterfrage
Passendste FU:FU5 – Welche Möglichkeiten und Grenzen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems durch Akteure im digitalen Bildungsraum von Gesundheitsberufen analysiert?
Begründung:Obwohl kein LMS im engeren Sinne untersucht wird, bietet die Studie methodische Parallelen zu digitalen Entscheidungsunterstützungssystemen im Gesundheitsbereich. Die Untersuchung der Umsetzbarkeit, Limitationen und Optimierungspotenziale einer ML-basierten Anwendung zur Verbesserung klinischer Abläufe und Früherkennung überträgt sich auf ähnliche Überlegungen in digitalen Lernsystemen.

8. Relevanzbewertung
Relevanz:3 – Mittelmäßig relevant

Die Studie bietet methodisch wertvolle Einblicke in die Integration von ML in digitale Systeme zur Entscheidungsunterstützung. Obwohl kein LMS untersucht wird, lassen sich die Erkenntnisse im Sinne der strukturellen Möglichkeiten und Herausforderungen auf die Bewertung digitaler Bildungssysteme übertragen. Der direkte Bezug zum Bildungskontext fehlt allerdings.

},
