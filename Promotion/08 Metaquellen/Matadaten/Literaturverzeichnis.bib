	url = {https://www.pedocs.de/frontdoor.php?source_opus=18471},
	doi = {10/grsthk},
	abstract = {Der Beitrag von Lisa Rupp, Benjamin Wulff und Kai-Christoph Hamborg beschäftigt sich mit der Wirkung der Sichtbarkeit von Mimik und Gestik des Vortragenden in Veranstaltungsaufzeichnungen auf die Lernleistung. (DIPF/Orig.)},
	language = {de-DE},
	urldate = {2023-02-17},
	publisher = {Waxmann},
