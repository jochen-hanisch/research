	file = {Schulze-Vorberg et al. - 2021 - Hinweise und Empfehlungen für die Konzeption von L.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/K4X6BTJ4/Schulze-Vorberg et al. - 2021 - Hinweise und Empfehlungen für die Konzeption von L.pdf:application/pdf},
