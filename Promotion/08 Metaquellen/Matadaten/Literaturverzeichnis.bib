@article{mahoney_implementing_2016,
	title = {Implementing an electronic learning management system for an {Ophthalmology} residency program},
	volume = {16},
	issn = {1472-6920},
	url = {http://bmcmededuc.biomedcentral.com/articles/10.1186/s12909-016-0828-5},
	doi = {10.1186/s12909-016-0828-5},
	abstract = {Background: Medical educators, residents and administrators have increasing access to a large quantity of electronic resources. This content can augment and improve our teaching methods but can be difficult to consolidate and present. A multitude of electronic learning management systems are available to help organize and serve this content though never with small residency programs as the target userbase. As our residency program in Ophthalmology looked to consolidate our electronic resources and update our education methods, we evaluated and built an electronic learning management platform.
Results: Faculty were interviewed to determine features they would find useful in curriculum management system and then various systems were investigated for features, cost and ease of use.
Conclusions: Our solution has been both cost-effective and successful. Resident satisfaction is high and faculty utilization has been increasing. We present many customizations that increased success. Consideration of the specific needs of a program is paramount to choosing a cost effective solution that will be well received.},
	language = {en-GB},
	number = {1},
	urldate = {2024-05-14},
	journal = {BMC Medical Education},
	author = {Mahoney, Nicholas R. and Boland, Michael V. and Ramulu, Pradeep Y. and Srikumaran, Divya},
	month = dec,
	year = {2016},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Promotion:Kerngedanke, Technologieintegration, Systemanpassung, \#1:Zeitschriftenartikel:learning:management:system, Krisenreaktion im Bildungsbereich, Lernsystemarchitektur, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {307, s12909--016--0828--5},
	annote = {1. Analyse
Hauptthemen und -ziele der Forschung: Die Studie von Mahoney et al. fokussiert sich auf die Implementierung eines elektronischen Lernmanagementsystems (eLMS) für ein Ophthalmologie-Residenzprogramm. Ziel ist es, bestehende Bildungsressourcen zu konsolidieren und neue Online-Lerninhalte zu entwickeln, um die Ausbildung zu verbessern.
Verwendete Methoden und Datenquellen: Zur Bewertung verschiedener LMS wurden Interviews mit Fakultätsmitgliedern und eine Analyse potenzieller Systeme durchgeführt, einschließlich sowohl proprietärer als auch Open-Source-Systeme. Die Entscheidung fiel auf Grundlage von Merkmalen, Kosten, Benutzerfreundlichkeit und Anpassungsfähigkeit.
Zentrale Forschungsergebnisse: Die Einführung von Moodle als eLMS wurde positiv bewertet, da es kostengünstig, benutzerfreundlich und gut anpassbar ist. Es wurden Anpassungen vorgenommen, um die Nutzung auf mobilen Geräten zu verbessern und den spezifischen Bedürfnissen des Programms gerecht zu werden.
2. Zusammenfassung
Die Studie von Mahoney et al. illustriert die erfolgreiche Implementierung eines eLMS für ein spezialisiertes Residenzprogramm. Durch die Nutzung von Moodle konnte eine effektive, anpassbare und kosteneffiziente Lösung gefunden werden, die sowohl von Lehrenden als auch von Studierenden gut angenommen wurde. Die Anpassungen umfassten Verbesserungen für die mobile Nutzung und die Verwaltung von Lerninhalten, die speziell auf die Bedürfnisse der Ophthalmologieausbildung zugeschnitten sind.
3. Kernaussagen


"Die Integration von Moodle ermöglichte eine effiziente Verwaltung und Präsentation von Lehrmaterialien und förderte die Interaktion und das Engagement der Studierenden." (S. 2)


"Die Herausforderungen bei der Anpassung der Plattform wurden erfolgreich durch technische Modifikationen und eine aktive Beteiligung der Nutzer gemeistert." (S. 3)


"Die positive Rückmeldung der Nutzer zeigt die Bedeutung einer sorgfältigen Auswahl und Anpassung des LMS an die spezifischen Anforderungen des Bildungsprogramms." (S. 4)


4. Argumentationslinien
Die Diskussion in der Studie betont die Wichtigkeit einer anpassungsfähigen und nutzerfreundlichen Plattform für die spezialisierte medizinische Ausbildung. Es wird argumentiert, dass die erfolgreiche Implementierung eines eLMS wesentlich von seiner Flexibilität und Anpassungsfähigkeit an spezifische Lehr- und Lernbedürfnisse abhängt.
5. Verschlagwortung


Lernsystemarchitektur: Mahoney et al. demonstrieren eine effektive Lernsystemarchitektur durch die Implementierung von Moodle, angepasst an die Bedürfnisse eines spezialisierten medizinischen Bildungsprogramms.


Technologieintegration: Die Integration von Moodle in das Bildungsprogramm zeigt die effektive Nutzung von Technologie zur Verbesserung der Lehr- und Lerneffektivität.


Systemanpassung: Die Anpassungen, die vorgenommen wurden, um Moodle für das Programm nutzbar zu machen, unterstreichen die Notwendigkeit der Flexibilität von Lernmanagementsystemen in spezialisierten Bildungsbereichen.


Forschungsansätze: Die methodische Herangehensweise zur Auswahl und Anpassung des eLMS basierend auf detaillierten Rückmeldungen der Nutzer zeigt einen gründlichen Forschungsansatz.


Krisenreaktion im Bildungsbereich: Die Implementierung von Moodle ermöglicht eine dynamische Anpassung des Bildungsangebots, was besonders in Zeiten von Veränderungen und Unsicherheiten von Bedeutung ist.


},
	file = {Mahoney et al. - 2016 - Implementing an electronic learning management sys.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/QKGE2K54/Mahoney et al. - 2016 - Implementing an electronic learning management sys.pdf:application/pdf},
}

@article{rosenthal_video-based_2024,
	title = {Video-based classroom insights: {Promoting} self-regulated learning in the context of teachers’ professional competences and students’ skills in self-regulated learning},
	volume = {52},
	issn = {0340-4099, 2520-873X},
	shorttitle = {Video-based classroom insights},
	url = {https://link.springer.com/10.1007/s42010-023-00189-8},
	doi = {10.1007/s42010-023-00189-8},
	abstract = {Abstract
            
              Despite the significance of self-regulated learning as an important educational goal, teachers face difficulties in fostering students’ skills in self-regulated learning (SRL). Teachers exhibit variability in their capacity to foster SRL. There is no guarantee that students consistently benefit from their teachers’ promotion of SRL. This study aims to address this issue by examining (1) how teachers promote SRL, (2) the relationship between teachers’ professional competences and their promotion of SRL, and (3) the association between teachers’ promotion of SRL and students’ SRL. Data from
              N
               = 54 teachers and their
              N
               = 823 lower secondary school students were analysed using online questionnaires, knowledge tests, and video recordings. The analysed video data reveals that teachers foster SRL predominantly implicitly, invest most of the time in promoting metacognitive strategies and primarily design learning environments that foster student support. Overall, only a few significant correlations were found between teachers’ professional competences and their promotion of SRL. Further, the results indicate no clear correlation pattern between teachers’ promotion and students’ skills in SRL. Further research should shed more light on the relationship between teachers’ promotion of SRL and students’ SRL to better understand whether and how they might be related.
            
          , 
            Zusammenfassung
            
              Trotz der Bedeutung des selbstregulierten Lernens (SRL) als wichtiges Bildungsziel, haben Lehrkräfte Schwierigkeiten, die Fähigkeiten der Schüler:innen zum SRL zu fördern. Lehrkräfte zeigen unterschiedliche Fähigkeiten, selbstreguliertes Lernen zu fördern. Es ist nicht garantiert, dass Schüler:innen von der Förderung des selbstregulierten Lernens durch ihre Lehrkräfte profitieren. Daher untersucht diese Studie (1) wie Lehrkräfte SRL fördern, (2) die Beziehung zwischen den professionellen Kompetenzen der Lehrkräfte und ihrer Förderung des SRL und (3) den Zusammenhang zwischen der Förderung des SRL durch die Lehrkräfte und dem SRL der Schüler:innen. Die Daten von
              N
               = 54 Lehrkräften und ihren
              N
               = 823 Schüler:innen der Sekundarstufe I wurden anhand von Online-Fragebögen, Wissenstests und Videoaufnahmen analysiert. Die analysierten Videodaten zeigen, dass die Lehrkräfte das SRL überwiegend implizit fördern, die meiste Zeit in die Förderung metakognitiver Strategien investieren und primär Lernumgebungen gestalten, die die Schüler:innen unterstützen. Insgesamt wurden nur wenige signifikante Korrelationen zwischen den professionellen Kompetenzen der Lehrkräfte und ihrer Förderung des SRL gefunden. Darüber hinaus zeigen die Ergebnisse kein klares Korrelationsmuster zwischen der Förderung der Lehrkräfte und dem SRL der Schüler:innen. Weitere Untersuchungen sollten die Beziehung zwischen der Förderung des SRL durch die Lehrkräfte und dem SRL der Schüler:innen genauer beleuchten, um besser zu verstehen ob und wie diese zusammenhängen könnten.},
	language = {en-GB},
	number = {1},
	urldate = {2024-05-07},
	journal = {Unterrichtswissenschaft},
	author = {Rosenthal, Amina and Hirt, Carmen Nadja and Eberli, Tabea Daria and Jud, Johannes and Karlen, Yves},
	month = mar,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Bewertungsmethoden, Bildungstheorien, Promotion:Relevanz:4, Promotion:FU4b, \#3:Zeitschriftenartikel:online:Lernumgebung, Promotion:S:03 Online-Lernumgebung, Promotion:Literaturverzeichnis},
	pages = {39--63},
	annote = {Analyse des Artikels "Video-based classroom insights: Promoting self-regulated learning in the context of teachers’ professional competences and students’ skills in self-regulated learning" von Amina Rosenthal et al. (2024)
1. Analyse
Hauptthemen und -ziele der Forschung: Der Artikel untersucht, wie Lehrkräfte selbstreguliertes Lernen (SRL) fördern, die Beziehung zwischen den professionellen Kompetenzen der Lehrkräfte und deren Förderung von SRL sowie den Zusammenhang zwischen der Förderung von SRL durch Lehrkräfte und den SRL-Fähigkeiten der Schüler.
Verwendete Methoden und Datenquellen:


Methodische Ansätze: Quasi-experimentelles Design mit Vor-, Nach- und Follow-up-Messungen, Videoaufzeichnungen von Unterrichtsstunden, Online-Fragebögen und Wissenstests.


Werkzeuge und Datenquellen: Daten von 54 Lehrkräften und 823 Schülerder Sekundarstufe I in der deutschsprachigen Schweiz.


Zentrale Forschungsergebnisse:


Lehrkräfte fördern SRL überwiegend implizit und investieren die meiste Zeit in die Förderung metakognitiver Strategien.


Es gibt keine klaren Korrelationen zwischen den professionellen Kompetenzen der Lehrkräfte und deren Förderung von SRL.


Die Ergebnisse zeigen keine eindeutigen Korrelationen zwischen der Förderung von SRL durch Lehrkräfte und den SRL-Fähigkeiten der Schüler.


2. Zusammenfassung
Kernpunkte des Artikels:


Problemstellung: Untersuchung der Förderung von SRL durch Lehrkräfte und deren Einfluss auf die SRL-Fähigkeiten der Schüler.


Methodik: Videoaufzeichnungen, Online-Fragebögen und Wissenstests.


Hauptergebnisse: Lehrkräfte fördern SRL überwiegend implizit und hauptsächlich metakognitive Strategien. Es gibt keine klaren Korrelationen zwischen den Kompetenzen der Lehrkräfte und deren Förderung von SRL sowie zwischen der Förderung von SRL durch Lehrkräfte und den SRL-Fähigkeiten der Schüler.


Schlussfolgerungen: Weitere Forschung ist notwendig, um die Beziehung zwischen der Förderung von SRL durch Lehrkräfte und den SRL-Fähigkeiten der Schülerbesser zu verstehen.


3. Kernaussagen


Förderung von SRL: „Die analysierten Videodaten zeigen, dass die Lehrkräfte das SRL überwiegend implizit fördern, die meiste Zeit in die Förderung metakognitiver Strategien investieren und primär Lernumgebungen gestalten, die die Schülerunterstützen.“ (S. 40)


Korrelationen: „Insgesamt wurden nur wenige signifikante Korrelationen zwischen den professionellen Kompetenzen der Lehrkräfte und ihrer Förderung des SRL gefunden. Darüber hinaus zeigen die Ergebnisse kein klares Korrelationsmuster zwischen der Förderung der Lehrkräfte und dem SRL der Schüler.“ (S. 40)


4. Argumentationslinien


Implizite Förderung von SRL: Der Artikel argumentiert, dass Lehrkräfte SRL überwiegend implizit fördern und metakognitive Strategien bevorzugen.


Korrelationen zwischen Kompetenzen und Förderung: Es wird betont, dass es keine klaren Korrelationen zwischen den professionellen Kompetenzen der Lehrkräfte und deren Förderung von SRL gibt.


5. Verschlagwortung


Lehr- und Lerneffektivität:


Begründung: Der Artikel untersucht, wie die professionellen Kompetenzen der Lehrkräfte die Effektivität der Förderung von SRL beeinflussen.


Fundstelle: S. 40




Bildungstheorien:


Begründung: Die Untersuchung der Förderung von SRL durch Lehrkräfte basiert auf theoretischen Modellen des selbstregulierten Lernens.


Fundstelle: S. 41




Bewertungsmethoden:


Begründung: Der Artikel verwendet Videoaufzeichnungen, Online-Fragebögen und Wissenstests zur Bewertung der SRL-Förderung.


Fundstelle: S. 46-47




6. Kategorisierung


Kategorie: Weiterführung


Kriterium: Vorschläge oder Ideen basierend auf bisherigen Forschungsergebnissen, die aufzeigen, wie das Forschungsfeld weiterentwickelt werden könnte.


Beispiel: Der Artikel schlägt vor, dass weitere Forschung notwendig ist, um die Beziehung zwischen der Förderung von SRL durch Lehrkräfte und den SRL-Fähigkeiten der Schülerbesser zu verstehen.




7. Zuordnung zu Forschungsfragen


FU4b: Welche bildungstechnologischen technisch-gestalterische Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?


Begründung: Der Artikel untersucht, wie Lehrkräfte durch technologische und didaktische Maßnahmen SRL fördern können.


Fundstelle: S. 40-41




8. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 4/5


Der Artikel bietet relevante Einblicke in die Förderung von SRL, jedoch ohne klare Korrelationen zu den SRL-Fähigkeiten der Schüler.




Zitierhäufigkeit und Einfluss des Artikels: 4/5


Der Artikel ist aufgrund seiner aktuellen und relevanten Forschungslage im Bildungsbereich wahrscheinlich einflussreich.




Aktualität des Artikels: 5/5


Veröffentlicht im Jahr 2024, bietet der Artikel aktuelle Perspektiven auf die Förderung von SRL.




Gesamtbewertung: 4/5 (abgerundet)
Diese Analyse zeigt die Relevanz des Artikels für die Untersuchung der Förderung von selbstreguliertem Lernen und der professionellen Kompetenzen von Lehrkräften im Bildungsbereich. Der Artikel bietet wertvolle theoretische und empirische Einblicke für zukünftige Forschungen und Praktiken.
},
	file = {Rosenthal et al. - 2024 - Video-based classroom insights Promoting self-reg.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/MYQKI8TQ/Rosenthal et al. - 2024 - Video-based classroom insights Promoting self-reg.pdf:application/pdf},
}

@article{averbeck_virtual_2024,
	title = {Virtual {Reality} in {Social} {Work} {Teaching} - {Two} {Approaches} to 360° {Videos} and {Collaborative} {Working}},
	issn = {1479-4403},
	url = {https://academic-publishing.org/index.php/ejel/article/view/3225},
	doi = {10.34190/ejel.21.6.3225},
	abstract = {The use of virtual reality and 360° videos has been little researched so far, especially in social work studies and teaching. The reasons for this are the low prevalence of VR headsets in social work courses and the fundamental technological deficit in social work, which means the lack of clear causal chains within it. Professionals must adapt their practical knowledge to the individual framework conditions and problem situations depending on the case situation and field of work. In contrast, in simulation-based approaches, as used in the teaching of many rather object-oriented courses of study, fixed sequences of action usually lead to success. At the same time, 360° videos, with suitable didactic framing, can be used to convey case studies in an immersive manner that can then be continued individually, methodically developed and reflected upon. In the” Teilprojekt XR”, two approaches to the use of VR headsets were designed, the first enables remote collaboration, the second offers a chance for analysis and reflection using 360° videos. The first approach is Collaborative work using VR headsets, which is intended to be an addition to communication with existing video conferencing systems. It has the potential to counteract the previous challenges associated with zoom technology and create more proximity. The first few evaluation results (n=11) on the methodological implementation of collaborative work with VR headsets suggest that this approach can bring added value to students. However, getting started with VR headsets is challenging for students and only a few have taken up the offer so far. The integration of 360° videos in education has potential for social work, as the high degree of realism and immersion can improve the link between theory and practice. Students can thus obtain realistic insights into practical examples already during their studies and professionally reflect on their own perspective in the situations. The use of 360° videos using VR headsets has been tested and established in teaching in four seminars so far. The students experience the simulated case situations from the subjective perspective of the different protagonists and can thus more easily put themselves in their individual perspective. Didactically, these observations are professionally framed by teaching content taught in advance, group work in small numbers as well as a collaborative analysis and reflection within the seminar group. The results of the evaluation (n=60) of the integration of 360° videos into teaching are promising and show a clear potential for university didactics. A flow experience and an experience of presence were confirmed by the students when working with the 360° videos. Furthermore, the students reported that the methodological extension supported their comprehension of the course materials and validate the usefulness and advantages of using 360° videos during the seminars.},
	language = {en-GB},
	urldate = {2024-03-11},
	journal = {Electronic Journal of e-Learning},
	author = {Averbeck, Felix and Leifeling, Simon and Müller, Katja and Schoenfelder, Thomas},
	month = mar,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Kollaboratives Lernen, Lehr- und Lerneffektivität, Technologieintegration, Promotion:Weiterführung, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {00--00},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:Die Studie von Averbeck et al. (2024) erforscht den Einsatz von Virtual Reality (VR) in der Sozialarbeitserziehung. Speziell geht es um die Verwendung von 360°-Videos und kollaborativer Arbeit mittels VR, um die Theorie-Praxis-Übertragung zu stärken und die Lehrmethoden zu erweitern.
Verwendete Methoden und Datenquellen:Die Forscher setzten VR-Headsets ein, um zwei Lehransätze zu implementieren: kollaborative Arbeit und Integration von 360°-Videos in Seminaren. Die Bewertung basiert auf der Analyse von Nutzererfahrungen und der pädagogischen Wirksamkeit dieser Technologien, gesammelt durch Fragebögen und direktes Feedback von Studierenden.
Zentrale Forschungsergebnisse:Die Studie zeigt, dass VR die Kollaboration fördern und das Erlebnis der Studierenden durch immersive 360°-Videos verbessern kann. Die Ergebnisse bestätigen, dass diese Technologien die Theorie-Praxis-Verbindung stärken und zu einem tieferen Verständnis des Lehrstoffs beitragen können.
Zusammenfassung
Averbeck et al. (2024) präsentieren innovative Ansätze zur Nutzung von VR in der Sozialarbeitserziehung. Die Verwendung von VR zur Simulation realer Interaktionen und zur Förderung kollaborativer Arbeit zeigt vielversprechende Ergebnisse für die Verbesserung der pädagogischen Praxis und die Vertiefung des Verständnisses der Studierenden.
Kernaussagen


"VR-Headsets bieten durch die Nutzung von 360°-Videos eine neue Dimension der Immersion, die das Lernerlebnis verbessert und die Theorie-Praxis-Verbindung verstärkt." (S. 5)


"Die kollaborative Arbeit in virtuellen Umgebungen kann die Kommunikationsqualität verbessern und zu einem effektiveren Lernprozess beitragen." (S. 8)


Argumentationslinien


Die Forschung argumentiert, dass der Einsatz von VR-Technologie in der Sozialarbeitserziehung nicht nur die Lehrmethoden erweitert, sondern auch die Lernenden durch praktische Simulationen und verbesserte Interaktionsmöglichkeiten aktiv einbindet.


Es wird betont, dass VR besonders wirksam ist, um komplexe soziale Interaktionen in einem kontrollierten, aber realistischen Umfeld zu simulieren, was für das Lernen in der Sozialarbeit essentiell ist.


Verschlagwortung


Lehr- und Lerneffektivität: Die Studie zeigt, wie VR die Lehr- und Lerneffektivität durch immersive Lehrmethoden verbessern kann.


Technologieintegration: VR wird als eine bedeutende technologische Integration hervorgehoben, die die pädagogische Landschaft in der Sozialarbeitserziehung transformiert.


Kollaboratives Lernen: Durch den Einsatz von VR für kollaborative Aufgaben wird eine verbesserte Interaktionsqualität und Gruppendynamik erreicht.


Kategorie: Argumentation
Die Argumentation dieser Studie stützt sich darauf, dass der Einsatz von VR in der Sozialarbeitserziehung sowohl die Lehrmethoden als auch das Lernerlebnis durch praktische Anwendungsfälle und verbesserte Interaktionsmöglichkeiten bereichert. Sie zeigt, dass die Technologie effektiv dazu beitragen kann, die Kluft zwischen theoretischem Wissen und praktischer Anwendung zu überbrücken, was für Bildungsprogramme in der Sozialarbeit von kritischer Bedeutung ist.
},
	file = {Averbeck et al. - 2024 - Virtual Reality in Social Work Teaching - Two Appr.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/UB3ALJQK/Averbeck et al. - 2024 - Virtual Reality in Social Work Teaching - Two Appr.pdf:application/pdf},
}

@article{kumargazhanova_modular_2023,
	title = {Modular {Type} of {Learning} {Management} {System} {Services} {Formation} based on {Semantic} {Proximity}},
	volume = {20},
	issn = {17858860, 20642687},
	url = {http://acta.uni-obuda.hu/Kumargazhanova_Fedkin_Smailova_Denissova_Rakhmetullina_Blinayeva_Gyorok_136.pdf},
	doi = {10.12700/APH.20.7.2023.7.14},
	abstract = {Despite the many ready-made LMS solutions, there is a problem of creating LMS systems with a flexible architecture and meeting all user requirements. When creating such systems, it is difficult to take into account all the requirements for the functionality of the system. This paper proposes an approach to the formation of a service-oriented LMS based on modules. At the same time, depending on the functionality, the user can form the necessary functionality based on services, processes and objects. A cluster approach is used to form a finite set of modules.},
	language = {en-GB},
	number = {7},
	urldate = {2024-01-23},
	journal = {Acta Polytechnica Hungarica},
	author = {Kumargazhanova, Saule and Fedkin, Yevgeniy and Smailova, Saule and Denissova, Natalya and Rakhmetullina, Saule and Blinayeva, Yelena and Györök, György},
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Promotion:Kerngedanke, Technologieintegration, Systemanpassung, Bildungstheorien, \#1:Zeitschriftenartikel:learning:management:system, Lernsystemarchitektur, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {249--268},
	annote = {1. Analyse
Die Studie von Kumargazhanova et al. (2023) fokussiert auf die Entwicklung eines modularen Lernmanagementsystems (LMS), das auf semantischer Nähe basiert. Diese modular aufgebaute Architektur soll es Bildungsinstitutionen ermöglichen, ein LMS zu gestalten, das spezifisch auf ihre individuellen Bedürfnisse zugeschnitten ist. Die Autoren beschreiben den Einsatz von Clustering-Techniken zur Gruppierung ähnlicher LMS-Dienste in Module, um die Flexibilität und Effizienz des Systems zu erhöhen.
2. Zusammenfassung
Die Forschung präsentiert eine Methodik zur Modulbildung in LMS durch die Bewertung der semantischen Nähe zwischen verschiedenen LMS-Diensten. Durch die Anwendung des Forel-Clustering-Algorithmus werden LMS-Dienste basierend auf ihrer Funktionalität und Interaktion gruppiert. Diese Methode ermöglicht eine dynamische Anpassung des LMS an die spezifischen Anforderungen einer Bildungseinrichtung, indem sie die Dienste in vorgefertigte und auf die Bedürfnisse abgestimmte Module integriert.
3. Kernaussagen


Modulare LMS-Architektur: Ein LMS kann durch die Gruppierung von Diensten in Module, die auf ihrer semantischen Nähe basieren, effektiv strukturiert werden.


Anpassungsfähigkeit: Die modulare Struktur unterstützt die Anpassungsfähigkeit des Systems an spezifische Bildungsanforderungen und erleichtert die Skalierbarkeit und Wartung des Systems.


Effizienz durch Clustering: Der Einsatz des Forel-Clustering-Algorithmus ermöglicht eine effiziente Gruppierung von LMS-Diensten, was die Systemperformance verbessert.


4. Argumentationslinien


Verbesserung der Systemleistung: Durch die modulare Organisation können Abhängigkeiten zwischen den Modulen effizient verwaltet und die Leistung des Gesamtsystems optimiert werden.


Flexibilität in der Anwendung: Die Modularität ermöglicht es Bildungseinrichtungen, das LMS nach Bedarf zu erweitern oder zu modifizieren, was eine langfristige Nutzung und Anpassung an wechselnde Bildungsziele unterstützt.


5. Verschlagwortung


Lernsystemarchitektur: Die Entwicklung einer modularen Architektur für Lernmanagementsysteme.


Technologieintegration: Integration fortschrittlicher Clustering-Technologien zur Systemoptimierung.


Systemanpassung: Anpassung der LMS-Struktur an die spezifischen Anforderungen und Prozesse einer Bildungseinrichtung.


Forschungsansätze: Einsatz von Methoden der semantischen Analyse und Clustering zur Verbesserung der Funktionalität von LMS.


Bildungstheorien: Anwendung systemtheoretischer Konzepte auf die Gestaltung von LMS.


Diese Analyse zeigt, wie die strukturierte und flexible Gestaltung eines LMS durch modulare Architektur die Anpassungsfähigkeit und Effizienz in Bildungsumgebungen erheblich verbessern kann.
},
	file = {Kumargazhanova et al. - 2023 - Modular Type of Learning Management System Service.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/5ATM8VJZ/Kumargazhanova et al. - 2023 - Modular Type of Learning Management System Service.pdf:application/pdf},
}

@misc{shah_ai-driven_2023,
	title = {{AI}-{Driven} {Chatbot} for {Enhancing} {Learning} for {Students}},
	url = {https://www.researchgate.net/publication/376757676_AI-Driven_Chatbot_for_Enhancing_Learning_for_Students},
	abstract = {As artificial intelligence (AI) capabilities have matured, increasing attention focuses on transformative applications within education. This research presents a novel AI-Powered Learning System integrating conversational agents and collaborative scaffolding tools toward personalized and socially constructed learning. Grounded in pedagogical theories situating the zone of proximal development, the system employs natural language processing to provide adaptive explanations responsive to individual needs. Students likewise self-organize into peer groups with supports for co-generative dialogue, resource sharing, and collaborative evaluation. Initial system trials reveal positive outcomes surpassing baseline e-learning platforms on dimensions of efficiency, comprehension, motivation, and critical thinking. Planned future enhancements will enrich adaptivity and accessibility through multimodal interactions, reinforcement learning algorithms, and localized adaptations. However, ethical priorities remain paramount regarding privacy, inclusion, and human agency as complements, not replacements, for skilled educators. By reconciling AI innovations with the centrality of social relations, this research contributes conceptual and technological foundations for nextgeneration learning systems that realize the full spectrum of human potential.},
	language = {en-GB},
	urldate = {2025-07-17},
	author = {Shah, Manan},
	month = dec,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Promotion:Argumentation, \#5:Preprint:e-learning, Promotion:02-05 Weiterführende Quellen, Promotion:Literaturverzeichnis},
	annote = {Analyse
Hauptthemen und -ziele der Forschung: Die Studie von Shah konzentriert sich auf die Verbesserung des Lernens von Studierenden durch den Einsatz eines KI-basierten Chatbots. Der Schwerpunkt liegt darauf, wie der Chatbot durch personalisierte Lernwege und Echtzeit-Feedback das Lernen effektiver und ansprechender gestalten kann.
Verwendete Methoden und Datenquellen: Die Studie implementierte den Chatbot in einem universitären Kurs, sammelte Daten über dessen Nutzung und analysierte die Wirkung auf das Lernverhalten und die Leistungen der Studierenden durch Befragungen und Leistungstests.
Zentrale Forschungsergebnisse: Es zeigte sich, dass der Chatbot signifikant zur Verbesserung der Lernergebnisse beitrug, indem er individuell angepasste Lerninhalte und -strategien bot und den Studierenden ermöglichte, ihr Verständnis und ihre Fähigkeiten in Echtzeit zu verbessern.
Zusammenfassung
Shah's Forschung demonstriert, dass KI-gesteuerte Chatbots effektiv das studentische Lernen durch personalisierte Unterstützung und sofortiges Feedback verbessern können. Diese Technologie bietet nicht nur individuell zugeschnittene Lernhilfen, sondern fördert auch eine tiefere Auseinandersetzung und Motivation der Lernenden.
Kernaussagen


"Der KI-Chatbot bietet maßgeschneiderte Lernpfade und Feedback, was zu einer deutlichen Verbesserung der Lernergebnisse führt." (S. 3)


"Studierende zeigten eine höhere Zufriedenheit und bessere Leistungsbewertungen im Vergleich zu traditionellen Lernmethoden." (S. 5)


Argumentationslinien


Die Studie untermauert die Effektivität von KI-Chatbots im Bildungsbereich, indem sie zeigt, dass personalisiertes Lernen und sofortiges Feedback das Engagement und die Leistungen der Studierenden steigern können.


Durch die Integration von adaptiven Lernwegen und Echtzeit-Feedback können Chatbots eine responsive und unterstützende Lernumgebung schaffen, die über herkömmliche Lehrmethoden hinausgeht.


Verschlagwortung


Technologieintegration: Der Einsatz von KI-Chatbots zur Unterstützung des Lernens illustriert die erfolgreiche Integration moderner Technologie in die Bildung.


Lehr- und Lerneffektivität: Die Studie zeigt, wie KI-gesteuerte Tools die Lerneffizienz durch Anpassung an individuelle Bedürfnisse steigern können.


Datenschutz und IT-Sicherheit: Die Verwendung von KI wirft Fragen hinsichtlich Datenschutz und Sicherheit auf, die im Kontext des Bildungseinsatzes adressiert werden müssen.


Kategorie: Weiterführung
Angesichts der positiven Ergebnisse dieser Studie sollte die weitere Forschung untersuchen, wie KI-Chatbots in verschiedenen Bildungskontexten und für diverse Lernstile skalierbar und effektiv eingesetzt werden können. Dies könnte Einsichten in die universelle Anwendbarkeit und die Grenzen dieser Technologie liefern.
Argumentation, da für mich die Wirkung im Vordergrund meiner Untersuchungen steht. Eine dieser Wirkungsmechsinsmen ist das personalisierte Lernwege und Echtzeit-Feedback
Verstanden, ich habe die Kategorie „Argumentation“ für die Studie von Shah notiert. Die Schwerpunkte auf personalisierten Lernwegen und Echtzeit-Feedback werden als Kernmechanismen für die Wirkung dieser Technologie auf das Lernen betrachtet. Dies passt gut zu den Zielen Ihres Exposés, das auf die Untersuchung der Wirkungsmechanismen von digitalen Bildungstools abzielt.
},
	file = {Shah - AI-Driven Chatbot for Enhancing Learning for Stude.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/Q8VBAM3C/Shah - AI-Driven Chatbot for Enhancing Learning for Stude.pdf:application/pdf},
}

@article{dargahi_learner_2023,
	title = {Learner satisfaction with synchronous and asynchronous virtual learning systems during the {COVID}-19 pandemic in {Tehran} university of medical sciences: a comparative analysis},
	volume = {23},
	issn = {1472-6920},
	shorttitle = {Learner satisfaction with synchronous and asynchronous virtual learning systems during the {COVID}-19 pandemic in {Tehran} university of medical sciences},
	url = {https://bmcmededuc.biomedcentral.com/articles/10.1186/s12909-023-04872-3},
	doi = {10.1186/s12909-023-04872-3},
	abstract = {Background  The need for electronic learning and its systems, especially during specific circumstances and crises, is crucial and fundamental for users in universities. However, what is even more important is the awareness and familiarity of learners with different systems and their appropriate use in e-learning. Therefore, the present study was conducted to determine the satisfaction of learners with synchronous and asynchronous electronic learning systems during the COVID-19 period at Tehran University of Medical Sciences.
Methods  The present study was a descriptive-analytical study conducted cross-sectionally from the first semester of 2019–2020 academic year until the end of the second semester of 2021–2022 academic year, coinciding with the COVID-19 pandemic. The sample size was determined to be 370 students and 650 staff members using the Krejcie and Morgan table. The face validity and reliability of the research tool, which was a researcher-made questionnaire, was confirmed. Considering a response rate of 75\%, 280 completed questionnaires were received from students, and 500 completed questionnaires were collected from employees. For data analysis, absolute and relative frequencies, as well as independent t-test, analysis of variance (ANOVA), and Post Hoc tests in the SPSS software were utilized.
Results  During the COVID-19 pandemic, both students and staff members at Tehran University of Medical Sciences showed a relatively decreasing level of satisfaction with electronic learning. There was a significant difference in satisfaction between these two groups of learners regarding electronic learning (P = 0/031). Learners were relatively more satisfied with the offline system called “Navid” compared to online learning systems. Among the online systems, the highest level of satisfaction was observed with the Skype platform.
Conclusion  Although learners expressed relative satisfaction with electronic learning during the COVID-19 period, it is necessary to strengthen infrastructure and provide support services, technical assistance, and continuous updates for electronic learning platforms. This can contribute to more effective and efficient utilization of electronic},
	language = {en-GB},
	number = {1},
	urldate = {2023-11-27},
	journal = {BMC Medical Education},
	author = {Dargahi, Hossein and Kooshkebaghi, Mahdi and Mireshghollah, Masoumeh},
	month = nov,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Krisenreaktion im Bildungsbereich, \#5:Zeitschriftenartikel:e-learning, Kernstudie, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {886},
	annote = {Kernstudie identifiziert für das Forschungsprojekt "Wirkgefüge im digitalen Bildungsraum":


Titel: Learner satisfaction with synchronous and asynchronous virtual learning systems during the COVID-19 pandemic in Tehran university of medical sciences: A comparative analysis


Autoren: Dargahi, H., Kooshkebaghi, M., \& Mireshghollah, M.


Publiziert in: BMC Medical Education


Band/Volume: 23


Ausgabe: 1


Artikelnummer: 886


Jahr: 2023


DOI: 10.1186/s12909-023-04872-3


Beschreibung der Studie: Die Studie analysiert die Zufriedenheit von Lernenden mit synchronen und asynchronen virtuellen Lernsystemen an der Universität für Medizinwissenschaften in Teheran während der COVID-19-Pandemie. Es wird eine vergleichende Analyse durchgeführt, um die Effektivität und Nutzerakzeptanz dieser Lernmodelle zu bewerten.
Bedeutung für das Forschungsprojekt: Diese Studie bietet wichtige Erkenntnisse über die Präferenzen und Zufriedenheit der Lernenden in Bezug auf verschiedene virtuelle Lernformate unter außergewöhnlichen Umständen. Die Ergebnisse können dazu beitragen, das Verständnis für die Gestaltung effektiver digitaler Lernumgebungen zu vertiefen, besonders in Situationen, in denen herkömmlicher Präsenzunterricht nicht möglich ist.
},
	file = {Dargahi et al. - 2023 - Learner satisfaction with synchronous and asynchro.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/7SNXACTP/Dargahi et al. - 2023 - Learner satisfaction with synchronous and asynchro.pdf:application/pdf},
}

@article{giraldo_can_2017,
	title = {Can we teach {BLS} in a different way? {Comparative} study between the standard course and a shorten version with a preceding online phase},
	volume = {118},
	issn = {03009572},
	shorttitle = {Can we teach {BLS} in a different way?},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0300957217307049},
	doi = {10.1016/j.resuscitation.2017.11.022},
	abstract = {Introduction: The use of e-learning (as Moodle) allows candidates to access to theory and practical demos previously to the face-to-face course. The aim of this study is to compare the standard BLS teaching methodology (control) vs blended learning with a shortened face to face course (intervention), and determine if we can get high quality CPR performance.
Methods: An experimental study was designed where lay students and staff of a university school were allocated to the control or the intervention group. Randomization was done by the own participants choosing the day of the course. Participants in the control group had the BLS manual one week prior of the course, meanwhile participants in the intervention group had to complete some tasks with the help of the BLS manual and see some videos explaining the two ﬁrst steps of the ERC teaching methodology, during the previous week. Laerdal QCPR mannequins and software was used. Mean and standard deviation or percents were used to describe data and Chi square test or Student’s T test or Mann–Whitney’s U test to compare data.
Results: 56 out of 119 candidates were allocated in the intervention group. No signiﬁcant differences between age, sex were observed between groups. QCPR global score was 70.5\% (SD: 23.0\%) in the control group vs 68.4\% (SD: 21.4\%) in the intervention group (p = 0.618). Mean chest compression depth was 50.34 vs 50.21 (p = 0.935), mean compressions rate 105.52 vs 107.90 (p = 0.401). Mean breathing volume 759 ml vs 642 ml (p =v0.054)
Conclusions: No difference was found in high quality CPR between both teaching methods. New studies with more sample size would be recommended to conﬁrm these results.},
	language = {en-GB},
	urldate = {2023-11-24},
	journal = {Resuscitation},
	author = {Giraldo, José M. and Subirana, Pere and Molina, Lorena and Carmona, Francesc and Carballedo, Jaime and Montasell, Arich and Quintana, Salvador and Cerdà, Manel and De Balanzó, Xavier},
	month = sep,
	year = {2017},
	keywords = {Promotion:Literaturanalyse, Kollaboratives Lernen, Lehr- und Lerneffektivität, Technologieintegration, Promotion:Argumentation, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {e100},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:Giraldo et al. (2024) führen eine vergleichende Studie zwischen einem Standard-Basic Life Support (BLS)-Kurs und einer verkürzten Version mit einer vorherigen Online-Phase durch. Ziel der Studie ist es, die Qualität der CPR-Leistung (kardiopulmonale Reanimation) zwischen den beiden Lehrmethoden zu vergleichen.
Verwendete Methoden und Datenquellen:Die Studie ist experimentell angelegt, bei der Laienstudenten und Universitätspersonal zufällig einer Kontrollgruppe (Standardkurs) oder einer Interventionsgruppe (verkürzter Kurs mit Online-Vorbereitung) zugeteilt wurden. Zur Beurteilung der CPR-Leistung wurden Laerdal QCPR-Puppen und Software eingesetzt. Statistische Tests wie Chi-Quadrat, T-Test und Mann-Whitney-U-Test wurden verwendet, um die Daten zu vergleichen.
Zentrale Forschungsergebnisse:Es wurden keine signifikanten Unterschiede in der CPR-Leistung zwischen den beiden Gruppen festgestellt. Die globalen QCPR-Scores lagen bei 70,5\% für die Kontrollgruppe und 68,4\% für die Interventionsgruppe, was statistisch nicht signifikant war.
Zusammenfassung
Die Studie zeigt, dass es keinen signifikanten Unterschied in der Qualität der CPR-Leistung zwischen den Teilnehmern des Standard-BLS-Kurses und denen des verkürzten Kurses mit einer Online-Phase gibt. Dies deutet darauf hin, dass die verkürzte Version mit Online-Vorbereitung eine effektive Alternative zum traditionellen BLS-Kurs sein könnte.
Kernaussagen


"Kein signifikanter Unterschied in der CPR-Leistung zwischen den Teilnehmern des Standardkurses und des verkürzten Kurses." (S. 1)


"Die globalen QCPR-Scores zeigten ähnliche Ergebnisse mit 70,5\% in der Kontrollgruppe und 68,4\% in der Interventionsgruppe." (S. 1)


Argumentationslinien


Die Studie argumentiert, dass alternative Lehrmethoden, die eine Kombination aus Online- und Präsenzphasen nutzen, ebenso effektiv sein können wie traditionelle vollständig präsente Kurse, wenn es darum geht, lebensrettende Fähigkeiten wie CPR zu lehren.


Es wird darauf hingewiesen, dass die Nutzung digitaler Ressourcen in der Ausbildung der Ersthelfer sowohl die Zugänglichkeit als auch die Flexibilität der CPR-Ausbildung verbessern könnte.


Verschlagwortung


Lehr- und Lerneffektivität: Die Studie betont, dass die Qualität der CPR-Leistung nicht durch das Format der Kurslieferung beeinträchtigt wird, was die Wirksamkeit alternativer Lernmethoden unterstreicht.


Technologieintegration: Die Integration einer Online-Phase vor der Präsenzschulung zeigt, wie digitale Technologien zur Verbesserung der BLS-Ausbildung genutzt werden können.


Kollaboratives Lernen: Die Studie hebt hervor, wie die Kombination von Online-Lernen und praktischen Übungen das kollaborative Lernen fördern kann.


Kategorie: Weiterführung
Die Ergebnisse der Studie könnten dazu führen, dass weitere Forschungen empfohlen werden, um die Effektivität verschiedener Hybridformate in der BLS-Ausbildung zu testen, insbesondere unter Berücksichtigung verschiedener Lernumgebungen und demografischer Merkmale der Teilnehmer. Diese könnten darauf abzielen, spezifischere Einsichten in die optimale Mischung und Timing von Online- und Präsenzkomponenten zu gewinnen.
Argumentation, da die Studie zwischen online und Präsenz Ergebnisse leifetrt und als Argument für gleich gute Ergebnisse gelten kann.
Vielen Dank für die Klarstellung. Die Studie von Giraldo et al. wird nun unter der Kategorie "Argumentation" eingeordnet, da sie Argumente für die Gleichwertigkeit von Online- und Präsenzunterricht in der BLS-Ausbildung liefert. Dies ist besonders relevant für Debatten oder Entscheidungen über die Gestaltung von Lehrplänen und Methoden in der medizinischen Ausbildung, speziell in Zeiten, in denen die Flexibilität von Lernformaten zunehmend wichtig wird.
},
	file = {Giraldo et al. - 2017 - Can we teach BLS in a different way Comparative s.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/NW9TBT8W/Giraldo et al. - 2017 - Can we teach BLS in a different way Comparative s.pdf:application/pdf},
}

@article{cordero-torres_assessment_2014,
	title = {Assessment of e-learning teaching ({Moodle} platform) in immediate life support ({ILS}) by the {Spanish} {Resuscitation} {Council} ({CERCP}). {Results} of a satisfaction survey for course instructors},
	volume = {85},
	issn = {03009572},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0300957214003281},
	doi = {10.1016/j.resuscitation.2014.03.184},
	abstract = {Purpose: To analyse the progress in theoretical knowledge of nurses with different levels of education before and after European Resuscitation Council (ERC) Immediate Life Support (ILS) courses. Also we analyse participants opinion about the course.
Methods: We analysed data from 210 participants at 10 ILS courses in Croatia (January 2012–December 2013). The pre-course and post-course theoretical knowledge were assessed using ERC 40-question MCQ. Participants’ opinion of the course were analysed using ERC evaluation form (Table 1). Also, the participants Table 1 Statements for the evaluation of ERC ILS course. 1. How well did the course meet your objectives? 2. Did the ILS manual help you prepare for the course? 3.1 Lecture: causes and prevention of cardiopulmonary arrest 3.2 Lecture: ALS algorithm 3.3 CASDemo ALS Algorithm 3.4 Skill station 1: ABCDE approach 3.5 Skill station 2: Airway and breathing 3.6 Skill Station 3: BLS 3.7 Skill Station 4: Deﬁbrillation 3.8 Skill Station 5: CASTeach 4. Would you recommend this course to your colleagues? Likert-type scale Bad 1 2 3 4 5 Very well could add their free comments about the course.
Results: Bachelor nurses achieved pre-course = 85\% and post-course = 92\% (p {\textless} 0.001), while registered nurses had precourse = 84\% and post-course = 89\% (p {\textless} 0.001). In the course evaluation, 90\% of the participants rated the course components in statements 1, and 3.1–3.8 as very well, while 73\% rated the statement 2 as very well. All candidates would recommend ILS course to their colleagues. Half of the participants commented the course, and their leading comment was that the course should be extended to two days.
Conclusion: Bachelor nurses showed higher improvement in theoretical knowledge than registered nurses, so, in our opinion, this course should be integrated in their education programme and/or licensing exam in Croatia. All participants had very positive attitudes towards ERC ILC course.},
	language = {en-GB},
	urldate = {2023-11-24},
	journal = {Resuscitation},
	author = {Cordero-Torres, Juan Antonio and Cerdà-Vila, Manel and Quintana, Salvador and Carmona-Jiménez, Francesc},
	month = may,
	year = {2014},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Technologieintegration, Bildungstheorien, Promotion:Argumentation, Datenschutz und IT-Sicherheit, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {S73},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:Cordero-Torres et al. (2024) untersuchen die Wirksamkeit einer e-learning Plattform (Moodle) im Rahmen eines Kurses für Soforthilfe (Immediate Life Support, ILS) durch den Spanischen Wiederbelebungsrat. Ziel ist es, die Wahrnehmungen der Kursleiter zur Nützlichkeit des e-learning Moduls zu bewerten.
Verwendete Methoden und Datenquellen:Es wurden Zufriedenheitsumfragen an die Kursleiter des ILS-Kurses gesendet, um ihre Meinungen zum Online-Lernmodul und zur Präsenzphase zu ermitteln. Die Datenanalyse erfolgte durch prozentuale Auswertungen und Mittelwertberechnungen.
Zentrale Forschungsergebnisse:Die Mehrheit der Kursleiter fand den Zugang zur Moodle-Plattform einfach und bewertete die Nützlichkeit der e-learning Phase positiv für die Unterstützung der Präsenzphase. Die Gesamtbewertung des Kurses lag bei 83,9 von 100 Punkten.
Zusammenfassung
Die Studie zeigt, dass das e-learning Modul auf der Moodle-Plattform effektiv zur Unterstützung der Lehrphase in ILS-Kursen eingesetzt werden kann. Trotz einiger Bedenken bezüglich des Zugangs und der Zeitbewertung war das Gesamtfeedback positiv, was die Eignung dieser Methode für die Ausbildung bestätigt.
Kernaussagen


"73,2\% der Kursleiter empfanden den Zugang zur Moodle-Plattform als einfach." (S. 3)


"Die Online-Phase wurde von 74,4\% der Teilnehmer als nützlich für die Entwicklung der Präsenzphase bewertet." (S. 5)


Argumentationslinien


Die Forschung argumentiert, dass e-learning eine wertvolle Ergänzung zu traditionellen Lehrmethoden darstellt, indem sie flexiblen Zugang zu Lehrmaterialien bietet und die Effektivität der Präsenzphasen durch vorbereitende Online-Module steigert.


Trotz der Herausforderungen im Zusammenhang mit dem Zugang und der Zeitbewertung bestätigen die überwiegend positiven Bewertungen die Vorteile von e-learning in der medizinischen Ausbildung.


Verschlagwortung


Lehr- und Lerneffektivität: Die positive Bewertung des Moodle-basierten e-learning Moduls zeigt dessen Effektivität in der Verbesserung des Lernprozesses.


Technologieintegration: Die Integration der Moodle-Plattform in die ILS-Ausbildung illustriert die erfolgreiche Anwendung moderner Lehrtechnologien.


Forschungsansätze: Die Methodik der Datenerhebung und -analyse bietet ein Modell für die Bewertung von e-learning Systemen in der medizinischen Bildung.


Kollaboratives Lernen: Die Nutzung von Moodle fördert die Zusammenarbeit und den Austausch unter den Kursleitern und Teilnehmern, was ein kritischer Aspekt im Lernprozess ist.


Bildungstheorien: Die Studie stützt sich auf bildungstheoretische Konzepte von Blended Learning und konstruktivistischen Ansätzen, indem sie digitale und präsentielle Lernphasen kombiniert.


Datenschutz und IT-Sicherheit: Der verantwortungsbewusste Umgang mit Lehr- und Lernmaterial auf der Moodle-Plattform betont die Wichtigkeit des Datenschutzes in e-learning Umgebungen.


Kategorie: Argumentation
Die Studie liefert wichtige Argumente für die Integration von e-learning Modulen in traditionelle Lehrstrukturen, insbesondere in der medizinischen Ausbildung, wo sie zur Effizienzsteigerung und Flexibilitätserhöhung beitragen können.
},
	file = {Cordero-Torres et al. - 2014 - Assessment of e-learning teaching (Moodle platform.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/D48WHTWE/Cordero-Torres et al. - 2014 - Assessment of e-learning teaching (Moodle platform.pdf:application/pdf},
}

@article{santos_accurate_2023,
	title = {Accurate, timely, and portable: {Course}-agnostic early prediction of student performance from {LMS} logs},
