@book{frohlichBildungAlsReflexion2006,
  title = {Bildung als Reflexion über die Lebenszeit},
  author = {Fröhlich, Volker and Göppel, Rolf},
  editor = {Büttner, Christian and Datler, Wilfried and Eggert-Schmid Noerr, Annelind and Finger-Trescher, Urte},
