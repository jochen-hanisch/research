}

@article{hoon_meta-synthesis_2013,
	title = {Meta-{Synthesis} of {Qualitative} {Case} {Studies}: {An} {Approach} to {Theory} {Building}},
	volume = {16},
	issn = {1094-4281, 1552-7425},
