@incollection{valdanilov2022Sdd,
  title = {Smartphone in {{Detecting Developmental Disability}} in {{Infancy}}: {{A Theoretical Approach}} to {{Shared Intentionality}} for {{Assessment Tool}} of {{Cognitive Decline}} and e-{{Learning}}},
