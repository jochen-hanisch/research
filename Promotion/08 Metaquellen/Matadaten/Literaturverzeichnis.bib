	file = {PDF:/Users/jochenhanisch-johannsen/Zotero/storage/QMY7BMXP/Rigopouli et al. - 2025 - The Whale Optimization Algorithm and Markov Chain Monte Carlo-Based Approach for Optimizing Teacher.pdf:application/pdf},
}

@article{lyu_enhancing_2025,
	title = {Enhancing collaborative learning in engineering classrooms: the impact of individual preparation on students’ collaborative design quality and epistemic behaviours},
	issn = {0304-3797, 1469-5898},
	shorttitle = {Enhancing collaborative learning in engineering classrooms},
	url = {https://www.tandfonline.com/doi/full/10.1080/03043797.2025.2522283},
	doi = {10.1080/03043797.2025.2522283},
	abstract = {Developing collaboration skills is essential in university engineering classrooms, yet fostering in-depth collaborative discussions remains a challenge. This study introduced individual preparation (IP) as a pedagogical design and examined its role in students’ collaborative learning outcomes and processes. Eighty-two engineering students from a Singapore university worked in pairs and completed two tasks under two conditions: With-IP and Without-IP. Students’ design artefacts and collaborative learning outcomes were scored, and their verbal discussions were analysed to identify epistemic behaviours during collaboration. The findings indicate that students in the With-IP condition achieved higher collaborative learning scores and demonstrated more elaboration and synthesis, compared to more superficial exchanges in the Without-IP condition. Sequence mining further revealed distinct epistemic behaviour trajectories, with the WithIP condition promoting more in-depth peer interactions over time. This study provides a comprehensive examination of IP’s role in collaborative learning, offering valuable insights for educators designing and implementing IP to support effective collaboration.},
	language = {en},
	urldate = {2025-07-12},
	journal = {European Journal of Engineering Education},
	publisher = {Informa UK Limited},
	author = {Lyu, Qianru and Chen, Wenli and Heng (John Gerard), Kok Hui},
	month = jul,
	year = {2025},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Systemanpassung, Promotion:Relevanz:4, Promotion:Weiterführung, Promotion:FU2b, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU2b},
	pages = {1--20},
	annote = {Analyse der Studie „Enhancing collaborative learning in engineering classrooms: The impact of individual preparation on group outcomes“ von Lyu et al. (2025)

1. Hauptthemen und Ziele der Forschung
Lyu et al. (2025) untersuchen den Einfluss individueller Vorbereitung auf die Qualität kollaborativen Lernens in ingenieurwissenschaftlichen Kursen. Das zentrale Ziel besteht darin, zu klären, wie sich das individuelle kognitive Vorwissen und die Vorbereitung auf die Gruppenleistung und den Gruppenprozess auswirken. Die Studie will damit evidenzbasiert aufzeigen, welche Bedingungen kollaboratives Lernen effektiv unterstützen.

2. Methoden und Datenquellen


Studiendesign: Mixed-Methods-Design mit quantitativer (quasi-experimentell) und qualitativer Auswertung.


Stichprobe: 89 Studierende im ersten Studienjahr eines ingenieurwissenschaftlichen Programms.


Gruppenbildung: Studierende wurden in Gruppen eingeteilt, je nach individueller Vorbereitung in „hoch“ vs. „niedrig vorbereitet“.


Datenerhebung:


Pre-Task-Knowledge-Test


Beobachtungen und Videoanalyse der Gruppenarbeit


Post-Task-Bewertungen der Gruppenleistungen


Interviews zu Wahrnehmungen der Lernenden




Die qualitative Analyse folgte einem kodierbasierten Ansatz, die quantitative auf Vergleich statistischer Mittelwerte.

3. Zentrale Forschungsergebnisse


Gruppen mit hoher individueller Vorbereitung zeigten signifikant bessere Leistungen in Bezug auf Problemlösequalität und Teamkoordination.


Auch metakognitive Prozesse (z. B. Reflexion über Problemlösestrategien) waren in diesen Gruppen ausgeprägter.


In weniger vorbereiteten Gruppen traten häufiger Missverständnisse, passive Beteiligung und Ineffizienzen auf.


Die individuelle Vorbereitung wirkt nicht nur auf das Wissen, sondern moduliert auch soziale und kommunikative Gruppenprozesse.



4. Zusammenfassung
Die Studie zeigt, dass der Grad individueller Vorbereitung ein entscheidender Prädiktor für die Qualität kollaborativen Lernens ist. Studierende, die sich intensiv vorbereiten, tragen nicht nur mehr inhaltlich zum Gruppenprozess bei, sondern fördern auch produktive Interaktionen. Für kollaborative Lernszenarien in technischen Studiengängen bedeutet dies: Lernwirksamkeit entsteht nicht allein aus dem Gruppensetting, sondern wesentlich durch das vorbereitende individuelle Engagement.

5. Kernaussagen


„Groups with higher individual preparation exhibited significantly better coordination and task performance“ (S. 9).


„Individual readiness influences not only cognitive but also interactional dynamics“ (S. 11).


„Preparation quality is a mediator between prior knowledge and group learning outcomes“ (S. 12).


„Students in low-preparedness groups reported frustration and ambiguity in their roles“ (S. 10).



6. Argumentationslinien
Die Argumentation verläuft in drei Schritten:


Theoretische Herleitung: Die Autor*innen begründen, dass kollektives Lernen nur dann wirksam ist, wenn kognitive Voraussetzungen auf individueller Ebene gegeben sind (Anlehnung an das „Preparation for Future Learning“-Paradigma).


Empirische Überprüfung: Anhand strukturierter Gruppenaufgaben wird geprüft, wie sich die individuelle Vorbereitung auf den Gruppenprozess auswirkt.


Ableitung didaktischer Implikationen: Es wird gefordert, dass Lernformate kollaborativen Lernens durch vorbereitende Einzelaufgaben ergänzt werden müssen, um Wirksamkeit zu entfalten.


Die Argumentation ist in sich konsistent, datengestützt und schließt mit Empfehlungen für die Gestaltung zukünftiger kollaborativer Lernformate.

7. Verschlagwortung




Schlagwort


Begründung




Kollaboratives Lernen


Die Studie fokussiert auf Gruppenlernprozesse und deren Optimierung durch individuelle Vorbereitung.




Lehr- und Lerneffektivität


Die Wirkung der individuellen Vorbereitung wird an der Qualität des Lernoutputs gemessen.




Forschungsansätze


Anwendung eines Mixed-Methods-Designs zur triangulierten Analyse von Gruppenprozessen.




Systemanpassung


Es wird diskutiert, wie Lernsysteme gestaltet werden müssen (z. B. verpflichtende Einzelaufgaben), um kollaboratives Lernen zu fördern.





8. Kategorisierung
Kategorie: Weiterführung

Die Studie formuliert aus den Befunden heraus konkrete Handlungsempfehlungen zur Gestaltung zukünftiger Lehrformate: Einzelvorbereitungen sollen systematisch als Voraussetzung für Gruppenarbeiten eingeführt werden. Dies stellt eine Weiterentwicklung existierender didaktischer Designs dar.


9. Zuordnung zu Forschungsunterfrage
Forschungsunterfrage (FU2b):„Welche Effekt-Faktoren erläutern Lehrende im digitalen Bildungsraum von Gesundheitsberufen bei der Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems?“
Begründung:Die Studie zeigt, wie ein spezifischer Effektfaktor – die individuelle Vorbereitung – Gruppenprozesse beeinflusst. Dies ist auch auf digitale Settings übertragbar (z. B. in Moodle® mit vorbereitenden Einzelmodulen). Lehrende können daraus Rückschlüsse auf didaktische Designprinzipien ziehen.

10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 4


Zitierfähigkeit und Einfluss: 4


Aktualität: 5


Gesamtbewertung: 4

11. Schlussfolgerung
Die Studie von Lyu et al. (2025) zeigt evidenzbasiert, dass individuelle Vorbereitung ein entscheidender Faktor für kollaborative Lernqualität ist. Auch wenn der Fokus auf ingenieurwissenschaftliche Bildung liegt, ist das Erkenntnismodell auf digital gestützte, kollaborative Lernszenarien in Gesundheitsberufen übertragbar – insbesondere in der Verbindung von Selbstlernen und Gruppenarbeit in LMS-Systemen.
