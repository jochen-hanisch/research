  keywords = {b:Zeitschriftenartikel:online:learning,Charité:Promotion,Forschungsansätze,Kollaboratives Lernen,Lehr- und Lerneffektivität,Promotion:FU4a,Promotion:Kerngedanke,Promotion:Literaturanalyse,Promotion:Relevanz:5},
