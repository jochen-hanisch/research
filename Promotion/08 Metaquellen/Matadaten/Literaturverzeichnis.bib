@article{kerres2019Obu,
  title = {Offene Bildungsressourcen und Open Education: Openness als Bewegung oder als Gefüge von Initiativen?},
  shorttitle = {Offene Bildungsressourcen und Open Education},
  author = {Kerres, Michael},
  date = {2019-02-18},
  journaltitle = {MedienPädagogik: Zeitschrift für Theorie und Praxis der Medienbildung},
  shortjournal = {MedienPädagogik},
  volume = {34},
  pages = {1--18},
  issn = {1424-3636, 1424-3636},
  doi = {10/gg5cnj},
  url = {https://www.medienpaed.com/article/view/637},
  urldate = {2020-04-20},
  abstract = {Der Beitrag problematisiert die aktuelle Diskussion über open educational resources und fragt nach ihrem Beitrag zur weiteren Öffnung von Bildung («open education»). Angenommen wird dabei regelmässig, dass verschiedene Initiativen zu einer Öffnung im Kontext von Bildung in einer Kaskade wirken und sich zu einer Openness-Bewegung zusammenführen lassen. Der Beitrag stellt die Gegenthese vor, dass die verschiedenen Initiativen sich auf unterschiedliche Problemhorizonte beziehen und nur schwer unter eine Klammer zu bringen sind. Denn das Ziel eines breiteren Zugangs zu Bildung lässt sich sowohl mit offenen wie auch geschlossenen Bildungsressourcen erreichen, die wiederum in offenen wie auch geschlossenen informationellen Ökosystemen betrieben werden können. Es erscheint damit zielführend, die Relation der verschiedenen Initiativen von Öffnung als mehrdimensionales Gefüge von eher lose gekoppelten Initiativen zu betrachten, um aufzuzeigen, wie bestimmte Initiativen zu anderen beitragen (oder nicht). Die Konstruktion einer Openness-Bewegung wird dagegen in ihrer normativen Setzung hinterfragt, da sie mit Schliessungstendenzen einhergeht, die das Gegenteil von Öffnung und Offenheit bewirkt.},
  issue = {Research and OER},
  langid = {ngerman},
  keywords = {Charité:Promotion,Promotion:Literaturanalyse},
  file = {/Users/jochen_hanisch-johannsen/Zotero/storage/2M5GVSZS/kerres_2019_offene_bildungsressourcen_und_open_education.pdf}
}

