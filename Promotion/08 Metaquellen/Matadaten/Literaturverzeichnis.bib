  booktitle = {Digitalisierung in Studium und Lehre gemeinsam gestalten},
  author = {Ortelt, Tobias R. and Terkowsky, Claudius and Schwandt, Andrea and Winzker, Marco and Pfeiffer, Anke and Uckelmann, Dieter and Hawlitschek, Anja and Zug, Sebastian and Henke, Karsten and Nau, Johannes and May, Dominik},
