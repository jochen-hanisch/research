}

@article{calvo2024Ipt,
  title = {Investigating Pre-Service Teachers from {{Brazil}} and the {{US}} in a Virtual Exchange Project: {{Benefits}} and Challenges of Student-Selected and Required Technologies},
  shorttitle = {Investigating Pre-Service Teachers from {{Brazil}} and the {{US}} in a Virtual Exchange Project},
