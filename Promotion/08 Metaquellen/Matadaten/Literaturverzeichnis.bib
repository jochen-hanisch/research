@article{danner2019Bfi,
  title = {Das Big Five Inventar 2: Validierung eines Persönlichkeitsinventars zur Erfassung von 5 Persönlichkeitsdomänen und 15 Facetten},
  shorttitle = {Das Big Five Inventar 2},
  author = {Danner, Daniel and Rammstedt, Beatrice and Bluemke, Matthias and Lechner, Clemens and Berres, Sabrina and Knopf, Thomas and Soto, Christopher J. and John, Oliver P.},
  date = {2019-07},
  journaltitle = {Diagnostica},
  shortjournal = {Diagnostica},
  volume = {65},
  number = {3},
  pages = {121--132},
  issn = {0012-1924, 2190-622X},
  doi = {10/gfvgxr},
  url = {10.1026/0012-1924/a000218},
  urldate = {2020-07-12},
  abstract = {The German version of the 60-item Big Five Inventory 2 (BFI-2) captures the five personality domains Extraversion, Agreeableness, Conscientiousness, Negative Emotionality (Neuroticism), and Open-Mindedness (Openness) and15 facets of personality. The inventory was translated from English into German in multiple steps. On the basis of a population survey (N = 1,224) quoted for age, sex, and education, we examined the reliability, validity, and measurement invariance for gender and age groups. The results suggested good reliability at the domain level and sufficient reliability at the facet level. Overall, items and facets showed the expected loadings on the five personality domains. Also, domain and facet scores correlated with other personality inventories and were associated with external criteria such as educational attainment, income, health, and life satisfaction. Structural equation modeling confirmed residual measurement invariance across gender. Completing the BFI-2 takes 8 min on average. Statistics for the general population in Germany are reported for future reference.},
  langid = {ngerman},
  keywords = {Charité:Promotion,Dissertation:2.2.4,Promotion:2.2.5 Dispositionale Merkmale},
  file = {/Users/jochen_hanisch-johannsen/Zotero/storage/DKUQ8S4D/danner_et_al_2019_das_big_five_inventar_2.pdf;/Users/jochen_hanisch-johannsen/Zotero/storage/H8C2W6C6/danner_et_al_2019_das_big_five_inventar_2.pdf}
}

@article{danzglock2024Bpf,
  title = {Benefits of {{Problem-Solving First}} for the {{Success}} of {{Cooperative Learning}} with {{Videos}}},
  author = {Danzglock, Maria and Hänze, Martin},
  date = {2024-07-22},
  journaltitle = {The Journal of Experimental Education},
  shortjournal = {The Journal of Experimental Education},
  pages = {1--18},
  issn = {0022-0973, 1940-0683},
  doi = {10.1080/00220973.2024.2379542},
  url = {https://www.tandfonline.com/doi/full/10.1080/00220973.2024.2379542},
  urldate = {2024-07-29},
  abstract = {Explainer videos (EV) can enhance learning by increasing motivation and illustrating complex content, yet they may also cause cognitive overload or reduced cognitive activation. Addressing these challenges requires welldesigned instructional strategies. Our study hypothesized that cooperative problem-solving before watching an EV improves learning outcomes. We tested this with 58 undergraduates examining the topic of light and shadow. The findings revealed that students who engaged in problemsolving prior to viewing the EV demonstrated superior knowledge transfer compared to those who watched the EV first. This suggests that starting with cooperative problem-solving can effectively prepare learners for EV, fostering deeper understanding and successful application of new knowledge.},
  langid = {british},
  keywords = {b:Zeitschriftenartikel:online:learning,Charité:Promotion,Promotion:Literaturanalyse,Promotion:S:11 Online Learning},
