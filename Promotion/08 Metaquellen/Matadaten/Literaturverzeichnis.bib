@incollection{hubener_trialogische_2025,
	title = {Trialogische {Lehre} in virtuellen studentischen {Lernumgebungen}: {Neue} {Wege} in der {Hochschulausbildung} für die {Soziale} {Arbeit}},
	url = {https://www.pedocs.de/volltexte/2025/33130/pdf/Huebener_Willee_2025_Trialogische_Lehre_in_virtuellen.pdf},
	language = {de-DE},
	urldate = {2025-07-17},
	booktitle = {Digitalisierung in der {Hochschulbildung} für {Soziale} {Arbeit}},
	author = {Hübener, Anne-Friederike and {Ulf-Henning Willée}},
	editor = {Hübener, Anne-Friederike and Willée, Ulf-Henning},
	year = {2025},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:FU4a, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Systemanpassung, \#5:Buchteil:e-learning, E-Learning, Promotion:S05, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU4a, Promotion:sec:A-14, Promotion:sec:Technologiedefizit, Promotion:sec:MedienpaedagogischeRahmung, Promotion:sec:LMS-Bildungsraum-Begrenzte-Steuerbarkeit, Promotion:chap:04-02},
	pages = {208--225},
	annote = {Analyse der Studie: Hübener \& Willée (2024) – Trialogische Lehre in virtuellen studentischen Lernumgebungen: Neue Wege in der Hochschulausbildung für die Soziale Arbeit

1. Hauptthemen und Ziele der Forschung
Die Studie analysiert und konzipiert ein innovatives E-Learning-Modell namens TrialogLe, das in der Hochschulausbildung für Soziale Arbeit Anwendung findet. Ziel ist es, soziale Präsenz und multiperspektivisches Fallverstehen in asynchronen digitalen Lernumgebungen zu ermöglichen – insbesondere in Großveranstaltungen. Der Fokus liegt auf der didaktischen Integration eines trialogischen Austauschs zwischen Betroffenen, Fachpersonen und Studierenden, um psychische Erkrankungen aus verschiedenen Perspektiven zu reflektieren und praxisrelevantes Wissen aufzubauenHübener und Willée - Tr….

2. Verwendete Methoden und Datenquellen
Die Umsetzung erfolgt im Rahmen eines Projekts der Stiftung Innovation in der Hochschullehre (2022–2024). Die Evaluierung erfolgt über ein feldexperimentelles Design, das qualitative und quantitative Methoden kombiniert. Eingesetzt werden unter anderem:


asynchrone Lehrvideos,


virtuelle „Gallery-Walks“ (z. B. über Kunstmatrix, Abb. 1 auf S. 217),


Gruppenarbeiten,


Portfolioarbeit (Golden Nuggets)Hübener und Willée - Tr….


Die theoretische Rahmung erfolgt u. a. durch den Trialogical Learning Approach (Paavola \& Hakkarainen) und psychiatrische Trialoge nach Bock \& Buck.

3. Zentrale Forschungsergebnisse


Soziale Präsenz ist auch in asynchronen Formaten möglich, wenn didaktisch strukturierte, partizipative Formate gewählt werden (z. B. kleingruppierte Posterarbeit mit multiperspektivischem Feedback).


Der Trialog zwischen Betroffenen, Expert:innen und Studierenden fördert Reflexion, Empathie und Fallverstehen.


Die Verbindung monologischer (individuelle Posterarbeit), dialogischer (Peer-Reflexion) und trialogischer Prozesse (Expert:innenantworten) ermöglicht tiefes, kreatives, kollaboratives Lernen.


Digitale Medien (Moodle, Kunstmatrix, Videos) erweitern den Raum für soziales LernenHübener und Willée - Tr….



4. Zusammenfassung
Die Studie entwickelt ein didaktisches Modell für die digitale Hochschullehre in der Sozialen Arbeit: TrialogLe. Ziel ist es, über virtuelle, asynchrone Formate soziale Präsenz, Perspektivenvielfalt und Reflexionsfähigkeit zu fördern. Die Methode basiert auf dem Trialogical Learning Approach und psychiatrischen Trialogen. In einem strukturieren Zyklus generieren Studierende Fragen zu Lehrinhalten, die in Videos von Expert:innen beantwortet und später in Gruppen reflektiert werden. Ergebnisse zeigen, dass so eine tiefergehende Auseinandersetzung, aktive Teilhabe und soziale Einbindung auch in digitaler Lehre möglich ist.

5. Kernaussagen (mit Seitenangabe)


„Die virtuelle Kommunikation hat […] für das Studium der Sozialen Arbeit erheblich an Bedeutung gewonnen.“ (S. 210)


„Soziale Präsenz […] ist eine wichtige Grundvoraussetzung für gelungenes E-Learning.“ (S. 211)


„Das Projekt TrialogLe verfolgt das Ziel, […] soziale Präsenz in virtuellen, asynchronen Lernumgebungen zu untersuchen.“ (S. 213)


„Der Trialogical Learning Approach […] bringt drei Komponenten von Lernen zusammen.“ (S. 214)


„Durch die Gestaltung […] mit festen kollaborativen Gruppen […] wird soziale Präsenz gestärkt.“ (S. 217)


„Der Lernprozess basiert auf der Aneignung von Wissen und der umfassenden Beteiligung der Lernenden.“ (S. 219)


„Die Nutzung digitaler Technologien […] ermöglicht es, Studierende in frühen Studienphasen mit multiperspektivischen Expertisen vertraut zu machen.“ (S. 221)



6. Argumentationslinien
Die Argumentation verläuft logisch entlang folgender Struktur:


Ausgangslage \& Problemanalyse: COVID-19 bedingte Digitalisierung legte Defizite der Lehre offen, insbesondere im Hinblick auf soziale Präsenz und kollaboratives Lernen (S. 209–211).


Theoretische Fundierung: Rückgriff auf Selbstbestimmungstheorie, Soziale Präsenz, Media Synchronicity Theory und Trialogical Learning Approach (S. 212–215).


Modellentwicklung \& Umsetzung: Konzeption des TrialogLe-Zyklus mit festen Gruppen, Posterarbeit, Gallery-Walks und Trialog-Videos (S. 215–218).


Reflexion \& Wirkung: Förderung tiefen Lernens, partizipativer und reflexiver Kompetenzen (S. 219–220).


Ausblick \& Skalierbarkeit: TrialogLe ist übertragbar, thematisch flexibel und wird durch Design-Based Research weiterentwickelt (S. 220–221).



7. Verschlagwortung


Lehr- und LerneffektivitätBegründung: Die Studie zeigt, wie durch innovative digitale Methoden tiefes Lernen, Motivation und Wissensgenerierung gefördert werden (z. B. Portfolioarbeit, Golden Nuggets, Perspektivwechsel).


TechnologieintegrationBegründung: Die Integration von Moodle, Kunstmatrix, asynchronen Videoformaten und digitalem Peer-Tutoring zeigt eine hohe Durchdringung didaktischer Prozesse mit Technik.


ForschungsansätzeBegründung: Anwendung des Trialogical Learning Approach und der Design-Based Research Methodologie zur Evaluation innovativer Lehrkonzepte.


Kollaboratives LernenBegründung: Kleingruppenarbeiten, Peer-Austausch, Posterarbeit und gemeinsame Artefakterstellung (Videos, Nuggets) stehen im Zentrum des Ansatzes.


SystemanpassungBegründung: Das Modell ist auf asynchrone Großveranstaltungen zugeschnitten, skalierbar und adaptierbar auf verschiedene Themenkontexte.



8. Kategorisierung
KerngedankeDer zentrale Gedanke ist, dass soziale Präsenz und kollaboratives Lernen auch in asynchronen digitalen Lernumgebungen durch strukturierte, multiperspektivische und partizipative Lehrformate gefördert werden können – vermittelt durch den Trialogical Learning ApproachHübener und Willée - Tr….

9. Zuordnung zur Forschungsunterfrage
Passendste Forschungsunterfrage:


FU4a: Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?


Begründung: Die Arbeit thematisiert umfassend die Mechanismen sozialer Präsenz, kollaborativen Lernens und der Wissensgenerierung durch trialogische Strukturen – zentrale bildungswissenschaftliche Aspekte, die die Wirkung des Lernsystems auf die Studierenden betreffen.

10. Relevanzbewertung


Direkte Relevanz: 5 – umfassend relevant für die Wirkung und Gestaltung digitaler Lernsysteme


Theorietiefe und Praxisbezug: 5 – innovativ, fundiert, praktisch umgesetzt


Aktualität: 5 – aktuelle empirische Erprobung (2023–2024)


Gesamtbewertung: 5 – Hoch relevant
},
	file = {Hübener und Willée - Trialogische Lehre in virtuellen studentischen Lernumgebungen Neue Wege in der Hochschulausbildung:/Users/jochenhanisch-johannsen/Zotero/storage/AIEP995X/Hübener und Willée - Trialogische Lehre in virtuellen studentischen Lernumgebungen Neue Wege in der Hochschulausbildung.pdf:application/pdf},
}

@incollection{kustermann_selbstreflexion_2021,
	address = {Wiesbaden},
	title = {Selbstreflexion mit {Hilfe} von {E}-{Portfolios}},
	isbn = {978-3-658-31278-7 978-3-658-31279-4},
	url = {http://link.springer.com/10.1007/978-3-658-31279-4_6},
	doi = {10.1007/978-3-658-31279-4_6},
	abstract = {Zusammenfassung
            Selbstlernmaterialien, Übungsmöglichkeiten, formative Assessments und Unterstützung in diesen Lern- und Arbeitsphasen sind Bausteine, die sich für gewöhnlich in Online- aber auch Präsenzbrückenkursen oder -vorkursen finden – wenn auch der Fokus sich von Angebot zu Angebot unterscheiden mag. Studierfähigkeit zu Studienbeginn ist in Zeiten von und nach dem Bologna-Prozess das Credo von selbstbestimmtem, selbstorganisiertem und vor allem kompetenzorientiertem Lernen. Doch wie lässt sich dies in Zeiten von stetig wachsenden Blended- und Distance-Learning-Szenarien verzahnen?},
	language = {de-DE},
	urldate = {2021-12-29},
	booktitle = {Selbststudium im digitalen {Wandel}},
	publisher = {Springer Fachmedien Wiesbaden},
	author = {Samoila, Oliver},
	editor = {Küstermann, Roland and Kunkel, Matthias and Mersch, André and Schreiber, Anne},
	year = {2021},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:FU4a, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Bewertungsmethoden, Systemanpassung, Bildung, Multimedia, Lernsystemarchitektur, \#5:Buchteil:e-learning, FernUni-Hagen:MABM:M6, E-Portfolio, Promotion:S:17 E-Portfolio, Promotion:S:05 E-Learning, Promotion:2.4 Exkurs: Technologiedefizit, Promotion:3.5 ePortfolio als ..., Promotion:Literaturverzeichnis},
	pages = {55--60},
	annote = {Analyse der Studie: Samoila (2021) – „Selbstreflexion mit Hilfe von E-Portfolios“In: Küstermann et al. (Hrsg.), Selbststudium im digitalen Wandel. Springer

1. Analyse
Hauptthemen und Ziele der Forschung
Der Beitrag von Oliver Samoila untersucht, wie E-Portfolios im Rahmen von Online-Vorkursen im Projekt optes zur Förderung von Selbstreflexion und Selbstregulation genutzt werden können. Ziel ist es, Lernende im Übergang von Schule zu Hochschule bei der Entwicklung ihrer Studierfähigkeit durch systematisierte Reflexionsanlässe zu unterstützen – insbesondere im Kontext heterogener Voraussetzungen der Studierenden. Das Portfolio ist hierbei als Schnittstelle zwischen fachlichen Anforderungen (v. a. Mathematik), sozialer Integration (Peer-Learning, E-Mentoring) und individueller Kompetenzentwicklung konzipiert.

Methoden und Datenquellen
Die Studie basiert auf einer qualitativen Fallanalyse des E-Portfolio-Einsatzes im Rahmen des optes-Projekts, das digitale Vorkurse und E-Mentoring für Studienanfänger*innen anbietet. Es handelt sich um eine designbasierte Evaluation (Design-Based Research) mit Fokus auf:


Systemarchitektur und Funktionalitäten (ILIAS-Plattform)


Strukturierung von Reflexionsprozessen


Integration diagnostischer Tools und Selbsteinschätzungsinstrumente


Die verwendeten Werkzeuge innerhalb des Portfolios umfassen:


Lernverlauf (Abbildung 2, S. 57)


Lernjournal (reflexives Schreiben)


mathematische Fähigkeiten (prozessuale Rückmeldung)


Lernzielübersicht (inhaltliche Fortschritte)


Soft Skills (Selbsteinschätzung)


sonstige Individualisierungsoptionen



Zentrale Ergebnisse


Das E-Portfolio im optes-Setting dient nicht nur als Ablage für Reflexionen, sondern ist integraler Bestandteil der didaktischen Steuerung.


Über automatisierte Rückmeldungen zu Lernverlauf, Kompetenzausprägungen und Lernzielen wird eine individualisierte Lernprozessdiagnostik ermöglicht.


Die Portfolio-Arbeit ist hochgradig personalisiert und bildet zugleich eine kommunikative Schnittstelle zu E-Mentor*innen.


Selbsteinschätzungen über Soft Skills ermöglichen metakognitive Reflexion und fließen in Feedbackprozesse ein.


Das Gesamtsystem fördert strukturierte Selbstbeobachtung, zielgerichtete Weiterarbeit und kontinuierliches Feedback auf mehreren Ebenen (siehe Abbildung 1, S. 56).



2. Zusammenfassung
Oliver Samoila beschreibt den Einsatz von E-Portfolios zur Förderung selbstregulierten Lernens im Rahmen digitaler Brückenkurse für Studienanfänger*innen. Das Portfolio wird auf der Lernplattform ILIAS implementiert und dient der Reflexion, der Lernfortschrittsdiagnostik und der individuellen Unterstützung durch E-Mentoring. Der Beitrag analysiert die funktionale Struktur des Portfolios, die Integration formativer Assessments, und zeigt auf, wie durch strukturierte Reflexionsanlässe Studierende zur metakognitiven Auseinandersetzung mit ihrem Lernprozess angeregt werden.

3. Kernaussagen


Verzahnung von Reflexion und Lernprozessdiagnostik: „Die damit im Portfolio dargebotenen Informationen liefern eine wesentliche Grundlage für Reflexionsprozesse – auf inhaltlicher, prozessualer und bilanzierender Ebene des eigenen Lernens“ (S. 56).


Differenzierte Rückmeldung über Kompetenzausprägungen: „Testfragen tragen […] eine Zuweisung zu Kompetenzen […]. Somit wird […] eine Rückmeldung zu individueller Kompetenzentwicklung gegeben“ (S. 58).


Portfolio als Kommunikationsbrücke: „Das Portfolio ist dabei das Medium, welches den Studierenden, aber auch den E-Mentor*innen, diese Informationen zugänglich macht und als Kommunikationsanlass dient“ (S. 58).


Soft Skills als Reflexionsanlass: „Die Antworten münden im eigenen Portfolio und dienen […] der eigenständigen Reflexion als auch zur Beratungsgrundlage für E-Mentor*innen“ (S. 59).


Adaptivität durch Lernzielorientierte Kurse: „Lernende bekommen in Abhängigkeit von erbrachten Leistungen Empfehlungen zu weiteren Lernhandlungen“ (S. 59, Fn. 6).



4. Argumentationslinien
Der Text argumentiert entlang der Linie, dass Reflexion ein zentraler Bestandteil kompetenzorientierten Lernens ist. Die Verknüpfung automatisierter Daten (z. B. Kompetenzrückmeldungen, Lernverlauf) mit subjektiven Reflexionen im Lernjournal ermöglicht eine ganzheitliche Betrachtung des Lernprozesses. Diese strukturierte Selbstbeobachtung wiederum schafft die Grundlage für adaptives Feedback durch E-Mentor*innen. Die Kombination aus technologischer Unterstützung (ILIAS) und pädagogischer Betreuung erlaubt somit eine passgenaue Lernprozessbegleitung.

5. Verschlagwortung


LernsystemarchitekturDas Portfolio ist tief in das LMS ILIAS integriert und mit weiteren Systemfunktionen (z. B. adaptive Kurslogik, formative Assessments) verzahnt (S. 56–60).


Lehr- und LerneffektivitätDurch Self-Monitoring, Kompetenzrückmeldungen und individualisierte Lernpfade wird eine hohe Effektivität des Lernprozesses ermöglicht (S. 58–59).


BewertungsmethodenFormative Assessments und Selbsteinschätzungen bilden das Rückgrat der Feedback-Architektur (S. 58).


TechnologieintegrationILIAS wird um spezifische Portfolio-Funktionen erweitert (z. B. mathematische Fähigkeiten, Soft-Skill-Selbsteinschätzung) (S. 56).


SystemanpassungDas Portfolio bietet personalisierte Entwicklungsverläufe und Empfehlungen auf Basis individueller Lernleistungen (S. 59).


ForschungsansätzeDer Beitrag steht exemplarisch für ein Design-Based-Research-Verständnis, bei dem didaktische Innovation und technische Implementation iterativ verbunden sind.



6. Kategorisierung
KerngedankeZentrale Idee ist, dass strukturierte Selbstreflexion in E-Portfolios, unterstützt durch automatisierte Leistungsdaten und Rückmeldesysteme, wesentlich zur Entwicklung von Studierfähigkeit und Selbstregulation beiträgt.

7. Zuordnung zur Forschungsfrage
FU4a – Bildungswissenschaftliche Mechanismen

„Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen LMS im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?“

Begründung:Die Studie beschreibt Reflexion als bildungswissenschaftlichen Mechanismus, der durch digitale Tools operationalisiert wird. Dabei stehen die individuellen kognitiven, metakognitiven und sozialen Entwicklungsprozesse im Zentrum – in enger Verzahnung mit didaktischen Konzepten und technischer Umsetzung.

8. Relevanzbewertung
Gesamtbewertung: 5 – Hoch relevant


Direkte Relevanz: 5 (zentrale Reflexions- und Steuerungsmechanismen im digitalen Raum)


Forschungsdesign und Tiefe: 5 (Design-Based Research, langjähriges Projekt, konzeptionelle Tiefe)


Anwendung im Gesundheitsbereich adaptierbar: 5 (hochgradig übertragbar auf systemisch-konstruktivistische LMS in Gesundheitsberufen)


},
	file = {Samoila - 2021 - Selbstreflexion mit Hilfe von E-Portfolios.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/ZENRRPQV/Samoila - 2021 - Selbstreflexion mit Hilfe von E-Portfolios.pdf:application/pdf},
}

@incollection{hemmler_personalisierte_2022,
