	keywords = {Charité:Promotion, Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Leraning:Analytics, Promotion:FU1, \#8:Zeitschriftenartikel:blended:learning, Promotion:S:08 Blended Learning, Promotion:Dissertation {\textbar} FU1 {\textgreater} Kerngedanke, Promotion:Literaturverzeichnis},
	pages = {103388},
	file = {Chen - 2024 - Effects of learning analytics-based feedback on st.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/UJ8HQAMA/Chen - 2024 - Effects of learning analytics-based feedback on st.pdf:application/pdf},
