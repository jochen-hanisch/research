	note = {ZSCC: NoCitationData[s0]},
	keywords = {Charité:Promotion, Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, \#1:Zeitschriftenartikel:learning:management:system, Bildung, Multimedia, Digitale Bildung, Krisenreaktion im Bildungsbereich, systematic review, distance education, digital education, health professions, health personnel, continuous medical education, leg ulcers, pressure ulcers, Promotion:S:01 Learning Management System, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
