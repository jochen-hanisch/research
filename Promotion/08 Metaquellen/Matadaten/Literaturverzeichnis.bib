@article{topali_designing_2024,
	title = {Designing human-centered learning analytics and artificial intelligence in education solutions: a systematic literature review},
	issn = {0144-929X, 1362-3001},
	shorttitle = {Designing human-centered learning analytics and artificial intelligence in education solutions},
	url = {https://www.tandfonline.com/doi/full/10.1080/0144929X.2024.2345295},
	doi = {10.1080/0144929X.2024.2345295},
	abstract = {The recent advances in educational technology enabled the development of solutions that collect and analyse data from learning scenarios to inform the decision-making processes. Research fields like Learning Analytics (LA) and Artificial Intelligence (AI) aim at supporting teaching and learning by using such solutions. However, their adoption in authentic settings is still limited, among other reasons, derived from ignoring the stakeholders’ needs, a lack of pedagogical contextualisation, and a low trust in new technologies. Thus, the research fields of Human-Centered LA (HCLA) and Human-Centered AI (HCAI) recently emerged, aiming to understand the active involvement of stakeholders in the creation of such proposals. This paper presents a systematic literature review of 47 empirical research studies on the topic. The results show that more than two-thirds of the papers involve stakeholders in the design of the solutions, while fewer papers involved them during the ideation and prototyping, and the majority do not report any evaluation. Interestingly, while multiple techniques were used to collect data (mainly interviews, focus groups and workshops), few papers explicitly mentioned the adoption of existing HC design guidelines. Further evidence is needed to show the real impact of HCLA/HCAI approaches (e.g., in terms of user satisfaction and adoption).},
	language = {en-GB},
	urldate = {2024-05-19},
	journal = {Behaviour \& Information Technology},
	author = {Topali, Paraskevi and Ortega-Arranz, Alejandro and Rodríguez-Triana, María Jesús and Er, Erkan and Khalil, Mohammad and Akçapınar, Gökhan},
	month = apr,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Forschungsansätze, Promotion:FU4a, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Bewertungsmethoden, Systemanpassung, Bildungstheorien, Datenschutz und IT-Sicherheit, Leraning:Analytics, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {1--28},
	annote = {Analyse der Studie „Designing human-centered learning analytics and artificial intelligence-based educational technology: Towards pedagogy-aware, accountable, and trustworthy systems“ von Topali et al. (2024)

1. Hauptthemen und Ziele der Forschung
Die Forschungsarbeit von Topali et al. (2024) beschäftigt sich mit der Entwicklung menschenzentrierter Lernanalytik (Learning Analytics, LA) und KI-gestützter Bildungstechnologien. Ziel ist die Gestaltung vertrauenswürdiger, rechenschaftspflichtiger und pädagogisch fundierter Systeme, die sich an den Bedürfnissen und Rechten der Lernenden orientieren. Die zentrale Fragestellung lautet: Wie können KI-basierte Lernanalytiksysteme so gestaltet werden, dass sie sowohl lernförderlich als auch ethisch vertretbar sind?

2. Methoden und Datenquellen
Methoden:


Interdisziplinäre Analyse bestehender Forschung zu LA und KI in Bildungskontexten.


Konzeptuelle Entwicklung eines „Human-Centered Design Framework“.


Reflexion auf Basis systematischer Literaturrecherchen, ethischer Leitlinien und Designprinzipien.


Datenquellen:


Breite Sekundärliteratur zu Learning Analytics, Educational Data Mining, KI-Systemen, pädagogischer Theorie und Ethik.


Internationale Policy-Dokumente (z. B. OECD, UNESCO) und Forschungsprojekte (z. B. SHEILA, DEL4ALL).



3. Zentrale Forschungsergebnisse


Fehlende Pädagogik-Orientierung: Aktuelle LA- und KI-Systeme sind häufig technologie- und datengetrieben, ohne klare pädagogische Fundierung.


Framework-Vorschlag: Das vorgeschlagene „Human-Centered Learning Analytics Framework“ integriert vier Dimensionen: Pädagogik-Bewusstsein, Rechenschaftspflicht, Vertrauenswürdigkeit und Inklusivität (S. 8).


Designprinzipien: Es werden konkrete Prinzipien für die Gestaltung pädagogisch fundierter, rechenschaftspflichtiger Systeme benannt (z. B. partizipatives Design, datensparsame Technik, erklärbare KI).


Implikationen: Bildungstechnologie muss nicht nur funktional, sondern auch normativ gestaltet werden – insbesondere in Bezug auf Machtverhältnisse, Datenschutz und Bildungsgerechtigkeit.



Zusammenfassung
Topali et al. (2024) fordern ein Umdenken in der Gestaltung von KI-basierten Bildungswerkzeugen. Die bislang vorherrschende daten- und technologiezentrierte Entwicklung von Learning Analytics wird kritisiert und ein interdisziplinäres, menschenzentriertes Framework vorgeschlagen. Dieses soll Systeme hervorbringen, die nicht nur technisch effizient, sondern auch ethisch reflektiert, lernförderlich und pädagogisch sinnvoll sind.

Kernaussagen mit Fundstellen


„LA systems often lack pedagogical grounding and neglect learners’ agency and context“ (S. 2)


„Designing LA should go beyond datafication towards critical engagement with educational values“ (S. 4)


„Human-centered LA requires co-design with stakeholders and a shared pedagogical vision“ (S. 6)


„The proposed framework foregrounds pedagogy-aware, accountable, trustworthy, and inclusive systems“(S. 8)


„Trust must be built through transparency, explainability, and respect for learners’ rights“ (S. 9)



Argumentationslinien mit Fundstellen


Kritik an status quo: Die Autoren beginnen mit einer fundierten Kritik an der bestehenden Praxis, in der LA-Systeme stark technikgetrieben und normativ unreflektiert gestaltet werden (S. 2–3).


Notwendigkeit eines Paradigmenwechsels: Sie argumentieren, dass Bildungstechnologien ohne pädagogische und ethische Reflexion nicht lernförderlich wirken können (S. 4–5).


Designprinzipien als Antwort: Es werden konkrete Designprinzipien als Reaktion auf diese Probleme entwickelt (S. 6–7).


Framework als Synthese: Das human-centered Framework wird als ganzheitliche Lösung vorgestellt, die pädagogische, ethische und gestalterische Aspekte integriert (S. 8–10).



Verschlagwortung




Schlagwort


Begründung




Bildungstheorien


Zentrale Kritik der Arbeit ist die fehlende pädagogische Fundierung aktueller Systeme. Pädagogische Theorien sollen in Designprozesse integriert werden (S. 2–4).




Bewertungsmethoden


Reflexion darüber, wie Lernerfolg, Fortschritt und Systemwirkung in Learning Analytics gemessen und interpretiert werden sollten (S. 6–7).




Technologieintegration


Die Arbeit behandelt systematisch, wie KI und Lernanalytik in bestehende Bildungssettings integriert werden können – und welche Bedingungen für eine sinnvolle Integration gegeben sein müssen (S. 3–5).




Datenschutz und IT-Sicherheit


Datenschutz, informationelle Selbstbestimmung und faire Datennutzung werden als zentrale Kriterien für Vertrauen und ethisches Design betrachtet (S. 9).




Systemanpassung


Anpassungsfähigkeit der Systeme an unterschiedliche Bildungsziele, Lernkontexte und Nutzer*innen wird als Schlüsselanforderung beschrieben (S. 7–8).




Forschungsansätze


Der Beitrag ist stark theoretisch-konzeptionell und bietet einen innovativen, normativ fundierten Forschungsrahmen (S. 5–10).





Kategorisierung
Kerngedanke:Der zentrale Gedanke der Arbeit ist, dass LA- und KI-Systeme nur dann pädagogisch wirksam und ethisch vertretbar sind, wenn sie menschenzentriert gestaltet werden – unter Einbezug von Lernenden, Lehrenden und normativen Bildungszielen (S. 4, 6, 8).

Zuordnung zur Forschungsunterfrage
Passendste Forschungsunterfrage:FU4a – Bildungswissenschaftliche Mechanismen
Begründung:Die Studie beschreibt tiefgreifend bildungswissenschaftliche Mechanismen, insbesondere die Relevanz von Pädagogik, Partizipation, Kontextualisierung und Normativität in der Wirkung von KI-Systemen auf Akteure im Bildungsraum. Diese Wirkfaktoren sind entscheidend für die Integration solcher Systeme in systemisch-konstruktivistische Bildungskontexte.

Relevanzbewertung
5 – Hoch relevant
Begründung:Die Quelle stellt eine zentrale theoretische Grundlage für das Verständnis dar, wie KI-gestützte LMS wirkungsvoll, ethisch und lernförderlich gestaltet werden können. Ihre Argumente sind direkt auf systemisch-konstruktivistische Bildungsräume und das Wirkgefüge von LMS übertragbar.

},
	file = {Topali et al. - 2024 - Designing human-centered learning analytics and ar.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/AN5WUFXC/Topali et al. - 2024 - Designing human-centered learning analytics and ar.pdf:application/pdf},
}

@incollection{sahin_guiding_2024,
