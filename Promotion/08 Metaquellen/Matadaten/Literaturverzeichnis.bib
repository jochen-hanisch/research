  author = {Themeli, Chryssa and Prasolova-Førland, Ekaterina and Hokstad, Leif Martin and Kjeksrud, Stian},
  editor = {Uskov, Vladimir L. and Howlett, Robert J. and Jain, Lakhmi C.},
