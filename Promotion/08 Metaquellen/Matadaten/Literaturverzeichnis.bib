@article{vaezi2024Qre,
  title = {A Qualitative Report on Experiences of Participants in the Young Innovative Leadership Program},
  author = {Vaezi, Atefeh and Khoshgoftar, Mohadeseh and Teimouri-Jervekani, Zahra and Haghjooy Javanmard, Shaghayegh},
  date = {2024-01-17},
  journaltitle = {BMC Medical Education},
  shortjournal = {BMC Med Educ},
  volume = {24},
  number = {1},
  pages = {71},
  issn = {1472-6920},
  doi = {10.1186/s12909-024-05033-w},
  url = {https://bmcmededuc.biomedcentral.com/articles/10.1186/s12909-024-05033-w},
  urldate = {2024-01-23},
  abstract = {Background\enspace{} Leadership in health system is a universal challenge. The Young Innovative Leadership Program (YILP) designed for undergraduate and postgraduate medical sciences students, implemented at the Isfahan University of Medical Sciences, aimed to cultivate leadership capacities through a 16-week training program. This program comprises ten modules covering innovation, change leadership, and management skills, with mentor-facilitated group discussions. This study aimed to provide a qualitative report of the experiences of participants in the YILP. Methods\enspace{} A qualitative study was conducted in 2022, three months after the end of the training program, to investigate the participants’ perspectives. Data was extracted through in-depth, semi-structured interviews with 14 participants. Results\enspace{} In this study 14 undergraduate and postgraduate medical sciences students who had participated in the YILP the previous year were included. Four main categories emerged from the interviews: “emergence of new horizons”, “values as beacon”, “an expanded toolbox”, and “program’s structure: a learning atmosphere”. Conclusions\enspace{} The results of our study indicated that medical science students would benefit from leadership development programs. In this regard, the framework utilized to implement YILP could serve as a role model.},
  langid = {english},
  keywords = {1:Zeitschriftenartikel:learning:management:system,Charité:Promotion,Forschungsansätze,Kollaboratives Lernen,Lehr- und Lerneffektivität,Promotion:FU2a,Promotion:Literaturanalyse,Promotion:Relevanz:3,Promotion:Weiterführung,Systemanpassung,Technologieintegration},
