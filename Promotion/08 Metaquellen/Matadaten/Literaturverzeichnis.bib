@misc{wirtz_wirkungsgefuge_2020,
	title = {Wirkungsgefüge},
	url = {https://dorsch.hogrefe.com/stichwort/wirkungsgefuege},
	abstract = {Wirkungsgefüge [engl. cause-effect arrangement/diagram], [KOG], Funktionsschaltbild für das Zusammenwirken von versch. Faktoren, Teilakten oder Reaktionen..},
	language = {de-DE},
	urldate = {2024-04-09},
	journal = {Dorsch Lexikon der Psychologie},
	author = {Wirtz, Markus Antonius},
	year = {2020},
	keywords = {Definition, Wirkungsgefüge, Promotion:Literaturverzeichnis},
	annote = {Definition Wirkungsgefüge
[engl. cause-effect arrangement/diagram], [KOG], Funktionsschaltbild für das Zusammenwirken von versch. Faktoren, Teilakten oder Reaktionen in einem Gesamtzusammenhang wie z. B. der Steuerung der willkürlichen Augenbewegung bei der Raumkonstanz nach dem Reafferenzprinzip oder Veranschaulichung eines Regelkreises. In der Tierverhaltensforschung vielfach verwendet zur Verdeutlichung von Funktionszusammenhängen meist angeborener Verhaltensweisen. Heute weniger gebräuchlich. Der Begriff geht auf E.v. Holst zurück und wird in der Verhaltensphysiologie und kybernetischen Biologie zur Darstellung von Verhaltensgesetzmäßigkeiten verwendet. Kybernetik, System, soziales.
Ein Wirkungsgefüge, auch bekannt als cause-effect arrangement oder diagram im englischen, ist ein Konzept, das in der kognitiven Psychologie sowie in der Verhaltensphysiologie und kybernetischen Biologie verwendet wird, um das Zusammenwirken verschiedener Faktoren, Teilakte oder Reaktionen innerhalb eines Gesamtzusammenhangs zu illustrieren. Es dient als eine Art Funktionsschaltbild, das beispielsweise in der Steuerung der willkürlichen Augenbewegung bei der Raumkonstanz nach dem Reafferenzprinzip oder in der Veranschaulichung eines Regelkreises angewendet wird. Ursprünglich von E. v. Holst in die Verhaltensforschung eingeführt, findet es vor allem in der Tierverhaltensforschung Anwendung zur Verdeutlichung von Funktionszusammenhängen, insbesondere bei meist angeborenen Verhaltensweisen. Obwohl der Begriff in der modernen Forschung weniger gebräuchlich ist, bleibt er ein wichtiges Werkzeug zur Darstellung von Verhaltensgesetzmäßigkeiten in der Verhaltensphysiologie und der kybernetischen Biologie.
},
	file = {Wirtz - 2020 - Wirkungsgefüge.html:/Users/jochenhanisch-johannsen/Zotero/storage/DLXA2YCL/Wirtz - 2020 - Wirkungsgefüge.html:text/html},
}

@incollection{pentzold_einleitung_2018,
	address = {Wiesbaden},
	title = {Einleitung: {Theoriegenerierendes} empirisches {Forschen} in medienbezogenen {Lebenswelten}},
	isbn = {978-3-658-15998-6 978-3-658-15999-3},
	shorttitle = {Einleitung},
	url = {http://link.springer.com/10.1007/978-3-658-15999-3_1},
	doi = {10.1007/978-3-658-15999-3_1},
	abstract = {Die Einleitung führt sowohl in die Struktur des Bandes als auch in grundlegende Überlegungen zur Anwendung von Grounded Theory für das Erforschen medienbezogener Lebenswelten ein. In einer Vorüberlegung wird das Buch als Sammlung zu adaptierender Anwendungen statt fertiger ‚Patentrezepte‘ vorgestellt, um gemäß der Grounded Theory theoriegenerierend zu forschen. Grounded Theory kann dabei als Verfahrensrahmen, als Methode und/oder als Ergebnis begriffen und gebraucht werden. Insbesondere für Einsteigerinnen und Einsteiger ist es nicht einfach, forschungspraktische, für ihre Vorhaben und Materialien passende Darstellungen des Arbeitens mit Grounded Theory zu finden. Deshalb trägt der Band beispielhafte Anwendungen für den Gegenstandsbereich medienbezogene Lebenswelten zusammen. Gemeint sind jene Felder der Alltagswelt, deren Sozialgeschehen grundlegend durch mediale Vermittlung und mediale Inhalte geprägt ist. Die Grounded Theory bietet sich gerade für ihre Erforschung an, weil sie offen und gegenstandsbezogen klärt, ob und inwiefern konkrete Medienbezüge in Lebenswelten hergestellt werden – anstatt deren Wirkmächtigkeit im Voraus festlegen zu wollen.},
	language = {de-DE},
	urldate = {2021-11-10},
