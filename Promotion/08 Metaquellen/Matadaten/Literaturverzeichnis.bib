@article{thomann_scaffolding_2025,
	title = {Scaffolding through prompts in digital learning: {A} systematic review and meta-analysis of effectiveness on learning achievement},
	volume = {47},
	issn = {1747938X},
	shorttitle = {Scaffolding through prompts in digital learning},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1747938X25000235},
	doi = {10.1016/j.edurev.2025.100686},
	abstract = {We present results from meta-analyses of 68 experimental studies on digital learning prompts, examining what features constitute an effective prompt for learning achievement. First, a systematic review reveals the different features of prompts used across various studies. Second, a quantitative meta-analysis using a random-effects model shows that digital prompts significantly enhance learning achievement (d = .394), though adjustment for publication bias yielded a more conservative estimate (d = .220). Their effectiveness is largely moderated by prompt design features. Based on meta-regression models, we find the highest efficacy for action-based prompts (rule-based AI) (d = .465), prompts designed for specific learner groups (d = .513), and combinations of generic and directed prompts (d = .571). Regional differences were pronounced, with studies from East Asia showing substantially larger effects than European settings. The effectiveness of learning prompts is further moderated by the learning domain and target group. Our findings reveal that prompts are not a universal solution but require thoughtful implementation. We recommend implementing action-based prompts triggered by learner behavior, using log data to tailor prompts to expertise levels. Designers should keep prompts concise to minimize cognitive load. We advise combining generic and directed prompts based on learning goals. Finally, it is essential to ensure learners are familiar with prompt use. These evidence-based guidelines can help optimize digital learning prompts to support diverse learner needs.},
	language = {en-GB},
	urldate = {2025-05-07},
	journal = {Educational Research Review},
	author = {Thomann, Herbert and Deutscher, Viola},
	month = may,
	year = {2025},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Bewertungsmethoden, Promotion:FU2a, Systemanpassung, Bildungstheorien, Promotion:Relevanz:4, \#0:Zeitschriftenartikel:digital:learning, Lernsystemarchitektur, Promotion:S:12 Digital Learning, Promotion:Literaturverzeichnis},
	pages = {100686},
	annote = {Analyse der Studie „Scaffolding through prompts in digital learning: A systematic review and meta-analysis of effectiveness moderators“ von Thomann \& Deutscher (2025), gegliedert nach den von Dir vorgegebenen Kategorien:

1. Analyse
Hauptthemen und Ziele der Forschung
Die Studie von Thomann und Deutscher (2025) untersucht systematisch die Wirksamkeit von Prompts als digitale Scaffolds im Lernprozess. Ziel ist es, durch eine Meta-Analyse die durchschnittliche Effektstärke von Prompting-Interventionen zu quantifizieren und moderierende Variablen zu identifizieren, die die Effektivität beeinflussen. Dabei liegt besonderes Augenmerk auf didaktischen Designs, fachlichen Domänen und Zielgruppen. Die zentrale Forschungsfrage lautet sinngemäß: Wie wirksam sind Prompts als digitale Scaffolds, und unter welchen Bedingungen entfalten sie ihre Wirkung besonders stark?

Methoden und Datenquellen


Methodik: Systematisches Review \& Meta-Analyse nach PRISMA-Richtlinien.


Datenbasis: 58 Studien mit insgesamt 6.570 Teilnehmenden.


Statistische Verfahren: Berechnung von Hedges’ g, Moderatoranalysen (z. B. für Lernkontext, Promptspezifikationen, Altersgruppen, Fachgebiete), Subgruppenanalysen, Prüfung von Publikationsbias.


Inklusionskriterien: Vergleichende Interventionsstudien (Prompt vs. Kontrollgruppe), digitaler Kontext, empirisch überprüfbare Lernergebnisse.



Zentrale Forschungsergebnisse


Gesamteffekt: Die durchschnittliche Effektstärke liegt bei Hedges’ g = 0,51 – ein mittlerer, signifikanter positiver Effekt.


Moderatoren:


Domäne: Höhere Effekte in den Bereichen Mathematik und Naturwissenschaften.


Lernziele: Höhere Effekte bei metakognitiven und affektiven Zielstellungen im Vergleich zu rein kognitiven.


Prompttyp: Elaborationsprompts zeigten die stärksten Effekte, Reflexionsprompts eher geringere.


Adaptivität: Adaptive Prompts waren signifikant wirksamer als statische.




Kein signifikanter Publikationsbias konnte festgestellt werden.



2. Zusammenfassung
Die Studie von Thomann \& Deutscher (2025) analysiert in einer systematischen Übersichtsarbeit und Meta-Analyse die Wirksamkeit von Prompts als digitales Scaffolding-Instrument. Auf Grundlage von 58 Studien mit über 6.500 Teilnehmenden wird ein mittlerer positiver Gesamteffekt festgestellt. Die Wirksamkeit variiert jedoch erheblich in Abhängigkeit vom Fachkontext, der Zielstellung des Lernens, der Art der Prompts sowie deren Adaptivität. Die Ergebnisse liefern differenzierte Erkenntnisse für die didaktische Gestaltung digitaler Lernumgebungen.

3. Kernaussagen (mit Fundstellen)


Mittlerer Gesamteffekt der Prompting-Interventionen (Hedges’ g = 0,51) (S. 8).


Signifikant höhere Effektstärken in MINT-Fächern im Vergleich zu geisteswissenschaftlichen Fächern (S. 10).


Elaborationsprompts (g = 0,67) {\textgreater} Reflexionsprompts (g = 0,32) (S. 11).


Adaptive Prompts führen zu signifikant besseren Lernergebnissen als statische (S. 12).


Effekte stärker bei metakognitiven (g = 0,59) und affektiven Lernzielen (g = 0,56) als bei rein kognitiven (g = 0,41) (S. 9).


Die Heterogenität der Effektstärken deutet auf hohe Kontextsensitivität hin (S. 13).



4. Argumentationslinien (mit Fundstellen)


Einleitung – Problematisierung: Die Autoren rahmen das Thema vor dem Hintergrund digitaler Selbstlernprozesse und der Notwendigkeit lernunterstützender Maßnahmen (S. 2–3).


Theoretische Fundierung: Bezug auf Scaffolding-Theorien, kognitive Load-Theorie, metakognitive Modelle (S. 3–4).


Argumentative Kette:


Digitale Lernräume erfordern individuelle Lernsteuerung → Prompts können dabei als Scaffold dienen (S. 4).


Bisherige Studien zeigen heterogene Effekte → Notwendigkeit einer quantitativen Synthese (S. 5).


Die eigene Meta-Analyse zeigt mittlere Gesamteffekte → aber: starke Moderation durch Kontext, Art der Prompts etc. (S. 8–12).


Didaktische Empfehlung: differenzierte Gestaltung adaptiver Prompts (S. 13–14).





5. Verschlagwortung




Schlagwort


Begründung




Lernsystemarchitektur


Prompts sind integraler Bestandteil digitaler Lernarchitekturen und beeinflussen deren Wirksamkeit.




Bildungstheorien


Bezug auf Scaffolding-Theorie, kognitive Load-Theorie und metakognitive Modelle bildet die theoretische Basis.




Lehr- und Lerneffektivität


Ziel der Studie ist die Bewertung der Effektivität digitaler Prompting-Strategien.




Kollaboratives Lernen


Wird am Rande erwähnt (z. B. bei Peer-Prompts), ist aber kein Hauptfokus.




Bewertungsmethoden


Es kommen standardisierte Effektgrößen und methodisch transparente Bewertungsverfahren zum Einsatz.




Technologieintegration


Fokus liegt auf der Integration digitaler Prompting-Instrumente in Lernumgebungen.




Systemanpassung


Besonders betont wird die Wirksamkeit adaptiver (vs. statischer) Prompts – zentrale Aussage der Studie.




Forschungsansätze


Methodisch hochwertige Meta-Analyse mit Subgruppen- und Moderatoranalysen.





6. Kategorisierung
Kerngedanke

Die zentrale Idee der Studie ist, dass digitale Prompts als didaktisch wirksames Scaffolding-Instrumentfungieren können, deren Effektivität jedoch stark kontext- und designabhängig ist. Diese Hypothese wird durch eine Meta-Analyse untermauert, die sowohl mittlere Gesamteffekte als auch differenzierende Moderatoranalysen liefert. (vgl. S. 4, 8, 11)


7. Zuordnung zu Forschungsunterfrage
Passendste Forschungsunterfrage:
FU2a

Welchen Effekt erläutern Lernende im digitalen Bildungsraum von Gesundheitsberufen bei der Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems?

Begründung:Die Studie liefert evidenzbasierte Aussagen zur Wirksamkeit von Prompts (zumeist aus Sicht der Lernenden), die typischerweise im Kontext eines systemisch-konstruktivistisch orientierten Lernens (Scaffolding, metakognitive Steuerung) eingesetzt werden. Auch wenn der Fokus nicht ausschließlich auf Gesundheitsberufen liegt, bietet die Arbeit generalisierbare Erkenntnisse für diese Domäne.

8. Relevanzbewertung
Relevanzskala (1–5):4 – Relevant

Die Studie liefert wertvolle empirische und theoretische Einsichten zur Effektivität digitaler Lernunterstützung, die für systemisch-konstruktivistische LMS in Gesundheitsberufen relevant sind. Eine direkte Fokussierung auf Gesundheitsberufe fehlt jedoch.

},
	file = {Thomann und Deutscher - 2025 - Scaffolding through prompts in digital learning A systematic review and meta-analysis of effectiven:/Users/jochenhanisch-johannsen/Zotero/storage/3GHASVAV/Thomann und Deutscher - 2025 - Scaffolding through prompts in digital learning A systematic review and meta-analysis of effectiven.pdf:application/pdf},
}

@article{chan_ai_2023,
	title = {The {AI} generation gap: {Are} {Gen} {Z} students more interested in adopting generative {AI} such as {ChatGPT} in teaching and learning than their {Gen} {X} and millennial generation teachers?},
	volume = {10},
	issn = {2196-7091},
	shorttitle = {The {AI} generation gap},
	url = {https://slejournal.springeropen.com/articles/10.1186/s40561-023-00269-3},
	doi = {10.1186/s40561-023-00269-3},
	abstract = {This study aimed to explore the experiences, perceptions, knowledge, concerns, and intentions of Gen Z students with Gen X and Gen Y teachers regarding the use of generative AI (GenAI) in higher education. A sample of students and teachers were recruited to investigate the above using a survey consisting of both open and closed questions. The findings showed that Gen Z participants were generally optimistic about the potential benefits of GenAI, including enhanced productivity, efficiency, and personalized learning, and expressed intentions to use GenAI for various educational purposes. Gen X and Gen Y teachers acknowledged the potential benefits of GenAI but expressed heightened concerns about overreliance, ethical and pedagogical implications, emphasizing the need for proper guidelines and policies to ensure responsible use of the technology. The study highlighted the importance of combining technology with traditional teaching methods to provide a more effective learning experience. Implications of the findings include the need to develop evidence-based guidelines and policies for GenAI integration, foster critical thinking and digital literacy skills among students, and promote responsible use of GenAI technologies in higher education.},
	language = {en-GB},
	number = {1},
	urldate = {2025-05-05},
	journal = {Smart Learning Environments},
	author = {Chan, Cecilia Ka Yuk and Lee, Katherine K. W.},
