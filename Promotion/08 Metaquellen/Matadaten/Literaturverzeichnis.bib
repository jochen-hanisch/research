	note = {Publisher: :null},
	keywords = {Charité:Promotion, Promotion:Literaturanalyse, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:FU2a, Systemanpassung, Bildungstheorien, Promotion:Relevanz:4, Bildung, Digitale Bildung, Digitalisierung, Digitalization, Virtual learning, Hochschule, Learning, On line, Online, Virtuelle Lehre, Pädagogik, Male student, Student, Psychologie, Self-instruction, Constructivism, Konstruktivismus, Eigenverantwortung, Lernen, Higher education institute, E-Learning, Selbstständiges Lernen, \#3:Buchteil:online:Lernumgebung, Educational psychology, Exemplary model, Fallbeispiel, Learning psychology, Pädagogische Psychologie, Pedagogical psychology, Problem based learning, Problemorientiertes Lernen, Psychology of learning, Promotion:S:03 Online-Lernumgebung, Promotion:Kompetenz \& Rettungswissenschaft, Promotion:Literaturverzeichnis},
