@article{biermann_medienbildung_2022,
	title = {Medienbildung durchgespielt?!: {Lern}- und {Bildungsprozesse} im {Kontext} digitaler {Spielkulturen}: {Ein} {Walkthrough}},
	volume = {50},
	issn = {1424-3636},
	shorttitle = {Medienbildung durchgespielt?},
	url = {https://www.medienpaed.com/article/view/1533},
	doi = {10.21240/mpaed/50/2022.12.09.X},
	abstract = {Digital games tell stories to a previously unknown extent, they draw players into the game world, and at the same time enable their own forms of expression through playful and creative practices. Thus, digital games and game cultures are not only interesting for research, but also attractive for innovative teaching concepts. Based on a fundamental contribution co-authored by Maic Masuch and Johannes Fromme on the importance of integrating digital games into higher education curricula, Dan Verständig and Ralf Biermann ask how digital games and game cultures are situated in the context of media education, especially in the intertwining of research and teaching. The discussion takes place along the study program of media education – audiovisual culture and communication, founded by Johannes Fromme and Winfried Marotzki in 2004 at the Otto-vonGuericke-University of Magdeburg.},
	language = {de-DE},
	urldate = {2022-12-29},
	journal = {MedienPädagogik: Zeitschrift für Theorie und Praxis der Medienbildung},
	author = {Biermann, Ralf and Verständig, Dan},
	month = dec,
	year = {2022},
	keywords = {Promotion:Literaturanalyse, \#7:Zeitschriftenartikel:digital:Medien, Bildung, Multimedia, Promotion:S:07 Digitale Medien, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {199--232},
	annote = {Analyse: Medienbildung durchgespielt?!: Lern- und Bildungsprozesse im Kontext digitaler Spielkulturen: Ein Walkthrough von Biermann, Verständig\# Analyse: *Medienbildung durchgespielt?!: Lern- und Bildungsprozesse im Kontext digitaler Spielkulturen: Ein Walkthrough* von Biermann, Verständig

\#\# 1. Hauptthemen und Ziele der Forschung
Der Artikel behandelt die Verflechtung digitaler Spielkulturen mit Medienbildung, insbesondere im Kontext von Lehr- und Forschungsaktivitäten. Ziel ist es, die Rolle, die digitale Spiele und die sie umgebenden Kulturen in der Medienbildung einnehmen, zu untersuchen und darüber nachzudenken, wie diese in innovative Lehrkonzepte integriert werden können.

\#\# 2. Methoden und Datenquellen
Explorative und theoretische Ansätze werden verwendet, um die Bedeutung digitaler Spiele für die Medienbildung zu erörtern. Der Artikel analysiert existierende Lehrpläne und Bildungsstrukturen, insbesondere das Studienprogramm "Medienbildung – audiovisuelle Kultur und Kommunikation" der Otto-von-Guericke-Universität Magdeburg.

\#\# 3. Zentrale Forschungsergebnisse
Es wird deutlich, dass digitale Spiele mehr sind als nur Unterhaltungsmedien; sie können als Mittel zur Förderung von Medienkompetenz und als Plattform für kreative und partizipative Lernprozesse verwendet werden. Digitale Spielkulturen bieten Raum für innovative pädagogische Ansätze.

\#\# 4. Zusammenfassung des Artikels
- **Problemstellung**: Die Frage, wie digitale Spiele und die ihnen zugrundeliegenden Kulturen wirksam in Bildungsprozesse integriert werden können, um Medienkompetenz zu fördern.
 - Methodik: 
 Die Analyse basiert auf dem Konzept des Walkthroughs von digitalen Bildungszugängen und bezieht bestehende Bildungsprogramme als Fallstudien ein.
 - Hauptergebnisse: 
 Digitale Spiele können erfolgreich für Bildungszwecke genutzt werden, da sie narrative und expressive Potenziale besitzen, die kreative und interaktive Lehr-Lern-Formate unterstützen.
 - Schlussfolgerungen: 
 Die Integration digitaler Spiele in die Medienbildung kann die traditionelle Bildungsstruktur erweitern und innovative Lernmöglichkeiten eröffnen.
- **Methodik**: Die Analyse basiert auf dem Konzept des Walkthroughs von digitalen Bildungszugängen und bezieht bestehende Bildungsprogramme als Fallstudien ein.
 - Hauptergebnisse: 
 Digitale Spiele können erfolgreich für Bildungszwecke genutzt werden, da sie narrative und expressive Potenziale besitzen, die kreative und interaktive Lehr-Lern-Formate unterstützen.
 - Schlussfolgerungen: 
 Die Integration digitaler Spiele in die Medienbildung kann die traditionelle Bildungsstruktur erweitern und innovative Lernmöglichkeiten eröffnen.
- **Hauptergebnisse**: Digitale Spiele können erfolgreich für Bildungszwecke genutzt werden, da sie narrative und expressive Potenziale besitzen, die kreative und interaktive Lehr-Lern-Formate unterstützen.
 - Schlussfolgerungen: 
 Die Integration digitaler Spiele in die Medienbildung kann die traditionelle Bildungsstruktur erweitern und innovative Lernmöglichkeiten eröffnen.
- **Schlussfolgerungen**: Die Integration digitaler Spiele in die Medienbildung kann die traditionelle Bildungsstruktur erweitern und innovative Lernmöglichkeiten eröffnen.

\#\# 5. Wichtige Aussagen und Befunde
Digitale Spiele sind wertvolle Bildungswerkzeuge, die nicht nur zur Unterhaltung dienen, sondern auch zur Förderung von Medienkompetenz und kreativem Ausdruck. Die Verbindung von Forschung und Lehre im Bereich digitaler Spielkulturen kann zu neuen Erkenntnissen führen und Ausbildungsprogramme bereichern.

\#\# 6. Logische Struktur und Argumentation
Der Artikel folgt einer klaren Argumentationslinie vom Verständnis digitaler Spiele als Bildungsmedium zur praktischen Anwendung in der Lehre. Die Autoren stützen sich auf theoretische Grundlagen und konkrete Fallbeispiele, um ihre Thesen zu untermauern.

\#\# 7. Relevante Schlagwörter
- Digitale Spiele: Aufgrund des zentralen Themas der Untersuchung in ihrer Funktion als Bildungsmedien.
- Medienbildung: Da die Untersuchung die Anwendung digitaler Spiele in der Bildungspraxis analysiert.
- Kreative Lernprozesse: Wegen der Betonung auf die kreative Nutzung von Spielen in Bildungsprozessen.
- Spielkulturen: Weil der kulturelle Kontext von Spielen für die Forschung von Bedeutung ist.

\#\# 8. Kategorie
Bildungsforschung mit dem Schwerpunkt auf digitaler Medienbildung, da der Artikel die Integration digitaler Spiele in Lehrpläne und Bildungsprozesse untersucht.

\#\# 9. Zugeordnete Forschungsfrage
Wie können digitale Spiele effektiv in Bildungskontexte integriert werden, um Medienkompetenz zu fördern und kreative Lernprozesse zu unterstützen? Diese Frage spiegelt die Kernanliegen und Zielsetzung des Artikels wider.

\#\# 10. Relevanz für die Forschungsfrage
Keine Informationen verfügbar
},
