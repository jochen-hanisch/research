@article{brooks_evaluation_2016,
	title = {An evaluation of {UK} foundation trainee doctors’ learning behaviours in a technology-enhanced learning environment},
	volume = {16},
	issn = {1472-6920},
	url = {http://bmcmededuc.biomedcentral.com/articles/10.1186/s12909-016-0651-z},
	doi = {10/f8wxds},
	abstract = {Background: Technology-Enhanced Learning (TEL) can be used to educate Foundation Programme trainee (F1 and F2) doctors. Despite the advantages of TEL, learning behaviours may be exhibited that are not desired by system developers or educators. The aim of this evaluation was to investigate how learner behaviours (e.g. time spent on task) were affected by temporal (e.g. time of year), module (e.g. word count), and individual (e.g. knowledge) factors for 16 mandatory TEL modules related to prescribing and therapeutics.
Methods: Data were extracted from the SCRIPT e-Learning platform for first year Foundation trainee (F1) doctors in the Health Education England’s West Midland region from 1st August 2013 to 5th August 2014. Generalised Estimating Equation models were used to examine the relationship between time taken to complete modules, date modules were completed, pre- and post-test scores, and module factors.
Results: Over the time period examined, 688 F1 doctors interacted with the 16 compulsory modules 10,255 times. The geometric mean time taken to complete a module was 28.9 min (95 \% Confidence Interval: 28.4–29.5) and 1,075 (10.5 \%) modules were completed in less than 10 min. In February and June (prior to F1 progression reviews) peaks occurred in the number of modules completed and troughs in the time taken. Most modules were completed, and the greatest amount of time was spent on the learning on a Sunday. More time was taken by those doctors with greater pre-test scores and those with larger improvements in test scores.
Conclusions: Foundation trainees are exhibiting unintended learning behaviours in this TEL environment, which may be attributed to several factors. These findings can help guide future developments of this TEL programme and the integration of other TEL programmes into curricula by raising awareness of potential behavioural issues that may arise.},
	language = {en-GB},
	number = {1},
	urldate = {2023-11-18},
	journal = {BMC Medical Education},
	author = {Brooks, Hannah L. and Pontefract, Sarah K. and Hodson, James and Blackwell, Nicholas and Hughes, Elizabeth and Marriott, John F. and Coleman, Jamie J.},
	month = dec,
	year = {2016},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, Promotion:FU3, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {133},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:
Die Studie von Brooks et al. (2016) untersucht die Lernverhaltensweisen von Foundation Year 1 (F1) Ärzten im Vereinigten Königreich, die an technologiegestütztem Lernen (Technology-Enhanced Learning, TEL) teilnehmen. Ziel ist es, die Faktoren zu identifizieren, die das Lernverhalten beeinflussen, und die Effektivität von TEL-Modulen im Bereich Verschreibungswissen und -kompetenz zu bewerten.
Verwendete Methoden und Datenquellen:


Design: Quantitative Evaluation


Datenquellen: Daten von 16 obligatorischen TEL-Modulen, die von 688 F1-Ärzten über einen Zeitraum von einem Jahr bearbeitet wurden.


Evaluationsmethoden: Generalized Estimating Equations (GEE) Modelle zur Analyse der Beziehung zwischen Zeitaufwand, Modulabschlüssen, Pre- und Post-Tests und anderen Faktoren.


Zentrale Forschungsergebnisse:


Zeitaufwand: Die durchschnittliche Zeit zur Bearbeitung eines Moduls betrug 28,9 Minuten. Es wurde festgestellt, dass viele Module in weniger als 10 Minuten abgeschlossen wurden, was auf suboptimale Lernverhaltensweisen hinweist.


Modulabschlüsse: Es gab Spitzenzeiten für Modulabschlüsse im Februar und Juni, die mit den bi-annualen Fortschrittsbewertungen zusammenfielen.


Lernverhalten: Die Untersuchung ergab, dass einige Ärzte Module sehr schnell abschlossen, was auf Oberflächliches Lernen hindeutet. Höhere Vor-Test Scores korrelierten mit einem größeren Zeitaufwand für die Module.


Zusammenfassung
Die Studie zeigt, dass technologiegestütztes Lernen (TEL) zur Verbesserung der Verschreibungskompetenz von Foundation Year 1 Ärzten beitragen kann. Allerdings wurden auch suboptimale Lernverhaltensweisen identifiziert, die darauf hindeuten, dass die Flexibilität von TEL zu oberflächlichem Lernen führen kann, insbesondere wenn die Module vor anstehenden Bewertungen abgeschlossen werden.
Kernaussagen


„Die durchschnittliche Zeit zur Bearbeitung eines Moduls betrug 28,9 Minuten, aber viele Module wurden in weniger als 10 Minuten abgeschlossen, was auf suboptimale Lernverhaltensweisen hinweist.“ (S. 4)


„Es gab Spitzenzeiten für Modulabschlüsse im Februar und Juni, die mit den bi-annualen Fortschrittsbewertungen zusammenfielen.“ (S. 5)


„Höhere Vor-Test Scores korrelierten mit einem größeren Zeitaufwand für die Module, was auf eine tiefere Auseinandersetzung mit dem Lernmaterial hinweist.“ (S. 6)


Argumentationslinien


Effektivität von TEL: Die Studie argumentiert, dass TEL eine effektive Methode zur Verbesserung der Verschreibungskompetenz ist, jedoch nur, wenn die Module wie vorgesehen genutzt werden. (S. 7)


Suboptimale Lernverhaltensweisen: Die Flexibilität von TEL ermöglicht es den Lernenden, Module schnell abzuschließen, was zu oberflächlichem Lernen führen kann. Maßnahmen zur Regulierung und Überwachung der Lernzeit sind erforderlich. (S. 8)


Zeitmanagement: Unterschiede im Zeitmanagement und der Motivation der Lernenden beeinflussen die Effektivität von TEL erheblich. (S. 9)


Verschlagwortung


Lehr- und Lerneffektivität: Untersuchung der Effektivität von TEL zur Verbesserung der Verschreibungskompetenz und Identifizierung von suboptimalen Lernverhaltensweisen.


Technologieintegration: Nutzung von TEL-Modulen zur Unterstützung der medizinischen Ausbildung im Bereich Verschreibungswissen.


Systemanpassung: Anpassung von TEL-Programmen an die Lernbedürfnisse und Zeitmanagementpraktiken der medizinischen Trainees.


Forschungsansätze: Quantitative Evaluation der Lernverhaltensweisen und -ergebnisse bei der Nutzung von TEL.


Kategorisierung: Argumentation
Begründung:
Die Studie von Brooks et al. (2016) liefert Argumente für die Effektivität und die Herausforderungen von TEL in der medizinischen Ausbildung. Durch die detaillierte Analyse der Lernverhaltensweisen und die Identifizierung von suboptimalen Praktiken wird argumentiert, dass TEL gut gestaltet und reguliert werden muss, um die gewünschten Lerneffekte zu erzielen. Diese Argumentationslinien sind besonders relevant für die Forschungsfragen des Exposés, da sie die praktischen und theoretischen Aspekte der Implementierung und Optimierung von TEL-Methoden im digitalen Bildungsraum beleuchten.
Kategorie: Argumentation
Zuordnung zur Forschungsfrage
FU3: Wie sind Konzeption und relevante didaktische und bildungstechnologische Merkmale des systemisch-konstruktivistischen Learning-Management-Systems für Akteure im digitalen Bildungsraum von Gesundheitsberufen dargestellt?
Begründung:
Die Studie untersucht die didaktischen und bildungstechnologischen Merkmale von TEL-Modulen und ihre Auswirkungen auf die Lernverhaltensweisen und Ergebnisse der Foundation Year 1 Ärzte. Diese Erkenntnisse sind besonders relevant, um die Konzeption und die Merkmale eines systemisch-konstruktivistischen Learning-Management-Systems im digitalen Bildungsraum von Gesundheitsberufen zu verstehen und zu optimieren.
},
	file = {Brooks et al. - 2016 - An evaluation of UK foundation trainee doctors’ le.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/4RVKF22A/Brooks et al. - 2016 - An evaluation of UK foundation trainee doctors’ le.pdf:application/pdf},
}

@article{gruner_introducing_2015,
	title = {Introducing global health into the undergraduate medical school curriculum using an e-learning program: a mixed method pilot study},
	volume = {15},
	issn = {1472-6920},
	shorttitle = {Introducing global health into the undergraduate medical school curriculum using an e-learning program},
	url = {http://bmcmededuc.biomedcentral.com/articles/10.1186/s12909-015-0421-3},
	doi = {10/f7zczm},
	abstract = {Background: Physicians need global health competencies to provide effective care to culturally and linguistically diverse patients. Medical schools are seeking innovative approaches to support global health learning. This pilot study evaluated e-learning versus peer-reviewed articles to improve conceptual knowledge of global health.
Methods: A mixed methods study using a randomized-controlled trial (RCT) and qualitative inquiry consisting of four post-intervention focus groups. Outcomes included pre/post knowledge quiz and self-assessment measures based on validated tools from a Global Health CanMEDS Competency Model. RCT results were analyzed using SPSS-21 and focus group transcripts coded using NVivo-9 and recoded using thematic analysis.
Results: One hundred and sixty-one pre-clerkship medical students from three Canadian medical schools participated in 2012–2013: 59 completed all elements of the RCT, 24 participated in the focus groups. Overall, comparing pre to post results, both groups showed a significant increase in the mean knowledge (quiz) scores and for 5/7 self-assessed competencies (p {\textless} 0.05). These quantitative data were triangulated with the focus groups findings that revealed knowledge acquisition with both approaches. There was no statistically significant difference between the two approaches. Participants highlighted their preference for e-learning to introduce new global health knowledge and as a repository of resources. They also mentioned personal interest in global health, online convenience and integration into the curriculum as incentives to complete the e-learning. Beta version e-learning barriers included content overload and technical difficulties.
Conclusions: Both the e-learning and the peer reviewed PDF articles improved global health conceptual knowledge. Many students however, preferred e-learning given its interactive, multi-media approach, access to links and reference materials and its capacity to engage and re-engage over long periods of time.},
	language = {en-GB},
	number = {1},
	urldate = {2023-11-18},
	journal = {BMC Medical Education},
	author = {Gruner, Douglas and Pottie, Kevin and Archibald, Douglas and Allison, Jill and Sabourin, Vicki and Belcaid, Imane and McCarthy, Anne and Brindamour, Mahli and Augustincic Polec, Lana and Duke, Pauline},
	month = dec,
	year = {2015},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, Promotion:FU3, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {142},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:
Die Studie von Gruner et al. (2015) untersucht die Integration von globaler Gesundheit in das Curriculum der medizinischen Ausbildung mithilfe eines E-Learning-Programms. Ziel der Forschung ist es, die Effektivität von E-Learning im Vergleich zu peer-reviewed Artikeln hinsichtlich der Wissensvermittlung über globale Gesundheit zu bewerten und die Erfahrungen der Studierenden mit dem E-Learning-Programm zu erfassen.
Verwendete Methoden und Datenquellen:


Design: Mixed-Methods-Pilotstudie bestehend aus einem randomisierten kontrollierten Versuch (RCT) und qualitativen Fokusgruppen.


Datenquellen: Wissensquiz und Selbstbewertungsfragebögen basierend auf dem CanMEDS-Kompetenzmodell für globale Gesundheit.


Teilnehmer: 161 vorklinische Medizinstudierende aus drei kanadischen Universitäten.


Evaluationsmethoden:


Quantitative Daten: Wissensquiz und Selbstbewertungsfragebögen vor und nach der Intervention.


Qualitative Daten: Fokusgruppeninterviews nach der Intervention.


Statistische Analyse mittels SPSS-21 und thematische Analyse der Fokusgruppentranskripte mit NVivo-9.




Zentrale Forschungsergebnisse:


Wissenszuwachs: Beide Gruppen (E-Learning und peer-reviewed Artikel) zeigten signifikante Verbesserungen in den durchschnittlichen Wissensscores und bei 5 von 7 selbstbewerteten Kompetenzen (P{\textless}.05). Es gab keinen signifikanten Unterschied zwischen den beiden Ansätzen.


Präferenzen: Die Teilnehmer bevorzugten das E-Learning-Programm aufgrund seiner interaktiven, multimedialen Inhalte, des Zugangs zu Links und Referenzmaterialien sowie der Möglichkeit, über längere Zeiträume hinweg zu lernen und sich erneut zu engagieren.


Barrieren: Hindernisse bei der Nutzung des E-Learning-Programms umfassten Überladung mit Inhalten und technische Schwierigkeiten.


Zusammenfassung
Die Studie zeigt, dass sowohl E-Learning als auch peer-reviewed Artikel das konzeptionelle Wissen über globale Gesundheit signifikant verbessern können. Die Studierenden bevorzugten jedoch das E-Learning aufgrund seiner interaktiven und flexiblen Natur. Die Integration solcher Programme in den Lehrplan könnte die Ausbildung in globaler Gesundheit effektiv unterstützen.
Kernaussagen


„Sowohl das E-Learning-Programm als auch die peer-reviewed Artikel verbesserten das konzeptionelle Wissen über globale Gesundheit signifikant.“ (S. 5)


„Die Teilnehmer bevorzugten das E-Learning-Programm aufgrund seiner interaktiven, multimedialen Inhalte und der Möglichkeit, sich über längere Zeiträume hinweg zu engagieren.“ (S. 6)


„Hindernisse bei der Nutzung des E-Learning-Programms umfassten Überladung mit Inhalten und technische Schwierigkeiten.“ (S. 7)


Argumentationslinien


Effektivität von E-Learning: Die Studie argumentiert, dass E-Learning eine effektive Methode zur Wissensvermittlung in der medizinischen Ausbildung sein kann, insbesondere im Bereich der globalen Gesundheit. (S. 6)


Präferenzen der Lernenden: Die Präferenz der Studierenden für E-Learning deutet darauf hin, dass interaktive und flexible Lernmethoden in der modernen medizinischen Ausbildung bevorzugt werden. (S. 6-7)


Technologische Herausforderungen: Die Identifizierung von Barrieren wie technische Schwierigkeiten und Inhaltüberladung zeigt die Notwendigkeit einer kontinuierlichen Verbesserung und Anpassung von E-Learning-Programmen. (S. 7)


Verschlagwortung


Lehr- und Lerneffektivität: Untersuchung der Effektivität von E-Learning-Programmen zur Wissensvermittlung in der medizinischen Ausbildung.


Technologieintegration: Nutzung von E-Learning zur Unterstützung der Ausbildung in globaler Gesundheit.


Systemanpassung: Anpassung von E-Learning-Programmen an die Bedürfnisse und Präferenzen der Medizinstudierenden.


Forschungsansätze: Mixed-Methods-Ansatz zur Bewertung der Effektivität von E-Learning und peer-reviewed Artikeln.


Kategorisierung: Argumentation
Begründung:
Die Studie von Gruner et al. (2015) liefert Argumente für die Effektivität von E-Learning-Programmen im Vergleich zu traditionellen Lehrmethoden (peer-reviewed Artikel) zur Vermittlung von Wissen über globale Gesundheit. Durch die detaillierte Analyse der Wissenszuwächse und die Präferenzen der Studierenden wird argumentiert, dass E-Learning-Programme eine wertvolle Ergänzung zur medizinischen Ausbildung darstellen können. Diese Argumentationslinien sind besonders relevant für die Forschungsfragen des Exposés, da sie die praktischen und theoretischen Aspekte der Implementierung und Optimierung von E-Learning-Methoden im digitalen Bildungsraum beleuchten.
Kategorie: Argumentation
Zuordnung zur Forschungsfrage
FU3: Wie sind Konzeption und relevante didaktische und bildungstechnologische Merkmale des systemisch-konstruktivistischen Learning-Management-Systems für Akteure im digitalen Bildungsraum von Gesundheitsberufen dargestellt?
Begründung:
Die Studie untersucht die didaktischen und bildungstechnologischen Merkmale des E-Learning-Programms und vergleicht es mit peer-reviewed Artikeln. Diese Erkenntnisse sind besonders relevant, um die Konzeption und die Merkmale eines systemisch-konstruktivistischen Learning-Management-Systems im digitalen Bildungsraum von Gesundheitsberufen zu verstehen und zu optimieren.
},
	file = {Gruner et al. - 2015 - Introducing global health into the undergraduate m.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/G633JGFU/Gruner et al. - 2015 - Introducing global health into the undergraduate m.pdf:application/pdf},
}

@article{alomari_framework_2020,
	title = {A {Framework} for the {Impact} of {Human} {Factors} on the {Effectiveness} of {Learning} {Management} {Systems}},
	volume = {8},
	issn = {2169-3536},
	url = {https://ieeexplore.ieee.org/document/8974212/},
	doi = {10/gs3z58},
	abstract = {Higher education institutions (HEI) have realized the advantages of implementing a blended learning environment by using learning management systems (LMSs) to provide effective ways of learning and teaching. However, recent literature has revealed that developing countries’ educational institutions fail when they adopt LMS technologies because they ignore the human factors related to these technologies. This study investigated the impact of human factors on the effectiveness of LMS in a blended learning environment at Kuwait’s HEIs (KHEIs). In this paper, a pragmatic approach consisting of quantitative and qualitative methods is used. User characteristics traits from the literature review were organized into three main indicators of human impact on the effectiveness of LMS: technological characteristics, psychological characteristics, and student-instructor interaction characteristics. After these indicators were identiﬁed, a conceptual model was developed to study the characteristics. A deductive approach was used, and the model was tested for signiﬁcance through receiving feedback from the universities’ students and faculty members. In addition, an inductive approach was implemented through conducting interviews to explore more factors related to the effectiveness of LMS. The inductive approach’s results revealed the relevant factors for the usage of the LMS, such as training, needs, expectations, and branding. The human factors that positively affect the success and effectiveness of LMS included attitude, enjoyment, experience, self-efﬁcacy, and promptness, which had the most substantial impacts on user satisfaction. The modiﬁed conceptual model that this paper presents includes these impacting factors and provides an acceptable ﬁt to the data. This research has developed an updated framework for demonstrating the effectiveness of LMS as it pertains to human factors, and its ﬁndings can be used to enhance user experience in a blended learning environment, thus improving the quality of Kuwaiti education.},
	language = {en-GB},
	urldate = {2023-11-07},
	journal = {IEEE Access},
	author = {Alomari, Majdi M. and El-Kanj, Hania and Alshdaifat, Nafesah I. and Topal, Ayse},
	year = {2020},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Systemanpassung, Bildungstheorien, \#1:Zeitschriftenartikel:learning:management:system, Bildung, Multimedia, Lernsystemarchitektur, Kernstudie, Promotion:S:01 Learning Management System, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {23542--23558},
	annote = {Kernstudie identifiziert für das Forschungsprojekt "Wirkgefüge im digitalen Bildungsraum":


Titel: A Framework for the Impact of Human Factors on the Effectiveness of Learning Management Systems


Autoren: Alomari, M. M.; El-Kanj, H.; Alshdaifat, N. I.; Topal, A.


Publiziert in: IEEE Access


Band/Volume: 8


Seiten: 23542–23558


Jahr: 2020


DOI: https://doi.org/10/gs3z58


Beschreibung der Studie: Diese Studie entwickelt ein Rahmenwerk, das untersucht, wie menschliche Faktoren die Effektivität von Learning Management Systemen (LMS) beeinflussen. Sie bietet eine umfassende Analyse der Interaktionen zwischen Benutzern und der Technologie, was sie zu einer zentralen Referenz für das Verständnis der Dynamiken innerhalb digitaler Bildungsumgebungen macht.
Bedeutung für das Forschungsprojekt: Diese Studie dient als Grundlage für das Verständnis und die Ableitung weiterer Forschungsansätze im Bereich des digitalen Lernens, speziell bezogen auf die Nutzung und Effektivität von LMS in verschiedenen Bildungskontexten.
