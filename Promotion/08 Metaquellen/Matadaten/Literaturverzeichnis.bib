@article{misiejuk_changes_2023,
	title = {Changes in online course designs: {Before}, during, and after the pandemic},
	volume = {7},
	issn = {2504-284X},
	shorttitle = {Changes in online course designs},
	url = {https://www.frontiersin.org/articles/10.3389/feduc.2022.996006/full},
	doi = {10.3389/feduc.2022.996006},
	abstract = {The switch to emergency remote teaching during the COVID-19 pandemic became for many university instructors a necessity to familiarise themselves with the institution’s online learning management system (LMS). This switch to online teaching made learning activities, course design patterns, and pedagogical approaches more visible than during face-to-face teaching. Furthermore, the process of translating physical learning activities to the digital space was challenging and needed institutional and leadership support. This paper presents an analysis of the changes made to the learning designs of 102 courses in a university’s LMS before, during, and after the pandemic. Using descriptive statistics and Epistemic Network Analysis we used LMS data to explore the use of LMS features revealing not only the overall university trends, but also faculty differences. In addition, we compared the learning activities as described in course descriptions with the actual learning activities designed in the LMS. Our findings show that although the switch to emergency remote teaching forced many instructors to change the learning designs of their courses, some instructors reverted to their pre-pandemic learning designs after the pandemic, while other instructors did not change their learning design during the pandemic at all. In addition, we identified a positive trend of an increased use of activity features in the learning management system. Finally, we reflected on the importance of the university leadership supporting the digital transformation.},
	language = {en-GB},
	urldate = {2024-06-28},
	journal = {Frontiers in Education},
	author = {Misiejuk, Kamila and Ness, Ingunn Johanne and Gray, Robert and Wasson, Barbara},
	month = jan,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Promotion:FU4a, Promotion:Kerngedanke, Technologieintegration, Promotion:Relevanz:4, \#1:Zeitschriftenartikel:learning:management:system, Krisenreaktion im Bildungsbereich, Lernsystemarchitektur, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {996006},
	file = {Misiejuk et al. - 2023 - Changes in online course designs Before, during, .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/GYDXVEB3/Misiejuk et al. - 2023 - Changes in online course designs Before, during, .pdf:application/pdf},
}

@article{weaver_implementation_2022,
	title = {Implementation of an {Online} {Poster} {Symposium} for a {Large}-{Enrollment}, {Natural} {Science}, {General} {Education}, {Asynchronous} {Course}},
	volume = {7},
	issn = {2504-284X},
	url = {https://www.frontiersin.org/articles/10.3389/feduc.2022.906995/full},
	doi = {10.3389/feduc.2022.906995},
	abstract = {Asynchronous online courses are popular because they offer benefits to both students and instructors. Students benefit from the convenience, flexibility, affordability, freedom of geography, and access to information. Instructors and institutions benefit by having a broad geographical reach, scalability, and cost-savings of no physical classroom. A challenge with asynchronous online courses is providing students with engaging, collaborative and interactive experiences. Here, we describe how an online poster symposium can be used as a unique educational experience and assessment tool in a large-enrollment (e.g., 500 students), asynchronous, natural science, general education (GE) course. The course, Introduction to Environmental Science (ENR2100), was delivered using distance education (DE) technology over a 15-week semester. In ENR2100 students learn a variety of topics including freshwater resources, surface water, aquifers, groundwater hydrology, ecohydrology, coastal and ocean circulation, drinking water, water purification, wastewater treatment, irrigation, urban and agricultural runoff, sediment and contaminant transport, water cycle, water policy, water pollution, and water quality. Here we present a is a long-term study that takes place from 2017 to 2022 (before and after COVID-19) and involved 5,625 students over 8 semesters. Scaffolding was used to break up the poster project into smaller, more manageable assignments, which students completed throughout the semester. Instructions, examples, how-to videos, book chapters and rubrics were used to accommodate Students’ different levels of knowledge. Poster assignments were designed to teach students how to find and critically evaluate sources of information, recognize the changing nature of scientific knowledge, methods, models and tools, understand the application of scientific data and technological developments, and evaluate the social and ethical implications of natural science discoveries. At the end of the semester students participated in an asynchronous online poster symposium. Each student delivered a 5-min poster presentation using an online learning management system and completed peer reviews of their classmates’ posters using a rubric. This poster project met the learning objectives of our natural science, general education course and taught students important written, visual and verbal communication skills. Students were surveyed to determine, which parts of the course were most effective for instruction and learning. Students ranked poster assignments first, followed closely by lectures videos. Approximately 87\% of students were confident that they could produce a scientific poster in the future and 80\% of students recommended virtual poster symposiums for online courses.},
	language = {en-GB},
	urldate = {2024-06-28},
	journal = {Frontiers in Education},
	author = {Weaver, Ella M. and Shaul, Kylienne A. and Lower, Brian H.},
	month = jun,
	year = {2022},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:FU4a, Promotion:Relevanz:5, Technologieintegration, Promotion:Argumentation, \#1:Zeitschriftenartikel:learning:management:system, Lernsystemarchitektur, Promotion:S:01 Learning Management System, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {906995},
	annote = {Analyse des Artikels "Implementation of an Online Poster Symposium for a Large-Enrollment, Natural Science, General Education, Asynchronous Course" von Weaver et al. (2022)
1. Analyse
Hauptthemen und -ziele der Forschung: Der Artikel beschreibt die Implementierung eines Online-Postersymposiums für einen großen, asynchronen Kurs in Naturwissenschaften an der Ohio State University. Ziel der Studie ist es, die Effektivität dieses Formats zur Förderung von Engagement und interaktiven Lernerfahrungen in einem Online-Lernumfeld zu bewerten.
Verwendete Methoden und Datenquellen:


Methodische Ansätze: Langzeitstudie über fünf Jahre (2017-2022) mit 5.625 Studenten, die an insgesamt neun Online-Poster-Symposien teilgenommen haben.


Werkzeuge und Datenquellen: Verwendung von Canvas LMS zur Verwaltung von Posterprojekten, Peer-Reviews und zur Durchführung von Umfragen zur Bewertung der Effektivität und des Studentenerlebnisses.


Zentrale Forschungsergebnisse:


Nutzung und Akzeptanz: 87\% der Studierenden waren zuversichtlich, dass sie in Zukunft wissenschaftliche Poster erstellen können, und 80\% empfahlen das virtuelle Postersymposium für andere Online-Kurse.


Lernförderung: Studierende lernten am meisten durch Posteraufgaben, gefolgt von Vorlesungsvideos. Die Interaktion mit Kommilitonen während des Postersymposiums wurde ebenfalls als wertvoll empfunden.


Effizienz und Flexibilität: Das asynchrone Format ermöglichte den Studierenden eine flexible Zeiteinteilung und förderte die Teilnahme und das Engagement über verschiedene Zeitzonen und geografische Standorte hinweg.


2. Zusammenfassung
Kernpunkte des Artikels:


Problemstellung: Ermittlung der Effektivität von Online-Postersymposien als Bildungs- und Bewertungsinstrument in einem großen, asynchronen Kurs in Naturwissenschaften.


Methodik: Langzeitstudie mit 5.625 Studierenden über fünf Jahre, die Posterprojekte und Peer-Reviews durchführten.


Hauptergebnisse: Hohe Akzeptanz und wahrgenommener Nutzen der Posteraufgaben und -symposien, signifikante Förderung des Engagements und der Lernleistung.


Schlussfolgerungen: Die Ergebnisse zeigen, dass Online-Postersymposien eine effektive Methode zur Förderung von wissenschaftlicher Kommunikation und interaktivem Lernen in asynchronen Kursen sind.


3. Kernaussagen


Effektivität der Posteraufgaben: „Poster assignments were ranked first in terms of learning effectiveness by the majority of students.“ (S. 1)


Studentenzufriedenheit: „Approximately 87\% of students felt confident that they could produce a scientific poster in the future.“ (S. 7)


Empfehlung: „80\% of students recommended virtual poster symposiums for other online courses.“ (S. 7)


4. Argumentationslinien


Flexibilität und Engagement: Der Artikel argumentiert, dass das asynchrone Format des Postersymposiums die Flexibilität erhöht und das Engagement der Studierenden fördert.


Peer-Interaktion: Es wird betont, dass die Peer-Reviews während des Postersymposiums den Lernprozess vertiefen und die wissenschaftliche Kommunikation stärken.


Rolle von LMS: Der Einsatz des Canvas LMS wird als zentral für die erfolgreiche Umsetzung und Verwaltung des Postersymposiums beschrieben.


5. Verschlagwortung


Lernsystemarchitektur


Begründung: Der Artikel diskutiert die Implementierung eines neuen Systems zur Unterstützung des Lernens durch Online-Postersymposien.


Fundstelle: S. 3




Lehr- und Lerneffektivität


Begründung: Die Studie zeigt, wie Posteraufgaben und -symposien die Lernleistung und das Engagement der Studierenden verbessern können.


Fundstelle: S. 7




Technologieintegration


Begründung: Der Artikel beschreibt die Integration des Canvas LMS zur Durchführung und Verwaltung des Postersymposiums.


Fundstelle: S. 3




6. Kategorisierung


Kategorie: Argumentation


Kriterium: Nutzung von empirischen Daten und Theorien zur Unterstützung der These, dass Online-Postersymposien die Lernleistung und das Engagement der Studierenden verbessern können.


Beispiel: Der Artikel diskutiert die Effektivität der Posteraufgaben und unterstützt dies mit empirischen Beispielen und Berichten aus den neun Semestern.




7. Zuordnung zu Forschungsfragen


FU4a: Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?


Begründung: Der Artikel untersucht, wie Online-Postersymposien das Lernverhalten und die wissenschaftliche Kommunikation der Studierenden beeinflussen.


Fundstelle: S. 3




8. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5/5


Der Artikel liefert detaillierte Einblicke in die Nutzung und den Nutzen von Online-Postersymposien, die relevant für die Forschungsfrage sind.




Zitierhäufigkeit und Einfluss des Artikels: 4/5


Basierend auf der detaillierten Untersuchung und der praktischen Anwendung der Ergebnisse ist der Artikel wahrscheinlich in akademischen Kreisen einflussreich.




Aktualität des Artikels: 5/5


Veröffentlicht im Jahr 2022, ist der Artikel hochaktuell und bezieht sich auf die neuesten Entwicklungen im Bereich der Online-Bildung und wissenschaftlichen Kommunikation.




Gesamtbewertung: 5/5
Diese Analyse zeigt die Relevanz des Artikels für die Untersuchung der Nutzung und des Nutzens von Online-Postersymposien im Bildungskontext und bietet wertvolle Einblicke für zukünftige Forschungen und Praktiken.
},
	file = {Weaver et al. - 2022 - Implementation of an Online Poster Symposium for a.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/8CNYZWEE/Weaver et al. - 2022 - Implementation of an Online Poster Symposium for a.pdf:application/pdf},
}

@article{martinez-alcala_digital_2018,
