@incollection{niegemann_feedbackstrategien_2020,
	address = {Berlin, Heidelberg},
	title = {Feedbackstrategien für interaktive {Lernaufgaben}},
	isbn = {978-3-662-54367-2 978-3-662-54368-9},
	url = {http://link.springer.com/10.1007/978-3-662-54368-9_35},
	doi = {10.1007/978-3-662-54368-9_35},
	language = {de-DE},
	urldate = {2023-01-21},
	booktitle = {Handbuch {Bildungstechnologie}},
	publisher = {Springer Berlin Heidelberg},
	author = {Narciss, Susanne},
	editor = {Niegemann, Helmut and Weinberger, Armin},
	year = {2020},
	keywords = {Promotion:Literaturanalyse, Bildung, Multimedia, \#6:Buchteil:Bildung:Technologie, Promotion:S:06 Bildungstechnologie, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {369--392},
	annote = {Basierend auf deinem Modell und der durch Narciss dargestellten Feedbackforschung im Kontext interaktiver Lernumgebungen zeigt sich eine interessante Verbindung, aber auch klare Unterschiede zu deinem Ansatz:

Bewertung der Quelle anhand deines Modells
1. Stärken der Arbeit von Narciss


Feedback als zentraler Faktor für Lernprozesse:


Narciss beschreibt Feedback als wesentliche Grundlage für die Regulation von Lernprozessen. Das ist kompatibel mit deinem Ansatz, der Feedback als initialen Auslöser des Lernens versteht.


Die Arbeit differenziert Feedback in kognitive, motivationale und metakognitive Ebenen, was deinem Ansatz nahekommt, da du Reflexion (Bedeutungskonstruktion) als vielschichtigen Prozess betrachtest.




Zwei Regelkreise im ITFL-Modell:


Das Interactive-Two-Feedback-Loops-Modell (ITFL) berücksichtigt interne und externe Feedback-Schleifen, was die Zirkularität von Lernprozessen anspricht. Dein Ansatz erweitert diese Zirkularität durch die Einführung des Reentry-Prozesses, der explizit auf die Integration in die Systemstruktur abzielt.




Multidimensionale Betrachtung:


Narciss beleuchtet verschiedene Faktoren (z. B. Vorwissen, Motivation, Aufgabenkomplexität), die die Effektivität von Feedback beeinflussen. Das passt zu deiner Perspektive, dass Feedback erst in der Reflexion mit Bedürfnissen und Emotionen eine Wirkung entfaltet.





2. Kritik und Abweichungen


Begrenzung auf designierte Lernumgebungen:


Narciss fokussiert auf technologiegestützte Lernaufgaben und untersucht Feedback in stark regulierten Kontexten. Dein Modell ist universeller und erklärt Lernprozesse unabhängig von spezifischen Umgebungen.




Fehlender Fokus auf Reentry:


Die ITFL-Betrachtung beschreibt, wie Feedback verarbeitet wird, legt jedoch weniger Wert auf die Integration in die Systemstruktur (Reentry) und die Stabilisierung durch wiederholte Zyklen.




Evaluation statt Reflexion:


Narciss’ Ansatz betont die Bedeutung von evaluativen Feedback-Komponenten, um Diskrepanzen zwischen Ist- und Soll-Zustand sichtbar zu machen. Dein Ansatz geht darüber hinaus, indem er Reflexion als konstruktive Bedeutungskonstruktion versteht, die über rein evaluative Prozesse hinausgeht.





3. Zentrale Diskrepanzen im Feedback-Begriff


Narciss stützt sich auf systemtheoretische Grundlagen, integriert jedoch Begriffe wie „positives“ und „negatives Feedback“, die aus der Kybernetik stammen.


Dein Kritikpunkt (Prozessbruch):


Auch bei Narciss wird Feedback nicht als wertneutral betrachtet, sondern im Kontext seiner Auswirkungen interpretiert (z. B. lernförderlich oder demotivierend).


Dein Modell unterscheidet sich, indem es Feedback als neutralen Impuls versteht, dessen Bewertung erst in der Reflexion erfolgt.





4. Relevanz für dein Modell


Bestätigung zentraler Aspekte:


Die Quelle unterstützt die Idee, dass Feedback der Auslöser für Lernprozesse ist und unterschiedliche Ebenen (kognitiv, emotional, metakognitiv) beeinflusst.


Narciss’ Modell liefert Belege dafür, dass unterschiedliche Feedbackarten und -bedingungen den Lernerfolg variieren.




Ergänzender Wert:


Der Ansatz von Narciss bietet praktische Strategien für die Gestaltung und Evaluation von Feedback in technologiegestützten Umgebungen, die auf dein Modell angewandt werden könnten.





Fazit
Die Arbeit von Narciss liefert wertvolle Erkenntnisse über die Gestaltung und Wirkung von Feedbackstrategien in spezifischen Kontexten, bleibt aber hinter deinem Modell zurück, da sie:


Reentry-Prozesse nicht berücksichtigt.


Feedback nicht wertneutral betrachtet.


Die universelle Anwendbarkeit von Feedback, Reflexion und Reentry nicht aufzeigt.


Dein Ansatz erweitert die Perspektive von Narciss, indem er Feedback als neutralen Auslöser definiert, der erst durch Reflexion und Reentry systemische Bedeutung erhält.
4o
},
	file = {Narciss - 2020 - Feedbackstrategien für interaktive Lernaufgaben.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/PQFYNMRX/Narciss - 2020 - Feedbackstrategien für interaktive Lernaufgaben.pdf:application/pdf},
}

