@article{bail_technostresserleben_2024,
	title = {Technostresserleben in der stationären medizinischen {Versorgung} in deutschen und schweizerischen {Kliniken}: aktueller {Forschungsstand}},
	issn = {0944-2502, 2198-0713},
	shorttitle = {Technostresserleben in der stationären medizinischen {Versorgung} in deutschen und schweizerischen {Kliniken}},
	url = {https://link.springer.com/10.1007/s40664-024-00542-3},
	doi = {10.1007/s40664-024-00542-3},
	abstract = {Zusammenfassung
            
              Hintergrund
              Ziel dieser Arbeit ist die Darstellung der aktuellen Studienlage zur Prävalenz und Ausprägung von Technostresserleben in der stationären medizinischen Versorgung in deutschen und schweizerischen Kliniken. Dieses stellt ein aufkommendes Risiko im Zusammenhang mit dem zunehmenden Einsatz von Informations- und Kommunikationstechnologien (IKT) im Gesundheitswesen dar.
            
            
              Methodik
              Mithilfe einer systematischen Literaturrecherche wurden unter Verwendung von Schlüsselbegriffen vordefinierten Ein- und Ausschlusskriterien 49 Artikel identifiziert, von denen 9 Studien einbezogen worden sind.
            
            
              Ergebnisse
              Theoretische Grundlage der in dieser Arbeit analysierten Studien bildet überwiegend das Technostress-Konzept von Ragu-Nathan et al. (2008) mit den Subkategorien Techno-overload, Techno-complexity, Techno-insecurity, Techno-uncertainty und Techno-invasion. Bei fast allen Studien handelt es sich um Querschnittsstudien, welche sich auf die Ausprägung von Technostress unter Ärzt:innen, seltener Pfleger:innen und anderen Gesundheitsberufen konzentriert haben sowie auf die Analyse der auslösenden und abschwächenden Faktoren von Technostress und Auswirkungen auf organisationale und gesundheitsbezogene Outcomes (u. a. Produktivität, Arbeitszufriedenheit, Burnout). Die aktuelle Studienlage spricht hierbei für ein moderates Level von Technostress, wobei die höchsten Ausprägungen für die Subkategorien „Techno-overload“ und „Techno-uncertainty“ erhoben worden sind.
            
            
              Schlussfolgerung
              Ärzt:innen und Pfleger:innen zeigen die höchsten Ausprägungen von Technostresserleben, gefolgt von Medizinisch-technischen, Medizinisch-therapeutischen und anderen Berufen (z. B. Sozialarbeiter:innen, Psycholog:innen, Hebammen). Es mangelt jedoch an empirischen Studien zu nichtärztlichen Gesundheitsberufen sowie an Interventionsstudien, die insbesondere Coping-Strategien im Umgang mit arbeitsbezogenem Technostresserleben evaluieren und darauf basierende Handlungsempfehlungen für Gesundheitsorganisationen aussprechen.
            
          , 
            Abstract
            
              Background
              The aim of this review article is to present the current state of research on the prevalence and severity of technostress experience in inpatient medical care in German and Swiss hospitals. This is an emerging risk among healthcare personnel in hospitals in connection with the increasing use of information and communication technologies (ICT) in healthcare.
            
            
              Methods
              A systematic literature search was carried out using key terms and predefined inclusion and exclusion criteria identified 49 articles, of which 9 studies were included.
            
            
              Results
              The theoretical basis of the studies analyzed in this article is predominantly the technostress concept of Ragu-Nathan et al. (2008) with the subcategories techno-overload, techno-complexity, techno-insecurity, techno-uncertainty and techno-invasion. Almost all studies are cross-sectional in nature that focused on the extent of technostress among physicians, less frequently among nurses and other healthcare professions as well as on the analysis of the triggering and mitigating factors of technostress and effects on organizational and health-related outcomes (including productivity, job satisfaction, burnout). The current study situation indicates a moderate level of technostress, with the highest levels recorded for the subcategories techno-overload and techno-uncertainty.
            
            
              Conclusion
              Physicians and nurses show the highest levels of technostress, followed by medical technical, medical therapeutic and other professions (e.g., social workers, psychologists, midwives); however, there is a lack of empirical studies on nonmedical healthcare professions as well as interventional studies that particularly evaluate coping strategies in dealing with work-related technostress and make recommendations for action for healthcare organizations based on this.},
	language = {de-DE},
	urldate = {2024-06-30},
	journal = {Zentralblatt für Arbeitsmedizin, Arbeitsschutz und Ergonomie},
	author = {Bail, Clara and Marquardt, Berit and Harth, Volker and Mache, Stefanie},
	month = jun,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Weiterführung, \#6:Zeitschriftenartikel:Bildung:Technologie, Datenschutz und IT-Sicherheit, Krisenreaktion im Bildungsbereich, Promotion:FU2b, Promotion:Relevanz:3, Promotion:S:06 Bildungstechnologie, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU2b},
	annote = {Analyse des Artikels "Technostresserleben in der stationären medizinischen Versorgung in deutschen und schweizerischen Kliniken: aktueller Forschungsstand" von Bail et al. (2024)
1. Analyse
Hauptthemen und -ziele der Forschung: Der Artikel untersucht die Prävalenz und Auswirkungen von Technostress auf Beschäftigte in der stationären medizinischen Versorgung in deutschen und schweizerischen Kliniken. Ziel ist es, die Ausprägungen von Technostress zu erfassen und deren Auswirkungen auf die psychische Gesundheit und Arbeitszufriedenheit des medizinischen Personals zu analysieren.
Verwendete Methoden und Datenquellen:


Methodische Ansätze: Systematische Literaturrecherche und Analyse bestehender Studien.


Werkzeuge und Datenquellen: Analyse von 49 Artikeln, von denen 9 Studien in die Untersuchung einbezogen wurden, basierend auf vordefinierten Ein- und Ausschlusskriterien.


Zentrale Forschungsergebnisse:


Häufigkeit von Technostress: Es wurde ein moderates Level von Technostress bei den meisten Berufsgruppen festgestellt, mit den höchsten Werten für die Subkategorien Techno-overload und Techno-uncertainty.


Auswirkungen auf die Gesundheit: Technostress führt zu erhöhten Burnout-Raten, geringerer Arbeitszufriedenheit und verminderter Work-Life-Balance.


Berufsgruppen: Ärztund Pflegerzeigen die höchsten Ausprägungen von Technostress, gefolgt von medizinisch-technischen und medizinisch-therapeutischen Berufen.


2. Zusammenfassung
Kernpunkte des Artikels:


Problemstellung: Untersuchung der Prävalenz und Auswirkungen von Technostress auf das medizinische Personal in deutschen und schweizerischen Kliniken.


Methodik: Systematische Literaturrecherche und Analyse von 9 relevanten Studien.


Hauptergebnisse: Moderates Level von Technostress mit den höchsten Ausprägungen für Techno-overload und Techno-uncertainty; negative Auswirkungen auf die psychische Gesundheit und Arbeitszufriedenheit.


Schlussfolgerungen: Notwendigkeit weiterer empirischer Studien und Interventionsstudien, um Coping-Strategien zu entwickeln und umzusetzen.


3. Kernaussagen


Technostress: „The current study situation indicates a moderate level of technostress, with the highest levels recorded for the subcategories techno-overload and techno-uncertainty.“ (S. 4)


Gesundheitliche Auswirkungen: „Technostress can lead to increased burnout rates, lower job satisfaction, and reduced work-life balance.“ (S. 5)


Berufsgruppen: „Physicians and nurses show the highest levels of technostress, followed by medical technical, medical therapeutic, and other professions.“ (S. 5)


4. Argumentationslinien


Wichtigkeit der Prävention: Der Artikel argumentiert, dass es entscheidend ist, präventive Maßnahmen zur Reduzierung von Technostress zu entwickeln und umzusetzen, um die psychische Gesundheit und Arbeitszufriedenheit des medizinischen Personals zu verbessern.


Notwendigkeit weiterer Forschung: Es wird betont, dass es an empirischen Studien zu nicht-ärztlichen Gesundheitsberufen und Interventionsstudien zur Evaluation von Coping-Strategien mangelt.


Einfluss von Technostress: Die Studie zeigt, dass Technostress signifikant mit negativen gesundheitlichen und organisatorischen Outcomes assoziiert ist.


5. Verschlagwortung


Lehr- und Lerneffektivität


Begründung: Der Artikel thematisiert, wie Technostress die Arbeitszufriedenheit und Produktivität des medizinischen Personals beeinflusst, was indirekt die Effektivität von Lern- und Arbeitsprozessen betrifft.


Fundstelle: S. 5




Datenschutz und IT-Sicherheit


Begründung: Technostress wird durch die Nutzung von IT-Systemen im Krankenhausumfeld beeinflusst, was Aspekte des Datenschutzes und der IT-Sicherheit umfasst.


Fundstelle: S. 3




Krisenreaktion im Bildungsbereich


Begründung: Die Studie behandelt die Anpassung der Arbeitsmethoden an die Herausforderungen der digitalen Transformation, was Parallelen zur Krisenreaktion im Bildungsbereich aufzeigt.


Fundstelle: S. 4




6. Kategorisierung


Kategorie: Weiterführung


Kriterium: Der Artikel bietet Empfehlungen für zukünftige Forschungen und die Weiterentwicklung von Strategien zur Bewältigung von Technostress.


Beispiel: Vorschläge zur Implementierung präventiver Maßnahmen und zur Entwicklung von Coping-Strategien für medizinisches Personal.




7. Zuordnung zu Forschungsfragen


FU2b: Welche Effekt-Faktoren erläutern Lehrende im digitalen Bildungsraum von Gesundheitsberufen bei der Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems?


Begründung: Der Artikel untersucht die Effekte von Technostress auf das medizinische Personal, was für die Erforschung der Effekte von Technostress im digitalen Bildungsraum relevant ist.


Fundstelle: S. 5




Gesamtbewertung: 3/5
Diese Analyse zeigt die Relevanz des Artikels für die Untersuchung der Prävalenz und Auswirkungen von Technostress auf das medizinische Personal in deutschen und schweizerischen Kliniken und bietet wertvolle Einblicke in die Weiterentwicklung von Bewältigungsstrategien und präventiven Maßnahmen.
},
	file = {Bail et al. - 2024 - Technostresserleben in der stationären medizinisch.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/KBPKQAZX/Bail et al. - 2024 - Technostresserleben in der stationären medizinisch.pdf:application/pdf},
}

@article{mathur_developing_2023,
	title = {Developing knowledge-based psychotherapeutic competencies in non-specialist providers: {A} pre-post study with a nested randomised controlled trial of a coach-supported versus self-guided digital training course for a problem-solving psychological intervention in {India}},
	volume = {10},
	issn = {2054-4251},
	shorttitle = {Developing knowledge-based psychotherapeutic competencies in non-specialist providers},
	doi = {10.1017/gmh.2023.81},
	abstract = {We evaluated a digital learning programme for non-specialists to develop knowledge-based competencies in a problem-solving intervention for adolescents to examine the overall impact of training on knowledge-based competencies among learners; and to compare the effects of two training conditions (self-guided digital training with or without coaching) in a nested parallel, two-arm, individually randomised controlled trial. Eligible participants were 18 or older; fluent in Hindi or English; able to access digital training; and had no prior experience of delivering structured psychotherapies. 277 participants were enrolled from 31 March 2022 to 19 June 2022 of which 230 (83\%) completed the study. There was a significant increase in competency score from pre-training (Mean = 7.01, SD = 3.29) to post-training (Mean = 8.88, SD = 3.80), 6 weeks after the pre-training assessment. Knowledge competency scores showed larger increase among participants randomised to the coaching arm (AMD = 1.09, 95\% CI 0.26-1.92, p = 0.01) with an effect size (d) of 0.33 (95\% CI 0.08-0.58). More participants completed training in the coaching arm (n = 96, 69.6\%) compared to the self-guided training arm (n = 56, 40.3\%). In conclusion, a coach-supported remote digital training intervention is associated with enhanced participation by learners and increased psychotherapeutic knowledge competencies.},
	language = {en-GB},
	journal = {Global Mental Health (Cambridge, England)},
	author = {Mathur, Sonal and Weiss, Helen A. and Neuman, Melissa and Leurent, Baptiste and Field, Andy P. and Shetty, Tejaswi and J, James E. and Nair, Pooja and Mathews, Rhea and Malik, Kanika and Michelson, Daniel and Patel, Vikram},
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Bewertungsmethoden, Promotion:Relevanz:4, \#0:Zeitschriftenartikel:digital:learning, Promotion:FU2b, India, adolescent mental health, digital training, capacity building, knowledge-based competency, problem-solving intervention, randomised controlled trial, Promotion:S:12 Digital Learning, Promotion:Literaturverzeichnis},
	pages = {e87},
	annote = {Analyse des Artikels "Developing knowledge-based psychotherapeutic competencies in non-specialist providers: A pre-post study with a nested randomised controlled trial of a coach-supported versus self-guided digital training course for a problem-solving psychological intervention in India" von Sonal Mathur et al. (2023)
1. Analyse
Hauptthemen und -ziele der Forschung: Der Artikel untersucht die Entwicklung von psychotherapeutischen Kompetenzen bei nicht-spezialisierten Anbietern durch ein digitales Trainingsprogramm. Ziel der Forschung ist es, die Auswirkungen eines coach-unterstützten gegenüber einem selbstgeführten digitalen Trainingsprogramms auf die Kompetenzentwicklung zu vergleichen und die Teilnahmeraten und Zufriedenheit der Teilnehmer zu bewerten.
Verwendete Methoden und Datenquellen:


Methodische Ansätze: Eine Kombination aus einer Vorher-Nachher-Studie und einer verschachtelten, randomisierten kontrollierten Studie (RCT) wurde verwendet, um die Auswirkungen der Trainingsbedingungen zu bewerten.


Werkzeuge und Datenquellen: Digitale Trainingsplattformen, die 16 Module mit Videovorträgen, Rollenspieldemonstrationen, narrativ begleiteten Folien, Selbstbewertungsquiz und Lesematerialien umfassen. Teilnehmer wurden aus Universitäten und NGOs in Indien rekrutiert.


Zentrale Forschungsergebnisse:


Kompetenzentwicklung: Beide Trainingsbedingungen führten zu einer signifikanten Verbesserung der Kompetenzwerte der Teilnehmer. Der Kompetenzwert stieg von einem Mittelwert von 7.01 vor dem Training auf 8.88 nach dem Training.


Effekt der Coach-Unterstützung: Teilnehmer im coach-unterstützten Arm zeigten eine größere Verbesserung der Kompetenzwerte im Vergleich zum selbstgeführten Arm (adjustierter Mittelwertunterschied von 1.09, p = 0.01).


Trainingsteilnahme: Teilnehmer im coach-unterstützten Arm waren signifikant wahrscheinlicher, das Training vollständig abzuschließen (69.6\% gegenüber 40.3\% im selbstgeführten Arm).


2. Zusammenfassung
Kernpunkte des Artikels:


Problemstellung: Untersuchung der Effizienz von coach-unterstütztem gegenüber selbstgeführtem digitalem Training zur Entwicklung psychotherapeutischer Kompetenzen bei nicht-spezialisierten Anbietern.


Methodik: Eine verschachtelte RCT innerhalb einer Vorher-Nachher-Studie mit Teilnehmern aus verschiedenen NGOs und Universitäten in Indien.


Hauptergebnisse: Beide Trainingsformate verbesserten die Kompetenzen der Teilnehmer signifikant, wobei der coach-unterstützte Ansatz effektiver war. Die Teilnahmeraten waren im coach-unterstützten Arm höher.


Schlussfolgerungen: Coach-unterstütztes digitales Training ist eine effektive Methode zur Entwicklung psychotherapeutischer Kompetenzen und zeigt höhere Teilnahmeraten und größere Kompetenzzuwächse im Vergleich zu selbstgeführtem Training.


3. Kernaussagen


Kompetenzentwicklung: „There was a significant increase in competency score from pre-training (Mean = 7.01, SD = 3.29) to post-training (Mean = 8.88, SD = 3.80), 6 weeks after the pre-training assessment.“ (S. 2)


Effekt der Coach-Unterstützung: „Knowledge competency scores showed larger increase among participants randomised to the coaching arm (AMD = 1.09, 95\% CI 0.26–1.92, p = 0.01) with an effect size (d) of 0.33 (95\% CI 0.08–0.58).“ (S. 2)


Trainingsteilnahme: „More participants completed training in the coaching arm (n = 96, 69.6\%) compared to the self-guided training arm (n = 56, 40.3\%).“ (S. 2)


4. Argumentationslinien


Wirksamkeit des Trainings: Der Artikel argumentiert, dass sowohl selbstgeführtes als auch coach-unterstütztes digitales Training effektiv sind, um die Kompetenzentwicklung zu fördern, wobei das coach-unterstützte Training größere Verbesserungen zeigt.


Teilnahmeraten und Zufriedenheit: Es wird betont, dass coach-unterstütztes Training höhere Teilnahmeraten und Zufriedenheitswerte aufweist, was auf die Bedeutung der persönlichen Unterstützung und Motivation hinweist.


Zukünftige Empfehlungen: Der Artikel schlägt vor, dass zukünftige Forschungen die Langzeiteffekte der digitalen Trainingsformate und deren Anwendung in anderen Kontexten untersuchen sollten.


5. Verschlagwortung


Lehr- und Lerneffektivität:


Begründung: Der Artikel untersucht die Effektivität digitaler Trainingsmethoden zur Verbesserung der psychotherapeutischen Kompetenzen.


Fundstelle: S. 2




Technologieintegration:


Begründung: Der Artikel behandelt die Integration digitaler Plattformen zur Unterstützung der Kompetenzentwicklung.


Fundstelle: S. 2




Bewertungsmethoden:


Begründung: Der Artikel evaluiert die Wirksamkeit verschiedener digitaler Trainingsmethoden durch eine strukturierte Bewertung der Kompetenzzuwächse.


Fundstelle: S. 2




6. Kategorisierung


Kategorie: Kerngedanke


Kriterium: Der Artikel liefert wesentliche Gedanken zur Rolle und Wirkung digitaler Trainingsprogramme für psychotherapeutische Kompetenzen.


Beispiel: Diskussion der Hauptbefunde zur Effektivität von coach-unterstütztem und selbstgeführtem Training. (S. 2)




7. Zuordnung zu Forschungsfragen


FU2b: Welche Effekt-Faktoren erläutern Lehrende im digitalen Bildungsraum von Gesundheitsberufen bei der Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems?


Begründung: Der Artikel untersucht, wie digitale Trainingsmethoden die Kompetenzentwicklung und Unterstützung der Teilnehmer verbessern können.


Fundstelle: S. 2




Gesamtbewertung: 4/5
Diese Analyse zeigt die Relevanz des Artikels für die Untersuchung der Effektivität digitaler Trainingsprogramme zur Entwicklung psychotherapeutischer Kompetenzen. Die Forschung bietet wertvolle Einblicke in die aktuellen Entwicklungen und Herausforderungen in diesem Bereich und gibt Empfehlungen für zukünftige Forschungen.
},
	file = {Mathur et al. - 2023 - Developing knowledge-based psychotherapeutic compe.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/342HWCI2/Mathur et al. - 2023 - Developing knowledge-based psychotherapeutic compe.pdf:application/pdf},
}

@article{du_analyzing_2024,
	title = {Analyzing the effects of instructional strategies on students’ on-task status from aspects of their learning behaviors and cognitive factors},
