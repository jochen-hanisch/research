	keywords = {Charité:Promotion, Promotion:04-04:4.4.4, Promotion:4.4.4 Dreidimenionale Clusteranalyse, Promotion:Literaturverzeichnis},
	pages = {565--580},
	file = {PDF:/Users/jochenhanisch-johannsen/Zotero/storage/YUY355CK/2011 - Fast Approximate Text Document Clustering Using Compressive Sampling.pdf:application/pdf},
