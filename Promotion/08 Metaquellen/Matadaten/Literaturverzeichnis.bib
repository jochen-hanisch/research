}

@article{besa2020Eze,
  title = {Erforschung der Zusammenhänge von elterlichem Belastungsempfinden und binnendifferenzierenden digitalen Lernmaterialien in Zeiten der Corona-Pandemie},
  author = {Besa, Kris-Stephen and Gensler, Anna and Gesang, Johanna and Röhrig, Ernst Daniel},
  date = {2020-12-10},
  journaltitle = {PraxisForschungLehrer*innenBildung. Zeitschrift für Schul- und Professionsentwicklung.},
  volume = {Vol. 2 No. 6},
  pages = {45--58},
  publisher = {PraxisForschungLehrer*innenBildung. Zeitschrift für Schul- und Professionsentwicklung.},
  doi = {10/ghzqbs},
  url = {https://www.pflb-journal.de/index.php/pflb/article/view/3928},
  urldate = {2021-02-06},
  abstract = {Die Corona-Pandemie führt zu zahlreichen Herausforderungen für Lehrkräfte und Schüler*innen. Die meist digital aufbereiteten Lernmaterialien sollten vor allem während des Lockdowns nur wenig Unterstützung seitens der Lehrkräfte erfordern und die Schüler*innen größtenteils zum selbstständigen Arbeiten befähigen. Dies bedeutete daher für die Lehrkräfte, möglichst binnendifferenzierendes Material zu entwickeln und digital umzusetzen, was z.T. ganz neue Ansätze erforderte. Auch für Eltern ergab sich durch das Homeschooling eine neue Situation, da sie die Rolle der Lehrkräfte zumindest in Teilen mitübernehmen und ihre Kinder beim Lernen zu Hause unterstützen müssen. In diesem Kontext ist davon auszugehen, dass Eltern durch diese zusätzliche Aufgabe neben ihrer eigenen Berufstätigkeit sowie angesichts nicht immer passgenauer Lernmaterialien für ihre Kinder eine Mehrbelastung erfahren. Dieser Beitrag geht der Thematik des Homeschoolings und der digital zur Verfügung gestellten Materialien nach und greift auf Ergebnisse einer Onlinebefragung von 635 Eltern in Rheinland-Pfalz zurück, die während der Schulschließung durchgeführt wurde. Dabei wird zum einen untersucht, wie das Belastungsempfinden der Eltern in dieser Zeit ausgeprägt ist und welche individuellen Faktoren dieses beeinflussen. Zum anderen wird analysiert, wie das Belastungsempfinden mit der Qualität der bereitgestellten Materialien und der eingeschätzten Medienkompetenz der Lehrkräfte zusammenhängt. Es zeigt sich, dass das Belastungserleben neben persönlichen Unterschieden auch durch die Gestaltung des Lehrmaterials beeinflusst wird.},
  langid = {ngerman},
  keywords = {9:Zeitschriftenartikel:digital:lernen,Bildungstheorien,Charité:Promotion,Krisenreaktion im Bildungsbereich,Lehr- und Lerneffektivität,Promotion:02-01_Q2,Promotion:02-01_Q3,Promotion:Argumentation,Promotion:Dissertation | FU1 > Argumentation,Promotion:FU1,Promotion:Literaturanalyse,Promotion:S:09 Digital Lernen,Technologieintegration},
  file = {/Users/jochen_hanisch-johannsen/Zotero/storage/3GWEVTFZ/besa_et_al_2020_erforschung_der_zusammenhange_von_elterlichem_belastungsempfinden_und.pdf}
}

