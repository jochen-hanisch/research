@article{belmar_taking_2023,
	title = {Taking advantage of asynchronous digital feedback: development of an at-home basic suture skills training program for undergraduate medical students that facilitates skills retention},
	volume = {2},
	issn = {2731-4588},
	shorttitle = {Taking advantage of asynchronous digital feedback},
	doi = {10.1007/s44186-023-00112-w},
	abstract = {PURPOSE: To date, there are no training programs for basic suturing that allow remote deliberate practice. This study seeks to evaluate the effectiveness of a basic suture skills training program and its 6-month skill retention applying unsupervised practice and remote digital feedback.
METHODS: Fourth-year medical-student trainees reviewed instructional videos from a digital platform and performed unsupervised practice as needed at their homes. When they felt competent, trainees uploaded a video of themselves practicing the skill. In {\textless} 72 h, they received expert asynchronous digital feedback. The course had two theoretical stages and five video-based assessments, where trainees performed different suturing exercises. For the assessment, a global (GRS) and specific rating scale (SRS) were used, with a passing score of 20 points (max:25) and 15 (max:20), respectively. Results were compared to previously published work with in-person expert feedback (EF) and video-guided learning without feedback (VGL). A subgroup of trainees underwent a 6-month skills retention assessment.
RESULTS: Two-hundred and forty-three trainees underwent the course between March and December 2021. A median GRS of 24 points was achieved in the final assessment, showing significantly higher scores (p {\textless} 0.001) than EF and VGL (20.5 and 15.5, respectively). Thirty-seven trainees underwent a 6-month skills retention assessment, improving in GRS (23.38 vs 24.03, p value = 0.06) and SRS (18.59 vs 19, p value = 0.07).
CONCLUSION: It is feasible to teach basic suture skills to undergraduate medical students using an unsupervised training course with remote and asynchronous feedback through a digital platform. This methodology allows continuous training with the repetition of quality practice, personalized feedback, and skills retention at 6 months.},
	language = {en-GB},
	number = {1},
	journal = {Global Surgical Education: Journal of the Association for Surgical Education},
	author = {Belmar, Francisca and Gaete, María Inés and Durán, Valentina and Chelebifski, Slavka and Jarry, Cristián and Ortiz, Catalina and Escalona, Gabriel and Villagrán, Ignacio and Alseidi, Adnan and Zamorano, Elga and Pimentel, Fernando and Crovari, Fernando and Varas, Julián},
	year = {2023},
	keywords = {Simulation, Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:FU4a, Technologieintegration, Bewertungsmethoden, Promotion:Relevanz:4, \#0:Zeitschriftenartikel:digital:learning, Promotion:Weiterführung, Basic suture skills, Distance-based simulation, Medicine students, Promotion:S:12 Digital Learning, Promotion:Literaturverzeichnis},
	pages = {32},
	annote = {Analyse der Studie "Taking advantage of asynchronous digital feedback: development of an at-home basic suture skills training program for undergraduate medical students that facilitates skills retention" von Belmar et al. (2023)
Hauptthemen und Ziele der Forschung:
Die Studie von Belmar et al. (2023) untersucht die Entwicklung und Implementierung eines häuslichen Trainingsprogramms für grundlegende Nahttechniken für Medizinstudenten im Grundstudium. Das Hauptziel ist es, die Effektivität dieses Programms zu bewerten, das auf unüberwachtes Üben und asynchrones digitales Feedback setzt, und die Beibehaltung der erlernten Fähigkeiten über einen Zeitraum von sechs Monaten zu analysieren.
Methoden und Datenquellen:


Methoden: Die Studie nutzt ein digitales Feedback-System, bei dem die Studenten Lehrvideos auf einer digitalen Plattform ansehen und dann unüberwachte Übungen zu Hause durchführen. Nach Erreichen eines bestimmten Kompetenzniveaus laden sie Videos ihrer Übungen hoch und erhalten innerhalb von 72 Stunden Expertenfeedback. Die Bewertung erfolgt durch eine globale Bewertungsskala (GRS) und eine spezifische Bewertungsskala (SRS). Die Ergebnisse wurden mit früheren Studien verglichen, die persönliche Expertenfeedbacks und videobasiertes Lernen ohne Feedback verwendeten.


Datenquellen: Daten wurden von 243 Medizinstudenten gesammelt, die das Programm zwischen März und Dezember 2021 durchliefen. Ein Untergruppe von 37 Studenten wurde sechs Monate nach dem ersten Training erneut bewertet.


Zentrale Forschungsergebnisse:


Verbesserte Leistung durch digitales Feedback: Die Studenten erzielten signifikant höhere GRS- und SRS-Werte im Vergleich zu traditionellen Methoden (persönliches Expertenfeedback und videobasiertes Lernen ohne Feedback). Die mittlere GRS im Abschlussbewertung betrug 24 Punkte, was höher ist als bei den anderen Methoden (20,5 und 15,5 Punkte).


Fähigkeitserhaltung: Nach sechs Monaten zeigten die Studenten eine Verbesserung der GRS- und SRS-Werte, was auf eine erfolgreiche Beibehaltung der Fähigkeiten hinweist.


Effizienz des Trainings: Das Programm ermöglichte es den Studenten, wiederholt zu üben und qualitatives Feedback zu erhalten, was zu einer hohen Abschlussrate führte (über 85 \% in jeder Übung).


Zusammenfassung
Die Studie untersucht die Entwicklung eines digitalen Trainingsprogramms für Nahttechniken, das auf asynchrones Feedback setzt. Die Ergebnisse zeigen, dass diese Methode die Leistung der Studenten signifikant verbessert und die Fähigkeiten langfristig erhalten bleiben. Das digitale Feedback-System ermöglicht flexibles und effizientes Lernen.
Kernaussagen


Verbesserte Leistung durch digitales Feedback: Studenten erzielten höhere GRS- und SRS-Werte im Vergleich zu traditionellen Methoden. (S. 3)


Fähigkeitserhaltung: Nach sechs Monaten zeigten die Studenten eine Verbesserung der GRS- und SRS-Werte, was auf eine erfolgreiche Beibehaltung der Fähigkeiten hinweist. (S. 6)


Effizienz des Trainings: Das Programm ermöglichte wiederholtes Üben und qualitatives Feedback, was zu hohen Abschlussraten führte. (S. 7)


Argumentationslinien
Die Autoren argumentieren, dass asynchrones digitales Feedback eine effektive Methode zur Verbesserung der praktischen Fähigkeiten von Medizinstudenten ist. Sie betonen, dass diese Methode flexibles Lernen ermöglicht und eine effiziente Nutzung der Trainerzeit fördert. Die Ergebnisse zeigen, dass digitale Feedback-Systeme die Leistung und die langfristige Beibehaltung der Fähigkeiten der Studenten signifikant verbessern können. (S. 8-9)
Verschlagwortung
Passendste Schlagworte und Begründungen:


Technologieintegration: Die Studie untersucht die Integration eines digitalen Feedback-Systems in die medizinische Ausbildung und dessen Einfluss auf die Lernleistung.


Lehr- und Lerneffektivität: Die Ergebnisse zeigen, wie digitales Feedback die Effektivität des praktischen Lernens durch wiederholtes Üben und personalisiertes Feedback verbessert.


Bewertungsmethoden: Die Verwendung von GRS- und SRS-Skalen zur Bewertung der Nahttechniken wird detailliert beschrieben.


Kategorisierung


