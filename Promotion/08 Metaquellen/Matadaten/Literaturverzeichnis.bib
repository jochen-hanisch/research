@article{turnbull_learning_2023,
	title = {Learning management systems and social media: a case for their integration in higher education institutions},
	volume = {31},
	issn = {2156-7077},
	shorttitle = {Learning management systems and social media},
	url = {https://journal.alt.ac.uk/index.php/rlt/article/view/2814},
	doi = {10/gskbsx},
	language = {en-GB},
	urldate = {2023-07-31},
	journal = {Research in Learning Technology},
	author = {Turnbull, Darren and Chugh, Ritesh and Luck, Jo},
	month = may,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Bildungstheorien, \#1:Zeitschriftenartikel:learning:management:system, Datenschutz und IT-Sicherheit, Bildung, Multimedia, Lernsystemarchitektur, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	annote = {1. Analyse
Die Studie von Turnbull et al. (2023) untersucht die Integration von sozialen Medien (SM) und Learning Management Systemen (LMS) in höheren Bildungseinrichtungen. Dabei analysieren sie die technologischen und pädagogischen Vorteile sowie Herausforderungen, die sich aus dieser Integration ergeben, und bewerten ihre Effekte auf das Lernerlebnis und die Bildungsergebnisse.
2. Zusammenfassung
Die Autoren berichten über die Analyse von 36 Peer-Review-Artikeln, die die Integration von SM und LMS thematisieren. Sie identifizieren sechs Vorteilskategorien dieser Integration, darunter Zugang zu Lernmaterialien, Verbesserung der Kommunikation und peer-unterstütztes Lernen sowie die Erhöhung von Geschwindigkeit und Zuverlässigkeit in der Kursverwaltung. Es wurden auch drei Kategorien von Nachteilen festgestellt, einschließlich Ablenkungen durch soziale Medien, technische und Sicherheitsprobleme sowie der Bedarf an kontinuierlicher Unterstützung.
3. Kernaussagen


Vorteile der Integration: Verbesserter Zugang zu Lernmaterialien, effizientere Studentenrekrutierung, und gesteigerte Kommunikation und Peer-Unterstützung (S. 4-5).


Nachteile der Integration: Ablenkungen durch SM, technische und Sicherheitsprobleme, und der kontinuierliche Unterstützungsbedarf (S. 10).


Pädagogische Effizienz: Die Integration von SM in LMS kann die pädagogische Effizienz verbessern, indem sie interaktive und benutzerfreundliche Lernumgebungen schafft (S. 6-7).


4. Argumentationslinien


Notwendigkeit der Integration: Die Integration von SM und LMS wird als notwendig erachtet, um die Anforderungen moderner Lernender zu erfüllen und Bildungseinrichtungen wettbewerbsfähiger zu machen (S. 3-4).


Herausforderungen der Implementierung: Trotz der Vorteile gibt es erhebliche Herausforderungen, die bewältigt werden müssen, darunter die Sicherstellung von Datenschutz und die Überwindung technischer Barrieren (S. 9-10).


5. Verschlagwortung


Lernsystemarchitektur: Die Studie untersucht die Architektur von integrierten Lernsystemen, die sowohl LMS als auch SM umfassen.


Bildungstheorien: Sie betont die Anwendung von sozialkonstruktivistischen Prinzipien durch die Nutzung von SM zur Förderung kollaborativer Lernansätze.


Lehr- und Lerneffektivität: Die Integration soll die Lehr- und Lerneffektivität durch verbesserte Zugänglichkeit und Interaktivität steigern.


Technologieintegration: Die Arbeit zeigt die Integration von Technologie in Lernprozesse und die damit verbundenen Herausforderungen auf.


Datenschutz und IT-Sicherheit: Probleme im Zusammenhang mit Datenschutz und Sicherheit werden als kritische Aspekte der Technologieintegration hervorgehoben.


Diese Analyse beleuchtet, wie die Kombination von SM und LMS in höheren Bildungseinrichtungen das Lernen verbessern kann, während sie auch die damit verbundenen technischen und pädagogischen Herausforderungen diskutiert.
},
	file = {Turnbull et al. - 2023 - Learning management systems and social media a ca.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/Z4N45T8E/Turnbull et al. - 2023 - Learning management systems and social media a ca.pdf:application/pdf},
}

@article{seviana_learning_2023,
	title = {Learning contradictions: does student social interaction occur in the middle of e-{Learning}?},
	volume = {19},
	abstract = {During the period of the Covid-19 pandemic, distance learning is known to provide new numerous opportunities, in the interaction patterns between learning actors, in Indonesia. The inter-group competitive and collaborative learning methods have also been identified as options for increasing interaction, by paying attention to students’ self-concepts. Based on being quantitative explanative, this research aims to determine the influence of both learning methods and the role of students’ self-concept, on the interactions between members and groups. This research used non-parametric quantitative methods so moreover, 62 students were selected and divided into 2 classes, namely the control and experimental groups, each with 38 \& 24 respondents, respectively. To determine the effect of competitive and collaborative methods between groups, as well as self-concept on students’ social interactions, the authors use a two-way ANOVA test. The results showed that there was an influence of using collaborative learning methods on students with low self-concept towards their social interactions. However, there was no influence of students’ self-concept toward their social interactions.},
	language = {en-GB},
	number = {1},
	journal = {Journal of e-learning and knowledge society},
	author = {Seviana, Francisca Laora and Suprobo, Filipus Priyo},
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Systemanpassung, Bildung, Multimedia, \#5:Zeitschriftenartikel:e-learning, Kernstudie, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	annote = {Kernstudie identifiziert für das Forschungsprojekt "Wirkgefüge im digitalen Bildungsraum":


Titel: Learning contradictions: Does student social interaction occur in the middle of e-Learning?


Autoren: Seviana, F. L.; Suprobo, F. P.


Publiziert in: [Journal Name Missing] - Bitte geben Sie den Namen der Zeitschrift an, falls verfügbar.


Band/Volume: 19


Ausgabe: 1


Jahr: 2023


Beschreibung der Studie: Die Studie von Seviana und Suprobo untersucht, inwieweit soziale Interaktionen zwischen Studierenden innerhalb von E-Learning-Umgebungen stattfinden. Sie zielt darauf ab, die Herausforderungen und Widersprüche aufzudecken, die sich ergeben, wenn Lernende versuchen, trotz der oft isolierenden Natur von Online-Lernformaten miteinander zu interagieren.
Bedeutung für das Forschungsprojekt: Diese Studie trägt zum Verständnis bei, wie digitale Lernumgebungen die soziale Komponente des Lernens beeinflussen und welche pädagogischen Ansätze erforderlich sind, um effektive soziale Interaktionen zu fördern. Sie liefert wichtige Einblicke für die Gestaltung von E-Learning-Systemen, die nicht nur Wissensvermittlung, sondern auch soziale Integration unterstützen.
Diese Informationen sind dokumentiert und werden als wesentlicher Bezugspunkt für weiterführende Analysen und Diskussionen innerhalb Ihres Forschungsprojekts verwendet. Bitte ergänzen Sie noch den Namen der Zeitschrift, um die Dokumentation zu vervollständigen.
},
	file = {Seviana und Suprobo - 2023 - Learning contradictions does student social inter.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/6GVUQP3S/Seviana und Suprobo - 2023 - Learning contradictions does student social inter.pdf:application/pdf},
}

@article{guerrero-cortez_emotional_2023,
	title = {Emotional {And} {Cognitive} {Development} {Of} {University} {Students} {As} {A} {Result} {Of} {The} {New} {E}-{Learning} {Model}},
	abstract = {A documentary review was carried out on the production and publication of research papers concerning studying Emotional Development and Cognitive Development variables during the Virtual Learning process for university students. The purpose of the bibliometric analysis proposed in this paper was to know the main characteristics of the volume of publications registered in the Scopus database during the period 2017-2022 and to identify the current situation in Ecuadorian institutions regarding the study of the variables above, achieving the identification of 63 publications in total. The information provided by the said platform was organized using tables and figures for categorizing the information by Year of Publication, Country of Origin, Area of Knowledge and Type of Publication. Once these characteristics were described, a qualitative analysis was used to refer to the position of different authors on the proposed topic. Among the main findings of this research, it is found that the United States, with 9 publications, was the country with the highest scientific production registered in the name of authors affiliated with institutions of that country. The Area of Knowledge that made the greatest contribution to the construction of bibliographic material referring to the study of Emotional Development, Cognitive Development during the Virtual Learning process for university students was Computer Science, with 37 published documents, and the Type of Publication that was most used during the period indicated above was the Journal Article, which represents 40\% of the total scientific production.},
	language = {en-GB},
	number = {2023},
	journal = {Res Militaris},
	author = {Guerrero-Cortez, Vladimir Alexander and López-Vera, Franklin Raúl and Córdova-Aragundi, José Saturnino and Pilco-Parra, Mesías Heriberto},
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Technologieintegration, Promotion:Argumentation, Bildung, Multimedia, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:Die Studie von Guerrero-Cortez et al. (2023) untersucht die emotionale und kognitive Entwicklung von Universitätsstudierenden als Ergebnis eines neuen E-Learning-Modells. Sie zielt darauf ab, die Effekte virtueller Lernumgebungen auf die emotionale und kognitive Reifung zu verstehen.
Verwendete Methoden und Datenquellen:Die Forschung nutzte eine bibliometrische Analyse, um Publikationen zu emotionaler und kognitiver Entwicklung in virtuellen Lernprozessen zu untersuchen. Die Daten wurden aus der Scopus-Datenbank extrahiert und mittels qualitativer und quantitativer Methoden analysiert.
Zentrale Forschungsergebnisse:Die Analyse ergab, dass Computerwissenschaften am häufigsten zu den Studien beitrugen, was die bedeutende Rolle der Technologie in der Bildung unterstreicht. Die USA führten die wissenschaftliche Produktion an, gefolgt von China und Italien.
Zusammenfassung
Die Studie zeigt, dass E-Learning-Modelle erhebliche Auswirkungen auf die emotionale und kognitive Entwicklung von Studierenden haben können. Die Ergebnisse betonen die Notwendigkeit, E-Learning-Plattformen sorgfältig zu gestalten, um diese Aspekte der Lernendenentwicklung zu fördern.
Kernaussagen


"Die Vereinigten Staaten sind führend in der wissenschaftlichen Produktion zu den Themen emotionale und kognitive Entwicklung im Kontext des virtuellen Lernens." (S. 5218)


"Computerwissenschaften sind das vorherrschende Wissensgebiet, das zur Erforschung der emotionalen und kognitiven Entwicklung beiträgt." (S. 5221)


Argumentationslinien


Die Studie zeigt, wie wichtig die Integration von fortschrittlichen ICT-Methoden in E-Learning-Systeme ist, um die emotionale und kognitive Entwicklung zu unterstützen.


Es wird argumentiert, dass eine interdisziplinäre Herangehensweise erforderlich ist, um die vollständigen Potenziale von E-Learning in der emotionalen und kognitiven Entwicklung zu realisieren.


Verschlagwortung


Lehr- und Lerneffektivität: Die Studie zeigt, dass E-Learning-Modelle die emotionale und kognitive Entwicklung positiv beeinflussen können.


Technologieintegration: Die starke Beteiligung der Computerwissenschaften unterstreicht die Bedeutung der Technologieintegration in Bildungsprozessen.


Kollaboratives Lernen: Die Forschung deutet darauf hin, dass kollaboratives Lernen durch E-Learning-Plattformen gefördert wird, was zu einer verbesserten emotionalen und kognitiven Entwicklung beitragen kann.


Forschungsansätze: Die bibliometrische Analyse bietet einen robusten Ansatz zur Untersuchung des Einflusses von E-Learning auf die emotionale und kognitive Entwicklung.


Datenschutz und IT-Sicherheit: Mit der zunehmenden Nutzung von Daten in der Bildungsforschung wird der Datenschutz immer wichtiger.


Kategorie: Argumentation
Die Diskussion in der Studie liefert wichtige Argumente für die Gestaltung von E-Learning-Systemen, die nicht nur Wissen vermitteln, sondern auch die emotionale und kognitive Entwicklung der Lernenden unterstützen. Die Notwendigkeit, Bildungsplattformen zu entwickeln, die diese ganzheitlichen Ziele fördern, wird klar hervorgehoben.
},
	file = {Guerrero-Cortez et al. - 2023 - Emotional And Cognitive Development Of University .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/AH7Z7HXT/Guerrero-Cortez et al. - 2023 - Emotional And Cognitive Development Of University .pdf:application/pdf},
}

@article{berger_virtuelle_2022,
	title = {Virtuelle {Lernumgebungen} in der betrieblichen {Ausbildung} – eine {Analyse} am {Beispiel} der {Elektrobranche} in der {Schweiz}},
	url = {https://www.zora.uzh.ch/id/eprint/225727},
	doi = {10/grmk85},
	abstract = {Für viele Lehrbetriebe ist es schwierig, Berufslernenden genügend Situationen zu ermöglichen, in denen sie die vorgesehenen beruflichen Handlungskompetenzen erlernen und üben können. Die Anreicherung der betrieblichen Ausbildung mit technologiegestützten Erfahrungswelten auf der Basis von Virtual Reality (VR) ist deshalb vielversprechend. VR wird in der betrieblichen Ausbildung jedoch kaum systematisch angewandt, was u.a. auf eine geringe Erfahrungs- und Forschungslage zurückgeführt werden kann. Daher wurde in einem Projekt auf Basis des Design-Based Research-Ansatzes die Erstellung und Anwendung einer VR-Lernumgebung für angehende Elektrofachpersonen aufgenommen. Dieser Beitrag stellt die aus pädagogischer und technologischer Sicht herausfordernde Auswahl einer Handlungssituation, die für die Möglichkeiten einer VR-Simulation prädestiniert ist, und deren sinnvolle pädagogische Rahmung in den Mittelpunkt. Zudem werden Ergebnisse der Evaluation des erstellten Prototyps mittels einer Interventionsstudie bei Schweizer Montage-Elektriker:innen und Elektroinstallateur:innen im letzten Ausbildungsjahr präsentiert.},
	language = {de-DE},
	number = {43},
	urldate = {2023-01-10},
	journal = {Berufs- und Wirtschaftspädagogik - online},
	publisher = {bwpat Förder-Club e.V.},
	author = {Berger, Martin and Kraus, Katrin and Keller, Thomas and Brucker-Kley, Elke and Knaack, Reto},
	month = dec,
	year = {2022},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:FU4a, Technologieintegration, Promotion:Argumentation, \#3:Zeitschriftenartikel:online:Lernumgebung, Promotion:02-01\_Q2, Promotion:S:03 Online-Lernumgebung, Promotion:9.1 Vergleiche, Promotion:Literaturverzeichnis},
	pages = {25},
	annote = {1. Analyse
