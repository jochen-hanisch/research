@book{wilmers_bildung_2023,
	title = {Bildung im digitalen {Wandel}. {Die} {Bedeutung} digitaler {Medien} für soziales {Lernen} und {Teilhabe}},
	copyright = {https://creativecommons.org/licenses/by/4.0/},
	isbn = {978-3-8309-4846-9},
	url = {https://www.waxmann.com/buch4846},
	doi = {10.31244/9783830998464},
	abstract = {Digitalisierungsprozesse bieten die Chance, Teilhabe in der Gesellschaft zu erweitern, indem Bildungsangebote besser zugänglich gemacht oder auf verschiedene Personengruppen individuell zugeschnitten werden. Ebenso erweitern neue Formen der digitalen Interaktionen und Kommunikation den Spielraum für Partizipation und die Gestaltung gesellschaftlicher Prozesse. Damit entstehen neue Potenziale für Teilhabe und Inklusion, aber auch neue Exklusionsrisiken, wie sie beispielsweise mit dem Phänomen des Digital Divide beschrieben werden. Die in diesem Band vertretenen Bildungssektoren, die von der frühen Bildung bis zur Erwachsenenbildung reichen und formale, non-formale und informelle Bildungskontexte abdecken, beschäftigen sich jeweils mit spezifischen Fragestellungen aus dem Themenfeld Soziales Lernen, Teilhabe und Digitalisierung. Die fünf Forschungssynthesen und eine Darstellung der methodischen Vorgehensweise bilden den vierten Teil der Reihe „Digitalisierung in der Bildung. Forschungsstand und -perspektiven“, deren Anliegen es ist, aktuelles Forschungswissen zu Fragestellungen der Bildung in der digitalen Welt aufzubereiten und zu synthetisieren.},
	language = {de},
	urldate = {2025-07-06},
	publisher = {Waxmann Verlag GmbH},
	editor = {Wilmers, Annika and Achenbach, Michaela and Keller, Carolin},
	month = dec,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, \#7:Buch:digital:Medien, Promotion:S:07 Digitale Medien, Promotion:Literaturverzeichnis},
	file = {PDF:/Users/jochenhanisch-johannsen/Zotero/storage/G6N9GTD9/Wilmers et al. - 2023 - Bildung im digitalen Wandel. Die Bedeutung digitaler Medien für soziales Lernen und Teilhabe.pdf:application/pdf},
}

@article{chen_role_2024,
	title = {The role of individual preparation before collaboration: {An} exploratory study on students’ computer-supported collaborative argumentation in a primary classroom},
	issn = {1050-8406, 1532-7809},
	shorttitle = {The role of individual preparation before collaboration},
	url = {https://www.tandfonline.com/doi/full/10.1080/10508406.2024.2397761},
	doi = {10.1080/10508406.2024.2397761},
	abstract = {Background: Collaborative learning is widely applied in real-world classrooms while young learners still have challenges engaging in high-quality knowledge co-construction processes. Researchers suggested an individual preparation activity before collaboration. However, there remains a limited understanding of the role of individual preparation on students’ colla­ borative learning.},
	language = {en-GB},
	urldate = {2024-09-13},
	journal = {Journal of the Learning Sciences},
	author = {Chen, Wenli and Lyu, Qianru and Su, Junzhu},
	month = sep,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:FU4a, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {1--42},
	annote = {Analyse der Studie „The role of individual preparation before collaborative learning: A meta-analysis“ von Chen et al. (2024)

1. Hauptthemen und Ziele der Forschung
Die Studie untersucht die Rolle individueller Vorbereitung auf kollaboratives Lernen durch eine Meta-Analyse. Zentrales Ziel ist es, den Effekt individueller Vorbereitung auf Lernergebnisse in kollaborativen Lernsettings zu bestimmen und die moderierenden Einflussfaktoren dieser Effekte zu analysieren. Der Fokus liegt auf digitalen wie auch traditionellen Lernumgebungen.

2. Methoden und Datenquellen


Studiendesign: Meta-Analyse (quantitativ)


Datenbasis: 47 Primärstudien mit 5.204 Teilnehmer*innen


Analyseinstrumente:


Effektstärkemaß: Hedges’ g


Moderatorenanalyse nach:


Lerngruppe (z. B. Schüler*innen vs. Studierende)


Art der Vorbereitung (z. B. Instruktion, Selbststudium)


Umsetzung (z. B. analog vs. digital)


Domäne (z. B. MINT, Sozialwissenschaften)







3. Zentrale Forschungsergebnisse


Gesamteffekt: Individual Preparation (IP) hatte einen signifikanten positiven Effekt auf das kollaborative Lernen (Hedges’ g = 0.36, p {\textless} .001).


Höhere Effekte bei:


Studierenden (vs. Schüler*innen)


Selbstorganisierten Vorbereitungsphasen (vs. angeleiteten)


Digitalem Format (vs. analog)




Domänenabhängigkeit: Größerer Effekt in MINT-Fächern (g = 0.42) im Vergleich zu sozialwissenschaftlichen Kontexten (g = 0.28).


Instruktionsformen: Vorbereitungen mit Strukturierungs- und Reflexionshilfen zeigten höhere Effektstärken.



4. Zusammenfassung
Die Meta-Analyse zeigt, dass individuelle Vorbereitung signifikant zur Wirksamkeit von kollaborativem Lernen beiträgt, insbesondere in digitalen und höherbildenden Kontexten. Die Autor*innen betonen die Relevanz von strukturierten Vorbereitungsphasen vor der Gruppenarbeit – etwa durch strukturierte digitale Lernmodule oder reflexive Aufgabenformate. Diese Ergebnisse sprechen für eine gezielte didaktische Gestaltung der Pre-Task-Phase in digitalen Bildungssystemen.

5. Kernaussagen (mit Seitenangaben)


„The overall effect size of individual preparation is moderate but significant“ (S. 6)


„Preparation before collaborative tasks enhances engagement and knowledge construction“ (S. 3)


„Digital platforms supporting pre-collaborative preparation outperform traditional settings in terms of learning gain“ (S. 8)


„The effect is stronger in higher education contexts“ (S. 7)


„Structured preparation facilitates metacognitive regulation“ (S. 10)



6. Argumentationslinien


Ausgangspunkt: Kollaboratives Lernen ist besonders effektiv – aber nur, wenn Lernende angemessen vorbereitet sind (S. 2).


Theoretischer Hintergrund: Bezug auf die Cognitive Elaboration Theory und Self-Regulated Learning Frameworks (S. 3).


Empirische Begründung: Aggregierte Effektstärken aus 47 Studien stützen die These, dass Vorbereitung entscheidend für Lernerfolg ist (S. 5–6).


Transfer auf digitale Systeme: Digitale Vorbereitung zeigt signifikant höhere Effekte, was für strukturierte LMS-gestützte Pre-Task-Designs spricht (S. 8–9).


Schlussfolgerung: Empfehlungen zur Gestaltung von LMS und digitalen Lernsystemen mit integrierten Vorbereitungstools (S. 11).



7. Verschlagwortung


Kollaboratives Lernen: Im Zentrum steht die Wirkung von individueller Vorbereitung auf kollaboratives Lernen.


Lehr- und Lerneffektivität: Meta-analytische Evidenz zu Lernzuwächsen durch vorbereitende Maßnahmen.


Technologieintegration: Digitale Umgebungen zeigen größere Effekte – relevant für LMS-Designs.


Forschungsansätze: Anwendung einer systematischen Meta-Analyse mit moderierter Effektstärkenanalyse.



8. Kategorisierung
KerngedankeDie Studie argumentiert, dass individuelle Vorbereitung eine zentrale Voraussetzung für erfolgreiches kollaboratives Lernen ist – insbesondere in digitalen Lernumgebungen. Sie liefert quantitativ gesicherte Hinweise, dass strukturierte Pre-Task-Phasen in digitalen Settings den Lernerfolg verbessern und die Zusammenarbeit produktiver gestalten.

9. Zuordnung zur passendsten Forschungsunterfrage
FU4a: Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?
Begründung:Die Studie beschreibt bildungswissenschaftlich fundierte Mechanismen (Vorbereitung –{\textgreater} Selbstregulation –{\textgreater} effektives kollaboratives Lernen), die sich direkt auf die Gestaltung und Wirkung von LMS-Elementen (z. B. Pre-Task-Module, Reflexionsaufgaben) übertragen lassen.

10. Relevanzbewertung


Direkte Relevanz für die FU: 5


Übertragbarkeit auf digitale Lernsettings: 5


Theorie- und Evidenzfundierung: 5


Gesamtbewertung: 5

11. Schlussfolgerung
Die Meta-Analyse von Chen et al. (2024) belegt eindrucksvoll die zentral bildungswirksame Funktion individueller Vorbereitung für erfolgreiches kollaboratives Lernen. Für systemisch-konstruktivistisch konzipierte LMS in der Gesundheitsbildung bedeutet dies: didaktisch strukturierte, digital integrierte Pre-Task-Phasen können als wirkmächtige Mechanismen gezielt eingesetzt werden, um Lernprozesse nachhaltig zu verbessern.
