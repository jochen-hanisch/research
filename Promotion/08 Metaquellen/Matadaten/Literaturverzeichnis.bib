@article{mat_effectiveness_2024,
	title = {Effectiveness of digital learning on students’ higher order thinking skills},
	volume = {13},
	copyright = {http://creativecommons.org/licenses/by-nc/4.0},
	issn = {2620-5440, 2252-8822},
	url = {https://ijere.iaescore.com/index.php/IJERE/article/view/29449},
	doi = {10.11591/ijere.v13i5.29449},
	abstract = {In the realm of education, learning and instructional activities play a crucial role in cultivating lasting and meaningful comprehension among science students. This research aims to evaluate the effectiveness of the i-Genius module in enhancing students’ performance in science. The i-Genius module’s development adhered to the ADDIE model, and two specific research questions were formulated: i) is there a statistically significant difference in mean scores between the experimental and control groups? and ii) to what extent can i-Genius contribute to students’ conceptual evolution compared to traditional methods? To address these questions, a sequential mixed-method approach involving interviews, pre-tests, and post-tests was implemented in two distinct schools in the Seremban District. The experimental group comprised 35 participants, and the control group also included 35 students with similar characteristics. Student performance, assessed through pre-test and post-test mean scores, revealed that students exposed to i-Genius achieved significantly higher scores than those exposed to traditional methods in the post-test (t(68)=8.37, p{\textless}0.05). This study’s implications lie in its practical application within the school context, offering an alternative instructional tool for teaching science and presenting an instructional model to guide teachers in formulating strategies that encourage problem-posing within the science curriculum.},
	language = {en-GB},
	number = {5},
	urldate = {2024-07-29},
	journal = {International Journal of Evaluation and Research in Education (IJERE)},
	author = {Mat, Hamidah and Mustakim, Siti Salina and Razali, Fazilah and Ghazali, Norliza and Minghat, Asnul Dahar},
	month = oct,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {2817},
	file = {Mat et al. - 2024 - Effectiveness of digital learning on students’ hig.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/QK332DB7/Mat et al. - 2024 - Effectiveness of digital learning on students’ hig.pdf:application/pdf},
}

@article{hedqvist_bracing_2024,
	title = {Bracing for the next wave: {A} critical incident study of frontline decision‐making, adaptation and learning in ambulance care during {\textless}span style="font-variant:small-caps;"{\textgreater}{COVID}{\textless}/span{\textgreater} ‐19},
	issn = {0309-2402, 1365-2648},
	shorttitle = {Bracing for the next wave},
	url = {https://onlinelibrary.wiley.com/doi/10.1111/jan.16340},
	doi = {10.1111/jan.16340},
	abstract = {Methods: Twenty-­eight registered nurses from the Swedish ambulance services described 56 critical incidents during the COVID-­19 pandemic through free-­text questionnaires. The material was analysed using the Critical Incident Technique and Interpretive Description through the lens of potential for resilient performance.
Results: The findings were synthesized into four themes: ‘Navigating uncharted waters under never-­ending pressure’, ‘Balancing on the brink of an abyss’, ‘Sacrificing the few to save the many’ and ‘Bracing for the next wave’. Frontline decision-­making during a pandemic contribute to ethical dilemmas while necessitating difficult prioritizations to adapt and respond to limited resources. Learning was manifested through effective information sharing and the identification of successful adaptations as compared to maladaptations.
Conclusions: During pandemics or under other extreme conditions, decisions must be made promptly, even amidst emerging chaos, potentially necessitating the use of untested methods and ad-h­ oc solutions due to initial lack of knowledge and guidelines. Within ambulance care, dynamic leadership becomes imperative, combining autonomous frontline decision-­making with support from management. Strengthening ethical competence and fostering ethical discourse may enhance confidence in decision-­making, particularly under ethically challenging circumstances.},
	language = {en-GB},
	urldate = {2024-07-29},
	journal = {Journal of Advanced Nursing},
	author = {Hedqvist, Ann‐Therese and Holmberg, Mats and Bjurling‐Sjöberg, Petronella and Ekstedt, Mirjam},
	month = jul,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {jan.16340},
	file = {Hedqvist et al. - 2024 - Bracing for the next wave A critical incident stu.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/YVF9TBCK/Hedqvist et al. - 2024 - Bracing for the next wave A critical incident stu.pdf:application/pdf},
}

@article{cai_efficiency_2024,
	title = {On the efficiency of adaptive collaborative scripts in learning: a systematic literature review on fading-out scripts, adaptive scripts, and self-adaptive scripts},
	issn = {1049-4820, 1744-5191},
	shorttitle = {On the efficiency of adaptive collaborative scripts in learning},
	url = {https://www.tandfonline.com/doi/full/10.1080/10494820.2024.2371931},
	doi = {10.1080/10494820.2024.2371931},
	abstract = {In an endeavor to tackle the limitations of fixed collaborative scripts and to further support collaborative learning practices, adaptive collaborative scripts have been implemented within the educational domain. However, the divergent findings surrounding the efficacy of adaptive collaborative scripts engendered a compelling need for a comprehensive understanding of the adaptive scripts. This study explored the effectiveness of adaptive scripts through a systematic analysis of 11 meticulously chosen studies and demonstrated the distinct contributions offered by varying types of adaptive collaborative scripts (namely, fading-out scripts, adaptable scripts, and self-adaptive scripts). The results underscored adaptive scripts yielded a favorable impact on the caliber of collaboration and on learners’ psychological contentment. Nonetheless, the ramifications on learning outcomes were inconclusive. Under the guidance of activity theory, this review uncovered the optimal application conditions of each variant of adaptive script. The fading-out scripts necessitated supplementary consistent support to ensure satisfactory learning outcomes. Adaptable scripts demonstrated stable efficacy when employed for students with good self-regulation ability. The self-adaptive scripts yielded optimal results in learning activities with higher-level educational objectives. Distributed roles within learning groups and perceived adaptivity also influenced the efficacy of self-adaptive scripts. Implications, limitations, and future directions were also provided.},
	language = {en-GB},
	urldate = {2024-07-29},
	journal = {Interactive Learning Environments},
	author = {Cai, Rongzhen and Wu, Chenggang and Jin, Hui},
	month = jul,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {1--25},
	file = {Cai et al. - 2024 - On the efficiency of adaptive collaborative script.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/KNM8FKBQ/Cai et al. - 2024 - On the efficiency of adaptive collaborative script.pdf:application/pdf},
}

@article{niu_how_2024,
	title = {How learners’ achievement goal motivation influences their metacognitive skills in online social annotations context?},
	issn = {1470-3297, 1470-3300},
	url = {https://www.tandfonline.com/doi/full/10.1080/14703297.2024.2382849},
	doi = {10.1080/14703297.2024.2382849},
	abstract = {Online learning requires high self-regulated abilities facilitated by metacognitive skills. Achievement goal motivation impacts meta­ cognition, but their relationship in online learning contexts lacks consensus. One of the components of achievement goal orienta­ tion is mastery goal orientation which focuses on learning and selfimprovement. The other component, performance goal orientation, emphasises demonstrating competence. This quantitative study collected questionnaire and behavioural log data from 39 learners and examined the interplay between achievement goal motivation and metacognitive skills within an online social annotation envir­ onment. Findings revealed that mastery goal orientation positively correlated with metacognitive planning and regulation, while per­ formance goal orientation was predominantly associated with metacognitive regulation. Neither goals significantly correlated with metacognitive monitoring. Cluster analysis indicated that ‘balanced achievers’ with higher performance goal orientation may play a pivotal role in promoting social cognition. These insights deepen understanding of motivating learners and creating effec­ tive online learning approaches by leveraging the influence of achievement goal motivation on metacognitive strategies.},
	language = {en-GB},
	urldate = {2024-07-29},
	journal = {Innovations in Education and Teaching International},
	author = {Niu, Xiaojie and Chen, Weijia and Li, Luyue and Zhang, Wenmei and Gao, Shurui and He, Chun and Zhang, Jingjing},
	month = jul,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {1--17},
	file = {Niu et al. - 2024 - How learners’ achievement goal motivation influenc.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/G5L2J2KZ/Niu et al. - 2024 - How learners’ achievement goal motivation influenc.pdf:application/pdf},
}

@article{hoppe_nutzen_2024,
	title = {Nutzen und {Herausforderungen} von selbstgesteuertem {Lernen} für die {Gestaltung} von {Onlinekursen}},
	volume = {62},
	language = {de-DE},
	number = {1},
	journal = {Medienimpulse},
	author = {Hoppe, Marie and Chruszczyk, Claudia and Schönsleben, Oliver},
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Systemanpassung, Promotion:FU6, \#a:Zeitschriftenartikel:online:lernen, Promotion:S:10 Online Lernen, Promotion:Literaturverzeichnis},
	pages = {1--27},
	annote = {Analyse der Studie „Nutzen und Herausforderungen von selbstgesteuertem Lernen für die Gestaltung von Onlinekursen“ von Hoppe et al. (2024)
Hauptthemen und Ziele der Forschung
Die Studie von Hoppe et al. (2024) untersucht, wie selbstgesteuertes Lernen in Onlinekursen umgesetzt werden kann, um die berufliche Weiterbildung zu fördern. Das Ziel ist, die Potenziale und Herausforderungen der Integration von selbstgesteuertem Lernen in digitale Bildungsformate zu identifizieren und praxisnahe Ansätze für die Gestaltung solcher Kurse zu entwickeln​​.
Methoden und Datenquellen


Methoden: Die Autoren analysieren theoretische Modelle des selbstgesteuerten Lernens und deren Anwendung in Onlinekursen. Ein besonderer Fokus liegt auf der Entwicklung von Gestaltungsmerkmalen, die selbstgesteuertes Lernen in digitalen Settings unterstützen. Die Studie verwendet eine Kombination aus Literaturrecherche und der Analyse von Praxisbeispielen aus dem Bereich des Onboardings in Unternehmen​​.


Datenquellen: Die Studie stützt sich auf bestehende Literatur und Fallstudien, insbesondere aus dem Bereich der beruflichen Weiterbildung und des Onboardings in Organisationen​​.


Zentrale Forschungsergebnisse


Gestaltungselemente für selbstgesteuertes Lernen: Sechs zentrale Merkmale wurden identifiziert, um selbstgesteuertes Lernen in Onlinekursen zu unterstützen: Navigationsfreiheit, Modularität, Methodenvielfalt, Vernetzung, Werkzeuge zur Lerneinschätzung und Kommunikationsmöglichkeiten​​.


Kompetenzentwicklung: Die Befähigung der Lernenden, selbstgesteuert zu lernen, erfordert spezifische Lernstrategien, die kognitive, metakognitive und selbstregulative Fähigkeiten umfassen. Diese Strategien müssen in die Kursgestaltung integriert werden, um den Lernerfolg zu fördern​​.


Herausforderungen und Potenziale: Die digitale Transformation bietet Chancen für die Implementierung selbstgesteuerter Lernansätze, bringt jedoch Herausforderungen in Bezug auf die didaktische Gestaltung und die Sicherstellung der Lernmotivation mit sich​​.


Zusammenfassung
Die Studie von Hoppe et al. (2024) zeigt, dass selbstgesteuertes Lernen ein effektives Mittel zur Förderung von Selbstlernkompetenzen in Onlinekursen darstellt. Durch die Identifikation und Umsetzung spezifischer Gestaltungsmerkmale kann die Effektivität dieser Lernformate gesteigert werden. Die Ergebnisse bieten wertvolle Einblicke in die Gestaltung von digitalen Bildungsangeboten, insbesondere im Kontext der beruflichen Weiterbildung​​.
Kernaussagen


Gestaltungselemente: Die Identifikation von sechs zentralen Gestaltungsmerkmalen zur Unterstützung selbstgesteuerten Lernens ist entscheidend für die erfolgreiche Implementierung in Onlinekursen (S. 18)​​.


Lernstrategien: Die Entwicklung und Integration spezifischer Lernstrategien sind unerlässlich, um den Lernerfolg in selbstgesteuerten Lernumgebungen zu sichern (S. 17)​​.


Digitalisierungspotenziale: Die digitale Transformation bietet erhebliche Potenziale, stellt aber auch Anforderungen an die didaktische Planung und Durchführung von Onlinekursen (S. 19)​​.


Argumentationslinien
Die Autoren argumentieren, dass selbstgesteuertes Lernen durch gezielte didaktische Maßnahmen und die Bereitstellung geeigneter technischer und organisatorischer Rahmenbedingungen gefördert werden kann. Die Studie betont die Wichtigkeit, die Lernenden aktiv in den Gestaltungsprozess einzubeziehen, um die Effektivität selbstgesteuerter Lernformate zu maximieren​​.
Verschlagwortung


Lehr- und Lerneffektivität: Die Studie untersucht die Effektivität selbstgesteuerter Lernansätze und deren Einfluss auf die Lernprozesse in Onlinekursen.


Technologieintegration: Es wird die Integration digitaler Technologien zur Unterstützung selbstgesteuerten Lernens thematisiert.


Systemanpassung: Die Anpassung von Lernsystemen an die Anforderungen selbstgesteuerten Lernens wird diskutiert.


Kategorisierung


Kernaussage: Die Studie bietet eine detaillierte Analyse der Wirkmechanismen selbstgesteuerten Lernens in digitalen Bildungsformaten und identifiziert zentrale Gestaltungsmerkmale zur Förderung dieses Ansatzes​​.


Zuordnung zur Forschungsunterfrage


FU6: Die Studie behandelt die Beurteilung selbstgesteuerter Lernansätze als Mittel zur Förderung von Kompetenzen in digitalen Bildungsräumen und analysiert deren Einfluss auf die Lernenden​​.


Einordnung der Relevanz


Relevanzbewertung: 5 - Hoch relevant. Die Studie bietet umfassende Einblicke in die Gestaltung und Implementierung selbstgesteuerter Lernformate und ist direkt relevant für die Förderung von Selbstlernkompetenzen in digitalen Bildungskontexten. Sie ist aktuell und thematisch relevant für die digitale Bildung.


},
	file = {Hoppe et al. - 2024 - Nutzen und Herausforderungen von selbstgesteuertem.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/4KCJZE6T/Hoppe et al. - 2024 - Nutzen und Herausforderungen von selbstgesteuertem.pdf:application/pdf},
}

@article{charton_impact_2023,
	title = {Impact of an online learning by concordance program on reflection},
	volume = {23},
	issn = {1472-6920},
	url = {https://bmcmededuc.biomedcentral.com/articles/10.1186/s12909-023-04799-9},
	doi = {10/gs566k},
	abstract = {Background  Learning by concordance (LbC) is a recent approach that introduces learners to the complexity and uncertainty of clinical practice. Some data on LbC suggest that it stimulates reflection in future clinicians. We developed an online LbC training program on electrocardiogram (ECG) interpretation in general practice at the University of Strasbourg, France, and conducted an exploratory qualitative study to document the impact of this ECG learning-by-concordance training program on reflection in participants.
Methods  We created 18 clinical vignettes on ECG interpretation based on a review of the literature on frequent and serious cardiovascular diseases that can be identified using an ECG in general practice. The training program was delivered online to postgraduate general practice students in two faculties of medicine. We conducted a qualitative study based on thematic analysis of two focus groups and six individual interviews. Inductive and deductive coding were performed. The five major components of reflection in the Nguyen model were used in the deductive coding: (i) thoughts and actions, (ii) attentive, critical, exploratory, and iterative processes (ACEI), (iii) underlying conceptual frame, (iv) change and (v) self.
Results  Two focus groups and six individual interviews were conducted. The qualitative analysis indicated 203 codes in the focus groups and 206 codes in the individual interviews, which were divided into five groups based on the components of reflection in the Nguyen model: (i) the self; (ii) attentive, critical, exploratory, and iterative interactions with (iii) one’s thoughts and actions; and (iv) a view on both the change itself and (v) the underlying conceptual frame. Inductive coding revealed interesting insights into the impact of the identity of the panel members, the absence of a scoring system and the question of uncertainty in ECG reading.
Conclusions  This study supports the claim that the use of LbC in the context of ECG interpretation could foster reflection in future general practitioners. We discuss future research avenues on instructional design of LbC and reflection.},
	language = {en-GB},
	number = {1},
	urldate = {2023-11-18},
	journal = {BMC Medical Education},
	author = {Charton, Léa and Lahmar, Abdelkader and Hernandez, Elodie and Rougerie, Fabien and Lorenzo, Mathieu},
	month = nov,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Bewertungsmethoden, Bildungstheorien, Promotion:FU6, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {822},
	annote = {Hier ist die ausführliche Analyse der Studie „Impact of an Online Learning by Concordance Program on Reflection“ von Léa Charton et al.:
1. Hauptthemen und -ziele der Forschung
Die Studie untersucht die Wirkung eines Online-Lernprogramms, das auf dem Prinzip des „Learning by Concordance“ (LbC) basiert, auf die Reflexionsfähigkeit von Medizinstudierenden. Das Hauptziel ist es, zu analysieren, wie das LbC-Programm zur Verbesserung des klinischen Denkens und der Reflexionsfähigkeiten von angehenden Allgemeinmedizinern beiträgt, insbesondere bei der Interpretation von Elektrokardiogrammen (EKGs).
2. Methoden und Datenquellen


Methoden: Die Studie verwendet eine qualitative Forschungsdesign, das aus Fokusgruppen und individuellen Interviews mit Teilnehmenden besteht. Diese wurden mit einem thematischen Analyseansatz ausgewertet, wobei sowohl induktive als auch deduktive Codierungsverfahren angewandt wurden. Die fünf Komponenten der Reflexion nach Nguyen et al. wurden als Grundlage für die deduktive Codierung verwendet.


Datenquellen: Die Daten stammen aus Fokusgruppen und Einzelinterviews mit Medizinstudierenden der Universitäten von Straßburg und Besançon. Insgesamt wurden zwei Fokusgruppen und sechs Einzelinterviews durchgeführt.


3. Zentrale Forschungsergebnisse


Förderung der Reflexion: Die Analyse zeigt, dass das LbC-Programm die Reflexion der Studierenden durch die Konfrontation mit komplexen klinischen Situationen fördert. Die Studierenden entwickelten eine kritischere und systematischere Herangehensweise an die EKG-Interpretation.


Verbesserte klinische Denkprozesse: Die Studierenden berichteten von einer Verbesserung ihrer klinischen Denkprozesse, insbesondere durch den Vergleich ihrer eigenen Interpretationen mit denen von Experten.


Bewältigung von Unsicherheit: Das Programm förderte die Fähigkeit der Studierenden, mit Unsicherheit umzugehen, indem es sie dazu ermutigte, unterschiedliche Meinungen und Ansätze zu berücksichtigen.


4. Zusammenfassung
Die Studie zeigt, dass das Online-LbC-Programm die Reflexions- und Denkfähigkeiten der Medizinstudierenden stärkt, indem es ihnen ermöglicht, klinische Situationen kritisch zu hinterfragen und alternative Lösungsansätze zu entwickeln. Das Programm bietet eine wertvolle Ergänzung zur traditionellen medizinischen Ausbildung, indem es die Studierenden in die Lage versetzt, Unsicherheit als Teil ihrer zukünftigen Praxis zu akzeptieren und zu bewältigen.
5. Kernaussagen


Reflexion als Lernziel: Die Teilnahme an LbC fördert die Entwicklung reflexiver Fähigkeiten, die für die klinische Praxis entscheidend sind. (S. 2)


Unterschiedliche Perspektiven: Die Möglichkeit, verschiedene klinische Perspektiven zu erkunden, verbessert die Fähigkeit der Studierenden, fundierte klinische Entscheidungen zu treffen. (S. 4)


Einsatz von Expertenmeinungen: Der Vergleich mit Expertenmeinungen hilft den Studierenden, ihre eigenen Denkprozesse kritisch zu evaluieren und anzupassen. (S. 6)


6. Argumentationslinien
Die Autoren argumentieren, dass LbC eine effektive Methode ist, um die Reflexionsfähigkeit von Medizinstudierenden zu stärken. Durch die Auseinandersetzung mit realitätsnahen klinischen Fällen und der Analyse von Expertenmeinungen werden die Studierenden dazu angeregt, ihre eigenen Denkprozesse zu hinterfragen und zu verbessern. Die Studie betont die Notwendigkeit, Lernumgebungen zu schaffen, die es den Studierenden ermöglichen, Unsicherheit als integralen Bestandteil der klinischen Praxis zu akzeptieren und zu bewältigen. (S. 7-8)
7. Verschlagwortung
Passendste Schlagworte und Begründungen:


Lehr- und Lerneffektivität: Untersuchung der Effektivität von LbC zur Verbesserung der Reflexionsfähigkeiten und des klinischen Denkens der Studierenden.


Bildungstheorien: Die Studie basiert auf theoretischen Modellen der Reflexion und des Lernens, um die Entwicklung von Denkprozessen zu fördern.


Bewertungsmethoden: Einsatz qualitativer Forschungsmethoden zur Bewertung der Lernfortschritte der Studierenden.


8. Kategorisierung
Kerngedanke: Die Studie beleuchtet die Bedeutung von LbC als innovative Lernstrategie zur Förderung der Reflexionsfähigkeit und des klinischen Denkens bei Medizinstudierenden. (S. 9)
9. Zuordnung zur Forschungsfrage
Passendste Forschungsunterfrage:


FU6: Wie wird ein systemisch-konstruktivistisches Learning-Management-System als Kompetenzerwerbssystem bei Akteuren im digitalen Bildungsraum von Gesundheitsberufen beurteilt?


Begründung: Die Untersuchung zeigt, wie LbC als Methode zur Verbesserung der klinischen Kompetenz und der Reflexionsfähigkeit in der medizinischen Ausbildung eingesetzt werden kann.




10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 - Die Studie bietet umfassende Einblicke in die Wirksamkeit von LbC als Lernstrategie.


Zitierhäufigkeit und Einfluss: 4 - Die Studie bietet wichtige Beiträge zur Diskussion über Reflexion in der medizinischen Ausbildung.


Aktualität: 5 - Die Forschung ist aktuell und bezieht sich auf moderne Entwicklungen im Bereich des medizinischen Lernens.


Gesamtbewertung: 4.7


Diese Analyse zeigt, wie das LbC-Programm die Reflexionsfähigkeit und das klinische Denken von Medizinstudierenden fördert und bietet wertvolle Einsichten für die Weiterentwicklung von Lernstrategien in der medizinischen Ausbildung.
},
	file = {Charton et al. - 2023 - Impact of an online learning by concordance progra.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/TJKYEMIR/Charton et al. - 2023 - Impact of an online learning by concordance progra.pdf:application/pdf},
}

@article{pan_online_2023,
	title = {Online {Learning} {Environments}, {Learners}’ {Empowerment}, and {Learning} {Behavioral} {Engagement}: {The} {Mediating} {Role} of {Learning} {Motivation}},
	volume = {13},
	issn = {2158-2440, 2158-2440},
	shorttitle = {Online {Learning} {Environments}, {Learners}’ {Empowerment}, and {Learning} {Behavioral} {Engagement}},
	url = {http://journals.sagepub.com/doi/10.1177/21582440231205098},
	doi = {10/gs3qfq},
	abstract = {This study aimed to explore the influence of online learning environments on learners’ empowerment, learning behavioral engagement and learning motivation and examine the mediating role of learning motivation. A total of 398 (132 male and 266 female) students from a comprehensive university in China participated in questionnaire survey and reported on their perceived online learning environments, learners’ empowerment, learning behavioral engagement, and learning motivation. Results showed that online learning environments significantly and positively influenced learners’ empowerment, learning behavioral engagement, and learning motivation; learners’ empowerment is positively associated with learning behavioral engagement. Furthermore, learning motivation mediated the relation between online learning environments and learning behavioral engagement. These findings unraveled the associations of both the external factors (e.g., online learning environments) and the internal factors (e.g., learning motivation; learners’ empowerment) of affecting students’ online learning behavioral engagement, thereby contributing to our further understanding and exploration of the imperatives of the joint inherent and extrinsic driving mechanisms. This study highlighted the importance of constructing appropriate online learning environments in accelerating students’ learning behavioral engagement, and would suggest focusing on teachers’ conscientious behaviors of enhancing the awareness of online learning community and stimulating students’ learning motivation.},
	language = {en-GB},
	number = {4},
	urldate = {2023-11-04},
	journal = {SAGE Open},
	author = {Pan, Xiaoquan},
	month = oct,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Systemanpassung, Bildungstheorien, Promotion:FU6, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {21582440231205098},
	annote = {Hier ist die überarbeitete Analyse der Studie "Online Learning Environments, Learners’ Empowerment, and Learning Behavioral Engagement: The Mediating Role of Learning Motivation" von Xiaoquan Pan, unter Berücksichtigung deiner spezifischen Schlagwörter:
1. Hauptthemen und -ziele der Forschung
Die Studie untersucht den Einfluss von Online-Lernumgebungen auf die Ermächtigung der Lernenden, ihr Lernverhalten und ihre Motivation. Das Hauptziel ist es, die Rolle der Lernmotivation als Mediator in diesen Beziehungen zu verstehen. Die Studie zielt darauf ab:


Einfluss untersuchen: Zu erforschen, wie Online-Lernumgebungen die Ermächtigung und das Engagement der Lernenden beeinflussen.


Rolle der Motivation: Die Rolle der Lernmotivation als vermittelnde Variable zwischen Online-Lernumgebungen und dem Lernverhalten zu analysieren.


Ermächtigung der Lernenden: Zu verstehen, wie die Ermächtigung der Lernenden deren Engagement und Motivation beeinflusst.


2. Methoden und Datenquellen


Methoden: Die Studie verwendete eine Umfrage unter 398 Studierenden einer chinesischen Universität, um die Wahrnehmung von Online-Lernumgebungen, die Ermächtigung der Lernenden, das Lernverhalten und die Motivation zu messen. Es wurden strukturierte Fragebögen eingesetzt, die mit einer 6-Punkte-Likert-Skala bewertet wurden. Zur Datenanalyse wurden beschreibende Statistiken, Korrelationsanalysen und Strukturgleichungsmodellierung (SEM) verwendet.


Datenquellen: Die Daten stammen aus Selbstauskünften der Studierenden zu ihrer Wahrnehmung der Online-Lernumgebungen und ihrer eigenen Lernmotivation und -engagement.


3. Zentrale Forschungsergebnisse


Positive Auswirkungen von Online-Lernumgebungen: Die Studie fand heraus, dass Online-Lernumgebungen einen signifikant positiven Einfluss auf die Ermächtigung der Lernenden, ihr Lernverhalten und ihre Motivation haben.


Rolle der Lernmotivation: Lernmotivation wurde als signifikanter Mediator zwischen Online-Lernumgebungen und dem Lernverhalten der Studierenden identifiziert. Eine höhere Lernmotivation verstärkte die positiven Effekte der Online-Lernumgebungen auf das Engagement.


Ermächtigung der Lernenden: Die Ermächtigung der Lernenden steht in positivem Zusammenhang mit ihrem Lernverhalten und ihrer Motivation, was darauf hinweist, dass Empowerment ein wichtiger Faktor für erfolgreiches Lernen ist.


4. Zusammenfassung
Die Studie von Pan zeigt, dass Online-Lernumgebungen einen bedeutenden Einfluss auf die Lernmotivation und das Engagement der Studierenden haben. Die Ergebnisse betonen die Wichtigkeit, Lernumgebungen zu optimieren, um die Motivation und das Engagement der Lernenden zu fördern. Lernmotivation wirkt als Schlüsselmediator, der den Einfluss von Online-Lernumgebungen auf das Lernverhalten verstärkt.
5. Kernaussagen


Einfluss von Online-Lernumgebungen: Diese Umgebungen fördern die Ermächtigung und das Engagement der Lernenden signifikant. (S. 1)


Mediierende Rolle der Motivation: Lernmotivation ist ein kritischer Faktor, der die Beziehung zwischen Lernumgebungen und dem Engagement der Lernenden vermittelt. (S. 9)


Bedeutung der Ermächtigung: Die Ermächtigung der Lernenden ist entscheidend für die Steigerung ihrer Motivation und ihres Engagements. (S. 11)


6. Argumentationslinien
Die Studie argumentiert, dass das Design von Online-Lernumgebungen entscheidend dafür ist, wie effektiv sie das Lernen unterstützen können. Insbesondere hebt die Studie hervor, dass die Motivation der Lernenden ein entscheidender Faktor für die Nutzung der Lernumgebungen ist. Die Autoren betonen die Notwendigkeit, Lernumgebungen so zu gestalten, dass sie die Eigenständigkeit und das Engagement der Lernenden fördern, was durch eine verstärkte Unterstützung von Lehrkräften erreicht werden kann. (S. 10-12)
7. Verschlagwortung
Passendste Schlagworte und Begründungen:


Lehr- und Lerneffektivität: Die Studie untersucht, wie Online-Lernumgebungen die Lernmotivation und das Engagement der Lernenden fördern, was zu einer effektiveren Lernumgebung führt.


Systemanpassung: Es wird analysiert, wie Lernumgebungen angepasst werden können, um die Motivation und Ermächtigung der Lernenden zu steigern.


Bildungstheorien: Die Untersuchung basiert auf theoretischen Modellen zur Lernmotivation und Ermächtigung der Lernenden.


8. Kategorisierung
Kerngedanke: Die Studie verdeutlicht die zentrale Rolle von Online-Lernumgebungen und Lernmotivation bei der Förderung des Engagements und der Ermächtigung der Lernenden. Sie zeigt, wie wichtig es ist, Lernumgebungen so zu gestalten, dass sie die intrinsische Motivation der Lernenden stärken. (S. 13-14)
9. Zuordnung zur Forschungsfrage
Passendste Forschungsunterfrage:


FU6: Wie wird ein systemisch-konstruktivistisches Learning-Management-System als Kompetenzerwerbssystem bei Akteuren im digitalen Bildungsraum von Gesundheitsberufen beurteilt?


Begründung: Die Untersuchung der Rolle von Online-Lernumgebungen und der Lernmotivation bietet wichtige Erkenntnisse über die Effektivität und Gestaltung von Lernsystemen im digitalen Bildungsbereich.




10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 - Die Studie bietet tiefgehende Einblicke in die Bedeutung von Lernumgebungen für das Engagement der Lernenden.


Zitierhäufigkeit und Einfluss: 4 - Die Studie ist neu und bietet relevante Beiträge zur Diskussion über Online-Lernen.


Aktualität: 5 - Die Forschung bezieht sich auf aktuelle Entwicklungen im Bereich der digitalen Bildung.


Gesamtbewertung: 4.7


Diese detaillierte Analyse der Studie von Xiaoquan Pan bietet wertvolle Einblicke in die Rolle von Online-Lernumgebungen und Lernmotivation bei der Förderung von Lernengagement und Ermächtigung.
},
	file = {Pan - 2023 - Online Learning Environments, Learners’ Empowermen.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/66N9ZYDR/Pan - 2023 - Online Learning Environments, Learners’ Empowermen.pdf:application/pdf},
}

@inproceedings{university_of_latvia_latvia_learning_2023,
	address = {Jelgava},
	title = {Learning culture or learning organization – approaches to implement changes at schools},
	url = {https://lbtufb.lbtu.lv/conference/REEP/2023/Latvia_REEP_2023_proceedings_No16_online-132-139.pdf},
	doi = {10/gsx9n2},
	abstract = {Currently, in Latvia, the improvement of the education process at the political and practical levels is based on the approach of the school as a learning organization, without critically analysing the advantages and disadvantages of the approach. Therefore, the aim of this theoretical study is to evaluate a different theoretical approach - the school as a learning organization and a learning culture to explore the practices taking place at school and to influence them by implementing changes in education. The analysis of the theoretical sources, documents and studies carried out in the research allows to conclude that the approach of the school as a learning organization, although it is widely used, does not sufficiently explain the processes taking place at school, ignoring the interaction of various structures and agents and the power given to them. Educational research is increasingly recognizing the pervasive influence of culture on teaching and learning. From a cultural perspective, changes in education and practices at schools is a complex and not always feasible process, as it is associated with tensions and conflicts. Using the theory of learning culture, it is possible to understand why students learn or do not engage in the learning process, why teachers change or do not change their practices, and how management can influence developments at a particular school. The study demonstrates the possibilities of the theoretical approaches of both sides to find out and improve the teaching and learning implemented at schools on the way to the knowledge society.},
	language = {en-GB},
	urldate = {2023-10-22},
	booktitle = {Rural environment. education. personality.},
	author = {{University of Latvia, Latvia} and Lazdina, Solvita},
	month = may,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Promotion:FU4a, Promotion:Kerngedanke, Promotion:Relevanz:5, Bildungstheorien, Krisenreaktion im Bildungsbereich, Lernsystemarchitektur, \#1:Konferenz-Paper:learning:management:system, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {132--139},
	annote = {Analyse der Studie "Learning Culture or Learning Organization – Approaches to Implement Changes at Schools" von Solvita Lazdiņa
1. Analyse
Hauptthemen und Ziele der Forschung:
Die Studie von Solvita Lazdiņa (2023) untersucht die beiden theoretischen Ansätze der "Schule als lernende Organisation" und der "Lernkultur", um herauszufinden, wie Veränderungen in Schulen umgesetzt werden können. Ziel ist es, die Vor- und Nachteile beider Ansätze zu evaluieren und herauszufinden, welcher Ansatz effektiver ist, um Bildungspraktiken zu verbessern und Schulen auf dem Weg zur Wissensgesellschaft zu unterstützen​.
Methoden und Datenquellen:


Methoden: Die Forschung basiert auf einer theoretischen Analyse von Literatur, Dokumenten und Studien, die sich mit den Konzepten der Schule als lernende Organisation und der Lernkultur befassen. Der Vergleich der theoretischen Rahmenbedingungen dient dazu, die Bedeutung und Einschränkungen beider Ansätze zu untersuchen​.


Datenquellen: Die Studie nutzt eine Vielzahl von Quellen, darunter Bildungsrichtlinien, theoretische Literatur und empirische Untersuchungen, um die Effekte der beiden Ansätze zu analysieren und ihre Umsetzbarkeit in verschiedenen Bildungskontexten zu bewerten​.


Zentrale Forschungsergebnisse:


Schule als lernende Organisation: Dieser Ansatz wird häufig in der Bildungspolitik verwendet, um Schulen als ideale Strukturen darzustellen, die Veränderungen bewältigen und Innovationen fördern können. Die Autoren kritisieren jedoch, dass dieser Ansatz oft die Komplexität schulischer Prozesse ignoriert und die Rolle des Managements überbewertet​​.


Lernkultur: Die Theorie der Lernkultur betont, dass die Verbesserung des Lernens mit der Transformation der Kultur verbunden ist, was durch die Wechselwirkungen zwischen verschiedenen Einflüssen und Strukturen beeinflusst wird. Diese Perspektive ermöglicht ein tieferes Verständnis der sozialen Praktiken und der Hindernisse, die Veränderungen im Bildungssystem erschweren können​​.


Kultureller Einfluss: Die Studie hebt hervor, dass die Kultur in Schulen eine bedeutende Rolle spielt, indem sie sowohl Lernprozesse fördert als auch hemmt. Unterschiedliche kulturelle Kontexte können die Implementierung von Veränderungen beeinflussen und erfordern eine Anpassung der Ansätze an lokale Gegebenheiten​.


2. Zusammenfassung
Die Studie vergleicht die Ansätze der Schule als lernende Organisation und der Lernkultur, um herauszufinden, welcher Ansatz besser geeignet ist, um Bildungspraktiken zu verbessern. Während die Schule als lernende Organisation auf Managementpraktiken fokussiert, betont die Lernkultur die Bedeutung sozialer und kultureller Faktoren. Die Autoren argumentieren, dass die Lernkultur ein umfassenderes Verständnis der Herausforderungen und Möglichkeiten für Veränderungen in Bildungseinrichtungen bietet​.
3. Kernaussagen


Komplexität des Lernens: Die Theorie der Lernkultur zeigt, dass das Lernen von sozialen und kulturellen Faktoren beeinflusst wird, die über das Management hinausgehen​.


Kritik am Organisationsansatz: Der Ansatz der Schule als lernende Organisation wird dafür kritisiert, dass er die sozialen Dimensionen des Lernens und die Machtstrukturen in Bildungseinrichtungen nicht ausreichend berücksichtigt​.


Kulturelle Anpassung: Veränderungen in Schulen müssen kulturell angepasst werden, um effektiv zu sein und langfristige Verbesserungen zu erzielen​.


4. Argumentationslinien
Die Autoren argumentieren, dass die Theorie der Lernkultur ein tiefgreifenderes Verständnis der Bildungsprozesse ermöglicht, indem sie die sozialen und kulturellen Dimensionen des Lernens berücksichtigt. Im Gegensatz dazu wird der Ansatz der Schule als lernende Organisation als zu stark auf Managementtechniken fokussiert kritisiert, wodurch die eigentlichen Herausforderungen des Bildungssystems übersehen werden. Die Autoren betonen die Notwendigkeit, beide Ansätze zu integrieren, um eine umfassendere Sicht auf die Bildungsreform zu gewinnen​.
5. Verschlagwortung


Lernsystemarchitektur: Untersuchung der strukturellen Ansätze zur Verbesserung von Bildungsinstitutionen.


Bildungstheorien: Analyse der theoretischen Rahmenbedingungen, die Bildungspraktiken beeinflussen.


Krisenreaktion im Bildungsbereich: Untersuchung der Anpassungsfähigkeit von Schulen an Veränderungen und Herausforderungen.


6. Kategorisierung


Kerngedanke: Die Studie beleuchtet die Bedeutung der kulturellen Dimension im Bildungswesen und zeigt auf, dass Veränderungen durch die Berücksichtigung von Lernkultur effektiver gestaltet werden können​.


7. Zuordnung zu Forschungsfragen
Passendste Forschungsunterfrage:


FU4a: Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?


Begründung: Die Studie bietet Einblicke in die kulturellen und sozialen Mechanismen, die Lernprozesse beeinflussen, was für die Analyse von Bildungsmechanismen relevant ist​.




8. Einordnung der Relevanz, Bewertungsskala


Relevanzbewertung: 5 - Hoch relevant: Die Quelle bietet wertvolle theoretische Einsichten in die Ansätze zur Implementierung von Veränderungen in Bildungseinrichtungen und ist somit direkt relevant für die Forschungsfrage.


},
	file = {University of Latvia, Latvia und Lazdina - 2023 - Learning culture or learning organization – approa.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/5D4DKLKB/University of Latvia, Latvia und Lazdina - 2023 - Learning culture or learning organization – approa.pdf:application/pdf},
}

@article{center_for_education_accreditation_viet_nam_national_university_vnu-cea_hanoi_vietnam_personalized_2023,
