  keywords = {8:Zeitschriftenartikel:blended:learning,Bildung,Charité:Promotion,Lehr- und Lerneffektivität,Multimedia,Promotion:FU4a,Promotion:Kerngedanke,Promotion:Literaturanalyse,Promotion:Relevanz:5,Systemanpassung},
