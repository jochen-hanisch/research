  author = {Masuda, Mitsumi and Sugiyama, Fumino and Shogaki, Junko and Matsumoto, Kyoko and Yagi, Machiko Saeki and Oishi, Hidenori},
  date = {2022-08-05},
  journaltitle = {GHM Open},
  shortjournal = {GHM Open},
  volume = {2},
