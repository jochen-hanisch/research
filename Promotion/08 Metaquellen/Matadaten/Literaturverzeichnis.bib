@article{bong_dual-process_2024,
	title = {A dual-process motivation mediation model to explain female high school students' cognitive engagement and disengagement in emergency remote teaching and online learning in {South} {Korea}},
	volume = {55},
	issn = {1467-8535},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/bjet.13415},
	doi = {10.1111/bjet.13415},
	abstract = {High attrition/dropout rates and low engagement have been major concerns of online educators. This study examined female high school students' cognitive engagement and disengagement in an online learning context during the COVID-19 pandemic through the lens of self-determination theory's basic psychological needs. We investigated an extended dual-process motivation mediation model that emphasizes the mediating role of the need for competence, including an additional factor, technology self-efficacy, in a South Korean high school context (n = 235). Results from structural equation modelling provided evidence for the proposed model. Our findings indicated that the exogenous variables (ie, perceived autonomy support, perceived teacher control and technology self-efficacy) predicted cognitive engagement and disengagement with the mediating role of competence need satisfaction and competence need frustration. We found distinct processes including (a) “autonomy support-competence need satisfaction-cognitive engagement”, (b) “teacher control-competence need frustration-cognitive disengagement”, (c) “technology self-efficacy-competence need satisfaction-cognitive engagement” and (d) “technology self-efficacy-competence need frustration (negative effect)-cognitive disengagement”. This study suggests using autonomy support strategies to fulfil students' competence needs in online learning contexts. We also found a possible role of technology self-efficacy in influencing psychological competence needs, cognitive engagement and cognitive disengagement in online learning contexts. Implications of the findings are discussed. Practitioner notes What is already known about this topic High attrition/dropout rates and low engagement have been major concerns of online educators. Emergency remote teaching (ERT) has implications for online teaching beyond the ERT paradigm. Self-determination theory (SDT) has been adopted and adapted with the goal of determining how to achieve need satisfaction, optimize learner motivation and enhance student engagement in classroom settings. What this paper adds This study applied a dual-process motivation mediation model to investigate both cognitive engagement and disengagement among female high school students in an ERT online learning environment. The extended dual-process motivation mediation model examined the role of an additional factor, technology self-efficacy in cognitive engagement and disengagement in online learning. This study examined the role of direct, indirect and cross-over effects focusing on both bright and dark aspects of the dual-process motivation mediation model in online learning in a South Korean girls' high school during ERT. Implications for practice and/or policy This study proposes the use of autonomy support strategies in online learning contexts. Teachers should understand their students and provide support that addresses competence need satisfaction to enhance student cognitive engagement in online learning contexts. More efforts should be made to prepare teachers for designing online learning experiences that increase students' competence need satisfaction and decrease competence need frustration.},
	language = {en-GB},
	number = {3},
	urldate = {2024-05-14},
	journal = {British Journal of Educational Technology},
	author = {Bong, Ji Yae and Cho, Kyunghwa and Liu, Zhichun and He, Dan},
	year = {2024},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1111/bjet.13415},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Lehr- und Lerneffektivität, Promotion:FU4a, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Systemanpassung, cognitive disengagement, cognitive engagement, emergency remote teaching, online learning, self-determination theory, technology self-efficacy, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {1020--1040},
	annote = {Analyse des wissenschaftlichen Artikels "A Dual-Process Motivation Mediation Model to Explain Female High School Students' Cognitive Engagement and Disengagement in Emergency Remote Teaching and Online Learning in South Korea" von Ji Yae Bong, Kyunghwa Cho, Zhichun Liu und Dan He (2024).
1. Analyse
Hauptthemen und Ziele der Forschung
Die Studie untersucht die kognitive Beteiligung und Abkopplung weiblicher Schüler im Online-Lernen während des Notfall-Fernunterrichts (ERT) in Südkorea. Das Ziel ist es, zu verstehen, wie die Selbstbestimmungstheorie (SDT) und die Technologie-Selbsteffizienz die kognitive Beteiligung und Abkopplung beeinflussen. Die Forschung verwendet ein erweitertes duales Motivationsvermittlungsmodell, um die Rolle der Kompetenzerfüllung und -frustration zu analysieren und den Einfluss von wahrgenommener Autonomieunterstützung, Lehrersteuerung und Technologie-Selbsteffizienz auf das Engagement und die Abkopplung der Schüler zu untersuchen.
Methoden und Datenquellen
Die Studie verwendet ein strukturelles Gleichungsmodell (SEM), um ein duales Motivationsvermittlungsmodell zu testen. Die Teilnehmer der Studie sind 235 Schülerinnen einer öffentlichen Mädchenschule in Südkorea, die alle zwischen 15 und 18 Jahre alt sind. Die Datenerhebung erfolgte mittels eines SDT-Fragebogens, der folgende Aspekte abdeckt:


Wahrgenommene Autonomieunterstützung (PAS)


Wahrgenommene Lehrersteuerung (PTC)


Technologie-Selbsteffizienz (TSE)


Kompetenzbedürfnis-Erfüllung (CNS)


Kompetenzbedürfnis-Frustration (CNF)


Kognitive Beteiligung (COEN)


Kognitive Abkopplung (CODISEN)


Die Datenanalyse wurde mit Hilfe von AMOS (Version 29) und MPlus (Version 8) durchgeführt, um die Passgenauigkeit des Modells zu bewerten.
Zentrale Forschungsergebnisse


Kognitive Beteiligung: Autonomieunterstützung und Technologie-Selbsteffizienz steigern die kognitive Beteiligung, indem sie die Erfüllung von Kompetenzbedürfnissen fördern. (S. 1030)


Kognitive Abkopplung: Lehrersteuerung führt zu Kompetenzfrustration, was die kognitive Abkopplung erhöht. (S. 1030)


Technologie-Selbsteffizienz: Technologie-Selbsteffizienz beeinflusst sowohl die Erfüllung als auch die Frustration von Kompetenzbedürfnissen und hat damit direkte und indirekte Auswirkungen auf die kognitive Beteiligung und Abkopplung. (S. 1031)


2. Zusammenfassung
Die Studie untersucht die kognitive Beteiligung und Abkopplung von Schülerinnen in einem Online-Lernkontext während der COVID-19-Pandemie in Südkorea. Sie zeigt, dass wahrgenommene Autonomieunterstützung und Technologie-Selbsteffizienz die Erfüllung von Kompetenzbedürfnissen fördern, was zu einer höheren kognitiven Beteiligung führt. Umgekehrt führt Lehrersteuerung zu Kompetenzfrustration und erhöhter kognitiver Abkopplung. Die Ergebnisse unterstreichen die Bedeutung der Unterstützung von Autonomie und Technologiekompetenz, um das Engagement im Online-Lernen zu fördern.
3. Kernaussagen


Autonomieunterstützung fördert Engagement: Autonomieunterstützung erhöht die kognitive Beteiligung durch die Erfüllung von Kompetenzbedürfnissen. (S. 1030)


Lehrersteuerung fördert Abkopplung: Lehrersteuerung führt zu Frustration von Kompetenzbedürfnissen und erhöht die kognitive Abkopplung. (S. 1030)


Rolle der Technologie-Selbsteffizienz: Technologie-Selbsteffizienz hat signifikante direkte und indirekte Effekte auf die kognitive Beteiligung und Abkopplung. (S. 1031)


4. Argumentationslinien
Die Autoren argumentieren, dass Autonomieunterstützung und Technologie-Selbsteffizienz wesentliche Faktoren für die Förderung der kognitiven Beteiligung im Online-Lernen sind. Lehrersteuerung hingegen fördert die Frustration von Kompetenzbedürfnissen und führt zu einer erhöhten Abkopplung. Diese Ergebnisse unterstreichen die Bedeutung der Gestaltung von Lernumgebungen, die Autonomie und technologische Kompetenzen unterstützen, um das Engagement der Lernenden zu verbessern. (S. 1034)
5. Verschlagwortung


Lehr- und Lerneffektivität: Untersuchung der Faktoren, die das Engagement und die Abkopplung im Online-Lernen beeinflussen.


Technologieintegration: Rolle der Technologie-Selbsteffizienz im Online-Lernen.


Systemanpassung: Anpassung von Lehrstrategien zur Förderung der kognitiven Beteiligung.


6. Kategorisierung
Kerngedanke: Die Studie analysiert, wie Autonomieunterstützung, Lehrersteuerung und Technologie-Selbsteffizienz die kognitive Beteiligung und Abkopplung von Schülerinnen im Online-Lernen beeinflussen. Sie hebt die Bedeutung von Autonomieunterstützung und Technologiekompetenzen hervor, um die Lernbeteiligung zu fördern. (S. 1035)
7. Zuordnung zu Forschungsfragen
Passendste Forschungsunterfrage: FU4a - Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?
Begründung: Die Studie untersucht, wie verschiedene Faktoren im Online-Lernen die kognitive Beteiligung beeinflussen, was direkt mit bildungswissenschaftlichen Mechanismen und deren Auswirkungen auf die Lernenden zusammenhängt.
8. Einordnung der Relevanz
Relevanzbewertung: 5 - Hoch relevantDie Quelle liefert umfassende Erkenntnisse über die Faktoren, die das Engagement im Online-Lernen beeinflussen, und bietet wertvolle Implikationen für die Gestaltung effektiver Lernumgebungen, die das Engagement der Lernenden fördern können.
Diese strukturierte Analyse bietet einen tiefen Einblick in die Themen der Studie und zeigt deren Relevanz im Kontext der digitalen Bildung auf. Die Ergebnisse unterstreichen die Notwendigkeit, Lernumgebungen zu gestalten, die Autonomie und technologische Kompetenzen unterstützen, um die Lernbeteiligung zu verbessern.
},
	file = {Bong et al. - 2024 - A dual-process motivation mediation model to expla.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/5C527UA8/Bong et al. - 2024 - A dual-process motivation mediation model to expla.pdf:application/pdf;Snapshot:/Users/jochenhanisch-johannsen/Zotero/storage/QXM6FT9E/bjet.html:text/html},
}

@article{bakir-yalcin_investigating_2024,
	title = {Investigating the antecedents of engagement in online learning: do achievement emotions matter?},
	volume = {29},
	issn = {1360-2357, 1573-7608},
	shorttitle = {Investigating the antecedents of engagement in online learning},
	url = {https://link.springer.com/10.1007/s10639-023-11995-z},
	doi = {10.1007/s10639-023-11995-z},
	abstract = {Student engagement is a multidimensional construct, indicates actual learning experiences and is affected by emotions. Negative and positive achievement emotions play an important role in engagement. In the light of Control-Value Theory and the Extended Process Model of Emotion Regulation, a model was developed and tested to investigate the relationship between student engagement and the antecedents of emotions. Participants consisted of 1450 pre-service teachers who were enrolled in degree programs at Faculties of Education in Turkey. The structural equation modeling method was used to test two research models developed for positive and negative achievement emotions. In the negative achievement emotions model, student engagement was influenced by control of learning beliefs, task value, negative achievement emotions, and reappraisal strategy, and these variables together explained 83.1\% of the total variance in engagement. In the positive achievement emotions model, results revealed the effect of control of learning beliefs, task value, positive achievement emotions, and reappraisal strategy on student engagement, and these variables together explained 97.3\% of the total variance in engagement. The findings have implications for expanding the theoretical knowledge about emotions and emotion regulation strategies to improve student engagement in online learning environments. This study suggests that it is important to pay attention to task value and emotions when designing online instruction and online learning materials and courses.},
	language = {en-GB},
	number = {4},
	urldate = {2024-03-23},
	journal = {Education and Information Technologies},
	author = {Bakır-Yalçın, Eda and Usluel, Yasemin Koçak},
	month = mar,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Systemanpassung, Promotion:FU1, Promotion:S:11 Online Learning, Promotion:Dissertation {\textbar} FU1 {\textgreater} Kerngedanke, Promotion:Literaturverzeichnis},
	pages = {3759--3791},
	annote = {Analyse des wissenschaftlichen Artikels "Investigating the Antecedents of Engagement in Online Learning: Do Achievement Emotions Matter?" von Eda Bakır-Yalçın und Yasemin Koçak Usluel (2024).
1. Analyse
Hauptthemen und Ziele der Forschung
Die Studie untersucht, wie Erfolgsemotionen (positive und negative) das Engagement von Studierenden in Online-Lernumgebungen beeinflussen. Ziel der Forschung ist es, die strukturellen Beziehungen zwischen Kontroll- und Wertüberzeugungen, Emotionen, Emotionsregulationsstrategien und dem Engagement von Lehramtsstudierenden zu modellieren und zu testen. Die Studie stützt sich auf die Kontroll-Wert-Theorie (Control-Value Theory) und das erweiterte Prozessmodell der Emotionsregulation, um zu verstehen, wie emotionale Faktoren das Engagement in Online-Lernumgebungen beeinflussen.
Methoden und Datenquellen
Die Studie verwendet ein strukturelles Gleichungsmodell (SEM), um zwei Forschungsmodelle für positive und negative Erfolgsemotionen zu testen. Die Teilnehmer der Studie sind 1450 Lehramtsstudierende, die an verschiedenen Hochschulen in der Türkei eingeschrieben sind. Die Daten wurden durch Online-Befragungen erhoben, die folgende Messinstrumente umfassten:


Motivated Strategies for Learning Questionnaire (MSLQ): Misst Kontrollüberzeugungen (CLB) und den Aufgabenwert (TV) mit einer 7-Punkte-Likert-Skala.


Class Related Achievement Emotions Questionnaire (Kurzform): Misst positive und negative Erfolgsemotionen (PAE und NAE) mit einer 5-Punkte-Likert-Skala.


Emotion Regulation Questionnaire: Misst Reappraisal (REAP) und Suppression (SUPP) mit einer 7-Punkte-Likert-Skala.


Student Engagement Scale in Online Environments: Misst das Engagement der Studierenden (emotional, kognitiv und verhaltensbezogen) mit einer 5-Punkte-Likert-Skala.


Zentrale Forschungsergebnisse


Positive Erfolgsemotionen (PAE): Das Engagement der Studierenden wird durch positive Erfolgsemotionen, Aufgabenwert und Reappraisal positiv beeinflusst. Diese Variablen erklären 97,3 \% der Varianz im Engagement. (S. 3765)


Negative Erfolgsemotionen (NAE): Das Engagement wird durch negative Erfolgsemotionen, Aufgabenwert und Reappraisal negativ beeinflusst. Diese Variablen erklären 83,1 \% der Varianz im Engagement. (S. 3765)


Kontrollüberzeugungen und Aufgabenwert: Kontrollüberzeugungen beeinflussen sowohl positive als auch negative Erfolgsemotionen durch ihren Effekt auf den Aufgabenwert, der als stärkster Prädiktor für Erfolgsemotionen gilt. (S. 3764)


Emotionsregulationsstrategien: Reappraisal hat einen positiven Einfluss auf das Engagement, während Suppression keinen signifikanten Einfluss auf das Engagement hat. (S. 3766)


2. Zusammenfassung
Die Studie untersucht die Rolle von Erfolgsemotionen, Kontrollüberzeugungen und Emotionsregulationsstrategien im Kontext des Online-Lernens. Es wird gezeigt, dass positive Erfolgsemotionen das Engagement der Studierenden signifikant erhöhen, während negative Emotionen es verringern. Der Aufgabenwert spielt eine entscheidende Rolle bei der Vorhersage von Erfolgsemotionen und beeinflusst das Engagement direkt und indirekt. Reappraisal als Emotionsregulationsstrategie unterstützt das Engagement, während Suppression keinen signifikanten Einfluss zeigt. Diese Erkenntnisse unterstreichen die Bedeutung emotionaler und kognitiver Faktoren für das Engagement in Online-Lernumgebungen.
3. Kernaussagen


Aufgabenwert als zentraler Faktor: Der Aufgabenwert hat sowohl direkte als auch indirekte Effekte auf das Engagement und ist ein entscheidender Prädiktor für positive und negative Erfolgsemotionen. (S. 3764)


Positive Emotionen fördern das Engagement: Positive Erfolgsemotionen sind der stärkste Einflussfaktor auf das Engagement der Studierenden in Online-Lernumgebungen. (S. 3775)


Reappraisal fördert Engagement: Reappraisal als adaptive Emotionsregulationsstrategie erhöht das Engagement signifikant. (S. 3777)


4. Argumentationslinien
Die Autoren argumentieren, dass Erfolgsemotionen einen entscheidenden Einfluss auf das Engagement der Studierenden haben. Positive Emotionen fördern das Engagement, indem sie durch einen hohen Aufgabenwert und adaptive Emotionsregulationsstrategien wie Reappraisal unterstützt werden. Negative Emotionen hingegen verringern das Engagement. Die Studie zeigt, dass Kontrollüberzeugungen und der Aufgabenwert zentrale Determinanten für das emotionale Erleben und das Engagement in Online-Lernumgebungen sind. (S. 3777)
5. Verschlagwortung


Lehr- und Lerneffektivität: Untersuchung der emotionalen und kognitiven Faktoren, die das Engagement im Online-Lernen beeinflussen.


Emotionale und kognitive Anpassung: Rolle von Emotionsregulationsstrategien und kognitiven Bewertungen beim Lernen.


Systemanpassung: Anpassung von Lernumgebungen, um positive Emotionen und Engagement zu fördern.


6. Kategorisierung
Kerngedanke: Die Studie analysiert, wie Erfolgsemotionen, Kontrollüberzeugungen und Emotionsregulationsstrategien das Engagement der Studierenden im Online-Lernen beeinflussen. Sie zeigt, dass positive Emotionen und ein hoher Aufgabenwert entscheidend für das Engagement sind und durch Reappraisal unterstützt werden. (S. 3775)
7. Zuordnung zu Forschungsfragen
Passendste Forschungsunterfrage: FU1 - Welche Akzeptanz und Nützlichkeit (Bedeutung) beschreiben Akteure im digitalen Bildungsraum von Gesundheitsberufen bei Anwendung eines Learning-Management-Systems?
Begründung: Die Studie untersucht die Rolle von Emotionen und kognitiven Faktoren im Online-Lernen, was direkt mit der Akzeptanz und Nützlichkeit digitaler Lernsysteme zusammenhängt.
8. Einordnung der Relevanz
Relevanzbewertung: 5 - Hoch relevantDie Quelle liefert umfassende Erkenntnisse über die Bedeutung emotionaler und kognitiver Faktoren für das Engagement im Online-Lernen und bietet wertvolle Implikationen für die Gestaltung effektiver Online-Lernumgebungen.
Diese strukturierte Analyse bietet einen tiefen Einblick in die Themen der Studie und zeigt deren Relevanz im Kontext der digitalen Bildung auf. Die Ergebnisse betonen die Notwendigkeit, Online-Lernumgebungen zu gestalten, die positive Emotionen fördern und kognitive sowie emotionale Anpassungsstrategien unterstützen.
},
	file = {Bakır-Yalçın und Usluel - 2024 - Investigating the antecedents of engagement in onl.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/8FCZVFB7/Bakır-Yalçın und Usluel - 2024 - Investigating the antecedents of engagement in onl.pdf:application/pdf},
}

@article{khanal_shifting_2024,
	title = {Shifting identities: an examination of student perceptions and experiences in face-to-face and online learning in {Nepal}},
	volume = {29},
	issn = {1360-2357, 1573-7608},
	shorttitle = {Shifting identities},
	url = {https://link.springer.com/10.1007/s10639-023-12020-z},
	doi = {10.1007/s10639-023-12020-z},
	abstract = {The transition from traditional, in-person classrooms to technology-based models like online learning is a significant challenge. This change is not only brought on by the COVID-19 pandemic, but it also presents difficulties for low-income and developing countries that have adopted online education for students who are spread out over a wide area. Students from low-income and developing countries, where the teaching and learning process is limited to a classroom environment, are struggling to adjust to online learning. This study aims to shed light on the multifaceted dimensions of the students’ educational journey, their adaptation to alternative learning environments, and the intricate interplay between sociocultural factors and individual identity trajectories within the Nepalese context. Based on indepth interviews with 15 graduate students who were also school teachers, the study found that student’s identities underwent some instability as tension arose between their self-perception in face-to-face and online learning. The students experienced changes in who they were in the face-to-face classroom and who they are in online learning, as well as changes in how society viewed them as online learners.},
	language = {en-GB},
	number = {4},
	urldate = {2024-03-23},
	journal = {Education and Information Technologies},
	author = {Khanal, Jeevan},
	month = mar,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Lehr- und Lerneffektivität, Promotion:FU4a, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Systemanpassung, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {4287--4315},
	annote = {Analyse des wissenschaftlichen Artikels "Shifting Identities: An Examination of Student Perceptions and Experiences in Face-to-Face and Online Learning in Nepal" von Jeevan Khanal (2024).
1. Analyse
Hauptthemen und Ziele der Forschung
Die Studie untersucht den Einfluss des Übergangs von traditionellem Präsenzunterricht zu Online-Lernen auf die Identität von Studierenden in Nepal. Ziel der Forschung ist es, die Erfahrungen und Wahrnehmungen von M.Phil.-Studierenden in Bezug auf ihre Identität in verschiedenen Lernumgebungen zu verstehen. Dabei wird untersucht, wie sich diese Veränderungen auf ihre Lernleistungen, ihr Zugehörigkeitsgefühl und ihre sozialen Interaktionen auswirken. Die Studie konzentriert sich auf die sozialen und individuellen Identitätsveränderungen, die durch den Wechsel zu Online-Lernumgebungen ausgelöst werden.
Methoden und Datenquellen
Die Studie verwendet einen qualitativen Ansatz mit einer interpretativen Paradigma-Methodik. Daten wurden durch in-depth Interviews mit 15 M.Phil.-Studierenden, die zuvor an traditionellen Universitäten in Nepal gelernt haben, gesammelt. Die Interviews wurden online über Microsoft Teams durchgeführt und dauerten jeweils etwa 45 Minuten. Die Teilnehmer wurden gezielt ausgewählt, um ihre ersten Erfahrungen mit blended Learning zu untersuchen. Zur Analyse der Daten wurde ein kritischer und diskursiver Analyseansatz verwendet, bei dem die Transkripte der Interviews analysiert wurden, um die Identitätskonstruktion und -veränderung zu verstehen.
Zentrale Forschungsergebnisse


Identitätsveränderung: Die Studierenden erlebten während des Übergangs vom Präsenz- zum Online-Lernen signifikante Veränderungen in ihrer Identität. Diese Veränderungen führten zu einer Neudefinition ihrer Rolle von passiven Wissensaufnehmenden zu aktiven Lernenden. (S. 4306)


Technologische Anpassung: Die Studierenden entwickelten durch den Einsatz von Technologien wie Blackboard und Moodle neue digitale Fähigkeiten und fühlten sich zunehmend als technisch versierte Lernende. (S. 4303)


Herausforderungen und Emotionen: Die Studierenden berichteten von anfänglichen Herausforderungen und negativen Emotionen, die mit der Anpassung an die neue Lernumgebung einhergingen, jedoch überwogen letztlich positive Erfahrungen und ein gestärktes Selbstbild. (S. 4305)


2. Zusammenfassung
Die Studie untersucht, wie der Übergang von Präsenzunterricht zu Online-Lernen die Identität von M.Phil.-Studierenden in Nepal beeinflusst. Die Ergebnisse zeigen, dass Studierende signifikante Identitätsveränderungen erfahren haben, indem sie von passiven zu aktiven Lernenden wurden und technologische Kompetenzen entwickelten. Trotz anfänglicher Herausforderungen und negativer Emotionen bewerteten die Studierenden den Übergang letztlich positiv. Die Studie hebt die transformative Wirkung von Online-Lernumgebungen auf die Identität der Studierenden hervor.
3. Kernaussagen


Identitätsveränderung: Die Studierenden definierten sich neu als aktive Lernende und technikaffine Personen. (S. 4306)


Technologische Kompetenzen: Der Einsatz von Technologien im Online-Lernen förderte die Entwicklung neuer digitaler Fähigkeiten. (S. 4303)


Positive Wahrnehmung: Trotz anfänglicher Schwierigkeiten empfanden die Studierenden die Veränderungen in ihrer Lernidentität als positiv und stärkend. (S. 4305)


4. Argumentationslinien
Die Autoren argumentieren, dass der Wechsel zu Online-Lernen eine tiefgreifende Auswirkung auf die Identität von Studierenden hat, indem er sie dazu zwingt, neue Rollen und Verantwortlichkeiten zu übernehmen. Der Übergang fördert die Entwicklung digitaler Kompetenzen und verändert die Selbstwahrnehmung der Studierenden von passiven Empfängern zu aktiven Teilnehmern. Diese Veränderungen tragen zur Stärkung des Selbstbewusstseins und der Identität bei und zeigen das transformative Potenzial von Online-Lernumgebungen. (S. 4306)
5. Verschlagwortung


Systemanpassung: Anpassung der Lernidentität und der Rolle der Studierenden in verschiedenen Lernumgebungen.


Technologieintegration: Entwicklung digitaler Fähigkeiten durch den Einsatz von Online-Lernplattformen wie Blackboard und Moodle.


Lehr- und Lerneffektivität: Auswirkungen des Übergangs zu Online-Lernen auf die Lernleistung und das Selbstbild der Studierenden.


6. Kategorisierung
Kerngedanke: Die Studie untersucht die tiefgreifende Auswirkung des Wechsels zu Online-Lernen auf die Identität von Studierenden in Nepal und zeigt auf, wie sich diese Veränderungen positiv auf ihr Selbstbild und ihre Lernkompetenzen auswirken. (S. 4306)
7. Zuordnung zu Forschungsfragen
