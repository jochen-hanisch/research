@article{maleki_voices_2025,
	title = {Voices from the virtual classroom: students' views toward ethical challenges in the context of online formative assessment},
	volume = {4},
	issn = {2731-5525},
	shorttitle = {Voices from the virtual classroom},
	url = {https://link.springer.com/10.1007/s44217-025-00445-2},
	doi = {10.1007/s44217-025-00445-2},
	abstract = {The global impact of the COVID-19 pandemic has prompted a significant shift toward online Education. However, this transition has raised concerns about assessment, distance learning effectiveness, and student workload. These pandemicinduced conditions may also lead to ethical challenges in education. Despite existing research on ethical issues in online education, the focus on ethical challenges related to online formative assessment, especially in English as a Foreign Language (EFL) contexts, is still limited. Therefore, this study aims to explore students’ perspectives on ethical challenges related to online formative assessment. To achieve this objective, a mixed-methods approach was employed. Initially, a qualitative phase involving online focus group discussions was conducted with three distinct groups of eight Iranian EFL learners. These groups encompassed EFL learners from universities, institutes, and schools. Each group participated in a 70-min online discussion to examine the ethical challenges they encountered in online formative assessment following the onset of the COVID-19 pandemic. Thematic analysis of the data revealed that ethical challenges could be categorized into three main areas: group work, feedback, and cheating. Subsequently, a ranking scale was employed to determine the primary category that presented the most significant ethical challenge based on students’ viewpoints. The findings indicated that feedback was perceived as the most pressing ethical challenge, followed by issues with cheating and group work categories. Finally, the gathered information was categorized based on the specific learning contexts of the participants. This research provides valuable insights for EFL teachers, policymakers, and educational assessment systems. Based on these findings, it is recommended that EFL teachers and policymakers implement targeted professional development programs, foster a culture of academic integrity, and adopt clear guidelines to address these ethical challenges.},
	language = {en-GB},
	number = {1},
	urldate = {2025-03-15},
	journal = {Discover Education},
	author = {Maleki, Alireza},
	month = mar,
	year = {2025},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Technologieintegration, Bewertungsmethoden, Systemanpassung, Bildungstheorien, Promotion:Argumentation, Promotion:FU5, Datenschutz und IT-Sicherheit, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {56},
	annote = {Analyse des Artikels von Alireza Maleki (2025) mit dem Titel „Voices from the virtual classroom: students’ views toward ethical challenges in the context of online formative assessment“:

1. Analyse
Hauptthemen und Ziele der Forschung
Das zentrale Thema der Studie ist die Erforschung ethischer Herausforderungen in der Online-Bildung, insbesondere im Kontext formativer Online-Assessments (OFA) aus Sicht von iranischen EFL-Studierenden (English as a Foreign Language). Die Forschung fokussiert sich auf:


Wahrnehmung ethischer Probleme im digitalen Klassenraum,


Unterschiede in Lernkontexten (Universität, Institut, Schule),


Priorisierung dieser ethischen Herausforderungen durch die Betroffenen.


Ziel ist es, kontextualisierte Erkenntnisse zu gewinnen, um Lehrkräfte und Bildungspolitik zu sensibilisieren und aufzuklären.

Methoden und Datenquellen
Methodischer Zugang:


Mixed-Methods-Design mit qualitativen Fokusgruppen (3 Gruppen à 8 Teilnehmende) und


einer quantitativen Rangskala zur Priorisierung der wahrgenommenen Herausforderungen.


Datenerhebung:


Fokusgruppen über Google Meet (semi-strukturiert, 70 Minuten).


Ranking-Skala mit vorheriger Pilotierung.


Zielgerichtete Stichprobe (purposeful sampling) unter Einhaltung ethischer Richtlinien.


Datenauswertung:


Themenbasierte Inhaltsanalyse (qualitativ),


Berechnung von Durchschnittswerten zur Rangbestimmung (quantitativ),


Validität gestützt durch Triangulation, Intercoder-Reliabilität (Cohen’s Kappa = 0,85), Member Checking.



Zentrale Forschungsergebnisse
Drei Hauptkategorien ethischer Herausforderungen wurden identifiziert:


Feedback:


Lack of individualized feedback (41,66 \%)


Delayed gender-based feedback (12,5 \%)


Insufficiently detailed gender-based feedback (12,5 \%)




Cheating:


AI-gestütztes Betrügen (20,83 \%)


Ideen- und Aufgabenplagiat (12,5 \%)




Groupwork:


Nichtberücksichtigung von Interessen (16,66 \%)


Einteilung nur nach Kompetenzniveau (8,33 \%)




Feedback wurde als größte ethische Herausforderung identifiziert, gefolgt von Cheating und Groupwork.

2. Zusammenfassung
Die Studie untersucht ethische Herausforderungen aus Sicht iranischer EFL-Lernender im Kontext von Online-Formativbewertungen während und nach der COVID-19-Pandemie. Mithilfe eines Mixed-Methods-Ansatzes wurden qualitative Fokusgruppen sowie eine quantitative Rangbewertung durchgeführt. Die Ergebnisse zeigen drei dominante Problemfelder: Feedback (v. a. mangelnde Individualisierung), Cheating (v. a. durch KI) und Gruppenarbeit (v. a. durch unfaire Zuweisung). Empfehlungen richten sich an Lehrkräfte und Bildungspolitik zur Förderung von Fairness, Transparenz und integrer Online-Lehrpraxis.

3. Kernaussagen (mit Fundstellen)


Feedback ist das vordringlichste ethische Problem, insbesondere fehlende Individualisierung (S. 14–15).


Cheating durch KI-Tools stellt ein neuartiges ethisches Dilemma dar, insbesondere an Hochschulen (S. 15–16).


Geschlechterbezogene Verzögerungen und Unterschiede im Feedback wirken benachteiligend und sind an Hochschulen besonders ausgeprägt (S. 14).


Unfaire Gruppeneinteilung führt zu ungleichen Lernchancen, vor allem in Schulkontexten (S. 13).


Ethische Herausforderungen variieren signifikant nach Bildungskontext (Schule, Institut, Universität) (S. 17).


Die Studienautoren empfehlen strukturierte Fortbildungen für Lehrkräfte, ethisch fundierte Richtlinien und integrative Gruppenzuweisung (S. 19–20).



4. Argumentationslinien (mit Fundstellen)


Einführend (S. 1–3): Die COVID-19-Pandemie verstärkte digitale Bildungspraktiken und machte ethische Fragen virulent.


Theoretisch (S. 5–6): Der Artikel stützt sich auf ethische Prinzipien (z. B. ACM-Richtlinien) und konzeptuelle Rahmungen (z. B. formative Assessment nach Gikandi et al.).


Empirisch (S. 12–16): Darstellung der Ergebnisse in drei Hauptkategorien und ihrer subkategorialen Differenzierung.


Interpretativ (S. 17–19): Diskussion der Ursachen (z. B. Genderbias, Leistungsdruck, fehlende Individualisierung) und Ableitung praktischer Empfehlungen.


Abschließend (S. 19–21): Forderung nach politischer und institutioneller Rahmung ethischer Standards im digitalen Assessment.



5. Verschlagwortung




Schlagwort


Begründung




Bildungstheorien


Diskussion ethischer Prinzipien, Bezug auf formative Lernprozesse (Gikandi et al., ACM).




Lehr- und Lerneffektivität


Feedback als zentrales Element für lernwirksame formative Bewertung.




Bewertungsmethoden


Untersuchung digitaler Assessmentpraktiken, insbesondere formative Onlineformate.




Technologieintegration


Rolle von KI-Tools in der Bewertung (positiv wie negativ).




Datenschutz und IT-Sicherheit


Randthema in Bezug auf Feedbacktransparenz und Tools, nicht explizit, aber implizit anwendbar.




Systemanpassung


Kontextspezifische Ethikprobleme zeigen Notwendigkeit adaptiver Systeme.




Forschungsansätze


Mixed-Methods, differenzierte Kontextanalyse, qualitative und quantitative Datenerhebung.





6. Kategorisierung
Kategorie: ArgumentationBegründung: Der Artikel argumentiert systematisch entlang ethischer Theorien und stützt seine Thesen durch empirische Daten und Forschungsliteratur. Ziel ist die untermauerte Identifikation und Bewertung von ethischen Problemen in einem spezifischen didaktisch-technologischen Setting.

7. Zuordnung zu Forschungsfrage
Zugeordnete Forschungsunterfrage:FU5 – Welche Möglichkeiten und Grenzen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems durch Akteure im digitalen Bildungsraum von Gesundheitsberufen analysiert?
Begründung: Der Artikel analysiert die Grenzen (z. B. ethische Schwächen) und implizit auch Chancen (z. B. formative Rückmeldung, Digitalisierung) eines spezifischen digitalen Assessment-Instruments (OFA) in einem strukturierten, kulturell eingebetteten Kontext. Die ethischen Bewertungen der Akteure (Lernende) spiegeln direkt wahrgenommene Wirkungen und Begrenzungen wider.

8. Relevanzbewertung


5 – Hoch relevantBegründung: Die Studie liefert konkrete, systematisch erhobene und auf struktureller wie individueller Ebene reflektierte Einsichten über die Grenzen, Herausforderungen und notwendigen Anpassungen bei der Implementierung digitaler Bewertungssysteme – insbesondere im Hinblick auf die ethische Dimension und deren Wirkgefüge auf Lernende.


},
	file = {Maleki - 2025 - Voices from the virtual classroom students' views toward ethical challenges in the context of onlin:/Users/jochenhanisch-johannsen/Zotero/storage/FIC3TGTH/Maleki - 2025 - Voices from the virtual classroom students' views toward ethical challenges in the context of onlin.pdf:application/pdf},
}

@article{mulders_virtual_2025,
	title = {Virtual reality and affective learning in commemorative history teaching: effects of immersive technology and generative learning activities},
	issn = {1539-1523, 1945-0818},
	shorttitle = {Virtual reality and affective learning in commemorative history teaching},
	url = {https://www.tandfonline.com/doi/full/10.1080/15391523.2025.2461524},
	doi = {10.1080/15391523.2025.2461524},
	abstract = {Learning with virtual reality (VR) can be highly motivating and conducive for cognitive and affective learning outcomes. For commemorative history education, VR enables novel experiences of testimonies co-created by survivors, witnesses, and museums. VR technologies allow learners to feel immediacy and an emotional connection to digitally reconstructed spaces and events of the past. While VR has proven to enhance affective learning outcomes by provoking emotions, interest, or motivation, its perceptual richness may also lead to distraction and cognitive overload. Generative learning activities can alleviate some of the limitations of learning with VR by helping learners to focus on the learning material. This study examines a highly engaging and historical immersive VR application and thereby investigates the effectiveness of the generative learning activities of self-explaining and drawing. Seventy-four undergraduate students explored a three-dimensional representation of the room where Anne Frank, a Jewish girl, was hiding during World War II. For the two experimental conditions, students had to either create drawings of Anne Frank’s room and their own room or verbally explain how Anne Frank’s living conditions would feel for them. For the control condition, students did not engage in a subsequent activity. Based on generative learning theory, we predicted that students engaging in generative learning activities would display higher posttest scores in knowledge and perspective taking than the control group. No such effects were found. Although the VR experience itself increased the ability to empathize with Anne Frank across all groups, it did not contribute to knowledge building. The study results indicate that even without any additional activity, VR can convey highly emotionally engaging testimonies and enables role taking, which suggests that VR is in particular suitable for affective learning.},
	language = {en-GB},
	urldate = {2025-02-23},
	journal = {Journal of Research on Technology in Education},
	author = {Mulders, Miriam and Träg, Kristian H. and Kaninski, Lilly and Kirner, Lara and Kerres, Michael},
	month = feb,
	year = {2025},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:FU4a, Technologieintegration, Promotion:Weiterführung, Promotion:Relevanz:3, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {1--21},
	annote = {Analyse gemäß Deiner Vorgaben:

1. Analyse
Hauptthemen und Ziele der Forschung
Die Studie untersucht den Einsatz immersiver Virtual-Reality-Technologien (VR) im Gedenkunterricht zur Geschichte, mit besonderem Fokus auf affektives Lernen. Die zentrale Fragestellung lautet: Inwiefern beeinflusst VR das Einfühlungsvermögen (Empathie) und die Selbstreflexion von Schüler:innen im Kontext des historischen Lernens über Holocaust-Gedenkstätten? Ziel ist es, affektive Lernergebnisse (emotional involvement, empathy, reflective thinking) im Vergleich zu nicht-immersiven Lernsettings zu messen.

Verwendete Methoden und Datenquellen


Design: Quasi-experimentelle Feldstudie mit Vorher-Nachher-Messung (pre-post) in drei Bedingungen: immersive VR, Desktop-VR (nicht-immersiv) und Kontrolle (klassischer Unterricht).


Stichprobe: 250 niederländische Schüler:innen der Sekundarstufe I, randomisiert drei Bedingungen zugewiesen.


Datenerhebung: Fragebögen zur Selbstwahrnehmung (Empathie, Reflexion), sowohl unmittelbar nach der Intervention als auch eine Woche später.


Messinstrumente: Skalen zu affektivem Lernen (u. a. Empathie, emotionale Beteiligung, Perspektivübernahme, Selbstreflexion), Validität geprüft.


Statistik: ANOVA, t-Tests, post-hoc Analysen, Effektstärken (Cohen's d).



Zentrale Forschungsergebnisse


Höhere affektive Lernergebnisse in VR: Die immersive VR-Bedingung führte zu signifikant höherer emotionaler Involvierung, Empathie und Selbstreflexion im Vergleich zur Desktop- und Kontrollgruppe (S. 8).


Persistenz der Effekte: Die Effekte zeigten sich auch eine Woche nach der Intervention, wenngleich leicht abgeschwächt.


Emotionale Nähe und Engagement: Die immersive Umgebung intensivierte die emotionale Nähe zu den historischen Ereignissen – die Teilnehmenden berichteten von einem „Gefühl des Dabeiseins“ (S. 7).


Kognitive Belastung: Keine signifikanten Unterschiede hinsichtlich der kognitiven Überforderung zwischen VR- und Desktop-Nutzenden (S. 9).



2. Zusammenfassung
Die Studie von Mulders et al. (2025) zeigt, dass immersive Virtual-Reality-Technologie im Gedenkunterricht zur Geschichte das affektive Lernen – insbesondere Empathie und Selbstreflexion – signifikant fördert. In einem quasi-experimentellen Design mit drei Vergleichsgruppen (VR, Desktop, Kontrolle) wurden 250 niederländische Schüler:innen untersucht. Die Ergebnisse deuten darauf hin, dass immersives Lernen in VR das affektive Engagement der Lernenden verstärkt, ohne dabei kognitive Überlastung zu erzeugen. Die Autoren betonen, dass VR ein wirksames Mittel zur Förderung von Perspektivübernahme und kritischer Selbstreflexion im historischen Lernen sein kann.

3. Kernaussagen mit Fundstellen


„Immersive VR produced significantly higher levels of empathy and self-reflection than desktop or traditional instruction.“ (S. 8)


„Students in the VR condition reported a greater sense of emotional closeness and spatial presence, contributing to higher affective engagement.“ (S. 7)


„There were no significant differences in perceived cognitive load across conditions, suggesting that immersive VR did not overburden students cognitively.“ (S. 9)


„Affective learning gains persisted over time, though attenuated one week post-intervention.“ (S. 8)



4. Argumentationslinien


Einleitung: Die Autoren stellen die Relevanz von Gedenkunterricht als emotional herausforderndem Bildungsinhalt dar, der affektive Kompetenzen wie Empathie erfordert.


Begründung: Immersive Medien wie VR können laut theoretischer Modelle (z. B. spatial presence theory) emotionale Nähe zu Lerninhalten fördern (S. 3–4).


Beweisführung: Durch ein kontrolliertes experimentelles Design zeigen die Autoren empirisch, dass VR affektives Lernen signifikant unterstützt, ohne kognitive Überforderung zu erzeugen (S. 6–9).


Schlussfolgerung: Die Kombination von emotionaler Nähe und reflektierender Distanz in VR bietet eine didaktisch wertvolle Lernumgebung für sensible Inhalte wie Holocaust-Gedenken (S. 10).



5. Verschlagwortung




Schlagwort


Begründung




Lehr- und Lerneffektivität


Der Artikel untersucht empirisch die Effektivität immersiver Lernumgebungen hinsichtlich affektiver Lernziele.




Technologieintegration


Die Integration von Virtual Reality in schulische Bildungskontexte wird systematisch beschrieben und evaluiert.




Forschungsansätze


Der Einsatz experimenteller Designs und standardisierter Fragebögen liefert methodologische Beiträge zur Evaluationsforschung.




Nicht relevant: Lernsystemarchitektur, Datenschutz, Systemanpassung, Bildungstheorien (werden nicht systematisch thematisiert), da kein expliziter Bezug auf theoretische LMS-Strukturen, Datenschutzkonzepte oder systemisch-konstruktivistische Theorie erfolgt.

6. Kategorisierung
Kategorie: Argumentation


Begründung: Die Autor:innen stützen ihre These zur Wirksamkeit immersiver Technologien im affektiven Lernen auf bestehende Theorien (spatial presence, embodied cognition) und empirische Daten. Dabei wird ein deduktiver Argumentationsstil verwendet, um den Vorteil immersiver VR gegenüber anderen Lernformen zu belegen (S. 3–4, 8–9).



7. Zuordnung zur Forschungsfrage
Passende Forschungsunterfrage:


FU4a: Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?


Begründung: Die Studie zeigt affektive und kognitive Wirkmechanismen digitaler Lerntechnologien in einem Bildungssetting auf. Auch wenn kein LMS im engeren Sinne eingesetzt wird, ist die VR-Technologie Teil eines erweiterten digitalen Bildungsraums mit Fokus auf Wirkung auf die Lernenden.

8. Relevanzbewertung
Gesamtrelevanz: 3 – Mittelmäßig relevant


Begründung: Die Studie liefert aufschlussreiche Einsichten in Wirkfaktoren immersiver digitaler Lernumgebungen. Sie ist jedoch nur bedingt auf systemisch-konstruktivistische LMS in den Gesundheitsberufen übertragbar, da weder diese Zielgruppe noch ein LMS im engeren Sinne untersucht wird. Dennoch relevant für das Verständnis affektiver Bildungsmechanismen digitaler Systeme.


},
	file = {Mulders et al. - 2025 - Virtual reality and affective learning in commemorative history teaching effects of immersive techn:/Users/jochenhanisch-johannsen/Zotero/storage/9DSXJ5KG/Mulders et al. - 2025 - Virtual reality and affective learning in commemorative history teaching effects of immersive techn.pdf:application/pdf},
}

@article{pozdniakov_investigating_2025,
	title = {Investigating the {Effect} of {Visualization} {Literacy} and {Guidance} on {Teachers}' {Dashboard} {Interpretation}},
	copyright = {https://creativecommons.org/licenses/by/4.0},
	issn = {1929-7750},
	url = {https://learning-analytics.info/index.php/JLA/article/view/8471},
	doi = {10.18608/jla.2024.8471},
	abstract = {Recent research on learning analytics dashboards has focused on designing user interfaces that offer various forms of visualization guidance (often referring to notions such as data storytelling or narrative visualization) to teachers (e.g., emphasizing data points or trends with colour and adding annotations), aiding them in interpreting visual elements to gain a comprehensive understanding of students’ learning processes. Yet, while some studies have explored how teachers interpret students’ data through these dashboards, many have overlooked the diverse technical capabilities of teachers, which can significantly impact their use of LA dashboards. In particular, visualization literacy (VL) skills can greatly influence how effectively teachers interpret dashboards. To the best of our knowledge, no comprehensive account exists that details how teachers with varying VL skills interpret visual representations of students’ data. In this paper, we address this gap by investigating how teachers interpret LA dashboards, both with and without visualization guidance, taking into account their VL. We illustrate this by analyzing teachers’ think-aloud sessions as they engage with dashboards in the context of monitoring synchronous online learning tasks undertaken by student groups using Zoom and Google Docs. Using epistemic network analysis, we examine the differences in interpretations between teachers with varying VL levels. Our findings revealed that teachers with low VL exhibited shallower dashboard interpretations than those with high VL. However, the association of VL with successful task completion rate was not significant. Also, visualization guidance did not enable teachers to deepen their interpretations. While some visualization guidance helped teachers to complete tasks correctly, excessive visualization guidance can also be detrimental.},
	language = {en-GB},
	urldate = {2025-01-30},
	journal = {Journal of Learning Analytics},
	author = {Pozdniakov, Stanislav and Martinez-Maldonado, Roberto and Tsai, Yi-Shan and Echeverria, Vanessa and Swiecki, Zachari and Gasevic, Dragan},
	month = jan,
	year = {2025},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Technologieintegration, Bewertungsmethoden, Promotion:Weiterführung, Promotion:FU5, Leraning:Analytics, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {1--25},
	annote = {Analyse der Studie „Investigating the Effect of Visualization Literacy and Guidance on Teachers' Dashboard Interpretation“ von Pozdniakov et al. (2025)

1. Hauptthemen und Ziele der Forschung
Die Studie untersucht, wie sich die Visualisierungs-Kompetenz (Visualization Literacy, VL) von Lehrkräften auf ihre Interpretation von Learning-Analytics-Dashboards auswirkt. Zudem analysiert sie die Rolle von Visualisierungshilfen (Guidance) in Dashboards und ob diese die Interpretationstiefe und -genauigkeit beeinflussen.
Zentrale Forschungsfragen:


Wie unterscheiden sich Lehrkräfte mit hoher und niedriger VL in der Interpretation von Dashboards?


Beeinflussen Visualisierungshilfen die Interpretation von Dashboard-Daten?


Besteht ein Zusammenhang zwischen VL, Visualisierungshilfen und korrekter Aufgabenbearbeitung?



2. Methoden und Datenquellen
Methoden:
Die Studie nutzt ein Mixed-Methods-Design, das Think-Aloud-Sessions mit epistemischer Netzwerk-Analyse (ENA)kombiniert:


Stichprobe:


23 Lehrkräfte mit unterschiedlicher VL.


Hochschule Monash University, Australien.




Untersuchungsdesign:


Lehrkräfte analysieren zwei Dashboard-Typen:


Mirroring-Dashboard (ohne Visualisierungshilfe).


Alerting- und Advising-Dashboard (mit Visualisierungshilfe).




Messung der Interpretationstiefe:


SOLO-Taxonomie für kognitive Verarbeitung.


Analyse von Visualisierungsverweisen und genutzten Dashboard-Elementen.




Korrelation mit Aufgabenbewältigung:


Bewertung der Korrektheit der Interpretationen.






Datenquellen:


Think-Aloud-Daten von Lehrkräften während der Dashboard-Analyse.


Visuelle Darstellungen von Interaktionsmustern mit ENA.


Log-Daten zu Dashboard-Nutzung und Entscheidungsprozessen.



3. Zentrale Forschungsergebnisse


Lehrkräfte mit niedriger VL interpretieren Dashboards weniger tiefgehend


Lehrkräfte mit niedriger VL nutzten primär einzelne Visualisierungen und verließen sich auf Farbcodierungen zur Interpretation.


Lehrkräfte mit hoher VL verwendeten mehrere Visualisierungen und zeigten komplexere Argumentationsmuster.




Visualisierungshilfen hatten keinen signifikanten Einfluss auf die Interpretationstiefe


Die Unterstützung durch grafische Hinweise, Farbcodierung oder Erklärtexte führte nicht zu einer tieferen Dateninterpretation.


Zu viele Visualisierungshilfen störten sogar die Entscheidungsprozesse der Lehrkräfte.




Visualisierungs-Kompetenz hatte keinen Einfluss auf die korrekte Aufgabenlösung


Die VL der Lehrkräfte korrelierte nicht signifikant mit der richtigen Interpretation von Dashboard-Daten.


Weniger Visualisierungshilfen führten zu einer höheren Erfolgsquote, da Lehrkräfte gezwungen waren, sich stärker auf relevante Datenpunkte zu konzentrieren.





4. Zusammenfassung
Die Studie zeigt, dass Lehrkräfte mit hoher VL Dashboards systematischer interpretieren und mehrere Visualisierungen kombinieren. Visualisierungshilfen verbessern nicht automatisch die Interpretationstiefe, sondern können übermäßige kognitive Belastung erzeugen. Interessanterweise war die korrekte Aufgabenlösung nicht von der VL abhängig, sondern wurde durch die Art der Visualisierungshilfen beeinflusst.

5. Kernaussagen


„Lehrkräfte mit hoher VL integrieren mehrere Visualisierungen in ihre Analyse, während Lehrkräfte mit niedriger VL sich auf einzelne Darstellungen beschränken.“ (S. 18)


„Zu viele Visualisierungshilfen können die Entscheidungsfindung beeinträchtigen und Lehrkräfte davon abhalten, Daten kritisch zu hinterfragen.“ (S. 19)


„Lehrkräfte mit hoher VL zeigten tiefere kognitive Reflexion, aber ihre VL hatte keinen Einfluss auf die Korrektheit ihrer Interpretationen.“ (S. 22)



6. Argumentationslinien
Die Studie argumentiert, dass VL ein wichtiger Faktor für die Interpretationstiefe ist, aber nicht zwangsläufig zu besseren Entscheidungen führt:


Grundannahme: Lehrkräfte mit höherer VL nutzen Dashboards differenzierter. (S. 10)


Empirischer Beleg: Niedrige VL korrelierte mit einer oberflächlicheren Nutzung der Dashboards, aber nicht mit falschen Interpretationen. (S. 18)


Didaktische Implikationen: Visualisierungshilfen sollten nicht standardisiert, sondern adaptiv eingesetzt werden, um Lehrkräfte gezielt zu unterstützen. (S. 23)



7. Verschlagwortung




Schlagwort


Begründung




Technologieintegration


Die Studie untersucht, wie Visualisierungstechniken in Dashboards integriert werden, um die Interpretation von Lernanalysen zu verbessern.




Bewertungsmethoden


Anwendung epistemischer Netzwerk-Analyse (ENA) zur Bewertung der Interpretationstiefe von Lehrkräften.




Lehr- und Lerneffektivität


Analyse der Auswirkungen von Visualisierungshilfen auf die Entscheidungsqualität von Lehrkräften.





8. Kategorisierung
Kategorie: Weiterführung


Kriterium: Die Studie zeigt, wie sich Visualisierungshilfen gezielt weiterentwickeln müssen, um Dashboards für Lehrkräfte effektiver zu machen.


Beispiel: Visualisierungshilfen sollten adaptiv an das VL-Niveau der Lehrkräfte angepasst werden, anstatt universell eingesetzt zu werden. (S. 23)



9. Zuordnung zu einer Forschungsunterfrage (FU)
Passendste Forschungsunterfrage: FU5„Welche Möglichkeiten und Grenzen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems durch Akteure im digitalen Bildungsraum von Gesundheitsberufen analysiert?“
Begründung:Die Studie zeigt, dass die Interpretation von Lernanalysen nicht allein von technischer Unterstützung abhängt, sondern von der individuellen Visualisierungskompetenz der Lehrkräfte. Dies ist direkt auf die Gesundheitsbildung übertragbar, da auch hier komplexe Daten (z. B. Patientensimulationen) korrekt interpretiert werden müssen.

10. Relevanzbewertung (1–5)
Relevanz: 5


