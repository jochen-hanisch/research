@article{zakaria_intelligent_2022,
	title = {Intelligent {System} for {Personalised} {Interventions} and {Early} {Drop}-out {Prediction} in {MOOCs}},
	volume = {13},
	issn = {21565570, 2158107X},
	url = {http://thesai.org/Publications/ViewPaper?Volume=13&Issue=9&Code=IJACSA&SerialNo=83},
	doi = {10/grw337},
	abstract = {In this paper, we propose an approach to early detect students at high risk of drop-out in MOOC (Massive Open Online Course); we design personalised interventions to mitigate that risk. We apply Machine Learning (ML) algorithms and data mining techniques to a dataset extracted from XuetangX MOOC learning platforms and sourced from the KDD cup 2015. Since this dataset contains only raw student log activity records, we perform a hybrid feature selection and dimensionality reduction techniques to extract relevant features, and reduce models complexity and computation time. Besides, we built two models based on: Genetic Algorithms (GA) and Deep Learning (DL) with supervised learning methods. The obtained results, according to the accuracy and the AUC (Area Under Curve)-ROC (Reciever Operator Characteristic) metrics, prove the pertinence of the extracted features and encourage the use of the hybrid features selection. They also proved that GA and DL are outperforming the baseline algorithms used in related works. To assess the generalisation of the approach used in this work, The same process is performed to a second benchmark dataset extracted from the university MOOC. Then, a single web application hosted on the university server, produces an individual weekly drop-out probability, using time series data. It also proposes an approach to personalise and prioritise interventions for at-risk students according to the drop-out patterns.},
	language = {en-GB},
	number = {9},
	urldate = {2023-03-12},
	journal = {International Journal of Advanced Computer Science and Applications},
	author = {Zakaria, Alj and Anas, Bouayad and Oucamah, Cherkaoui Malki Mohammed},
	year = {2022},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Bewertungsmethoden, Promotion:FU6, \#4:Zeitschriftenartikel:MOOC, Promotion:S:04 MOOC, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU6},
	annote = {Analyse der Studie "Intelligent System for Personalised Interventions and Early Drop-out Prediction in MOOCs" von Zakaria et al. (2022)
Hauptthemen und Ziele der Forschung:
Die Studie von Zakaria et al. (2022) zielt darauf ab, ein intelligentes System zur Früherkennung von Abbrechern in MOOCs zu entwickeln und personalisierte Interventionen zu entwerfen, um das Abbruchrisiko zu minimieren. Die Autoren verwenden Machine Learning (ML) Algorithmen und Data Mining Techniken auf einem Datensatz von der XuetangX MOOC Plattform, der aus dem KDD Cup 2015 stammt. Ziel ist es, relevante Merkmale zu extrahieren, die Komplexität der Modelle zu reduzieren und die Berechnungszeit zu minimieren, um effektive personalisierte Interventionen bereitzustellen (S. 700-701).
Methoden und Datenquellen:
Die Studie verwendet zwei Modelle basierend auf genetischen Algorithmen (GA) und Deep Learning (DL) mit überwachten Lernmethoden. Die Autoren verwenden Hybrid-Feature-Selektion und Dimensionalitätsreduktionstechniken, um relevante Merkmale zu extrahieren und die Modelle zu optimieren. Die Datensätze umfassen Protokolle von 79.186 Studenten und 120.543 Einschreibungen. Der Datensatz wurde hinsichtlich des Klassenungleichgewichts behandelt, indem die Minderheitsklasse durch Methoden wie SMOTE (Synthetic Minority Oversampling Technique) aufgestockt wurde (S. 702-703).
Zentrale Forschungsergebnisse:


Prädiktive Genauigkeit: Die entwickelten Modelle (GA und DL) zeigten hohe Genauigkeit und AUC (Area Under Curve) ROC-Werte. Die Genauigkeit der GA-Modelle betrug 92,6 \% mit allen Merkmalen und 93,3 \% mit ausgewählten Merkmalen. Die DL-Modelle erreichten 94,3 \% Genauigkeit mit allen Merkmalen und 93,8 \% mit ausgewählten Merkmalen (S. 706).


Relevanz der Merkmalsextraktion: Die Hybrid-Feature-Selektion erwies sich als effektiv bei der Reduzierung der Datensatzdimension, ohne die Vorhersagegenauigkeit signifikant zu beeinträchtigen. Die relevanten Merkmale umfassten die Anzahl der erfolgreich abgeschlossenen Einschreibungen, die Anzahl der Protokolle für das aktuelle Einschreiben und die Anzahl der aktiven Minuten (S. 703-704).


Personalisierte Interventionen: Das System konnte wöchentliche Drop-out-Wahrscheinlichkeiten für individuelle Studenten berechnen und personalisierte Interventionen basierend auf den Drop-out-Mustern vorschlagen. Diese personalisierten Interventionen trugen zur Reduzierung der Abbruchquoten bei (S. 707-708).


Zusammenfassung
Die Studie zeigt, dass ein intelligentes System zur Früherkennung von Abbrechern in MOOCs mithilfe von ML-Algorithmen und Data Mining-Techniken effektiv entwickelt werden kann. Die Verwendung von genetischen Algorithmen und Deep Learning führte zu hoher Vorhersagegenauigkeit und ermöglichte personalisierte Interventionen, die das Abbruchrisiko verringerten.
Kernaussagen


Prädiktive Genauigkeit: Die GA- und DL-Modelle erreichten hohe Genauigkeits- und AUC-ROC-Werte, was ihre Effektivität bei der Vorhersage von Drop-out-Risiken zeigt (S. 706).


Effektive Merkmalsextraktion: Die Hybrid-Feature-Selektion reduzierte die Datensatzdimension, ohne die Vorhersagegenauigkeit zu beeinträchtigen (S. 703-704).


Personalisierte Interventionen: Das System ermöglichte die Bereitstellung personalisierter Interventionen basierend auf den spezifischen Drop-out-Mustern der Studenten (S. 707-708).


Argumentationslinien
Die Autoren argumentieren, dass die Verwendung von genetischen Algorithmen und Deep Learning in Verbindung mit Hybrid-Feature-Selektion eine effektive Methode zur Früherkennung von Abbrechern und zur Bereitstellung personalisierter Interventionen in MOOCs darstellt. Die Studie zeigt, dass diese Ansätze das Potenzial haben, die Abbruchquoten signifikant zu reduzieren und die Lernergebnisse zu verbessern (S. 708).
Verschlagwortung
Passendste Schlagworte und Begründungen:


Technologieintegration: Die Studie untersucht die Integration von ML-Algorithmen und Data Mining-Techniken in die MOOC-Plattform, um Drop-out-Risiken vorherzusagen und Interventionen bereitzustellen (S. 700-701).


Lehr- und Lerneffektivität: Die personalisierten Interventionen tragen zur Verbesserung der Lehr- und Lerneffektivität bei, indem sie das Abbruchrisiko verringern (S. 707-708).


Bewertungsmethoden: Die Verwendung von genetischen Algorithmen und Deep Learning zur Vorhersage von Drop-outs und zur Bewertung der Effektivität von Interventionen stellt eine innovative Bewertungsmethode dar (S. 706).


Kategorisierung


Kerngedanke: Die Studie präsentiert die zentrale Idee der Entwicklung eines intelligenten Systems zur Früherkennung von Abbrechern und zur Bereitstellung personalisierter Interventionen in MOOCs (S. 700).


Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU2a: Effekt-Faktoren für Lernende im digitalen Bildungsraum.


Begründung: Die Studie analysiert die Effekte von prädiktiven Modellen und personalisierten Interventionen auf die Lernenden, was direkt die Frage nach den Effekt-Faktoren für Lernende im digitalen Bildungsraum betrifft (S. 707-708).
Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie untersucht umfassend die Vorhersage von Drop-outs und die Bereitstellung personalisierter Interventionen in MOOCs).


Zitierhäufigkeit und Einfluss: 4 (Die Studie ist umfassend und gut zitiert).


Aktualität: 5 (Die Studie ist von 2022 und behandelt ein aktuelles Thema).


Gesamtbewertung: 4.7
Schlussfolgerung
Die Studie zeigt, dass ein intelligentes System zur Früherkennung von Abbrechern in MOOCs mithilfe von genetischen Algorithmen und Deep Learning effektiv entwickelt werden kann. Durch die Bereitstellung personalisierter Interventionen kann das Abbruchrisiko signifikant reduziert und die Lernergebnisse verbessert werden. Die Ergebnisse bieten wertvolle Einblicke und Empfehlungen für die zukünftige Gestaltung und Implementierung solcher Systeme in der digitalen Bildung.
},
	file = {Zakaria et al. - 2022 - Intelligent System for Personalised Interventions .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/PJ9K9JYF/Zakaria et al. - 2022 - Intelligent System for Personalised Interventions .pdf:application/pdf},
}

@article{hofler_imoox_2022,
	title = {{iMooX}: mehr als eine {MOOC}-{Plattform}},
	language = {de-DE},
	number = {11},
	journal = {Lernen in der digitalen Welt},
	author = {Höfler, Elke},
	year = {2022},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Systemanpassung, Promotion:Relevanz:4, Promotion:FU3, \#4:Zeitschriftenartikel:MOOC, Promotion:S:04 MOOC, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {26--27},
	annote = {Analyse des Artikels "iMooX: mehr als eine MOOC-Plattform" von Elke Höfler (2022)
Hauptthemen und Ziele der Forschung:
Der Artikel von Elke Höfler (2022) beschreibt die österreichische MOOC-Plattform iMooX, die 2014 ins Leben gerufen wurde. Das Hauptziel des Artikels ist es, die Funktionalitäten und Vorteile von iMooX hervorzuheben und zu erläutern, wie diese Plattform zur Personalisierung und Demokratisierung der Bildung beiträgt. Der Artikel untersucht, wie iMooX als personalisierbare Lernumgebung genutzt werden kann und welche spezifischen Bildungsbedarfe sie adressiert (S. 26-27).
Methoden und Datenquellen:
Der Artikel stützt sich auf eine Literaturübersicht und Erfahrungsberichte zur Funktionalität und Nutzung von iMooX. Es werden verschiedene Lehr- und Lernszenarien beschrieben, in denen iMooX zum Einsatz kommt. Zusätzlich werden die Vorteile von MOOCs im Allgemeinen und deren spezifische Implementierung auf iMooX diskutiert, um die Wirksamkeit und Akzeptanz dieser Plattform zu beleuchten (S. 27).
Zentrale Forschungsergebnisse:


Personalisierung der Bildung: iMooX bietet eine flexible und anpassbare Lernumgebung, die es den Lernenden ermöglicht, Lernmaterialien nach ihren individuellen Bedürfnissen zu nutzen. Die Plattform fördert orts- und zeitunabhängiges Lernen und unterstützt die Entwicklung von personalisierten Lernnetzwerken (S. 26).


Vielfältige Lehr- und Lernszenarien: Die Plattform kann in verschiedenen Bildungsbereichen, von der Primarstufe über die Sekundarstufe bis zur Erwachsenenbildung, effektiv genutzt werden. Szenarien wie Blended Learning und Flipped Classroom werden durch die Integration von MOOCs unterstützt (S. 26-27).


Multimodale Lernangebote: iMooX bietet eine Vielzahl von Lernmaterialien, darunter Videos, Animationen, Präsentationen und Selbsttests, die barrierefrei zugänglich sind. Diese Multimodalität fördert die Interaktivität und das Engagement der Lernenden (S. 27).


Zusammenfassung
Der Artikel von Elke Höfler beschreibt die österreichische MOOC-Plattform iMooX und ihre Rolle bei der Personalisierung und Demokratisierung der Bildung. Die Plattform bietet flexible und anpassbare Lernumgebungen und unterstützt vielfältige Lehr- und Lernszenarien durch den Einsatz von multimodalen Lernmaterialien.
Kernaussagen


Personalisierung der Bildung: iMooX ermöglicht orts- und zeitunabhängiges Lernen und unterstützt die Entwicklung von personalisierten Lernnetzwerken (S. 26).


Vielfältige Lehr- und Lernszenarien: Die Plattform wird in verschiedenen Bildungsbereichen genutzt und unterstützt Szenarien wie Blended Learning und Flipped Classroom (S. 26-27).


Multimodale Lernangebote: iMooX bietet eine Vielzahl von barrierefreien Lernmaterialien, die die Interaktivität und das Engagement der Lernenden fördern (S. 27).


Argumentationslinien
Die Autorin argumentiert, dass iMooX durch die Bereitstellung flexibler und anpassbarer Lernumgebungen signifikante Vorteile für die Personalisierung und Demokratisierung der Bildung bietet. Sie betont die Rolle der Plattform bei der Unterstützung verschiedener Lehr- und Lernszenarien und die Bedeutung der Multimodalität der Lernangebote für die Förderung des Engagements und der Interaktivität der Lernenden (S. 26-27).
Verschlagwortung
Passendste Schlagworte und Begründungen:


Technologieintegration: Der Artikel diskutiert die Integration von MOOCs in verschiedene Bildungsbereiche und deren Beitrag zur Personalisierung und Demokratisierung der Bildung (S. 26-27).


Lehr- und Lerneffektivität: Die beschriebenen Lehr- und Lernszenarien und die Nutzung multimodaler Lernmaterialien zeigen die Effektivität von iMooX bei der Unterstützung des Lernprozesses (S. 26-27).


Systemanpassung: Die Flexibilität und Anpassungsfähigkeit von iMooX an die individuellen Bedürfnisse der Lernenden wird hervorgehoben (S. 26).


Kategorisierung


Kerngedanke: Die zentrale Idee des Artikels ist die Darstellung von iMooX als eine Plattform, die durch die Integration von MOOCs zur Personalisierung und Demokratisierung der Bildung beiträgt und vielfältige Lehr- und Lernszenarien unterstützt (S. 26-27).


Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU3: Konzeption und Merkmale des LMS.


Begründung: Der Artikel beschreibt die Konzeption und spezifischen Merkmale der MOOC-Plattform iMooX, die zur Personalisierung und Demokratisierung der Bildung beitragen und vielfältige Lehr- und Lernszenarien unterstützen (S. 26-27).
Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Der Artikel untersucht umfassend die Konzeption und Merkmale von iMooX und deren Beitrag zur Personalisierung und Demokratisierung der Bildung).


Zitierhäufigkeit und Einfluss: 4 (Der Artikel basiert auf umfassender Literatur und Erfahrungsberichten).


Aktualität: 5 (Der Artikel ist von 2022 und behandelt ein aktuelles Thema).


Gesamtbewertung: 4.7
Schlussfolgerung
Der Artikel zeigt, dass die MOOC-Plattform iMooX durch die Bereitstellung flexibler und anpassbarer Lernumgebungen und die Unterstützung vielfältiger Lehr- und Lernszenarien signifikante Vorteile für die Personalisierung und Demokratisierung der Bildung bietet. Die Ergebnisse bieten wertvolle Einblicke und Empfehlungen für die zukünftige Nutzung von MOOCs in verschiedenen Bildungsbereichen.
},
	file = {Höfler - iMooX mehr als eine MOOC-Plattform.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/QD7Z3ZCV/Höfler - iMooX mehr als eine MOOC-Plattform.pdf:application/pdf},
}

