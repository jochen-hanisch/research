@article{chathuranga_unveiling_2024,
	title = {Unveiling the perceived benefits of online learning among management undergraduates: a study in a {Sri} {Lankan} government-owned university},
	volume = {29},
	issn = {1360-2357, 1573-7608},
	shorttitle = {Unveiling the perceived benefits of online learning among management undergraduates},
	url = {https://link.springer.com/10.1007/s10639-023-12355-7},
	doi = {10.1007/s10639-023-12355-7},
	abstract = {The purpose of this study is to determine the benefits of online learning among undergraduate students at a specific university and to investigate whether there are any differences in perception based on gender. A total of 477 participants completed structured questionnaires, and descriptive statistics were used to analyze the data. The Mann-Whitney U test was used to test the hypotheses, which does not require normality or homogeneity of variance assumptions. Results suggest that online learning, particularly the use of recorded lectures, offers several benefits for management undergraduates, including improved learning outcomes, flexibility and control, and access to a wider range of learning resources. The study also found that there is no significant difference in perceived benefits between male and female management undergraduates. These findings highlight the potential of online learning to enhance student learning outcomes and improve education quality in management. To enhance the effectiveness of online learning, educators should focus on creating engaging and interactive courses that promote active learning and student engagement. Additionally, institutions should invest in educator training and support to ensure that they are equipped with the necessary skills and knowledge to deliver effective online courses.},
	language = {en-GB},
	number = {1},
	urldate = {2024-01-10},
	journal = {Education and Information Technologies},
	author = {Chathuranga, Nirmal and Dissanayake, Pasindu and Gunawardane, Naduni},
	month = jan,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Systemanpassung, Promotion:FU1, Promotion:S:11 Online Learning, Promotion:Dissertation {\textbar} FU1 {\textgreater} Kerngedanke, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU1},
	pages = {881--893},
	annote = {Analyse des wissenschaftlichen Artikels "Unveiling the Perceived Benefits of Online Learning Among Management Undergraduates: A Study in a Sri Lankan Government-Owned University" von Nirmal Chathuranga, Pasindu Dissanayake und Naduni Gunawardane (2024).
1. Analyse
Hauptthemen und Ziele der Forschung
Die Studie untersucht die wahrgenommenen Vorteile des Online-Lernens unter Studierenden eines Managementstudiengangs an einer sri-lankischen Universität. Ziel ist es, zu verstehen, wie Studierende die Vorteile von Online-Lernen wahrnehmen und ob es Unterschiede in diesen Wahrnehmungen zwischen männlichen und weiblichen Studierenden gibt. Ein weiteres Ziel ist es, herauszufinden, wie das Online-Lernen durch die Studierenden bewertet wird und ob diese Form des Lernens eine verbesserte Qualität der Ausbildung ermöglicht.
Methoden und Datenquellen
Die Studie folgt einem objektivistischen/positivistischen Forschungsansatz und nutzt ein querschnittliches Design mit quantitativer Methodik. Daten wurden durch strukturierte Fragebögen erhoben, die an 477 Studierende des Managementstudiengangs verteilt wurden. Die Auswahl der Teilnehmer erfolgte durch einfaches Zufallsstichprobenverfahren. Zur Analyse der Daten wurden deskriptive Statistiken verwendet, und Hypothesentests wurden mit dem Mann-Whitney-U-Test durchgeführt, einem nichtparametrischen Test, der keine Normalverteilung oder Homogenität der Varianz erfordert.
Zentrale Forschungsergebnisse


Vorteile von Online-Lernen: Die Studie zeigt, dass Online-Lernen insbesondere durch den Einsatz von aufgezeichneten Vorlesungen erhebliche Vorteile bietet. Diese umfassen verbesserte Lernergebnisse, Flexibilität und die Möglichkeit, auf eine Vielzahl von Lernressourcen zuzugreifen. (S. 882)


Geschlechterunterschiede: Es wurde festgestellt, dass es keinen signifikanten Unterschied in der Wahrnehmung der Vorteile des Online-Lernens zwischen männlichen und weiblichen Studierenden gibt. (S. 887)


Flexibilität und Komfort: Ein Großteil der Befragten stimmt zu, dass Online-Lernen durch die Verfügbarkeit von Vorlesungsaufzeichnungen jederzeit Flexibilität bietet und den Komfort erhöht, da das Lernen von zu Hause aus ohne frühes Aufstehen und Reisen möglich ist. (S. 886)


2. Zusammenfassung
Die Studie untersucht die wahrgenommenen Vorteile des Online-Lernens unter Managementstudierenden an einer sri-lankischen Universität. Die Ergebnisse zeigen, dass aufgezeichnete Vorlesungen signifikante Vorteile für das Lernen bieten, darunter Flexibilität, Zugänglichkeit und verbessertes Verständnis. Es wurden keine signifikanten geschlechtsspezifischen Unterschiede in der Wahrnehmung dieser Vorteile festgestellt. Die Ergebnisse unterstreichen das Potenzial des Online-Lernens, die Lernqualität und -ergebnisse in der Managementausbildung zu verbessern.
3. Kernaussagen


Nutzung von Vorlesungsaufzeichnungen: 60,6 \% der Befragten gaben an, dass aufgezeichnete Vorlesungen hilfreich für das Lernen und die Klärung von Inhalten sind. (S. 886)


Flexibilität und Zugänglichkeit: 51,8 \% der Befragten schätzen den Komfort, den das Lernen von zu Hause aus bietet, während 38,6 \% den Zugang zu Bildungsressourcen jederzeit als großen Vorteil ansehen. (S. 886)


Kein Geschlechterunterschied: Die Ergebnisse des Mann-Whitney-U-Tests zeigten, dass es keine signifikanten Unterschiede in den wahrgenommenen Vorteilen des Online-Lernens zwischen männlichen und weiblichen Studierenden gibt. (S. 887)


4. Argumentationslinien
Die Autoren argumentieren, dass Online-Lernen eine Vielzahl von Vorteilen bietet, insbesondere in Bezug auf Flexibilität und den Zugang zu Lernressourcen. Diese Vorteile können die Lernergebnisse verbessern, indem sie den Studierenden mehr Kontrolle über ihre Lernumgebung und ihren Zeitplan geben. Die Untersuchung zeigt, dass das Geschlecht keinen Einfluss auf die Wahrnehmung dieser Vorteile hat, was darauf hinweist, dass die Implementierung von Online-Lernmethoden universell vorteilhaft sein kann. (S. 886-887)
5. Verschlagwortung


Lehr- und Lerneffektivität: Die Untersuchung der Rolle von Online-Lernstrategien zur Steigerung der Lernleistung und Flexibilität.


Technologieintegration: Die Integration und Nutzung von aufgezeichneten Vorlesungen und digitalen Ressourcen zur Unterstützung des Lernens.


Systemanpassung: Anpassung von Online-Lernumgebungen, um den individuellen Lernbedürfnissen der Studierenden gerecht zu werden.


6. Kategorisierung
Kerngedanke: Die Studie untersucht, wie Online-Lernen durch die Nutzung digitaler Technologien signifikante Vorteile für Studierende bietet, insbesondere durch die Flexibilität und den einfachen Zugang zu Lernmaterialien. Sie zeigt, dass aufgezeichnete Vorlesungen die Lernergebnisse verbessern und eine flexible Lernumgebung schaffen. (S. 889)
7. Zuordnung zu Forschungsfragen
Passendste Forschungsunterfrage: FU1 - Welche Akzeptanz und Nützlichkeit (Bedeutung) beschreiben Akteure im digitalen Bildungsraum von Gesundheitsberufen bei Anwendung eines Learning-Management-Systems?
Begründung: Die Studie untersucht, wie Studierende die Vorteile des Online-Lernens wahrnehmen, was direkt mit der Akzeptanz und Nützlichkeit digitaler Lernsysteme zusammenhängt.
8. Einordnung der Relevanz
Relevanzbewertung: 5 - Hoch relevantDie Quelle liefert umfassende Erkenntnisse über die Vorteile des Online-Lernens und bietet wertvolle Implikationen für die Gestaltung und Implementierung effektiver Online-Lernumgebungen, die die Lernqualität und -ergebnisse verbessern können.
Diese strukturierte Analyse bietet einen tieferen Einblick in die Themen der Studie und zeigt deren Relevanz im Kontext der digitalen Bildung auf. Die Ergebnisse unterstreichen die Notwendigkeit, Online-Lernumgebungen zu gestalten, die Flexibilität, Zugänglichkeit und positive Lernergebnisse fördern.
},
	file = {Chathuranga et al. - 2024 - Unveiling the perceived benefits of online learnin.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/F9R5LG6A/Chathuranga et al. - 2024 - Unveiling the perceived benefits of online learnin.pdf:application/pdf},
}

@article{fidan_emotions_2024,
	title = {Emotions, metacognition and online learning readiness are powerful predictors of online student engagement: {A} moderated mediation analysis},
	volume = {29},
	issn = {1360-2357, 1573-7608},
	shorttitle = {Emotions, metacognition and online learning readiness are powerful predictors of online student engagement},
	url = {https://link.springer.com/10.1007/s10639-023-12259-6},
	doi = {10.1007/s10639-023-12259-6},
	abstract = {It is pointed out that one of the main problems of online learning environments is determining whether students engage or not. As engagement is a complex and multifaceted concept, researchers have stated that engagement is effected by many factors (environmental conditions and learner characteristics) and changes according to the context. Among these factors, discovering the effects of emotions experienced in learning processes on engagement has drawn attention recently. It is stated that there is an effect of emotions on engagement. However, the mechanisms underlying the effect of emotions experienced in online learning environment on student engagement have not yet been discovered, and what potential mediator and/or moderator variables might explain this effect. Therefore, this study aims to establish whether emotions predicted student engagement through their effect on the online learning readiness, and whether the strength of this effect was a function of metacognition. The study group includes 1601 university students. Data were gathered via online survey. The moderated mediation models were analyzed with PROCESS macro. The results displayed that emotions are powerful predictors of online learning readiness. Online readiness mediated the effect of emotions on student engagement in three models. Metacognition moderated the positive emotions and negative emotions model but did not moderate the exploratory emotions model. As a result; the direct effect of emotions on both readiness and engagement reveal the need for strategies to enable students to experience positive and exploratory emotions and to reduce negative emotions in learning environments. This study reveals that increasing students’ positive and exploratory emotions and reducing their negative emotions, ensuring their online learning readiness and high metacognition have an impact on online student engagement. Therefore, with the results of this study, it can be stated that taking into account students’ emotions, readiness and metacognition in the design of online learning environment and activities may have a positive effect on student engagement.},
	language = {en-GB},
	number = {1},
	urldate = {2024-01-10},
	journal = {Education and Information Technologies},
	author = {Fidan, Ayça and Koçak Usluel, Yasemin},
	month = jan,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Promotion:FU1, Promotion:S:11 Online Learning, Promotion:Dissertation {\textbar} FU1 {\textgreater} Kerngedanke, Promotion:Literaturverzeichnis},
	pages = {459--481},
	annote = {Below is an analysis of the scientific article "Emotions, Metacognition, and Online Learning Readiness Are Powerful Predictors of Online Student Engagement: A Moderated Mediation Analysis" by Ayça Fidan and Yasemin Koçak Usluel (2024).
1. Analyse
Hauptthemen und Ziele der Forschung
Die Studie untersucht die Rolle von Emotionen, Metakognition und Online-Lernbereitschaft als Prädiktoren für das Engagement von Studierenden im Online-Lernen. Das Ziel der Forschung ist es, die komplexen Beziehungen zwischen diesen Variablen zu analysieren und zu verstehen, wie sie das Engagement der Studierenden beeinflussen. Die Autoren wollen herausfinden, ob Emotionen das Engagement durch ihre Wirkung auf die Online-Lernbereitschaft vorhersagen und ob Metakognition die Stärke dieser Effekte moderiert.
Methoden und Datenquellen
Die Studie basiert auf einer kausal-vergleichenden Forschungsmethode und verwendet eine moderierte Mediationsanalyse, die mit dem PROCESS-Makro in SPSS durchgeführt wurde. Die Teilnehmer der Studie waren 1601 Universitätsstudenten in der Türkei, die freiwillig an einer Online-Befragung teilnahmen. Die Daten wurden mittels mehrerer Skalen erhoben:


Emotions Experienced in Distance Education Scale: Misst positive, negative und explorative Emotionen.


Student’s Engagement Scale: Misst das Engagement der Studierenden im Online-Lernen.


Online Learning Readiness Scale: Bewertet die Bereitschaft für Online-Lernen.


Metacognitions Questionnaire-30: Bewertet das Metakognitionsniveau der Studierenden.


Zentrale Forschungsergebnisse


Emotionen und Engagement: Positive und explorative Emotionen haben einen positiven Einfluss auf das Engagement der Studierenden, während negative Emotionen einen negativen Einfluss haben. (S. 471)


Online-Lernbereitschaft als Mediator: Die Online-Lernbereitschaft vermittelt den Einfluss von Emotionen auf das Engagement. Positive und explorative Emotionen fördern die Lernbereitschaft, während negative Emotionen diese verringern. (S. 474)


Metakognition als Moderator: Metakognition moderiert den Einfluss von positiven und negativen Emotionen auf das Engagement, jedoch nicht den Einfluss von explorativen Emotionen. Eine geringere Metakognition verstärkt die negativen Effekte von negativen Emotionen auf das Engagement. (S. 475)


2. Zusammenfassung
Die Studie von Fidan und Koçak Usluel (2024) untersucht, wie Emotionen, Metakognition und Online-Lernbereitschaft das Engagement der Studierenden in Online-Lernumgebungen beeinflussen. Die Ergebnisse zeigen, dass positive und explorative Emotionen das Engagement fördern, während negative Emotionen es hemmen. Die Online-Lernbereitschaft vermittelt diese Effekte, und Metakognition moderiert die Beziehungen zwischen Emotionen und Engagement. Die Studie betont die Bedeutung der Berücksichtigung von Emotionen, Metakognition und Lernbereitschaft bei der Gestaltung von Online-Lernumgebungen.
3. Kernaussagen


Positive Emotionen steigern das Engagement: Positive Emotionen korrelieren positiv mit der Online-Lernbereitschaft (r = 0.37) und dem Engagement (r = 0.49). (S. 469)


Negative Emotionen verringern das Engagement: Negative Emotionen korrelieren negativ mit der Online-Lernbereitschaft (r = -0.23) und dem Engagement (r = -0.42). (S. 469)


Metakognition beeinflusst den Effekt von Emotionen: Metakognition moderiert den Einfluss von Emotionen auf das Engagement, indem sie die Effekte von positiven und negativen Emotionen abschwächt oder verstärkt. (S. 471)


4. Argumentationslinien
Die Autoren argumentieren, dass Emotionen eine entscheidende Rolle für das Engagement der Studierenden im Online-Lernen spielen. Positive und explorative Emotionen fördern das Engagement, indem sie die Online-Lernbereitschaft erhöhen. Negative Emotionen hingegen reduzieren das Engagement durch eine verringerte Lernbereitschaft. Metakognition wird als ein moderierender Faktor identifiziert, der den Einfluss von Emotionen auf das Engagement entweder verstärken oder abschwächen kann, je nach den metakognitiven Fähigkeiten der Studierenden. Diese Ergebnisse legen nahe, dass Strategien zur Förderung positiver Emotionen und zur Entwicklung von Metakognition wichtig sind, um das Engagement in Online-Lernumgebungen zu erhöhen. (S. 474-475)
5. Verschlagwortung


Lehr- und Lerneffektivität: Untersuchung der Rolle von Emotionen und Metakognition im Online-Lernen zur Steigerung des Engagements.


Technologieintegration: Analyse der Nutzung von Learning Management Systems (LMS) und ihrer Auswirkungen auf das Lernen.


Kollaboratives Lernen: Bedeutung der emotionalen und metakognitiven Unterstützung für das Engagement der Studierenden.


6. Kategorisierung
Kerngedanke: Die Studie analysiert, wie Emotionen und Metakognition das Engagement der Studierenden im Online-Lernen beeinflussen und zeigt, dass die Förderung positiver Emotionen und die Entwicklung von Metakognitionsstrategien entscheidend für das Engagement sind. (S. 475)
7. Zuordnung zu Forschungsfragen
Passendste Forschungsunterfrage: FU1 - Welche Akzeptanz und Nützlichkeit (Bedeutung) beschreiben Akteure im digitalen Bildungsraum von Gesundheitsberufen bei Anwendung eines Learning-Management-Systems?
Begründung: Die Studie untersucht die Rolle von Emotionen und Metakognition in der Online-Lernbereitschaft und deren Einfluss auf das Engagement, was direkt mit der Akzeptanz und Nützlichkeit digitaler Lernsysteme zusammenhängt.
8. Einordnung der Relevanz
Relevanzbewertung: 5 - Hoch relevantDie Quelle liefert umfassende Erkenntnisse über die Rolle von Emotionen und Metakognition im Online-Lernen und bietet wertvolle Implikationen für die Gestaltung von Online-Lernumgebungen, um das Engagement der Studierenden zu fördern.
Diese strukturierte Analyse bietet einen tieferen Einblick in die Themen der Studie und zeigt deren Relevanz im Kontext der digitalen Bildung auf. Die Ergebnisse unterstreichen die Notwendigkeit, Online-Lernumgebungen so zu gestalten, dass sie positive Emotionen fördern und die Metakognition der Studierenden unterstützen.
},
	file = {Fidan und Koçak Usluel - 2024 - Emotions, metacognition and online learning readin.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/8CR6Z6YQ/Fidan und Koçak Usluel - 2024 - Emotions, metacognition and online learning readin.pdf:application/pdf},
}

@article{koh_adaptiveness_2023,
	title = {Adaptiveness for {Online} {Learning}: {Conceptualising} ‘{Online} {Learning} {Dexterity}’ from {Higher} {Education} {Students}’ {Experiences}},
	volume = {58},
	issn = {0028-8276, 2199-4714},
	shorttitle = {Adaptiveness for {Online} {Learning}},
	url = {https://link.springer.com/10.1007/s40841-023-00287-2},
	doi = {10.1007/s40841-023-00287-2},
	abstract = {Online learning dexterity, or the ability to effortlessly adapt to online learning situations, has become critical since the COVID-19 pandemic, but its processes are not well-understood. Using grounded theory, this study develops a paradigm model of online learning dexterity from semi-structured interviews with 32 undergraduate and postgraduate students from a university in New Zealand. Through students’ online learning experiences during the pandemic from 2020 to 2021, online learning dexterity is found to be how students make online learning ‘just as good’ as face-to-face learning by creating and adjusting five learning manoeuvres according to developing online learning circumstances. Undergraduates and postgraduates re-use familiar study strategies as deep learning manoeuvres, but undergraduates restrict supportseeking manoeuvres to lecturers. Technical problems with online systems and poor course organisation by lecturers affected learning productivity, resulting in the need for more time optimisation manoeuvres. Social support helped students activate persistence manoeuvres to sustain online class attendance. However, undergraduates had more problems sustaining interest and engagement during class as they were not as proficient with using learning presence manoeuvres as postgraduates enrolled in distance learning programmes. The theoretical and practical significance of online learning dexterity for post-pandemic higher education is discussed.},
	language = {en-GB},
	number = {2},
	urldate = {2023-11-22},
	journal = {New Zealand Journal of Educational Studies},
	author = {Koh, Joyce Hwee Ling and Daniel, Ben Kei and Greenman, Angela C.},
	month = dec,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Systemanpassung, Promotion:FU1, Promotion:S:11 Online Learning, Promotion:Dissertation {\textbar} FU1 {\textgreater} Kerngedanke, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU1},
	pages = {379--397},
	annote = {Below is an analysis of the scientific article "Adaptiveness for Online Learning: Conceptualising ‘Online Learning Dexterity’ from Higher Education Students’ Experiences" by Joyce Hwee Ling Koh, Ben Kei Daniel, and Angela C. Greenman (2023).
1. Analyse
Hauptthemen und Ziele der Forschung
Die Studie untersucht, was unter dem Begriff „Online-Lern-Geschicklichkeit“ (Online Learning Dexterity) zu verstehen ist, indem sie die Erfahrungen von Studierenden mit Online-Lernen während der COVID-19-Pandemie analysiert. Ziel ist es, ein Modell zu entwickeln, das beschreibt, wie Studierende ihre Lernstrategien anpassen, um Online-Lernen effektiv zu gestalten und die gleichen Lernergebnisse wie im Präsenzunterricht zu erreichen. Das Hauptziel ist, die theoretischen und praktischen Implikationen von Online-Lern-Geschicklichkeit für die Hochschulbildung nach der Pandemie zu verstehen.
Methoden und Datenquellen
Die Forschungsmethodik basiert auf der Grounded Theory, die es ermöglicht, soziale Phänomene durch die Erfahrungen der Studierenden zu untersuchen. Es wurden halbstrukturierte Interviews mit 32 Studierenden an einer Universität in Neuseeland durchgeführt. Die Teilnehmer wurden aus verschiedenen Fakultäten und Studienrichtungen ausgewählt, um eine möglichst breite Variation der Erfahrungen abzudecken. Die Datenanalyse erfolgte durch offenes, axiales und selektives Kodieren unter Verwendung der Software NVIVO.
Zentrale Forschungsergebnisse


Produktivität: Studierende entwickelten „Zeitoptimierungsmanöver“, um ihre Effizienz im Online-Lernen zu steigern. Dies beinhaltete den Umgang mit technischen Systemen und die Nutzung von Vorlesungsaufzeichnungen.


Effektivität: Studierende nutzten bewährte Lernstrategien („Deep Learning Manöver“), um ein tiefes Verständnis der Lerninhalte zu erlangen. Der Zugang zu Online-Ressourcen und das Suchen von Unterstützung spielten dabei eine wesentliche Rolle.


Engagement: „Persistenz-Manöver“ und „Lernpräsenz-Manöver“ halfen den Studierenden, ihre Aufmerksamkeit und Motivation im Online-Umfeld aufrechtzuerhalten. Soziale Unterstützung war hierbei ein entscheidender Faktor.


2. Zusammenfassung
Die Studie von Koh et al. (2023) analysiert die Fähigkeit von Studierenden, sich an die Herausforderungen des Online-Lernens während der Pandemie anzupassen. Durch Grounded Theory wurde ein Modell entwickelt, das beschreibt, wie Studierende durch Anpassung ihrer Lernstrategien Produktivität, Effektivität und Engagement im Online-Lernen erreichen. Die Studie hebt die Bedeutung der technischen und sozialen Unterstützung hervor und liefert praktische Implikationen für die Gestaltung post-pandemischer Online-Lernumgebungen.
3. Kernaussagen


Online Learning Dexterity: Die Fähigkeit der Studierenden, durch Anpassung ihrer Lernstrategien das Online-Lernen genauso effektiv zu gestalten wie den Präsenzunterricht. (S. 380)


Zeitoptimierungsmanöver: Strategien zur Verbesserung der Produktivität im Umgang mit technischen Systemen. (S. 386)


Deep Learning Manöver: Einsatz bewährter Lernstrategien zur Verbesserung der Effizienz und des Verständnisses von Lerninhalten. (S. 387)


Persistenz- und Lernpräsenz-Manöver: Taktiken zur Aufrechterhaltung von Motivation und Konzentration im Online-Lernen. (S. 388)


4. Argumentationslinien
Die Autoren argumentieren, dass Online-Lern-Geschicklichkeit über die Selbstregulation hinausgeht und stark von kontextuellen Faktoren beeinflusst wird, wie der Benutzerfreundlichkeit der Lernplattformen und der Unterrichtsgestaltung durch Lehrende. Sie betonen, dass Studierende durch adaptive Expertise in der Lage sein sollten, ihre Strategien je nach Lernsituation anzupassen. (S. 390)
5. Verschlagwortung


Lehr- und Lerneffektivität: Die Untersuchung der Wirksamkeit von Online-Lernstrategien zur Steigerung der Lernleistung.


Technologieintegration: Die Rolle technischer Systeme und deren Benutzerfreundlichkeit im Online-Lernen.


Kollaboratives Lernen: Die Bedeutung sozialer Unterstützung und Interaktion im Online-Lernen.


Systemanpassung: Anpassung der Lernstrategien an unterschiedliche Online-Lernumgebungen.


6. Kategorisierung
Kerngedanke: Die Studie analysiert, wie Studierende ihre Lernstrategien anpassen, um die gleichen Ergebnisse im Online-Lernen zu erzielen wie im Präsenzunterricht. Sie zeigt, dass Online-Lern-Geschicklichkeit eine Kombination aus Produktivität, Effektivität und Engagement erfordert und durch technologische sowie soziale Faktoren beeinflusst wird. (S. 389)
7. Zuordnung zu Forschungsfragen
Passendste Forschungsunterfrage: FU1 - Welche Akzeptanz und Nützlichkeit (Bedeutung) beschreiben Akteure im digitalen Bildungsraum von Gesundheitsberufen bei Anwendung eines Learning-Management-Systems?
Begründung: Die Studie untersucht, wie Studierende ihre Lernstrategien anpassen, um die Wirksamkeit des Online-Lernens zu maximieren, was direkt mit der Akzeptanz und Nützlichkeit digitaler Lernsysteme zusammenhängt.
8. Einordnung der Relevanz
Relevanzbewertung: 5 - Hoch relevantDie Quelle liefert umfassende Erkenntnisse über die Anpassungsfähigkeit von Studierenden im Online-Lernen und bietet wertvolle Implikationen für die Gestaltung post-pandemischer Lernumgebungen in der Hochschulbildung.
Diese strukturierte Analyse bietet tiefergehende Einblicke in die Themen der Studie und zeigt deren Relevanz im Kontext der digitalen Bildung auf. Die Ergebnisse unterstreichen die Notwendigkeit, Online-Lernumgebungen sowohl technisch als auch sozial zu unterstützen, um die Lernleistung zu optimieren.
},
	file = {Koh et al. - 2023 - Adaptiveness for Online Learning Conceptualising .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/JTF6MJ8S/Koh et al. - 2023 - Adaptiveness for Online Learning Conceptualising .pdf:application/pdf},
}

