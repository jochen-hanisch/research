@article{elmoazen_capturing_2024,
	title = {Capturing temporal pathways of collaborative roles: {A} multilayered analytical approach using community of inquiry},
	issn = {1556-1607, 1556-1615},
	shorttitle = {Capturing temporal pathways of collaborative roles},
	url = {https://link.springer.com/10.1007/s11412-024-09431-6},
	doi = {10.1007/s11412-024-09431-6},
	abstract = {In collaborative learning, students may follow different trajectories that evolve over time. This study used a multilayered approach to map the temporal dynamics of online problembased learning (PBL) and the transition of students’ roles across time over a full year duration. Based on data from 135 dental students across four consecutive courses throughout a full academic year, the students’ discourses were coded based on the community of inquiry (CoI). A mixture model was used to identify students’ roles. The roles identified were leaders, social mediators, and peripheral explorer roles, and they were visualized using epistemic network analysis (ENA). Similar trajectories were identified and visualized using sequence and process mining. The results showed varying activity levels across three trajectories. Students in the active-constructive trajectory took on leadership roles, while the students in the social interactive trajectory were mostly social mediators, and the free rider trajectory showed a predominant peripheral explorer role. The students in all trajectories returned to their initial roles, showing features typical of stable collaborative dispositions. Both active trajectories (active constructive and social interactive) had very close levels of achievement, whereas the free riders demonstrated lower grades compared to their peers. This research suggests that understanding role dynamics and their evolving trajectories can help teachers better design future collaborative activities, assign roles, form groups, distribute tasks, and, more importantly, be able to support students.},
	language = {en-GB},
	urldate = {2024-08-17},
	journal = {International Journal of Computer-Supported Collaborative Learning},
	author = {Elmoazen, Ramy and Saqr, Mohammed and Hirsto, Laura and Tedre, Matti},
	month = aug,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Promotion:FU2a, Leraning:Analytics, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	annote = {Analyse der Studie "Capturing temporal pathways of collaborative roles: A multilayered analytical approach using community of inquiry" von Elmoazen et al. (2024)
1. Hauptthemen und Ziele der Forschung
Die Studie von Elmoazen et al. (2024) untersucht die zeitlichen Dynamiken kollaborativer Rollen von Studierenden in problemorientierten Lernumgebungen (PBL). Das Hauptziel der Forschung ist es, die Entwicklung und Veränderung von Rollen der Studierenden im Laufe eines akademischen Jahres zu kartieren und zu analysieren. Hierbei wird ein mehrschichtiger analytischer Ansatz verwendet, der auf dem Community of Inquiry (CoI)-Modell basiert.
2. Methoden und Datenquellen
Methoden:


Die Studie nutzt einen mehrschichtigen analytischen Ansatz, der Techniken wie Latent Class Analysis (LCA), Epistemic Network Analysis (ENA), und Process Mining kombiniert.


Daten wurden über ein Jahr hinweg von 135 Zahnmedizinstudenten aus vier aufeinanderfolgenden Kursen gesammelt. Die Diskurse der Studierenden in Online-Diskussionsforen wurden anhand des CoI-Modells kodiert.


LCA wurde verwendet, um die Studierenden in verschiedene Rollen zu klassifizieren. ENA half dabei, die Verbindungen zwischen den CoI-Indikatoren zu visualisieren, während Process Mining die Übergänge und Entwicklungen der Rollen über die Zeit analysierte.


Datenquellen:


Die Daten stammen aus Online-Diskussionsforen, die in einem Lernmanagementsystem (LMS) gehostet wurden. Die Diskussionsdaten wurden über das gesamte akademische Jahr hinweg gesammelt und umfassten 9.301 Beiträge von Studierenden.


3. Zentrale Forschungsergebnisse


Identifizierung von Rollen:


Die Studie identifizierte drei zentrale Rollen: "Leader", "Social Mediator" und "Peripheral Explorer". Jede dieser Rollen zeigte unterschiedliche Muster in den sozialen, kognitiven und lehrenden Präsenzdimensionen des CoI-Modells.




Rollenentwicklung:


Die Analyse zeigte, dass Studierende tendenziell zu ihren ursprünglichen Rollen zurückkehren, was auf eine stabile kollaborative Disposition hinweist. Die Rollenentwicklung erfolgte in drei Haupttrajektorien: "Active Constructive", "Social Interactive" und "Free Riders".




Leistungskorrelation:


Studierende in den aktiven Trajektorien (Active Constructive und Social Interactive) erzielten ähnliche akademische Leistungen, während die "Free Riders"-Gruppe signifikant niedrigere Noten erzielte.




4. Zusammenfassung
Die Studie erforscht die zeitliche Entwicklung kollaborativer Rollen in problemorientierten Lernumgebungen und zeigt, dass bestimmte Rollen und deren Übergänge stabil bleiben. Durch die Anwendung eines mehrschichtigen Ansatzes bietet die Forschung tiefere Einblicke in die Dynamik und den Einfluss dieser Rollen auf die akademische Leistung.
5. Kernaussagen


Rollenidentifikation: Drei zentrale Rollen (Leader, Social Mediator, Peripheral Explorer) wurden identifiziert, die unterschiedliche Interaktionsmuster im Online-PBL zeigen. (S. 7)


Rollenstabilität: Studierende neigen dazu, zu ihren ursprünglichen Rollen zurückzukehren, was auf stabile kollaborative Muster hinweist. (S. 10)


Leistungskorrelation: Studierende in aktiven Rollen zeigten eine höhere akademische Leistung im Vergleich zu weniger aktiven Rollen. (S. 14)


6. Argumentationslinien
Die Autoren argumentieren, dass das Verständnis der zeitlichen Entwicklung von Rollen in kollaborativen Lernumgebungen Lehrkräften hilft, zukünftige Gruppenaktivitäten besser zu gestalten, Rollen zuzuweisen und Aufgaben zu verteilen. Dies könnte zu effektiveren Lehrstrategien und besseren Lernergebnissen führen. (S. 18)
7. Verschlagwortung


Kollaboratives Lernen: Die Studie analysiert, wie unterschiedliche Rollen die Zusammenarbeit und das Lernen in einer PBL-Umgebung beeinflussen.


Lehr- und Lerneffektivität: Die Forschung zeigt, wie die Identifikation und Unterstützung bestimmter Rollen zu einer Verbesserung der Lehr- und Lernprozesse beitragen kann.


Forschungsansätze: Anwendung und Kombination mehrschichtiger Analysemethoden zur Untersuchung von Lernprozessen in kollaborativen Umgebungen.


8. Kategorisierung
Kerngedanke: Die Studie legt dar, dass das Verständnis der zeitlichen Entwicklung kollaborativer Rollen von entscheidender Bedeutung ist, um kollaboratives Lernen effektiver zu gestalten und die Lehrmethoden entsprechend anzupassen. (S. 19)
9. Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU2a: Welchen Effekt erläutern Lernende im digitalen Bildungsraum von Gesundheitsberufen bei der Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems?


Begründung: Die Studie untersucht die Rollenentwicklung in einem kollaborativen, technologiegestützten Lernumfeld, was relevante Erkenntnisse für die Effekte auf Lernende in vergleichbaren Systemen liefert.


10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie liefert fundierte Erkenntnisse zur Rollenentwicklung in kollaborativen Lernumgebungen).


Zitierhäufigkeit und Einfluss: 4 (Die Studie ist aktuell und innovativ in ihrem Ansatz).


Aktualität: 5 (Veröffentlichung im Jahr 2024, daher sehr aktuell).


Gesamtbewertung: 4.7
11. Schlussfolgerung
Die Studie von Elmoazen et al. (2024) verdeutlicht die Bedeutung der Analyse von Rollenentwicklungen in kollaborativen Lernumgebungen. Die Ergebnisse zeigen, dass ein tiefgehendes Verständnis dieser Dynamiken Lehrkräfte dabei unterstützen kann, gezieltere und effektivere Lernaktivitäten zu gestalten, die die akademische Leistung der Studierenden verbessern.
},
	file = {Elmoazen et al. - 2024 - Capturing temporal pathways of collaborative roles.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/J69ZM7J3/Elmoazen et al. - 2024 - Capturing temporal pathways of collaborative roles.pdf:application/pdf},
}

@article{ng_implementing_2024,
	title = {Implementing learning analytics interventions to support student agency in knowledge building},
	issn = {1554-480X, 1554-4818},
	url = {https://www.tandfonline.com/doi/full/10.1080/1554480X.2024.2379786},
	doi = {10.1080/1554480X.2024.2379786},
	abstract = {Research and development of Learning Analytics (LA) have created new ways to support students’ learning. However, our understand­ ing of teachers’ roles when implementing LA in classroom practices remains nascent. This study investigates how teachers can imple­ ment LA to support students’ agency in directing their own inquiry, when engaging in a digital pedagogy approach known as Knowledge Building (KB) on an online platform called Knowledge Forum (KF). Together with a teacher experienced in KB and KF, we co-constructed interventions anchored on two easy-to-use LA tools in KF, the Scaffold Tracker and Word Cloud. These LA interventions were enacted with a Grade 5 class of 18 students and another Grade 6 class of 18 students. Three teacher roles were identified: detecting behaviour unproductive to collaboration, mediating between LA and student self-assessment, and framing student-generated lines of inquiry in actionable ways. We coded KF notes for the discourse moves they reflected and found that after the teacher implemented the LA interventions, notes that sustained inquiry increased sharply with students’ focus shifting from individual to collective knowl­ edge and from superficial explanations to deep understandings. We discuss the implications of these findings on the development of ways to bridge LA research and practice.},
	language = {en-GB},
	urldate = {2024-08-02},
	journal = {Pedagogies: An International Journal},
	author = {Ng, Andy Ding-Xuan and Ong, Aloysius and Lee, Alwyn Vwen Yen and Teo, Chew Lee},
	month = jul,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Leraning:Analytics, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {1--31},
	file = {Ng et al. - 2024 - Implementing learning analytics interventions to s.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/6J8DAPYH/Ng et al. - 2024 - Implementing learning analytics interventions to s.pdf:application/pdf},
}

@article{shulgina_online_2024,
	title = {Online peer editing: the influence of comments, tracked changes and perception of participation on students’ writing performance},
	volume = {11},
	issn = {2196-7091},
	shorttitle = {Online peer editing},
	url = {https://slejournal.springeropen.com/articles/10.1186/s40561-024-00315-8},
	doi = {10.1186/s40561-024-00315-8},
	abstract = {While peer-editing is considered an important part of developing students’ academic writing, questions remain about how different types of peer-editing affect subsequent student performance. The present study looked at a group of university students (N = 149) engaged in peer editing of one another’s essays in an online security studies course. The analysis was conducted from two perspectives: feedback givers and feedback receivers. More specifically, the relationships between the giving of comments and tracking changes in peer’s work and writing score on essays were explored. The results showed that there was a positive correlation between the total number of received comments and the student’s writing score, whereas there was no correlation for the number of tracked changes (neither words deleted, nor words added). Surprisingly, students who assume that peers provide high quality tracked changes demonstrate worse writing performance. This research shows the importance of nuance in understanding peer editing types and their influence on students’ performance, as well as highlighting potential complexities of the interplay between students’ collaborative activities, their performance, and their attitudes.},
	language = {en-GB},
	number = {1},
	urldate = {2024-08-02},
	journal = {Smart Learning Environments},
	author = {Shulgina, Galina and Costley, Jamie and Shcheglova, Irina and Zhang, Han and Sedova, Natalya},
	month = jun,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Bewertungsmethoden, Promotion:Relevanz:4, Promotion:FU3, Promotion:01-02, Promotion:01-02 Methodenquellen, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU3},
	pages = {30},
	annote = {Analyse der Studie „Online Peer Editing: The Influence of Comments, Tracked Changes and Perception of Participation on Students’ Writing Performance“ von Shulgina et al. (2024)
1. Hauptthemen und Ziele der Forschung
Die Studie untersucht, wie unterschiedliche Formen des Peer-Editings in einem Online-Lernumfeld die Schreibkompetenz von Studierenden beeinflussen. Besonders wird die Wirkung von:


Kommentaren (schriftliches Feedback zu bestimmten Textstellen),


Nachverfolgten Änderungen (direkte Änderungen im Text, z. B. Wörter löschen oder hinzufügen),


Wahrnehmung der eigenen Beteiligung am Peer-Editing-Prozess auf die Qualität der studentischen Schreibleistungen analysiert.


Die Hauptfragestellungen der Studie sind:


Ist das Empfangen von Kommentaren mit einer besseren Schreibleistung assoziiert?


Ist das Empfangen von nachverfolgten Änderungen mit einer besseren Schreibleistung assoziiert?


Ist das Geben von Kommentaren mit einer besseren Schreibleistung assoziiert?


Ist das Geben von nachverfolgten Änderungen mit einer besseren Schreibleistung assoziiert?


Wie beeinflusst die Wahrnehmung der eigenen Beteiligung das Schreibniveau?


2. Methoden und Datenquellen


Teilnehmer: 149 Bachelor-Studierende eines Kurses für Sicherheitsstudien an einer Universität in Russland.


Lernumgebung: Online-Format in Microsoft Teams mit Peer-Editing via Google Docs.


Datenerhebung:


Quantitative Analyse der in Google Docs dokumentierten Peer-Editing-Aktivitäten (Anzahl an Kommentaren und nachverfolgten Änderungen).


Online-Umfrage zur Wahrnehmung des Peer-Editing-Prozesses (7-Punkte-Likert-Skala).


Bewertung der Schreibleistung durch Kursleiter anhand eines Rubrikensystems (0–10 Punkte).




Datenanalyse: Multiple lineare Regression zur Untersuchung der Zusammenhänge zwischen Peer-Editing-Variablen und Schreibleistung.


3. Zentrale Forschungsergebnisse


Empfangene Kommentare verbessern die Schreibleistung: Studierende, die mehr Kommentare erhielten, zeigten eine signifikant bessere Schreibqualität (B = 0,034, p {\textless} 0,01).


Empfangene nachverfolgte Änderungen haben keinen Einfluss: Weder das Hinzufügen noch das Löschen von Wörtern im Text durch Peers zeigte eine statistisch signifikante Korrelation mit der Schreibqualität.


Geben von Kommentaren oder nachverfolgten Änderungen zeigt keinen Effekt: Das Bereitstellen von Feedback führte nicht zu einer signifikanten Verbesserung der eigenen Schreibleistung.


Wahrnehmung der Qualität der Peer-Änderungen ist negativ mit der Schreibleistung korreliert: Studierende, die die Qualität der Peer-Änderungen als hoch bewerteten, hatten tendenziell eine schlechtere Schreibleistung (B = -0,221, p {\textless} 0,01).Mögliche Erklärung: Kompetenzstärkere Studierende zweifeln eher an der Nützlichkeit des Feedbacks, während schwächere Studierende das Feedback als hilfreicher wahrnehmen.


Zusätzliche Einflussfaktoren:


GPA (Notenschnitt) und Geschlecht waren signifikante Prädiktoren für die Schreibleistung (p {\textless} 0,05), wobei weibliche Studierende bessere Ergebnisse erzielten.




4. Zusammenfassung
Die Studie zeigt, dass Kommentare im Peer-Editing die Schreibqualität verbessern, während nachverfolgte Änderungen keine signifikante Rolle spielen. Das bloße Bereitstellen von Feedback steigert nicht automatisch die eigene Schreibleistung. Zudem kann die Wahrnehmung der Qualität von Peer-Feedback irreführend sein: Studierende mit höheren Fähigkeiten neigen dazu, Peer-Feedback skeptischer zu bewerten.
5. Kernaussagen


Kommentare sind der effektivste Bestandteil des Online-Peer-Editings für die Verbesserung von Schreibkompetenzen.


Nachverfolgte Änderungen (Hinzufügen/Löschen von Wörtern) haben keinen direkten Einfluss auf die Schreibqualität.


Das Geben von Peer-Feedback führt nicht automatisch zu besseren eigenen Schreibfähigkeiten.


Studierende mit besseren Schreibfähigkeiten bewerten Peer-Feedback kritischer und profitieren weniger davon.


Weibliche Studierende und Studierende mit höheren Noten erzielen bessere Schreibleistungen.


6. Argumentationslinien
Shulgina et al. (2024) argumentieren, dass Peer-Editing als kollaborative Methode nur dann effektiv ist, wenn es gezielt gestaltet wird. Kommentare bieten reflektierendes Feedback und fördern die Metakognition der Studierenden, während direkte Textänderungen als wenig hilfreich wahrgenommen werden. Die Wahrnehmung der Qualität von Peer-Feedback kann zudem von der eigenen Kompetenz beeinflusst sein, was zeigt, dass Studierende mit hohen Fähigkeiten möglicherweise andere Bewertungsmechanismen benötigen.
7. Verschlagwortung


Kollaboratives Lernen: Analyse, wie Peer-Editing die Schreibfähigkeiten verbessert.


Bewertungsmethoden: Untersuchung der Effekte von Peer-Feedback auf Schreibleistungen.


Lehr- und Lerneffektivität: Evaluierung der Wirkung von Peer-Editing auf den Lernerfolg.


Forschungsansätze: Kombination aus quantitativen Daten (Google Docs) und qualitativer Wahrnehmungsanalyse.


8. Kategorisierung
Kerngedanke – Die Studie untersucht die Wirkmechanismen von Online-Peer-Editing in der Schreibförderung und liefert Erkenntnisse über den Einfluss von Feedback-Typen auf die Leistung der Studierenden.
9. Zuordnung zur Forschungsfrage
Passendste Forschungsunterfrage:


In diesem Fall könnte eine alternative Zuordnung lauten:


FU3: Wie sind Konzeption und relevante didaktische und bildungstechnologische Merkmale des systemisch-konstruktivistischen Learning-Management-Systems für Akteure im digitalen Bildungsraum von Gesundheitsberufen dargestellt?


Begründung: Die Studie beschreibt, welche spezifischen Gestaltungsmerkmale (Kommentarfunktionen vs. Nachverfolgte Änderungen) in digitalen Schreibprozessen wirksam sind.


Gesamtbewertung: 4 (hoch relevant, aber nicht explizit auf LMS fokussiert)
11. Schlussfolgerung
Die Studie von Shulgina et al. (2024) zeigt, dass Peer-Editing in Online-Umgebungen primär durch Kommentare verbessert wird. Lehrkräfte sollten daher den Fokus auf die Vermittlung konstruktiver Kommentar-Techniken legen, während direkte Änderungen im Text weniger effektiv sind. Zudem sollte der Einfluss individueller Wahrnehmungen in zukünftigen Forschungsarbeiten weiter untersucht werden, um differenzierte Lernstrategien für unterschiedliche Kompetenzniveaus zu entwickeln.
},
	file = {Shulgina et al. - 2024 - Online peer editing the influence of comments, tr.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/J9HEWK3S/Shulgina et al. - 2024 - Online peer editing the influence of comments, tr.pdf:application/pdf},
}

@article{yan_evidencebased_2024,
	title = {Evidence‐based multimodal learning analytics for feedback and reflection in collaborative learning},
