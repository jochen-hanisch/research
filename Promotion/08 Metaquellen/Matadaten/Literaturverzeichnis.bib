  author = {Eckle, Jannick and Jungfleisch, Anne and Stattkus, Daniel and Zarvić, Novica and Knopf, Julia and Thomas, Oliver},
  date = {2021-12},
  journaltitle = {HMD Praxis der Wirtschaftsinformatik},
