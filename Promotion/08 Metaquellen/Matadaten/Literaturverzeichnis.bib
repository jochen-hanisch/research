@article{mastour_exploring_2025,
	title = {Exploring the acceptance of e-learning in health professions education in {Iran} based on the technology acceptance model ({TAM})},
	volume = {15},
	issn = {2045-2322},
	doi = {10.1038/s41598-025-90742-5},
	abstract = {The COVID-19 pandemic has rapidly accelerated the adoption of e-learning across educational institutions worldwide, especially in health professions education. This study explored the factors influencing e-learning acceptance among health professions students and faculty members in Iran using an extended Technology Acceptance Model (TAM). A descriptive cross-sectional study was conducted among 932 participants, including faculty members, postgraduates, and undergraduates at Mashhad University of Medical Sciences, one of the top five universities in Iran. Data were collected through an online survey from August 1 to August 31, 2020. The TAM was extended by incorporating innovation, social, and organizational characteristics. Partial least squares structural equation modeling was used to analyze the relationships between constructs, including perceived ease of use (PEU), perceived usefulness (PU), and intention to use e-learning. The findings revealed that PEU and PU were pivotal in shaping e-learning acceptance, underscoring the need for user-friendly and effective platforms. Attitude toward e-learning significantly influenced participants' intention to use e-learning platforms, with PEU emerging as the most influential factor. PU had a more substantial impact on faculty members and undergraduate students, while postgraduates placed less emphasis on usefulness. Organizational factors only indirectly affected e-learning acceptance, mediated by individual characteristics. This study underscores the importance of usability, technological infrastructure, and digital literacy training in promoting e-learning acceptance among health professions students and faculty members. These findings significantly impact policymakers, educators, and administrators in designing more user-centered e-learning platforms. Future research should explore the longitudinal effects of technological advancements and institutional policies on e-learning adoption.},
	language = {en-GB},
	number = {1},
	journal = {Scientific Reports},
	author = {Mastour, Haniye and Yousefi, Razieh and Niroumand, Shabnam},
	month = mar,
	year = {2025},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Bewertungsmethoden, Systemanpassung, Bildungstheorien, Humans, Female, Male, Surveys and Questionnaires, COVID-19, Cross-Sectional Studies, Adult, Promotion:FU1, \#5:Zeitschriftenartikel:e-learning, Middle Aged, Education, Distance, Young Adult, Online learning, Faculty, Health Occupations, Health professions education, Iran, Medical education, PLS-SEM, Technology acceptance model (TAM), Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {8178},
	annote = {Analyse der Studie: "Exploring the acceptance of e-learning in health professions education in Iran based on the technology acceptance model (TAM)" von Mastour et al. (2025)

1. Analyse
Hauptthemen und Ziele der Forschung
Ziel der Studie war es, die Akzeptanz von E-Learning in der medizinischen Ausbildung im Iran zu analysieren. Grundlage bildet das erweiterte Technology Acceptance Model (TAM), das um Innovations-, soziale, individuelle und organisationale Faktoren ergänzt wurde. Im Zentrum stand die Frage: Welche Faktoren beeinflussen die Absicht und tatsächliche Nutzung von E-Learning bei Studierenden und Lehrenden im Gesundheitsbereich?
Methoden und Datenquellen


Design: Deskriptive Querschnittsstudie


Teilnehmer: 932 Personen (163 Lehrende, 264 postgraduale und 505 untergraduale Studierende) der Mashhad University of Medical Sciences


Erhebungszeitraum: August 2020


Instrument: Fragebogen mit 33 Items basierend auf dem erweiterten TAM


Analyse: Partial Least Squares Structural Equation Modeling (PLS-SEM), Validierung durch Cronbach’s Alpha, AVE, Composite Reliability


Zentrale Forschungsergebnisse


Die wahrgenommene Benutzerfreundlichkeit (PEU) war der stärkste Prädiktor für die Einstellung gegenüber E-Learning bei allen Gruppen.


Wahrgenommener Nutzen (PU) hatte bei Studierenden signifikanten Einfluss auf die Nutzungsabsicht, bei Lehrenden hingegen nicht.


Individuelle Faktoren beeinflussten die PEU nur bei Lehrenden, während sie die PU in allen Gruppen beeinflussten.


Organisationale Faktoren zeigten keine direkten, aber indirekte Effekte über individuelle und soziale Variablen.


Die Nutzungsabsicht war ein starker Prädiktor für die tatsächliche Nutzung.



2. Zusammenfassung
Die Studie untersucht mittels eines erweiterten Technology Acceptance Models (TAM) die Akzeptanz von E-Learning bei Lehrenden und Studierenden im Bereich der Gesundheitsberufe in Iran. Die Daten wurden im August 2020 mittels Onlinefragebogen erhoben. Die Analyse mittels PLS-SEM ergab, dass insbesondere die wahrgenommene Benutzerfreundlichkeit und -nützlichkeit zentrale Faktoren für die Akzeptanz sind. Organisationale Einflüsse wirkten nur mittelbar. Unterschiede zwischen den Gruppen (Lehrende, Postgraduierte, Undergraduates) zeigten unterschiedliche Gewichtungen von Einflussfaktoren, was auf kontextspezifische Herausforderungen und Erwartungen schließen lässt.

3. Kernaussagen (mit Seitenangaben)


PEU beeinflusst die Einstellung zu E-Learning signifikant bei allen Gruppen (β = 0.725–0.826, S. 8)


PU beeinflusst die Einstellung nur bei Undergraduates signifikant (β = 0.114, p = 0.001; S. 8), nicht jedoch bei Postgraduierenden.


Intention to use → tatsächliche Nutzung ist stark korreliert (β = 0.724–0.805; S. 8)


Organisationale Faktoren wirken nur indirekt über individuelle und soziale Faktoren (S. 9)


PEU → PU ist bei Lehrenden besonders stark ausgeprägt (S. 9)


Soziale Faktoren zeigen keine direkte Wirkung auf PEU oder PU, aber beeinflussen individuelle Faktoren (S. 9)



4. Argumentationslinien
Die Argumentation basiert auf dem TAM, das um relevante externe Variablen ergänzt wurde. Die Autoren strukturieren ihre Argumentation wie folgt:


Theoretische Grundlage: Das TAM ist ein etabliertes Modell zur Erklärung von Technologieakzeptanz, validiert durch zahlreiche Studien.


Empirische Erweiterung: Zusätzliche Variablen wie Innovation, Organisation, individuelle und soziale Faktoren werden integriert.


Hypothesentestung: Es wird gezeigt, dass PEU und PU zentrale Prädiktoren sind, wobei PEU durch individuelle und innovative Faktoren bedingt ist.


Vergleich der Gruppen: Unterschiede zwischen Lehrenden und Studierenden (z. B. Bedeutung von PU vs. PEU) werden detailliert analysiert (S. 7–9).


Ableitung von Handlungsempfehlungen: Plattformen sollten benutzerfreundlich sein; Trainingsprogramme müssen auf Gruppenunterschiede abgestimmt werden (S. 10–11).



5. Verschlagwortung




Schlagwort


Begründung




Technologieintegration


Die Studie analysiert detailliert die Integration von E-Learning-Systemen im Gesundheitsbereich und deren Wirkfaktoren.




Bildungstheorien


Anwendung des TAM als theoretisches Rahmenmodell; Erweiterung um sozio-technische Variablen.




Lehr- und Lerneffektivität


PU als zentrales Konstrukt erfasst subjektive Nützlichkeit für den Lernerfolg und berufliche Leistung.




Bewertungsmethoden


Verwendung psychometrisch validierter Skalen (z. B. AVE, CR, Cronbach's Alpha) zur Modellvalidierung.




Systemanpassung


Die Studie berücksichtigt individuelle und organisationale Unterschiede als Bedingungen für Systemakzeptanz.




Forschungsansätze


Einsatz eines erweiterten PLS-SEM-Ansatzes mit Hypothesentestung und Modellvergleich zwischen Subgruppen.





6. Kategorisierung
Kategorie: Kerngedanke
Begründung: Die Studie stellt mit dem erweiterten TAM einen zentralen theoretischen Bezugsrahmen zur Verfügung, der die Akzeptanz digitaler Bildungssysteme im Gesundheitsbereich analysiert. Es wird gezeigt, dass PEU als dominanter Faktor gruppenübergreifend wirkt und PU stark kontextabhängig ist.

7. Zuordnung zu Forschungsfragen
Zugeordnete Forschungsunterfrage:FU1 – „Welche Akzeptanz und Nützlichkeit (Bedeutung) beschreiben Akteure im digitalen Bildungsraum von Gesundheitsberufen bei Anwendung eines Learning-Management-Systems?“
Begründung:Die Studie analysiert direkt die Konstrukte „Perceived Usefulness“ und „Perceived Ease of Use“ sowie deren Einfluss auf Akzeptanz und Nutzung, differenziert nach Nutzergruppen.

8. Relevanzbewertung


Direkte Relevanz für FU1: 5


Zitierhäufigkeit (potenziell): 4 (nature.com, sehr renommierte Plattform, 2025)


Aktualität: 5


Gesamtbewertung: 5 – Hoch relevant
},
