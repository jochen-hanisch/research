@incollection{vajjhala_transformative_2025,
	address = {Cham},
	title = {The {Transformative} {Role} of {Big} {Data} {Analytics} and {Generative} {AI} in {Redefining} {FinTech} for {New} {Business} {Models}},
	volume = {24},
