@article{scheidig_prognose_2023,
	title = {Prognose von {Studienabbrüchen} angehender {Lehrkräfte} mit {Maschinellem} {Lernen}: {Potenziale} der {Nutzung} von {Studierenden}- und {Studienverlaufsdaten} aus dem {Campus}-{Management}-{System}},
	volume = {51},
	issn = {0340-4099, 2520-873X},
	shorttitle = {Prognose von {Studienabbrüchen} angehender {Lehrkräfte} mit {Maschinellem} {Lernen}},
	url = {https://link.springer.com/10.1007/s42010-023-00182-1},
	doi = {10.1007/s42010-023-00182-1},
	abstract = {The unmet need for teachers draws attention to student teachers’ dropout. In this context, interest is both focused on clarifying the reasons and on reducing dropouts in teacher education programmes. With regard to the analysis of dropouts, new possibilities for the use of student and study progress data (learning analytics) are emerging in the context of digitalisation. The paper presents a study in which dropout predictions were calculated based on campus management data of 4601 student teachers. Two machine learning methods, logistic regression and random forest, were used and their application and results are presented. With both methods, all students could be correctly assigned to either the group of successful graduates or dropouts with about 80\% accuracy. The most important predictor was the examination performance in the ﬁrst three semesters (grade and percentage of passed examinations). The article discusses possibilities and challenges of dropout prediction in teacher education programmes as well as implications of data use.},
	language = {de-DE},
	number = {4},
	urldate = {2024-03-11},
	journal = {Unterrichtswissenschaft},
	author = {Scheidig, Falk and Holmeier, Monika},
	month = dec,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Technologieintegration, Bewertungsmethoden, Promotion:Weiterführung, \#1:Zeitschriftenartikel:learning:management:system, Datenschutz und IT-Sicherheit, DRK-Bildungszentrum Düsseldorf, Krisenreaktion im Bildungsbereich, Assessment, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {489--509},
	annote = {1. Analyse
Die Studie von Scheidig und Holmeier (2023) untersucht die Prognose von Studienabbrüchen bei Lehramtsstudierenden unter Verwendung von Maschinellem Lernen, speziell durch die Analyse von Daten aus dem Campus-Management-System. Die Studie verwendet zwei Methoden: Logistische Regression und Random Forest, und erreicht eine Genauigkeitsrate von etwa 80\% bei der Zuordnung von Studierenden zu den Gruppen der erfolgreichen Absolventen oder der Studienabbrecher.
2. Zusammenfassung
Scheidig und Holmeier fokussieren auf die Prüfungsleistungen in den ersten drei Semestern als wichtigsten Prädiktor für Studienabbrüche. Die Ergebnisse der Studie verdeutlichen das Potenzial von Maschinellem Lernen, um frühzeitig Risiken für Studienabbrüche zu erkennen und gegebenenfalls intervenieren zu können. Die Autoren diskutieren auch die Herausforderungen und ethischen Überlegungen im Umgang mit personenbezogenen Daten in solchen Prognosemodellen.
3. Kernaussagen


Wichtigkeit von Prüfungsleistungen: Die Studienleistungen in den ersten Semestern sind entscheidend für die Prognose von Studienabbrüchen (S. 490-492).


Methodische Ansätze: Logistische Regression und Random Forest bieten effektive Werkzeuge für die Analyse von Bildungsdaten, wobei beide Methoden ihre spezifischen Stärken und Limitationen haben (S. 490-494).


Datenschutz und ethische Überlegungen: Die Verwendung von Learning Analytics wirft wichtige Fragen bezüglich Datenschutz und der ethischen Behandlung von Studierendendaten auf (S. 494-495).


4. Argumentationslinien


Potenzial von Maschinellem Lernen: Die Technologie bietet innovative Wege, um Bildungsprozesse zu analysieren und frühzeitig Risikofaktoren für Studienabbrüche zu identifizieren (S. 490-492).


Herausforderungen bei der Datenverwendung: Es besteht die Notwendigkeit, ethische und datenschutzrechtliche Aspekte sorgfältig zu berücksichtigen, insbesondere wenn persönliche Daten zur Prognose von Studienverhalten verwendet werden (S. 494-495).


5. Verschlagwortung


Bewertungsmethoden: Die verwendeten maschinellen Lernmethoden zur Bewertung des Risikos von Studienabbrüchen illustrieren die Anwendung komplexer Algorithmen im Bildungssektor.


Technologieintegration: Die Integration von Analytik-Tools in das Bildungsmanagement zeigt, wie digitale Werkzeuge zur Vorhersage und Verbesserung von Bildungsergebnissen genutzt werden können.


Datenschutz und IT-Sicherheit: Die Studie betont die Bedeutung des Schutzes persönlicher Daten und der ethischen Überlegungen im Kontext von Bildungsdatenanalyse.


Forschungsansätze: Die Nutzung von Campus-Management-Daten bietet neue Forschungsansätze in der Bildungsanalytik.


Krisenreaktion im Bildungsbereich: Die Möglichkeit, Studienabbrüche vorherzusagen, kann helfen, auf Krisen in der Bildungskarriere von Studierenden effektiver zu reagieren.


Diese detaillierte Analyse von Scheidig und Holmeiers Forschung verdeutlicht das wachsende Interesse und die Möglichkeiten, die maschinelles Lernen für die Vorhersage und Management von Bildungstrajectorien bietet.
},
	file = {Scheidig und Holmeier - 2023 - Prognose von Studienabbrüchen angehender Lehrkräft.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/QRWLCRPZ/Scheidig und Holmeier - 2023 - Prognose von Studienabbrüchen angehender Lehrkräft.pdf:application/pdf},
}

@article{wolf-ostermann_digitale_2024,
	title = {Digitale {Technologien} in der {Pflege} – {Was} können sie leisten?},
	issn = {1436-9990, 1437-1588},
	url = {https://link.springer.com/10.1007/s00103-024-03843-3},
	doi = {10.1007/s00103-024-03843-3},
	abstract = {Zusammenfassung
            Digitale Pflegetechnologien gewinnen in der Langzeitpflege zunehmend an Bedeutung. Sie umfassen alle Technologien, die mittels Vernetzung und/oder Sensorik Prozesse und/oder Produkte verändern, und schließen künstliche Intelligenz, also Verfahren, Methoden und Algorithmen, um mittels Daten zu lernen und darauf aufbauend zielorientierte Handlungen zu ermöglichen, ein. Ihre Anwendung reicht von der Förderung professioneller Zusammenarbeit über Steuerung und Verwaltung, Wissenserwerb und -weitergabe, Interaktion und Beziehung bis zur körpernahen Pflege.
            Digitale Pflegetechnologien haben das Potenzial, gleichzeitig die Qualität der Pflege zu erhöhen und die Arbeitsbedingungen in der Pflege zu verbessern. Allerdings stehen dem Hemmnisse auf verschiedenen Ebenen entgegen: Die Entwicklung dieser Technologien wird häufig von den technischen Möglichkeiten getrieben, sodass Produkte entstehen, die im Pflegealltag keinen konkreten Nutzen entfalten. Bei der Implementation wird nur die Bedienung geschult; es erfolgt aber keine Organisationsentwicklung zur systematischen Integration der Technologien in den Arbeitsalltag. Zudem fehlen hochwertige Evaluationen, die den tatsächlichen Nutzen im Arbeitsalltag abbilden, um so potenzielle Anwender:innen für die Technologie zu gewinnen. Schließlich ist die nachhaltige Finanzierung, insbesondere der Unterhaltung dieser Technologien, nicht gesichert.
            Eine gelingende Digitalisierung in der Pflege setzt daher voraus, dass Technikentwickler:innen und -anwender:innen ebenso wie Politik und Wissenschaft gemeinsam diese Hemmnisse überwinden. Das impliziert, dass Pflegende von Anfang an in den Entwicklungsprozess einbezogen sind, aber auch dass Orte geschaffen werden, in denen die Wirkung digitaler Pflegetechnologien im tatsächlichen Versorgungsgeschehen evaluiert werden kann.
          , 
            Abstract
            Digital care technologies are becoming increasingly important in long-term care. They encompass all technologies that change processes and products by means of networking and/or sensor technology and include artificial intelligence, that is, processes, methods, and algorithms for learning by means of data and enabling meaningful decisions based on this. Their application ranges from the promotion of professional collaboration, control and management, knowledge acquisition and transfer, interaction and relationships to physical caregiving.
            Digital care technologies have the potential to simultaneously increase the quality of care and improve working conditions in care. However, there are obstacles to this at various levels: The development of these technologies is often driven by technical possibilities, resulting in products that do not provide any concrete benefits in routine nursing care. During implementation, only the operator is trained; however, there is no organizational development for the systematic integration of these technologies into routine work. In addition, there is a lack of high-quality evaluations showing evidence of the actual benefits to routine work in order to attract potential users to these technologies. Finally, there is no sustainable financing, especially for the maintenance of these technologies.
            Successful digitization in long-term care therefore requires that technology developers and users, as well as policymakers and scientists, jointly overcome these obstacles. This implies that caregivers are involved in the development process from the outset (co-creation) but also that spaces are created where the effect of digital care technologies can be evaluated in routine caregiving.},
	language = {de-DE},
	urldate = {2024-02-10},
	journal = {Bundesgesundheitsblatt - Gesundheitsforschung - Gesundheitsschutz},
	author = {Wolf-Ostermann, Karin and Rothgang, Heinz},
	month = feb,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Promotion:FU4a, Promotion:Relevanz:5, Technologieintegration, Promotion:Argumentation, \#1:Zeitschriftenartikel:learning:management:system, Datenschutz und IT-Sicherheit, Krisenreaktion im Bildungsbereich, Promotion:FU4b, Lernsystemarchitektur, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	annote = {Analyse des Artikels "Digitale Technologien in der Pflege – Was können sie leisten?" von Wolf-Ostermann und Rothgang (2024)
1. Analyse
Hauptthemen und -ziele der Forschung: Der Artikel untersucht die Anwendung digitaler Technologien in der Pflege im Kontext des demografischen Wandels und der zunehmenden Pflegebedürftigkeit. Ziel ist es, die Potenziale und Herausforderungen digitaler Technologien in der Pflege darzustellen und zu evaluieren, welche technischen Lösungen zur Verbesserung der Pflegequalität und der Arbeitsbedingungen beitragen können.
Verwendete Methoden und Datenquellen:


Methodische Ansätze: Systematische Übersicht und Analyse der aktuellen Literatur und Gesetzgebung zu digitalen Pflegetechnologien.


Werkzeuge und Datenquellen: Umfragen, systematische Literaturrecherche, Gesetzestexte und Berichte zu digitalen Pflegeinnovationen.


Zentrale Forschungsergebnisse:


Technologische Anwendungen: Zu den digitalen Pflegetechnologien gehören elektronische Patientenakten, Televisiten, Hausnotrufsysteme, digitale Pflegedokumentation, Sensorik, Robotik und E-Learning-Software.


Potenziale: Digitale Technologien können die Pflegequalität verbessern, Arbeitsbedingungen erleichtern und Pflegende entlasten.


Hindernisse: Technologische Entwicklungen sind oft technikgetrieben und nicht auf die Bedürfnisse der Pflegepraxis abgestimmt. Es fehlen hochwertige Evaluationen und eine nachhaltige Finanzierung.


2. Zusammenfassung
Kernpunkte des Artikels:


Problemstellung: Die Pflege steht vor großen Herausforderungen durch den demografischen Wandel und den Fachkräftemangel. Digitale Technologien könnten Lösungen bieten.


Methodik: Systematische Analyse der aktuellen Literatur und Gesetzgebung.


Hauptergebnisse: Digitale Technologien haben das Potenzial, die Pflegequalität zu verbessern und die Arbeitsbedingungen zu erleichtern. Es gibt jedoch erhebliche Hindernisse bei der Implementierung und Finanzierung.


Schlussfolgerungen: Erfolgreiche Digitalisierung in der Pflege erfordert eine partizipative Entwicklung, nachhaltige Finanzierung und hochwertige Evaluationen.


3. Kernaussagen


Potenziale digitaler Technologien: „Digitale Pflegetechnologien haben das Potenzial, gleichzeitig die Qualität der Pflege zu erhöhen und die Arbeitsbedingungen in der Pflege zu verbessern.“ (S. 1)


Hindernisse bei der Implementierung: „Bei der Implementation wird nur die Bedienung geschult; es erfolgt aber keine Organisationsentwicklung zur systematischen Integration der Technologien in den Arbeitsalltag.“ (S. 1)


Notwendigkeit hochwertiger Evaluationen: „Zudem fehlen hochwertige Evaluationen, die den tatsächlichen Nutzen im Arbeitsalltag abbilden, um so potenzielle Anwenderfür die Technologie zu gewinnen.“ (S. 1)


4. Argumentationslinien


Verbesserung der Pflegequalität: Der Artikel argumentiert, dass digitale Technologien die Pflegequalität und die Arbeitsbedingungen signifikant verbessern können, sofern sie richtig implementiert werden.


Partizipative Entwicklung: Es wird betont, dass technologische Entwicklungen partizipativ erfolgen müssen, um die tatsächlichen Bedürfnisse der Pflegenden zu adressieren.


Nachhaltige Finanzierung: Eine langfristige und nachhaltige Finanzierung ist unerlässlich für die Implementierung und den Unterhalt digitaler Pflegetechnologien.


5. Verschlagwortung


Technologieintegration:


Begründung: Der Artikel behandelt umfassend die Integration digitaler Technologien in die Pflegepraxis und die damit verbundenen Herausforderungen.


Fundstelle: S. 1




Bewertungsmethoden:


Begründung: Der Artikel diskutiert die Notwendigkeit hochwertiger Evaluationen zur Bewertung der Wirksamkeit digitaler Pflegetechnologien.


Fundstelle: S. 1




Systemanpassung:


Begründung: Es wird aufgezeigt, wie digitale Technologien in die bestehende Pflegeinfrastruktur integriert werden können und welche Anpassungen notwendig sind.


Fundstelle: S. 1




6. Kategorisierung


Kategorie: Argumentation


Kriterium: Nutzung von empirischen Daten und theoretischen Ansätzen zur Unterstützung der These, dass digitale Technologien die Pflegequalität verbessern können.


Beispiel: Der Artikel diskutiert die Potenziale und Herausforderungen digitaler Technologien in der Pflege und unterstützt dies mit Beispielen und Literaturverweisen.




7. Zuordnung zu Forschungsfragen


FU5: Welche Möglichkeiten und Grenzen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems durch Akteure im digitalen Bildungsraum von Gesundheitsberufen analysiert?


Begründung: Der Artikel bietet eine umfassende Analyse der Möglichkeiten und Grenzen digitaler Technologien in der Pflege, was direkt auf die Untersuchung der Effekte und Grenzen digitaler Systeme im Bildungsbereich übertragbar ist.


Fundstelle: S. 1




8. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5/5


Der Artikel liefert detaillierte Einblicke in die Integration und Bewertung digitaler Technologien, was direkt relevant für die Forschungsfrage ist.




Zitierhäufigkeit und Einfluss des Artikels: 4/5


Basierend auf der umfassenden Analyse und dem aktuellen Fokus auf digitale Technologien in der Pflege, ist der Artikel wahrscheinlich einflussreich in akademischen und praxisbezogenen Kreisen.




Aktualität des Artikels: 5/5


Veröffentlicht im Jahr 2024, ist der Artikel hochaktuell und bezieht sich auf die neuesten Entwicklungen in der Pflege.




Gesamtbewertung: 4.7/5
Diese Analyse zeigt die Relevanz des Artikels für die Untersuchung der Integration und Bewertung digitaler Technologien in der Pflege und bietet wertvolle Einblicke für zukünftige Forschungen und Praktiken.
},
	file = {Wolf-Ostermann und Rothgang - 2024 - Digitale Technologien in der Pflege – Was können s.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/M7RACXSK/Wolf-Ostermann und Rothgang - 2024 - Digitale Technologien in der Pflege – Was können s.pdf:application/pdf},
}

@article{carabregu-vokshi_21st_2024,
	title = {21st century digital skills of higher education students during {Covid}-19—is it possible to enhance digital skills of higher education students through {E}-{Learning}?},
	volume = {29},
	issn = {1360-2357, 1573-7608},
	url = {https://link.springer.com/10.1007/s10639-023-12232-3},
	doi = {10.1007/s10639-023-12232-3},
	abstract = {Crucial for organizations’ business performance, 21st-century digital skills have gained prominence. The Covid-19 pandemic’s impact on individuals, education, and higher education institutions led to a shift from traditional face-to-face to remote synchronous learning. Students experienced diverse information and communication technologies (ICTs), while instructors adapted course structures, engaged in e-learning, and revamped online curricula. This study examines factors affecting students’ digital skills acquisition, including instructor involvement, e-course quality, e-learning system usability, and e-course interactivity. Additionally, we explore the relationship between increased educational ICT usage and improved digital skills. Drawing from a survey of 624 higher education students in Pristina, Kosovo, and employing variance-based PLS-SEM analysis using SmartPLS 3.0, we find that active professor engagement in e-learning significantly influences digital skills acquisition. Ease of use and e-course interactivity also wield substantial effects, while e-course quality indirectly affects digital skills. Enhanced educational ICT usage positively correlates with creative and innovative skills development, enabled by content creation and ICT integration. This study contributes to the ongoing discussion regarding the potential enhancement of digital skills acquisition among higher education students. The findings indicate that increasing students’ gaining digital skills through e-learning is indeed achievable through instructor involvement, e-course quality, ease of use, and increased ICT utilization. This study’s insights provide a foundation for educators, institutions, and policymakers to make informed decisions on designing effective e-learning environments and strategies that promote students’ digital skills in a rapidly evolving educational landscape.},
	language = {en-GB},
	number = {1},
	urldate = {2024-01-10},
	journal = {Education and Information Technologies},
	author = {Carabregu-Vokshi, Mjellma and Ogruk-Maz, Gokcen and Yildirim, Sinan and Dedaj, But and Zeqiri, Adelina},
	month = jan,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {103--137},
	annote = {Analyse
Hauptthemen und -ziele der Forschung: Die Studie von Carabregu-Vokshi et al. (2024) untersucht, ob und wie digitale Fähigkeiten von Studierenden im Hochschulbereich durch E-Learning verbessert werden können, insbesondere im Kontext der COVID-19-Pandemie. Die Forschung fokussiert sich auf die Verbindung zwischen der Nutzung von Bildungs-ICT und der Entwicklung digitaler Kompetenzen.
Verwendete Methoden und Datenquellen: Mithilfe einer Befragung von 624 Studierenden in Pristina, Kosovo, und einer varianzbasierten PLS-SEM Analyse (SmartPLS 3.0) analysieren die Autoren den Einfluss verschiedener Faktoren wie Dozentenbeteiligung, Kursqualität und Interaktivität auf die digitalen Fähigkeiten der Studierenden.
Zentrale Forschungsergebnisse: Die Studie zeigt, dass die aktive Beteiligung der Dozenten, die Benutzerfreundlichkeit der E-Learning-Systeme und die Qualität der E-Kurse wesentlich zur Verbesserung der digitalen Fähigkeiten beitragen. Zudem wird festgestellt, dass eine erhöhte Nutzung von Bildungs-ICT kreative und innovative Fähigkeiten fördert.
Zusammenfassung
Carabregu-Vokshi et al. (2024) bieten wichtige Einblicke, wie digitale Fähigkeiten durch E-Learning gefördert werden können. Sie betonen die Bedeutung der Lehrpersonen und der Gestaltung von Online-Kursen zur Förderung digitaler Kompetenzen. Ihre Ergebnisse unterstützen die These, dass E-Learning ein effektives Mittel sein kann, um auf die Anforderungen des 21. Jahrhunderts zu reagieren.
Kernaussagen


"Die aktive Beteiligung der Dozenten im E-Learning beeinflusst signifikant die Aneignung digitaler Fähigkeiten." (S. 103)


"Erhöhte Nutzung von Bildungs-ICT korreliert positiv mit der Entwicklung kreativer und innovativer Fähigkeiten." (S. 107)


Argumentationslinien


Die Forschung stützt sich auf die Hypothese, dass verbesserte E-Learning-Umgebungen und eine verstärkte Interaktion zwischen Lehrenden und Lernenden essentiell für die Entwicklung digitaler Kompetenzen sind.


Die Ergebnisse untermauern die Bedeutung von gut gestalteten und interaktiven E-Kursen zur Förderung des Erwerbs digitaler Fähigkeiten.


Verschlagwortung


Lehr- und Lerneffektivität: Durch den Einsatz interaktiver und gut gestalteter E-Learning-Kurse wird die Effektivität des Lernprozesses erhöht.


Technologieintegration: Die Nutzung von ICTs zur Bildung zeigt die Integration von Technologie in Lernprozessen.


Kollaboratives Lernen: Die Studie betont die Rolle der Zusammenarbeit und Kommunikation in digitalen Lernumgebungen.


Kategorie: Weiterführung
Die Studie deutet darauf hin, dass weitere Forschungen zur Optimierung von E-Learning-Umgebungen und zur Vertiefung des Verständnisses darüber, wie digitale Werkzeuge am besten in Lehrpläne integriert werden können, notwendig sind. Dies könnte die Entwicklung von Strategien zur effektiveren Nutzung von ICTs in der Bildung umfassen.
},
	file = {Carabregu-Vokshi et al. - 2024 - 21st century digital skills of higher education st.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/SJ22G6M5/Carabregu-Vokshi et al. - 2024 - 21st century digital skills of higher education st.pdf:application/pdf},
}

