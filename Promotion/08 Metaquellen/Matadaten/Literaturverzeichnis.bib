	url = {https://online-journals.org/index.php/i-jet/article/view/42929},
	doi = {10/gss62q},
	abstract = {E-learning implementation is growing alongside the e-learning market’s growth. As a result, competing models and approaches were proposed to improve e-learning and learner performance; one of these models is the e-learning systems success model. In order to expand this model, an analysis of the published e-learning models and frameworks in the period 2017–2022 was conducted using the aggregative review method. 37 studies that match the current study interests have been selected and analyzed. The main results support the e-learning system success model. In addition to further constructs other than those used in the model that have been used to enhance it, an adaptive e-learning success model has been proposed, which integrates the e-learning success model with the other models and frameworks proposed in the literature. This study recommends that achieving e-learning success requires an analysis of the internal and external environment and crafting an adaptation plan to determine the e-learning methods depending on the pedagogical approaches and tutors’ and learners’ abilities and characteristics, which in turn determine the instructional material required and assessment methods, besides the required ICT. Besides the required enhancements, such as tutor and learner training, as well as the institution’s policy and e-learning management, in addition to the required adaptations to cope with environmental factors in order to embrace learners in education policies and future strategies.},
	language = {en-GB},
	number = {18},
	urldate = {2023-09-30},
	journal = {International Journal of Emerging Technologies in Learning (iJET)},
	author = {Romi, Ismail M.},
	month = sep,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Bildungstheorien, \#1:Zeitschriftenartikel:learning:management:system, Bildung, Multimedia, Lernsystemarchitektur, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {177--191},
	annote = {Die Studie von Romi (2023) präsentiert ein erweitertes Modell für den Erfolg adaptiver E-Learning-Systeme, das auf einer umfassenden Literaturrecherche und der Integration verschiedener bestehender Modelle und Rahmenwerke basiert.
1. Analyse der Quelle
Romi untersucht bestehende E-Learning-Erfolgsmodelle und entwickelt ein integriertes Modell, das individuelle, institutionelle und umweltbedingte Faktoren berücksichtigt. Der Schwerpunkt liegt auf der Anpassung des E-Learning an die Bedürfnisse und Fähigkeiten von Lernenden und Lehrenden unter Berücksichtigung der technologischen Rahmenbedingungen.
2. Zusammenfassung der Kernaussagen
Das erweiterte Modell betont die Notwendigkeit einer guten Passform zwischen den Komponenten des E-Learning-Systems, einschließlich der Anpassung an technische Fähigkeiten und pädagogische Ansätze. Erfolgreiches E-Learning hängt von einer sorgfältigen Analyse und Planung ab, die sowohl interne als auch externe Faktoren berücksichtigt.
3. Darstellung der Kernaussagen anhand der Fundstellen


Anpassung des Systems: Das Modell beschreibt, wie E-Learning-Systeme an die spezifischen Bedürfnisse der Nutzer angepasst werden sollten, um effektiv zu sein (S. 183-185).


Integration verschiedener Modelle: Verschiedene pädagogische und technische Aspekte werden integriert, um die Effektivität des Lernens zu maximieren (S. 186-188).


Erfolgsfaktoren: Individuelle, institutionelle und umweltbedingte Determinanten werden als kritische Erfolgsfaktoren für E-Learning hervorgehoben (S. 189-191).


4. Argumentationslinien
Die Studie argumentiert, dass eine erfolgreiche E-Learning-Umgebung eine flexible Anpassung an die Bedürfnisse der Lernenden erfordert und dass eine systematische Überprüfung und Anpassung der Lehrmethoden und technologischen Werkzeuge notwendig ist, um die Lernziele effektiv zu unterstützen.
5. Verschlagwortung


Lernsystemarchitektur: Beschreibt die strukturelle Anpassung und Integration von E-Learning-Komponenten.


Bildungstheorien: Betonung verschiedener Lehr- und Lernansätze innerhalb des Modells.


Lehr- und Lerneffektivität: Fokus auf die Maximierung der Lernleistung durch Anpassung der Lehrmaterialien und Methoden.


Technologieintegration: Integration moderner ICT-Werkzeuge zur Unterstützung des E-Learning.


Forschungsansätze: Analyse und Entwicklung eines umfassenden Modells basierend auf einer aggregativen Literaturrezension.


Dieser systematische Überblick verdeutlicht die Komplexität und die multidimensionalen Aspekte, die bei der Gestaltung erfolgreicher E-Learning-Umgebungen berücksichtigt werden müssen.
},
	file = {Romi - 2023 - Adaptive E-Learning Systems Success Model.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/RWKTVP8N/Romi - 2023 - Adaptive E-Learning Systems Success Model.pdf:application/pdf},
}

@article{korndle_arbeitsplatznahe_2023,
	title = {Arbeitsplatznahe {Lernaufgaben}: {Ihre} {Modellierung}, {Konstruktion} und {Einsatz} in digitalen {Lehr}-{Lernszenarien} beruflichen {Lernens}},
	abstract = {Arbeitsplatznahe Lernaufgaben verbinden den Erwerb beruflicher Kompetenzen mit der Bewältigung von Aufgaben aus dem Berufs- oder Alltagsleben. Ziel dieses Beitrages ist es, auf der Grundlage von Erkenntnissen zum Problemlösen den komplexen Lehr-Lernprozess beim Bearbeiten von arbeitsplatznahen Lernaufgaben genauer zu beschreiben, um auf dieser Basis Handlungsanleitungen für die Konstruktion und den Einsatz arbeitsplatznaher Lernaufgaben in digitalen Lernumgebungen für das berufliche Lernen abzuleiten. Anhand eines Beispiels aus der beruflichen Ausbildung wird illustriert, wie auf dieser Grundlage Entscheidungen für die Konstruktion und den Einsatz arbeitsplatznaher Lernaufgaben in digitalen Lernumgebungen für das berufliche Lernen ermöglicht werden. Dabei wird insbesondere auf das Potential einer digitalen Lernortkooperation eingegangen. Abschließend werden Bedingungen und Herausforderungen beim Einsatz arbeitsplatznaher Lernaufgaben diskutiert.},
	language = {de-DE},
	journal = {Berufs- und Wirtschaftspädagogik - online},
	author = {Körndle, Hermann and Proske, Antje and Dresden, TU},
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:FU3, Promotion:FH, \#3:Zeitschriftenartikel:online:Lernumgebung, Promotion:S:03 Online-Lernumgebung, Promotion:Literaturverzeichnis},
	annote = {Analyse des Artikels “Arbeitsplatznahe Lernaufgaben: Ihre Modellierung, Konstruktion und Einsatz in digitalen Lehr-Lernszenarien beruflichen Lernens” von Hermann Körndle \& Antje Proske (2023)
1. Identifizierung und Beschreibung der Hauptthemen und -ziele der Forschung:
Der Artikel befasst sich mit der Entwicklung und Implementierung arbeitsplatznaher Lernaufgaben in digitalen Lernumgebungen für berufliches Lernen. Hauptziel ist die detaillierte Beschreibung des komplexen Lehr-Lernprozesses beim Bearbeiten solcher Aufgaben, um daraus Handlungsanleitungen für die Konstruktion und den Einsatz dieser Aufgaben abzuleiten. Die Autoren untersuchen insbesondere das Potenzial digitaler Lernortkooperationen.
2. Erkennung der verwendeten Methoden und Datenquellen:
Die Autoren verwenden einen theoretischen Ansatz, basierend auf Erkenntnissen zum Problemlösen, um den Lehr-Lernprozess zu analysieren. Sie illustrieren ihre theoretischen Überlegungen anhand eines praktischen Beispiels aus der CNC-Ausbildung. Methoden wie der IDEAL-Problem-Solver und das Sandwichmodell der Aufgabenbearbeitung werden verwendet, um die einzelnen Schritte und Prozesse zu strukturieren.
3. Erklärung der zentralen Forschungsergebnisse:
Die zentrale Erkenntnis ist, dass arbeitsplatznahe Lernaufgaben durch ihre realitätsnahe Gestaltung und die Einbettung in authentische berufliche Kontexte besonders geeignet sind, berufliche Kompetenzen zu fördern. Durch eine strukturierte Vorgehensweise, wie sie das Sandwichmodell und der IDEAL-Problem-Solver bieten, können Lernende systematisch an komplexe berufliche Aufgaben herangeführt werden, was zu einer effektiven Verbindung von Theorie und Praxis führt.
Zusammenfassung
Kernpunkte des Artikels:
	•	Problemstellung: Wie können arbeitsplatznahe Lernaufgaben effektiv in digitalen Lernumgebungen gestaltet und eingesetzt werden, um berufliche Kompetenzen zu fördern?
	•	Methodik: Theoretische Analyse basierend auf Problemlösungsmodellen und praktische Illustration anhand eines Beispiels aus der CNC-Ausbildung.
	•	Hauptergebnisse: Strukturierte, realitätsnahe Lernaufgaben fördern die Verbindung von Theorie und Praxis und unterstützen den Kompetenzaufbau. Digitale Lernortkooperationen bieten zusätzliche Vorteile.
	•	Schlussfolgerungen: Die Umsetzung arbeitsplatznaher Lernaufgaben in digitalen Szenarien ist effektiv, erfordert jedoch sorgfältige Planung und Unterstützung durch didaktische Modelle und Technologien.
Kernaussagen
	•	Arbeitsplatznahe Lernaufgaben kombinieren berufliche Kompetenzentwicklung mit realen Aufgaben aus dem Berufsleben (S. 1).
	•	Die Bearbeitung solcher Aufgaben kann als Problemlöseprozess verstanden werden (S. 3).
	•	Ein prozessorientierter Ansatz, wie der IDEAL-Problem-Solver, hilft Lernenden, die Aufgaben systematisch zu bearbeiten (S. 4).
	•	Das Sandwichmodell zeigt die Phasen und Ressourcen der Aufgabenbearbeitung und betont die Bedeutung der Lernortkooperation (S. 7-8).
Argumentationslinien
	•	Aufbau der Argumente:
	•	Einleitung: Definition und Bedeutung arbeitsplatznaher Lernaufgaben.
	•	Theoretischer Rahmen: Problemlösen und prozessorientierte Unterstützung.
	•	Modellierung: IDEAL-Problem-Solver und Sandwichmodell.
	•	Praktische Anwendung: Beispiel aus der CNC-Ausbildung.
	•	Diskussion: Herausforderungen und Bedingungen für den Einsatz.
	•	Logische Verbindungen:
	•	Verknüpfung von Theorie und Praxis: Durch arbeitsplatznahe Aufgaben und digitale Kooperation.
	•	Systematische Unterstützung: Durch Modelle und strukturierte Prozesse.
Verschlagwortung
	•	Lehr- und Lerneffektivität: Der Artikel beschreibt ausführlich, wie strukturierte und realitätsnahe Lernaufgaben den Lernprozess und den Kompetenzaufbau fördern, was direkt auf die Effektivität von Lehr- und Lernmethoden abzielt.
Kategorisierung
	•	Kerngedanke: Der zentrale Gedanke des Artikels ist die Förderung beruflicher Kompetenzen durch realitätsnahe und strukturierte Lernaufgaben in digitalen Lernumgebungen.
Forschungsfragen Zuordnung
	•	Hauptforschungsfrage: Wie ist das Wirkgefüge des angewendeten Learning-Management-Systems auf Akteure im digitalen Bildungsraum von Gesundheitsberufen gestaltet?
	•	FU3: Wie sind Konzeption und relevante didaktische und bildungstechnologische Merkmale des systemisch-konstruktivistischen Learning-Management-Systems für Akteure im digitalen Bildungsraum von Gesundheitsberufen dargestellt?
Der Artikel von Körndle und Proske passt zu dieser Forschungsfrage, da er die Konzeption und didaktischen Merkmale arbeitsplatznaher Lernaufgaben in digitalen Lernumgebungen beschreibt und die Auswirkungen auf die Lernenden analysiert.
},
	file = {Körndle et al. - 2023 - Arbeitsplatznahe Lernaufgaben Ihre Modellierung, .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/VN43NVEY/Körndle et al. - 2023 - Arbeitsplatznahe Lernaufgaben Ihre Modellierung, .pdf:application/pdf},
}

@article{barta_time_2021,
	title = {Time {Perspectives} as {The} {Predictors} of {Online} {Self}-{Regulated} {Learning}},
	volume = {1},
	issn = {2669-235X},
	url = {https://diamondopen.com/journals/jelr/article/view/73},
	doi = {10/gp6jqm},
	abstract = {Digital education considerably requires active participation of students in the learning process, the application of self-regulated learning activities for the attainment of successful learning results. The aim of the present study is the investigation of time perspectives as the predictors of online self-regulated learning. In our study 210 Transylvanian students participated, from the Babeș-Bolyai University, Faculty of Psychology and Educational Sciences. Students’ demographic characteristics were recorded, for the assessment of self-regulation the Self-regulated Online Learning Questionnaire - Revised was applied and time perspectives of students were measured by the Zimbardo Time Perspective Inventory. A correlational, cross-sectional design was used. On the basis of the results of hierarchical regression, in our first model demographic characteristics explained 5\% of the variance for the application of selfregulation activities. In our second model, controlling demographic variables, time perspectives explained an additional 33\% of the variance for self-regulation. Self-regulated learning strategies are predicted among demographic characteristics by students’ gender, age and online learning, while out of time perspectives only future orientation proved to be a significant predictor. Females, older students, participants attending online education and higher future orientation apply to a higher degree the selfregulated learning strategies as males, younger students and participants with lower scores at future orientation.},
	language = {en-GB},
	number = {2},
	urldate = {2022-05-20},
	journal = {Journal of e-learning Research},
	author = {Barta, Andrea and Tamás, Borbála and Gálfi, Bernadette and Szamosközi, István},
	month = dec,
	year = {2021},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Systemanpassung, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {32--40},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:
Die Studie von Barta et al. (2021) untersucht, wie unterschiedliche Zeitperspektiven (Vergangenheit, Gegenwart, Zukunft) als Prädiktoren für selbstreguliertes Lernen im Online-Bereich fungieren. Ziel ist es, herauszufinden, welche Zeitperspektiven am stärksten die Anwendung selbstregulierter Lernstrategien bei Studierenden vorhersagen, insbesondere in der Online-Bildung.
Verwendete Methoden und Datenquellen:
Es wurde ein korrelatives, querschnittliches Design verwendet, um die Vorhersagekraft der Zeitperspektiven für selbstreguliertes Lernen zu messen, wobei demografische Variablen kontrolliert wurden. An der Studie nahmen 210 Studierende der Babeș-Bolyai Universität, Fakultät für Psychologie und Erziehungswissenschaften, teil. Zur Erfassung der selbstregulierten Lernstrategien wurde der “Self-Regulated Online Learning Questionnaire – Revised” (SROLQ-R) und zur Erfassung der Zeitperspektiven das “Zimbardo Time Perspective Inventory” (ZTPI) verwendet.
Zentrale Forschungsergebnisse:
Die Ergebnisse der hierarchischen Regression zeigen, dass demografische Variablen 5 \% der Varianz bei der Anwendung selbstregulierter Lernstrategien erklären. Zeitperspektiven erklären zusätzlich 33 \% der Varianz. Insbesondere die Zukunftsperspektive erwies sich als signifikanter Prädiktor für selbstreguliertes Lernen, während andere Zeitperspektiven (Vergangenheit negativ, Vergangenheit positiv, Gegenwart hedonistisch, Gegenwart fatalistisch) keine signifikanten Prädiktoren waren.
Zusammenfassung
Die Studie zeigt, dass die Zukunftsperspektive ein wichtiger Prädiktor für selbstreguliertes Lernen im Online-Bereich ist. Studierende mit einer starken Zukunftsorientierung neigen dazu, mehr selbstregulierte Lernstrategien anzuwenden und dadurch akademische Erfolge zu erzielen. Diese Erkenntnisse unterstreichen die Bedeutung der Förderung einer zukunftsorientierten Haltung bei Studierenden, um ihre Lernprozesse effektiver zu gestalten.
Kernaussagen
	•	“Demografische Variablen erklärten signifikante 5 \% der Varianz bei der Anwendung selbstregulierter Lernstrategien.” (S. 35)
	•	“Zeitperspektiven erklärten zusätzlich 33 \% der Varianz, wobei die Zukunftsperspektive als signifikanter Prädiktor hervortrat.” (S. 36)
	•	“Studierende mit höherer Zukunftsorientierung wenden mehr selbstregulierte Lernstrategien an als solche mit geringerer Zukunftsorientierung.” (S. 37)
Argumentationslinien
	•	Die Studie argumentiert, dass eine starke Zukunftsorientierung die Anwendung selbstregulierter Lernstrategien fördert, was zu höheren akademischen Leistungen führt.
	•	Es wird betont, dass demografische Faktoren wie Geschlecht, Alter und bisherige Erfahrungen mit Online-Lernen ebenfalls wichtige, aber weniger starke Prädiktoren für selbstreguliertes Lernen sind.
Verschlagwortung
	•	Lehr- und Lerneffektivität: Die Untersuchung zeigt, dass eine zukunftsorientierte Zeitperspektive die Effektivität selbstregulierter Lernstrategien erhöht.
	•	Forschungsansätze: Die Studie verwendet ein korrelatives, querschnittliches Design zur Untersuchung der Prädiktoren für selbstreguliertes Lernen.
	•	Systemanpassung: Die Ergebnisse betonen die Notwendigkeit, Bildungsstrategien an die Zeitperspektiven der Studierenden anzupassen, um selbstreguliertes Lernen zu fördern.
Kategorie: Kerngedanke
Diese Studie trägt wesentlich zur Beantwortung der Forschungsfrage bei, welche bildungswissenschaftlichen Mechanismen bei der Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems in Bezug auf die Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben werden. Sie zeigt, dass eine zukunftsorientierte Zeitperspektive ein zentraler Mechanismus ist, der selbstreguliertes Lernen fördert und somit die akademischen Erfolge der Studierenden verbessert.
},
	file = {Barta et al. - 2021 - Time Perspectives as The Predictors of Online Self.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/TQ63IH7P/Barta et al. - 2021 - Time Perspectives as The Predictors of Online Self.pdf:application/pdf},
}

@article{heislbetz_distanzunterricht_2022,
	title = {Distanzunterricht und {E}-{Learning} in der beruflichen {Fort}- und {Weiterbildung}: {Wie} verändert der {Distanzunterricht} durch {Corona} die {Erwartungen} der {Teilnehmer}\_innen?},
	volume = {17},
	issn = {1861-6186, 2235-218X},
	shorttitle = {Distanzunterricht und {E}-{Learning} in der beruflichen {Fort}- und {Weiterbildung}},
	url = {https://econtent.hogrefe.com/doi/10.1024/1861-6186/a000660},
	doi = {10.1024/1861-6186/a000660},
	abstract = {Zusammenfassung. Die Prognose, dass die Digitalisierung die Praxis in der beruflichen Fort- und Weiterbildung verändern wird, ist nicht neu. Dennoch gibt es bislang wenig Erkenntnis zu den Erwartungen der Teilnehmer\_innen nach digital unterstützten Lernformen. Auf Grundlage von Erhebungen zu zwei Zeitpunkten vergleicht dieser Beitrag, wie sich die diesbezüglichen Erwartungen in der beruflichen Fort- und Weiterbildung im Sozial- und Gesundheitswesen vor und während des Ausbruchs der Corona-Pandemie verändert haben.},
	language = {de-DE},
	number = {1},
	urldate = {2022-04-26},
	journal = {PADUA},
	author = {Heislbetz, Claus and Götz, Vanadis},
	month = feb,
	year = {2022},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, Krisenreaktion im Bildungsbereich, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {43--48},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:Heislbetz und Götz (2022) beleuchten die Auswirkungen der COVID-19-Pandemie auf Distanzunterricht und E-Learning in der beruflichen Fort- und Weiterbildung, insbesondere im Sozial- und Gesundheitswesen. Ziel der Studie ist es, Veränderungen in den Erwartungen und Wünschen der Teilnehmer\_innen zu untersuchen und festzustellen, wie diese durch die Pandemie beeinflusst wurden.
Verwendete Methoden und Datenquellen:Die Autoren führten eine Umfrage unter Teilnehmenden von beruflichen Fort- und Weiterbildungsprogrammen durch. Die Erhebung erfolgte in zwei Phasen: vor und während der ersten Corona-Lockdowns, um Veränderungen im Zeitverlauf zu erfassen.
Zentrale Forschungsergebnisse:Die Studie zeigt, dass vor der Pandemie bereits ein geringer Einsatz digitaler Lehrmethoden vorhanden war, der sich während des Lockdowns intensivierte. Es wurde eine erhöhte Nachfrage nach Online-Unterricht und digitalen Austauschformaten festgestellt. Die Erfahrungen der Teilnehmer\_innen mit dem Distanzlernen während der Pandemie führten zu einem veränderten Wunsch nach mehr digital unterstütztem Lernen.
Zusammenfassung
Die Forschung von Heislbetz und Götz zeigt eine signifikante Verschiebung in den Erwartungen an Distanzunterricht und E-Learning aufgrund der pandemiebedingten Notwendigkeit, Bildungsformate schnell anzupassen. Die Ergebnisse unterstreichen die Wichtigkeit, flexible und responsive Bildungsangebote zu entwickeln, die sowohl Präsenz- als auch Distanzelemente effektiv integrieren können.
Kernaussagen


"Die Corona-Pandemie führte zu einer verstärkten Nachfrage und einer positiveren Einstellung gegenüber Online-Unterricht und digitalen Lernformaten." (S. 3)


"Trotz der schnellen Anpassung an Distanzunterricht fehlt es vielen Bildungsinstituten an ausgereiften digitalen Lehrkonzepten." (S. 5)


Argumentationslinien


Die Studie argumentiert, dass die Pandemie die Notwendigkeit beschleunigt hat, digitale Lernmethoden zu implementieren, zeigt aber auch, dass die rasche Umsetzung oft zu ad-hoc Lösungen führte, die nicht immer optimal waren.


Es wird die Bedeutung von ausgereiften digitalen Bildungsangeboten hervorgehoben, die nicht nur als Notlösung dienen, sondern langfristig in das Bildungsangebot integriert werden sollten.


Verschlagwortung


Krisenreaktion im Bildungsbereich: Die Studie zeigt, wie Bildungseinrichtungen auf die plötzliche Notwendigkeit reagierten, Bildungsangebote zu digitalisieren.


Technologieintegration: Die Notwendigkeit, digitale Technologien effektiv in den Bildungsalltag zu integrieren, wird deutlich betont.


Systemanpassung: Die Anpassungsfähigkeit des Bildungssystems an plötzliche Veränderungen und die Integration neuer Lehrmethoden wird als kritisch für die Zukunft der Bildung gesehen.


Lehr- und Lerneffektivität: Die Effektivität von E-Learning-Strategien und deren Auswirkungen auf das Lernerlebnis und den Lernerfolg werden untersucht.


Kategorie: Argumentation
Diese Studie liefert wichtige Argumente für die Weiterentwicklung und strategische Planung von Distanzunterricht und E-Learning in der beruflichen Bildung. Sie verdeutlicht, dass eine schnelle Anpassung an geänderte Rahmenbedingungen möglich ist, jedoch eine langfristige strategische Planung für die Qualität und Effektivität von Bildungsangeboten entscheidend ist.
},
	file = {Heislbetz und Götz - 2022 - Distanzunterricht und E-Learning in der berufliche.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/Y9IF6FLN/Heislbetz und Götz - 2022 - Distanzunterricht und E-Learning in der berufliche.pdf:application/pdf},
}

@article{zamberg_novice_2021,
	title = {Novice and {Advanced} {Learners}’ {Satisfaction} and {Perceptions} of an e-{Learning} {Renal} {Semiology} {Module} {During} the {COVID}-19 {Pandemic}: {Mixed} {Methods} {Study}},
	volume = {7},
	issn = {2369-3762},
	shorttitle = {Novice and {Advanced} {Learners}’ {Satisfaction} and {Perceptions} of an e-{Learning} {Renal} {Semiology} {Module} {During} the {COVID}-19 {Pandemic}},
	url = {https://mededu.jmir.org/2021/2/e29216},
	doi = {10.2196/29216},
	abstract = {Background: Nephrotic syndrome is a unique clinical disorder, which provides interesting teaching opportunities that connect physiological and pathological aspects to clinical practice. During the current COVID-19 outbreak, in-person teaching in our institution was not permitted, thus creating a unique challenge for clinical skills teaching. A case-based electronic learning (e-learning) activity was designed to replace the traditional in-person teaching of renal semiology. e-Learning activities have been shown to be effective for knowledge retention and increasing novice learners’ performance. However, major knowledge gaps exist concerning the satisfaction of learners with e-learning activities as the sole form of teaching, specifically for undergraduate clinical skills education.
Objective: Our study aimed to prospectively assess undergraduate medical students’ perceptions of and satisfaction with an e-learning activity teaching renal semiology.
Methods: All second-year medical students (novice learners) from the medical faculty of the University of Geneva, Switzerland, undertook the e-learning activity and were invited to participate in a nonmandatory, validated web-based survey, comprising questions answered using a 10-point Likert scale and one qualitative open-ended question. For comparison and to provide further insights, 17 fourth- to sixth-year students (advanced learners) were prospectively recruited to participate in both the e-learning activity and the evaluation. A mixed methods analysis was performed.
Results: A total of 88 (63\%) out of 141 novice learners and all advanced learners responded to the evaluation survey. Advanced learners reported significantly higher satisfaction with the e-learning activity (mean 8.7, SD 1.0 vs mean 7.3, SD 1.8; P{\textless}.001), clarity of objectives (mean 9.6, SD 0.8 vs mean 7.7, SD 1.7; P{\textless}.001), and attainability of objectives (mean 9.8, SD 0.5 vs mean 7.3, SD 1.3; P{\textless}.001). Both groups showed high interest in the inclusion of the activity as part of a blended learning approach; however, there was low interest in the activity being the sole means of teaching.
Conclusions: Case-based e-learning activities might be better suited for advanced learners and could increase learners’ satisfaction within a blended teaching instructional design. More research on students’ satisfaction with e-learning activities in the field of clinical skills education should be done. In addition, more effort should be put into finding alternative teaching tools for clinical skills education in light of the ongoing COVID-19 pandemic and future health crises.},
	language = {en-GB},
	number = {2},
	urldate = {2021-12-12},
