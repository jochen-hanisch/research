@inproceedings{dreifuss-serrano2023Acm,
  title = {Assessing {{Cheating}} in {{MOOCs}}},
  booktitle = {2023 {{IEEE Learning}} with {{MOOCS}} ({{LWMOOCS}})},
  author = {Dreifuss-Serrano, Cristina and Herrera, Pablo C. and Reátegui, José and Braida, Frederico},
