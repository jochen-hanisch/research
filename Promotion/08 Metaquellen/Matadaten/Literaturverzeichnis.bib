@article{kopp_blended_2022,
	title = {Blended {Learning} {Fortbildung} für {Forschendes} {Lernen} im naturwissenschaftlich-technischen {Unterricht}},
	volume = {Gestaltung und Diskussion},
	copyright = {Creative Commons Attribution Share Alike 4.0 International},
	url = {https://www.herausforderung-lehrerinnenbildung.de/index.php/hlz/article/view/5386},
	doi = {10.11576/HLZ-5386},
	abstract = {In diesem Artikel wird das Konzept einer Blended-Learning-Fortbildung für Lehrkräfte zur Unterstützung von Forschendem Lernen in der Grundschule vorgestellt, das im Rahmen des Programms Experimento der Siemens Stiftung entwickelt wurde. Zielsetzungen sind die Vermittlung von fachlich-methodischem Wissen zum Forschenden Lernen und dessen Operationalisierung im Forschungskreis zum Experimentieren sowie insbesondere der Wissenstransfer auf die aktuelle Unterrichtspraxis. Um diese Ziele zu erreichen, wurde sowohl auf die Lehrmethoden des Blended Learning und problembasierten Lernens als auch auf mediendidaktische Gestaltungselemente zurückgegriffen. Mithilfe einer digitalen Lernumgebung haben die Lehrkräfte im Blended Learning die Möglichkeit, zeitlich und räumlich flexibel auf die Lerninhalte zuzugreifen, um Experimente für ihren Unterricht vorzubereiten. Im Rahmen des problembasierten Lernens werden digitale authentische Unterrichtsvideos bereitgestellt, die zahlreiche didaktische Anknüpfungspunkte zur Aufbereitung des Unterrichts bieten. Mediendidaktische Gestaltungselemente ermöglichen auch eine fokussierte inhaltliche Bearbeitung und sinnstiftende kognitive Verarbeitung. Die digitale Lehr-Lernumgebung ist allen Bildungsinteressierten nach Anmeldung frei zugänglich.},
	language = {de-DE},
	urldate = {2022-12-29},
	journal = {Herausforderung Lehrer*innenbildung - Zeitschrift zur Konzeption},
	publisher = {Herausforderung Lehrer*innenbildung - Zeitschrift zur Konzeption, Gestaltung und Diskussion},
	author = {Kopp, Birgitta and Clerc, Angela and Mandl, Heinz},
	month = dec,
	year = {2022},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Bildung, Multimedia, Promotion:FU3, \#9:Zeitschriftenartikel:digital:lernen, Promotion:S:09 Digital Lernen, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {Bd. 5 Nr. 1 (2022): Herausforderung Lehrer*innenbildungAusgabe 5},
	file = {Kopp et al. - 2022 - Blended Learning Fortbildung für Forschendes Lerne.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/QG6GE99U/Kopp et al. - 2022 - Blended Learning Fortbildung für Forschendes Lerne.pdf:application/pdf},
}

@article{schinko_didaktisches_2022,
	title = {Didaktisches {Design} für {Distance} {Education}: {Anregungen} für die {Entwicklung} von {Konzepten} bezogen auf digitale {Lernarrangements}},
	issn = {2313-1640},
	shorttitle = {Didaktisches {Design} für {Distance} {Education}},
	url = {https://journal.ph-noe.ac.at/index.php/resource/article/view/1065},
	doi = {10/gp3q5k},
	abstract = {Digitale Medien sowie Lehren und Lernen über Distanz (Distance Education) haben im Bildungsbereich nicht nur zunehmend an Bedeutung gewonnen, sondern sind spätestens seit der Covid-19 Pandemie ein das Schulsystem aufrechterhaltender Faktor geworden (Tengler, Schrammel, Brandhofer \& Sabitzer, 2020, S. 195f). Als Gelingensbedingung für erfolgreiche Distance Education sind Faktoren wie die technische Infrastruktur, Vorkenntnisse, Planung, Zeit und didaktische Organisation zu berücksichtigen (Kerres, 2018; Niedermeier \& Mandl, 2015; Kristöfl, Sandtner \& Jandl, 2006). Zudem benötigt es didaktische Designs, in deren Planung die Nutzung digitaler Medien für den Unterricht berücksichtigt wird. Es reicht nicht, digitale Medien als reine Add-on in Unterrichtskonzepte einzufügen (Kerres, 2018, S. 423). 
Dem zugrunde liegend widmet sich vorliegender Beitrag den Fragestellungen, wie durch die Implementierung digitaler Medien in didaktische Designs die Vorteile von Distance Education genutzt werden können und wie Lernarrangements aufbereitet werden könnten, um das Potenzial digitaler Medien im Unterricht bestmöglich nutzen zu können. Hierfür werden die Strukturen eines didaktischen Designs beschrieben und Anregungen für digitale Lernarrangements in der Struktur eines didaktisch-methodischen Entwicklungskreislaufes exemplarisch dargestellt sowie die Bedeutung der Evaluierung mediengestützten Lernens erläutert. Das Konzept wird am Beispiel Blended Learning vorgestellte und kann als Anregung für die Planung von Lernarrangements betrachtet werden.},
	language = {de-DE},
	number = {17},
	urldate = {2022-05-21},
	journal = {R\&E-SOURCE},
	author = {Schinko, Michaela},
	month = apr,
	year = {2022},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Bildung, Multimedia, Promotion:FU3, \#9:Zeitschriftenartikel:digital:lernen, Promotion:S:09 Digital Lernen, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	file = {Schinko - 2022 - Didaktisches Design für Distance Education Anregu.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/AUEKSVDQ/Schinko - 2022 - Didaktisches Design für Distance Education Anregu.pdf:application/pdf},
}

@article{grogorick_digitales_2021,
	title = {Digitales {Lernen} und {Lehren}: {Führt} {Corona} zu einer zeitgemäßen {Bildung}?},
	volume = {58},
	issn = {1436-3011, 2198-2775},
	shorttitle = {Digitales {Lernen} und {Lehren}},
	url = {https://link.springer.com/10.1365/s40702-021-00806-z},
	doi = {10.1365/s40702-021-00806-z},
	abstract = {Learning and teaching at universities, schools and other training facilities had to be digitally substituted by online courses almost completely to protect against Corona. But even before Corona, almost no one learned exclusively analog anymore, i.e. without digital support. (Digital) learning has been in a state of transformation for quite some time now. For this reason, this article focuses on how learning in general and possible learning formats have changed in the last years, and on how Corona has currently transformed learning at schools, universities, and other training facilities.},
	language = {de-DE},
	number = {6},
	urldate = {2021-11-28},
	journal = {HMD Praxis der Wirtschaftsinformatik},
	author = {Grogorick, Linda and Robra-Bissantz, Susanne},
	month = dec,
	year = {2021},
	note = {ZSCC: 0000000},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Bildungstheorien, Promotion:Argumentation, Krisenreaktion im Bildungsbereich, \#9:Zeitschriftenartikel:digital:lernen, Promotion:FU1, Promotion:S:09 Digital Lernen, Promotion:Dissertation {\textbar} FU1 {\textgreater} Argumentation, Promotion:Literaturverzeichnis},
	pages = {1296--1312},
	annote = {1. Analyse
Identifizierung und Beschreibung der Hauptthemen und -ziele der Forschung
Hauptthemen:


Digitalisierung des Lernens und Lehrens in Bildungseinrichtungen durch die COVID-19-Pandemie


Vergleich klassischer und neuerer Lernformate


Lerntheorien und die Rolle digitaler Medien


Hauptziele:


Untersuchung der Auswirkungen der COVID-19-Pandemie auf digitale Bildungsformate an Hochschulen, Schulen und in der Weiterbildung


Analyse, wie digitale Medien die Vielfalt und Effektivität der Lernformate beeinflussen


Evaluation der langfristigen Veränderungen und Entwicklungen im digitalen Bildungsbereich


Erkennung der verwendeten Methoden und Datenquellen
Methoden:


Literatur- und Diskursanalyse


Empirische Studien und Umfragen unter Studierenden, Lehrenden und Unternehmen


Datenquellen:


Studien und Umfragen von Institutionen wie dem Stifterverband, der Deutschen Telekom Stiftung und dem Deutschen Zentrum für Hochschul- und Wissenschaftsforschung (DZHW)


Theoretische Konzepte und Modelle zur Medienpädagogik und digitalen Bildung


Erklärung der zentralen Forschungsergebnisse
Zentrale Ergebnisse:


Die COVID-19-Pandemie hat die Digitalisierung des Bildungswesens beschleunigt und zu einer nahezu vollständigen Umstellung auf digitale Lernformate geführt.


Digitale Medien erweitern die Vielfalt der Lernformate und ermöglichen neue didaktische Ansätze, die traditionelle Methoden ergänzen.


Trotz der Herausforderungen durch die Digitalisierung, wie unzureichende technische Ausstattung und fehlende Lehrkonzepte, bietet die digitale Transformation Chancen für eine zeitgemäße und flexible Bildung.


Die Implementierung digitaler Lernformate erfordert eine Anpassung der Lehr- und Lernmethoden, um den individuellen Bedürfnissen der Lernenden gerecht zu werden.


2. Zusammenfassung
Problemstellung: Wie hat die COVID-19-Pandemie das Lernen und Lehren in Bildungseinrichtungen verändert und welche langfristigen Auswirkungen hat dies auf die Digitalisierung der Bildung?
Methodik: Literatur- und Diskursanalyse sowie empirische Studien und Umfragen unter verschiedenen Bildungseinrichtungen und Unternehmen.
Hauptergebnisse:


Beschleunigte Digitalisierung des Bildungswesens durch die COVID-19-Pandemie.


Erweiterung der Lernformate durch digitale Medien und neue didaktische Ansätze.


Herausforderungen bei der technischen Ausstattung und der Entwicklung von Lehrkonzepten.


Chancen für eine flexible und zeitgemäße Bildung durch digitale Transformation.


Schlussfolgerungen: Die COVID-19-Pandemie hat das Potenzial, das Bildungssystem langfristig zu verändern, indem sie die Digitalisierung vorantreibt und neue Lernformate etabliert. Eine gezielte Unterstützung und Weiterentwicklung digitaler Bildungsangebote ist notwendig, um diese Chancen zu nutzen.
3. Kernaussagen
Wichtige Aussagen und Befunde:


Beschleunigte Digitalisierung: Die COVID-19-Pandemie hat die Digitalisierung des Lernens und Lehrens stark beschleunigt (S. 1297).


Vielfalt der Lernformate: Digitale Medien erweitern die Vielfalt der Lernformate und ermöglichen innovative didaktische Ansätze (S. 1302-1303).


Herausforderungen und Chancen: Die Digitalisierung bringt Herausforderungen, aber auch Chancen für eine flexible und zeitgemäße Bildung mit sich (S. 1306-1307).


4. Argumentationslinien
Aufbau der Argumente:


Einführung: Darstellung der Auswirkungen der COVID-19-Pandemie auf das Bildungswesen und die Notwendigkeit der Digitalisierung (S. 1297-1298).


Hauptteil: Analyse der verschiedenen Lernformate, Lerntheorien und die Rolle digitaler Medien (S. 1299-1305).


Schluss: Diskussion der langfristigen Veränderungen und Potenziale der Digitalisierung im Bildungsbereich (S. 1306-1310).


5. Verschlagwortung


Lehr- und Lerneffektivität: Begründung: Der Artikel untersucht, wie die Digitalisierung des Bildungswesens die Effektivität von Lehr- und Lernprozessen durch neue Lernformate und didaktische Ansätze verbessern kann.


Technologieintegration: Begründung: Der Artikel behandelt die Integration digitaler Medien in den Bildungsbereich und die damit verbundenen Herausforderungen und Chancen.


Bildungstheorien: Begründung: Der Artikel diskutiert verschiedene Lerntheorien und ihre Anwendung im Kontext digitaler Medien und Lernformate.


Systemanpassung: Begründung: Der Artikel beschreibt die Anpassung des Bildungssystems an die Anforderungen der Digitalisierung und die notwendigen Veränderungen der Lehr- und Lernmethoden.


Krisenreaktion im Bildungsbereich: Begründung: Der Artikel thematisiert, wie die COVID-19-Pandemie als Katalysator für die Digitalisierung im Bildungsbereich gewirkt hat.


6. Kategorisiere
Kategorie: Argumentation
Kriterium: Nutzung von Quellen oder Theorien zur Unterstützung oder Widerlegung einer These oder Fragestellung.
Beispiel: Der Artikel argumentiert, dass die COVID-19-Pandemie die Digitalisierung des Bildungswesens beschleunigt hat und stützt diese These durch empirische Daten und theoretische Überlegungen zur Rolle digitaler Medien und neuer Lernformate.
7. Zuordnung zu Forschungsfragen
Passende Forschungsfrage: FU1: Welche Akzeptanz und Nützlichkeit (Bedeutung) beschreiben Akteure im digitalen Bildungsraum von Gesundheitsberufen bei Anwendung eines Learning-Management-Systems?
Begründung: Der Artikel untersucht die Akzeptanz und Nützlichkeit digitaler Lernformate und Medien im Bildungswesen, was direkt auf die Forschungsfrage FU1 zutrifft.
},
	file = {Grogorick und Robra-Bissantz - 2021 - Digitales Lernen und Lehren Führt Corona zu einer.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/7QMJJEJ7/Grogorick und Robra-Bissantz - 2021 - Digitales Lernen und Lehren Führt Corona zu einer.pdf:application/pdf},
}

