@article{michael_influence_2021,
	title = {The influence of teaching attitudes and digital competencies on virtual higher education {teachingDer} {Einfluss} von {Lehr}-{Einstellungen} und digitalen {Kompetenzen} auf die virtuelle {Lehre}},
	url = {10.3217/ZFHE-16-03/07},
	doi = {10.3217/zfhe-16-03/07},
	abstract = {The design and implementation of virtual courses is influenced by the different teaching approaches of university lecturers as well as their individual levels of competence in digital (teaching) skills. This paper presents the empirical results of a study which showed that a student-centered teaching approach is particularly advantageous for the design of virtual teaching and that the development of digital competencies is one key to the successful implementation of digital educational formats. To this end, the paper also discusses the implications of the current findings for the creation of advanced training programmes designed to provide HEI educators with the digital competences needed in teaching and learning settings.},
	language = {de-DE},
	urldate = {2021-11-05},
	publisher = {Verlag der Technischen Universität Graz \& Verein Forum neue Medien in der Lehre Austria},
	author = {Michael, Eichhorn and Alexander, Tillmann and Hendrik, Drachsler},
	month = oct,
	year = {2021},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:FU4a, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Bildungstheorien, \#0:Zeitschriftenartikel:digital:learning, Promotion:S:12 Digital Learning, Promotion:Literaturverzeichnis},
	annote = {Analyse des Artikels „Der Einfluss von Lehr-Einstellungen und digitalen Kompetenzen auf die virtuelle Lehre“ von Eichhorn, Tillmann und Drachsler (2021)
1. Hauptthemen und Ziele der Forschung
Der Artikel untersucht, wie die Lehr-Einstellungen (studierendenzentriert vs. lehrendenzentriert) und digitalen Kompetenzen von Hochschullehrenden die Gestaltung und Durchführung virtueller Lehre beeinflussen. Ziel der Studie war es, die Auswirkungen dieser Variablen auf die Qualität der virtuellen Lehre während der pandemiebedingten Umstellung zu analysieren und daraus Implikationen für mediendidaktische Qualifikationen abzuleiten.

2. Methoden und Datenquellen


Design: Quantitative Online-Befragung (Vollerhebung) unter 396 Hochschullehrenden einer deutschen Universität im Sommersemester 2020.


Messinstrumente:


Lehreinstellungen: Approaches to Teaching Inventory (ATI-R), deutsche Version (Lübeck, 2009).


Digitale Kompetenzen: Frankfurter Modell digitaler Kompetenzen, mit den Dimensionen:


Gestaltung digitaler Lehre.


Digitale Medienproduktion.


Kommunikation/Kollaboration.


IT-Bedienkompetenz.




Weitere Variablen: Wahrnehmung von Autonomie, Kompetenz, sozialer Eingebundenheit sowie Interesse an digitalen Formaten.




Datenauswertung: Statistische Analyse mit Korrelations- und Mediationsanalysen.



3. Zentrale Forschungsergebnisse


Lehreinstellungen:


Studierendenzentrierte Lehrende (SF) passten ihre Methoden besser an virtuelle Formate an und nutzten mehr asynchrone Formate wie Forendiskussionen und Peer-Feedback.


Lehrendenzentrierte Lehrende (TF) neigten dazu, ihre bisherigen Präsenzmethoden direkt zu übertragen.




Digitale Kompetenzen:


Beide Gruppen bewerteten ihre digitalen Kompetenzen als überdurchschnittlich, wobei TF-Lehrende in der Medienproduktion leicht bessere Bewertungen erzielten.




Zusammenhang zwischen Kompetenzen und Motivation:


Höhere digitale Kompetenzen korrelierten signifikant mit:


Wahrgenommenem Autonomie- und Kompetenzerleben (r = .28 bzw. r = .47, p {\textless} .01).


Interesse und Motivation für digitale Lehrformate (r = .43, p {\textless} .01).




Digitale Kompetenzen beeinflussten positiv die Wahrnehmung der Studierenden (weniger Überforderung und höhere Beteiligung).




Feedback in der Lehre:


SF-Lehrende setzten sowohl in Präsenz- als auch in virtuellen Formaten häufiger Feedback ein, was zur Förderung des Lernerfolgs beitrug.





Zusammenfassung
Der Artikel zeigt, dass digitale Kompetenzen und studierendenzentrierte Lehransätze Schlüssel für erfolgreiche virtuelle Lehre sind. SF-Lehrende nutzten virtuelle Möglichkeiten kreativer und anpassungsfähiger, während TF-Lehrende eher bewährte Methoden beibehielten. Die digitale Kompetenz beeinflusst nicht nur die Lehre, sondern auch die Motivation der Lehrenden und das Engagement der Studierenden.

Kernaussagen


Lehransatz ist entscheidend: Studierendenzentrierte Ansätze fördern flexible und innovative Nutzung digitaler Formate. (S. 128)


Digitale Kompetenzen sind Schlüsselfaktoren: Sie steigern die Wahrnehmung von Autonomie, Kompetenz und sozialer Eingebundenheit. (S. 132)


Feedback fördert Lernerfolg: SF-Lehrende setzen häufiger Feedback ein, was auch in virtuellen Formaten eine Schlüsselrolle spielt. (S. 130)



Argumentationslinien
Die Autor:innen argumentieren, dass der Aufbau digitaler Kompetenzen und die Reflexion der eigenen Lehrendenrolle für die nachhaltige Implementierung virtueller Lehrformate essenziell sind. Sie empfehlen mediendidaktische Qualifikationen, um lehrendenzentrierte Lehrende zu befähigen, ihre Ansätze zu überdenken und flexibler auf digitale Formate einzugehen. (S. 134)

Verschlagwortung


Bildungstheorien:Begründung: Der Artikel diskutiert die Bedeutung studierendenzentrierter Ansätze im Kontext der Selbstbestimmungstheorie. (S. 123)


Lehr- und Lerneffektivität:Begründung: Fokus auf die Verbesserung von Lehre durch digitale Kompetenzen und innovative Ansätze. (S. 132)


Technologieintegration:Begründung: Die Studie zeigt, wie digitale Werkzeuge und Formate effektiv in die Hochschullehre integriert werden können. (S. 125)



Kategorisierung
Kerngedanke: Digitale Kompetenzen und studierendenzentrierte Ansätze sind essenziell für die Gestaltung effektiver virtueller Lehre. (S. 133)

Zuordnung zur Forschungsunterfrage
Passendste Forschungsunterfrage:FU4a: „Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum beschrieben?“
Begründung: Der Artikel zeigt, wie digitale Kompetenzen und pädagogische Ansätze die Gestaltung digitaler Bildungsräume beeinflussen können.

Relevanzbewertung


Hoch relevant (5): Die Studie liefert wichtige empirische Daten zur Verbindung von Lehransätzen, digitalen Kompetenzen und Lernerfolg in virtuellen Formaten.


},
	file = {Michael et al. - The influence of teaching attitudes and digital co.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/CYCZ97W4/Michael et al. - The influence of teaching attitudes and digital co.pdf:application/pdf},
}

@techreport{karin_competence_2021,
	type = {Werkstattbericht},
	title = {Competence acquisition in a digital environment: {Wie} eine {Plattform} zur länderübergreifenden kompetenzorientierten, digitalen {Lehre} {beiträgtKompetenzen} digital vermitteln: {Wie} eine {Plattform} zur länderübergreifenden kompetenzorientierten, digitalen {Lehre} beiträgt},
	shorttitle = {Competence acquisition in a digital environment},
	url = {https://zfhe.at/index.php/zfhe/article/view/1491},
	abstract = {The use of digital formats for university teaching has increased, not least due to the COVID-19 pandemic. In particular because social and technical skills are equally relevant for the professional world, researchers developed a digitisation platform in the ERASMUS+ project OSMP that contributes to the international networking of teachers and learners and combines professional content with practical learning settings to develop communication and conflict resolution skills. This is achieved by providing study materials and self-produced videos or mock mediation trainings, which enable an application-oriented preparation for worklife.},
	language = {de-DE},
	urldate = {2021-07-08},
	institution = {Verlag der Technischen Universität Graz \& Verein Forum neue Medien in der Lehre Austria},
	author = {Karin, Sonnleitner},
	month = jun,
	year = {2021},
	note = {ZSCC: NoCitationData[s0]},
	keywords = {Promotion:Literaturanalyse, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Promotion:FU3, \#0:Bericht:digital:learning, Promotion:S:13 Berichte, Promotion:Literaturverzeichnis},
	pages = {181--193},
	annote = {Hier ist die strukturierte Analyse und Zusammenfassung des Artikels „Kompetenzen digital vermitteln: Wie eine Plattform zur länderübergreifenden kompetenzorientierten, digitalen Lehre beiträgt“ von Karin Sonnleitner (2024):

Analyse
1. Hauptthemen und Ziele der Forschung


Hauptthemen:


Entwicklung und Implementierung einer digitalen Plattform zur Förderung von Fach- und Sozialkompetenzen im Rahmen des Erasmus+ Projekts OSMP.


Verknüpfung von theoretischen Inhalten mit praxisorientierten Lernsettings, um Kommunikations- und Konfliktlösungskompetenzen zu entwickeln.




Ziele:


Förderung der internationalen Vernetzung von Lehrenden und Studierenden.


Bereitstellung innovativer didaktischer Werkzeuge, wie Mock-Mediationstrainings, für anwendungsorientiertes Lernen.




2. Methoden und Datenquellen


Methoden:


Entwicklung und Evaluation einer digitalen Lernplattform in Kooperation mit internationalen Partneruniversitäten.


Integration von praxisorientierten Elementen wie Lehrvideos, Rollenspielen und interaktiven Übungen.




Datenquellen:


Studienmaterialien, selbstproduzierte Lehrvideos und Mock-Mediationswettbewerbe, die auf der Plattform zugänglich gemacht wurden.




3. Zentrale Forschungsergebnisse


Digitale Plattform:


Die Plattform bietet offene Bildungsressourcen (OER) mit Fokus auf die Verknüpfung von Fachwissen und sozialen Kompetenzen.


Mock-Mediationen ermöglichen praxisnahes Training und stärken interkulturelle Kompetenzen.




Lehr-Lern-Prozesse:


Kombination aus selbstgesteuertem Lernen und Echtzeit-Übungen verbessert die Praxistransferfähigkeit.


Die internationale Zusammenarbeit in Summer Schools und Wettbewerben fördert Vernetzung und Erfahrungslernen.




Herausforderungen:


Eingewöhnung in die Plattformstruktur war für einige Lernende anfangs schwierig.


Virtuelle Mobilität kann internationale Face-to-Face-Interaktionen nicht vollständig ersetzen.





Zusammenfassung
Der Artikel stellt eine innovative digitale Lernplattform vor, die im Rahmen des Erasmus+ Projekts OSMP entwickelt wurde. Die Plattform kombiniert theoretische Inhalte mit praxisnahen Übungen, wie Mock-Mediationstrainings, um soziale und fachliche Kompetenzen zu fördern. Durch internationale Zusammenarbeit und digitale Tools trägt das Projekt zur Kompetenzentwicklung und Vernetzung von Lehrenden und Studierenden bei.

Kernaussagen


Integration von Theorie und Praxis: Lehrvideos und Mock-Mediationen ermöglichen praxisnahes Lernen und stärken soziale Kompetenzen (S. 187-188).


Internationale Vernetzung: Summer Schools und Mock-Wettbewerbe fördern interkulturelle Kompetenzen und Netzwerke (S. 185-186).


Offene Bildungsressourcen: Die Plattform bietet frei zugängliche Inhalte und unterstützt Blended Learning (S. 189).



Argumentationslinien


Hauptthese: Digitale Plattformen können durch die Verknüpfung von Fach- und Sozialkompetenzen einen signifikanten Beitrag zur internationalen Hochschulbildung leisten.


Unterstützende Evidenz: Mock-Mediationstrainings und praxisorientierte Inhalte steigern die Praxistransferfähigkeit der Studierenden (S. 187-190).


Implikationen: Virtuelle Mobilität ergänzt, ersetzt jedoch nicht vollständig den direkten internationalen Austausch (S. 191).



Verschlagwortung


Technologieintegration: Nutzung digitaler Plattformen zur Förderung internationaler Zusammenarbeit.


Lehr- und Lerneffektivität: Kombination von theoretischen Inhalten und praxisorientierten Übungen.


Kollaboratives Lernen: Förderung interkultureller und kommunikativer Kompetenzen durch Mock-Mediationen.



Kategorisierung
Kategorie: KerngedankeBegründung: Der Artikel analysiert die Kernkomponenten einer innovativen Plattform, die gezielt zur Kompetenzförderung in digitalen Bildungskontexten beiträgt.

Zuordnung zu Forschungsfragen


Passendste Forschungsfrage: FU3: Wie sind Konzeption und relevante didaktische und bildungstechnologische Merkmale des systemisch-konstruktivistischen Learning-Management-Systems für Akteure im digitalen Bildungsraum von Gesundheitsberufen dargestellt?


Begründung: Der Artikel beschreibt die Gestaltung einer Plattform, die digitale und kollaborative Elemente integriert, um praktische Kompetenzen zu fördern.



Relevanzbewertung


Aktualität: 5 (Veröffentlichung 2024, hoch relevant).


Direkte Relevanz: 5 (Wichtige Erkenntnisse für die Digitalisierung und Internationalisierung in der Hochschulbildung).


Gesamtbewertung: 5 (Essentiell für Bildungsforschung und -praxis).


},
	annote = {SeriesInformation
Zeitschrift für HochschulentwicklungSeriesInformation
Zeitschrift für Hochschulentwicklung (Journal for Higher Education Development)},
	file = {Karin - Competence acquisition in a digital environment W.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/UL7NNYQS/Karin - Competence acquisition in a digital environment W.pdf:application/pdf},
}

@article{falloon_exploration_2024,
	title = {An exploration of online technoliteracy capability teaching and learning in early years classrooms},
	volume = {29},
	issn = {1360-2357, 1573-7608},
	url = {https://link.springer.com/10.1007/s10639-023-12239-w},
	doi = {10.1007/s10639-023-12239-w},
	abstract = {The increasing use of digital devices by young children, has led to calls for earlier teaching for information literacy. However, some research indicates reluctance to do this, due to perceived limitations of young children and notions about what is and is not ‘appropriate’ for them learn. This study examines this proposition, through analysis of 6 and 7 year olds’ application of ‘Technoliteracy’ capabilities during a unit of learning about Matariki (the Maori new year). It used an updated and expanded revision of Durrant and Green’s (2000) l(IT)eracy capability model, to understand how the students applied ‘Technoliteracy’ capabilities to online research and production of an information artefact for an identified audience. Although results were mixed, data was found of students’ productive engagement of ‘Technoliteracy’ capabilities aligned with Durrant and Green’s dimensions, suggesting that with developmentally-appropriate curriculum and pedagogy they were capable of integrating these for meaning making, judging meaning quality, and meaning sharing and communication. Given increasingly ubiquitous access to devices from a young age, results indicate that serious consideration should be given to teaching basic ‘Technoliteracy’ capabilities in early years classrooms.},
	language = {en-GB},
	number = {1},
	urldate = {2024-01-10},
	journal = {Education and Information Technologies},
	author = {Falloon, Garry},
	month = jan,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Kollaboratives Lernen, Lehr- und Lerneffektivität, Bewertungsmethoden, Promotion:FU2a, Promotion:Argumentation, Promotion:Relevanz:4, \#0:Zeitschriftenartikel:digital:learning, Promotion:S:12 Digital Learning, Promotion:Literaturverzeichnis},
	pages = {625--654},
	annote = {Analyse der Studie "An exploration of online technoliteracy capability teaching and learning in early years classrooms" von Falloon (2024) wurde durchgeführt. Hier ist die strukturierte Darstellung entsprechend deiner Vorgaben:

1. Hauptthemen und Ziele der Forschung
Die Studie untersucht die Technoliteracy-Fähigkeiten junger Schüler (6–7 Jahre) bei der Anwendung digitaler Technologien für Informationsrecherche und die Erstellung digitaler Artefakte. Die Arbeit analysiert, inwiefern ein strukturierter Lehransatz in der Grundschule dazu beiträgt, Technoliteracy-Fähigkeiten zu entwickeln, insbesondere in den Bereichen Informationsbewertung und -verarbeitung.
2. Methoden und Datenquellen
Methoden:


Fallstudienansatz: Daten wurden in einer Grundschule in Neuseeland erhoben.


Beobachtung und Videoanalyse: Die Arbeit mit digitalen Geräten (Tablets) wurde aufgezeichnet und detailliert analysiert.


Qualitative Inhaltsanalyse: Codierung der Interaktionen gemäß dem revidierten Modell von Durrant und Green (2000).


Datenquellen:


37 Stunden und 27 Minuten Bildschirm- und Audiomaterial von Schülerpaaren, die in einem Unterrichtsprojekt eine digitale Informationspräsentation erstellten.


Analyse von Dialogen und Interaktionen in Bezug auf den Umgang mit digitalen Ressourcen.



3. Zentrale Forschungsergebnisse


Technoliteracy-Fähigkeiten sind entwickelbar: Junge Schüler können unter Anleitung gezielt digitale Recherche- und Bewertungsmethoden erlernen.


Operational vs. Kognitive Fähigkeiten: Technische Kompetenzen (Suchstrategien, Nutzung digitaler Tools) beeinflussen direkt die Fähigkeit zur kritischen Informationsbewertung.


Unterrichtsstruktur als entscheidender Faktor: Eine sequenziell aufgebaute und gezielt modellierte Unterrichtsstruktur ist essenziell für die Entwicklung von Technoliteracy.


Informationsbewertung noch begrenzt: Während grundlegende Fähigkeiten zur Quellenkritik beobachtet wurden, bleibt die Fähigkeit zur differenzierten Bewertung von Online-Informationen begrenzt.


Assistive Technologien erleichtern den Zugang: Schüler mit schwächeren Lese- und Sprachfähigkeiten profitierten stark von Funktionen wie Text-to-Speech.



4. Zusammenfassung
Die Studie zeigt, dass selbst sehr junge Schüler Technoliteracy-Fähigkeiten entwickeln können, wenn diese gezielt im Unterricht gefördert werden. Eine Kombination aus technischem Training und kritisch-reflexiven Aufgaben verbessert die Fähigkeit, Online-Informationen sinnvoll zu nutzen. Die Ergebnisse sprechen für eine frühzeitige Integration solcher Kompetenzen in den Schulunterricht.

5. Kernaussagen (mit Fundstellen)


Technoliteracy kann im frühen Alter entwickelt werden: Schüler können gezielt digitale Recherche- und Bewertungstechniken erlernen, wenn der Unterricht methodisch strukturiert ist. (S. 631)


Digitale Assistenzsysteme fördern Lernprozesse: Funktionen wie Text-to-Speech helfen Schülern mit schwächeren Lese- und Sprachfähigkeiten, sich mit digitalen Inhalten auseinanderzusetzen. (S. 640)


Effektive Nutzung digitaler Medien erfordert mehr als technische Fähigkeiten: Der Lernerfolg hängt stark von der Qualität der Unterrichtsstruktur und den angewendeten didaktischen Methoden ab. (S. 651)



6. Argumentationslinien


Die Studie belegt, dass Lehrpläne für die frühkindliche Bildung digitale Kompetenzen explizit fördern sollten, um Schüler systematisch auf Informationsrecherche und -bewertung vorzubereiten. (S. 650)


Operational-technische Fähigkeiten allein reichen nicht aus – es braucht eine Verbindung zu kognitiven und kritischen Bewertungsprozessen. (S. 648)


Eine methodisch strukturierte Didaktik kann eine nachhaltige Kompetenzentwicklung in der Technoliteracy sicherstellen. (S. 651)



7. Verschlagwortung


Lehr- und Lerneffektivität: Die Studie zeigt, wie durch gezielte pädagogische Maßnahmen die Effektivität des Technoliteracy-Lernens gesteigert werden kann.


Kollaboratives Lernen: Die Arbeit mit Tablets wurde in Paararbeit organisiert, wodurch soziale und kommunikative Aspekte des Lernens gestärkt wurden.


Bewertungsmethoden: Die Arbeit untersucht, inwiefern Schüler in der Lage sind, Online-Informationen zu bewerten und kritisch zu hinterfragen.


Forschungsansätze: Die methodische Vorgehensweise basiert auf einem qualitativen Fallstudienansatz mit einer detaillierten Analyse von Schülerinteraktionen.



8. Kategorisierung
Kerngedanke:Die Studie zeigt, dass Technoliteracy eine essenzielle Kompetenz ist, die bereits in jungen Jahren durch gezielte didaktische Strategien aufgebaut werden kann. Dies widerlegt bestehende Annahmen über die begrenzte Fähigkeit junger Kinder, digitale Informationen kritisch zu verarbeiten. (S. 651)

9. Zuordnung zur Forschungsunterfrage (FU)
Passendste Forschungsunterfrage:FU2a: Welchen Effekt erläutern Lernende im digitalen Bildungsraum von Gesundheitsberufen bei der Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems?
Begründung:Die Studie untersucht, wie Schüler durch eine gezielte pädagogische Strategie Technoliteracy-Kompetenzen erwerben. Diese Ergebnisse sind relevant für die Untersuchung, wie Lernende in digitalen Bildungsräumen Wissen konstruieren und verarbeiten.

10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie befasst sich direkt mit der Entwicklung digitaler Kompetenzen im Bildungskontext).


Zitierhäufigkeit und Einfluss: 4 (Die Studie ist aktuell und methodisch solide, auch wenn sie eine spezifische Altersgruppe betrachtet).


Aktualität: 5 (Veröffentlichung im Jahr 2024, hochaktuell).


Gesamtbewertung: 4.7 (Hoch relevant)

11. Schlussfolgerung
Die Studie zeigt, dass Technoliteracy bereits im frühen Kindesalter gefördert werden kann und sollte. Eine strukturierte Didaktik ist entscheidend für den Erwerb dieser Kompetenzen. Für den digitalen Bildungsraum bedeutet dies, dass entsprechende methodische Ansätze notwendig sind, um Technoliteracy systematisch aufzubauen und eine kritische Medienkompetenz langfristig zu verankern.
},
	file = {Falloon - 2024 - An exploration of online technoliteracy capability.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/AJPISDN7/Falloon - 2024 - An exploration of online technoliteracy capability.pdf:application/pdf},
}

