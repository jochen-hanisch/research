	keywords = {Humans, Tomography, X-Ray Computed, Early Detection of Cancer, Neural Networks, Computer, Image Processing, Computer-Assisted, Deep Learning, Computers, Bone Neoplasms, Osteosarcoma, Promotion:04-04:4.4.4, Promotion:4.4.4 Dreidimenionale Clusteranalyse, Promotion:Literaturverzeichnis},
	pages = {2144},
	file = {Volltext:/Users/jochenhanisch-johannsen/Zotero/storage/CRGPGM2Y/Sampath et al. - 2024 - A comparative analysis of CNN-based deep learning .pdf:application/pdf},
