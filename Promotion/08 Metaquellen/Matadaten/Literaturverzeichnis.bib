	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Technologieintegration, Bewertungsmethoden, Lernsystemarchitektur, Promotion:Literaturverzeichnis},
	pages = {242--273},
	annote = {Yang et al. (2024)


