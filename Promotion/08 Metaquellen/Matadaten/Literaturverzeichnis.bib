	address = {Wiesbaden},
	title = {Digitalisierung der {Hochschullehre} – {Ein} neues {Normal}?: {Das} bayerische {Projekt} {NewNormal} als didaktisches {Entwicklungsprojekt}},
	isbn = {978-3-658-45214-8 978-3-658-45215-5},
