},
	file = {PDF:/Users/jochenhanisch-johannsen/Zotero/storage/2PU6Z7J5/Rieser und Adl-Amini - 2025 - Gemeinsame Steuerung des Lernprozesses beim kooperativen Lernen Eine explorative Untersuchung der P.pdf:application/pdf},
}

