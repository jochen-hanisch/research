@article{su_applying_2021,
	title = {Applying {Educational} {Data} {Mining} to {Explore} {Viewing} {Behaviors} and {Performance} {With} {Flipped} {Classrooms} on the {Social} {Media} {Platform} {Facebook}},
	volume = {12},
	issn = {1664-1078},
	url = {https://www.frontiersin.org/articles/10.3389/fpsyg.2021.653018/full},
	doi = {10.3389/fpsyg.2021.653018},
	abstract = {In recent years, learning materials have gradually been applied to ﬂipped classrooms. Teachers share learning materials, and students can preview the learning materials before class. During class, the teacher can discuss students’ questions from their notes from previewing the learning materials. The social media platform Facebook provides access to learning materials and diversiﬁed interactions, such as sharing knowledge, annotating learning materials, and establishing common objectives. Previous studies have explored the effect of ﬂipped classrooms on students’ learning engagement, attitudes, and performance. In this paper, we apply educational data mining to explore the relationship between students’ viewing behaviors in accessing learning materials and their performance in ﬂipped classrooms. The participants are classiﬁed into an experimental group and a control group to engage in ﬂipped classroom activities. The experimental group uses the social media platform Facebook for ﬂipped learning, and the control group uses a learning management system for ﬂipped learning. The results show that there is a signiﬁcant difference in the learning performance between the two groups, with the average score of the experimental group being higher than that of the control group. Furthermore, we ﬁnd that the viewing behaviors and performance of the students within the experimental group differ signiﬁcantly.},
	language = {en-GB},
	urldate = {2024-06-28},
	journal = {Frontiers in Psychology},
	author = {Su, Yu-Sheng and Lai, Chin-Feng},
	month = apr,
	year = {2021},
	keywords = {Promotion:Literaturanalyse, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Bewertungsmethoden, \#1:Zeitschriftenartikel:learning:management:system, Promotion:FU3, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {653018},
	file = {Su und Lai - 2021 - Applying Educational Data Mining to Explore Viewin.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/JB29HH5M/Su und Lai - 2021 - Applying Educational Data Mining to Explore Viewin.pdf:application/pdf},
}

@article{aksoy_performance_2019,
	title = {Performance {Monitoring} via {Functional} {Near} {Infrared} {Spectroscopy} for {Virtual} {Reality} {Based} {Basic} {Life} {Support} {Training}},
	volume = {13},
	issn = {1662-453X},
	url = {https://www.frontiersin.org/article/10.3389/fnins.2019.01336/full},
	doi = {10.3389/fnins.2019.01336},
	abstract = {The use of serious game tools in training of medical professions is steadily growing. However, there is a lack of reliable performance assessment methods to evaluate learner’s outcome. The aim of this study is to determine whether functional near infrared spectroscopy (fNIRS) can be used as an additional tool for assessing the learning outcome of virtual reality (VR) based learning modules. The hypothesis is that together with an improvement in learning outcome there would be a decrease in the participants’ cerebral oxygenation levels measured from the prefrontal cortex (PFC) region and an increase of participants’ serious gaming results. To test this hypothesis, the subjects were recruited and divided into four groups with different combinations of prior virtual reality experience and prior Basic Life Support (BLS) knowledge levels. A VR based serious gaming module for teaching BLS and 16-Channel fNIRS system were used to collect data from the participants. Results of the participants’ scores acquired from the serious gaming module were compared with fNIRS measures on the initial and ﬁnal training sessions. Kruskal Wallis test was run to determine any signiﬁcant statistical difference between the groups and Mann–Whitney U test was utilized to obtain pairwise comparisons. BLS training scores of the participants acquired from VR based serious game’s the learning management system and fNIRS measurements revealed decrease in use of resources from the PFC, but increase in behavioral performance. Importantly, brain-based measures can provide an additional quantitative metric for trainee’s expertise development and can assist the medical simulation instructors.},
	language = {en-GB},
	urldate = {2024-06-28},
	journal = {Frontiers in Neuroscience},
	author = {Aksoy, Emin and Izzetoglu, Kurtulus and Baysoy, Engin and Agrali, Atahan and Kitapcioglu, Dilek and Onaral, Banu},
	month = dec,
	year = {2019},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Bewertungsmethoden, Promotion:Relevanz:4, Promotion:Weiterführung, \#1:Zeitschriftenartikel:learning:management:system, Promotion:FU4b, Promotion:S:01 Learning Management System, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {1336},
	annote = {Analyse des Artikels "Performance Monitoring via Functional Near Infrared Spectroscopy for Virtual Reality Based Basic Life Support Training" von Aksoy et al. (2019)
1. Analyse
Hauptthemen und -ziele der Forschung: Der Artikel untersucht die Nutzung von funktioneller Nahinfrarotspektroskopie (fNIRS) zur Leistungsüberwachung in einem VR-basierten Training für Basismaßnahmen der Wiederbelebung (Basic Life Support, BLS). Ziel ist es, festzustellen, ob fNIRS als zusätzliches Werkzeug zur Bewertung der Lernergebnisse von VR-basierten Lernmodulen verwendet werden kann.
Verwendete Methoden und Datenquellen:


Methodische Ansätze: Experimentelle Studie mit vier Gruppen, die sich durch unterschiedliche Vorerfahrungen mit VR und BLS unterscheiden.


Werkzeuge und Datenquellen: VR-basiertes Serious-Game-Modul, 16-Kanal-fNIRS-System, Kruskal-Wallis-Test und Mann-Whitney-U-Test zur statistischen Analyse.


Zentrale Forschungsergebnisse:


Lernleistung: Signifikante Verbesserung der BLS-Leistung in den Gruppen ohne vorherige BLS-Kenntnisse. Die Gruppe mit vorheriger VR-Erfahrung zeigte keine signifikanten Leistungssteigerungen.


fNIRS-Ergebnisse: Eine signifikante Reduktion der Hirnaktivität in der präfrontalen Cortex (PFC)-Region wurde bei den meisten Teilnehmern festgestellt, was auf eine reduzierte kognitive Arbeitsbelastung bei zunehmender Aufgabenvertrautheit hinweist.


2. Zusammenfassung
Kernpunkte des Artikels:


Problemstellung: Untersuchung der Eignung von fNIRS zur Leistungsüberwachung in VR-basierten BLS-Trainingsmodulen.


Methodik: Experimentelle Studie mit 22 Teilnehmern, die in vier Gruppen aufgeteilt wurden.


Hauptergebnisse: Signifikante Leistungsverbesserungen und reduzierte kognitive Arbeitsbelastung bei Teilnehmern ohne vorherige BLS-Kenntnisse.


Schlussfolgerungen: fNIRS kann als zusätzliches Bewertungsinstrument zur Überwachung der kognitiven Arbeitsbelastung während des Trainings eingesetzt werden.


3. Kernaussagen


Leistungsüberwachung: „fNIRS can be used as a complementary tool for assessing the real performance of the trainee by monitoring cognitive workload during training sessions.“ (S. 7)


Lernleistung: „The VR based serious gaming module used for this study had a positive effect on learning the content of BLS for the groups without prior BLS knowledge.“ (S. 6)


Kognitive Arbeitsbelastung: „A significant reduction in the amount of PFC activation is expected with increased task familiarity and skill acquisition.“ (S. 6)


4. Argumentationslinien


Bedeutung der fNIRS: Der Artikel argumentiert, dass fNIRS eine nützliche Ergänzung zur Bewertung von Lernfortschritten und kognitiver Arbeitsbelastung in VR-basierten Trainings sein kann.


Nutzung von Serious Games: Es wird betont, dass VR-basierte Serious Games effektiv zur Vermittlung von BLS-Inhalten eingesetzt werden können.


Reduzierte kognitive Arbeitsbelastung: Der Artikel hebt hervor, dass die reduzierte Aktivierung der PFC-Region auf eine zunehmende Aufgabenvertrautheit und damit verbundene Lernfortschritte hinweist.


5. Verschlagwortung


Lehr- und Lerneffektivität


Begründung: Der Artikel untersucht die Effektivität von VR-basierten Trainingsmodulen und deren Auswirkungen auf die Lernleistung.


Fundstelle: S. 6




Bewertungsmethoden


Begründung: Die Studie verwendet fNIRS als Methode zur Bewertung der kognitiven Arbeitsbelastung und Lernleistung.


Fundstelle: S. 6




Technologieintegration


Begründung: Der Artikel befasst sich mit der Integration von VR und fNIRS in medizinische Trainingsprogramme.


Fundstelle: S. 6




6. Kategorisierung


Kategorie: Weiterführung


Kriterium: Der Artikel schlägt vor, fNIRS mit anderen Bewertungsalgorithmen in zukünftigen Studien zu kombinieren.


Beispiel: Der Artikel diskutiert die Möglichkeit, fNIRS-Messungen mit den Scoring-Algorithmen anderer Serious-Gaming-Module zu kombinieren.




7. Zuordnung zu Forschungsfragen


FU4b: Welche technisch-gestalterische Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?


Begründung: Der Artikel untersucht die technischen und gestalterischen Aspekte der Integration von fNIRS und VR in medizinische Trainingsprogramme.


Fundstelle: S. 6




8. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 4/5


Der Artikel bietet wertvolle Einblicke in die technische Integration und Bewertung von VR-basierten Trainingsmodulen.




Zitierhäufigkeit und Einfluss des Artikels: 4/5


Aufgrund der innovativen Nutzung von fNIRS zur Leistungsüberwachung hat der Artikel das Potenzial, in akademischen Kreisen einflussreich zu sein.




Aktualität des Artikels: 5/5


Veröffentlicht im Jahr 2019, ist der Artikel aktuell und relevant für die neuesten Entwicklungen in der medizinischen Ausbildungstechnologie.




Gesamtbewertung: 4/5
Diese Analyse zeigt die Relevanz des Artikels für die Untersuchung der Integration und Bewertung von VR-basierten Trainingsmodulen und bietet wertvolle Einblicke für zukünftige Forschungen und Praktiken.
},
	file = {Aksoy et al. - 2019 - Performance Monitoring via Functional Near Infrare.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/9962G7XE/Aksoy et al. - 2019 - Performance Monitoring via Functional Near Infrare.pdf:application/pdf},
}

@article{saiz_manzanares_how_2017,
	title = {How {Do} {B}-{Learning} and {Learning} {Patterns} {Influence} {Learning} {Outcomes}?},
	volume = {8},
	issn = {1664-1078},
	url = {http://journal.frontiersin.org/article/10.3389/fpsyg.2017.00745/full},
	doi = {10.3389/fpsyg.2017.00745},
	abstract = {Learning Management System (LMS) platforms provide a wealth of information on the learning patterns of students. Learning Analytics (LA) techniques permit the analysis of the logs or records of the activities of both students and teachers on the on-line platform. The learning patterns differ depending on the type of Blended Learning (B-Learning). In this study, we analyse: (1) whether signiﬁcant differences exist between the learning outcomes of students and their learning patterns on the platform, depending on the type of B-Learning [Replacement blend (RB) vs. Supplemental blend (SB)]; (2) whether a relation exists between the metacognitive and the motivational strategies (MS) of students, their learning outcomes and their learning patterns on the platform. The 87,065 log records of 129 students (69 in RB and 60 in SB) in the Moodle 3.1 platform were analyzed. The results revealed different learning patterns between students depending on the type of B-Learning (RB vs. SB). We have found that the degree of blend, RB vs. SB, seems to condition student behavior on the platform. Learning patterns in RB environments can predict student learning outcomes. Additionally, in RB environments there is a relationship between the learning patterns and the metacognitive and (MS) of the students.},
	language = {en-GB},
	urldate = {2024-06-28},
	journal = {Frontiers in Psychology},
	author = {Sáiz Manzanares, María Consuelo and Marticorena Sánchez, Raúl and García Osorio, César Ignacio and Díez-Pastor, José F.},
	month = may,
	year = {2017},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Bewertungsmethoden, Promotion:Relevanz:4, \#1:Zeitschriftenartikel:learning:management:system, Promotion:FU2b, Promotion:S:01 Learning Management System, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU2b},
	pages = {745},
	annote = {Analyse des Artikels "How Do B-Learning and Learning Patterns Influence Learning Outcomes?" von Sáiz Manzanares et al. (2017)
1. Analyse
Hauptthemen und -ziele der Forschung: Der Artikel untersucht den Einfluss von Blended Learning (B-Learning) und Lernmustern auf die Lernergebnisse der Studierenden. Ziel ist es, Unterschiede in den Lernmustern und deren Zusammenhang mit Lernergebnissen sowie metakognitiven und motivationalen Strategien zu identifizieren.
Verwendete Methoden und Datenquellen:


Methodische Ansätze: Quasi-experimentelles Design und deskriptiv-korrelationales Design.


Werkzeuge und Datenquellen: Moodle 3.1 Plattform zur Analyse von 87.065 Log-Einträgen von 129 Studierenden, Skala der Lernstrategien (ACRAr) von Román und Poggioli (2013).


Zentrale Forschungsergebnisse:


Lernmuster: Unterschiede in den Lernmustern zwischen den Studierenden, abhängig von der Art des B-Learning (Replacement Blend - RB vs. Supplemental Blend - SB).


Lernergebnisse: Lernmuster in RB-Umgebungen können die Lernergebnisse der Studierenden vorhersagen. In RB-Umgebungen besteht ein Zusammenhang zwischen Lernmustern und metakognitiven sowie motivationalen Strategien der Studierenden.


2. Zusammenfassung
Kernpunkte des Artikels:


Problemstellung: Untersuchung, ob Unterschiede in den Lernmustern der Studierenden abhängig von der Struktur des Trainingsprogramms bestehen und ob ein Zusammenhang zwischen den Lernmustern und Lernergebnissen besteht.


Methodik: Analyse von Log-Daten der Moodle-Plattform und Einsatz der ACRAr-Skala zur Bewertung von Lernstrategien.


Hauptergebnisse: Unterschiede in den Lernmustern zwischen RB und SB, wobei RB-Umgebungen lernförderlichere Muster aufweisen. Zusammenhang zwischen Lernmustern und metakognitiven sowie motivationalen Strategien in RB-Umgebungen.


Schlussfolgerungen: Die Art des B-Learning beeinflusst die Lernmuster und Lernergebnisse der Studierenden signifikant.


3. Kernaussagen


Lernmuster und Lernergebnisse: „Learning patterns in RB environments can predict student learning outcomes. Additionally, in RB environments there is a relationship between the learning patterns and the metacognitive and motivational strategies (MS) of the students.“ (S. 1)


Prozess- und ergebnisorientiertes Feedback: „Well-designed LMS mean that the development of process-oriented feedback is more structured for students, since they can consult the orientations of the teacher, both in real time and afterwards, at any time in the learning process.“ (S. 2)


Bedeutung von LMS: „Learning Management Systems (LMS) have been related to improvements in learning outcomes and in information acquisition.“ (S. 2)


4. Argumentationslinien


Bedeutung von B-Learning: Der Artikel argumentiert, dass die Struktur des B-Learning-Programms (RB vs. SB) signifikante Auswirkungen auf die Lernmuster und Lernergebnisse der Studierenden hat.


Nutzung von Lernanalytik: Es wird betont, dass Lernanalytik wertvolle Einblicke in die Lernmuster und Verhaltensweisen der Studierenden bietet und zur Verbesserung der Lernergebnisse genutzt werden kann.


Feedbackmechanismen: Der Artikel hebt hervor, dass prozessorientiertes Feedback effektiver ist als ergebnisorientiertes Feedback und zur besseren Wissenskonstruktion beiträgt.


5. Verschlagwortung


Lehr- und Lerneffektivität


Begründung: Der Artikel untersucht die Effektivität von B-Learning-Programmen und deren Auswirkungen auf die Lernmuster und Lernergebnisse der Studierenden.


Fundstelle: S. 1




Bewertungsmethoden


Begründung: Die Studie verwendet Lernanalytik zur Bewertung der Lernmuster und Verhaltensweisen der Studierenden.


Fundstelle: S. 2




Technologieintegration


Begründung: Der Artikel befasst sich mit der Integration von LMS und deren Rolle im Blended Learning.


Fundstelle: S. 2




6. Kategorisierung


Kategorie: Kerngedanke


Kriterium: Der Artikel liefert zentrale Erkenntnisse zur Bedeutung der Struktur von B-Learning-Programmen und deren Einfluss auf die Lernmuster und Lernergebnisse der Studierenden.


Beispiel: Der Artikel diskutiert detailliert die Unterschiede zwischen RB und SB und deren Auswirkungen auf die Lernergebnisse.




7. Zuordnung zu Forschungsfragen


FU2b: Welche Effekt-Faktoren erläutern Lehrende im digitalen Bildungsraum von Gesundheitsberufen bei der Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems?


Begründung: Der Artikel untersucht die Unterschiede in den Lernmustern und deren Zusammenhang mit metakognitiven und motivationalen Strategien der Studierenden, was für die Effekt-Faktoren relevant ist.


Fundstelle: S. 1




8. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 4/5


Der Artikel bietet wertvolle Einblicke in die Unterschiede der Lernmuster und deren Einfluss auf die Lernergebnisse.




Zitierhäufigkeit und Einfluss des Artikels: 3/5


Die Studie ist relevant für die Diskussion um die Effektivität von B-Learning-Programmen, aber die Stichprobengröße ist begrenzt.




Aktualität des Artikels: 5/5


Veröffentlicht im Jahr 2017, ist der Artikel aktuell und relevant für die neuesten Entwicklungen im Bereich Blended Learning und LMS.




Gesamtbewertung: 4/5
Diese Analyse zeigt die Relevanz des Artikels für die Untersuchung der Lernmuster und Lernergebnisse in Blended-Learning-Umgebungen und bietet wertvolle Einblicke für zukünftige Forschungen und Praktiken.
},
	file = {Sáiz Manzanares et al. - 2017 - How Do B-Learning and Learning Patterns Influence .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/7V9TJYBS/Sáiz Manzanares et al. - 2017 - How Do B-Learning and Learning Patterns Influence .pdf:application/pdf},
}

@inproceedings{al-mansoori_using_2011,
	address = {Abu Dhabi, United Arab Emirates},
	title = {Using {E}-learning for helping children with diabetes},
	isbn = {978-1-4577-0311-9},
	url = {http://ieeexplore.ieee.org/document/5893806/},
	doi = {10.1109/INNOVATIONS.2011.5893806},
	abstract = {Diabetes is a common and costly condition disease that is associated with significant morbidity and mortality. Recent studies have shown remarkable increases in diabetes during the last decade. This has attracted many researchers and doctors to investigate e-learning technologies as a way of assisting people with diabetes. However very little work exist that focus on educating children to adopt healthy lifestyle. As a result, this research work aims to create awareness of diabetes among children, and thereby, ultimately contribute to reducing the growing rate of diabetes. This paper presents an investigation into E-Learning systems and how it can help people with diabetes, especially when it comes to children who are largely unaware and poorly informed about the menace of the disease. This research addresses children’ needs expectations, and proposes a design of an E-Learning prototype that can raise their awareness and knowledge in order to help reduce the effects of this disease on children.},
	language = {en-GB},
	urldate = {2024-06-16},
	booktitle = {2011 {International} {Conference} on {Innovations} in {Information} {Technology}},
	publisher = {IEEE},
	author = {Al-Mansoori, Mona and Shaalan, Khaled and Tawfik, Hissam},
