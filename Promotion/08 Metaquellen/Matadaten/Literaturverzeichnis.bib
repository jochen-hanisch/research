	keywords = {Charité:Promotion, Promotion:Literaturanalyse, Kollaboratives Lernen, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Lernsystemarchitektur, Promotion:FU6, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:1.3.3 Forschungsstand und Forschungslücke, Promotion:Literaturverzeichnis},
