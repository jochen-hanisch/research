@article{eckle_school_2021,
	title = {School to go: {Neues} {Lernen} im {Social}-{Media}-{Stil}},
	volume = {58},
	issn = {1436-3011, 2198-2775},
	shorttitle = {School to go},
	url = {https://link.springer.com/10.1365/s40702-021-00793-1},
	doi = {10.1365/s40702-021-00793-1},
	abstract = {With the pandemic-related ﬁrst lockdown in March 2020, digital learning has experienced a tremendous boost. In times of nationwide school closures, the “School to go” initiative makes a relevant contribution to digital education for students, parents, teachers and the interested public. The platform of the same name (www.schooltogo.de) bundles digital learning opportunities for children, young people and young adults. It also features blog posts on trend topics in digital education: How can digital and didactically motivated spatial concepts contribute to improved learning and what signiﬁcance does gamiﬁcation have for students’ motivation to learn? Currently, there are already over 1000 innovative learning formats (as of May 2021) for various subjects on “School to go”, aimed at students of all ages and grades. This article shows how new learning succeeds in the age of digitization and how didactics and business informatics should be harmonized to provide sustainable learning experiences.},
	language = {de-DE},
	number = {6},
	urldate = {2021-11-28},
	journal = {HMD Praxis der Wirtschaftsinformatik},
	author = {Eckle, Jannick and Jungfleisch, Anne and Stattkus, Daniel and Zarvić, Novica and Knopf, Julia and Thomas, Oliver},
	month = dec,
	year = {2021},
	note = {ZSCC: 0000000},
	keywords = {Promotion:Literaturanalyse, Kollaboratives Lernen, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, \#9:Zeitschriftenartikel:digital:lernen, Promotion:FU1, Promotion:S:09 Digital Lernen, Promotion:Dissertation {\textbar} FU1 {\textgreater} Argumentation, Promotion:Literaturverzeichnis},
	pages = {1469--1482},
	annote = {1. Analyse
Identifizierung und Beschreibung der Hauptthemen und -ziele der Forschung
Hauptthemen:
	•	Einsatz von Social-Media-Stil-Plattformen für das digitale Lernen
	•	Implementierung und Nutzung der Plattform „School to go“
	•	Integration digitaler und didaktisch motivierter Raumkonzepte zur Verbesserung des Lernens
Hauptziele:
	•	Untersuchung der Auswirkungen von Social-Media-ähnlichen Lernplattformen auf die Lernmotivation und -effektivität von Schülerinnen und Schülern
	•	Analyse der Potenziale und Herausforderungen der Plattform „School to go“ zur Förderung des selbstregulierten und motivierten Lernens
	•	Diskussion der Bedeutung von Gamification und personalisierten Lernumgebungen
Erkennung der verwendeten Methoden und Datenquellen
Methoden:
	•	Qualitative und quantitative Analyse der Plattform „School to go“
	•	Synthese bestehender Literatur und empirischer Daten zur Nutzung von Social-Media-Plattformen im Bildungsbereich
Datenquellen:
	•	Beiträge und empirische Daten aus der Plattform „School to go“
	•	Relevante Studien und Artikel zu digitalem Lernen, Social Media und Gamification
Erklärung der zentralen Forschungsergebnisse
Zentrale Ergebnisse:
	•	Social-Media-ähnliche Plattformen wie „School to go“ können die intrinsische Lernmotivation und das selbstregulierte Lernen fördern.
	•	Gamification-Elemente tragen zur Erhöhung der Lernmotivation bei und machen das Lernen interaktiver und ansprechender.
	•	Die personalisierte und individualisierte Gestaltung der Lernumgebungen ermöglicht es, den unterschiedlichen Lernbedürfnissen der Schülerinnen und Schüler gerecht zu werden.
	•	Herausforderungen bestehen in der technischen Umsetzung und der Sicherstellung der didaktischen Qualität der Inhalte.
2. Zusammenfassung
Problemstellung:
Wie können Social-Media-ähnliche Plattformen zur Verbesserung des digitalen Lernens beitragen und welche Herausforderungen und Potenziale ergeben sich daraus?
Methodik:
Qualitative und quantitative Analyse der Plattform „School to go“ sowie eine Synthese bestehender Literatur zu digitalem Lernen, Social Media und Gamification.
Hauptergebnisse:
	•	Social-Media-ähnliche Plattformen fördern die intrinsische Lernmotivation und das selbstregulierte Lernen.
	•	Gamification-Elemente steigern die Lernmotivation und Interaktivität.
	•	Personalisierte Lernumgebungen adressieren individuelle Lernbedürfnisse.
	•	Technische und didaktische Herausforderungen müssen bewältigt werden.
Schlussfolgerungen:
Plattformen im Social-Media-Stil wie „School to go“ bieten großes Potenzial für das digitale Lernen, erfordern jedoch sorgfältige Planung und Umsetzung, um die didaktische Qualität und technische Funktionalität sicherzustellen.
3. Kernaussagen
Wichtige Aussagen und Befunde:
	1.	Förderung der Lernmotivation: Social-Media-ähnliche Plattformen wie „School to go“ fördern die intrinsische Lernmotivation und das selbstregulierte Lernen (S. 1470-1471).
	2.	Bedeutung von Gamification: Gamification-Elemente tragen zur Erhöhung der Lernmotivation und Interaktivität bei (S. 1472-1473).
	3.	Personalisierte Lernumgebungen: Die personalisierte und individualisierte Gestaltung der Lernumgebungen ermöglicht eine Anpassung an die individuellen Lernbedürfnisse der Schülerinnen und Schüler (S. 1475-1476).
4. Argumentationslinien
Aufbau der Argumente:
	•	Einführung: Darstellung der Bedeutung und Herausforderungen des digitalen Lernens während der COVID-19-Pandemie (S. 1470-1471).
	•	Hauptteil: Analyse der Funktionsweise und Vorteile von „School to go“, die Bedeutung von Gamification und personalisierten Lernumgebungen (S. 1472-1476).
	•	Schluss: Diskussion der Implikationen und zukünftigen Herausforderungen für die Implementierung von Social-Media-ähnlichen Lernplattformen (S. 1477-1480).
5. Verschlagwortung
	•	Lehr- und Lerneffektivität: Begründung: Der Artikel untersucht, wie Social-Media-ähnliche Plattformen die Effektivität des Lernens durch erhöhte Motivation und personalisierte Lernumgebungen verbessern können.
	•	Technologieintegration: Begründung: Der Artikel behandelt die Integration von Social Media und Gamification-Elementen in die Bildungsprozesse und die damit verbundenen Herausforderungen und Chancen.
	•	Systemanpassung: Begründung: Der Artikel beschreibt die Anpassung traditioneller Lernumgebungen an moderne, digitale Plattformen im Social-Media-Stil.
	•	Kollaboratives Lernen: Begründung: Der Artikel thematisiert, wie durch Social-Media-Elemente die Kollaboration und Interaktion unter den Lernenden gefördert werden kann.
6. Kategorisiere
Kategorie: Argumentation
Kriterium: Nutzung von Quellen oder Theorien zur Unterstützung oder Widerlegung einer These oder Fragestellung.
Beispiel: Der Artikel argumentiert, dass Social-Media-ähnliche Plattformen die Lernmotivation und Effektivität verbessern können, und stützt diese These durch empirische Daten und theoretische Überlegungen zur Bedeutung von Gamification und personalisierten Lernumgebungen.
7. Zuordnung zu Forschungsfragen
Passende Forschungsfrage: FU1: Welche Akzeptanz und Nützlichkeit (Bedeutung) beschreiben Akteure im digitalen Bildungsraum von Gesundheitsberufen bei Anwendung eines Learning-Management-Systems?
Begründung: Der Artikel untersucht die Akzeptanz und Nützlichkeit von Social-Media-ähnlichen Plattformen zur Verbesserung der Lehr- und Lernprozesse, was direkt auf die Forschungsfrage FU1 zutrifft.
},
	file = {Eckle et al. - 2021 - School to go Neues Lernen im Social-Media-Stil.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/JYWSPMSM/Eckle et al. - 2021 - School to go Neues Lernen im Social-Media-Stil.pdf:application/pdf},
}

@article{king_defining_2001,
	title = {Defining {Distance} {Learning} and {Distance} {Education}},
	volume = {9},
	abstract = {There is, in most academic and scientific fields, a common yet distinct vocabulary. This precise vocabulary makes it possible for researchers and practitioners within that domain to communicate clearly and succinctly with each other. At this time, there is a lack of such a precise vocabulary in the domain of distance learning and distance education. This paper hopes to start the movement toward a common vocabulary by offering precise definitions of distance learning and distance education, and their interrelationship. This is accomplished by first proposing a single definition of learning and then breaking down the concept of learning into three subcategories: instruction, exploration and serendipity. Each of these, in turn, is defined and the concepts of distance learning and distance education are derived and categorized.},
	language = {en-GB},
	number = {1},
	journal = {AACE Review (formerly AACE Journal)},
	author = {King, Frederick B and Young, Michael F and Drivere-Richmond, Kelly and Schrader, P G},
	year = {2001},
	note = {ZSCC: 0000148},
	keywords = {Promotion:Literaturanalyse, Promotion:FU4a, Promotion:Kerngedanke, Technologieintegration, Bildungstheorien, Promotion:Relevanz:4, Lernsystemarchitektur, Promotion:todo, Promotion:S:06 Bildungstechnologie, Promotion:Literaturverzeichnis},
	pages = {14},
	annote = {Hier ist die strukturierte Analyse der Studie "Defining Distance Learning and Distance Education" von Frederick B. King, Michael F. Young, Kelly Drivere-Richmond und P. G. Schrader:
1. Hauptthemen und -ziele der Forschung
Die Studie zielt darauf ab, klare und präzise Definitionen für die Begriffe "Distance Learning" (Fernlernen) und "Distance Education" (Fernunterricht) zu entwickeln, um die Kommunikation in diesem Forschungsbereich zu verbessern. Es wird argumentiert, dass ein Mangel an einheitlichen Definitionen die Forschung und den Austausch von Ideen behindert hat. Das Ziel ist es, eine gemeinsame Basis für die Forschung und Entwicklung in diesem Bereich zu schaffen.
2. Methoden und Datenquellen


Methoden: Die Autoren verwenden eine theoretische Analyse, um die bestehenden Definitionen von Fernlernen und Fernunterricht zu untersuchen und neue, klarere Definitionen vorzuschlagen. Sie beziehen verschiedene psychologische und pädagogische Theorien ein, um eine umfassende Definition von Lernen zu formulieren, die dann auf Fernlernen und Fernunterricht angewendet wird.


Datenquellen: Die Analyse basiert auf einer umfassenden Literaturrecherche und der Untersuchung bestehender Definitionen und Theorien im Bereich des Lernens und des Fernunterrichts.


3. Zentrale Forschungsergebnisse


Definition von Lernen: Die Autoren definieren Lernen als "verbesserte Fähigkeiten im Wissen und/oder Verhalten als Ergebnis von Erfahrungen". Diese Definition umfasst sowohl behavioristische als auch kognitive Perspektiven und betont, dass Lernen in einem bestimmten Kontext stattfindet.


Kategorien des Lernens: Die Studie identifiziert drei Hauptkategorien des Lernens:


Instruktion: Zielgerichtetes Lernen, das typischerweise in formellen Bildungsumgebungen stattfindet.


Erkundung: Selbstgesteuertes Lernen, das informell und außerhalb formeller Bildungsumgebungen erfolgt.


Zufälligkeit: Ungeplantes Lernen, das durch zufällige Begegnungen mit Informationen entsteht.




Definition von Fernlernen und Fernunterricht:


Fernlernen: Wird definiert als das Erreichen verbesserter Fähigkeiten durch Erfahrungen, die räumlich oder zeitlich getrennt stattfinden.


Fernunterricht: Wird als formalisierter, instruktiver Lernprozess definiert, bei dem die zeitlichen/geografischen Umstände den direkten Kontakt zwischen Schülern und Lehrern verhindern.




Synchronie als Variable: Die Autoren unterscheiden zwischen synchronem (gleichzeitiges) und asynchronem (zeitversetztes) Fernlernen, wobei beide Formen spezifische Vor- und Nachteile haben.


4. Zusammenfassung
Die Studie von King et al. bietet eine theoretische Grundlage für die Definition und Unterscheidung von Fernlernen und Fernunterricht. Durch die Formulierung präziser Definitionen soll die Forschung in diesem Bereich erleichtert und verbessert werden. Die Autoren schlagen vor, dass durch die Betrachtung der Beschränkungen und Möglichkeiten in jeder Lernform eine fairere Bewertung von Fernunterricht und Präsenzunterricht möglich wird.
5. Kernaussagen


Notwendigkeit einheitlicher Definitionen: Ohne präzise Definitionen bleibt die Forschung in diesem Bereich fragmentiert und wenig effektiv. (S. 2-3)


Definition von Lernen als dynamischer Prozess: Lernen ist eine permanente Veränderung, die durch Erfahrungen in verschiedenen Kontexten vermittelt wird. (S. 5)


Fernlernen als gleichwertig mit Präsenzlernen: Die Autoren argumentieren, dass Fernlernen und Präsenzlernen koexistierende, gleichwertige Formen des Lernens sind, die jeweils ihre eigenen Vor- und Nachteile haben. (S. 7-8)


6. Argumentationslinien
Die Autoren argumentieren, dass ein Mangel an klaren Definitionen in der Vergangenheit die Forschung im Bereich des Fernlernens behindert hat. Sie schlagen vor, dass eine klare Begriffsbestimmung sowohl die theoretische als auch die empirische Forschung voranbringen kann. Darüber hinaus betonen sie die Bedeutung der Unterscheidung zwischen synchronem und asynchronem Lernen als wesentliche Variablen im Fernunterricht. (S. 9-10)
7. Verschlagwortung
Passendste Schlagworte und Begründungen:


Lernsystemarchitektur: Die Studie untersucht die strukturellen Merkmale von Fernunterrichtssystemen.


Bildungstheorien: Die Definitionen und Argumente stützen sich auf verschiedene Bildungstheorien.


Technologieintegration: Untersuchung der Rolle von Technologie bei der Vermittlung von Lerninhalten in Fernlernszenarien.


8. Kategorisierung
Kerngedanke: Die Studie strebt an, klare Definitionen für Fernlernen und Fernunterricht zu schaffen, um die Grundlage für weitere Forschung zu legen und die Diskussion im Bereich des digitalen Lernens zu verbessern. (S. 11-12)
9. Zuordnung zur Forschungsfrage
Passendste Forschungsunterfrage:


FU4a: Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?


Begründung: Die Untersuchung von Definitionen und Mechanismen des Fernlernens bietet Einblicke in die bildungswissenschaftlichen Prozesse, die für die Bewertung und Implementierung von Fernunterrichtssystemen relevant sind.




10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 4 - Die Studie bietet grundlegende Definitionen, die für das Verständnis von Fernlernen wichtig sind.


Zitierhäufigkeit und Einfluss: 3 - Die Studie hat eine solide theoretische Grundlage, wird jedoch nicht breit zitiert.


Aktualität: 4 - Die Diskussion über Definitionen ist zeitlos relevant, obwohl der Artikel nicht auf die neuesten technologischen Entwicklungen eingeht.


Gesamtbewertung: 3.7


Diese Analyse bietet einen detaillierten Einblick in die Studie von King et al. und zeigt, wie sie zur Klärung und Verbesserung der Diskussion über Fernlernen und Fernunterricht beiträgt.
},
	annote = {Übersetzung

Definition von Distance Learning und Distance EducationFrederick B. King, Michael F. Young, Kelly Drivere-Richmond, P. G. Schrader Die Universität von ConnecticutNeag School of EducationEingereicht bei: Educational Technology Review Frederick King: rking@uconnvm.uconn.edu Michael Young: myoung@uconnvm.uconn.edu Kelly Drivere-Richmond: kelly@neca.com P. G. Schrader: peegee@peegee.comKorrespondenz zu diesem Artikel ist zu richten an Frederick B. King, Unit 2004, 249 Glenbrook Rd. Storrs, CT 06269-2004, rking@uconnvm.uconn.eduZusammenfassungIn den meisten akademischen und wissenschaftlichen Bereichen gibt es ein gemeinsames und doch eindeutiges Vokabular.Dieses präzise Vokabular ermöglicht es den Forschern und Praktikern in diesem Bereich, klar und prägnant miteinander zu kommunizieren. Derzeit fehlt ein solches präzises Vokabular im Bereich des Fernstudiums und der Fernausbildung. Dieses Papier hofft, die Bewegung in Richtung eines gemeinsamen Vokabulars zu starten, indem es präzise Definitionen des Fernunterrichts und der Fernlehre sowie deren Beziehung zueinander anbietet. Dies wird erreicht, indem zunächst eine einheitliche Definition des Begriffs "Lernen" vorgeschlagen wird und dann das Konzept des Lernens in drei Unterkategorien unterteilt wird: Anweisung, Erkundung und Serendipität. Jede dieser Unterkategorien wird wiederum definiert und die Konzepte des Fernlernens und des Fernunterrichts werden abgeleitet und kategorisiert.
Definition von Fernlernen und FernunterrichtIn den meisten akademischen und wissenschaftlichen Bereichen ist es üblich, ein gemeinsames, aber dennoch eindeutiges Vokabular zu haben. Genaue Definitionen sind für die Kommunikation innerhalb bestimmter Bereiche für Dozenten, Studenten und vor allem für Forscher, die operationale Definitionen erstellen müssen, unerlässlich. Es ist seltsam, dass es in einem so alten Bereich wie dem Fernunterricht noch kein solch eindeutiges, gemeinsames Vokabular gibt. Viele Autoren haben die gleichen Begriffe verwendet, um unterschiedliche Dinge zu meinen. Oft werden Schlüsselbegriffe des Fernunterrichts verwendet, ohne sie zu definieren, so dass man entweder davon ausgeht, dass die Bedeutung universell ist, oder das Thema einfach ignoriert. Phipps \& Merisotis (1999) stellten fest: "Es ist wichtig zu verstehen, was mit 'Fernunterricht' gemeint ist. Da sich die Technologie weiterentwickelt, ändert sich die Definition dessen, was Fernunterricht ist, ständig (S. 11)." Im selben Bericht wird die Tatsache dargestellt, dass ein Großteil der Forschung im Bereich des Fernunterrichts seit 1990 schwerwiegende methodische Mängel aufweist und es "einen relativen Mangel an echter, originärer Forschung gibt, die sich der Erklärung oder Vorhersage von Phänomenen im Zusammenhang mit dem Fernunterricht widmet (S. 2)." Wir stimmen dem zu und sind der Meinung, dass für die Durchführung origineller, sinnvoller Forschung eine Grundlage von operationalen Definitionen erforderlich ist. Begriffe und Definitionen müssen konsistent sein. Selbst in ihrem Bericht verwenden Phipps und Merisotis die Begriffe Fernunterricht und Fernlernen synonym. Damit bedeutende, forschungsgetriebene Fortschritte im Bereich des Fernunterrichts gemacht werden können, müssen die Definitionen sowohl semantisch als auch operativ innerhalb und zwischen den Artikeln konsistent sein. Unser Berufsstand sollte einen kollaborativen Dialog und eine gemeinsame Wissenschaft anstreben, deren Ergebnisse replizierbar und deren Schlussfolgerungen interpretierbar sind. In diesem Papier wird eine Definition von Begriffen und Bedingungen im Zusammenhang mit dem Bereich des Fernunterrichts vorgeschlagen, damit diese Begriffe
damit diese Begriffe eine bessere gemeinsame Basis für den Austausch von Ideen und Informationen bilden, insbesondere für Forschung und Entwicklung. Indem wir die Begriffe und Bedingungen definieren, erkennen wir an, dass Bedeutung ständig und dynamisch konstruiert wird und dass sich Definitionen ändern, wenn neues Wissen entdeckt wird. Dennoch hoffen wir, dass unser Vorschlag und der damit verbundene Dialog die Verwirrung verringern und die Klarheit einer gemeinsamen Sprache für die laufende Forschung auf dem Gebiet des Fernunterrichts verbessern kann.Um den aktuellen Stand der Dinge zu verdeutlichen, betrachten wir zwei Definitionen des Fernunterrichts, die repräsentativ für unsere Beobachtungen im gesamten Bereich des Fernunterrichts sind. Die United States Distance Learning Association definierte Fernunterricht 1998 (Roblyer \& Edwards, 2000) als "die Aneignung von Wissen und Fertigkeiten durch vermittelte Informationen und Unterricht, die alle Technologien und andere Formen des Lernens auf Distanz umfasst (S. 192)." Dies ist eine Definition, die nicht zwischen formellem und informellem Lernen oder verschiedenen Arten von Distanz (zeitlich und physisch) unterscheidet. Newby, Stepich, Lehman und Russell (2000) definieren Fernunterricht als "ein organisiertes Unterrichtsprogramm, bei dem Lehrende und Lernende räumlich getrennt sind (S. 210)." Diese Definition ist noch weniger spezifisch, da sie keine Auswirkungen auf den Lernenden postuliert und lediglich die Existenz eines Programms beschreibt, in dem vermutlich überhaupt kein Lernen stattfindet.Wir beginnen unseren Vorschlag bezüglich des "Fernlernens" mit dem zweiten Wort, "Lernen". In jedem Lehrbuch der allgemeinen Psychologie und der pädagogischen Psychologie findet sich mindestens eine Definition von "Lernen". Die meisten dieser Definitionen sind in vielen Aspekten ähnlich, aber in ihren Details so unterschiedlich, dass sie verwirren. Einige setzen voraus, dass man weiß, was Lernen ist, und bieten keine konkrete Definition an (Pressley \& McCormick, 1995). Andere verwenden eine ungenaue Terminologie wie "relativ", wie in "relativ dauerhaft" (Ormrod, 1995; Good \&
Brophy, 1995; Woolfolk, 1995). Einige Definitionen scheinen sich nur auf das Verhalten zu beziehen (Schunk, 2000), einige nur auf das Wissen (Mayer, 1987) und einige sowohl auf das Wissen als auch auf das beobachtbare Verhalten (Slavin, 1994). Einige Autoren stellen zwei oder mehr Definitionen auf und zeigen keine Präferenz. Die meisten der zitierten Autoren weisen auch auf die Unterschiede zwischen behavioristischen Definitionen und kognitiven Definitionen hin. Nur wenige Autoren haben sich mit der Definition von Lernen als situiert beschäftigt (Brown, Collins, \& Duguid, 1989; Greeno \& Middle School Mathematics Through Applications Project Group, 1998). Damit Fernunterricht angemessen definiert werden kann, muss also zunächst eine gemeinsame Haltung zum Lernen im Allgemeinen eingenommen werden. Unter Berücksichtigung dieser vielfältigen Perspektiven und der Synthese dieser Punkte lautet unsere vorgeschlagene Ausgangsdefinition des Lernens: Lernen ist die Verbesserung von Fähigkeiten im Wissen und/oder Verhalten als Ergebnis von Erfahrung.Wir finden, dass diese Definition sparsam ist und dennoch die verhaltens- und kognitionspsychologischen Perspektiven einschließt. Sie definiert Lernen als positive Veränderung im Laufe der Zeit, verbesserte Fähigkeiten in Kognition, Handlungen oder beidem als Ergebnis persönlicher Beobachtung oder Interaktion mit der erlebten Welt. Es ist ein dynamischer Prozess: Lernen findet nicht isoliert statt. Es ist nicht zeitlich begrenzt. Es ist permanent. Der Organismus wird verändert. Wenn einmal etwas gelernt wurde, wird nichts mehr so sein, wie es vorher war, egal wie klein oder trivial die gelernte Lektion auch sein mag. Dennoch finden wir, dass diese Definition für unsere Zwecke unvollständig ist. Sie stellt eine vernünftige Synthese der Definitionen dar, auf die in den Lehrbüchern Bezug genommen wird, aber es fehlt etwas in dieser Definition - insbesondere wird nicht berücksichtigt, was das Lernen begrenzt, wie z. B. der soziale oder ökologische Kontext.Lernen findet in einer Situation statt (Brown, Collins, \& Duguid, 1989; CTGV, 1990, 1993; Greeno, et al., 1998; Lave \& Wenger, 1991; Young, 1993). Es gibt eine sich ständig
wechselnde Dynamik zwischen der Situation und dem Lernenden. Die Auswirkungen der Situation (auf den Lerner) sind so vielfältig wie die Anzahl der Individuen und so spezifisch wie das Individuum selbst einzigartig ist. Das Individuum verändert sich auch durch die Erfahrungen mit der Situation, und der Lernende kann Handlungen vornehmen, die die Situation beeinflussen und modifizieren. Die Komplexität des Lernens liegt also nicht nur in einem Individuum, sondern in der komplexen Dynamik der Lerner-Situation-Interaktion.Jede Situation setzt dem Lernen Grenzen durch die Tatsache, dass eine Situation einem bestimmten Individuum nicht die einzigartigen Erfahrungen bieten kann, die eine andere Situation bieten kann, und andersherum. Diese Einschränkungen werden als Constraints bezeichnet. Die Situation, auf die der Einzelne trifft, schränkt sein Handlungspotenzial in dieser Situation ein. Beschränkungen können auf zwei Arten betrachtet werden. Die erste ist, dass Zwänge Handlungsbeschränkungen sind. Diese Sichtweise von Zwängen hat eine negative Konnotation. Der Einzelne kann etwas nicht tun, weil die Situation, in der er sich befindet, ihm diese Handlung nicht erlaubt. Zum Beispiel kann eine Person nicht in 30.000 Fuß Höhe schwimmen gehen, während sie in einer 747 fliegt.Die zweite Art, Einschränkungen - als Randbedingungen für zielgerichtetes Handeln - zu betrachten, hat eine positivere Perspektive. Diese zweite Sichtweise ist konsistent mit Gibsons (1986) Begriff der Affordanzen (Greeno, 1994). In diesem Sinne bietet jede Situation Möglichkeiten. Gibsons Begriff der Affordanzen wurde als Handlungsmöglichkeiten beschrieben, die ein Lernender mit der Fähigkeit zu handeln hat. Jede Situation erlaubt einem Individuum, in dieser Situation etwas zu tun, was in einer anderen Situation nicht möglich wäre. Wiederum im Beispiel der 747 wird einem eine spektakuläre Aussicht über ein weites Gebiet geboten, die man beim Schwimmen auf der Erde nicht hätte. Zusammenfassend lässt sich sagen, dass das Individuum mit der Situation interagiert, die wiederum die Interaktion einschränkt oder bestimmte Aktivitäten ermöglicht.diese Interaktion einschränkt oder bestimmte Aktivitäten ermöglicht. Jetzt kann also eine umfassendere Definition von
Lernens erstellt werden. Lernen ist die Verbesserung von Fähigkeiten in Wissen und/oder Verhalten als Ergebnis vermittelter Erfahrungen, die durch Interaktionen mit der Situation eingeschränkt werden.Mit dieser Definition von LERNEN sind wir auf halbem Weg zu unserem Ziel, das Fernstudium zu definieren. Bedenken Sie nun, dass es mehr als einen Zweck für das Lernen gibt. Da Lernen ein ständiger Prozess ist, der immer und überall dort stattfindet, wo das Individuum aufnahmefähig ist, müssen die verschiedenen Lernzwecke (unterschiedliche Lernabsichten) berücksichtigt werden. Schließlich können Lernsituationen formal (konstruiert) oder selbstgesteuert in alltäglichen Situationen (naturalistisch) sein. Lernen kann gewollt oder zufällig erfolgen. Mit diesen Möglichkeiten im Hinterkopf schlagen die Autoren daher drei Hauptunterkategorien des Lernens vor: 1) Instruktion: zielgerichtetes Lernen; 2) Exploration: ohne Ziele; und 3) Serendipität: unbeabsichtigtes Lernen.Instruktion: Zielgerichtetes LernenDie erste Kategorie ist diejenige, die uns am ehesten in den Sinn kommt, wenn wir überLernen in Schulen sprechen. Es ist das instruktionale/pädagogische Modell. Bei dieser Art des Lernens, die wir Instruktion nennen, gibt es einen Schüler und einen Lehrer. Die Instruktion ist ziel- und zweckorientiert. Das bestimmende Merkmal dieser Unterkategorie ist die Interaktion zwischen Schüler und Ausbilder. Die meisten Bücher, die über das Lernen geschrieben wurden, befassen sich mit dem Lernen in solchen Situationen. In einem solchen Kontext können die Lernenden entweder Leistungs- oder Lernziele verfolgen (Dweck, 1990), was zu einer unterschiedlichen Dynamik innerhalb eines bestimmten Klassenzimmers führt. Unsere Unterscheidung hier steht im Einklang mit Moore und Kearsley (1996), die "Fernunterricht" (wie unseren Unterricht) von "Fernlernen" unterscheiden.Exploration ohne ZielsetzungDie nächste Kategorie des Lernens ist viel weniger formal als die erste. Sie kann folgendermaßen bezeichnet werdenErkundung. Diese Art des Lernens ist selbstgesteuert und wird von persönlichen Zielen und Interessen bestimmt. Es ist viel informeller und normalerweise nicht mit einer Interaktion zwischen Dozent und Teilnehmer verbunden. Sie ist jedoch immer noch zielorientiert. Die Ziele in dieser Kategorie sind alle persönliche Lernziele, keine Leistungsziele. Dieses Lernen findet außerhalb der formalen Bildungssituation statt. Hauptsächlich findet es in naturalistischen Kontexten während alltäglicher Umstände statt, wie z.B. effizientes Einkaufen, Experimentieren beim Kochen lernen zu Hause, Ratschläge von Freunden einholen und andere absichtsgesteuerte Erfahrungen, die zu informellem Lernen führen.SerendipitätSerendipity ist unsere Erkenntnis, dass es manchmal zufälliges Lernen gibt. EsMit dieser Art des Lernens sind keine Ziele verbunden. Es geht darum, etwas zu lernen, weil man einfach "zufällig" auf die Information gestoßen ist. Unerwartete Begegnungen mit neuen Freunden, passives Fernsehen und das Abhören von Klatsch und Tratsch sind gute Beispiele. Das Surfen im Internet liefert täglich Beispiele für diese Art des Lernens - wenn eine Person surft, nicht linear liest und von einem "verführerischen Detail", das auf einer Seite präsentiert wird, die für den ursprünglichen Zweck des Surfens der Person irrelevant ist, in den Bann gezogen wird. Die Person kann dann absichtlich diesem Thema folgen, um mehr über diese Daten zu erfahren, weil sie es möchte. Auf diese Weise kann aus dem Zufall eine Erkundung werden, oder die Information kann einfach eine kleine, aber dauerhafte Veränderung in der Person hervorrufen.Instruktion - ein Teil des Lernpuzzles mit mehreren TeilenWie aus unserem Vorschlag dieser Kategorien ersichtlich ist, sind die Autoren der Meinung, dass "Lernen"das übergreifende Konzept ist und dass es drei Unterkategorien gibt, die sich von diesem übergreifenden Prinzip ableiten. Die Instruktion ist nur eine Unterkategorie. Aus diesem Grund und aus Gründen der Klarheit der Definition wird die Unterweisung weiter in zwei Hauptkategorien unterteilt: Präsenzunterricht und Fernunterricht. Wir schlagen vor, den persönlichen Unterricht als eine Situation zu definieren, in der der Ausbilder und der Schüler dieselbe Zeit und denselben geografischen Raum nutzen. Das heißt, der Student und der Dozent sind zeitlich und räumlich gebunden (Barker \& Dickson, 1996). Beispiele hierfür wären die meisten traditionellen College-Vorlesungen, Highschool- und Grundschulunterrichtssituationen. Dies bringt uns zu einer Definition von "Fernunterricht". Abbildung 1. Drei Ziele für das LernenUnterweisung Erkundung Serendipität Persönlicher Unterricht 1 2 3Entfernung (Zeit oder Raum)* 4a, 4s 5a, 5s 6a, 6s a= asynchron; s=synchr.Wenn, wie vorgeschlagen, Unterricht eine Unterkategorie von Lernen ist, dann schlagen wir vor, dass Fernunterricht als Unterkategorie von Unterricht betrachtet wird. Das Wort Distanz impliziert eine Trennung. Diese Trennung kann zeitlich und/oder räumlich sein. Wie auch immer die Trennung aussieht, der Lernende und das, was gelernt wird, befinden sich nicht im selben räumlichen/zeitlichen Kontext. Sie sind zeitlich und/oder räumlich unabhängig (Barker \& Dickson, 1996), werden aber durch andere Faktoren, wie z.B. die vermittelnde Technologie, eingeschränkt. Nehmen wir als Beispiel eine alltägliche Situation: eine Person, die einen aufgezeichneten Bericht über einen Hurrikan während der Nachrichten im Fernsehen anschaut. Die Person, die fernsieht, befindet sich in einer Situation - sie sitzt bequem zu Hause. DerDer Sender befindet sich in einer anderen Situation - unter dem heißen Licht in einem Fernsehstudio. Und der Nachrichtensprecher, der zuvor auf Video aufgenommen wurde, befindet sich in einer anderen - mitten in Wind und Regen. Die Situationen sind unterschiedlich und werden durch das Fernsehen vermittelt. In diesem Fall ist der Zuschauer geografisch sowohl vom Nachrichtensprecher als auch vom Sender getrennt, aber nur zeitlich vom Nachrichtensprecher. Der Lernkontext würde vorgeben, ob die Sendung als Instruktion genutzt wird, d.h. ein Elternteil informiert sein Kind über Katastrophen (Abbildung 1, Zelle 1); als absichtliche Distanz-Exploration, d.h. sich hinsetzen, um sich über den Sturm zu informieren (Zelle 5) oder als Distanz-Serendipität, d.h. die Absicht, ein Fußballspiel zu sehen und beim Durchblättern der Kanäle eine Pause zu machen (Zelle 6).Unsere Definition von Fernlernen ist folgende: Fernlernen ist die Verbesserung von Fähigkeiten in Wissen und/oder Verhalten als Ergebnis von vermittelten Erfahrungen, die durch Zeit und/oder Entfernung eingeschränkt sind, so dass der Lernende nicht die gleiche Situation mit dem zu Lernenden teilt. Aus dieser Definition des Fernlernens ergibt sich unsere Definition des Fernunterrichts. Fernunterricht ist formalisiertes Unterrichtslernen, bei dem die zeitliche/geografische Situation das Lernen einschränkt, da kein persönlicher Kontakt zwischen Schüler und Dozent möglich ist. Präsenzunterricht ist formalisierter Unterricht, bei dem die zeitliche/geografische Situation das Lernen dadurch einschränkt, dass eine synchrone Interaktion von Mensch zu Mensch erforderlich ist.Wir glauben, dass wir durch die Berücksichtigung der Einschränkungen, die bei jeder Art von Lernen vorhanden sind, das Spielfeld für die Erforschung der Unterschiede zwischen traditionellem, persönlichem Unterricht und Fernunterricht ebnen können. Wir schlagen vor, dass traditionelles Lernen und Fernunterricht gleichwertig werden, jeder hat seine Vorteile und jeder hat seine Einschränkungen, die
von der Forschung aufgezählt werden sollten. Unsere Überzeugung widerspricht dem vorherrschenden Konzept, dass Fernunterricht das schwache Stiefkind des Präsenzunterrichts ist. Ein Fokus auf die Einschränkungen kann uns davon befreien, immer wieder die Nullhypothese zu beweisen, dass Fernunterricht sich nicht vom Präsenzunterricht unterscheidet. Natürlich kann es sogar Zeiten geben, in denen sich der Fernunterricht als überlegen erweist. Der Fernunterricht hat klare Vorteile, die der Präsenzunterricht nicht hat, z.B. längere Bedenkzeit vor der Beantwortung von Fragen, Nutzung verteilter Ressourcen ohne Unterbrechung des Diskussionsflusses oder der Klassenpräsentationen, permanente Aufzeichnung vieler Interaktionen (Listservs, Bulletin Boards und E-Mail) zu Forschungs- und Evaluierungszwecken. Wir schlagen daher vor, die Möglichkeiten des Fernunterrichts mit den Möglichkeiten des Präsenzunterrichts und die Einschränkungen des Fernunterrichts mit den Einschränkungen des Präsenzunterrichts zu vergleichen, um gleiche Voraussetzungen für die Forschung zu schaffen.Synchronität als variables Merkmal des FernunterrichtsFernunterricht (Zellen 4a und 4s) umfasst nach der von uns aufgestellten Definitionein breites Spektrum an möglichen Situationen. Diese Situationen können jedoch in zwei Hauptkategorien eingeteilt werden, die jeweils ihre eigenen Beschränkungen haben. Die beiden Kategorien sind synchroner und asynchroner Fernunterricht.Synchrone Situationen bieten Möglichkeiten, die eine "Echtzeit"-Interaktion zwischen Student und Dozent ermöglichen. Synchrone Situationen sind zeitabhängig, aber geografisch unempfindlich. Beispiele für solche Situationen sind Telekonferenzen, Videokonferenzen, Online-Chat und CUSeeME.Im Gegensatz dazu bieten asynchrone Situationen keine Möglichkeiten, die eine "Echtzeit"-Interaktion zwischen Teilnehmer und Dozent ermöglichen. Asynchrone Situationen sind sowohl zeitlich
und geographisch unempfindlich. Beispiele für solche Situationen sind Korrespondenzkurse, E-Mail und Web-/Server-basierter Unterricht.Diese beiden grundlegenden Kategorien von Lernsituationen können auf eine weitere Unterkategorie des Lernens angewendet werden. Das Lernen auf Distanz und das Lernen auf Distanz kann ebenfalls synchron oder asynchron stattfinden. Die Definitionen sind die gleichen wie oben, die Situation ist die gleiche, aber es besteht ein Unterschied in der Zeitskala (möglicherweise Tage oder Wochen). So kann ein Websurfer in einen persönlichen, zielgerichteten Online-Chat verwickelt sein - synchrone Distanzexploration (Zelle 5s) - und später per E-Mail mit einem Domänenexperten kommunizieren - asynchrone Distanzexploration, (Zelle 5a). Oder dieser Surfer stößt auf ein interessantes Stück Triviales und erforscht es über Hypertext - synchrone Distanz-Serendipität (Zelle 6s) - oder indem er versehentlich eine Nachricht an einen Listserv sendet und unerwarteten Input von Listenmitgliedern erhält - asynchrone Distanz-Serendipität (Zelle 6a).Ob Sie also das Äquivalent von Phidippides zum Lernen verwenden (Fernkurse) oder das modernere Äquivalent der Merkur-Methode (elektronisch vermittelt), die Definition von Lernen, Bildung und Fernunterricht gilt für alle verwendeten Medien. Es ist die Situation und ihre Beschränkungen und Möglichkeiten, die sich ändern, die die verwendeten Medien diktieren und das Lernen und Denken beeinflussen, das stattfindet. Es ist zu hoffen, dass diese vorgeschlagene Definition des Fernunterrichts, das damit begonnene Gespräch innerhalb des Feldes und der anschließende gemeinsame Konsens ein notwendiger Schritt zur Entwicklung des Fernunterrichts als wissenschaftlich erforschbare Disziplin ist.
ReferenzenBarker, B. O., \& Dickson, M. W. (1996). Fernunterrichtstechnologien in K-12schools: Past, present, and future practice. Techtrends, 41(6), 19-22.Brown, J. S., Collins, A., \& Duguid, P. (1989, Januar-Februar). 'Situierte Kognitionand the culture of learning', Educational Researcher, 32-42.Cognition and Technology Group at Vanderbilt (CTGV) (1990). Verankerte Instruktionand its relationship to situated cognition. Educational Researcher, 19, 2-10. Cognition and Technology Group at Vanderbilt (CTGV) (1993, März). AnchoredInstruction and Situated Cognition revisited. Educational Technology, 52-70.Dweck, C. S. (1990). Selbsttheorien und Ziele: Their role in motivation, personality, and development. Vortrag gehalten auf dem Nebraska Symposium on Motivation, Lincoln.Gibson, J. J. (1986). The ecological approach to visual perception. Hillsdale, NJ: Erlbaum.Good, T. L., \& Brophy, J. (1995). Contemporary educational psychology (5th ed.). White Plains, NY: Longman.Greeno, J. G., \& Middle School Mathematics Through Applications Project Group (1998). Die Situativität von Wissen, Lernen und Forschung. American Psychologist, 53(1), 5-26.Greeno, J. G. (1994). Gibson's affordances. Psychological Review, 101(2), 236-342.Lave, J., \& Wenger, E. (1991). Situiertes Lernen: Legitimate peripheral participation. Cambridge, UK: Cambridge University Press.Mayer, R. E. (1987). Pädagogische Psychologie: Ein kognitiver Ansatz. Boston: Little, Brown and Co.Moore, M. G., \& Kearsley, G. (1996). Distance Education: A systems view. Albany, NY: Wadsworth.Newby, T. J., Stepich, D. A., Lehman, J. D., \& Russell, J. D. (2000). Instruction technology for teaching and learning. Upper Saddle River, NJ: Merrill.Ormrod, J. E. (1995). Human learning (2nd ed.). Englewood Cliffs, NJ: Prentice Hall.Phipps, R., \& Merisotis, J. P. (1999, April). What's the Difference? A review of contemporary research on the effectiveness of distance learning in higher education. Washington, DC: The Institute for Higher Education Policy.Pressley, M., \& McCormick, C. B. (1995). Advanced education psychology for educators, researchers, and policymakers. New York: HaperCollins.Roblyer, M. D., \& Edwards, J. (2000). Integrating educational technology into teaching (2nd ed.). Upper Saddle River, NJ: Merrill.Schunk, D. H. (2000). Learning Theories (3rd Ed.). Englewood Cliff, NJ: Prentice- Hall.Slavin, R. E. (1994). Pädagogische Psychologie: Theorie und Praxis (5. Aufl.). Boston: Allyn and Bacon.Woolfolk, A. E. (1995). Pädagogische Psychologie (6. Aufl.). Needham Heights, MA: Simon \& Schuster.Young, M. F. (1993). Instructional design for situated learning. Educational Technology Research and Development, 41(1), 43-58.
