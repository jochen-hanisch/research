@incollection{matzen2023Tmw,
  title = {Task {{Matters When Scanning Data Visualizations}}},
  booktitle = {Visualization {{Psychology}}},
  author = {Matzen, Laura E. and Divis, Kristin M. and Cronin, Deborah A. and Haass, Michael J.},
  editor = {Albers Szafir, Danielle and Borgo, Rita and Chen, Min and Edwards, Darren J. and Fisher, Brian and Padilla, Lace},
  date = {2023},
