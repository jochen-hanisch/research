	file = {Deci, Edward L. und Ryan, Richard M. - 2017 - Die Selbstbestimmungstheorie der Motivation und ih.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/SZUC9W8R/Deci, Edward L. und Ryan, Richard M. - 2017 - Die Selbstbestimmungstheorie der Motivation und ih.pdf:application/pdf},
