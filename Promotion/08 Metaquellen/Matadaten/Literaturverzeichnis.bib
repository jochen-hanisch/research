@article{parkavi_predicting_2023,
	title = {Predicting academic performance of learners with the three domains of learning data using neuro-fuzzy model and machine learning algorithms},
	issn = {23071877},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2307187723002110},
	doi = {10.1016/j.jer.2023.09.006},
	abstract = {In recent days, learners faced difficulties learning programming courses. This research study will help the learners learn complex concepts quickly with different activities like flipped classrooms, online quizzes, learning by doing, and a virtual laboratory. This research is carried out to address the difficulties of learners and cover all the domains of learning, including knowledge, Skill, and Attitude. The fuzzy logic method has recently been applied in education to overcome these restrictions. While employing the fuzzy logic approach to evaluate student achievement, qualifications are assessed qualitatively rather than quantitatively. This research study applies Fuzzy Logic in the first stage, Factor Analysis (FA), and Machine Learning (ML) techniques in the second stage to discover essential factors associated with the effective use of Active Learning Strategies (ALS) in the Learning Management System (LMS) of information technology course learners. Fuzzy logic and neural network topology can be coupled using ANFIS, an adaptable network. FA is performed to find the critical factors for successful learners. The study compares the performance of five supervised machine learning algorithms: KNearest Neighbor, Decision Tree, Naive Bayes, Discriminant Analysis, and Support Vector Machine. These classifiers are evaluated to determine their suitability and model fit in the context of the research. In this study, real-time data is collected from B.Tech Information Technology learners. The following prediction models achieved high accuracy before FA analysis: Naive Bayes (90 \%), Support Vector Machine (89 \%), Discriminant Analysis (88 \%), Decision Tree (86 \%), and K-Nearest Neighbors (82 \%). Naive Bayes gives the best accuracy, with 90 \%. Following factor analysis (FA), the accuracy achieved by various classifiers is as follows: Naive Bayes 92 \%, K-Nearest Neighbors - 92 \%, Support Vector Machine - 90 \%, Discriminant Analysis - 89 \%, and Decision Tree - 88 \%. Among these, Naive Bayes and K-Nearest Neighbors exhibit the highest accuracy of 92 \%.},
	language = {en-GB},
	urldate = {2023-11-22},
	journal = {Journal of Engineering Research},
	author = {Parkavi, R. and Karthikeyan, P. and Sheik Abdullah, A.},
	month = sep,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Technologieintegration, Bewertungsmethoden, Promotion:Weiterführung, \#1:Zeitschriftenartikel:learning:management:system, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {S2307187723002110},
	annote = {Die Studie von Parkavi et al. (2023) untersucht, wie Lernende mit Hilfe eines Neuro-Fuzzy-Modells und maschinellen Lernalgorithmen in den drei Lernbereichen (Wissen, Fähigkeiten und Einstellungen) ihre akademische Leistung vorhersagen können. Hier ist eine detaillierte Analyse:
1. Analyse der Quelle
Die Forschung konzentriert sich auf die Vorhersage der akademischen Leistung von Studierenden im B.Tech.-Programm für Informationstechnologie. Es werden Fuzzy-Logik und maschinelle Lernalgorithmen angewendet, um komplexe Daten zu analysieren und effektive Lernstrategien zu entwickeln. Die Studie verwendet Echtzeitdaten und betrachtet verschiedene Modelle, einschließlich des adaptiven Neuro-Fuzzy Inference Systems (ANFIS).
2. Zusammenfassung der Kernaussagen
Das Hauptziel der Studie ist es, durch innovative Lehrmethoden und die Integration von Lernmanagementsystemen (LMS) die akademische Leistung zu verbessern. Die Forscher fanden heraus, dass nach einer Faktorenanalyse die Genauigkeit der verschiedenen Klassifikatoren wie folgt ist: Naive Bayes und K-Nearest Neighbors erreichen die höchste Genauigkeit von 92\%​​.
3. Darstellung der Kernaussagen anhand der Fundstellen


Vorhersagemodelle: Die Studie vergleicht die Leistung von fünf überwachten maschinellen Lernalgorithmen vor und nach der Faktorenanalyse. Vor der Analyse erzielte Naive Bayes die beste Genauigkeit mit 90\%, während nach der Analyse Naive Bayes und K-Nearest Neighbors jeweils 92\% erreichten​​.


Verwendung von ANFIS: ANFIS integriert Fuzzy-Logik mit neuronalen Netzwerktechnologien, um die Vorhersagegenauigkeit zu verbessern und effektiver auf die Komplexität und Mehrdimensionalität von Bildungsdaten zu reagieren​​.


4. Argumentationslinien
Die Studie betont, dass die Kombination aus fortgeschrittener Fuzzy-Logik und maschinellen Lernalgorithmen wesentlich zur Vorhersage und Verbesserung der akademischen Leistungen beiträgt. Die Integration dieser Technologien ermöglicht eine präzisere Analyse und Anpassung von Lehrstrategien, die auf individuelle Bedürfnisse der Lernenden abgestimmt sind​​.
5. Verschlagwortung


Technologieintegration: Einsatz von ANFIS und maschinellen Lernalgorithmen zur Analyse von Lernverhalten und Vorhersage der akademischen Leistung.


Bewertungsmethoden: Anwendung von Faktorenanalyse und maschinellen Lernalgorithmen zur Bewertung und Verbesserung von Lernstrategien.


Forschungsansätze: Nutzung von Echtzeitdaten und hybriden Modellen zur Untersuchung der Effektivität von Lehrmethoden.


Lehr- und Lerneffektivität: Bewertung des Einflusses von aktiven Lernstrategien auf die akademische Leistung.


Diese Analyse liefert Einblicke in die komplexe Integration von Fuzzy-Logik und maschinellem Lernen zur Optimierung der Bildungstechnologie und Verbesserung der Lehr- und Lernprozesse.
},
	file = {Parkavi et al. - 2023 - Predicting academic performance of learners with t.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/34DNS2U9/Parkavi et al. - 2023 - Predicting academic performance of learners with t.pdf:application/pdf},
}

@article{toring_evaluation_2023,
	title = {Evaluation of students’ satisfaction toward an adopted learning management system at {Indiana} {Aerospace} {University}: {A} structural equation modelling approach},
	volume = {28},
	issn = {10293132},
	shorttitle = {Evaluation of students’ satisfaction toward an adopted learning management system at {Indiana} {Aerospace} {University}},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1029313222000720},
	doi = {10.1016/j.apmrv.2022.12.002},
	abstract = {The global health crisis caused by COVID-19 has forced the migration of classes to online education with the help of learning management system. As students are the key stakeholders who will determine the adoption or usage of it, their perceptions of it need to be considered. In this regard, this study aims to evaluate students' satisfaction toward BrightSpace, an adopted LMS by Indiana Aerospace University, using Nguyen's (2021) LMS satisfaction model, with sex and year levels added as moderating variables. Using a quantitative cross-sectional survey design, 602 students from different degree programs participated in an online survey deployed using Google Forms. The survey aimed to test the inﬂuence of system content, instruction information, interaction, and technology quality on students' perceived LMS usefulness, and the inﬂuence of perceived usefulness on students' LMS satisfaction. The ﬁndings of structural equation modeling suggest that system content, interaction, and technology quality signiﬁcantly and positively inﬂuenced students' perceived usefulness, subsequently leading to their satisfaction with the LMS. Results further revealed that sex is a moderating variable that inﬂuences the relationships between system content and instruction information with students' perceived usefulness of the LMS. Also, year level is a moderating variable of the relationships between system content and interaction with their perceived usefulness of the LMS. In conclusion, this study reveals the model's usefulness in understanding the factors inﬂuencing students' satisfaction with an LMS. Consequently, the results offer practical implications for practitioners in designing and increasing LMS satisfaction to create a more effective learning environment.},
	language = {en-GB},
	number = {3},
	urldate = {2023-11-22},
	journal = {Asia Pacific Management Review},
	author = {Toring, Harold and Legaspi, Giovanni and Omolon, Jerryford and Amadeo, Rodnie and Amadeo, Estrellita and Opolentisima, Queenie and Barina, Vicente and Cacho, Truman and Illustrimo, Flordeliza and Cortes, Sylvester},
	month = sep,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Bewertungsmethoden, Promotion:Argumentation, \#1:Zeitschriftenartikel:learning:management:system, Datenschutz und IT-Sicherheit, Lernsystemarchitektur, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {336--346},
	annote = {1. Analyse der Quelle
Die Studie von Toring et al. (2023) untersucht die Zufriedenheit von Studierenden mit einem an der Indiana Aerospace University eingeführten Lernmanagementsystem (LMS) namens BrightSpace, unter Verwendung von Nguyen's LMS Zufriedenheitsmodell. Es wird geprüft, wie Systeminhalt, Instruktionsinformation, Interaktion und technische Qualität die wahrgenommene Nützlichkeit des LMS beeinflussen und wie diese wiederum die Zufriedenheit der Studierenden beeinflusst. Sex und Studienjahr werden als moderierende Variablen hinzugefügt.
2. Zusammenfassung der Kernaussagen
Die Studie identifiziert, dass der Systeminhalt, die Interaktion und die technische Qualität des LMS signifikant und positiv die wahrgenommene Nützlichkeit beeinflussen, was wiederum zur Zufriedenheit der Studierenden beiträgt. Sex und Studienjahr moderieren einige dieser Beziehungen, wobei geschlechtsspezifische Unterschiede besonders in der Wahrnehmung von Systeminhalt und Instruktionsinformationen festgestellt werden.
3. Argumentationslinien
Die Ergebnisse unterstützen die Annahme, dass eine gut gestaltete Lernplattform, die effektive Interaktion und technische Zuverlässigkeit bietet, zur Zufriedenheit der Studierenden beiträgt. Die Rolle von moderierenden Variablen betont die Notwendigkeit, Lernsysteme an unterschiedliche Bedürfnisse und Kontexte der Lernenden anzupassen.
4. Verschlagwortung


Lernsystemarchitektur: Die Studie befasst sich mit der Struktur und Funktionalität von BrightSpace und deren Auswirkungen auf die Lernenden.


Lehr- und Lerneffektivität: Die Analyse der Beziehungen zwischen Systemkomponenten und der Zufriedenheit der Studierenden zeigt, wie das LMS die Lerneffektivität beeinflusst.


Technologieintegration: Die Integration von BrightSpace und die Untersuchung der technischen Qualität unterstreichen die Bedeutung einer nahtlosen Technologieintegration.


Bewertungsmethoden: Die Verwendung von struktureller Gleichungsmodellierung (SEM) zur Bewertung der Studierendenzufriedenheit zeigt fortgeschrittene Bewertungsmethoden.


Datenschutz und IT-Sicherheit: Obwohl nicht direkt erwähnt, impliziert die Betonung der technischen Qualität eine zugrundeliegende Betrachtung der Datensicherheit.


Diese Analyse zeigt die Notwendigkeit, LMS nicht nur als technologische Werkzeuge, sondern auch als pädagogische Plattformen zu verstehen, die aktiv auf die Bedürfnisse und das Wohlbefinden der Studierenden eingehen müssen.
},
	file = {Toring et al. - 2023 - Evaluation of students’ satisfaction toward an ado.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/QCYTELKN/Toring et al. - 2023 - Evaluation of students’ satisfaction toward an ado.pdf:application/pdf},
}

@incollection{sims_learning_2021,
	address = {Berkeley, CA},
	title = {Learning {Management} {Systems}},
