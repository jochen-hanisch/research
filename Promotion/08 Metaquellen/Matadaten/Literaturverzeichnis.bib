  editor = {{Geschäftsstelle beim Stifterverband}},
  date = {2021},
  pages = {3--8},
  publisher = {Springer Fachmedien Wiesbaden},
  location = {Wiesbaden},
  doi = {10.1007/978-3-658-32849-8_1},
  url = {https://link.springer.com/10.1007/978-3-658-32849-8_1},
  urldate = {2021-12-29},
  abstract = {Zusammenfassung             Die Digitalisierung in Studium und Lehre gemeinsam gestalten – dies ist der Anspruch des Hochschulforums Digitalisierung (HFD) seit seiner Gründung 2014. In dieser Zeit  hat sich das HFD von einem institutions- und funktionsübergreifendem Expert*innennetzwerk zu einem umsetzungsorientierten Think-\&-Do-Tank weiterentwickelt. Im Mittelpunkt steht dabei eine beständig wachsende und über institutionelle Grenzen hinweg ausdifferenzierte Community, die gerade in ihrer Bereitschaft, die Aktivitäten des HFD zu unterstützen, tagtäglich unter Beweis stellt, wie produktiv Kollaboration in diesem Handlungsfeld funktionieren kann. Im Sammelband werden nun die Vielzahl von notwendigen Fragestellungen, kreativen Lösungsansätzen und strategischen Gestaltungsmöglichkeiten der Digitalisierung in Studium und Lehre sichtbar, die die vielfältige Arbeit des HFD im Kern prägt. Die programmatische Rahmung dieser Publikation basiert auf vier zentralen Thesen: (1) Zusammenarbeit ist der Schlüssel zum Erfolg, (2) Es braucht Offenheit als Haltung und Strategie, (3) Partizipation und Empowerment bewirken Bildungserfolg, (4) Innovation erfordert Mut zu neuen, ungewöhnlichen Wegen.},
  isbn = {978-3-658-32848-1 978-3-658-32849-8},
  langid = {ngerman},
  keywords = {7:Buchteil:digital:Medien,Charité:Promotion,Promotion:Literaturanalyse},
