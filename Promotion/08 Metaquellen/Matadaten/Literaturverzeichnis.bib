	doi = {10.1007/978-3-476-05673-3_10},
	abstract = {Ausgehend von Überlegungen George Herbert Meads, die dem kindlichen Spiel eine wesentliche Rolle bei der Entwicklung des personalen Selbst zuerkennen, wird in diesem Aufsatz dafür argumentiert, dass auch Computerspiele eine entsprechende Funktion bei der Herausbildung eines selbstbestimmten und selbstverantwortlichen Selbst erfüllen können. Damit wendet sich der Text zugleich gegen das gängige Pauschalurteil, Computerspiele seien gewaltverherrlichende „Killerspiele“ oder sinnloses „Daddeln“ und damit Gift für die Entwicklung des Kindes.},
