@article{bremer_virtuelles_2007,
	title = {Virtuelles {Lernen} in {Gruppen}: {Rollenspiele} und {Online}-{Diskussionen} und die {Bedeutung} von {Lerntypen}},
	language = {de-DE},
	author = {Bremer, Claudia},
	month = feb,
	year = {2007},
	keywords = {Promotion:Literaturanalyse, Kollaboratives Lernen, Promotion:Kerngedanke, Technologieintegration, Promotion:FU2a, Systemanpassung, Promotion:Relevanz:4, Bildung, Lerntypen nach Vester, \#a:Zeitschriftenartikel:online:lernen, Promotion:S:10 Online Lernen, Promotion:Literaturverzeichnis},
	pages = {15},
	annote = {Analyse der Studie „Virtuelles Lernen in Gruppen: Rollenspiele und Online-Diskussionen“ von Claudia Bremer
Hauptthemen und Ziele der Forschung
Die Studie von Claudia Bremer untersucht die Erfahrungen aus einem virtuellen Tutorium, das sich auf Gruppenarbeit und Rollenspiele in Online-Chats konzentriert. Ziel ist es, die Wirksamkeit solcher virtuellen Lernumgebungen zu evaluieren und deren Potenziale für die Weiterentwicklung internetbasierter Lehrveranstaltungen aufzuzeigen. Der Beitrag thematisiert insbesondere die Bedeutung von Lerntypen und deren Mediennutzungspräferenzen​​.
Methoden und Datenquellen


Methoden: Die Veranstaltung wurde über sechs Wochen angeboten und umfasste wöchentliche Sitzungen, die auf webbasierten Chats und einem Online-Forum basierten. Es wurden Rollenspiele durchgeführt, um die Interaktion und das Lernen in Kleingruppen zu fördern. Die Evaluation erfolgte durch einen Fragebogen, der Lernverhalten, Bewertung der Veranstaltung und Lernstile der Teilnehmenden erfasste​​.


Datenquellen: Daten wurden von 111 Studierenden der Wirtschaftswissenschaften erhoben, die sich im ersten bis vierten Semester befanden. Die Studierenden hatten unterschiedliche Vorkenntnisse im Bereich Internet und nutzten hauptsächlich PCs in universitären Poolräumen​​.


Zentrale Forschungsergebnisse


Motivation und Teilnahme: Die Hauptmotivation der Studierenden zur Teilnahme war die Prüfungsvorbereitung. 75 \% der Befragten nahmen regelmäßig an den wöchentlichen Sitzungen teil. Die Teilnahme an den Chats war besonders hoch während der Rollenspiele​​.


Rolle von Rollenspielen: Rollenspiele in den Chats wurden von 68 \% der Studierenden regelmäßig besucht. Sie trugen zur Motivation bei und wurden als unterhaltsam und verbindend wahrgenommen, auch wenn sie nicht direkt zur Prüfungsvorbereitung beitrugen​​.


Lerntypen: Die Analyse der Lerntypen nach Kolb ergab, dass Divergierer und Akkomodierer am meisten von den Rollenspielen profitierten, während Assimilierer weniger Interesse zeigten. Die Gruppenarbeit wurde insgesamt positiv bewertet, obwohl sie als mühsam empfunden wurde​​.


Zusammenfassung
Die Studie zeigt, dass virtuelle Tutorien mit einem Fokus auf Gruppenarbeit und Rollenspiele erfolgreich sein können, um die Motivation der Studierenden zu steigern und die Teilnahme zu fördern. Die Kombination von Online-Chats und Rollenspielen wird als effektiv angesehen, um die Interaktion und das soziale Lernen in virtuellen Umgebungen zu unterstützen.
Kernaussagen


Effektivität virtueller Tutorien: Virtuelle Tutorien können durch Rollenspiele und Gruppenarbeit die Motivation und das Engagement der Studierenden steigern (S. 6)​​.


Einfluss der Lerntypen: Unterschiedliche Lerntypen profitieren unterschiedlich von virtuellen Lernumgebungen, was bei der Gestaltung solcher Angebote berücksichtigt werden sollte (S. 12)​​.


Argumentationslinien
Die Autoren argumentieren, dass virtuelle Lernumgebungen, die auf interaktive und kooperative Elemente wie Rollenspiele setzen, das Lernen unterstützen und die Bindung der Studierenden an die Veranstaltung erhöhen. Sie betonen die Bedeutung, verschiedene Lerntypen bei der Gestaltung von Lehrveranstaltungen zu berücksichtigen, um die Effektivität und Attraktivität digitaler Lernangebote zu verbessern​​.
Verschlagwortung


Kollaboratives Lernen: Der Artikel zeigt die Bedeutung von Gruppenarbeit und Rollenspielen für das soziale Lernen in virtuellen Umgebungen.


Technologieintegration: Die Nutzung von webbasierten Chats und Foren als integrale Bestandteile des Lernprozesses wird thematisiert.


Systemanpassung: Anpassung der Lernumgebung an unterschiedliche Lerntypen und Vorkenntnisse der Studierenden wird untersucht.


Kategorisierung


Weiterführung: Die Studie schlägt vor, die Erkenntnisse über Lerntypen und Motivation in die Weiterentwicklung virtueller Lehr- und Lernformate zu integrieren, um deren Effektivität zu steigern​​.


Zuordnung zur Forschungsunterfrage


FU2a: Die Studie beleuchtet die Effekte von kollaborativen und interaktiven Lernmethoden auf die Lernenden in einem virtuellen Bildungsraum und unterstützt die Untersuchung, wie sich solche Ansätze auf das Lernen auswirken.


Einordnung der Relevanz


Relevanzbewertung: 4 - Relevant. Die Studie bietet wichtige Einsichten in die Gestaltung und Durchführung von virtuellen Lehrveranstaltungen und deren Einfluss auf das Lernen und die Motivation von Studierenden. Sie ist aktuell und thematisch relevant für die digitale Bildung.


},
	file = {Bremer - Virtuelles Lernen in Gruppen Rollenspiele und Onl.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/4M6QP6L4/Bremer - Virtuelles Lernen in Gruppen Rollenspiele und Onl.pdf:application/pdf},
}

@article{kleinert_work-related_2021,
	title = {Work-related online learning during the {COVID}-19 pandemic in {Germany}},
	issn = {2364-0014, 2364-0022},
	url = {https://link.springer.com/10.1007/s40955-021-00192-5},
	doi = {10.1007/s40955-021-00192-5},
	abstract = {Abstract
            The COVID-19 pandemic has made access to face-to-face learning opportunities—the most common form of adult learning—impossible. Many firms have scaled back their training investments due to economic uncertainty. One way to fill these gaps is through self-directed learning via the Internet. Learning opportunities via apps and online videos are available flexibly in terms of time and location. But can online learning substitute for the lack of face-to-face courses, especially in the workplace where constant skill updating becomes ever more important? We wanted to know if online learning opportunities were used more in the first months of the pandemic, and if so, for which purposes and by which groups. Using data from the Adult Cohort of the German National Educational Panel Study (NEPS-SC6) and a supplementary web survey conducted in May and June 2020, we show that the work-related use of online learning was stronger in these months than before the crisis. At the same time, however, educational inequalities in the use of such opportunities were larger than before the pandemic. Thus, the expansion of online learning seems to benefit highly educated workers rather than educationally disadvantaged groups.
          , 
            Zusammenfassung
            Die COVID-19-Pandemie hat den Zugang zu Lerngelegenheiten in Präsenz – der häufigsten Form des Lernens im Erwachsenenalter – unmöglich gemacht. Viele Betriebe haben auf Grund der wirtschaftlichen Unsicherheit ihre Weiterbildungsinvestitionen heruntergefahren. Eine Möglichkeit, diese Lücken zu füllen, ist das selbstgesteuerte Lernen über das Internet. Lernangebote über Apps oder Online-Videos sind zeitlich und räumlich flexibel verfügbar. Aber können Onlineangebote das Lernen in Präsenz insbesondere in der Arbeitswelt, die von immer stärkeren Lernanforderungen geprägt ist, ersetzen? Wir wollten wissen, ob Online-Angebote in den ersten Monaten der Pandemie verstärkt genutzt wurden, und wenn ja, zu welchem Zweck und von welchen Gruppen. Mit den Daten der Erwachsenenkohorte des Nationalen Bildungspanels (NEPS-SC6) sowie einer Zusatzerhebung, die im Mai und Juni 2020 durchgeführt wurde, können wir zeigen, dass die berufliche Nutzung von Online-Lernangeboten während der ersten Monate tatsächlich stärker war. Gleichzeitig haben sich Bildungsungleichheiten in der Nutzung solcher Angebote jedoch verstärkt. Von der Ausweitung des Online-Lernens scheinen eher Hochgebildete zu profitieren und nicht „bildungsferne“ Gruppen.},
	language = {en-GB},
	urldate = {2021-11-28},
	journal = {Zeitschrift für Weiterbildungsforschung},
	author = {Kleinert, Corinna and Zoch, Gundula and Vicari, Basha and Ehlert, Martin},
	month = nov,
	year = {2021},
	note = {ZSCC: 0000000},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Technologieintegration, Promotion:Argumentation, Promotion:FU5, Krisenreaktion im Bildungsbereich, \#a:Zeitschriftenartikel:online:lernen, Promotion:S:10 Online Lernen, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU5},
	annote = {Analyse der Studie "Work-related online learning during the COVID-19 pandemic in Germany" von Corinna Kleinert et al.
1. Analyse
Hauptthemen und Ziele der Forschung:
Die Studie von Corinna Kleinert et al. (2021) untersucht, wie die COVID-19-Pandemie die Nutzung von arbeitsbezogenen Online-Lernangeboten in Deutschland beeinflusst hat. Ziel ist es, festzustellen, welche Personengruppen vermehrt Online-Lernangebote genutzt haben und welche sozialen Ungleichheiten dabei bestehen. Der Fokus liegt auf der Frage, ob Online-Lernen während der Pandemie eine kompensatorische Rolle einnehmen konnte, um fehlende Präsenzlernangebote auszugleichen, und ob dies zur Verringerung von Bildungsungleichheiten beigetragen hat.
Methoden und Datenquellen:
Die Untersuchung basiert auf Daten der Erwachsenen-Kohorte des Nationalen Bildungspanels (NEPS-SC6) und einer ergänzenden Web-Umfrage, die im Mai und Juni 2020 durchgeführt wurde. Die Stichprobe umfasste 1.799 Personen, die vor und während der Pandemie zu ihrer Teilnahme an Online-Lernangeboten befragt wurden. Die Analyse erfolgte mittels logistischer Regressionsmodelle, um die Wahrscheinlichkeit der Nutzung von Online-Lernangeboten für berufliche Zwecke zu schätzen.
Zentrale Forschungsergebnisse:


Zunahme der Online-Lernnutzung: Während der ersten Monate der Pandemie stieg die Nutzung von Online-Lernangeboten für berufliche Zwecke an. Fast die Hälfte der Befragten, die Online-Lernangebote nutzten, tat dies aus beruflichen Gründen, verglichen mit nur 39 \% vor der Pandemie.


Bildungsungleichheiten: Die Pandemie hat die bestehenden Bildungsungleichheiten verschärft. Höher gebildete Arbeitnehmer nutzten Online-Lernangebote häufiger als weniger gebildete Arbeitnehmer. Diese Polarisierung deutet darauf hin, dass die digitale Kluft nicht überbrückt wurde.


Rolle der Arbeitsbedingungen: Die Möglichkeit zur Telearbeit war mit einer höheren Wahrscheinlichkeit der Nutzung von Online-Lernangeboten verbunden. Diese Gruppe erweiterte sich während der Pandemie deutlich, von unter 4 \% auf 33 \%.


2. Zusammenfassung
Die Studie analysiert die Auswirkungen der COVID-19-Pandemie auf die Nutzung von arbeitsbezogenen Online-Lernangeboten in Deutschland. Es wurde festgestellt, dass Online-Lernen in den ersten Monaten der Pandemie an Bedeutung gewann, insbesondere für berufliche Zwecke. Trotz der zunehmenden Verfügbarkeit von Online-Lernmöglichkeiten konnten Bildungsungleichheiten nicht verringert werden, da höher gebildete Arbeitnehmer tendenziell stärker von diesen Angeboten profitierten.
3. Kernaussagen


Zunahme der beruflichen Online-Lernnutzung: Während der Pandemie wurde Online-Lernen verstärkt aus beruflichen Gründen genutzt. (S. 34)


Polarisierung durch Bildung: Höher gebildete Arbeitnehmer nutzten Online-Lernangebote häufiger, was zu einer Vertiefung der Bildungsungleichheiten führte. (S. 35)


Einfluss der Telearbeit: Die Möglichkeit zur Telearbeit korrelierte positiv mit der Nutzung von Online-Lernangeboten. (S. 36)


4. Argumentationslinien
Die Autoren argumentieren, dass die Pandemie zwar die Nutzung von Online-Lernangeboten förderte, jedoch bestehende Ungleichheiten in der Bildungsteilnahme verschärfte. Besonders höher gebildete Arbeitnehmer profitierten von den neuen Lernmöglichkeiten, während bildungsferne Gruppen zurückblieben. Die Fähigkeit zur Telearbeit spielte eine Schlüsselrolle bei der Teilnahme an Online-Lernangeboten, was die Notwendigkeit betont, den Zugang zu digitalen Lernmöglichkeiten für alle Arbeitnehmer zu verbessern. (S. 37)
5. Verschlagwortung


Lehr- und Lerneffektivität: Die Studie untersucht die Effektivität von Online-Lernangeboten im beruflichen Kontext während der Pandemie.


Technologieintegration: Die Nutzung von Online-Lernplattformen und digitalen Werkzeugen in der Weiterbildung wird analysiert.


Krisenreaktion im Bildungsbereich: Die Anpassung von Bildungssystemen und Lernangeboten an die Bedingungen der Pandemie wird untersucht.


6. Kategorisierung


Argumentation: Die Studie liefert Belege dafür, dass Online-Lernen während der Pandemie zwar an Bedeutung gewann, aber bestehende Bildungsungleichheiten nicht verringert wurden. Die Rolle der Arbeitsbedingungen, insbesondere der Telearbeit, wird hervorgehoben, um die Grenzen und Möglichkeiten von Online-Lernen zu analysieren. Dies unterstützt die Forschungsunterfrage FU5, da es die Herausforderungen und Potenziale digitaler Bildung im Arbeitskontext beleuchtet. (S. 38)


7. Zuordnung zu Forschungsfragen
Passendste Forschungsunterfrage:


FU5: Welche Möglichkeiten und Grenzen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems durch Akteure im digitalen Bildungsraum von Gesundheitsberufen analysiert?


Begründung: Die Studie untersucht die Nutzung und Herausforderungen von Online-Lernen im beruflichen Kontext, was zur Beantwortung dieser Frage beiträgt.




8. Einordnung der Relevanz, Bewertungsskala


Relevanzbewertung: 4 - Relevant: Die Quelle liefert wichtige Informationen zur Rolle von Online-Lernangeboten während der Pandemie und den damit verbundenen sozialen Ungleichheiten.


},
	file = {Kleinert et al. - 2021 - Work-related online learning during the COVID-19 p.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/28GTQFV4/Kleinert et al. - 2021 - Work-related online learning during the COVID-19 p.pdf:application/pdf},
}

