	editor = {Roth, Jürgen and Baum, Michael and Eilerts, Katja and Hornung, Gabriele and Trefzger, Thomas},
	year = {2023},
	doi = {10.1007/978-3-662-66131-4_11},
	keywords = {Charité:Promotion, Promotion:Literaturanalyse, Promotion:01-02, Promotion:Eye-Tracking, Promotion:01-02 Methodenquellen, Promotion:Literaturverzeichnis},
	pages = {181--192},
