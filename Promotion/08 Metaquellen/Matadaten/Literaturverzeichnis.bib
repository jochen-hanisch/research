	abstract = {In the last years, Learning Management systems (LMSs) are acquiring great importance in online education, since they offer flexible integration platforms for organising a vast amount of learning resources, as well as for establishing effective communication channels between teachers and learners, at any direction. These online platforms are then attracting an increasing number of users that continuously access, download/upload resources and interact each other during their teaching/learning processes, which is even accelerating by the breakout of COVID-19. In this context, academic institutions are generating large volumes of learning-related data that can be analysed for supporting teachers in lesson, course or faculty degree planning, as well as administrations in university strategic level. However, managing such amount of data, usually coming from multiple heterogeneous sources and with attributes sometimes reflecting semantic inconsistencies, constitutes an emerging challenge, so they require common definition and integration schemes to easily fuse them, with the aim of efficiently feeding machine learning models. In this regard, semantic web technologies arise as a useful framework for the semantic integration of multi-source e-learning data, allowing the consolidation, linkage and advanced querying in a systematic way. With this motivation, the e-LION (e-Learning Integration ONtology) semantic model is proposed for the first time in this work to operate as data consolidation approach of different e-learning knowledge-bases, hence leading to enrich on-top analysis. For demonstration purposes, the proposed ontological model is populated with real-world private and public data sources from different LMSs referring university courses of the Software Engineering degree of the University of Malaga (Spain) and the Open University Learning. In this regard, a set of four case studies are worked for validation, which comprise advance semantic querying of data for feeding predictive modelling and time-series forecasting of students’ interactions according to their final grades, as well as the generation of SWRL reasoning rules for student’s behaviour classification. The results are promising and lead to the possible use of e-LION as ontological mediator scheme for the integration of new future semantic models in the domain of e-learning.},
	language = {en-GB},
	urldate = {2023-11-22},
	journal = {Expert Systems with Applications},
	author = {Paneque, Manuel and Roldán-García, María Del Mar and García-Nieto, José},
	month = mar,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Technologieintegration, Bewertungsmethoden, Promotion:Weiterführung, \#1:Zeitschriftenartikel:learning:management:system, Lernsystemarchitektur, Leraning:Analytics, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {118892},
	file = {Paneque et al. - 2023 - e-LION Data integration semantic model to enhance.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/U8NN7XKW/Paneque et al. - 2023 - e-LION Data integration semantic model to enhance.pdf:application/pdf},
}

@article{gachanja_e-learning_2021,
	title = {E-learning in medical education during {COVID}-19 pandemic: experiences of a research course at {Kenya} {Medical} {Training} {College}},
	volume = {21},
	issn = {1472-6920},
	shorttitle = {E-learning in medical education during {COVID}-19 pandemic},
	url = {https://bmcmededuc.biomedcentral.com/articles/10.1186/s12909-021-03050-7},
	doi = {10/gsgh3v},
	abstract = {Background:  E-learning has been widely adopted as a teaching and learning approach in medical education internationally. However, its adoption in low- and middle-income countries is still at an infantile stage. The use of e-learning may help to overcome some of the barriers to access to quality education and provide flexible, low-cost, user-centred, and easily updated learning. To address the need for research education during the COVID-19 pandemic, we developed and implemented an e-learning course for students enrolled in higher diploma courses at the Kenya Medical Training College (KMTC). In this paper, we report our experience teaching the online research course in resource-constrained settings to enable other medical educators, students and institutions in similar settings to understand the most appropriate approaches to incorporating e-learning interventions.
Methods:  This was a cross-sectional study that reviewed the experiences of learners and lecturers on a research course at Kenya Medical Training College. All higher diploma students admitted to the college in the 2020/21 academic year were invited to take part in the study. We also included all lecturers that were involved in the coordination and facilitation of the course. We analysed qualitative and quantitative data that were collected from the e-learning platform, an online course-evaluation form and reports from course lecturers.
Results:  We enrolled 933 students on the online research course. These students had joined 44 higher diploma courses in 11 campuses of the college. The students struggled to complete synchronous e-learning activities on the e-learning platform. Only 53 and 45\% of the students were able to complete the pretest and the posttest, respectively. Four themes were identified through a thematic analysis of qualitative data (1) Students gained research competencies (2) Students appreciated the use of diverse e-learning technologies (3) Students felt overwhelmed by the research course (4) Technological challenges reduce the effectiveness of online learning.
Conclusion:  Our results suggest that e-learning can be used to teach complex courses, such as research in resourceconstrained settings. However, faculty should include more asynchronous e-learning activities to enhance teaching and learning and improve student experiences.},
	language = {en-GB},
	number = {1},
	urldate = {2023-11-18},
	journal = {BMC Medical Education},
	author = {Gachanja, Francis and Mwangi, Nyawira and Gicheru, Wagaki},
	month = dec,
	year = {2021},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:FU4a, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Systemanpassung, Krisenreaktion im Bildungsbereich, Promotion:04-03:3.2, \#5:Zeitschriftenartikel:e-learning, Promotion:3.2 Entwicklung des Forschungsgegenstandes, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis, Promotion:sec:Weiterentwicklung-extern, Promotion:chap:04-03},
	pages = {612},
	annote = {Analyse der Studie „E-learning in medical education during COVID-19 pandemic: experiences of a research course at Kenya Medical Training College“ von Gachanja et al. (2021)

1. Analyse
Hauptthemen und Ziele der Forschung
Die Studie untersucht die Umsetzung eines E-Learning-Forschungskurses für Studierende in medizinischen Fachrichtungen am Kenya Medical Training College (KMTC) während der COVID-19-Pandemie. Ziel war es, Erfahrungen aus einem ressourcenlimitierten Kontext zu dokumentieren, um daraus Empfehlungen für ähnliche Institutionen abzuleiten.
Methoden und Datenquellen
Die Forschenden wählten ein querschnittliches Design, bei dem sowohl quantitative (u. a. Testteilnahmen, Plattformnutzung) als auch qualitative Daten (offene Feedbacks, Evaluationen) erhoben wurden. Die Daten stammen aus dem Moodle-LMS, Online-Evaluationsbögen sowie Berichten von Dozierenden. Die qualitative Auswertung erfolgte mittels thematischer Analyse, die quantitative Auswertung mittels deskriptiver Statistik in R.
Zentrale Forschungsergebnisse


Teilnahme und Completion Rates: Von 933 eingeschriebenen Studierenden bearbeiteten 65 \% den Pretest (53 \% vollständig), 62 \% den Posttest (45 \% vollständig), 60 \% gaben die Peer-Assignment ab, 54 \% nahmen an der Kursevaluation teil.


Vier zentrale Themen wurden identifiziert:


Kompetenzgewinn im Forschungsbereich


Wertschätzung der Vielfalt an eingesetzten Technologien


Überforderung durch Umfang und Dauer


Technologische Herausforderungen (z. B. Plattforminstabilität)




Dozierende berichteten ebenfalls über technische Herausforderungen, aber auch über positive Lerneffekte, Zusammenarbeit und Flexibilisierung.



2. Zusammenfassung
Die Studie zeigt, dass die Einführung eines E-Learning-Kurses unter Pandemiebedingungen in ressourcenarmen Regionen grundsätzlich umsetzbar ist, jedoch technologische Hürden und didaktische Überforderung überwunden werden müssen. Asynchrone Formate und technische Schulungen sind entscheidend für den Erfolg. Die positive Resonanz der Studierenden auf Inhalt und Relevanz des Kurses spricht für das Potenzial digitaler Formate in der medizinischen Weiterbildung.

3. Kernaussagen (mit Seitenangaben)


„E-learning can be used to teach complex courses [...] in resource-constrained settings“ (S. 1).


„Students felt overwhelmed by the research course“ (S. 1).


„Technological challenges reduce the effectiveness of online learning“ (S. 1).


„Only 53 \% completed the pretest and 45 \% the posttest“ (S. 3, Abb. 1).


„The Moodle platform was sometimes unavailable or had dead links“ (S. 5).


„Faculty members reported increased collaboration and interdisciplinary learning“ (S. 6).



4. Argumentationslinien
Die Argumentation folgt einer realistischen Darstellung des Spannungsfelds zwischen Potenzial und Begrenzungen von E-Learning:


Einerseits ermöglicht E-Learning die Skalierung von Lehrangeboten bei knappen Ressourcen (z. B. 22 Lehrende für 933 Studierende).


Andererseits bestehen strukturelle Hürden wie mangelnde Internetverbindung, fehlende IT-Kompetenzen und Überforderung durch mangelnde Zeitstrukturierung.


Die Autoren empfehlen asynchrone Lernaktivitäten und eine stärkere technische Vorbereitung als zentrale Lernpunkte.



5. Verschlagwortung


Technologieintegration: Nutzung von Moodle, Zoom, PDF/PPT-Ressourcen, Peer-Assessment; Schwierigkeiten mit Plattformverfügbarkeit zeigen Relevanz des Themas.


Lehr- und Lerneffektivität: Bewertet wurden Lernzuwachs, Selbstwirksamkeit und Kursqualität durch Evaluationen (z. B. Abb. 2 \& 3).


Systemanpassung: Die Implementierung in einem ressourcenlimitierten Umfeld während der Pandemie verlangt Anpassungsfähigkeit und Improvisation.


Krisenreaktion im Bildungsbereich: Die komplette Umstellung auf Online-Lehre war Reaktion auf COVID-19, wodurch digitale Transformation erzwungen wurde.


Forschungsansätze: Mixed-Methods-Design mit qualitativer (themengeleitete Analyse) und quantitativer Datenauswertung.



6. Kategorisierung
KerngedankeDie Studie illustriert, wie digitale Bildungsangebote in medizinischen Ausbildungskontexten auch unter widrigen Rahmenbedingungen (Pandemie, Ressourcenknappheit) gelingen können, wenn sie strukturiert, adaptiv und technikunterstützt konzipiert sind. Die Notwendigkeit einer lernförderlichen Infrastruktur, asynchroner Lernformenund digitaler Basiskompetenz tritt dabei klar zutage.

7. Zuordnung zu Forschungsunterfrage (FU)
FU4a – Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?
Begründung: Die Studie analysiert Lerneffekte, subjektive Bewertungen, Überforderung und Selbstwirksamkeitserleben im Zusammenhang mit der Nutzung eines LMS. Die identifizierten Mechanismen (Selbstregulation, didaktischer Medienmix, technologische Schwellen) stehen im direkten Bezug zur Wirkung des Systems auf Lernende und Lehrende.

8. Relevanzbewertung




Kriterium


Bewertung




Direkte Relevanz zur FU


5




Umfang und Tiefe der Analyse


4




Kontextbezug (medizinisch, LMS)


5




Übertragbarkeit


4




Aktualität


5




Gesamtbewertung: 5 (hoch relevant)


},
	annote = {Zusammenfassung
Hintergrund:
E-Learning hat sich als Lehr- und Lernmethode in der medizinischen Ausbildung international durchgesetzt. In Ländern mit niedrigem und mittlerem Einkommen steckt die Einführung jedoch noch in den Kinderschuhen. Der Einsatz von E-Learning kann dazu beitragen, einige der Hindernisse für den Zugang zu einer qualitativ hochwertigen Ausbildung zu überwinden und ein flexibles, kostengünstiges, nutzerzentriertes und leicht zu aktualisierendes Lernen zu ermöglichen. Um dem Bedarf an wissenschaftlicher Ausbildung während der COVID-19-Pandemie gerecht zu werden, haben wir einen E-Learning-Kurs für Studenten entwickelt und eingeführt, die in höheren Diplomkursen am Kenya Medical Training College (KMTC) eingeschrieben sind. In diesem Beitrag berichten wir über unsere Erfahrungen bei der Durchführung des Online-Forschungskurses in einem ressourcenbeschränkten Umfeld, um anderen medizinischen Ausbildern, Studenten und Einrichtungen in ähnlichen Situationen die Möglichkeit zu geben, die am besten geeigneten Ansätze für die Einbeziehung von E-Learning-Maßnahmen zu verstehen. 
Methoden:
Es handelte sich um eine Querschnittsstudie, in der die Erfahrungen von Lernenden und Dozenten in einem Forschungskurs am Kenya Medical Training College untersucht wurden. Alle Studenten, die im akademischen Jahr 2020/21 an der Hochschule zugelassen werden, wurden eingeladen, an der Studie teilzunehmen. Wir haben auch alle Dozenten einbezogen, die an der Koordination und Durchführung des Kurses beteiligt waren. Wir analysierten die qualitativen und quantitativen Daten, die auf der E-Learning-Plattform, in einem Online-Kursbewertungsformular und in den Berichten der Dozenten gesammelt wurden. 
Ergebnisse:
Wir haben 933 Studierende für den Online-Forschungskurs eingeschrieben. Diese Studenten hatten an 44 Kursen für höhere Diplome an 11 Standorten der Hochschule teilgenommen. Die Studierenden hatten Schwierigkeiten, die synchronen E-Learning-Aktivitäten auf der E-Learning-Plattform zu absolvieren. Nur 53 bzw. 45 \% der Studierenden waren in der Lage, den Pretest bzw. den Posttest zu absolvieren. Die thematische Analyse der qualitativen Daten ergab vier Themen: (1) Die Studierenden erwarben Forschungskompetenzen, (2) die Studierenden schätzten den Einsatz verschiedener E-Learning-Technologien, (3) die Studierenden fühlten sich durch den Forschungskurs überfordert, (4) technologische Herausforderungen beeinträchtigen die Wirksamkeit des Online-Lernens.  Schlussfolgerung: Unsere Ergebnisse deuten darauf hin, dass E-Learning für die Vermittlung komplexer Lehrinhalte, wie z. B. Forschung in einem ressourcenbeschränkten Umfeld, genutzt werden kann. Die Lehrkräfte sollten jedoch mehr asynchrone E-Learning-Aktivitäten einbeziehen, um das Lehren und Lernen und die Erfahrungen der Studierenden zu verbessern.  Schlüsselwörter: Kenya Medical Training College, E-learning, Forschung, COVID-19
},
	file = {Gachanja et al. - 2021 - E-learning in medical education during COVID-19 pa.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/5XQTMHQJ/Gachanja et al. - 2021 - E-learning in medical education during COVID-19 pa.pdf:application/pdf},
}

@article{stiller_modelling_2023,
	title = {Modelling e-learning acceptance of clinical staff using the general extended technology acceptance model for e-learning},
	volume = {11},
	abstract = {Companies still increasingly rely on online training to train employees continuously, effectively, and efficiently. The intention of employees in using e-learning, however, is influenced by various factors. In this study, the influence of external factors on the acceptance of online training was examined in an operational context according to the General Extended Technology Acceptance Model for E-Learning. In this model, computer experience, computer self-efficacy, computer anxiety, perceived enjoyment, and subjective norm were included as important external factors that have been shown to be relevant in numerous empirical studies. In operational contexts, few studies to date have investigated the acceptance model and even less in Europe or Germany. To investigate the influence of external factors, data of 113 employees from a medical institution were collected after participation in an online training course by means of an online questionnaire and were evaluated by regression analyses. The predictors computer experience, perceived enjoyment, and subjective norm were the strongest predictors of perceived usefulness (R2 = 0.59 of the complete model). The perceived ease of use was best explained by the factors computer experience, computer self-efficacy, computer anxiety, and enjoyment (R2 = 0.43 of the complete model). The attitude towards using e-learning and the intention to use e-learning in this study were mainly influenced by perceived usefulness (R2 = 0.67 and R2 = 0.59 of the complete models, together with perceived ease of use). Overall, the acceptance model was largely confirmed in this study.},
	language = {en-GB},
	number = {4},
	journal = {The Online Journal of Distance Education and e-Learning},
	author = {Stiller, Klaus D and Wager, Sven},
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Technologieintegration, Bewertungsmethoden, Systemanpassung, Promotion:Argumentation, Datenschutz und IT-Sicherheit, Promotion:FU1, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU1},
	annote = {1. Analyse
Hauptthemen und -ziele der Forschung: Die Studie von Stiller und Wager (2023) untersucht die Akzeptanz von E-Learning bei klinischem Personal unter Verwendung des General Extended Technology Acceptance Model for E-Learning (GETAMEL). Sie zielt darauf ab, die Einflussfaktoren zu verstehen, die die Bereitschaft des Personals beeinflussen, E-Learning-Systeme in ihrem Arbeitsumfeld zu nutzen.
Verwendete Methoden und Datenquellen: Es wurde eine quantitative Erhebung unter 113 Mitarbeitern einer medizinischen Einrichtung durchgeführt. Die Daten wurden über Online-Fragebögen gesammelt und mittels Regressionsanalysen ausgewertet, um die Beziehung zwischen externen Faktoren wie Computervertrautheit, wahrgenommener Nutzen und Einfachheit der Nutzung zu bestimmen.
Zentrale Forschungsergebnisse: Die Studie bestätigt, dass Faktoren wie Computervertrautheit, wahrgenommener Genuss und subjektive Normen starke Prädiktoren für die wahrgenommene Nützlichkeit und Benutzerfreundlichkeit von E-Learning-Systemen sind. Diese Faktoren beeinflussen deutlich die Einstellung und Intention des klinischen Personals zur Nutzung von E-Learning.
2. Zusammenfassung
Die Forschung zeigt, dass die Akzeptanz von E-Learning im klinischen Bereich stark von externen Faktoren wie der Erfahrung mit Computern, der Selbstwirksamkeitserwartung und der Angst vor Computern abhängt. Diese Elemente zusammen mit dem wahrgenommenen Genuss und den sozialen Normen spielen eine entscheidende Rolle in der Modellierung der Wahrnehmungen von Nützlichkeit und Benutzerfreundlichkeit, was wiederum die Einstellungen und Absichten zur Nutzung beeinflusst.
3. Kernaussagen


"Computervertrautheit, wahrgenommener Genuss und subjektive Normen sind signifikante Prädiktoren für die wahrgenommene Nützlichkeit von E-Learning-Systemen." (S. 3)


"Die Selbstwirksamkeit und Computerangst beeinflussen die wahrgenommene Einfachheit der Nutzung, was wiederum die Einstellungen zur Nutzung von E-Learning formt." (S. 4)


4. Argumentationslinien
Die Argumentation der Studie stützt sich darauf, dass die Akzeptanz und effektive Nutzung von E-Learning in klinischen Einstellungen verbessert werden kann, indem man die externen Faktoren adressiert, die die Technologieakzeptanz beeinflussen. Durch die Identifikation dieser Schlüsselfaktoren können gezielte Maßnahmen entwickelt werden, um die Einstellung und Nutzungsbereitschaft des klinischen Personals zu erhöhen.
5. Verschlagwortung


Technologieintegration: Die Integration von E-Learning in die klinische Ausbildung zeigt die Notwendigkeit, Technologie effektiv zu implementieren.


Forschungsansätze: Der Einsatz des erweiterten Technologieakzeptanzmodells unterstreicht den methodischen Ansatz zur Untersuchung von Akzeptanzfaktoren.


Datenschutz und IT-Sicherheit: Während diese speziell nicht thematisiert wurden, ist die sichere und vertrauensvolle Handhabung von E-Learning-Plattformen implizit kritisch für die Akzeptanz.


Kategorie: Argumentation
Die Studie nutzt theoretische Modelle und empirische Daten, um die Bedeutung externer Faktoren für die Akzeptanz von E-Learning-Systemen im klinischen Bereich zu untermauern und argumentiert, dass eine gezielte Adressierung dieser Faktoren die Nutzungsbereitschaft erhöhen kann.
},
	annote = {Analyse der Studie „Modelling E-Learning Acceptance of Clinical Staff Using the General Extended Technology Acceptance Model for E-Learning“ von Stiller \& Wager (2023)

1. Hauptthemen und Ziele der Forschung
Die Studie zielt auf die Analyse der Akzeptanzfaktoren von E-Learning im klinischen Arbeitsumfeld unter Anwendung des General Extended Technology Acceptance Model for E-Learning (GETAMEL) ab. Dabei wird untersucht, inwieweit externe Variablen wie Computererfahrung (CEXP), Selbstwirksamkeit (CSE), Computerangst (CANX), soziale Norm (SN) und wahrgenommenes Vergnügen (PENJ) die Nützlichkeit (PU) und Benutzerfreundlichkeit (PEoU) eines E-Learning-Moduls zur Händehygiene beeinflussen und damit die Einstellung (AtU) sowie die Nutzungsintention (ItU) beeinflussen.

2. Methoden und Datenquellen


Studiendesign: Quantitativ, querschnittlich


Stichprobe: 113 Teilnehmende aus einer medizinischen Einrichtung in Bayern, darunter Pflegekräfte, Ärztinnen und Therapeutinnen (S. 8).


Lernumgebung: Ein Moodle-basiertes E-Learning-Modul zur Händehygiene mit sieben Kapiteln und integrierter Abschlussprüfung.


Messinstrumente: Standardisierte, validierte Fragebogenskalen mit Likert-Skalen (1–5) zu allen neun Variablen des GETAMEL (Tab. 6, S. 10), übersetzt ins Deutsche und rückübersetzt.


Analyseverfahren: Korrelationen, multiple lineare Regressionsanalysen, Test auf Homoskedastizität (Koenker), Multikollinearität (Toleranz), Autokorrelation (Durbin-Watson) (S. 13–14).



3. Zentrale Forschungsergebnisse


Die größte Varianzaufklärung für PU (R² = .59) stammt von CEXP, SN und PENJ, wobei PENJ der stärkste Prädiktor ist.


Die wahrgenommene Benutzerfreundlichkeit (PEoU) wird durch CEXP, CSE, CANX und PENJ beeinflusst (R² = .43). SN hatte keinen signifikanten Einfluss.


AtU und ItU werden am stärksten durch PU beeinflusst (jeweils R² = .67), PEoU hat nur geringen Einfluss.


CANX zeigte keinen Effekt auf PU, was den Erwartungen entsprach. Überraschend war, dass CSE keinen Einfluss auf PU hatte.



4. Zusammenfassung
Diese Studie evaluiert die Relevanz externer Einflussfaktoren auf die Akzeptanz eines Moodle-basierten E-Learning-Tools im Gesundheitswesen. Mit einem differenzierten statistischen Modell zeigt sich, dass insbesondere das wahrgenommene Vergnügen sowie Computererfahrung und soziale Norm die Akzeptanz entscheidend beeinflussen. Die Ergebnisse bestätigen weitgehend die Annahmen des GETAMEL, weisen aber auch auf Grenzen hin, insbesondere in Bezug auf die Rolle der Selbstwirksamkeit.

5. Kernaussagen (mit Seitenangaben)


PENJ ist stärkster Prädiktor für PU und PEoU. (S. 12–13)


Computererfahrung (CEXP) korreliert signifikant negativ mit Computerangst (CANX). (S. 11)


SN beeinflusst PU positiv, aber nicht PEoU. (S. 12)


CSE beeinflusst PEoU, aber nicht PU. (S. 12)


CANX beeinflusst PEoU negativ, PU jedoch nicht. (S. 13)


PU ist der stärkste Prädiktor für AtU und ItU. (S. 12–13)


AtU und ItU sind stark miteinander korreliert (r = .79). (S. 11)



6. Argumentationslinien


Theoretische Fundierung: Die Autoren stützen sich auf den Technology Acceptance Model (TAM) nach Davis (1989), erweitert um externe Faktoren gemäß GETAMEL (Abdullah \& Ward, 2016).


Logik der Akzeptanz: PEoU beeinflusst PU; beide beeinflussen AtU, das wiederum ItU determiniert. Zusätzlich wirkt PU direkt auf ItU (S. 3).


Empirische Prüfung: Die Hypothesen werden mit Regressionsmodellen getestet, wobei hohe Korrelationen (r {\textgreater} .7) auf starke Modellpassung hinweisen (S. 12–13).


Kritik am Modell: Die Rolle von CSE bleibt unklar, was eine Ausweitung der GETAMEL-Modelle auf alternative externe Faktoren nahelegt (S. 14–15).



7. Verschlagwortung


Technologieintegration: Das LMS Moodle wurde durch Articulate-Inhalte ergänzt – klassische Beispiel einer komplexen Tool-Integration (S. 9).


Lehr- und Lerneffektivität: Die Effekte auf die wahrgenommene Nützlichkeit und Benutzerfreundlichkeit wurden präzise evaluiert (S. 12).


Bewertungsmethoden: Validierte, reliabel übersetzte Skalen und multiple Regressionsanalysen bilden eine robuste Bewertungsbasis (S. 10).


Forschungsansätze: Die Anwendung des GETAMEL mit Erweiterung um empirische Tests im betrieblichen Kontext stellt eine methodische Innovation dar (S. 13).


Systemanpassung: Das Moodle-System wurde kontextspezifisch mit einfachen Navigationsfunktionen und Text-/Video-Dualität angepasst (S. 9).



8. Kategorisierung
Kategorie: ArgumentationBegründung: Die Studie überprüft theoriegeleitet (TAM, GETAMEL) die Wirkung externer Einflussfaktoren auf Nutzer*innenverhalten im E-Learning. Die Argumentationsstruktur basiert auf Hypothesen, die durch empirische Modelle geprüft und mit vorhandener Literatur trianguliert werden (z. B. S. 13–14).

9. Zuordnung zur Forschungsfrage
Forschungsunterfrage: FU1Begründung: Die Studie fokussiert auf die Akzeptanz des E-Learning-Systems durch klinisches Personal im medizinischen Kontext – also genau jene Perspektive, die durch FU1 erfasst wird.

10. Relevanzbewertung


Direkter Bezug zur Fragestellung: 5


Empirische Evidenz und Modelltiefe: 5


Anwendung im Kontext Gesundheitsberufe: 5


Aktualität und Anschlussfähigkeit: 5


Gesamtbewertung: 5 – Hoch relevant


},
	file = {Stiller und Wager - 2023 - MODELLING E-LEARNING ACCEPTANCE OF CLINICAL STAFF .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/WFDN7TW5/Stiller und Wager - 2023 - MODELLING E-LEARNING ACCEPTANCE OF CLINICAL STAFF .pdf:application/pdf},
}

