@incollection{bertini2021Muk,
  title = {Manipulationssichere und per Knopfdruck verifizierbare Digital Credentials: Die Blockchain als Initiator internationaler Kooperationsprojekte},
  shorttitle = {Manipulationssichere und per Knopfdruck verifizierbare Digital Credentials},
