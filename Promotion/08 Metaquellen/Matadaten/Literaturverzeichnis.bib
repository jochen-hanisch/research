@article{miller2001Itp,
  title = {An {{Integrative Theory}} of {{Prefrontal Cortex Function}}},
  author = {Miller, Earl K. and Cohen, Jonathan D.},
  date = {2001-03},
  journaltitle = {Annual Review of Neuroscience},
  shortjournal = {Annu. Rev. Neurosci.},
  volume = {24},
