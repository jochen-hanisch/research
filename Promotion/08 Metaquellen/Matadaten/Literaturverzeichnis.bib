@article{rotter_potenziale_2022,
	title = {Potenziale von {Serious} {Games} als virtuelle {Lernumgebung} in der betrieblichen {Weiterbildung}. {Konzeptuelle} Überlegungen und empirische {Erkenntnisse}.},
	issn = {1618-8543},
	shorttitle = {Potenziale von {Serious} {Games} als virtuelle {Lernumgebung} in der betrieblichen {Weiterbildung}},
	url = {https://www.bwpat.de/ausgabe/43/rotter-etal},
	abstract = {Um den Herausforderungen zu begegnen, die sich durch technologischen Wandel und die damit verbundenen Veränderungen für eine digitalisierte Arbeit ergeben, müssen auch die Lernräume erweitert und darauf angepasst werden. Vor diesem Hintergrund haben digitale Lernspielangebote (Serious Games) ein enormes Potenzial, um die erforderlichen Fähig- und Fertigkeiten zu entwickeln, da sie authentische, komplexe Handlungssituationen simulieren und so betriebliches Lernen individuell angepasst sowie auf spielerische und motivierende Weise unterstützen können. Der Beitrag thematisiert die forschungsbasierte Konzeption von KI-gestützten Serious Games als digitales Lernangebot im Kontext virtueller Lernräume. Hierzu werden die Erkenntnisse aus einer Literaturrecherche und explorativen Bedarfsanalyse sowie die Erfahrungen bei der theoriegeleiteten Umsetzung eines Lernspielkonzepts im Rahmen des Forschungsprojekts „Serious Games für die Berufliche Bildung“ (SG4BB) exemplifiziert vorgestellt. Im Ausblick wird das bevorstehende Evaluationsvorhaben zur Untersuchung der Potenziale des spielbasierten Lernens für die Lernförderlichkeit dargelegt.},
	language = {de-DE},
	number = {43},
	urldate = {2023-02-20},
	journal = {Berufs- und Wirtschaftspädagogik - online},
	author = {Rotter, Elisabeth and Maier, Angelika and Funken, Franziska and Ziegler, Birgit and Göbel, Stefan},
	editor = {Büchter, Karin and Wilbers, Karl and Windelband, Lars and Gössling, Bernd},
	month = dec,
	year = {2022},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Bildung, Multimedia, Promotion:FU3, \#3:Zeitschriftenartikel:online:Lernumgebung, Promotion:02-01\_Q2, Promotion:S:03 Online-Lernumgebung, Promotion:Literaturverzeichnis},
	annote = {Analyse des Artikels “Potenziale von Serious Games als virtuelle Lernumgebung in der betrieblichen Weiterbildung. Konzeptuelle Überlegungen und empirische Erkenntnisse” von Elisabeth Rotter, Angelika Maier, Franziska Funken, Birgit Ziegler und Stefan Göbel (2022)
1. Identifizierung und Beschreibung der Hauptthemen und -ziele der Forschung:
Der Artikel untersucht das Potenzial von Serious Games als virtuelle Lernumgebung in der betrieblichen Weiterbildung. Ziel ist es, konzeptionelle Überlegungen und empirische Erkenntnisse darzustellen, die aufzeigen, wie Serious Games effektiv zur Entwicklung beruflicher Kompetenzen eingesetzt werden können.
2. Erkennung der verwendeten Methoden und Datenquellen:
Die Studie stützt sich auf eine Literaturrecherche und eine explorative Bedarfsanalyse. Darüber hinaus wird ein theoriegeleiteter Prozess zur Umsetzung eines Lernspielkonzepts im Rahmen des Forschungsprojekts „Serious Games für die Berufliche Bildung“ (SG4BB) vorgestellt. Zukünftige Evaluationsvorhaben zur Untersuchung der Potenziale des spielbasierten Lernens werden ebenfalls skizziert.
3. Erklärung der zentralen Forschungsergebnisse:
Die Ergebnisse zeigen, dass Serious Games authentische, komplexe Handlungssituationen simulieren können, die individuelles und motiviertes Lernen fördern. Sie bieten die Möglichkeit, Lernprozesse realitätsnah und anwendungsbezogen zu gestalten, was insbesondere in der beruflichen Weiterbildung von Vorteil ist. Die Forschung betont die Bedeutung einer sorgfältigen didaktischen Planung und der Anpassung der Lernspiele an die spezifischen Bedürfnisse der Lernenden.
Zusammenfassung
Kernpunkte des Artikels:
	•	Problemstellung: Untersuchung des Potenzials von Serious Games in der betrieblichen Weiterbildung und deren effektive Nutzung zur Kompetenzentwicklung.
	•	Methodik: Literaturrecherche, explorative Bedarfsanalyse, theoriegeleiteter Prozess zur Entwicklung von Lernspielen.
	•	Hauptergebnisse: Serious Games simulieren authentische Handlungssituationen, fördern individuelles und motiviertes Lernen und bieten anwendungsbezogene Lernumgebungen. Sorgfältige didaktische Planung und Anpassung an Lernbedürfnisse sind entscheidend.
	•	Schlussfolgerungen: Serious Games haben großes Potenzial in der beruflichen Weiterbildung, erfordern jedoch eine durchdachte didaktische Konzeption und kontinuierliche Anpassung und Evaluation.
Kernaussagen
	•	Serious Games können authentische und komplexe Handlungssituationen simulieren, die individuelles und motiviertes Lernen unterstützen (S. 2).
	•	Die Integration von Serious Games in die betriebliche Weiterbildung erfordert eine sorgfältige didaktische Planung und Anpassung an die Bedürfnisse der Lernenden (S. 5).
	•	Zukünftige Evaluationsvorhaben sind notwendig, um die Lernförderlichkeit und Effektivität von Serious Games weiter zu untersuchen (S. 7).
Argumentationslinien
	•	Aufbau der Argumente:
	•	Einleitung: Bedeutung von Serious Games und die Notwendigkeit, betriebliche Lernumgebungen an technologische Entwicklungen anzupassen.
	•	Theoretischer Rahmen: Diskussion der Rolle von Serious Games und deren Potenzial in der Weiterbildung.
	•	Methoden: Beschreibung der Literaturrecherche und der explorativen Bedarfsanalyse.
	•	Ergebnisse: Darstellung der Vorteile und Herausforderungen bei der Implementierung von Serious Games.
	•	Schlussfolgerungen: Empfehlungen für die didaktische Konzeption und zukünftige Evaluationsvorhaben.
	•	Logische Verbindungen:
	•	Verknüpfung von Theorie und Praxis: Anwendung theoretischer Erkenntnisse auf die praktische Umsetzung von Serious Games.
	•	Systematische Unterstützung: Durch detaillierte Analysen und Empfehlungen für die Implementierung und Evaluation.
Verschlagwortung
	•	Technologieintegration: Der Artikel zeigt, wie digitale Medien und Technologien, speziell Serious Games, in die betriebliche Weiterbildung integriert werden können.
	•	Lehr- und Lerneffektivität: Die Untersuchung der Effektivität von Serious Games zur Förderung von Kompetenzentwicklung und Lernmotivation.
Kategorisierung
	•	Kerngedanke: Der zentrale Gedanke des Artikels ist die Untersuchung des Potenzials von Serious Games zur Förderung von Lernprozessen und Kompetenzentwicklung in der betrieblichen Weiterbildung durch authentische und motivierende Lernumgebungen.
Forschungsfragen Zuordnung
	•	FU3: Wie sind Konzeption und relevante didaktische und bildungstechnologische Merkmale des systemisch-konstruktivistischen Learning-Management-Systems für Akteure im digitalen Bildungsraum von Gesundheitsberufen dargestellt?
Der Artikel von Rotter et al. passt zu dieser Forschungsfrage, da er die Konzeption und didaktischen Merkmale von Serious Games als digitale Lernumgebung untersucht. Die Integration von Technologien und die didaktische Planung zur Förderung von beruflichen Kompetenzen sind zentrale Themen, die für die Untersuchung der Effekte und Anforderungen an ein systemisch-konstruktivistisches Learning-Management-System relevant sind.
},
	file = {Rotter et al. - 2022 - Potenziale von Serious Games als virtuelle Lernumg.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/TYLWFTH4/Rotter et al. - 2022 - Potenziale von Serious Games als virtuelle Lernumg.pdf:application/pdf},
}

@article{ahadi_online_2021,
	title = {Online {Professional} {Learning} in {Response} to {COVID}-19—{Towards} {Robust} {Evaluation}},
	volume = {13},
	doi = {10/gj3fcv},
	number = {3},
	journal = {Future Internet},
	author = {Ahadi, Alireza and Bower, Matt and Singh, Abhay and Garrett, Michael},
	year = {2021},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Lehr- und Lerneffektivität, Technologieintegration, Promotion:Argumentation, Promotion:Relevanz:4, Promotion:FU5, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {56},
	annote = {Analyse der Studie "Online Professional Learning in Response to COVID-19—Towards Robust Evaluation" von Ahadi et al. (2021)
1. Hauptthemen und Ziele der Forschung
Die Studie untersucht die Wirksamkeit von Online-Workshops zur beruflichen Weiterbildung von Lehrkräften, die aufgrund der COVID-19-Pandemie von einem Präsenzformat auf ein Online-Format umgestellt wurden. Das Ziel der Studie ist es, die Effizienz der Evaluationsmethoden für solche Workshops zu analysieren und Empfehlungen für die zukünftige Bewertung von technologiegestützter Lehrerfortbildung zu geben.
2. Methoden und Datenquellen


Methoden: Die Studie verwendete ein Fallstudien-Design zur Evaluierung eines Online-Workshops für Lehrer. Die Evaluationsmethode basierte auf einer Synthese von sechs etablierten Evaluationsmodellen und fokussierte sich auf acht kritische Dimensionen der Bildungstechnologie-Evaluation.


Datenquellen: Die Daten wurden durch Pre- und Post-Workshop-Umfragen, Fokusgruppen und Beobachtungen gesammelt. Der Workshop fand online statt und wurde mittels Web-Konferenzsystemen und unterstützenden Technologien wie Echo360 und Google Slides durchgeführt .


3. Zentrale Forschungsergebnisse


Effektivität der Online-Workshops: Die Ergebnisse zeigten, dass Online-Workshops signifikante Verbesserungen der beruflichen Lernziele der Teilnehmer erzielen können. Die Teilnehmer berichteten über verbesserte Kenntnisse und Fähigkeiten im Umgang mit Technologie in ihrem Unterricht.


Evaluationsansatz: Der verwendete Evaluationsansatz ermöglichte es, Veränderungen in den Einstellungen und Praktiken der Lehrer objektiv zu bewerten und gleichzeitig qualitative Informationen für die Verbesserung zukünftiger Workshop-Iterationen zu liefern.


Herausforderungen und Empfehlungen: Die Autoren identifizierten Herausforderungen bei der Implementierung und Bewertung von Online-Workshops und gaben Empfehlungen zur Verbesserung der Evaluationspraktiken, um die Effektivität solcher Programme zu steigern .


4. Zusammenfassung
Die Studie von Ahadi et al. (2021) bietet eine detaillierte Analyse der Evaluationsmethoden von Online-Workshops für Lehrerfortbildung, die als Reaktion auf die COVID-19-Pandemie durchgeführt wurden. Die Ergebnisse zeigen, dass Online-Formate effektive Mittel zur Lehrerweiterbildung darstellen können, wenn sie richtig evaluiert und implementiert werden. Die Studie betont die Wichtigkeit einer robusten Evaluationsmethodik, um den Erfolg solcher Programme sicherzustellen.
5. Kernaussagen


Effektivität der Workshops: Online-Workshops können die berufliche Entwicklung von Lehrern signifikant fördern, wenn sie gut strukturiert sind (S. 2) .


Evaluationsrahmen: Eine fundierte Evaluation ist entscheidend, um die Wirksamkeit von Fortbildungsprogrammen zu messen und zu verbessern (S. 3) .


Technologieintegration: Der effektive Einsatz von Technologien in der Bildung erfordert entsprechende professionelle Entwicklung und sorgfältige Planung (S. 2) .


6. Argumentationslinien
Die Autoren argumentieren, dass die Umstellung auf Online-Formate in der Lehrerfortbildung erfolgreich sein kann, wenn Evaluationsmethoden systematisch angewandt werden. Sie betonen die Notwendigkeit, Evaluation als integralen Bestandteil der Programmgestaltung zu sehen, um den Lernerfolg der Teilnehmer zu maximieren. Die Studie liefert Einblicke in die Gestaltung und Bewertung von technologiegestützten Lehrerfortbildungsprogrammen und zeigt auf, wie solche Programme nachhaltig verbessert werden können .
7. Verschlagwortung


Technologieintegration: Die Studie analysiert die Implementierung von Technologien in der Lehrerfortbildung und deren Einfluss auf den Unterricht.


Lehr- und Lerneffektivität: Die Ergebnisse zeigen, wie Online-Workshops die beruflichen Fähigkeiten von Lehrern verbessern können.


Bewertungsmethoden: Die Studie beschreibt detailliert die Methoden zur Bewertung der Wirksamkeit von Lehrerfortbildungsprogrammen.


8. Kategorisierung: Argumentation
Die Studie nutzt eine Vielzahl von Evaluationsmodellen, um die Wirksamkeit der Workshops zu analysieren, und leitet daraus praktische Empfehlungen ab, die zur Verbesserung zukünftiger Programme beitragen können. Dies unterstützt die Forschungsunterfrage FU5, indem es die Möglichkeiten und Grenzen von Online-Formaten in der Lehrerfortbildung aufzeigt .
9. Zuordnung zu der passendsten Forschungsunterfrage


FU5: Welche Möglichkeiten und Grenzen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems durch Akteure im digitalen Bildungsraum von Gesundheitsberufen analysiert?


Begründung: Die Studie untersucht die Möglichkeiten und Herausforderungen von Online-Workshops, die auf systemisch-konstruktivistischen Prinzipien basieren, und zeigt auf, wie diese Programme die berufliche Entwicklung von Lehrern beeinflussen können .




10. Einordnung der Relevanz


Relevanzbewertung: 4 - Relevant. Die Studie liefert wichtige Einblicke in die Evaluierung von technologiegestützter Lehrerfortbildung und trägt zur Beantwortung der Forschungsfragen bei. Sie zeigt, wie Online-Workshops effektiv gestaltet und evaluiert werden können, um die berufliche Entwicklung von Lehrern zu fördern .


},
	file = {Full Text PDF:/Users/jochenhanisch-johannsen/Zotero/storage/DNU4496E/online-professional-learning-in-response-to-covid-19-towards-robust-evaluation.pdf:application/pdf},
}

@article{eiben-zach_digitales_2021,
	title = {Digitales {Lesen} in der {Hochschule}: {Ein} {Vergleich} von {Lehramtsstudierenden} mit anderen {Studierendengruppen}},
	issn = {1424-3636, 1424-3636},
	abstract = {Digitale Lesefähigkeiten sind für Lehramtsstudierende in zweifacher Form bedeutsam: Sie werden im Rahmen der eigenen Ausbildung benötigt und stellen eine an Schülerinnen und Schüler zu vermittelnde Fähigkeit dar. Dass Lehramtsstudierende mit digitalen wissenschaftlichen Texten kompetent umgehen, gewann im Rahmen der digital organisierten ‹Corona-Semester› besondere Bedeutung. Vor diesem Hintergrund untersucht der vorliegende Beitrag, wie Lehramtsstudierende den Umgang mit digitaler Lektüre in Lehrveranstaltungen wahrnahmen, wie sie ihre eigene Arbeit mit diesen Texten – auch in emotionaler und motivationaler Hinsicht sowie mit Blick auf den Austausch über das Gelesene – einschätzten und welche Hilfestellung sie von Seiten der Universitäten und Hochschulen erhielten. Mithilfe einer online durchgeführten Umfrage wurden die Einschätzungen Lehramtsstudierender mit denen von Studierenden aus anderen Studiengängen (N = 4701) verglichen. Die Untersuchung hat gezeigt: Lehramtsstudierende berichteten nicht nur von grösseren Schwierigkeiten im effizienten Umgang mit Texten am Bildschirm, sondern schätzten auch ihre Konzentration und Stimmung beim Lesen negativer ein als Studierende anderer Fächer. Insgesamt stellten sich Lehramtsstudierende weniger selbstständig und intrinsisch motiviert dar als andere Studierende. Handlungsbedarf zeichnet sich insbesondere in dem Sinne ab, dass Studierenden verstärkt für das digitale Lesen adäquate Textformate bereitzustellen sind. Auch sollten Hochschulen Studierende insgesamt stärker im Umgang mit digitalen Texten unterstützen.},
	language = {de-DE},
	number = {40},
	journal = {MedienPädagogik Zeitschrift für Theorie und Praxis der Medienbildung},
	author = {Eiben-Zach, Britta and Schwabe, Annika and Brendel-Kepser, Ina and Führer, Carolin and {Marion Krause-Wolters}},
	year = {2021},
	keywords = {Promotion:Literaturanalyse, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, \#7:Zeitschriftenartikel:digital:Medien, Promotion:FU5, Promotion:S:07 Digitale Medien, Promotion:Literaturverzeichnis},
	pages = {282--304},
	annote = {Analyse der Studie "Digitales Lesen in der Hochschule: Ein Vergleich von Lehramtsstudierenden mit anderen Studierendengruppen" von Britta Eiben-Zach et al.
1. Analyse
Hauptthemen und Ziele der Forschung:
Die Studie untersucht die digitalen Lesefähigkeiten von Lehramtsstudierenden im Vergleich zu Studierenden anderer Fachrichtungen an Hochschulen. Im Kontext der Pandemie und der damit verbundenen digitalen Semester wird der Fokus auf die Herausforderungen und Chancen des digitalen Lesens gelegt. Die Autoren möchten herausfinden, wie Lehramtsstudierende digitale Texte in ihrer Ausbildung wahrnehmen, welche Schwierigkeiten sie dabei haben und welche Unterstützung sie von ihren Universitäten erhalten​​.
Methoden und Datenquellen:


Methoden: Die Untersuchung basiert auf einer Online-Umfrage, die im Sommersemester 2020 durchgeführt wurde. Befragt wurden 4701 Studierende aus verschiedenen Studiengängen, darunter 1315 Lehramtsstudierende. Die Befragung umfasste Fragen zur Nutzung digitaler Texte, zur Motivation und zu emotionalen Aspekten beim Lesen​.


Datenquellen: Die Daten wurden an 92 Universitäten und Fachhochschulen im deutschsprachigen Raum erhoben. Der Fragebogen umfasste 134 Items, von denen die Hälfte direkt analysiert und die andere Hälfte zu Skalen zusammengefasst wurde, um die interne Konsistenz zu gewährleisten​​.


Zentrale Forschungsergebnisse:


Unterschiede im digitalen Lesen: Lehramtsstudierende berichteten von größeren Schwierigkeiten im Umgang mit digitalen Texten im Vergleich zu Studierenden anderer Fächer. Sie empfanden ihre Lesefähigkeiten als weniger effizient und hatten häufiger technische Probleme​​.


Motivation und emotionale Aspekte: Lehramtsstudierende bewerteten ihre Motivation und ihre Stimmung beim digitalen Lesen negativer als andere Studierende. Sie gaben häufiger an, dass das Lesen am Bildschirm weniger angenehm sei und sie sich weniger konzentrieren könnten​​.


Unterstützung durch Universitäten: Es zeigte sich ein Defizit in der Unterstützung durch die Hochschulen. Lehramtsstudierende erhielten weniger Hilfestellungen und Anleitungen zum effizienten Umgang mit digitalen Texten​​.


2. Zusammenfassung
Die Studie vergleicht die digitalen Lesefähigkeiten von Lehramtsstudierenden mit anderen Studierendengruppen und zeigt signifikante Unterschiede in der Wahrnehmung und Nutzung digitaler Texte. Lehramtsstudierende haben größere Schwierigkeiten und fühlen sich weniger motiviert und unterstützt beim digitalen Lesen. Die Autoren fordern eine stärkere Unterstützung durch die Universitäten, um die digitalen Kompetenzen der Studierenden zu fördern​.
3. Kernaussagen


Effizienz beim digitalen Lesen: Lehramtsstudierende empfinden das Lesen digitaler Texte als weniger effizient und haben größere technische Schwierigkeiten​.


Negative emotionale und motivationale Einstellung: Die Studierenden zeigen eine geringere Motivation und erleben häufig negative Emotionen beim digitalen Lesen​.


Mangelnde Unterstützung: Es besteht ein Defizit an universitären Unterstützungsmaßnahmen, um die digitalen Lesefähigkeiten der Studierenden zu fördern​.


4. Argumentationslinien
Die Autoren argumentieren, dass digitale Lesefähigkeiten essenziell für die akademische und berufliche Entwicklung von Lehramtsstudierenden sind. Sie betonen, dass Universitäten eine aktive Rolle spielen müssen, um diese Fähigkeiten zu fördern und die Studierenden besser auf die Anforderungen des digitalen Lernens vorzubereiten. Die Studie zeigt, dass spezifische Unterstützungsangebote notwendig sind, um die Herausforderungen des digitalen Lesens zu bewältigen​.
5. Verschlagwortung


Lehr- und Lerneffektivität: Untersuchung der Effektivität von digitalen Lesefähigkeiten und deren Einfluss auf das Lernen.


Technologieintegration: Analyse der Nutzung digitaler Technologien im Hochschulbereich.


Kollaboratives Lernen: Betrachtung der Rolle des Austauschs über digitale Texte in der Hochschullehre.


6. Kategorisierung


Weiterführung: Die Studie liefert wertvolle Erkenntnisse für die Weiterentwicklung von Unterstützungsangeboten im digitalen Lesen und zeigt auf, wie Lehramtsstudierende besser auf die Herausforderungen des digitalen Lernens vorbereitet werden können​.


7. Zuordnung zu Forschungsfragen
Passendste Forschungsunterfrage:


FU5: Welche Möglichkeiten und Grenzen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems durch Akteure im digitalen Bildungsraum von Gesundheitsberufen analysiert?


Begründung: Die Untersuchung bietet Einblicke in die Nutzung und Herausforderungen digitaler Texte, die für die Analyse der Möglichkeiten und Grenzen von LMS relevant sind​.




8. Einordnung der Relevanz


Relevanzbewertung: 4 - Relevant: Die Quelle liefert wichtige Informationen über digitale Lesefähigkeiten und deren Einfluss auf das Lernen und ist somit relevant für die Beantwortung der Forschungsfragen.


},
	file = {Britta Eiben-Zach et al. - 2021 - Digitales Lesen in der Hochschule Ein Vergleich v.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/THFFNNC2/Britta Eiben-Zach et al. - 2021 - Digitales Lesen in der Hochschule Ein Vergleich v.pdf:application/pdf},
}

