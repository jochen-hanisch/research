@article{niehorster2020Gos,
  title = {{{GlassesViewer}}: {{Open-source}} Software for Viewing and Analyzing Data from the {{Tobii Pro Glasses}} 2 Eye Tracker},
  shorttitle = {{{GlassesViewer}}},
  author = {Niehorster, Diederick C. and Hessels, Roy S. and Benjamins, Jeroen S.},
  date = {2020-06},
  journaltitle = {Behavior Research Methods},
  shortjournal = {Behav Res},
  volume = {52},
  number = {3},
  pages = {1244--1253},
  issn = {1554-3528},
  doi = {10/ggkh52},
  url = {http://link.springer.com/10.3758/s13428-019-01314-1},
  urldate = {2023-11-18},
  abstract = {We present GlassesViewer, open-source software for viewing and analyzing eye-tracking data of the Tobii Pro Glasses 2 head-mounted eye tracker as well as the scene and eye videos and other data streams (pupil size, gyroscope, accelerometer, and TTL input) that this headset can record. The software provides the following functionality written in MATLAB: (1) a graphical interface for navigating the study- and recording structure produced by the Tobii Glasses 2; (2) functionality to unpack, parse, and synchronize the various data and video streams comprising a Glasses 2 recording; and (3) a graphical interface for viewing the Glasses 2’s gaze direction, pupil size, gyroscope and accelerometer time-series data, along with the recorded scene and eye camera videos. In this latter interface, segments of data can furthermore be labeled through userprovided event classification algorithms or by means of manual annotation. Lastly, the toolbox provides integration with the GazeCode tool by Benjamins et al. (2018), enabling a completely open-source workflow for analyzing Tobii Pro Glasses 2 recordings.},
  langid = {british},
  keywords = {6:Zeitschriftenartikel:Bildung:Technologie,Bildungstheorien,Charité:Promotion,Lehr- und Lerneffektivität,Promotion:01-02,Promotion:01-02 Methodenquellen,Promotion:02-01_Q2,Promotion:02-01_Q3,Promotion:Argumentation,Promotion:Eye-Tracking,Promotion:FU4b,Promotion:Literaturanalyse,Promotion:S:06 Bildungstechnologie,Technologieintegration},
  file = {/Users/jochen_hanisch-johannsen/Zotero/storage/7W4R9ZEY/Niehorster et al. - 2020 - GlassesViewer Open-source software for viewing an.pdf}
}

