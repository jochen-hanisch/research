  author = {Strübing, Jörg},
  pages = {27},
  abstract = {Assuming that it is the special conception of, and emphasis on, the relationship between perspective and process that makes the pragmatist version of interactionism especially powerful in the analysis of current problems in science and technology, the article proceeds in three steps: First, the legacy of interactionisms in both the pragmatist philosophy and the early Chicago-style sociology is recapitulated. The resulting theoretical and methodological positions are then related to current issues in science and technology studies (STS), such as heterogeneous cooperation, black-boxing, and the contribution of artifacts in processes of action. Finally, the over-arching potential of this approach for general theoretical reasoning in sociology is examined: especially its potential for endeavours and products like non-dualistic theorizing, for the scalability of theoretical concepts developed in empirical research, for the integrative handling of the micro-macro distinction and for the construction of a dynamic analytical model of the relationship between structure and action.},
  langid = {ngerman},
  keywords = {FernUni-Hagen,FernUni-Hagen:MABM:M4,Promotion:01-01 Designarten,Promotion:Sprachcode-Normalisierung},
  file = {/Users/jochen_hanisch-johannsen/Zotero/storage/567BU4IB/Strübing - Prozess und Perspektive. Von der pragmatistischen .pdf}
}

