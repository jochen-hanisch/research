  keywords = {8:Zeitschriftenartikel:blended:learning,Charité:Promotion,Forschungsansätze,Lehr- und Lerneffektivität,Leraning:Analytics,Promotion:Dissertation | FU1 > Kerngedanke,Promotion:FU1,Promotion:Kerngedanke,Promotion:Literaturanalyse,Promotion:Relevanz:5,Promotion:S:08 Blended Learning,Technologieintegration},
