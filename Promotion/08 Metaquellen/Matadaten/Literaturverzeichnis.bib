@article{heinz_gelingensbedingungen_nodate,
	title = {Gelingensbedingungen für den {Einsatz} von {E}-{Portfolios} in der {Hochschullehre}},
	abstract = {E-Portfolios haben an dualen Hochschulen Potenzial zur intensiven Reflexion berufspraktischer Erfahrungen, finden jedoch in den Bachelorstudiengängen der DHBW bislang wenig Anwendung. Die Forschungsfrage lautete daher, welche Unterstützungsangebote die Bereitschaft zum Einsatz von E-Portfolios in der Lehre und als Prüfungsform erhöhen können. In einer explorativen Interviewstudie wurden drei Pilotprojekte mit verschiedenen Einsatzszenarien evaluiert. Lehrende wünschen umfassende Einführung und Begleitung, während Studierende intuitive technische Lösungen bevorzugen. Supportzentren spielen eine zentrale Rolle bei der Auswahl geeigneter technischer Lösungen und der Unterstützung der Lehrenden und tragen damit maßgeblich zum erfolgreichen Einsatz innovativer Lehr- und Prüfungsformen wie dem E-Portfolio bei.},
	language = {de},
	author = {Heinz, Aneta and Sandal, Cüneyt and Graß, Jascha and Schneider, Christina},
	keywords = {Promotion:Literaturanalyse, Promotion:S:17 E-Portfolio, Promotion:Literaturverzeichnis},
