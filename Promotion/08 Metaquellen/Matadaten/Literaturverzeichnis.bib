	editor = {{Deutscher Hochschulverband}},
	month = dec,
	year = {2004},
	keywords = {DRK-Bildungszentrum Düsseldorf, Promotion:Literaturverzeichnis, Promotion:sec:Neugier, Promotion:chap:04-02},
	pages = {89--98},
