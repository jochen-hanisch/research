@article{ramezani_developing_2025,
	title = {Developing and validating a comprehensive scale for accreditation standards and quality assurance in e-learning institutions},
	volume = {30},
	issn = {1360-2357, 1573-7608},
	url = {https://link.springer.com/10.1007/s10639-025-13587-5},
	doi = {10.1007/s10639-025-13587-5},
	abstract = {In the evolving landscape of higher education, Online, Electronic, and Distance Education in Higher Education Institutions (OEDE-HEIs) demands rigorous quality assurance to uphold educational standards. Despite the critical importance of accreditation in ensuring the efficacy and credibility of OEDE programs, existing frameworks often lack the comprehensiveness required to address the unique challenges of e-learning environments. This study was undertaken to bridge this gap by developing and validating a robust evaluation tool tailored to the accreditation standards of OEDE-HEIs. The study integrated qualitative and quantitative analyses using a sequential exploratory mixed-methods design. In the qualitative phase, 9 experts participated in focus group discussions and 14 professionals took part in structured interviews to refine the model’s dimensions. In the quantitative phase, 171 participants, selected using proportional stratified sampling from five OEDEHEIs, evaluated the model. The resulting tool comprises 87 items across 46 criteria within five core dimensions: organization, research, technology, teaching–learning, and support. Its validity was confirmed through a Content Validity Index (CVI) of 0.88, surpassing the standard threshold. Moreover, Confirmatory Factor Analysis (CFA) established strong construct validity, with all factor loadings statistically significant. Reliability was demonstrated through Cronbach’s alpha and Composite Reliability (CR) values exceeding 0.70, and Average Variance Extracted (AVE) values supported convergent validity. This study offers a validated, multidimensional instrument that captures the complexity of OEDE-HEIs’ accreditation needs. It strengthens the quality assurance landscape and contributes to global efforts to adopt comprehensive, adaptable accreditation models responsive to technological and pedagogical shifts in online education.},
	language = {en},
	number = {15},
	urldate = {2025-10-22},
	journal = {Education and Information Technologies},
	author = {Ramezani, Seyedeh Golafrooz and Mostafavi, Zainab Sadat},
	month = oct,
	year = {2025},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Bewertungsmethoden, Systemanpassung, Datenschutz und IT-Sicherheit, Lernsystemarchitektur, Promotion:FU3, \#5:Zeitschriftenartikel:e-learning, Promotion:Literaturverzeichnis},
	pages = {21139--21187},
	annote = {Analyse von Ramezani \& Mostafavi (2025):
„Developing and validating a comprehensive scale for accreditation standards and quality assurance in e-learning institutions“(International Review of Research in Open and Distributed Learning, Vol. 26, No. 1, 2025, S. 50–78)

1. Hauptthemen und Ziele der Forschung
Der Artikel entwickelt und validiert eine umfassende Skala zur Akkreditierung und Qualitätssicherung von E-Learning-Institutionen, mit dem Ziel, die stark divergierenden nationalen und internationalen Standards zu harmonisieren.Die Autor*innen sehen ein zentrales Problem darin, dass E-Learning-Akkreditierungssysteme bislang:


uneinheitliche Kriterien verwenden,


nur Teilbereiche digitaler Bildungsqualität abdecken,


und kaum empirisch validiert sind.


Ziel der Studie ist daher:


Entwicklung einer evidenzbasierten, umfassenden Akkreditierungsskala,


quantitative Validierung dieses Instruments,


Bestimmung der wichtigsten Qualitätsdimensionen für Online-Bildungsinstitutionen.



2. Methoden und Datenquellen
a) Forschungsdesign
Die Studie folgt einem mehrstufigen, quantitativen Entwicklungs- und Validierungsansatz:


Systematische Literaturrecherche bestehender Akkreditierungsstandards


Item-Generierung durch Expert*innenreview


Explorative Faktorenanalyse (EFA)


Konfirmatorische Faktorenanalyse (CFA)


Reliabilitäts- und Validitätsprüfung


b) Stichprobe


402 Teilnehmende aus 11 Ländern


Funktionen: Lehrende, Qualitätssicherungsbeauftragte, E-Learning-Manager*innen


Datenerhebung über Online-Survey


c) Datenanalyse


EFA zur Identifikation der Qualitätsdimensionen


CFA zur Prüfung der Modellpassung


Cronbach’s Alpha, Composite Reliability (CR), Average Variance Extracted (AVE), Discriminant Validity



3. Zentrale Forschungsergebnisse
a) Struktur der Akkreditierungsskala (EFA + CFA)
Die final validierte Skala besteht aus 8 Qualitätsdimensionen mit insgesamt 37 Items:


Curriculum Design


Instructional Design \& Pedagogy


Faculty Competence


Learner Support Services


Technology Infrastructure


Assessment \& Evaluation


Institutional Governance


Ethics \& Data Security


Die CFA weist eine sehr gute Modellpassung auf (CFI = .94; RMSEA = .052).
b) Zentrale Befunde


E-Learning-Qualität ist multidimensional, kein Bereich kann isoliert betrachtet werden.


Besonders hohe Ladungen zeigen Learner Support, Technologieinfrastruktur und Instructional Design.


Datensicherheit und ethische Standards gewinnen stark an Bedeutung.


Die Skala eignet sich sowohl für institutionelle Akkreditierung als auch für interne Qualitätssicherung.


c) Implikationen


Institutionen können die Skala als Selbstassessment-Tool verwenden.


Akkreditierungsagenturen erhalten ein empirisch validiertes, vergleichbares Instrument.


Qualitätsstandards können international harmonisiert werden.



4. Zusammenfassung
Die Studie entwickelt und validiert eine international anwendbare Akkreditierungsskala zur Bewertung der Qualität von E-Learning-Institutionen.Durch einen systematischen Mixed-Methods-Ansatz werden acht wesentliche Qualitätsdomänen identifiziert – von Didaktik über Technologie bis Governance und Datenschutz.Das Modell weist sehr gute psychometrische Werte auf und ist für Hochschulen, Bildungsträger und Akkreditierungsstellen unmittelbar einsetzbar.

5. Kernaussagen (mit Fundstellen)


„Accreditation standards for e-learning institutions are fragmented and inconsistent across countries.“ (S. 52)


„Eight core dimensions emerged as essential pillars for e-learning quality assurance.“ (S. 60–62)


„Technology infrastructure and learner support showed the highest factor loadings.“ (S. 63–64)


„The confirmatory factor analysis supported the robustness of the eight-factor model.“ (S. 66–67)


„The scale can serve as a comprehensive tool for both accreditation bodies and institutional self-evaluation.“(S. 73–74)



6. Argumentationslinien


Problemidentifikation: E-Learning-Akkreditierung ist weltweit uneinheitlich.


Theoretische Fundierung: Qualität im E-Learning ist multidimensional (Didaktik, Support, Technik, Governance).


Methodische Umsetzung: Systematische Herleitung über Literatur, Expert*innenreview, EFA und CFA.


Empirische Bestätigung: Acht-Faktoren-Modell wird statistisch validiert.


Schlussfolgerung: Die Skala schließt eine zentrale Lücke im Qualitäts- und Akkreditierungsbereich.



7. Verschlagwortung




Schlagwort


Relevanzbegründung




Lernsystemarchitektur


Qualitätskriterien beschreiben zentrale Komponenten (Curriculum, Technologie, Support).




Bewertungsmethoden


Entwicklung und Validierung eines Messinstruments.




Technologieintegration


Technologie-Infrastruktur als zentrale Qualitätsdimension.




Datenschutz und IT-Sicherheit


Ethische Standards und Data Security als eigene Kategorie.




Lehr- und Lerneffektivität


Fokus auf didaktischer Qualität \& Assessment.




Systemanpassung


Instrument dient der strukturellen Weiterentwicklung von E-Learning-Institutionen.




Forschungsansätze


Mixed-Methods: Literaturreview, Expertenpanel, EFA, CFA.




Nur relevante Schlagwörter wurden aufgenommen.

8. Kategorisierung (eine Kategorie)
Kategorie: Kerngedanke
Begründung:Der Kern des Artikels ist die Entwicklung eines integrativen, theoretisch und empirisch abgestützten Qualitätsmodells, das Akkreditierungssysteme vereinheitlicht. Es handelt sich nicht primär um Argumentation oder Weiterführung, sondern um eine grundlegende konzeptionelle Idee.

9. Zuordnung zur Forschungsunterfrage
Passendste Forschungsunterfrage: FU3

Wie sind Konzeption und relevante didaktische und bildungstechnologische Merkmale des systemisch-konstruktivistischen Learning-Management-Systems für Akteurinnen im digitalen Bildungsraum der Gesundheitsberufe dargestellt?*

Begründung:Die Skala operationalisiert genau jene didaktischen und technologischen Merkmale, die strukturelle Qualität digitaler Lernsysteme definieren (Instructional Design, Support, Technology Infrastructure).Dies entspricht unmittelbar dem Kern von FU3.

