@incollection{plass_taxonomy_2025,
	address = {Cham},
	title = {A {Taxonomy} for {Enhancing} {Metacognitive} {Adaptivity} and {Personalization} in {Serious} {Games} {Using} {Multimodal} {Trace} {Data}},
	volume = {15259},
	isbn = {978-3-031-74137-1 978-3-031-74138-8},
	url = {https://link.springer.com/10.1007/978-3-031-74138-8_3},
	doi = {10.1007/978-3-031-74138-8_3},
	abstract = {This paper presents a theoretically-driven and empirically-based preliminary taxonomy for optimizing metacognitive adaptivity and personalization in serious games by leveraging multimodal trace data. By integrating diverse sources of multimodal trace data, such as eye tracking, log ﬁles, concurrent verbalizations, facial expressions of emotions, physiological sensors, and screen recordings, the taxonomy aims to capture nuanced insights into learners’ metacognitive processes during gameplay. Our taxonomy focuses on six speciﬁc metacognitive processes, including judgments of learning (JOLs), feelings of knowing (FOKs), content evaluations (CEs), monitoring progress towards goals (MPTG), and monitoring use of strategies (MUS), and self-questioning (SQ). These metacognitive processes are critical in learning, reasoning, and problem solving across several learning technologies, including serious games. We provide operational deﬁnitions and examples of how each process can be captured by each multimodal data channel during gameplay. More speciﬁcally, the taxonomy facilitates the development of serious games that dynamically adjust difﬁculty levels, provide personalized feedback, and offer tailored scaffolding to enhance metacognitive development using advanced machine learning techniques, including generative AI, for real-time multimodal analysis. Through this taxonomy, researchers and developers can design and evaluate adaptive serious games that optimize metacognitive awareness, monitoring, regulation, and reﬂection, contributing to advancing the science of learning with serious games. Lastly, future research needs to empirically test these recommendations, and we expect further reﬁnements based on such testing with different serious games across various learners, tasks, domains, and educational contexts.},
	language = {en},
	urldate = {2024-11-12},
	booktitle = {Serious {Games}},
	publisher = {Springer Nature Switzerland},
	author = {Azevedo, Roger and Dever, Daryn and Wiedbusch, Megan and Brosnihan, Annamarie and Delgado, Tara and Marano, Cameron and Patel, Milouni and Smith, Kevin},
	editor = {Plass, Jan L. and Ochoa, Xavier},
	year = {2025},
	note = {Series Title: Lecture Notes in Computer Science},
	keywords = {Promotion:01-02, Promotion:01-02 Methodenquellen, Promotion:Literaturverzeichnis},
	pages = {27--40},
	file = {Azevedo et al. - 2025 - A Taxonomy for Enhancing Metacognitive Adaptivity and Personalization in Serious Games Using Multimo:/Users/jochenhanisch-johannsen/Zotero/storage/YV8VTLE2/Azevedo et al. - 2025 - A Taxonomy for Enhancing Metacognitive Adaptivity and Personalization in Serious Games Using Multimo.pdf:application/pdf},
}

@article{schuppert_automated_2023,
	title = {Automated image quality assessment for selecting among multiple magnetic resonance image acquisitions in the {German} {National} {Cohort} study},
	volume = {13},
	issn = {2045-2322},
	doi = {10.1038/s41598-023-49569-1},
	abstract = {In magnetic resonance imaging (MRI), the perception of substandard image quality may prompt repetition of the respective image acquisition protocol. Subsequently selecting the preferred high-quality image data from a series of acquisitions can be challenging. An automated workflow may facilitate and improve this selection. We therefore aimed to investigate the applicability of an automated image quality assessment for the prediction of the subjectively preferred image acquisition. Our analysis included data from 11,347 participants with whole-body MRI examinations performed as part of the ongoing prospective multi-center German National Cohort (NAKO) study. Trained radiologic technologists repeated any of the twelve examination protocols due to induced setup errors and/or subjectively unsatisfactory image quality and chose a preferred acquisition from the resultant series. Up to 11 quantitative image quality parameters were automatically derived from all acquisitions. Regularized regression and standard estimates of diagnostic accuracy were calculated. Controlling for setup variations in 2342 series of two or more acquisitions, technologists preferred the repetition over the initial acquisition in 1116 of 1396 series in which the initial setup was retained (79.9\%, range across protocols: 73-100\%). Image quality parameters then commonly showed statistically significant differences between chosen and discarded acquisitions. In regularized regression across all protocols, 'structured noise maximum' was the strongest predictor for the technologists' choice, followed by 'N/2 ghosting average'. Combinations of the automatically derived parameters provided an area under the ROC curve between 0.51 and 0.74 for the prediction of the technologists' choice. It is concluded that automated image quality assessment can, despite considerable performance differences between protocols and anatomical regions, contribute substantially to identifying the subjective preference in a series of MRI acquisitions and thus provide effective decision support to readers.},
	language = {eng},
	number = {1},
	journal = {Scientific Reports},
	author = {Schuppert, Christopher and Rospleszcz, Susanne and Hirsch, Jochen G. and Hoinkiss, Daniel C. and Köhn, Alexander and von Krüchten, Ricarda and Russe, Maximilian F. and Keil, Thomas and Krist, Lilian and Schmidt, Börge and Michels, Karin B. and Schipf, Sabine and Brenner, Hermann and Kröncke, Thomas J. and Pischon, Tobias and Niendorf, Thoralf and Schulz-Menger, Jeanette and Forsting, Michael and Völzke, Henry and Hosten, Norbert and Bülow, Robin and Zaitsev, Maxim and Kauczor, Hans-Ulrich and Bamberg, Fabian and Günther, Matthias and Schlett, Christopher L.},
	month = dec,
	year = {2023},
	keywords = {Promotion:01-02, Humans, Longitudinal Studies, Promotion:Eye-Tracking, Cohort Studies, Magnetic Resonance Imaging, Prospective Studies, ROC Curve, Promotion:01-02 Methodenquellen, Promotion:Literaturverzeichnis},
	pages = {22745},
	file = {Volltext:/Users/jochenhanisch-johannsen/Zotero/storage/MJKSKRDR/Schuppert et al. - 2023 - Automated image quality assessment for selecting a.pdf:application/pdf},
}

@article{hartmann_effects_nodate,
	title = {Effects of environmental details \& coherence formation},
	abstract = {This study examines how coherence between environmental details and verbal learning content in immersive virtual reality (IVR) influences. It bridges research on multimedia learning and IVR-based learning environments. In a two-factor experiment, environmental details (360° immersive scene vs. 2D static scene) and content coherence (text coherent with environment vs. incoherent) were manipulated. N = 77 students explored a virtual replica of the Sistine Chapel. Measures included spatial ability and presence, enjoyment, cognitive load, knowledge acquisition and eye-tracking data. Immersive presentation of environmental details increased enjoyment and drew attention to background elements, but did not improve learning. Results further showed that incoherent content led to better learning performance, possibly due to lower intrinsic cognitive load and higher perceived enjoyment of the learning material. Spatial presence was positively correlated with enjoyment, but enjoyment did not show a direct relationship with knowledge acquisition. In fact, spatial presence was negatively correlated with learning. Eye tracking analyses validated the operationalization of coherence, revealing a distinct allocation of attention based on coherence levels. The results may be explained by the complexity of the learning environment. The regulation of coherence building may only become relevant in more complex, dynamic IVR environments where information is not presented statically and requires attentional regulation by learners. The results also show that immersive features do not guarantee better learning outcomes but may increase user enjoyment. Future research should explore dynamic IVR settings and use gaze-based process analysis to better understand how students learn in IVRs.},
	language = {en},
	author = {Hartmann, Christian and Kosel, Christian and Wolf, Annabel and Bannert, Maria},
	keywords = {Promotion:01-02, Promotion:01-02 Methodenquellen, Promotion:Literaturverzeichnis},
	file = {Hartmann et al. - Effects of environmental details & coherence formation:/Users/jochenhanisch-johannsen/Zotero/storage/Z4E6IBJ5/Hartmann et al. - Effects of environmental details & coherence formation.pdf:application/pdf},
}

