}

@article{bagheri_effect_2025,
	title = {The effect of combined training program on clinical competence and professional commitment of perioperative nursing students in laparoscopic surgery: a quasi-experimental study},
	volume = {25},
	issn = {1472-6920},
	shorttitle = {The effect of combined training program on clinical competence and professional commitment of perioperative nursing students in laparoscopic surgery},
	url = {https://bmcmededuc.biomedcentral.com/articles/10.1186/s12909-025-07400-7},
	doi = {10.1186/s12909-025-07400-7},
	abstract = {Background With rapid advancements in medical sciences, minimally invasive surgical techniques such as laparoscopy have replaced traditional open surgeries. Enhancing the clinical competence and professional commitment of operating room nurses can empower nurses and directly impact surgical outcomes and patient safety.
Methods A quasi-experimental pre-test-post-test control group design was employed. Ninety-four students were selected through convenience sampling and randomly allocated to two groups: an intervention group (n = 47) and a control group (n = 47). The intervention group received five sessions for training on laparoscopic surgical principles using E-learning, video demonstrations, and participatory methods. The control group received training using lectures and PowerPoint presentation. Data was collected using a demographic questionnaire, perceived perioperative competence scale- revised (PPCS-R), and the nursing professional commitment scale (NPCS), before and two weeks after the intervention.
Results There was no significant difference in the mean scores of clinical competence and professional commitment between the two groups at baseline (P {\textgreater} 0.05). After the intervention, the mean score of clinical competence in the intervention group was significantly higher than the control group (p = 0.005). However, there was no significant difference in the mean score of professional commitment between the two groups after the intervention (P = 0.261).
Conclusion Using a combined learning approach in laparoscopic surgery led to a significant increase in the clinical skills of nursing students, resulting in improved performance in the clinical setting. However, to further generalize the results, similar studies with larger sample sizes and in different educational settings are recommended.},
	language = {en-GB},
	number = {1},
	urldate = {2025-06-03},
	journal = {BMC Medical Education},
	author = {Bagheri, Majid and Adelmanesh, Yaser and Alizadeh, Amirali and Sadeghi Meymand, Shiva and Amiri, Azadeh and Khaki, Sahar},
	month = jun,
	year = {2025},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:FU4a, Promotion:Kerngedanke, Promotion:Relevanz:5, Systemanpassung, Bildungstheorien, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {817},
	annote = {Analyse der Studie „The learning community for involved learning – Towards cybergogy-based learning“ von Satria et al. (2025):

1. Analyse
Hauptthemen und Ziele der Forschung
Die Studie zielt auf die Etablierung und theoretische Fundierung eines Lernmodells, das auf der „Cybergogik“ basiert – einem integrativen pädagogischen Konzept für digitales Lernen. Im Zentrum steht die Frage, wie Lernende durch die Kombination von kognitiven, affektiven und sozialen Elementen aktiv am Lernprozess beteiligt werden können.
Ziele der Arbeit sind:


Entwicklung eines theoretisch fundierten Modells zur Gestaltung einer „Lern-Community“ auf Grundlage von Cybergogy.


Operationalisierung des Modells zur praktischen Anwendung in digitalen Lernsettings.


Beschreibung konkreter Gestaltungselemente und Gelingensbedingungen digitaler Lernumgebungen mit Community-Charakter.


Verwendete Methoden und Datenquellen


Methodischer Ansatz: Qualitativ-theoretische Konzeptentwicklung (kein empirisches Design).


Datenbasis: Sekundäranalyse bestehender Literatur zur Cybergogy, Community of Inquiry (CoI), E-Learning-Theorie, pädagogischer Interaktion.


Modellentwicklung: Integration von Dimensionen aus:


Kognitivem Engagement (metakognitives Lernen, Problemlösung)


Affektiver Unterstützung (Empathie, Zugehörigkeit)


Partizipativer Lernkultur (Community-Building, Verantwortung)




Zentrale Forschungsergebnisse


Entwicklung eines Modells, das drei Schlüsselkomponenten betont:


Cognitive Involvement (Reflexion, Analyse, Transfer)


Emotional Engagement (Verbindung, Empathie, Motivation)


Participation (Ko-Konstruktion, Verantwortung, Zusammenarbeit)




Verknüpfung dieser drei Ebenen soll zu einem ganzheitlich involvierten Lernprozess führen.


Die Rolle der Lehrperson wird dabei als „cybergogischer Facilitator“ beschrieben – nicht mehr reiner Wissensvermittlerin, sondern Koordinator*in einer sozial-digitalen Lernumgebung.



2. Zusammenfassung
Die Studie entwickelt ein theoretisches Rahmenmodell für eine auf Cybergogik basierende Lerncommunity in digitalen Lernräumen. Sie integriert bestehende pädagogische Konzepte wie soziale Präsenz, affektive Unterstützung und partizipatives Lernen. Ziel ist ein ganzheitlich involvierender Bildungsprozess, in dem Lernende kognitiv, emotional und sozial eingebunden sind. Die Arbeit versteht sich als konzeptuelle Grundlage für die Entwicklung von didaktisch reflektierten E-Learning-Umgebungen.

3. Kernaussagen (mit Fundstellen)


„Cybergogy involves cognitive, emotional, and participative domains“ (S. 2).


„Learning community becomes the pedagogical architecture to support involvement“ (S. 3).


„Cybergogic facilitation requires educators to adopt hybrid digital roles“ (S. 4).


„The framework fosters personalization, social connectivity, and shared responsibility“ (S. 5).


„Involved learning emerges through the interplay of metacognition, empathy, and agency“ (S. 6).



4. Argumentationslinien


Die Autor*innen beginnen mit einer Kritik an konventionellem E-Learning, das vor allem kognitiv-instruktivgeprägt ist (S. 1–2).


Es folgt die Begründung, dass effektives Lernen im digitalen Raum mehrdimensionale Involvierung erfordert – kognitiv, emotional, sozial (S. 2).


Das Konzept der „Cybergogik“ wird als integrativer Lösungsansatz vorgestellt (S. 3).


Schließlich wird ein Modell präsentiert, das auf Interaktion, Reflexion und emotionaler Eingebundenheit basiert (S. 4–5).



5. Verschlagwortung


BildungstheorienBegründung: Der gesamte Beitrag ist theoriegeleitet, insbesondere durch die Konzepte der Cybergogik und der Community of Inquiry.


Lehr- und LerneffektivitätBegründung: Ziel des Modells ist es, die Effektivität des Lernens durch holistische Involvierung zu steigern.


Kollaboratives LernenBegründung: Die Rolle der Lerncommunity und partizipativer Gestaltung stehen im Mittelpunkt.


SystemanpassungBegründung: Der Text diskutiert Anforderungen an digitale Systeme, um die beschriebenen Dimensionen realisieren zu können.


ForschungsansätzeBegründung: Die Studie liefert einen theoriegetriebenen Beitrag zur Modellbildung und dient der konzeptionellen Weiterentwicklung digitaler Lernarchitekturen.



6. Kategorisierung
Kategorie: KerngedankeBegründung: Die zentrale Hypothese der Studie besteht in der Entwicklung und Begründung eines theoretisch fundierten Lernmodells (Cybergogy) für digitale Bildungsräume.

7. Zuordnung zur Forschungsunterfrage
FU4a:„Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?“
Begründung:Die Studie liefert ein theoretisches Rahmenmodell für bildungswissenschaftliche Wirkmechanismen in digitalen Settings, mit direkter Relevanz für die Gestaltung und Bewertung von Lernprozessen in systemisch-konstruktivistischen Lernplattformen.

8. Relevanzbewertung


Direkte Relevanz: 5


Tiefe des Modells \& Innovationsgrad: 5


Theoretische Fundierung: 5


Aktualität: 5


Gesamtbewertung: 5 – Hoch relevant
},
	file = {Bagheri et al. - 2025 - The effect of combined training program on clinical competence and professional commitment of periop:/Users/jochenhanisch-johannsen/Zotero/storage/6LIWQ8NL/Bagheri et al. - 2025 - The effect of combined training program on clinical competence and professional commitment of periop.pdf:application/pdf},
}

