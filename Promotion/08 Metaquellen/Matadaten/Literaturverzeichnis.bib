@article{lin_effects_2024,
	title = {The effects of students’ self-efficacy, self-regulated learning strategy, perceived and actual learning effectiveness: {A} digital game-based learning system},
	issn = {1360-2357, 1573-7608},
	shorttitle = {The effects of students’ self-efficacy, self-regulated learning strategy, perceived and actual learning effectiveness},
	url = {https://link.springer.com/10.1007/s10639-024-12700-4},
	doi = {10.1007/s10639-024-12700-4},
	abstract = {Self-regulated learning (SRL) strategies have been identified as a valuable component of digital game-based learning system (GBLS) activities. However, few studies have focused on the effects of information feedback on self-efficacy, SRL strategies, and perceived and actual learning effectiveness. Social cognitive and SRL theories describe the learning process of monitoring, controlling, and evaluating individual behavior and the corresponding environment. Insufficient information feedback hinders learning using GBLS and results in weak perceived and actual learning effectiveness. Some researchers have investigated the information feedback intervention mechanism and its significance. The partial least square method was used to investigate a convenience sample of 240 undergraduate students to test the proposed hypotheses. The research results indicated that information feedback significantly affects self-efficacy, SRL strategy, and perceived and actual learning effectiveness. Surprisingly, the SRL strategy does not significantly affect actual learning effectiveness. The theoretical and practical implications of this study are discussed.},
	language = {en-GB},
	urldate = {2024-05-09},
	journal = {Education and Information Technologies},
	author = {Lin, Ying-Lien and Wang, Wei-Tsong and Hsieh, Min-Ju},
	month = may,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Bildungstheorien, \#0:Zeitschriftenartikel:digital:learning, Promotion:FU1, Promotion:S:12 Digital Learning, Promotion:Dissertation {\textbar} FU1 {\textgreater} Kerngedanke, Promotion:Literaturverzeichnis},
	annote = {Artikelanalyse: Lin et al. (2024) - The effects of students’ self-efficacy, self-regulated learning strategy, perceived and actual learning effectiveness: A digital game-based learning system
1. Analyse
Hauptthemen und -ziele der Forschung:
Der Artikel untersucht die Effekte von Informationsfeedback auf das Selbstwirksamkeitsempfinden, selbstregulierte Lernstrategien (SRL) sowie die wahrgenommene und tatsächliche Lerneffektivität in einem digitalen spielbasierten Lernsystem (GBLS).
Methoden und Datenquellen:
	•	Methodischer Ansatz: Verwendung der Partial Least Square (PLS) Methode zur Hypothesentestung.
	•	Stichprobe: 240 Studierende, die mit einem mobilen GBLS arbeiteten.
	•	Datenquellen: Fragebögen und Lernleistungstests (Pre- und Posttest).
Zentrale Forschungsergebnisse:
	•	Informationsfeedback hat einen signifikanten positiven Einfluss auf Selbstwirksamkeit, SRL-Strategien sowie wahrgenommene und tatsächliche Lerneffektivität.
	•	SRL-Strategien beeinflussen die tatsächliche Lerneffektivität nicht signifikant.
	•	Theoretische Implikationen betonen die Wichtigkeit von Feedback für das Lernen in digitalen Umgebungen.
2. Zusammenfassung
Problemstellung: Die Untersuchung fokussiert auf die Rolle von Informationsfeedback innerhalb eines GBLS und dessen Einfluss auf verschiedene Lernvariablen.
Methodik: Empirische Untersuchung mit der PLS-Methode, Daten gesammelt durch Fragebögen und Lernleistungstests.
Hauptergebnisse: Positiver Einfluss von Informationsfeedback auf Selbstwirksamkeit und wahrgenommene Lerneffektivität. Keine signifikanten Effekte von SRL-Strategien auf tatsächliche Lerneffektivität.
Schlussfolgerungen: Feedback ist ein kritischer Faktor für effektives Lernen in GBLS. Weitere Forschung ist nötig, um die Mechanismen hinter SRL-Strategien besser zu verstehen.
3. Kernaussagen
	•	Informationsfeedback und Selbstwirksamkeit: Informationsfeedback fördert das Selbstwirksamkeitsempfinden der Studierenden. (S. 7)
	•	SRL-Strategien und tatsächliche Lerneffektivität: SRL-Strategien zeigen keinen signifikanten Einfluss auf die tatsächliche Lerneffektivität. (S. 10)
	•	Feedback als Lernunterstützung: Feedback unterstützt das selbstregulierte Lernen und die wahrgenommene Lerneffektivität. (S. 12)
4. Argumentationslinien
	•	Feedback und Selbstwirksamkeit: Es wird argumentiert, dass Informationsfeedback Studierende dazu ermutigt, selbstbewusster und aktiver in Lernaufgaben zu agieren. Dies basiert auf sozial-kognitiver Theorie und SRL-Theorie. (S. 8)
	•	SRL-Strategien und ihre Limitationen: Trotz theoretischer Annahmen zeigen empirische Daten, dass SRL-Strategien nicht immer die tatsächliche Lerneffektivität steigern, was auf verschiedene Kontextfaktoren zurückgeführt wird. (S. 11)
	•	Wichtigkeit von Feedback: Die Rolle des Feedbacks als wesentlicher Bestandteil des Lernprozesses wird durch zahlreiche Studien unterstützt, die zeigen, dass Feedback die Lernleistung verbessert. (S. 9)
5. Verschlagwortung
	•	Lernsystemarchitektur: Das Design und die Implementierung des GBLS werden detailliert beschrieben, was Rückschlüsse auf allgemeine Lernsystemarchitekturen ermöglicht.
	•	Bildungstheorien: Die Anwendung der sozial-kognitiven Theorie und SRL-Theorie im Forschungsansatz zeigt die Bedeutung theoretischer Rahmenwerke für das Verständnis digitaler Lernprozesse.
	•	Lehr- und Lerneffektivität: Der Artikel beleuchtet Evaluationsmethoden zur Messung der Lerneffektivität, was für die Bewertung von Lehr- und Lernprozessen relevant ist.
	•	Bewertungsmethoden: Spezifische Instrumente zur Bewertung der Bildungseffektivität werden beschrieben, die auf andere Bildungsforschungsbereiche anwendbar sind.
6. Kategorisierung
Kategorie: Argumentation
Begründung: Der Artikel nutzt theoretische Rahmenwerke wie die sozial-kognitive Theorie und SRL-Theorie zur Unterstützung und Diskussion der Hypothesen, die die Effektivität von Feedback und SRL-Strategien in GBLS-Kontexten untersuchen.
7. Zuordnung zu Forschungsfragen
Hauptforschungsfrage: „Wie ist das Wirkgefüge des angewendeten Learning-Management-Systems auf Akteure im digitalem Bildungsraum von Gesundheitsberufen gestaltet?“
FU2a: Welchen Effekt erläutern Lernende im digitalen Bildungsraum von Gesundheitsberufen bei der Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems?
Relevanzbewertung: 4/5
Begründung: Die Untersuchung zeigt klare Bezüge zu den Effekten von Feedback und SRL-Strategien auf Lernende, was für die Analyse von LMS in Gesundheitsberufen relevant ist. Die methodische Strenge und die theoretische Fundierung machen die Ergebnisse wertvoll für das Verständnis des LMS-Wirkgefüges.
},
	file = {Lin et al. - 2024 - The effects of students’ self-efficacy, self-regul.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/5MIYFALJ/Lin et al. - 2024 - The effects of students’ self-efficacy, self-regul.pdf:application/pdf},
}

@article{zhang_impacts_2024,
	title = {Impacts of task value belief and relational quality on {hMOOC} learner satisfaction in the post-pandemic era: {The} mediating roles of {Learner} {Engagement} and {Knowledge} sharing},
	issn = {1360-2357, 1573-7608},
	shorttitle = {Impacts of task value belief and relational quality on {hMOOC} learner satisfaction in the post-pandemic era},
	url = {https://link.springer.com/10.1007/s10639-024-12695-y},
	doi = {10.1007/s10639-024-12695-y},
	abstract = {Despite the growing importance of MOOCs and their application in face-to-face classes since 2020, driven by the COVID-19 pandemic, existing literature offers limited research on the factors affecting the quality of hybrid MOOC (hMOOC) learning, particularly from a psychological perspective. Thus, based on the 3P model of teaching and learning, this study aims to build a psychological pathway to empirically investigate the indicators of, and their relationship with, hMOOC learning outcomes by examining task value belief and relational quality as presage variables, and learner engagement and knowledge sharing as process variables, leading to learner satisfaction as the product. A self-administered questionnaire was distributed to 750 undergraduate learners with prior experience in hMOOC learning in higher educational institutions of the People’s Republic of China (PRC). Confirmatory factor analysis (CFA), path, and mediation analyses were conducted based on structural equation modeling (SEM). The results confirmed the hypothesis that task value belief and relational quality both significantly influenced learner satisfaction in hMOOCs. Task value belief exerted indirect effects on satisfaction through learner engagement. However, it failed to predict satisfaction through knowledge sharing indirectly. Instead, task value belief affected learner engagement first and then knowledge sharing, which finally impacted satisfaction, revealing the linear relationship of TVB→LE→KS→SA. Moreover, relational quality had an indirect effect on satisfaction through both learner engagement and knowledge sharing, indicating the interrelationships of RQ→LE \& KS→SA. Theoretical and pedagogical implications are discussed in the conclusion.},
	language = {en-GB},
	urldate = {2024-05-09},
	journal = {Education and Information Technologies},
	author = {Zhang, Yunqing and Zheng, Xinmin and Shen, Bin},
	month = may,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Promotion:FU2a, Bildungstheorien, \#4:Zeitschriftenartikel:MOOC, Promotion:S:04 MOOC, Promotion:Literaturverzeichnis},
	annote = {Analyse des Artikels "Impacts of task value belief and relational quality on hMOOC learner satisfaction in the post-pandemic era" von Zhang et al. (2024)
1. Analyse
Hauptthemen und -ziele der Forschung: Der Artikel untersucht die Auswirkungen von Aufgabenwertüberzeugung und Beziehungsqualität auf die Zufriedenheit der Lernenden in hybriden MOOCs (hMOOCs) nach der COVID-19-Pandemie. Ziel ist es, die psychologischen und sozialen Faktoren zu identifizieren, die die Lernergebnisse beeinflussen.
Verwendete Methoden und Datenquellen:


Methodische Ansätze: Strukturgleichungsmodellierung (SEM), Konfirmatorische Faktorenanalyse (CFA), Pfad- und Mediationsanalysen.


Werkzeuge und Datenquellen: Selbstausgefüllter Fragebogen, verteilt an 750 Studierende in China mit Erfahrung in hMOOC-Lernen.


Zentrale Forschungsergebnisse:


Aufgabenwertüberzeugung und Beziehungsqualität beeinflussen die Zufriedenheit der Lernenden signifikant.


Aufgabenwertüberzeugung wirkt sich indirekt auf die Zufriedenheit über Lernbeteiligung aus, jedoch nicht über Wissensaustausch.


Beziehungsqualität hat sowohl über Lernbeteiligung als auch Wissensaustausch indirekte Effekte auf die Zufriedenheit.


2. Zusammenfassung
Kernpunkte des Artikels:


Problemstellung: Untersuchung der Einflussfaktoren auf die Zufriedenheit der Lernenden in hMOOCs.


Methodik: Nutzung von SEM, CFA, und Mediationsanalysen zur Analyse von Umfragedaten.


Hauptergebnisse: Positive Effekte von Aufgabenwertüberzeugung und Beziehungsqualität auf die Zufriedenheit, vermittelt durch Lernbeteiligung und Wissensaustausch.


Schlussfolgerungen: Zur Verbesserung der Zufriedenheit in hMOOCs sollten Lehrende die Aufgabenwertüberzeugung und die Beziehungsqualität in Lernumgebungen stärken.


3. Kernaussagen


Aufgabenwertüberzeugung und Zufriedenheit: „Task value belief positively affects learner satisfaction in hMOOC learning.“ (S. 1)


Beziehungsqualität und Zufriedenheit: „Relational quality positively affects learner satisfaction in hMOOC learning.“ (S. 1)


Mediationsrolle der Lernbeteiligung: „Learner engagement mediates the relationship between task value belief and learner satisfaction.“ (S. 1)


4. Argumentationslinien


Direkte und indirekte Effekte: Der Artikel argumentiert, dass sowohl direkte als auch indirekte Effekte (vermittelt durch Lernbeteiligung und Wissensaustausch) von Aufgabenwertüberzeugung und Beziehungsqualität auf die Zufriedenheit bestehen.


Wichtigkeit der Lernbeteiligung: Lernbeteiligung wird als wichtigerer Mediator für Aufgabenwertüberzeugung zur Zufriedenheit im Vergleich zu Wissensaustausch dargestellt.


5. Verschlagwortung


Bildungstheorien:


Begründung: Der Artikel nutzt das 3P-Modell und die Erwartungs-Wert-Theorie, um die Faktoren zu analysieren, die die Zufriedenheit der Lernenden beeinflussen.


Fundstelle: S. 2-3




Lehr- und Lerneffektivität:


Begründung: Der Artikel untersucht, wie Aufgabenwertüberzeugung und Beziehungsqualität die Effektivität des Lernens in hMOOCs beeinflussen.


Fundstelle: S. 5-6




Forschungsansätze:


Begründung: Nutzung von strukturgleichungsmodellbasierten Methoden zur Analyse der Daten und zur Bestätigung der Hypothesen.


Fundstelle: S. 4-5




6. Kategorisierung


Kategorie: Weiterführung


Kriterium: Vorschläge basierend auf bisherigen Forschungsergebnissen zur Weiterentwicklung des Forschungsfeldes.


Beispiel: Der Artikel schlägt vor, die Aufgabenwertüberzeugung und Beziehungsqualität in Lernumgebungen zu stärken, um die Zufriedenheit der Lernenden zu verbessern.




7. Zuordnung zu Forschungsfragen


FU2a: Welchen Effekt erläutern Lernende im digitalen Bildungsraum von Gesundheitsberufen bei der Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems?


Begründung: Der Artikel untersucht die Effekte von Aufgabenwertüberzeugung und Beziehungsqualität auf die Lernzufriedenheit, was relevant für die Analyse der Effekte von LMS im Gesundheitsbereich ist.


Fundstelle: S. 5-6




8. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 4/5


Der Artikel bietet umfassende Einblicke in die Effekte von psychologischen und sozialen Faktoren auf die Zufriedenheit der Lernenden, was für die Analyse von LMS-Effekten relevant ist.




Zitierhäufigkeit und Einfluss des Artikels: 3/5


Als aktueller Artikel aus dem Jahr 2024 hat er Potenzial für Einfluss, jedoch liegen noch keine Zitierdaten vor.




Aktualität des Artikels: 5/5


Veröffentlicht im Jahr 2024, bietet der Artikel die neuesten Perspektiven.




Gesamtbewertung: 4/5 (abgerundet)
Diese Analyse zeigt, dass der Artikel wichtige Einblicke in die psychologischen und sozialen Faktoren bietet, die die Zufriedenheit der Lernenden in hMOOCs beeinflussen. Er liefert relevante Impulse für die Untersuchung der Effekte von Learning-Management-Systemen und bietet Vorschläge zur Verbesserung der Lernumgebungen.
},
