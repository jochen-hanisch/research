@article{storey2023Ata,
  title = {{{AI Technology}} and {{Academic Writing}}: {{Knowing}} and {{Mastering}} the “{{Craft Skills}}”},
  shorttitle = {{{AI Technology}} and {{Academic Writing}}},
  author = {Storey, Valerie A.},
  date = {2023-07-11},
  journaltitle = {International Journal of Adult Education and Technology},
  volume = {14},
