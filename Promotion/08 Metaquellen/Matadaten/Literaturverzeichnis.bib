},
	file = {Hagemann et al. - 2011 - High Responsibility Teams:/Users/jochenhanisch-johannsen/Zotero/storage/R8BP7Z8F/Hagemann et al. - 2011 - High Responsibility Teams – Eine systematische Ana.pdf:application/pdf},
}

