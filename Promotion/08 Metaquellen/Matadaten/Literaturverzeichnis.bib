@article{richards_challenges_2023,
	title = {Challenges and instructor strategies for transitioning to online learning during and after the {COVID}-19 pandemic: a review of literature},
	volume = {8},
	issn = {2297-900X},
	shorttitle = {Challenges and instructor strategies for transitioning to online learning during and after the {COVID}-19 pandemic},
	url = {https://www.frontiersin.org/articles/10.3389/fcomm.2023.1260421/full},
	doi = {10.3389/fcomm.2023.1260421},
	abstract = {The COVID-19 pandemic triggered an unprecedented shift to online learning, significantly impacting the higher education landscape. This paper examines the challenges faced by faculty and students during the rapid transition to online instruction and explores best practices for delivering effective online courses. The increased adoption of online learning created stress for faculty and resulted in academic setbacks for students. Although challenges are present strategies exist to help faculty create rich online learning environments. One important element is engagement, which looks at both student engagement with the material and with their classmates and faculty. In addition to working on student engagement the faculty were now in a position that required a new type of expertise to manage online interactions, which can be much different from their experiences in traditional classrooms. Insufficient time for proper course adaptation and limited knowledge of online teaching methods added to these challenges. Effective online delivery requires careful planning, utilization of advanced instructional technologies, and creating an immersive and interactive learning environment. Faculty must also adapt their teaching strategies to accommodate the unique challenges of online instruction. This review highlights the significance of a quality learning management system (LMS) as the backbone of online courses. An effective LMS facilitates course management, content delivery, and student interaction. Future considerations include providing comprehensive faculty support and training, promoting effective communication and collaboration among students, and incorporating interactive elements into online lessons. The following will provide lessons learned from the COVID-19 pandemic which will help faculty to improve their instructional competence and social presence in the online classroom.},
	language = {en-GB},
	urldate = {2024-06-28},
	journal = {Frontiers in Communication},
	author = {Richards, Keith and Thompson, Brittany Myles Wright},
	month = sep,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Promotion:Argumentation, Promotion:Relevanz:4, \#1:Zeitschriftenartikel:learning:management:system, Lernsystemarchitektur, Promotion:FU2b, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {1260421},
	annote = {Analyse des Artikels "Challenges and Instructor Strategies for Transitioning to Online Learning During and After the COVID-19 Pandemic: A Review of Literature" von Richards und Thompson (2023)
1. Analyse
Hauptthemen und -ziele der Forschung: Der Artikel untersucht die Herausforderungen und Strategien, die Lehrkräfte bei der Umstellung auf Online-Lernen während und nach der COVID-19-Pandemie angewendet haben. Ziel ist es, die wichtigsten Schwierigkeiten zu identifizieren und bewährte Methoden zur effektiven Gestaltung und Durchführung von Online-Kursen zu ermitteln.
Verwendete Methoden und Datenquellen:


Methodische Ansätze: Systematische Überprüfung der Literatur zu den Erfahrungen und Strategien von Lehrkräften während der Pandemie.


Werkzeuge und Datenquellen: Analyse qualitativer und quantitativer Daten aus verschiedenen Studien, die sich mit den Herausforderungen und Erfolgsstrategien im Online-Lernen befassen.


Zentrale Forschungsergebnisse:


Herausforderungen: Lehrkräfte standen vor Schwierigkeiten wie unzureichender institutioneller Infrastruktur, mangelnder technischer Kenntnisse, erhöhten Arbeitsanforderungen und Erschöpfung. Studierende litten unter Unsicherheit hinsichtlich der Kursdurchführung und einem Gefühl der Isolation.


Strategien: Erfolgreiche Strategien umfassen die Nutzung von Lernmanagementsystemen (LMS), die Förderung von Interaktionen zwischen Lehrkräften und Studierenden sowie die Anpassung von Lehrmethoden an die Anforderungen des Online-Unterrichts. Die Bedeutung eines qualitativ hochwertigen LMS für die Kursverwaltung, Inhaltsvermittlung und Interaktion wird betont.


2. Zusammenfassung
Kernpunkte des Artikels:


Problemstellung: Untersuchung der Herausforderungen und Strategien bei der Umstellung auf Online-Lernen während und nach der COVID-19-Pandemie.


Methodik: Systematische Überprüfung der Literatur zu den Erfahrungen von Lehrkräften und Studierenden.


Hauptergebnisse: Identifikation der Hauptprobleme und erfolgreicher Strategien im Online-Lernen. Bedeutung eines effektiven LMS und der Förderung von Engagement und Interaktion.


Schlussfolgerungen: Die Ergebnisse bieten praktische und theoretische Implikationen für die Gestaltung und Implementierung von Online-Lernumgebungen.


3. Kernaussagen


Herausforderungen: „Faculty reported a lack of institutional infrastructure and a lack of knowledge on the technical aspects of teaching online“ (S. 1).


Strategien: „An effective LMS facilitates course management, content delivery, and student interaction“ (S. 2).


Bedeutung von Interaktion: „Student engagement with the material and with their classmates and faculty is crucial for online learning success“ (S. 2).


4. Argumentationslinien


Herausforderungen der Umstellung: Der Artikel argumentiert, dass die rasche Umstellung auf Online-Lernen erhebliche Herausforderungen für Lehrkräfte und Studierende mit sich brachte, einschließlich technischer und organisatorischer Probleme.


Bedeutung von Engagement: Es wird betont, dass das Engagement der Studierenden für den Erfolg des Online-Lernens entscheidend ist und durch gezielte Interaktionen und den Einsatz eines hochwertigen LMS gefördert werden kann.


Anpassung der Lehrstrategien: Lehrkräfte müssen ihre Lehrmethoden an die besonderen Anforderungen des Online-Unterrichts anpassen und technologische Hilfsmittel effektiv einsetzen, um den Lernprozess zu unterstützen.


5. Verschlagwortung


Lernsystemarchitektur


Begründung: Der Artikel diskutiert die Rolle von LMS in der Verwaltung und Durchführung von Online-Kursen.


Fundstelle: S. 2




Lehr- und Lerneffektivität


Begründung: Die Studie zeigt, wie Strategien zur Förderung des Engagements die Effektivität des Online-Lernens verbessern können.


Fundstelle: S. 2




Technologieintegration


Begründung: Der Artikel behandelt die Integration technologischer Hilfsmittel und deren Bedeutung für den Online-Unterricht.


Fundstelle: S. 2




6. Kategorisierung


Kategorie: Argumentation


Kriterium: Nutzung von empirischen Daten und Theorien zur Unterstützung der These, dass ein effektives LMS und gezielte Engagement-Strategien die Herausforderungen des Online-Lernens bewältigen können.


Beispiel: Der Artikel diskutiert die Rolle von LMS und Engagement-Strategien und stützt sich dabei auf empirische Daten und Berichte aus der Literatur.




7. Zuordnung zu Forschungsfragen


FU2b: Welche Effekt-Faktoren erläutern Lehrende im digitalen Bildungsraum von Gesundheitsberufen bei der Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems?


Begründung: Der Artikel untersucht die Herausforderungen und Strategien der Lehrkräfte bei der Umstellung auf Online-Lernen und ist somit relevant für die Erforschung der Effekt-Faktoren im digitalen Bildungsraum.


Fundstelle: S. 1




8. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 4/5


Der Artikel liefert detaillierte Einblicke in die Herausforderungen und Strategien der Lehrkräfte bei der Umstellung auf Online-Lernen, die relevant für die Forschungsfrage sind.




Zitierhäufigkeit und Einfluss des Artikels: 3/5


Basierend auf der systematischen Natur und dem Überblick über mehrere Studien ist der Artikel wahrscheinlich in akademischen Kreisen einflussreich.




Aktualität des Artikels: 5/5


Veröffentlicht im Jahr 2023, ist der Artikel hochaktuell und bezieht sich auf die neuesten Entwicklungen im Bereich des Online-Lernens.




Gesamtbewertung: 4/5
Diese Analyse zeigt die Relevanz des Artikels für die Untersuchung der Herausforderungen und Strategien bei der Umstellung auf Online-Lernen und bietet wertvolle Einblicke für zukünftige Forschungen und Praktiken.
