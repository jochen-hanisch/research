@article{looi2024Cuf,
  title = {Charting the Uncertain Future of {{AI}} and Education: Promises, Challenges and Opportunities},
  shorttitle = {Charting the Uncertain Future of {{AI}} and Education},
  author = {Looi, Chee-Kit},
