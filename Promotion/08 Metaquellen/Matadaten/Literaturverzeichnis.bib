@article{kumar_micro-credentials_2022,
	title = {Micro-credentials in leveraging emergency remote teaching: the relationship between novice users’ insights and identity in {Malaysia}},
	volume = {19},
	issn = {2365-9440},
	shorttitle = {Micro-credentials in leveraging emergency remote teaching},
	url = {https://educationaltechnologyjournal.springeropen.com/articles/10.1186/s41239-022-00323-z},
	doi = {10.1186/s41239-022-00323-z},
	abstract = {Micro-credentials have gained much popularity in recent years, and their popularity has skyrocketed due to emergency remote teaching instigated by the pandemic. It has been defined as a platform that provides credentials based on validated competencies. Nevertheless, in Malaysian HEI, such a concept is still novel and identifying insights on the benefits, challenges, and application are still scarce. Similarly, it was observed that there is a lack of observation on how students’ digital learning identity and their perception of professional relevance are influenced by such platform. Henceforth, based on the adapted enriched virtual model approach, a micro-credentials course was implemented to complement the new “normal” classes for a pre-service teacher’s instructional design course. A mixed-method triangulation design was used to explore the qualitative findings operationalized by open-ended questions (N = 74) with data obtained from the Digital Learning Identity Survey (DLIS) and Constructivist On-Line Learning Environment Survey (COLLES) (N = 72). The findings indicated that respondents had an overall positive perception of the use of micro-credentials to complement and overcome online learning challenges mainly due to substandard internet connectivity; nevertheless, they are unaware of the value of such credentials in their future profession. Conversely, their new identity as digital learners and experiences with a blended approach of online learning, especially with micro-credentials, was successful in shaping their identity as aspiring educators that embrace technology for teaching and learning.},
	language = {en-GB},
	number = {1},
	urldate = {2024-07-08},
	journal = {International Journal of Educational Technology in Higher Education},
	author = {Kumar, Jeya Amantha and Richard, Rachel Jasmine and Osman, Sharifah and Lowrence, Kevin},
	month = dec,
	year = {2022},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:FU4a, Promotion:Kerngedanke, Technologieintegration, Promotion:Relevanz:4, Krisenreaktion im Bildungsbereich, \#8:Zeitschriftenartikel:blended:learning, Promotion:02-01\_Q2, Promotion:S:08 Blended Learning, Promotion:Literaturverzeichnis},
	pages = {18},
	annote = {Analyse der Studie "Micro-credentials in leveraging emergency remote teaching: the relationship between novice users’ insights and identity in Malaysia" von Kumar et al. (2022)
Hauptthemen und Ziele der Forschung:
Die Studie von Kumar et al. (2022) untersucht die Rolle von Micro-Credentials bei der Unterstützung des Notfall-Fernunterrichts während der COVID-19-Pandemie in Malaysia. Ziel ist es, die Wahrnehmungen und digitalen Identitäten von Novizen, die diese Micro-Credentials nutzen, zu verstehen und deren potenzielle berufliche Relevanz zu evaluieren.
Methoden und Datenquellen:


Methoden: Mixed-Methods-Design, das qualitative und quantitative Ansätze kombiniert.


Datenquellen: Fragebögen (Digital Learning Identity Survey, DLIS und Constructivist On-Line Learning Environment Survey, COLLES) und offene Fragen. Die Stichprobe umfasste 74 Pre-Service-Lehrer, die an einem Instructional Design Kurs teilnahmen.


Zentrale Forschungsergebnisse:


Positive Wahrnehmung: Die Mehrheit der Befragten zeigte eine positive Wahrnehmung der Nutzung von Micro-Credentials zur Unterstützung des Online-Lernens. Dies wurde hauptsächlich auf die Flexibilität und Zugänglichkeit der Lernplattform zurückgeführt.


Technische Herausforderungen: Hauptsächliche Herausforderungen waren technische Probleme wie instabile Internetverbindungen und Schwierigkeiten bei der Nutzung der Online-Plattform.


Berufliche Relevanz: Die Befragten sahen die erworbenen Fähigkeiten als wertvoll für ihre zukünftige berufliche Laufbahn an, insbesondere im Hinblick auf die Gestaltung und Entwicklung von Unterrichtsmaterialien.


Zusammenfassung
Die Studie untersucht die Rolle von Micro-Credentials im Notfall-Fernunterricht in Malaysia. Es zeigt sich, dass diese Form der Zertifizierung positiv wahrgenommen wird und als wertvoll für die berufliche Entwicklung angesehen wird, obwohl technische Herausforderungen bestehen.
Kernaussagen


Positive Wahrnehmung: Micro-Credentials werden als flexibel und zugänglich wahrgenommen, was ihre Nutzung fördert.


Technische Herausforderungen: Schwierigkeiten bei der Internetverbindung und Nutzung der Plattform wurden als Hauptprobleme identifiziert.


Berufliche Relevanz: Die erworbenen Fähigkeiten werden als wertvoll für die berufliche Laufbahn angesehen, insbesondere im Bereich der Unterrichtsgestaltung.


Argumentationslinien
Die Autoren argumentieren, dass Micro-Credentials eine wertvolle Ergänzung zum Online-Lernen darstellen, insbesondere in Zeiten des Notfall-Fernunterrichts. Sie betonen die Bedeutung von Flexibilität und Zugänglichkeit sowie die Notwendigkeit, technische Herausforderungen zu überwinden.
Verschlagwortung
Passendste Schlagworte und Begründungen:


Technologieintegration: Die Studie untersucht die Integration von Micro-Credentials in den Online-Lernprozess und deren Auswirkungen auf die Lernenden.


Lehr- und Lerneffektivität: Die Untersuchung zeigt, wie Micro-Credentials zur Verbesserung der Lehr- und Lerneffektivität beitragen können.


Krisenreaktion im Bildungsbereich: Die Studie beleuchtet, wie Micro-Credentials als Reaktion auf die COVID-19-Pandemie genutzt wurden, um das Lernen aufrechtzuerhalten.


Kategorisierung


Kerngedanke: Die zentrale Idee der Studie ist die Untersuchung der Rolle von Micro-Credentials im Notfall-Fernunterricht und deren Einfluss auf die digitalen Identitäten und beruflichen Perspektiven der Lernenden.


Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU4a: Bildungswissenschaftliche Mechanismen bei Anwendung eines LMS.


Begründung: Die Studie analysiert, wie Micro-Credentials als bildungswissenschaftlicher Mechanismus wirken und die Lernenden in ihrer Rolle als zukünftige Lehrer unterstützen.
Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie untersucht umfassend die Rolle von Micro-Credentials im Notfall-Fernunterricht).


Zitierhäufigkeit und Einfluss: 4 (Die Studie ist umfassend und gut zitiert).


Aktualität: 5 (Die Studie ist von 2022 und behandelt ein aktuelles Thema).


Gesamtbewertung: 4.7
Schlussfolgerung
Die Studie zeigt, dass Micro-Credentials eine wertvolle Ergänzung zum Online-Lernen darstellen, insbesondere in Notfallsituationen wie der COVID-19-Pandemie. Sie werden positiv wahrgenommen und als wertvoll für die berufliche Entwicklung angesehen, obwohl technische Herausforderungen bestehen. Die Ergebnisse bieten wertvolle Einblicke und Empfehlungen für die zukünftige Gestaltung und Implementierung von Micro-Credentials im digitalen Bildungsbereich.
},
	file = {Kumar et al. - 2022 - Micro-credentials in leveraging emergency remote t.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/SWQ9HKV8/Kumar et al. - 2022 - Micro-credentials in leveraging emergency remote t.pdf:application/pdf},
}

@article{chen_comparing_2018,
	title = {Comparing the determinants of non-{MOOC} and {MOOC} continuance intention in {Taiwan}: {Effects} of interactivity and openness},
	volume = {36},
	copyright = {https://www.emerald.com/insight/site-policies},
	issn = {0737-8831},
	shorttitle = {Comparing the determinants of non-{MOOC} and {MOOC} continuance intention in {Taiwan}},
	url = {https://www.emerald.com/insight/content/doi/10.1108/LHT-11-2016-0129/full/html},
	doi = {10.1108/LHT-11-2016-0129},
	abstract = {Purpose – Massive open online courses (MOOCs) differ from non-MOOC e-learning platforms mainly in terms of degree of openness, with MOOCs designed to maximize learner access and interaction. The purpose of this paper is to propose a new research model to explore intention to continue to use MOOCs from the perspectives of openness and interactivity, based on related theories and dimensions from previous research. Design/methodology/approach – In order to evaluate the effectiveness of the MOOC platform, two online survey questionnaires were developed and e-mailed to the all of the university students in Taichung, Taiwan. The first one and second one are the same except the construct openness. The first one was delivered in late 2015 while the second one was delivered in the middle 2016. After the authors eliminated incomplete responses and duplicates, 995 and 854 usable responses from platform users remained, respectively, and were used to test the relationships in the model.},
	language = {en-GB},
	number = {4},
	urldate = {2024-07-08},
	journal = {Library Hi Tech},
	author = {Chen, Chia-Chen and Lee, Chun-Hsiung and Hsiao, Kuo-Lun},
	month = oct,
	year = {2018},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Promotion:FU3, \#4:Zeitschriftenartikel:MOOC, Promotion:S:04 MOOC, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU3},
	pages = {705--719},
	annote = {Analyse des Artikels "Comparing the determinants of non-MOOC and MOOC continuance intention in Taiwan: Effects of interactivity and openness" von Chen et al. (2018)
1. Analyse
Hauptthemen und -ziele der Forschung: Der Artikel untersucht die Determinanten der kontinuierlichen Nutzung von MOOCs im Vergleich zu traditionellen E-Learning-Plattformen (non-MOOCs) in Taiwan. Dabei wird besonders auf die Effekte von Interaktivität und Offenheit eingegangen. Ziel ist es, die Faktoren zu identifizieren, die die Nutzungsabsicht von MOOCs beeinflussen, und zu verstehen, wie sich diese Faktoren von denen der non-MOOCs unterscheiden.
Verwendete Methoden und Datenquellen:


Methodische Ansätze: Die Studie verwendet einen quantitativen Ansatz mit Online-Umfragen. Zwei Umfragen wurden an Universitätsstudenten in Taichung, Taiwan, durchgeführt, um die Effekte von Interaktivität und Offenheit zu untersuchen.


Werkzeuge und Datenquellen: Die Daten wurden durch zwei Online-Umfragen erhoben, die in den Jahren 2015 und 2016 an Universitätsstudenten verschickt wurden. Insgesamt wurden 995 und 854 gültige Antworten von Plattformnutzern gesammelt und zur Überprüfung des Modells verwendet.


Zentrale Forschungsergebnisse:


Einfluss der Interaktivität: Die Interaktivität, insbesondere die Mensch-Nachricht-Interaktion (HMI), hat den stärksten Einfluss auf die Zufriedenheit und damit auf die kontinuierliche Nutzung von MOOCs.


Einfluss der Offenheit: Die wahrgenommene Offenheit beeinflusst die Nutzungsabsicht, jedoch ist ihr Einfluss auf die Zufriedenheit relativ gering.


Ähnlichkeiten zwischen MOOCs und non-MOOCs: Die Effekte von Interaktivität und Motivation auf die Nutzungsabsicht waren sowohl bei MOOCs als auch bei non-MOOCs ähnlich.


2. Zusammenfassung
Kernpunkte des Artikels:


Problemstellung: Untersuchung der Determinanten der kontinuierlichen Nutzung von MOOCs und non-MOOCs, mit Fokus auf Interaktivität und Offenheit.


Methodik: Quantitative Analyse basierend auf Online-Umfragen unter Universitätsstudenten in Taiwan.


Hauptergebnisse: Starke Effekte von HMI auf die Zufriedenheit; Offenheit beeinflusst Nutzungsabsicht, aber nicht signifikant die Zufriedenheit.


Schlussfolgerungen: Die wahrgenommene Interaktivität und Offenheit sind entscheidend für die kontinuierliche Nutzung von MOOCs, jedoch hat Offenheit einen geringeren Einfluss auf die Zufriedenheit als erwartet.


3. Kernaussagen


Einfluss der HMI: „Among the three interaction factors, human-message interaction on the platform has the strongest effect on satisfaction.“ (S. 173)


Einfluss der Offenheit: „Perceived openness was found to influence usage intention but its effects were relatively low.“ (S. 173)


Kontinuierliche Nutzung: „The model can account for more than 75 percent of the variance in continuance intention.“ (S. 173)


4. Argumentationslinien


Wichtigkeit der Interaktivität: Der Artikel argumentiert, dass HMI der wichtigste Faktor für die Zufriedenheit und damit für die kontinuierliche Nutzung von MOOCs ist.


Rolle der Offenheit: Offenheit ist wichtig für die Nutzungsabsicht, beeinflusst jedoch die Zufriedenheit weniger stark, was auf kulturelle Unterschiede und die Wahrnehmung der Nutzer zurückzuführen sein könnte.


Vergleich von MOOCs und non-MOOCs: Es wird betont, dass die Determinanten der kontinuierlichen Nutzung zwischen MOOCs und non-MOOCs ähnlich sind, wobei jedoch spezifische Unterschiede in der Bedeutung von HHI und Offenheit bestehen.


5. Verschlagwortung


Lehr- und Lerneffektivität:


Begründung: Der Artikel untersucht, wie Interaktivität und Offenheit die Effektivität und Nutzungsabsicht von MOOCs beeinflussen.


Fundstelle: S. 173




Technologieintegration:


Begründung: Die Studie fokussiert sich auf die Integration von Interaktivitäts- und Offenheitsfunktionen in MOOCs.


Fundstelle: S. 173




6. Kategorisierung


Kategorie: Kerngedanke


Kriterium: Der Artikel bietet zentrale Ideen zur Verbesserung der kontinuierlichen Nutzung von MOOCs durch die Untersuchung von Interaktivität und Offenheit.


Beispiel: Diskussion der Effekte von HMI und Offenheit auf die Nutzungsabsicht und Zufriedenheit. (S. 173)




7. Zuordnung zu Forschungsfragen


FU3: Wie sind Konzeption und relevante didaktische und bildungstechnologische Merkmale des systemisch-konstruktivistischen Learning-Management-Systems für Akteure im digitalen Bildungsraum von Gesundheitsberufen dargestellt?


Begründung: Der Artikel untersucht die Merkmale von MOOCs und deren Einfluss auf die kontinuierliche Nutzung, was auf die Konzeption und Merkmale eines systemisch-konstruktivistischen LMS übertragen werden kann.


Fundstelle: S. 173




Gesamtbewertung: 5/5
Diese Analyse zeigt die hohe Relevanz des Artikels für die Untersuchung der Determinanten der kontinuierlichen Nutzung von MOOCs und non-MOOCs. Die Forschung bietet wertvolle Einblicke in die Bedeutung von Interaktivität und Offenheit für die Nutzungsabsicht und Zufriedenheit und liefert konkrete Empfehlungen für die Gestaltung effektiver Online-Lernumgebungen.
},
	file = {Chen et al. - 2018 - Comparing the determinants of non-MOOC and MOOC co.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/R5J95A6N/Chen et al. - 2018 - Comparing the determinants of non-MOOC and MOOC co.pdf:application/pdf},
}

