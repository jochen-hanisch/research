	booktitle = {Künstliche {Intelligenz} in der {Hochschulbildung}. {Chancen} und {Grenzen} des {KI}-gestützten {Lernens} und {Lehrens}},
	author = {Gottburgsen, Anja and Hofmann, Yvette E and Willige, Janka},
	editor = {Schmohl, Tobias, Tobias and Watanabe, Alice and Schelling, Kathrin},
	year = {2023},
	keywords = {Promotion:Literaturanalyse, \#9:Buchteil:digital:lernen, Forschungsansätze, Technologieintegration, Promotion:Argumentation, Krisenreaktion im Bildungsbereich, Promotion:FU3, Promotion:S:09 Digital Lernen, Promotion:Literaturverzeichnis},
