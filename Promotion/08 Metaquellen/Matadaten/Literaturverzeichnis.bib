@article{ballaram_scoping_2024,
	title = {A scoping review of continuing education models and statutory requirements for pharmacists globally},
	volume = {24},
	issn = {1472-6920},
	url = {https://bmcmededuc.biomedcentral.com/articles/10.1186/s12909-024-05322-4},
	doi = {10.1186/s12909-024-05322-4},
	abstract = {Background  In the dynamic field of pharmacy amongst a diverse array of countries with disparate income levels, pharmacists play a pivotal role in integrating emerging scientific knowledge into their practice while adapting to evolving therapeutic interventions and expanding service delivery responsibilities. Lifelong Learning (LLL) is cultivated through continuing professional education (CPE) and continuing professional development (CPD), indispensable components ensuring sustained professional competence and heightened patient care quality. The global landscape witnesses diverse LLL activities tailored to pharmacists’ learning needs and preferences. This scoping review maps and synthesises a comprehensive global perspective on the existing knowledge regarding CPE/CPD models, statutory requirements, and pharmacists’ preferences for LLL activities.
Objective  To comprehensively investigate global models of CPE/CPD for pharmacists’ and examine the statutory requirements governing pharmacists’ registration and licensure.
Method  A literature search of PubMed, Google Scholar, Web of Science, and the University of KwaZulu-Natal library search engine was undertaken for studies between January 2012 and February 2023. The article selection and reporting followed the recommendations made by PRISMA (Preferred Reporting Items of Systematic Reviews and Meta-Analyses) guidelines. The articles were tabulated based on their respective country’s income level, continuing education models employed, country-specific statutory requirements, and pharmacists’ preferences for LLL activities.
Results  Of the initial 3974 publications identified through the database search, 24 studies met the review criteria. The majority of the articles originated from high-income countries (HICs) (14/24, 58.3\%), and most employed the mandatory CPD points system (21/24, 87.5\%). However, in some HICs and upper-middle income countries (UMICs), the CPE/CPD is non-mandatory. While most countries (19/24, 79.2\%) offer various LLL formats, the preference of pharmacists remains primarily face-to-face learning (13/24, 54.2\%). However, workplace learning (3/24, 12.5\%) and blended learning (7/24, 29.1\%) are mentioned in some studies.
Conclusion  Diverse models of CPE/CPD alongside statutory requirements persist globally and evolve, shaped by varied implementation experiences. HICs lead in CPD models, while the implementation in low- and middle-income countries (LMICs) and low-income countries (LICs) requires further exploration for inclusivity and effectiveness. A few},
	language = {en-GB},
	number = {1},
	urldate = {2024-04-02},
	journal = {BMC Medical Education},
	author = {Ballaram, Sholene and Perumal-Pillay, Velisha and Suleman, Fatima},
	month = mar,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Promotion:Relevanz:5, Technologieintegration, Systemanpassung, Promotion:Argumentation, Promotion:FU5, \#8:Zeitschriftenartikel:blended:learning, Promotion:S:08 Blended Learning, Promotion:Literaturverzeichnis},
	pages = {343},
	annote = {Analyse der Studie "A scoping review of continuing education models and statutory requirements for pharmacists globally" von Ballaram et al. (2024)
1. Hauptthemen und Ziele der Forschung
Ballaram et al. (2024) untersuchen in dieser Studie die verschiedenen Modelle der Fort- und Weiterbildung (Continuing Professional Education, CPE; und Continuing Professional Development, CPD) für Apotheker weltweit. Ziel ist es, einen umfassenden Überblick über die aktuellen Modelle und gesetzlichen Anforderungen zu geben und die Vorlieben von Apothekern für lebenslanges Lernen (LLL) zu ermitteln, um internationale Best Practices zu identifizieren und mögliche Lücken in der Implementierung zu schließen​.
2. Methoden und Datenquellen


Studiendesign: Die Studie nutzt einen Scoping-Review-Ansatz basierend auf der Methodik des Joanna Briggs Institute und dem Arksey und O'Malley Framework. Es wurde eine systematische Literaturrecherche in Datenbanken wie PubMed, Google Scholar und Web of Science durchgeführt. Die ausgewählten Studien wurden nach Einkommensniveau der Länder, angewendeten Modellen der Weiterbildung, gesetzlichen Anforderungen und den Präferenzen der Apotheker für LLL-Aktivitäten kategorisiert.


Datenquellen: Die Suche erstreckte sich über Veröffentlichungen zwischen Januar 2012 und Februar 2023 und berücksichtigte Studien, die sich auf CPE, CPD und LLL-Aktivitäten bezogen. Insgesamt wurden 24 Studien nach Anwendung der PRISMA-Richtlinien in die Analyse einbezogen​.


3. Zentrale Forschungsergebnisse


Regionale Unterschiede und Modelle: Die Mehrheit der Studien stammt aus Ländern mit hohem Einkommen (HICs) (58,3 \%). In diesen Ländern dominiert das CPD-Modell, während in Ländern mit mittlerem oder niedrigem Einkommen (LMICs und LICs) häufig CPE praktiziert wird oder sich die Länder im Übergang zum CPD-Modell befinden.


Präferenzen für Lernformate: Die Präferenzen der Apotheker variieren: 54,2 \% bevorzugen Präsenzveranstaltungen, während 29,1 \% eine Mischung aus Online- und Präsenzlernen (Blended Learning) bevorzugen. In LMICs sind Blended-Learning-Ansätze und Arbeitsplatzlernen beliebt, insbesondere aufgrund begrenzter Ressourcen und Infrastrukturschwächen.


Gesetzliche Anforderungen und CPD-Modelle: In den meisten analysierten Ländern sind CPD-Modelle gesetzlich vorgeschrieben, insbesondere in HICs. In einigen LMICs bleibt die Implementierung jedoch unvollständig, und CPE wird weiterhin verwendet oder ist sogar freiwillig. Beispielsweise sind in Ländern wie Kuwait, Malaysia und Pakistan keine verbindlichen CPD-Modelle etabliert​.


4. Zusammenfassung
Die Studie bietet einen umfassenden Überblick über die verschiedenen Ansätze zur beruflichen Weiterbildung für Apotheker weltweit und zeigt erhebliche Unterschiede in der Implementierung und Nutzung der Modelle zwischen Ländern unterschiedlicher Einkommensstufen auf. Sie verdeutlicht die Notwendigkeit einer Angleichung und Harmonisierung der CPD-Modelle, um eine konsistente Weiterbildung und Qualifizierung von Apothekern weltweit zu gewährleisten.
5. Kernaussagen


Unterschiede zwischen HICs und LMICs: In Ländern mit hohem Einkommen sind CPD-Modelle weit verbreitet und gesetzlich vorgeschrieben, während in Ländern mit niedrigem und mittlerem Einkommen oft noch CPE verwendet wird oder der Übergang zum CPD-Modell stockt (S. 7).


Präferenz für Präsenzlernen: Apotheker bevorzugen nach wie vor face-to-face-Aktivitäten, trotz der wachsenden Bedeutung digitaler Formate und Blended-Learning-Ansätze (S. 9).


Notwendigkeit einer globalen Harmonisierung: Es besteht ein Bedarf, die globalen Standards für die berufliche Weiterbildung von Apothekern zu vereinheitlichen, um die Qualität der Patientenversorgung zu verbessern und internationale Mobilität zu fördern (S. 10)​.


6. Argumentationslinien
Die Autoren argumentieren, dass die Einführung und Anwendung von CPD-Modellen für Apotheker weltweit nicht nur von gesetzlichen Rahmenbedingungen, sondern auch von kulturellen und ökonomischen Faktoren abhängt. Sie betonen, dass Unterschiede in Ressourcen und Infrastruktur die Umsetzung beeinflussen und dass daher maßgeschneiderte Strategien erforderlich sind, um die Weiterbildung in Ländern mit unterschiedlichen Einkommensniveaus effektiv zu gestalten​.
7. Verschlagwortung


Forschungsansätze: Die Studie untersucht global unterschiedliche CPD- und CPE-Modelle und analysiert ihre Implementierung und Effektivität.


Technologieintegration: Untersuchung der Integration digitaler Lernformate wie E-Learning und Blended Learning zur beruflichen Weiterbildung von Apothekern.


Systemanpassung: Analyse der Anpassung von CPD- und CPE-Modellen an die spezifischen Bedürfnisse von Apothekern in verschiedenen sozioökonomischen Kontexten.


8. Kategorisierung
Argumentation: Die Studie nutzt verschiedene Theorien und empirische Daten, um zu argumentieren, dass die Effektivität von CPD-Modellen von den sozioökonomischen Bedingungen und den regulatorischen Rahmenbedingungen abhängt. Sie zeigt auf, dass Länder mit hohem Einkommen durch gesetzliche Verpflichtungen und Ressourcen verstärkt auf CPD-Modelle setzen, während Länder mit mittlerem und niedrigem Einkommen andere oder angepasste Ansätze benötigen (S. 8)​.
9. Zuordnung zu der passendsten Forschungsunterfrage
FU5: Welche Möglichkeiten und Grenzen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems durch Akteure im digitalen Bildungsraum analysiert?


Begründung: Die Arbeit untersucht globale Unterschiede und Limitationen in der Implementierung von CPD-Modellen für Apotheker und verdeutlicht die Herausforderungen, denen Länder mit unterschiedlichen Ressourcen- und Infrastrukturkapazitäten gegenüberstehen.


10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie bietet detaillierte Erkenntnisse zu den Unterschieden in der Implementierung von CPD-Modellen weltweit und deren Auswirkungen).


Zitierhäufigkeit und Einfluss: 4 (Die Studie greift auf eine Vielzahl von Primärstudien zurück und ist methodisch fundiert, auch wenn ein Fokus auf HICs besteht).


Aktualität: 5 (Veröffentlichung im Jahr 2024, somit sehr aktuell und relevant).


Gesamtbewertung: 4.7
11. Schlussfolgerung
Ballaram et al. (2024) zeigen, dass die Implementierung und Anwendung von CPD-Modellen weltweit erheblich variiert und dass diese Unterschiede sowohl die Qualität der Weiterbildung als auch die internationale Mobilität von Apothekern beeinflussen. Es besteht ein dringender Bedarf an global abgestimmten Standards und Strategien, die den unterschiedlichen sozioökonomischen Bedingungen Rechnung tragen, um eine effektive Weiterbildung und qualifizierte Patientenversorgung sicherzustellen​.
},
	file = {Ballaram et al. - 2024 - A scoping review of continuing education models an.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/DJDBHXVQ/Ballaram et al. - 2024 - A scoping review of continuing education models an.pdf:application/pdf},
}

@article{dus-ilnicka_blended_2024,
	title = {Blended intensive programme’s implementation in dental education: post-pandemic evolution of learning},
	volume = {24},
	issn = {1472-6920},
	shorttitle = {Blended intensive programme’s implementation in dental education},
	url = {https://bmcmededuc.biomedcentral.com/articles/10.1186/s12909-024-05301-9},
	doi = {10.1186/s12909-024-05301-9},
	abstract = {Blended Intensive Programmes (BIP’s) represent a valuable tool for gathering knowledge and summarising the latest trends in medicine and dentistry. Blended education has been found, even before the COVID-19 pandemic, to increase the level of education and stimulate effective learning for postgraduate healthcare professionals. Interprofessional education is critical for preparing students to enter the health workforce, where teamwork and collaboration are important competencies. This article outlines the key points of the Blended Intensive Programme’s implementation in dental education organised by Wroclaw Medical University in Poland. BIP involved professors from 12 universities or research institutions from Europe and South America and 28 participants from 8 countries. The course was taught remotely and in person. In addition, it included a visit to the university and practical classes with artificial simulation and practice in dentistry. A structured questionnaire enabled measuring the evaluation of students’ perception of the COVID-19 education before and after the pandemic. The European Region Action Scheme for the Mobility of University Students (ERASMUS) was fundamental to carrying out the BIP with the participation of several countries, allowing the exchange of knowledge, assessing the impact of the pandemic on dental universities, and strengthening international collaborations and the future project of research, education and clinical assistance. We conclude that hybrid teaching programmes broaden the learning spectrum in dental studies by allowing transnational and interdisciplinary approaches that make students aware of the importance of their work within the framework of the general health approach, as this differs from country to country.},
	language = {en-GB},
	number = {1},
	urldate = {2024-04-02},
	journal = {BMC Medical Education},
	author = {Duś-Ilnicka, Irena and Paradowska-Stolarz, Anna and Mazur, Marta and Radwan-Oczko, Małgorzata and Perra, Andrea and Paula, Vanessa Salete De and Ward, Laura Sterian and Valente, Nicola Alberto and Firkova, Elena and Karteva, Teodora and Jorda, Lucia Miralles and Sousa Gomes, Pedro De and Dominiak, Marzena},
	month = mar,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Technologieintegration, Systemanpassung, Promotion:FU7, Promotion:Schlussfolgerung, \#8:Zeitschriftenartikel:blended:learning, Promotion:S:08 Blended Learning, Promotion:Literaturverzeichnis},
	pages = {352},
	annote = {Analyse der Studie "Blended intensive programme’s implementation in dental education: post-pandemic evolution of learning" von Duś-Ilnicka et al. (2024)
1. Hauptthemen und Ziele der Forschung
Duś-Ilnicka et al. (2024) untersuchen die Implementierung eines Blended Intensive Programme (BIP) im Bereich der zahnmedizinischen Ausbildung, das speziell entwickelt wurde, um den Herausforderungen der COVID-19-Pandemie gerecht zu werden. Ziel des Programms ist es, die interdisziplinäre und transnationale Zusammenarbeit im zahnmedizinischen Bereich zu fördern und gleichzeitig moderne digitale Lernmethoden wie Teledentistry und Künstliche Intelligenz (KI) in die Lehre zu integrieren, um die praktischen und theoretischen Kompetenzen der Teilnehmenden zu erweitern​.
2. Methoden und Datenquellen


Studiendesign: Das BIP wurde als hybrides Format mit sowohl virtuellen als auch Präsenzkomponenten konzipiert. Es umfasste synchrones und asynchrones Lernen, das über die Plattform Microsoft Teams durchgeführt wurde. Die Präsenzveranstaltungen fanden an der Wroclaw Medical University statt und beinhalteten praktische Schulungen und interaktive Seminare.


Datenquellen: Die Studie basiert auf Umfrageergebnissen, die die Wahrnehmung der Teilnehmer vor und nach der Pandemie evaluieren. Zusätzlich wurden strukturierte Fragebögen und Feedback-Mechanismen eingesetzt, um die Effektivität des Programms zu bewerten und die Auswirkungen der Pandemie auf die zahnmedizinische Ausbildung zu analysieren​.


3. Zentrale Forschungsergebnisse


Anpassung und Entwicklung während der Pandemie: Das BIP bot eine Lösung für die durch die Pandemie verursachten Einschränkungen in der zahnmedizinischen Ausbildung, indem es Online- und Präsenzformate kombinierte. Dies ermöglichte es, wichtige praktische Inhalte weiterhin zu vermitteln, während gleichzeitig neue digitale Technologien wie KI und Teledentistry eingeführt wurden​.


Stärkung der internationalen Zusammenarbeit: Das Programm förderte den Austausch zwischen Universitäten in Europa und Südamerika, was zu einer Vertiefung der internationalen Netzwerke und zur Entwicklung gemeinsamer Lehrstrategien führte. Die transnationale Dimension des Programms betonte die Relevanz der Interprofessionalität im Gesundheitswesen​.


Positive Teilnehmerresonanz: Die Mehrheit der Teilnehmenden bewertete das BIP positiv, insbesondere im Hinblick auf die Kombination von Theorie und Praxis sowie die Nutzung neuer Technologien. Die Erfahrungen im hybriden Format wurden als bereichernd und zukunftsweisend wahrgenommen.


4. Zusammenfassung
Die Studie beschreibt die Implementierung und Evaluation eines Blended Intensive Programme zur zahnmedizinischen Ausbildung. Es zeigt, dass hybride Lernformate nicht nur die Flexibilität und Adaptivität in der Lehre erhöhen, sondern auch die Qualität der Ausbildung verbessern können, indem sie internationale und interdisziplinäre Ansätze integrieren.
5. Kernaussagen


Flexibilität durch hybride Formate: Das BIP ermöglichte die Fortsetzung und Weiterentwicklung der zahnmedizinischen Ausbildung während der Pandemie durch die Kombination von Online- und Präsenzformaten (S. 3).


Interdisziplinäre Zusammenarbeit: Der internationale Austausch und die Einbeziehung verschiedener Fachrichtungen trugen zur Erweiterung der Lerninhalte und zur Erhöhung der Relevanz für die Praxis bei (S. 6)​.


Nutzung neuer Technologien: Die Einführung von KI und Teledentistry innerhalb des Programms zeigte, wie innovative Technologien effektiv in die Lehre integriert werden können (S. 7)​.


6. Argumentationslinien
Die Autoren argumentieren, dass hybride Lehrformate eine effektive Möglichkeit darstellen, um die Herausforderungen, die durch die Pandemie entstanden sind, zu bewältigen. Sie betonen, dass die Integration digitaler Technologien und die Förderung internationaler Netzwerke entscheidend sind, um eine qualitativ hochwertige zahnmedizinische Ausbildung sicherzustellen und weiterzuentwickeln​.
7. Verschlagwortung


Technologieintegration: Die Studie beschreibt die Integration digitaler Tools wie KI und Teledentistry in die zahnmedizinische Ausbildung.


Lehr- und Lerneffektivität: Analyse der Effektivität hybrider Lehrformate zur Bewältigung pandemiebedingter Herausforderungen und zur Steigerung der Ausbildungsqualität.


Systemanpassung: Untersuchung der Anpassung und Weiterentwicklung von Lehrformaten zur Sicherstellung einer kontinuierlichen Ausbildung im Gesundheitsbereich während der Pandemie.


8. Kategorisierung
Schlussfolgerung:


Kriterium: Die Studie zieht abschließende Bewertungen aus den Analyseergebnissen des Blended Intensive Programme (BIP) und reflektiert die Wirksamkeit hybrider Lehrformate im zahnmedizinischen Bildungsbereich während der Pandemie. Es wird aufgezeigt, wie diese Formate zur Aufrechterhaltung und Verbesserung der Ausbildung trotz externer Krisen beitragen können.


Beispiel: Die Studie kommt zu dem Schluss, dass das BIP durch die Kombination von Online- und Präsenzformaten die Qualität der Ausbildung während der COVID-19-Pandemie sichern konnte und dass die Integration internationaler und interdisziplinärer Ansätze wesentlich zur erfolgreichen Umsetzung beigetragen hat (S. 5)​.


9. Zuordnung zu der passendsten Forschungsunterfrage
FU7: Welche Inputs und Strategien werden als Erweiterung von Kausalgesetzen bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems durch Akteure im digitalen Bildungsraum abgeleitet?


Begründung: Die Arbeit untersucht, wie hybride Formate und digitale Technologien in der Lehre eingesetzt werden, um die Ausbildung in Krisensituationen (wie der Pandemie) anzupassen und zu optimieren.


10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie bietet detaillierte Einblicke in die Anpassung und Integration digitaler Technologien in die Ausbildung während der Pandemie).


Zitierhäufigkeit und Einfluss: 4 (Die Arbeit ist methodisch fundiert und analysiert internationale Ansätze und Kollaborationen).


Aktualität: 5 (Veröffentlichung im Jahr 2024, sehr aktuell und relevant im Kontext der Digitalisierung im Bildungswesen).


Gesamtbewertung: 4.7
11. Schlussfolgerung
Duś-Ilnicka et al. (2024) zeigen, dass hybride Lernprogramme, wie das Blended Intensive Programme, eine effektive Methode darstellen, um die zahnmedizinische Ausbildung während pandemiebedingter Einschränkungen fortzusetzen und weiterzuentwickeln. Die Integration digitaler Technologien und die Förderung internationaler Zusammenarbeit tragen maßgeblich zur Flexibilität und Qualität der Ausbildung bei und ermöglichen eine zukunftsorientierte Weiterentwicklung des Bildungssektors im Gesundheitswesen​.
},
	file = {Duś-Ilnicka et al. - 2024 - Blended intensive programme’s implementation in de.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/TUIITDLU/Duś-Ilnicka et al. - 2024 - Blended intensive programme’s implementation in de.pdf:application/pdf},
}

@article{pawellek_digitale_2024,
	title = {Digitale {Patient}:innenschulung: {Konzeption} eines {Erhebungsinstruments} für {Kompetenzen} von {Therapeut}:innen zur {Planung} und {Umsetzung} digitaler {Adipositastherapie}},
	volume = {57},
	copyright = {https://creativecommons.org/licenses/by/4.0},
	issn = {1424-3636},
	shorttitle = {Digitale {Patient}},
	url = {https://www.medienpaed.com/article/view/1700},
	doi = {10.21240/mpaed/57/2024.03.22.X},
	abstract = {Obesity is recognized to be a significant public health issue, necessitating targeted therapeutic approaches to reduce the mighty prevalence. The digitalization of patient education offers potential to enhance effectiveness, but requires new competencies from therapy providers. Educational science presents digital competence frameworks for designing training and enhancing educational outcomes. However, there is a lack of competence models or corresponding assessment tools for obesity therapy. Therefore, the objective is to determine competence structures for the planning and implementation of digital therapy. The development of the questionnaire involved a literature review to identify applicable competence conceptualizations. Content analysis was employed to extract dimensions and items. To validate the questionnaire, experts were interviewed. Based on literature, the questionnaire contains three subjects: therapy-appropriate competences, competence moderators, and demographic information, which comprise 16 dimensions (e.g., media adaptation, digital learning monitoring) in 46 items. Expert feedback (n = 11) resulted in 40 revisions on language and content. The average completion time was 8.8 minutes. For the first time, competence structures for the planning and implementation of digital obesity therapy were identified based on literature and expert interviews. Following the statistical validation, the influence of competences on therapy effectiveness can be investigated and conclusions can be drawn for training.},
	language = {de-DE},
	urldate = {2024-03-31},
	journal = {MedienPädagogik: Zeitschrift für Theorie und Praxis der Medienbildung},
	author = {Pawellek, Sabine and Wulff, Hagen},
	month = mar,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Bewertungsmethoden, Systemanpassung, Promotion:Argumentation, \#0:Zeitschriftenartikel:digital:learning, Promotion:S:12 Digital Learning, Promotion:Literaturverzeichnis},
	pages = {1--21},
	file = {Pawellek und Wulff - 2024 - Digitale Patientinnenschulung Konzeption eines E.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/2RA2ACQ7/Pawellek und Wulff - 2024 - Digitale Patientinnenschulung Konzeption eines E.pdf:application/pdf},
