@article{shawket_urban_2024,
	title = {Urban perception: impact of community-based learning},
	abstract = {This paper delves into the merits of integrating community-based learning into urban design and planning studios, emphasizing the essential connection between academic learning and practical experiences within local communities. It promotes collaborative efforts among students, staff, and community members to address specific local challenges effectively. By actively engaging with these communities, participants gain profound insights into the social, cultural, economic, and environmental factors shaping them, enabling them to apply their disciplinary knowledge aptly to address community issues. Extended on-site durations further amplify the benefits, offering a deeper understanding of community needs, values, and perspectives. This fosters enduring collaborations and promotes social, economic, and environmental sustainability. Experiential learning activities during the experimental week, such as service-learning projects and community-based research, enhance critical thinking, problem-solving, and communication skills, while heightening awareness of social and cultural dynamics within the community. In conclusion, community-based learning proves invaluable in urban design and planning studios, fostering sustained collaboration and promoting holistic sustainability.},
	language = {en-GB},
	author = {Shawket, Indjy M},
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Kollaboratives Lernen, Lehr- und Lerneffektivität, Technologieintegration, Promotion:FU2a, Promotion:Argumentation, Promotion:Relevanz:4, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	file = {Shawket - 2024 - URBAN PERCEPTION IMPACT OF COMMUNITY-BASED LEARNI.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/QV4L2DRW/Shawket - 2024 - URBAN PERCEPTION IMPACT OF COMMUNITY-BASED LEARNI.pdf:application/pdf},
}

@article{maloney_health_2013,
	title = {Health {Professional} {Learner} {Attitudes} and {Use} of {Digital} {Learning} {Resources}},
	volume = {15},
	issn = {1438-8871},
	url = {http://www.jmir.org/2013/1/e7/},
	doi = {10.2196/jmir.2094},
	abstract = {Background: Web-based digital repositories allow educational resources to be accessed efficiently and conveniently from diverse geographic locations, hold a variety of resource formats, enable interactive learning, and facilitate targeted access for the user. Unlike some other learning management systems (LMS), resources can be retrieved through search engines and meta-tagged labels, and content can be streamed, which is particularly useful for multimedia resources.
Objective: The aim of this study was to examine usage and user experiences of an online learning repository (Physeek) in a population of physiotherapy students. The secondary aim of this project was to examine how students prefer to access resources and which resources they find most helpful.
Methods: The following data were examined using an audit of the repository server: (1) number of online resources accessed per day in 2010, (2) number of each type of resource accessed, (3) number of resources accessed during business hours (9 am to 5 pm) and outside business hours (years 1-4), (4) session length of each log-on (years 1-4), and (5) video quality (bit rate) of each video accessed. An online questionnaire and 3 focus groups assessed student feedback and self-reported experiences of Physeek.
Results: Students preferred the support provided by Physeek to other sources of educational material primarily because of its efficiency. Peak usage commonly occurred at times of increased academic need (ie, examination times). Students perceived online repositories as a potential tool to support lifelong learning and health care delivery.
Conclusions: The results of this study indicate that today’s health professional students welcome the benefits of online learning resources because of their convenience and usability. This represents a transition away from traditional learning styles and toward technological learning support and may indicate a growing link between social immersions in Internet-based connections and learning styles. The true potential for Web-based resources to support student learning is as yet unknown.},
	language = {en-GB},
	number = {1},
	urldate = {2024-05-14},
	journal = {Journal of Medical Internet Research},
	author = {Maloney, Stephen and Chamberlain, Michael and Morrison, Shane and Kotsanas, George and Keating, Jennifer L and Ilic, Dragan},
	month = jan,
	year = {2013},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Systemanpassung, \#1:Zeitschriftenartikel:learning:management:system, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {e7},
	annote = {1. Analyse
Hauptthemen und -ziele der Forschung: Die Studie von Maloney et al. untersucht die Einstellungen und die Nutzung digitaler Lernressourcen durch Gesundheitsberufsstudierende, insbesondere in Bezug auf das Lernmanagementsystem (LMS) Physeek. Ziel ist es, die Wirksamkeit dieser Ressourcen in der Unterstützung des klinischen Lernens und der Entwicklung von Praxisfähigkeiten zu bewerten.
Verwendete Methoden und Datenquellen: Die Forschung nutzte eine Kombination aus quantitativen und qualitativen Methoden, darunter eine Nutzungsaudit von Physeek, eine Umfrage und Fokusgruppen. Die Audit-Daten lieferten Einblicke in die Zugriffszeiten, bevorzugte Ressourcentypen und Nutzungsmuster in Bezug auf Tageszeit und Videoqualität.
Zentrale Forschungsergebnisse: Es zeigte sich, dass die Studierenden digitale Lernressourcen vor allem wegen ihrer Effizienz und Verfügbarkeit schätzten. Die Nutzung der Ressourcen war besonders während der Prüfungszeiten und vor klinischen Einsätzen hoch. Die Studierenden nutzten Physeek aktiv zur Überprüfung praktischer Fähigkeiten, und die Zugänglichkeit von qualitativ hochwertigen Videos spielte eine wichtige Rolle bei ihrer Lernrevision.
2. Zusammenfassung
Maloney et al. heben die positive Aufnahme und effektive Nutzung von Physeek hervor, einem digitalen Lernmanagementsystem, das Studierenden in Gesundheitsberufen hilft, klinische Fähigkeiten zu entwickeln und theoretisches Wissen praktisch anzuwenden. Die Studie betont die Notwendigkeit von Ressourcen, die leicht zugänglich sind und die Anforderungen des klinischen Lernens erfüllen.
3. Kernaussagen


"Studierende bevorzugen digitale Lernressourcen wegen ihrer sofortigen Verfügbarkeit und Effizienz." (S. 3)


"Die Nutzung von Physeek spitzt sich während der Prüfungszeiten zu, was den Bedarf an unterstützenden Lernressourcen in stressigen akademischen Perioden unterstreicht." (S. 4)


"Hochwertige Lehrvideos sind besonders beliebt, da sie es den Studierenden ermöglichen, komplexe praktische Fähigkeiten effektiv zu überprüfen." (S. 5)


4. Argumentationslinien
Die Studie zeigt, dass der Zugang zu qualitativ hochwertigen und gut organisierten digitalen Ressourcen das Lernen verbessern kann, indem er zeitnahe und relevante Unterstützung bietet. Diese Ressourcen werden besonders in zeitsensiblen Perioden wie vor Prüfungen oder klinischen Einsätzen geschätzt.
5. Verschlagwortung


Lehr- und Lerneffektivität: Die Studie unterstreicht, wie digitale Lernressourcen die Effizienz des Lernens steigern können.


Technologieintegration: Die Integration von Physeek in den Lehrplan zeigt, wie Technologie erfolgreich zur Unterstützung der Ausbildung in Gesundheitsberufen eingesetzt werden kann.


Kollaboratives Lernen: Obwohl nicht direkt thematisiert, fördert die Plattform durch ihre Struktur potenziell kollaboratives Lernen unter Studierenden.


Forschungsansätze: Die kombinierte Anwendung von Nutzungsaudits, Umfragen und Fokusgruppen bietet einen umfassenden Ansatz zur Bewertung der Effektivität von Lernressourcen.


Systemanpassung: Die Anpassung des Bildungssystems an die Nutzung digitaler Ressourcen, wie durch die Implementierung von Physeek demonstriert, zeigt die Notwendigkeit, Lehrmethoden kontinuierlich zu modernisieren.


},
	file = {Maloney et al. - 2013 - Health Professional Learner Attitudes and Use of D.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/XBK25EFS/Maloney et al. - 2013 - Health Professional Learner Attitudes and Use of D.pdf:application/pdf},
}

@article{alt_health_2021,
	title = {Health management students’ self-regulation and digital concept mapping in online learning environments},
	volume = {21},
	issn = {1472-6920},
	url = {https://bmcmededuc.biomedcentral.com/articles/10.1186/s12909-021-02542-w},
	doi = {10.1186/s12909-021-02542-w},
	abstract = {Background: Self-regulation of learning is considered one of the key capabilities deemed essential for the healthcare system and its workers to cope successfully with the current challenges they are facing. Therefore, healthcare curricula are increasingly called upon to support self-regulation as a central learning outcome. With scant relevant publications describing how students of medicine and other healthcare professions regulate their learning, this study set out to design and assess a problem-based learning using digital concept mapping in an online course and to evaluate the set of connections between this intervention and Health Management students’ self-regulation of learning.
Method: Students of a Management of Health Service Organizations program (100) were presented with an illstructured problem, relevant to their course content (accreditation process within hospitals) and were asked to argue for or against the implementation of the accreditation process. The participants were asked to detail five arguments to establish their decision by using Mindomo, a popular digital platform for designing concept maps. The students were given predefined criteria that allowed them to self-assess their maps. Data for the analysis were gathered by two measurements: Concept mapping for problem-based learning scale and the Online self-regulated learning scale and were analyzed by using Partial Least Squares - Structural Equation Modeling.
Results: The analyses showed that at the beginning of the process, students’ online self-regulation was found lower than at the end of the intervention, and only two self-regulation sub-factors: Goal setting and Task strategies, were positively linked to students’ perceptions of the intervention. After the intervention, the analyses showed that it increased the levels of four Online self-regulation sub-factors: Goal setting, Task strategies, Environment structuring, and Time management.
Conclusions: Teachers need to recognize and account for different types of learners and encourage and scaffold students’ effective use of self-regulation strategies. Low self-regulated learners might fail to see the advantages of concept mapping in problem-solving activities. Combining these teaching and learning tools together with the use of advanced technology in an online course that encourages active learning enables the development and acquisition of abilities of self-directed learning among students in the medical and health management professions.},
	language = {en-GB},
	number = {1},
	urldate = {2024-05-14},
	journal = {BMC Medical Education},
	author = {Alt, Dorit and Naamati-Schneider, Lior},
	month = dec,
	year = {2021},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Systemanpassung, Bildungstheorien, \#1:Zeitschriftenartikel:learning:management:system, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {110},
	annote = {1. Analyse
Hauptthemen und -ziele der Forschung: Die Studie von Alt und Naamati-Schneider untersucht die Selbstregulation und digitales Concept Mapping bei Gesundheitsmanagementstudenten in Online-Lernumgebungen. Ziel ist es, die Fähigkeiten zur Selbstregulation zu verbessern, die als entscheidend für die Anpassungsfähigkeit im Gesundheitswesen betrachtet werden.
Verwendete Methoden und Datenquellen: Es wurde eine problemorientierte Lernmethode mit digitaler Concept-Map-Erstellung in einem Online-Kurs verwendet. Die Studenten setzten Mindomo ein, eine Plattform für digitale Concept Maps, und ihre Fortschritte wurden anhand spezifischer Selbstbewertungskriterien gemessen. Die Datenanalyse erfolgte mittels Structural Equation Modeling.
Zentrale Forschungsergebnisse: Die Studie ergab, dass die Intervention die Selbstregulationsfähigkeiten der Studenten verbesserte, insbesondere in den Bereichen Zielsetzung und Strategieentwicklung. Das Concept Mapping förderte die aktive und selbstgesteuerte Lernbeteiligung.
2. Zusammenfassung
Alt und Naamati-Schneider demonstrieren, wie digitales Concept Mapping in Online-Lernumgebungen effektiv zur Förderung der Selbstregulation unter Gesundheitsmanagementstudenten eingesetzt werden kann. Die Studie zeigt, dass durch die gezielte Nutzung von Concept Maps in einem problemorientierten Lernansatz nicht nur die Selbstregulation, sondern auch die kritischen Denkfähigkeiten und die autonome Lernkompetenz der Studierenden gestärkt werden.
3. Kernaussagen


"Selbstregulation des Lernens ist ein Schlüsselmerkmal für Gesundheitsfachkräfte, um mit aktuellen Herausforderungen erfolgreich umzugehen." (S. 2)


"Digitales Concept Mapping fördert das tiefere Verständnis und die aktive Beteiligung der Studenten im Lernprozess." (S. 5)


"Die Verbesserung der Selbstregulationsfähigkeiten wurde insbesondere in den Bereichen Zielsetzung und Strategieentwicklung festgestellt." (S. 7)


4. Argumentationslinien
Die Studie argumentiert, dass eine effektive Selbstregulation eine wesentliche Fähigkeit für angehende Gesundheitsmanager ist, um dynamisch auf Veränderungen reagieren zu können. Das digitale Concept Mapping wird als nützliches Werkzeug hervorgehoben, das Studenten dabei unterstützt, ihre Lernprozesse selbst zu steuern und kritisch über den Lernstoff nachzudenken.
5. Verschlagwortung


Bildungstheorien: Die Verwendung von problemorientiertem Lernen und Concept Mapping stützt sich auf konstruktivistische Lerntheorien.


Lehr- und Lerneffektivität: Die Studie zeigt, dass durch die Kombination von Selbstregulation und digitalen Tools die Lerneffektivität gesteigert werden kann.


Technologieintegration: Die Integration von digitalen Concept Maps in den Lernprozess illustriert die effektive Nutzung von Technologie zur Unterstützung des Lernens.


Systemanpassung: Die Anpassung des Lehrplans zur Förderung der Selbstregulation zeigt die Notwendigkeit, Bildungssysteme an die Anforderungen der digitalen Ära anzupassen.


Forschungsansätze: Die methodologische Herangehensweise der Autoren bietet eine neue Perspektive auf die Nutzung von Concept Mapping in der Gesundheitsbildung.


},
	file = {Alt und Naamati-Schneider - 2021 - Health management students’ self-regulation and di.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/HPANKCYT/Alt und Naamati-Schneider - 2021 - Health management students’ self-regulation and di.pdf:application/pdf},
}

@article{alon_working_2023,
	title = {Working towards a ready to implement digital literacy program},
	volume = {9},
	issn = {2306-9740},
	doi = {10.21037/mhealth-23-13},
	abstract = {BACKGROUND: As healthcare continues to expand online and digital care offerings multiply, the importance of digital inclusion and equity is now better recognized. Yet despite impressive regional grassroots efforts, today there remain few readily deployable programs designed to support patient digital literacy.
METHODS: Digital Outreach for Obtaining Resources and Skills (DOORs) is one such digital literacy program that has evolved over the last 5 years to meet the rising demand. Through community partnerships, the DOORs curriculum and delivery has been updated to make the program more accessible and applicable as Coronavirus Disease 2019 (COVID-19) changes healthcare. Participants' experience in the most updated iteration of DOORS was assessed through surveys and semi-structured interviews.
RESULTS: Improvements to DOORs include an updated DOORs curriculum, updated facilitator manual, an online platform with a learning management system, standardized training, patient-facing educational handouts, consolidation of all DOORs materials into a single package that is ready to be shared with other groups, implementation of a single-session intervention model, and Spanish translation. Participants reported improved confidence on 72\% of the digital skills assessed. Thematic analysis resulted in three themes: awareness of divide, patient-centered design, and expanded skills and confidence.
CONCLUSIONS: Combined, these changes and participant outcomes better position DOORS to meet the rising need for digital literacy and offers a scalable model for teams across the world.},
	language = {en-GB},
	journal = {mHealth},
	author = {Alon, Noy and Perret, Sarah and Torous, John},
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, \#1:Zeitschriftenartikel:learning:management:system, Krisenreaktion im Bildungsbereich, literacy, smartphone, Digital literacy, mobile, equity, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {32},
	annote = {1. Analyse
Hauptthemen und -ziele der Forschung: Alon et al. entwickeln und implementieren ein digitales Alphabetisierungsprogramm namens Digital Outreach for Obtaining Resources and Skills (DOORs). Ziel ist es, digitale Fähigkeiten bei Menschen mit schweren psychischen Erkrankungen zu verbessern, indem grundlegende Smartphone-Funktionen gelehrt werden, die den Teilnehmern helfen, ihr tägliches Leben zu organisieren und Zugang zu Gesundheitsdiensten zu erhalten.
Verwendete Methoden und Datenquellen: Die Studie nutzte Methoden wie Umfragen und semi-strukturierte Interviews zur Bewertung der Teilnehmererfahrung. Es wurden acht Sitzungen durchgeführt, in denen die Teilnehmer durch das Programm geführt wurden. Die Messung der digitalen Fähigkeiten erfolgte über spezifisch für jede Sitzung entwickelte Umfragen.
Zentrale Forschungsergebnisse: Teilnehmer berichteten von einer signifikanten Verbesserung ihres Vertrauens in 72\% der bewerteten digitalen Fähigkeiten. Die Ergebnisse zeigen, dass DOORs effektiv die digitalen Kompetenzen verbessert und den Teilnehmern hilft, ihre Smartphones für gesundheitliche und alltägliche Aufgaben effektiver zu nutzen.
2. Zusammenfassung
Die Forschung von Alon et al. zeigt, dass das DOORs-Programm erfolgreich digitale Fähigkeiten bei Personen mit schweren psychischen Erkrankungen verbessert. Durch Anpassungen und Übersetzungen des Programms konnten mehr Menschen erreicht werden. Die Kombination von Theorie und Praxis sowie die Integration von Feedback der Teilnehmer trugen wesentlich zum Erfolg des Programms bei.
3. Kernaussagen


"Teilnehmer zeigten eine signifikante Verbesserung in ihrer Fähigkeit, digitale Ressourcen nach der Teilnahme am DOORs-Programm zu nutzen." (S. 5)


"Die Anpassung des Curriculums und die Übersetzung in andere Sprachen haben die Zugänglichkeit des Programms erhöht und es verschiedenen Gemeinschaften näher gebracht." (S. 6)


"Die Einführung einer Online-Plattform hat die Skalierbarkeit und Reichweite des Programms erweitert, was es ermöglicht, eine größere Anzahl von Teilnehmern zu schulen." (S. 7)


4. Argumentationslinien
Die Studie argumentiert, dass die Verbesserung der digitalen Fähigkeiten eine wesentliche Voraussetzung für die soziale Inklusion und den Zugang zu Gesundheitsdiensten ist. Durch das DOORs-Programm wurden nicht nur die digitalen Kompetenzen der Teilnehmer gestärkt, sondern auch deren Vertrauen in die Nutzung digitaler Technologien erhöht, was zu einer besseren Selbstständigkeit und verbesserten Zugang zu gesundheitlichen Ressourcen führt.
5. Verschlagwortung


Technologieintegration: Das Programm zeigt, wie digitale Bildung durch die Integration moderner Technologien wie Online-Plattformen und Smartphone-Anwendungen verbessert werden kann.


Lehr- und Lerneffektivität: DOORs hat effektiv die Fähigkeiten und das Selbstvertrauen der Teilnehmer verbessert, was die Effektivität des Lehransatzes unterstreicht.


Systemanpassung: Die Anpassungsfähigkeit des Programms an die Bedürfnisse verschiedener Gemeinschaften und die Übersetzung in andere Sprachen zeigen die Flexibilität und Relevanz des Systems.


Krisenreaktion im Bildungsbereich: Die schnelle Anpassung des Programms an die digitale Lernumgebung während der COVID-19-Pandemie demonstriert, wie Bildungssysteme auf Krisen reagieren können.


Forschungsansätze: Die methodische Herangehensweise, die die Integration von Umfragen und Interviews umfasst, bietet wichtige Einblicke in die Wirksamkeit digitaler Bildungsprogramme.


},
	file = {Alon et al. - 2023 - Working towards a ready to implement digital liter.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/RX7SMQ3D/Alon et al. - 2023 - Working towards a ready to implement digital liter.pdf:application/pdf},
}

@article{schick_training_2024,
	title = {Training in medical communication competence through video-based e-learning: {How} effective are video modeling and video reflection?},
	volume = {121},
	issn = {1873-5134},
	shorttitle = {Training in medical communication competence through video-based e-learning},
	doi = {10.1016/j.pec.2023.108132},
	abstract = {OBJECTIVE: The present study investigated the efficacy of the didactic approaches of video modeling (VM, best-practice examples), video reflection (VR, problem-based approach), and the combination of both (VMR) in fostering medical communication competence in a video-based digital learning environment.
METHODS: N = 126 third-year medical students who participated in the pre-post study were assigned to either the intervention groups (VM, VR, and VMR) or the wait-list control group. The efficacy of the three approaches was assessed by means of a situational judgment test (SJT) of medical communication competence. To investigate the differences between the wait-list control and the intervention groups (H1), between the single-mode and combined conditions (H2), and between VM and VR (H3), we applied planned contrast analyses.
RESULTS: The planned contrasts showed that the VR condition significantly improved learning outcomes in comparison to the VM condition (H3). The decreased mean scores of the VM condition offset the increased mean scores of VR, and thus no significant differences could be found in H1 and H2.
CONCLUSIONS: Our study provides promising evidence that VR fosters medical communication competence more effectively than VM.
PRACTICAL IMPLICATIONS: Medical students' learning in video-based digital environments can be facilitated by the use of interactive VR.},
	language = {en-GB},
	journal = {Patient Education and Counseling},
	author = {Schick, Kristina and Reiser, Sabine and Janssen, Laura and Schacht, Laura and Pittroff, Sylvia Irene Donata and Dörfler, Eva and Klein, Evelyn and Roenneberg, Casper and Dinkel, Andreas and Fleischmann, Andreas and Berberat, Pascal O. and Bauer, Johannes and Gartmeier, Martin},
	month = apr,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, Learning, Humans, Communication, Students, Medical, \#5:Zeitschriftenartikel:e-learning, Computer-Assisted Instruction, Clinical Competence, E-learning, Medical communication competence, Video modeling, Video reflection, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {108132},
	annote = {1. Analyse
Hauptthemen und -ziele der Forschung: Die Studie von Schick et al. evaluiert die Effektivität von videobasiertem E-Learning zur Schulung der medizinischen Kommunikationsfähigkeiten unter Verwendung von Video-Modellierung (VM) und Video-Reflexion (VR). Ziel ist es, herauszufinden, welche Methode oder deren Kombination (VMR) die medizinische Kommunikationskompetenz bei Medizinstudenten am effektivsten verbessert.
Verwendete Methoden und Datenquellen: In der Studie wurden 126 Medizinstudenten im dritten Jahr in eine von drei Interventionsgruppen oder eine Warteliste-Kontrollgruppe randomisiert. Die Effektivität der Methoden wurde mittels eines situativen Urteilstests (SJT) zur medizinischen Kommunikationskompetenz bewertet.
Zentrale Forschungsergebnisse: Es zeigte sich, dass VR signifikant bessere Lernergebnisse im Vergleich zu VM lieferte. Die Kombination beider Ansätze (VMR) zeigte keine signifikanten Vorteile gegenüber den einzelnen Methoden.
2. Zusammenfassung
Die Studie von Schick et al. zeigt, dass Video-Reflexion (VR) im Vergleich zu Video-Modellierung (VM) effektiver in der Förderung der medizinischen Kommunikationskompetenz ist. Die Ergebnisse legen nahe, dass VR, das aktive Analyse und Reflexion von Kommunikationssituationen beinhaltet, eine tiefere Lernebene erreicht als VM, das auf das Vorführen von Best-Practice-Beispielen fokussiert ist.
3. Kernaussagen


"Die VR-Gruppe zeigte eine signifikante Verbesserung der Lernergebnisse im Vergleich zur VM-Gruppe." (S. 3)


"Die Kombination von VM und VR (VMR) erbrachte keine signifikanten Verbesserungen gegenüber den Einzelmethoden." (S. 4)


"VR fördert effektiv die medizinische Kommunikationskompetenz, indem es den Lernenden ermöglicht, Kommunikationssituationen aktiv zu analysieren und zu reflektieren." (S. 5)


4. Argumentationslinien
Die Studie unterstreicht die Bedeutung von Reflexion und aktiver Auseinandersetzung mit dem Lernmaterial. VR ermöglicht es den Studierenden, durch das kritische Betrachten von Videos tiefergehendes Verständnis und Fähigkeiten in der medizinischen Kommunikation zu entwickeln.
5. Verschlagwortung


Lehr- und Lerneffektivität: Die Überlegenheit von VR gegenüber VM bei der Schulung von Kommunikationskompetenzen zeigt die Effektivität von Methoden, die aktive Lernprozesse betonen.


Technologieintegration: Die Studie demonstriert die Rolle digitaler Technologien bei der Verbesserung der Lehrmethoden in der medizinischen Ausbildung.


Kollaboratives Lernen: Obwohl nicht direkt adressiert, könnte VR das kollaborative Lernen fördern, indem es die Studierenden zur Diskussion und Reflexion über beobachtete Kommunikationsstrategien anregt.


Systemanpassung: Anpassung von Lehrplänen zur Integration von digitalen Lernwerkzeugen, die reflexives Lernen fördern.


Forschungsansätze: Die methodologische Durchführung der Studie mittels randomisierter Kontrollgruppen und situativer Urteilstests liefert wichtige Erkenntnisse über die Wirksamkeit unterschiedlicher Lehrmethoden.


},
