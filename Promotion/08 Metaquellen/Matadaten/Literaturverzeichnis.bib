@article{theobald_test_2022,
	title = {Test {Anxiety} {Does} {Not} {Predict} {Exam} {Performance} {When} {Knowledge} {Is} {Controlled} {For}: {Strong} {Evidence} {Against} the {Interference} {Hypothesis} of {Test} {Anxiety}},
	volume = {33},
	issn = {0956-7976, 1467-9280},
	shorttitle = {Test {Anxiety} {Does} {Not} {Predict} {Exam} {Performance} {When} {Knowledge} {Is} {Controlled} {For}},
	url = {http://journals.sagepub.com/doi/10.1177/09567976221119391},
	doi = {10/grs7n3},
	abstract = {Do test-anxious students perform worse in exam situations than their knowledge would otherwise allow? We analyzed data from 309 medical students who prepared for a high-stakes exam using a digital learning platform. Using log files from the learning platform, we assessed students’ level of knowledge throughout the exam-preparation phase and their average performance in mock exams that were completed shortly before the final exam. The results showed that test anxiety did not predict exam performance over and above students’ knowledge level as assessed in the mock exams or during the exam-preparation phase. Leveraging additional ambulatory assessment data from the exam-preparation phase, we found that high trait test anxiety predicted smaller gains in knowledge over the exam-preparation phase. Taken together, these findings are incompatible with the hypothesis that test anxiety interferes with the retrieval of previously learned knowledge during the exam.},
	language = {en-GB},
	number = {12},
	urldate = {2023-02-20},
	journal = {Psychological Science},
	author = {Theobald, Maria and Breitwieser, Jasmin and Brod, Garvin},
	month = dec,
	year = {2022},
	keywords = {Charité:Promotion, Promotion:Literaturanalyse, \#0:Zeitschriftenartikel:digital:learning, Promotion:S:12 Digital Learning, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {2073--2083},
	file = {Theobald et al. - 2022 - Test Anxiety Does Not Predict Exam Performance Whe.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/9HV4MCZD/Theobald et al. - 2022 - Test Anxiety Does Not Predict Exam Performance Whe.pdf:application/pdf},
}

