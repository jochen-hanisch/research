@article{ganesh_novel_2025,
	title = {A novel end-to-end system for efficient generation of true/false educational assessments using deep learning models},
	copyright = {https://www.springernature.com/gp/researchers/text-and-data-mining},
	issn = {1868-5137, 1868-5145},
	url = {https://link.springer.com/10.1007/s12652-025-04992-2},
	doi = {10.1007/s12652-025-04992-2},
	abstract = {The rapid transition to digital education, fueled by the pandemic, has seen a rise in the use of online assessments. However, the process of educators generating these questions has remained largely inefficient and time-consuming. Our work introduces an innovative Natural Language Processing (NLP) approach that empowers educators by automating the creation of True/False assessments, freeing up their time for more advanced instructional tasks. This system, aligned with the Indian Central Board of Secondary Education (CBSE) curriculum, offers a unique combination of summarization techniques, semi-supervised learning, and a novel question-sampling algorithm. Using deep learning models for summarization and answer identification, this framework also identifies true statements and generates the corresponding false statements through transformer-based models. A specialized sampling algorithm tailors question generation to educators’ needs by assessing sentence difficulty and ranking them accordingly. Validation with high school teachers demonstrates the effectiveness of the framework. Compared to existing systems, our method achieves higher percentages across key metrics in terms of grammar semantics (82.4\% vs. 81\%), answerability (83.6\% vs. 77\%), and relevance (84.7\% vs. 84\%)—as well as stronger inter-annotator agreement with Kappa scores of 0.79 in grammar semantics and 0.76 in answerability. These results indicate that the framework not only saves educators time but also enhances assessment quality, making it a valuable tool for both learners and teachers in educational technology.},
	language = {en},
	urldate = {2025-07-18},
	journal = {Journal of Ambient Intelligence and Humanized Computing},
	publisher = {Springer Science and Business Media LLC},
	author = {Ganesh, T. N. Sree and Sheik, Reshma and Subramanyam, Suraj and Thomas, Jeremiah and Nirmala, S. Jaya},
	month = jul,
	year = {2025},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Technologieintegration, Bewertungsmethoden, Promotion:FU4b, Promotion:Schlussfolgerung, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	annote = {Analyse der Studie „A novel end-to-end system for efficient generation of true/false educational assessments using deep learning models“ von Ganesh et al. (2025)

1. Analyse
Hauptthemen und Ziele der Forschung
Ziel der Studie ist die Entwicklung eines automatisierten Systems zur Generierung von True/False-Fragen (TFQ) im Bildungsbereich mittels Deep Learning und Natural Language Processing (NLP). Das System adressiert den zeitintensiven Prozess der manuellen Frageerstellung durch Lehrkräfte und orientiert sich am indischen CBSE-Curriculum (Biologie und Geographie, Klassen 8 und 9). Im Fokus steht die Erhöhung der Effizienz und Qualität digitaler Leistungsbewertungen.
Methoden und Datenquellen
Die Forschenden implementieren ein vierphasiges Deep-Learning-basiertes Framework:


Summarization: Kombination von TextRank und BART zur inhaltszentrierten Textkondensation.


Answer Identification: Semi-supervised Training (ALBERT, BERT u. a.) zur Erkennung von Antwortkomponenten.


False Statement Generation: Maskierung der Antwortbestandteile, infilling via RoBERTa.


Sampling Algorithm: Auswahl von Fragen anhand linguistischer Komplexität (Wortanzahl, POS-Verteilung).


Datenbasis: NCERT-Schulbücher, extrahiert mittels Apache PDFBox, anschließend bereinigt und annotiert (regelbasiert, Pseudolabeling).
Zentrale Ergebnisse und Implikationen


Das Modell übertrifft bestehende Systeme (z. B. Zou et al., 2022) signifikant in Grammatik (87 \%), Relevanz (84,7 \%), Antwortbarkeit (83,6 \%).


Interannotator-Konsens ist hoch (Kappa: 0.89).


ALBERT-Modell zeigte beste Performance bei Effizienz und Genauigkeit (F1 = 65.86).


Das System unterstützt differenzierte Fragenschwierigkeit (leicht, mittel, schwer) und ist auf andere Fächer skalierbar.



2. Zusammenfassung
Ganesh et al. (2025) präsentieren ein automatisiertes System zur Generierung von True/False-Bildungsfragen auf Grundlage von Schulbuchtexten. Durch den Einsatz eines vierphasigen Frameworks (Summarization, Answer Identification, False Statement Generation, Sampling) auf Basis moderner NLP-Modelle wird ein vollständiger Workflow realisiert. Die Evaluierung erfolgt mit annotierten Datensätzen und durch Lehrkräfte. Die Resultate belegen eine höhere Qualität und Relevanz im Vergleich zu existierenden Verfahren. Die Studie zeigt, wie KI-basierte Systeme Lehrkräfte bei der Leistungsbewertung effektiv entlasten und so digitale Bildungspraktiken stärken können.

3. Kernaussagen (mit Fundstellen)


„Our system demonstrates state-of-the-art results in TFQ generation and answer identification tasks“ (S. 2).


„We propose a novel end-to-end system […] for automatically generating true/false educational assessments.“ (S. 2)


„The ALBERT model achieved the highest performance“ (S. 8).


„Our model achieved a kappa score of 0.89, indicating a high level of agreement among the annotators“ (S. 9).


„Compared to existing systems, our method achieves higher percentages across key metrics“ (S. 1).



4. Argumentationslinien
Die Autor*innen führen ein zentrales Problem aus der Praxis an – die aufwändige manuelle Erstellung von TFQs – und motivieren daraus die Notwendigkeit eines KI-gestützten Systems. Sie argumentieren, dass bestehende Methoden entweder ineffizient (regelbasiert) oder ungenau (fehlende pädagogische Relevanz) sind. Darauf aufbauend leiten sie die vierteilige Modellarchitektur her. Jedes Modul wird empirisch evaluiert (z. B. ALBERT bei Answer Identification), die Ergebnisse werden durch Kappa-Konsens und Metriken (Fluency, Answerability etc.) validiert. Abschließend wird der didaktische Nutzen hervorgehoben: Lehrkräfte erhalten ein flexibles Tool zur zeitsparenden Erstellung valider Assessments.

5. Verschlagwortung


Technologieintegration: Nutzung fortgeschrittener NLP-Modelle (BART, RoBERTa) zur Integration in schulische Bewertungssysteme.


Bewertungsmethoden: Fokus liegt auf der automatisierten Erstellung und Bewertung von TFQs.


Systemanpassung: Auswahlparameter (Fach, Schwierigkeitsgrad, Klasse) ermöglichen passgenaue Integration ins Curriculum.


Lehr- und Lerneffektivität: Durch Entlastung der Lehrkräfte kann der Fokus stärker auf didaktische und kognitive Prozesse gelegt werden.


Forschungsansätze: Semi-supervised Learning, Transfer Learning und Pseudolabeling als innovative methodische Ansätze.



6. Kategorisierung
Kategorie: SchlussfolgerungDie Studie zieht eine klare Bewertung aus der empirischen Analyse: Das entwickelte System verbessert Effizienz und Qualität bei der Erstellung pädagogisch valider TFQs signifikant. Der Schluss wird durch empirische Evaluation, Nutzerfeedback und Modellvergleiche gestützt.

7. Zuordnung zur Forschungsunterfrage
Passende FU:FU4b – Technisch-gestalterische Mechanismen

Welche technisch-gestalterische Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?

Begründung:Die Studie befasst sich detailliert mit der technischen Gestaltung eines automatisierten TFQ-Generators. Die Integration in digitale Lernumgebungen, die adaptive Steuerung (Summarization, Masking, Sampling), die semantische Validierung und die Nutzer*innenrückmeldung beschreiben genau die Art von Mechanismen, die für die Wirkung digitaler Systeme auf Akteure im Bildungsraum verantwortlich sind.

8. Relevanzbewertung


Direkte Relevanz für die FU: 5


Fokus auf technische Gestaltung: 5


Beitrag zur Digitalisierung pädagogischer Prozesse: 5Gesamtbewertung: 5 – Hoch relevant


},
	file = {Ganesh et al. - 2025 - A novel end-to-end system for efficient generation of truefalse educational assessments using deep:/Users/jochenhanisch-johannsen/Zotero/storage/766652DY/Ganesh et al. - 2025 - A novel end-to-end system for efficient generation of truefalse educational assessments using deep.pdf:application/pdf},
}

@article{di_bari_remote_2025,
	title = {Remote online teaching beyond {COVID}-19 pandemic: a qualitative study across {Physiotherapy} programs in {Italy}},
	volume = {25},
	copyright = {https://creativecommons.org/licenses/by-nc-nd/4.0},
	issn = {1472-6920},
	shorttitle = {Remote online teaching beyond {COVID}-19 pandemic},
	url = {https://bmcmededuc.biomedcentral.com/articles/10.1186/s12909-025-07386-2},
	doi = {10.1186/s12909-025-07386-2},
	abstract = {Background With the lockdown imposed by the Coronavirus Disease 2019 (COVID-19) pandemic, remote online teaching (ROT) became pivotal in the rapid reorganization imposed on the healthcare professions’ educational programs. Physiotherapy programs were particularly affected, as they are characterized by hard and soft skills that are hardly learned with ROT. The purpose of the present study was to investigate the experiences and opinions on ROT by faculties involved in the education and training of Physiotherapy students during the pandemic, and on its possible application thereafter.
Methods Following accreditated checklists for qualitative research, semi-structured interviews were conducted by members of the National Directorate of the Physiotherapy programs in Italy. Academic directors (AD) and clinical training coordinators (CTC) of Italian Physiotherapy programs were randomly selected and interviewed, to collect their experiences and opinions on the use of ROT before, during, and after the COVID-19 pandemic. Iterative rounds of readings and discussions were conducted to analyze the interviews.
Results A total of 22 participants were interviewed, reaching a satisfactory level of saturation. Before the COVID-19 pandemic, ROT was used sporadically in academic activities; during the pandemic, participants familiarized themselves rapidly with this new approach, which was generally abandoned thereafter. After initial difficulties, most participants recognized the importance of ROT in preserving education during the lockdown. A negative impact on Physiotherapy students was occasionally reported, especially during their final exam and thesis dissertation. Despite the limitations of ROT in Physiotherapy education, participants recognized its advantages in supporting administrative tasks, sharing lectures, and creating international programs. Its potential for pedagogical innovation and the opportunity for investments in Internet-based didactic approaches were also underlined.
Conclusions ROT was perceived as an important tool to preserve Physiotherapy programs during the COVID-19 pandemic. Although it was in general discontinued after the pandemic, many participants believed that it might contribute to establishing a “new normal” didactic paradigm in Physiotherapy education.},
	language = {en},
	number = {1},
	urldate = {2025-07-21},
	journal = {BMC Medical Education},
	publisher = {Springer Science and Business Media LLC},
	author = {Di Bari, Mauro and Deodato, Manuela and Paci, Matteo and Gatti, Roberto},
	month = jul,
	year = {2025},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Technologieintegration, Systemanpassung, Promotion:FU5, Krisenreaktion im Bildungsbereich, Promotion:Schlussfolgerung, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis, Promotion:sec:A-14, Promotion:sec:Technologiedefizit, Promotion:sec:MedienpaedagogischeRahmung, Promotion:sec:LMS-Bildungsraum-Begrenzte-Steuerbarkeit, Promotion:chap:04-02},
	annote = {Analyse der Studie „Remote online teaching beyond COVID-19 pandemic: a qualitative study across Physiotherapy programs in Italy“ von Di Bari et al. (2025)

1. Hauptthemen und Ziele der Forschung
Ziel der qualitativen Studie war die Untersuchung der Wahrnehmung und Erfahrungen von Lehrenden (Akademische Direktorinnen und klinische Koordinatorinnen) in Physiotherapie-Programmen in Italien im Umgang mit Remote Online Teaching (ROT) während, vor und nach der COVID-19-Pandemie. Die Forscher*innen wollten herausfinden, ob die Erfahrungen mit ROT langfristige Veränderungen im Lehrverhalten angestoßen haben.

2. Methoden und Datenquellen
Methoden:


Qualitativ-phänomenologische Studie


Halbstrukturierte Interviews


Themenspezifische Kodierung durch iterative thematische Analyse ohne Softwareunterstützung


Datenquellen:


22 Interviews mit akademischen Direktorinnen (AD) und klinischen Koordinatorinnen (CTC) aus verschiedenen Regionen Italiens


Videobasierte Online-Interviews via Google Meet


Transkription mittels KI-basierter Software (Cabolo®).



3. Zentrale Forschungsergebnisse


Vor der Pandemie wurde ROT kaum genutzt; in der Pandemie als Notlösung schnell adaptiert.


ROT wurde trotz Herausforderungen als nützlich erkannt, um Ausbildungskontinuität sicherzustellen.


Hauptkritik: unzureichende Vermittlung praktischer Fertigkeiten und soziale Isolation der Lernenden.


Nach der Pandemie wurde ROT großteils wieder eingestellt – meist aus psychologischen (nicht rationalen) Gründen.


Potenziale: internationale Programme, geteilte Lehrveranstaltungen, administrative Erleichterung, ökologischer Nutzen.


Langfristige Integration scheiterte oft an strukturellen Widerständen und unzureichender Didaktisierung.



4. Zusammenfassung
Die Studie zeigt, dass ROT in der physiotherapeutischen Ausbildung als funktionale Übergangslösung während der Pandemie diente, aber nur begrenzt nachhaltig in das post-pandemische Bildungssystem übernommen wurde. Trotz anfänglicher Skepsis entwickelten viele Lehrende eine positivere Haltung gegenüber digitalem Lehren, erkannten aber zugleich die strukturellen, didaktischen und sozialen Limitationen von ROT.

5. Kernaussagen (mit Fundstellen)


ROT war vor der Pandemie kaum verbreitet und wurde in der Krise hastig implementiert (S. 2).


Lehrende empfanden ROT als wertvoll für die Aufrechterhaltung des Unterrichts (S. 4).


Klinische Ausbildung litt massiv unter der Umstellung auf ROT (S. 5).


ROT ermöglichte jedoch innovative klinische Fallbesprechungen und stärkere Förderung des klinischen Denkens (S. 6).


Nach der Pandemie verschwand ROT weitgehend, oft aus psychologischer Ablehnung (S. 6).


ROT könnte langfristig Mehrwert für internationale und hybride Programme bieten (S. 6).


Die meisten Befragten fordern Investitionen in didaktische Schulungen statt nur Technik (S. 6–7).



6. Argumentationslinien
Die Autor*innen argumentieren entlang eines Spannungsfelds zwischen Nutzen und Grenzen von ROT:


Notwendigkeit: ROT war eine essentielle Maßnahme zur Sicherung der Lehre während der Pandemie.


Akzeptanz: Trotz anfänglicher Ablehnung wurde ROT als lehrreich und teilweise innovativ erkannt.


Kritik: Besonders in der praktischen Ausbildung und im sozialen Lernen ist ROT unzureichend.


Zukunft: ROT könnte Teil zukünftiger hybrider Lehrformate sein – wenn didaktisch weiterentwickelt.


Bedingung: Voraussetzung für sinnvolle Nutzung sind nicht Technik, sondern pädagogische Schulung der Lehrpersonen.



7. Verschlagwortung


Technologieintegration: Die Studie thematisiert die Integration von ROT in ein bestehendes Hochschulsystem.


Krisenreaktion im Bildungsbereich: Reaktion auf die COVID-19-Pandemie ist zentraler Untersuchungsgegenstand.


Lehr- und Lerneffektivität: ROT wird hinsichtlich seiner Auswirkungen auf klinisches Denken und Prüfungsleistungen diskutiert.


Forschungsansätze: Anwendung eines phänomenologischen Forschungsdesigns zur Erhebung multiperspektivischer Meinungen.


Systemanpassung: Postpandemische Rücknahme und Reflexion über zukünftige Nutzungsformen von ROT zeigen systemische Reaktionen auf externe Schocks.



8. Kategorisierung
Kategorie: Schlussfolgerung
Begründung: Die Studie bewertet abschließend ROT als nützliches Werkzeug zur Krisenbewältigung, erkennt jedoch dessen Grenzen für die Langzeitanwendung und leitet daraus Handlungsempfehlungen für zukünftige Integration in Bildungssysteme ab (z. B. Schulungsbedarf statt Technikzentrierung).

9. Zuordnung zu Forschungsunterfrage
Forschungsunterfrage (FU5):„Welche Möglichkeiten und Grenzen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems durch Akteure im digitalen Bildungsraum von Gesundheitsberufen analysiert?“
Begründung: Die Studie beleuchtet konkret die Chancen und Restriktionen digitaler Lehrformate (ROT) aus Perspektive der Lehrenden in Gesundheitsberufen.

10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Unmittelbare Auseinandersetzung mit Chancen und Limitationen digitaler Lehre)


Zitierhäufigkeit und Einfluss: 3 (Neue Studie, potenziell einflussreich, aber bisher keine etablierte Rezeption)


Aktualität: 5 (Veröffentlichung 2025)


Gesamtbewertung: 5

11. Schlussfolgerung
Die qualitative Studie von Di Bari et al. (2025) bietet zentrale Erkenntnisse zur Akzeptanz, Nutzung und Bewertung von ROT in der physiotherapeutischen Ausbildung. Sie zeigt auf, wie eine erzwungene Transformation langfristige Denkprozesse auslösen kann – allerdings nur dann zu Innovationen führt, wenn institutionelle Offenheit und didaktische Professionalisierung hinzukommen.
},
	file = {Di Bari et al. - 2025 - Remote online teaching beyond COVID-19 pandemic a qualitative study across Physiotherapy programs i:/Users/jochenhanisch-johannsen/Zotero/storage/GU52GKT6/Di Bari et al. - 2025 - Remote online teaching beyond COVID-19 pandemic a qualitative study across Physiotherapy programs i.pdf:application/pdf},
}

@book{baumgarten_low_2025,
