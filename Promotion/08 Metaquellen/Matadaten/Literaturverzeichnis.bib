	keywords = {Promotion:01-02, Promotion:01-02 Methodenquellen, Promotion:Literaturverzeichnis},
	pages = {18},
	file = {Brückner und Zlatkin-Troitschanskaia - 2024 - Effects of teacher students’ study progress on their gaze behavior while solving of an economics kno:/Users/jochenhanisch-johannsen/Zotero/storage/3TFB4V6N/Brückner und Zlatkin-Troitschanskaia - 2024 - Effects of teacher students’ study progress on their gaze behavior while solving of an economics kno.pdf:application/pdf},
