	keywords = {Charité:Promotion, Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
