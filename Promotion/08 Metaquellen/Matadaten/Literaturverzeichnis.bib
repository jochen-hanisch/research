	note = {ZSCC: 0000005},
	keywords = {Promotion:Literaturanalyse, Kollaboratives Lernen, Promotion:FU4a, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Bildungstheorien, \#6:Zeitschriftenartikel:Bildung:Technologie, Promotion:S:06 Bildungstechnologie, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {59--92},
