	file = {Budde - 2021 - Der digitale Wandel als Motor der Hochschulentwick.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/ELPYP2RU/Budde - 2021 - Der digitale Wandel als Motor der Hochschulentwick.pdf:application/pdf},
