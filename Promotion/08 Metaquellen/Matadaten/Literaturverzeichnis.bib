@incollection{vanderheiden_embodying_2025,
	address = {Cham},
	title = {Embodying {Pedagogical} {Love} {Through} {Feminist} {Pedagogy} and the {Principles} of bell hooks’ {Love} {Ethic} {Within} a {Religious} {Studies} {Classroom} and {Beyond}},
	isbn = {978-3-031-82045-8 978-3-031-82046-5},
	url = {https://link.springer.com/10.1007/978-3-031-82046-5_21},
	doi = {10.1007/978-3-031-82046-5_21},
	abstract = {Within our increasingly diverse higher education classrooms, nurturing learning through strategies and environments that foster inclusion and belonging has become imperative. In the post-pandemic move back to in-person teaching, a shift from online and often asynchronous modes of course delivery, both lecturers and students have encountered opportunities and challenges that present themselves when our embodiment is both perceived and felt within the educational encounter. Early in 2024, I lectured an undergraduate module in the Study of Religions, the course is positioned at an intersection of religion and gender. The module I taught critically engaged with representations of gender and sexuality specifically within Christianity, and the resources and content for the Christianity module were predominantly and intentionally from Feminist, African Feminist, and Queer Theological perspectives. Educators have noted how trust and care, principles embedded in approaches that espouse pedagogical love, promote classroom relations that facilitate active listening, dialogue, and cooperation between both teacher and student. Positioning my teaching and facilitation within the guiding framework of bell hooks’ love ethic, which also centres trust and care (in addition to commitment, responsibility, respect, and knowledge), led to a conscious and intentional weaving of feminist and engaged pedagogies, within my approach to religious studies education, and pedagogical love in the classroom. In this chapter I will be critically reflecting on this experience through (1) my own embodiment and positionality in relation to the students in the classroom, (2) the feminist orientation of the casestudy, the course content and curriculum as guided by a feminist approach to religious studies, as well as (3) the in-classroom teaching and learning engagement strategies used to facilitate learning, understanding, and connection. This critical reflection will be supported by anonymous student feedback received in course evaluations, and my observations of student participation in the classroom.},
	language = {en-GB},
	urldate = {2025-05-05},
	booktitle = {Pedagogical {Love} in {Adult} {Education}},
	publisher = {Springer Nature Switzerland},
	author = {Carlse, Janine},
	editor = {Vanderheiden, Elisabeth and Mayer, Claude-Hélène and Barcelos, Ana Maria F.},
	year = {2025},
	keywords = {Promotion:Literaturanalyse, \#b:Buchteil:online:learning, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {409--424},
	file = {Carlse - 2025 - Embodying Pedagogical Love Through Feminist Pedagogy and the Principles of bell hooks’ Love Ethic Wi:/Users/jochenhanisch-johannsen/Zotero/storage/95VRSQZ4/Carlse - 2025 - Embodying Pedagogical Love Through Feminist Pedagogy and the Principles of bell hooks’ Love Ethic Wi.pdf:application/pdf},
}

@incollection{vanderheiden_pedagogical_2025,
	address = {Cham},
	title = {Pedagogical {Love} and {Online} {Learning}: {What} {Matters} to {Students}},
	isbn = {978-3-031-82045-8 978-3-031-82046-5},
	shorttitle = {Pedagogical {Love} and {Online} {Learning}},
	url = {https://link.springer.com/10.1007/978-3-031-82046-5_22},
	doi = {10.1007/978-3-031-82046-5_22},
	abstract = {Määtä and Uusiautti’s conceptualization of pedagogical love is supported by others such as Freire, Fromm, and van Manen; being a good teacher requires a loving attitude, an attachment to learners, and a strong desire to help the learner grow and develop to their best potential. The two authors work in teacher education programs where many students take classes online and asynchronously. This lack of in-person, face-to-face connection raises challenges for the relational teacher educator. To better understand how and whether pedagogical love was realized by online students, the authors sent students an anonymous survey with openended questions. The authors then analyzed these results to understand better what relational, pedagogical love these students experience in online coursework.},
	language = {en-GB},
	urldate = {2025-05-05},
	booktitle = {Pedagogical {Love} in {Adult} {Education}},
	publisher = {Springer Nature Switzerland},
	author = {Jones, Alexis L. and Kessler, Meghan A.},
	editor = {Vanderheiden, Elisabeth and Mayer, Claude-Hélène and Barcelos, Ana Maria F.},
	year = {2025},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:FU4a, Promotion:Relevanz:5, Technologieintegration, Systemanpassung, Bildungstheorien, Promotion:Argumentation, \#b:Buchteil:online:learning, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {425--439},
	annote = {Analyse des Artikels „Pedagogical Love and Online Learning: What Matters to Students“ von Jones \& Kessler (2025) nach deinen Vorgaben:

1. Analyse
Hauptthemen und Ziele der Forschung
Die zentrale Fragestellung der Studie lautet: Wie erleben Studierende „pädagogische Liebe“ im Kontext asynchroner Online-Lehrveranstaltungen? Ziel ist es, herauszufinden, welche pädagogischen Haltungen und konkreten didaktischen Praktiken von Studierenden als fürsorglich, empathisch und unterstützend wahrgenommen werden. Damit will die Studie zur Theoriebildung über "pedagogical love" im digitalen Bildungsraum beitragen und Hinweise für eine menschlichere Gestaltung digitaler Lehre liefernJones und Kessler - 202….
Verwendete Methoden und Datenquellen


Methoden: Qualitative Inhaltsanalyse nach Prinzipien der Grounded Theory (Charmaz, 2000; Glaser, 2011)


Datenbasis: Anonyme, offene Online-Umfrage via Google Forms an aktuelle und ehemalige Master-Studierende (n = 15)


Zielgruppe: Berufstätige Lehrer:innen in Online-Graduiertenprogrammen zweier US-Hochschulen


Analyseansatz: Zwei Hauptkategorien wurden induktiv entwickelt – „Stances“ (Wie Lehrende sind) und „Strategies“ (Was Lehrende tun)Jones und Kessler - 202…


Zentrale Forschungsergebnisse


Studierende verbinden pädagogische Liebe mit menschlicher Verbindung, Empathie und Rückmeldung.


Zwei Hauptdimensionen beeinflussen das Erleben pädagogischer Liebe:


Stances: Empathie, Authentizität, Wärme, Menschlichkeit


Strategies: Videobotschaften, synchrone Treffen, ausführliche individuelle Rückmeldungen




Gleichzeitig besteht ein Spannungsfeld zwischen dem Wunsch nach persönlicher Verbindung und dem Bedarf an zeitlicher Flexibilität – viele Studierende bevorzugen asynchrone Kurse wegen ihrer LebensrealitätenJones und Kessler - 202….



2. Zusammenfassung
Jones \& Kessler (2025) untersuchen anhand qualitativer Daten, wie pädagogische Liebe – verstanden als Haltung der Fürsorglichkeit, Empathie und Unterstützung – im asynchronen Online-Lernen erlebt wird. Ihre Analyse von 15 anonym erhobenen studentischen Rückmeldungen zeigt, dass sowohl affektive Haltungen („Wie Lehrende sind“) als auch konkrete didaktische Praktiken („Was Lehrende tun“) entscheidend zur positiven Wahrnehmung beitragen. Besonders geschätzt werden Feedback, persönliche Videobotschaften und synchrone Kontaktmöglichkeiten. Allerdings erleben viele Studierende einen Zielkonflikt zwischen Beziehungsqualität und notwendiger zeitlicher Flexibilität. Die Autorinnen plädieren für eine digital angepasste, „liebende“ Lehre, die menschliche Verbindung trotz Asynchronität ermöglicht.

3. Kernaussagen (mit Fundstellen)


„Connection and community represented pedagogical love“ – Verbindung und Gemeinschaft als Kernelemente pädagogischer Liebe (S. 431)


„How instructors are… and what instructors do“ – Zentrale Kategorien zur Wahrnehmung von Fürsorglichkeit (S. 430–432)


„Lengthy feedback… shows investment and care“ – Rückmeldung als emotional bedeutsames Interaktionselement (S. 433)


„They’re okay simply because they are convenient – but very impersonal“ – Flexibilität wird oft der Beziehungsqualität vorgezogen (S. 435)


„Online instructors should lean into virtual capacities while enhancing humanizing elements“ – Digitalisierung braucht gezielte Humanisierung (S. 436)



4. Argumentationslinien (mit Seitenangabe)


S. 426–427: Theoretische Verortung in Konzepten pädagogischer Liebe nach Määttä \& Uusiautti, Freire, Fromm, van Manen


S. 428–430: Methodologie und forschungspraktische Verankerung (Self-Study, Grounded Theory)


S. 431–434: Ergebnisse strukturiert nach „Stances“ (affektive Haltung) und „Strategies“ (praktische Maßnahmen)


S. 435: Darstellung des Spannungsfeldes zwischen zeitlicher Flexibilität und Bedürfnis nach Beziehung


S. 436–437: Diskussion und Implikationen für zukünftige Forschung und Lehre



5. Verschlagwortung




Schlagwort


Begründung




Bildungstheorien


Die Studie basiert auf Theorien pädagogischer Liebe (u. a. Freire, Fromm, van Manen).




Lehr- und Lerneffektivität


Thematisiert wird, wie affektive Faktoren das Lernerleben in digitalen Räumen verbessern.




Kollaboratives Lernen


Gemeinschaftliches Lernen wird als relationales Bedürfnis thematisiert (z. B. Zoom, Padlet).




Technologieintegration


Diskutiert wird die Integration von Videos, LMS, Zoom als Beziehungsmittel.




Forschungsansätze


Qualitative, theoriebasierte Grounded-Theory-Analyse mit Self-Study-Komponente.




Systemanpassung


Reflexion über die Grenzen und Potenziale digitaler Lehre im Spannungsfeld von Beziehung und Flexibilität.





6. Kategorisierung
Kategorie: ArgumentationBegründung: Die Studie basiert auf einem systematischen Bezug zu theoretischen Konzepten pädagogischer Liebe (Määttä \& Uusiautti, Freire, Fromm) und diskutiert diese kritisch im Hinblick auf deren Umsetzung in Online-Lernumgebungen. Die empirischen Ergebnisse werden konsequent in diese Theoriebildung eingebettet.

7. Zuordnung zu Forschungsunterfrage
Zuordnung: FU4a – Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?
Begründung: Die Studie liefert zentrale Einsichten zu bildungswissenschaftlichen Mechanismen wie Empathie, Beziehungsgestaltung, Feedbackkultur und Community-Building in digitalen Lernräumen – allesamt Faktoren, die sich auch im Gesundheitsbereich systemisch-konstruktivistisch deuten lassen.

8. Relevanzbewertung
Bewertung: 5 – Hoch relevant


Direkter Bezug zur Wirkung von Online-Lehre auf Akteure


Theoriegeleitete Analyse mit Transferpotenzial für Gesundheitsberufe


Kombination aus empirischer Evidenz und systemischer Theoriebildung


},
	annote = {{\textless}div class="codex-extract"{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Quelle (PDF):{\textless}/strong{\textgreater} /Users/jochenhanisch-johannsen/Zotero/storage/HEIUXFTL/Jones und Kessler - 2025 - Pedagogical Love and Online Learning What Matters to Students.pdf{\textless}/p{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Extrakte (Treffer auf Muster):{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}ol{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 12{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}indicate that it is not only possible but important for instructors to connect withstudents in authentic, caring, and compassionate ways. While instructor videos (forfeedback or course content) were described as a high-impact practice, the responsesabove also reveal that simple tone and instructor language can help students feelcared for online.{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}/ol{\textgreater}{\textless}/div{\textgreater}},
