@article{skulmowski_forced-choice_2014,
	title = {Forced-choice decision-making in modified trolley dilemma situations: a virtual reality and eye tracking study},
	volume = {8},
	issn = {1662-5153},
	shorttitle = {Forced-choice decision-making in modified trolley dilemma situations},
	url = {http://journal.frontiersin.org/article/10.3389/fnbeh.2014.00426/abstract},
	doi = {10.3389/fnbeh.2014.00426},
	abstract = {Based on the frameworks of dual-process theories, we examined the interplay between intuitive and controlled cognitive processes related to moral and social judgments. In a virtual reality (VR) setting we performed an experiment investigating the progression from fast, automatic decisions towards more controlled decisions over multiple trials in the context of a sacriﬁcing scenario. We repeatedly exposed participants to a modiﬁed tento-one version and to three one-to-one versions of the trolley dilemma in VR and varied avatar properties, such as their gender and ethnicity, and their orientation in space. We also investigated the inﬂuence of arousing music on decisions. Our experiment replicated the behavioral pattern observed in studies using text versions of the trolley dilemma, thereby validating the use of virtual environments in research on moral judgments. Additionally, we found a general tendency towards sacriﬁcing male individuals which correlated with socially desirable responding. As indicated by differences in response times, the ten-toone version of the trolley dilemma seems to be faster to decide than decisions requiring comparisons based on speciﬁc avatar properties as a result of differing moral content. Building upon research on music-based emotion induction, we used music to induce emotional arousal on a physiological level as measured by pupil diameter. We found a speciﬁc temporal signature displaying a peak in arousal around the moment of decision. This signature occurs independently of the overall arousal level. Furthermore, we found context-dependent gaze durations during sacriﬁcing decisions, leading participants to look prolonged at their victim if they had to choose between avatars differing in gender. Our study conﬁrmed that moral decisions can be explained within the framework of dualprocess theories and shows that pupillometric measurements are a promising tool for investigating affective responses in dilemma situations.},
	language = {en},
	urldate = {2025-01-26},
	journal = {Frontiers in Behavioral Neuroscience},
	author = {Skulmowski, Alexander and Bunge, Andreas and Kaspar, Kai and Pipa, Gordon},
	month = dec,
	year = {2014},
	keywords = {Promotion:01-02, Promotion:01-02 Methodenquellen, Promotion:Literaturverzeichnis},
	file = {Skulmowski et al. - 2014 - Forced-choice decision-making in modified trolley dilemma situations a virtual reality and eye trac:/Users/jochenhanisch-johannsen/Zotero/storage/W6N3P46Q/Skulmowski et al. - 2014 - Forced-choice decision-making in modified trolley dilemma situations a virtual reality and eye trac.pdf:application/pdf},
}

@article{habib_flexible_2023,
	title = {Flexible {Learning} {Approach}: {A} {Systematic} {Review} of {Pedagogical} {Tools} for {Higher} {Education}},
	issn = {1556-5068},
	shorttitle = {Flexible {Learning} {Approach}},
	url = {https://www.ssrn.com/abstract=4574286},
	doi = {10/gs28rq},
	abstract = {The paper seeks to explore pedagogical tools within flexible learning that could contribute positively to the development of skill sets for students in the context of higher education. To this effect, a systematic review was adopted in obtaining all possible studies related to flexible learning and pedagogical tools analysed and presented accordingly for this paper. A systematic review is an objective, reproducible approach to finding answers to the overarching question of this paper. There is a growing body of knowledge relating to pedagogical tools within flexible learning in higher education. In the field of learning and teaching, a well-conducted systematic review (SR) is considered a feasible approach to keeping academics abreast of the current evidence-based teaching and learning practice. To ensure data quality and accuracy two reviewers were engaged in the review process.},
	language = {en},
	urldate = {2023-10-30},
	journal = {SSRN Electronic Journal},
	author = {Habib, Armaghan and Pius, A.},
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Bewertungsmethoden, Systemanpassung, Promotion:Relevanz:4, Promotion:FU3, Promotion:01-02, Promotion:01-02 Methodenquellen, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU3},
	annote = {Analyse des Artikels „Flexible Learning Approach: A Systematic Review of Pedagogical Tools for Higher Education“ von Habib und Pius (2023)

1. Analyse
Hauptthemen und Ziele der Forschung


Thema: Analyse pädagogischer Werkzeuge im Kontext flexibler Lernansätze in der Hochschulbildung.


Ziel: Systematische Überprüfung der Effektivität didaktischer Werkzeuge, um Studierende mit Kompetenzen für lebenslanges Lernen und berufliche Anforderungen auszustatten.


Verwendete Methoden und Datenquellen


Methodik:


Systematische Literaturübersicht (2010–2020) mit PRISMA-Ansatz.


Analyse von 107 Studien durch quantitative, qualitative und gemischte methodische Ansätze.


Theoretische Grundlage: Metaanalyse unter Verwendung des TREAD-Prinzips (Time, Resources, Expertise, Audience, Data).




Datenquellen:


Publikationen aus Datenbanken wie ERIC, DOAJ und Google Scholar.


Ausschluss von redaktionellen Briefen und nicht-veröffentlichten Arbeiten.




Zentrale Forschungsergebnisse


Kombination von Werkzeugen: Traditionelle Methoden (z. B. Vorlesungen) sind effektiver, wenn sie mit neuen Ansätzen wie Gamification, Online-Diskussionen und Simulationen kombiniert werden.


Wachsende Bedeutung digitaler Werkzeuge: Tools wie mobile Geräte, soziale Medien und virtuelle Lernplattformen steigern Flexibilität und Engagement.


Schlüsselkompetenzen: Pädagogische Werkzeuge tragen zur Entwicklung von Problemlösungsfähigkeiten, kritischem Denken und Teamarbeit bei.



2. Zusammenfassung
Die systematische Übersicht untersucht die Wirksamkeit flexibler Lernansätze und betont die Bedeutung kombinierter pädagogischer Werkzeuge für die Hochschulbildung. Die Studie hebt hervor, dass traditionelle Methoden durch digitale und interaktive Werkzeuge ergänzt werden sollten, um Studierende besser auf die Herausforderungen des globalen Arbeitsmarktes vorzubereiten.

3. Kernaussagen


Integration traditioneller und digitaler Methoden: Die Kombination von Vorlesungen mit modernen Tools fördert die Lernerfahrung (S. 4–5).


Technologiegetriebene Bildung: Flexible Lernplattformen bieten den Studierenden mehr Autonomie und Zugänglichkeit (S. 6–7).


Fokus auf Schlüsselkompetenzen: Werkzeuge wie Simulationen und Case Studies fördern kritisches Denken und Problemlösungsfähigkeiten (S. 8).



4. Argumentationslinien


Theorie: Bezug auf Barnetts Konzept flexibler Bildung, das die Anpassung von Lehrmethoden an individuelle Lernbedürfnisse betont (S. 3).


Empirische Evidenz: Die Übersicht zeigt, dass kombinierte Methoden effektiver sind als reine traditionelle oder digitale Ansätze (S. 7).


Praktische Relevanz: Empfehlungen zur Integration moderner Werkzeuge in flexible Curricula zur Verbesserung von Lernergebnissen und Beschäftigungsfähigkeit (S. 9).



5. Verschlagwortung


Technologieintegration: Schwerpunkt auf der Nutzung digitaler Plattformen und Tools zur Flexibilisierung der Hochschulbildung.


Lehr- und Lerneffektivität: Verbesserung der Lernergebnisse durch die Kombination traditioneller und moderner Ansätze.


Bewertungsmethoden: Systematische Analyse von Studien zur Bewertung der Wirksamkeit flexibler Lernansätze.



6. Kategorisierung
Kategorie: Kerngedanke


Begründung: Die Studie identifiziert zentrale Elemente flexibler Bildung und zeigt auf, wie innovative Tools die Hochschullehre transformieren können (S. 9–10).



7. Zuordnung zu Forschungsfragen
Passendste Forschungsunterfrage: FU3: „Wie sind Konzeption und relevante didaktische und bildungstechnologische Merkmale des systemisch-konstruktivistischen Learning-Management-Systems für Akteure im digitalen Bildungsraum von Gesundheitsberufen dargestellt?“


Begründung: Die Arbeit beschreibt detailliert die Konzeption und Anwendung moderner pädagogischer Tools in flexiblen Lernumgebungen (S. 6–7).



8. Relevanzbewertung


Direkte Relevanz: 5 (Hohe Relevanz für die Integration moderner Ansätze in digitale Bildungsplattformen).


Aktualität: 4 (Veröffentlichung 2023, aktuell und praxisnah).


Zitierhäufigkeit: 4 (Breit anwendbare Erkenntnisse, jedoch begrenzte spezifische Sichtbarkeit).


Gesamtbewertung: 4
},
	file = {Habib und Pius - 2023 - Flexible Learning Approach A Systematic Review of.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/SU2YWSE2/Habib und Pius - 2023 - Flexible Learning Approach A Systematic Review of.pdf:application/pdf},
}

@article{van_niekerk_addressing_2025,
	title = {Addressing the use of generative {AI} in academic writing},
	volume = {8},
	issn = {2666920X},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2666920X24001450},
	doi = {10.1016/j.caeai.2024.100342},
	language = {en},
	urldate = {2025-02-15},
	journal = {Computers and Education: Artificial Intelligence},
	author = {Van Niekerk, Johan and Delport, Petrus M.J. and Sutherland, Iain},
	month = jun,
	year = {2025},
	keywords = {Promotion:01-02, 4.3.1 Literaturanalyse und KI-gestützte Methoden, Promotion:01-02 Methodenquellen, Promotion:Literaturverzeichnis, Promotion:sec:P-QIA, Promotion:sec:Methodenkritik-Absicherung, Promotion:sec:Erkenntnisinteresse, Promotion:chap:04-04, Promotion:chap:04-01},
	pages = {100342},
	annote = {{\textless}!-- codex:methodenkritik:04-04 --{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Methodenkritik (Anschlussstelle: KI-gestützte Literatur-/Textarbeit, Evidenzlogik, Referenzprüfung){\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}p{\textgreater}Der Beitrag adressiert genau die Stelle, an der eine KI-gestützte Analyse in meiner Methodik angreifbar wäre: GenAI kann falsche bzw. fabrizierte Informationen liefern (Halluzinationen) und damit die Evidenzlogik einer Argumentation unterlaufen; zugleich wird der Punkt gemacht, dass damit nicht nur Fakten, sondern auch die Eigenleistung im Sinne originärer gedanklicher Formulierungs- und Bewertungsarbeit tangiert ist. Für mein Vorgehen folgt daraus, dass GenAI nicht als Quelle/Autor behandelt wird, sondern als Arbeitsoberfläche, deren Outputs in jedem Schritt an Primärtexte zurückgebunden und gegenprüfbar dokumentiert werden müssen. (Van Niekerk et al., 2025, S. 2){\textless}/p{\textgreater}{\textless}p{\textgreater}Besonders anschlussfähig ist die konkrete Operationalisierung: Studierende sollen Referenzen, die von ChatGPT in einem generierten Text genannt werden, aktiv auf Existenz prüfen, um fabrizierte Zitationen auszuschließen, und erst danach die Qualität der Quelle bewerten. Das ist für meine Methodik ein direktes Argument für ein verpflichtendes Referenz-Audit (Existenz, Passung, Primärquelle) als Teil des Workflows. (Van Niekerk et al., 2025, S. 4){\textless}/p{\textgreater}{\textless}p{\textgreater}Zusätzlich wird die Notwendigkeit klarer Anleitung und Interventionen betont, um Missbrauch bzw. unangemessene Nutzung zu begrenzen. Das stützt in meiner Methodik die Entscheidung, Governance nicht als Randthema zu führen, sondern als Bestandteil der Methode (Leitplanken, Offenlegung, Prüfroutinen). (Van Niekerk et al., 2025, S. 10){\textless}/p{\textgreater}},
	file = {Van Niekerk et al. - 2025 - Addressing the use of generative AI in academic writing:/Users/jochenhanisch-johannsen/Zotero/storage/ND92B4LM/Van Niekerk et al. - 2025 - Addressing the use of generative AI in academic writing.pdf:application/pdf},
}

@article{biswas_chatgpt_2023,
	title = {{ChatGPT} for {Research} and {Publication}: {A} {Step}-by-{Step} {Guide}},
	volume = {28},
	issn = {2331-348X, 1551-6776},
	shorttitle = {{ChatGPT} for {Research} and {Publication}},
	url = {https://jppt.kglmeridian.com/view/journals/jppt/28/6/article-p576.xml},
	doi = {10.5863/1551-6776-28.6.576},
	language = {en},
	number = {6},
	urldate = {2025-02-15},
	journal = {The Journal of Pediatric Pharmacology and Therapeutics},
	author = {Biswas, Som S.},
	month = oct,
	year = {2023},
	keywords = {Promotion:01-02, 4.3.1 Literaturanalyse und KI-gestützte Methoden, Promotion:01-02 Methodenquellen, Promotion:Literaturverzeichnis, Promotion:sec:P-QIA, Promotion:sec:Methodenkritik-Absicherung, Promotion:chap:04-04},
	pages = {576--584},
	annote = {{\textless}!-- codex:methodenkritik:04-04 --{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Methodenkritik (Anschlussstelle: Promptworkflow, wissenschaftliche Integrität, Grenzen der Delegation){\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}p{\textgreater}Biswas rahmt ChatGPT explizit als Tool, das nur unter ethischer Reflexion sinnvoll integrierbar ist: Bias, Interpretierbarkeit und Plagiatsrisiken werden als zentrale Problemzonen markiert. Das stützt in meiner Methodik die Setzung, dass KI-Ausgaben nicht als Ergebnis gelten, sondern als Vorstufe, die durch menschliche Prüfung, argumentative Einordnung und referenzierte Nachweise stabilisiert werden muss. (Biswas, 2023, S. 1){\textless}/p{\textgreater}{\textless}p{\textgreater}Sehr klar wird die rote Linie im Methodendesign gezogen: ChatGPT darf nicht zur Fabrikation von Daten oder Ergebnissen eingesetzt werden; bestimmte Abschnitte (hier: Patientendaten/Results) müssen authentisch bleiben und können nicht an das Modell delegiert werden. Das ist ein direktes Argument, die Delegationsgrenze in meiner Methodik explizit zu markieren (was KI darf und was nicht) und die Authentizität von Daten/Ergebnissen als nicht substituierbaren Kern auszuweisen. (Biswas, 2023, S. 7){\textless}/p{\textgreater}},
	file = {Biswas - 2023 - ChatGPT for Research and Publication A Step-by-Step Guide:/Users/jochenhanisch-johannsen/Zotero/storage/6DDDWQ6N/Biswas - 2023 - ChatGPT for Research and Publication A Step-by-Step Guide.pdf:application/pdf},
}

@article{storey_ai_2023,
	title = {{AI} {Technology} and {Academic} {Writing}: {Knowing} and {Mastering} the “{Craft} {Skills}”},
	volume = {14},
	issn = {2643-7996, 2643-8003},
	shorttitle = {{AI} {Technology} and {Academic} {Writing}},
	url = {https://services.igi-global.com/resolvedoi/resolve.aspx?doi=10.4018/IJAET.325795},
	doi = {10.4018/IJAET.325795},
	abstract = {Evidence shows that artificial intelligence (AI) has become an important subject in academia, representing about 2.2\% of all scientific publications. One concern for doctoral programs is the future role of AI in doctoral writing due to the increase in AI-generated content, such as text and images. Apprehensions have been expressed that the use of AI may have a negative impact on a doctoral student’s ability to think critically and creatively. In contrast, others argue that using AI tools can provide various benefits resulting in rigorous research. This conceptual article first discusses the developing relationship between AI and dissertation writing skills. Second, the article explores the origins of the traditional dissertation and outlines 21st-century dissertation options which reflect contextual needs and utilization of AI. Third, identified writing challenges are highlighted before turning to an in-depth examination of AI-generated tools and writing craft skills required to complete the five chapters of a traditional dissertation.},
	language = {en},
	number = {1},
	urldate = {2024-01-12},
	journal = {International Journal of Adult Education and Technology},
	author = {Storey, Valerie A.},
	month = jul,
	year = {2023},
	keywords = {Promotion:01-02, 4.3.1 Literaturanalyse und KI-gestützte Methoden, Promotion:01-02 Methodenquellen, Promotion:Literaturverzeichnis, Promotion:sec:P-QIA, Promotion:sec:Methodenkritik-Absicherung, Promotion:chap:04-04},
	pages = {1--15},
	annote = {{\textless}!-- codex:methodenkritik:04-04 --{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Methodenkritik (Anschlussstelle: KI-gestützte Text-/Literaturarbeit, Promptworkflow, Dokumentationslogik){\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}p{\textgreater}Der Beitrag macht sehr klar, dass GenAI den Dissertationsprozess nicht nur "beschleunigt", sondern die Trennlinie zwischen eigenständiger wissenschaftlicher Leistung und maschinell generierter Formulierung/Strukturierung faktisch verwischt: Dissertation Committees stehen vor dem Problem, nicht mehr verlässlich unterscheiden zu können, was vom Kandidaten stammt und was von KI erzeugt wurde; verstärkend kommt hinzu, dass KI-Ausgaben gezielt einen akademischen Stil imitieren können und Detektionswerkzeuge (gerade bei neuen Modellen) nicht stabil greifen. Konsequenz für mein Vorgehen ist: KI wird methodisch nicht als "Autor" eingesetzt, sondern als probabilistischer Assistenzraum, dessen Outputs zwingend in eine Prüf- und Dokumentationslogik zurückgebunden werden müssen (Audit-Trail: Prompt, Input, Output, Entscheidung, Revision), um die Zuschreibung von Autorenschaft und die Nachvollziehbarkeit der Argumentführung nicht zu unterlaufen. (Storey, 2023, S. 2){\textless}/p{\textgreater}{\textless}p{\textgreater}Gleichzeitig wird ein zweiter, in meiner Methodik zentraler Kritikpunkt adressiert: Auch wenn Hochschulen die Nutzung prinzipiell zulassen, wird die Bedingung der effektiven, ethischen und transparenten Nutzung explizit an die Sorge gekoppelt, dass eine (zu starke) Abhängigkeit von KI die Schreib-, Kritik- und Evaluationskompetenzen des Forschenden erodieren kann. Daraus folgt für mein Design eine doppelte Absicherung: (1) KI-Outputs werden nicht als Erkenntnis akzeptiert, sondern als Vorschlag, der gegen Primärtexte, Ankerbeispiele und theoriegeleitete Kriterien gegengeprüft wird; (2) die argumentative Verantwortung bleibt beim Forschenden und wird über explizite Entscheidungen (Warum diese Kategorie? Warum diese Verdichtung?) sichtbar gehalten. (Storey, 2023, S. 4){\textless}/p{\textgreater}{\textless}p{\textgreater}Schließlich wird die Integritätsdimension pragmatisch gefasst: KI-gestützte Plagiats- und Formatierungstools können zwar genutzt werden, aber nur unter der Bedingung, dass der Einsatz transparent gemacht und korrekt referenziert wird. Das stützt in meiner Methodik die Forderung nach Offenlegung (welche Tools wofür), ohne damit die inhaltliche Prüfpflicht zu delegieren. (Storey, 2023, S. 13){\textless}/p{\textgreater}},
	file = {Storey - 2023 - AI Technology and Academic Writing Knowing and Ma.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/TTPCNK22/Storey - 2023 - AI Technology and Academic Writing Knowing and Ma.pdf:application/pdf},
}

@article{al_harrasi_developing_2023,
	title = {Developing a needs-based plagiarism management in second-language writing in a higher education institute: practice-oriented research},
	volume = {51},
	issn = {0020-4277, 1573-1952},
	shorttitle = {Developing a needs-based plagiarism management in second-language writing in a higher education institute},
	url = {https://link.springer.com/10.1007/s11251-023-09628-6},
	doi = {10.1007/s11251-023-09628-6},
	abstract = {The paper describes an action research being developed by the researcher to address the issue of plagiarism and assist tertiary students to master second-language (L2) writing using sources in a higher education institute (HEI) in Oman. It recruited 16 undergraduate students from two classes who undertook an L2 writing course. To identify their needs of citation skills and develop a follow-up action plan, the students were initially asked to write a referenced-based essay, and then they were interviewed to explore their knowledge and skills of citation. Accordingly, specific amount of tasks were developed and conducted in 10 weeks. After implementing the tasks, the participants were asked to write another referenced-based essay and then they were interviewed for the second time to explore any change they had in knowledge and skills of citation. Findings showed that instances of plagiarism significantly decreased in their second essay; however, there was a modest overall improvement in cases of misinterpreted citations across the students who had low level of English proficiency. Implications for teaching citation skills in academic L2 writing contexts are discussed.},
	language = {en},
	number = {6},
	urldate = {2024-01-03},
	journal = {Instructional Science},
	author = {Al Harrasi, Kothar Talib Sulaiman},
	month = dec,
	year = {2023},
	keywords = {Promotion:01-02, 4.3.1 Literaturanalyse und KI-gestützte Methoden, Promotion:01-02 Methodenquellen, Promotion:Literaturverzeichnis},
	pages = {1079--1115},
	file = {Al Harrasi - 2023 - Developing a needs-based plagiarism management in .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/S9J7M9DT/Al Harrasi - 2023 - Developing a needs-based plagiarism management in .pdf:application/pdf},
}

@article{yondemir_caliskan_effect_2025,
	title = {The effect of cumulative eye movements’ guidance of experts on transition from novice to expert},
	volume = {73},
	issn = {1042-1629, 1556-6501},
	url = {https://link.springer.com/10.1007/s11423-024-10414-5},
	doi = {10.1007/s11423-024-10414-5},
	abstract = {Based on the assumptions of cognitive load theory, this study aims to utilize the eye movement data collected from multiple experts to scaffold novice graphic designers. The study has two main stages. In the first stage, eye tracking was used to record the eye movements of 7 experts, who covered eight topics explaining how to use Photoshop. The areas of interest and fixation durations were analyzed for each topic to extract the common patterns. Instructional videos were produced with the guidance of both eye movement patterns and multimedia design principles. In the second stage of this study, those videos were delivered to 30 university students. The experiment group watched the guided videos, whereas the control group watched straight videos, i.e., content without guidance. The guidance elements were reduced (faded) as students got familiar with the interface. All participants were assigned to perform tasks as soon as they completed the videos. The findings showed that the knowledge scores did not significantly differ between groups. Still, the average performance scores of the experiment group were considerably higher than that of the control group. Considering the transition process, the experiment group outperformed the others. The topics in which experts’ eye movements highly matched each other resulted in highperformance gaps among groups.},
	language = {en},
	number = {1},
	urldate = {2025-03-15},
	journal = {Educational technology research and development},
	author = {Yondemir Çalişkan, Neslihan and Şendurur, Emine},
	month = feb,
	year = {2025},
	keywords = {Promotion:01-02, Promotion:01-02 Methodenquellen, Promotion:Literaturverzeichnis},
	pages = {59--89},
	file = {Yondemir Çalişkan und Şendurur - 2025 - The effect of cumulative eye movements’ guidance of experts on transition from novice to expert:/Users/jochenhanisch-johannsen/Zotero/storage/7833VJTM/Yondemir Çalişkan und Şendurur - 2025 - The effect of cumulative eye movements’ guidance of experts on transition from novice to expert.pdf:application/pdf},
}

@incollection{bartimote_emotion_2024,
	address = {Cham},
	title = {Emotion {Theory} and {Learning} {Analytics}: {A} {Theoretical} {Framework} for {Capturing} {Emotion} {Regulation} {Using} {Process} {Data}},
	isbn = {978-3-031-60570-3 978-3-031-60571-0},
	shorttitle = {Emotion {Theory} and {Learning} {Analytics}},
	url = {https://link.springer.com/10.1007/978-3-031-60571-0_8},
	doi = {10.1007/978-3-031-60571-0_8},
	abstract = {Emotion regulation (ER) refers to the constant monitoring and modulating one’s dysfunctional emotion states and is essential for increasing learning outcomes with advanced learning technologies. Prior studies have typically captured ER using static instruments (e.g., self-reports) while little has focused on using various types of process data, including facial expressions of emotions, log files, screen recordings, physiology, verbalizations, and eye tracking. This possibly stems from the general lack of guidance for researchers on how to capture ER processes as individuals learn with advanced learning technologies. With an enormous increase in the access to process data for researchers, this chapter contributes to the field of learning analytics by reflecting on state-of-the-art methods and describing a theoretically-driven framework to study each phase of ER using process data. Specifically, this chapter extends McRae and Gross’ (2020) ER model by identifying modalities of data that represent different phases of ER. This framework lays the theoretical groundwork for how future studies should incorporate multimodal data to capture the ER process, increasing the accessibility and utility of leveraging process data to a range of stakeholders for capturing and identifying ER using learning analytics.},
	language = {en},
	urldate = {2025-01-01},
	booktitle = {Theory {Informing} and {Arising} from {Learning} {Analytics}},
	publisher = {Springer Nature Switzerland},
	author = {Dever, Daryn A. and Cloude, Elizabeth B. and Wiedbusch, Megan D. and Azevedo, Roger},
	editor = {Bartimote, Kathryn and Howard, Sarah K. and Gašević, Dragan},
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Promotion:01-02, Leraning:Analytics, Promotion:01-02 Methodenquellen, Promotion:S:15 Learning Analytics, Promotion:Literaturverzeichnis},
	pages = {125--137},
	file = {Dever et al. - 2024 - Emotion Theory and Learning Analytics A Theoretical Framework for Capturing Emotion Regulation Usin:/Users/jochenhanisch-johannsen/Zotero/storage/5DRE4YBU/Dever et al. - 2024 - Emotion Theory and Learning Analytics A Theoretical Framework for Capturing Emotion Regulation Usin.pdf:application/pdf},
}

@article{parker_negotiating_2024,
	title = {Negotiating {Meaning} with {Machines}: {AI}'s {Role} in {Doctoral} {Writing} {Pedagogy}},
	issn = {1560-4292, 1560-4306},
	shorttitle = {Negotiating {Meaning} with {Machines}},
	url = {https://link.springer.com/10.1007/s40593-024-00425-x},
	doi = {10.1007/s40593-024-00425-x},
	abstract = {This paper examines the integration of generative artificial intelligence (AI) in doctoral writing pedagogy. It explores how AI augments traditional teaching and composition processes, fosters a new paradigm of cognitive engagement and collaborative academic writing, and the broader ethical and social implications of human-AI writing in doctoral writing pedagogy. A community-engaged participatory research methodology was employed within a Doctor of Healthcare Administration program. Data were collected through discussion board messages, self-assessment papers, student reflections, and a focus group interview, and analyzed using thematic analysis. The research unearthed a hybrid humanAI writing process characterized by dynamic brainstorming, continuous negotiation of meaning, and comparative evaluation. These practices enhanced students’ cognitive and metacognitive engagement, confidence, and learner agency, signifying a shift toward a collaborative approach to academic writing. The findings highlight the need for academic institutions to adapt policies and curricula to incorporate AI technologies ethically and responsibly. Emphasis on AI literacy and academic integrity is crucial for preparing graduates for an AI-integrated workforce. This study contributes to the understanding of AI’s role in doctoral education, specifically doctoral writing development, presenting a novel perspective on the synergistic collaboration between students and AI in academic writing and its implications for institutional policies and writing pedagogy.},
	language = {en},
	urldate = {2024-12-11},
	journal = {International Journal of Artificial Intelligence in Education},
	author = {Parker, Jessica L. and Richard, Veronica M. and Acabá, Alexandra and Escoffier, Sierra and Flaherty, Stephen and Jablonka, Shannon and Becker, Kimberly P.},
	month = sep,
	year = {2024},
	keywords = {Promotion:01-02, 4.3.1 Literaturanalyse und KI-gestützte Methoden, Promotion:01-02 Methodenquellen, Promotion:Literaturverzeichnis, Promotion:sec:P-QIA, Promotion:sec:Methodenkritik-Absicherung, Promotion:sec:Erkenntnisinteresse, Promotion:chap:04-04, Promotion:chap:04-01},
	annote = {{\textless}!-- codex:methodenkritik:04-04 --{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Methodenkritik (Anschlussstelle: KI im Schreib-/Syntheseprozess, Integrität, institutionelle Leitplanken){\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}p{\textgreater}Der Beitrag positioniert den KI-Einsatz im Doktorandenschreiben als hybriden Prozess, der kognitiv/metakognitiv produktiv sein kann, aber unmittelbar Fragen der akademischen Integrität und der notwendigen AI-Literacy aufruft. Für mein Vorgehen ist das ein Argument, KI-Nutzung nicht stillschweigend als „normalen Workflow“ zu behandeln, sondern sie explizit als methodisch kontrollierten Teilprozess mit offengelegter Rolle zu führen. (Parker et al., 2024, S. 1){\textless}/p{\textgreater}{\textless}p{\textgreater}Gleichzeitig wird der Risikohorizont für akademisches Schreiben stark gemacht: Mit dem Konzept „postplagiarism“ wird beschrieben, dass hybride Human-KI-Texterzeugung neue Integritätsfragen aufwirft und klassische Grenzziehungen (Plagiat/Autorenschaft) verschiebt. Das unterstützt die Notwendigkeit, meine methodische Autorenschaft über Prüf- und Dokumentationslogiken sichtbar zu halten (Entscheidungsketten, Begründungen, Revisionen), statt KI-Outputs in die Argumentation zu „verstecken“. (Parker et al., 2024, S. 2){\textless}/p{\textgreater}{\textless}p{\textgreater}Sehr konkret wird zudem der Bedarf nach klaren Policies herausgestellt, die angemessene Nutzung demarkieren; fehlende/inkonsistente Kursregeln führen zu stark divergierenden Nutzungsstrategien. Das stützt in meiner Methodik die Entscheidung, Leitplanken (Do/Don’t, Offenlegung, Prüfroutinen) nicht implizit zu lassen, sondern als methodischen Standard festzuschreiben. (Parker et al., 2024, S. 13){\textless}/p{\textgreater}},
	file = {Parker et al. - 2024 - Negotiating Meaning with Machines AI's Role in Doctoral Writing Pedagogy:/Users/jochenhanisch-johannsen/Zotero/storage/6S432NV7/Parker et al. - 2024 - Negotiating Meaning with Machines AI's Role in Doctoral Writing Pedagogy.pdf:application/pdf},
}

@incollection{bartimote_theory_2024,
	address = {Cham},
	title = {Theory and {Intermediate}-{Level} {Knowledge} in {Multimodal} {Learning} {Analytics}},
	isbn = {978-3-031-60570-3 978-3-031-60571-0},
	url = {https://link.springer.com/10.1007/978-3-031-60571-0_6},
	doi = {10.1007/978-3-031-60571-0_6},
	abstract = {Advances in sensing technologies and computational analyses have demonstrated the potential to help us understand learning processes which were either not-possible to be captured or “too complex” for traditional analytics (e.g., eyetracking, temperature sensing, hear-rate sensing). This gave rise to the research space of Multimodal Learning Analytics (MMLA), which maintains Learning Analytics’ overarching goal of understanding and improving learning in all the different environments where it occurs, but also leverages advances in sensor technologies and computational analyses (e.g., sensor data processing, fusion, and analysis techniques). In this chapter, we introduce the reader to the field of MMLA and provide an overview of contemporary MMLA research. Moreover, we give an overview of theories used in MMLA and discuss the potential of MMLA to support the development of intermediate-level knowledge and how this knowledge, can be generated. To exemplify the importance and potential of intermediate-level knowledge in MMLA, we provide three examples on how knowledge that is more generative than an instantiation and yet not at the scope of generalized theory, manages to greatly advance MMLA research and practice.},
	language = {en},
	urldate = {2025-01-01},
	booktitle = {Theory {Informing} and {Arising} from {Learning} {Analytics}},
	publisher = {Springer Nature Switzerland},
	author = {Giannakos, Michail},
	editor = {Bartimote, Kathryn and Howard, Sarah K. and Gašević, Dragan},
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Promotion:01-02, Leraning:Analytics, Promotion:01-02 Methodenquellen, Promotion:S:15 Learning Analytics, Promotion:Literaturverzeichnis},
	pages = {87--104},
	file = {Giannakos - 2024 - Theory and Intermediate-Level Knowledge in Multimodal Learning Analytics:/Users/jochenhanisch-johannsen/Zotero/storage/2SZ9HLSF/Giannakos - 2024 - Theory and Intermediate-Level Knowledge in Multimodal Learning Analytics.pdf:application/pdf},
}

@article{siouti_emotions_2025,
	title = {Emotions in the {Qualitative} {Research} {Process}: {Introduction} to the {Special} {Issue}},
	volume = {26},
	copyright = {Copyright (c) 2025 Irini Siouti, Minna Kristiina Ruokonen - Engler},
