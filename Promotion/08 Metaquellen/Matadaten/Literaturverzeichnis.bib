@article{chaudhry_analyzing_2023,
	title = {Analyzing effect of fear and uncertainty avoidance on use behavior of learning management system: {Post} {COVID}-19 era},
	volume = {3},
	issn = {26670968},
	shorttitle = {Analyzing effect of fear and uncertainty avoidance on use behavior of learning management system},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2667096823000447},
	doi = {10.1016/j.jjimei.2023.100197},
	abstract = {This study examines the acceptance of mobile Learning Management Systems (LMS) in the telecom sector of Pakistan during the COVID-19 pandemic. The study employs the extended Unified Theory of Acceptance and Use of Technology (UTAUT2) to gain a deeper understanding of the factors that affect the acceptance of LMS among workers and how it is affected by the moderating impact of Fear of pandemic and uncertainty avoidance. Data were analyzed using Partial Least Squares (PLS) and Structural Equation Modeling (SEM). The results of this study indicate that social isolation, price value, and habitat have a significant impact on users’ LMS behavior. Additionally, user behavior is significantly influenced by behavioral intentions. The study also found that coronavirus fears can moderate the relationships between performance expectancy, effort expectancy, social influence, price value, and behavioral intentions. On the other hand, uncertainty avoidance moderates the relationship between performance expectancy, social influence, facilitating conditions, price value, and behav­ ioral intentions. This study highlights the importance of understanding user acceptance of LMS in order to improve work performance, save time, and eliminate costs. The findings of this study can be used by organi­ zations to develop strategies to increase the acceptance and usage of LMS in the workplace, especially in the context of the COVID-19 pandemic. The study also provides insight into how fear of COVID-19 and uncertainty avoidance can be taken into account when designing and implementing LMS.},
	language = {en-GB},
	number = {2},
	urldate = {2023-11-22},
	journal = {International Journal of Information Management Data Insights},
	author = {Chaudhry, Naveed Iqbal and Rehman, Shafique Ur and Elrehail, Hamzah and Masaeid, Turki Fahed Al and Adaileh, Raid and Alzoubi, Haitham M.},
	month = nov,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Technologieintegration, Bewertungsmethoden, Bildungstheorien, Promotion:Argumentation, \#1:Zeitschriftenartikel:learning:management:system, Krisenreaktion im Bildungsbereich, Lernsystemarchitektur, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {100197},
	annote = {1. Analyse der Studie "Analyzing effect of fear and uncertainty avoidance on use behavior of learning management system: Post COVID-19 era" von Chaudhry et al. (2023):
Diese Studie analysiert den Einfluss von Angst und Unsicherheitsvermeidung auf das Nutzungsverhalten von Lernmanagementsystemen (LMS) in der Telekommunikationsbranche Pakistans während der COVID-19-Pandemie. Der erweiterte Unified Theory of Acceptance and Use of Technology (UTAUT2) Modell wird verwendet, um den moderierenden Einfluss von Pandemieangst und Unsicherheitsvermeidung auf die Akzeptanz und Nutzung von LMS zu verstehen.
2. Zusammenfassung:
Die Studie ergab, dass soziale Isolation, Preiswert und Gewohnheit signifikante Auswirkungen auf das Verhalten der Nutzer gegenüber LMS haben. Zudem beeinflusst das Nutzungsverhalten signifikant die Verhaltensabsichten der Benutzer. Es wurde festgestellt, dass die Angst vor dem Coronavirus die Beziehungen zwischen Leistungserwartung, Anstrengungserwartung, sozialem Einfluss, Preiswert und Verhaltensabsichten moderiert, während Unsicherheitsvermeidung die Beziehungen zwischen Leistungserwartung, sozialem Einfluss, erleichternden Bedingungen, Preiswert und Verhaltensabsichten moderiert.
3. Kernaussagen anhand der Fundstellen:


Soziale Isolation und Preiswert (S. 6): Diese Faktoren haben einen signifikanten Einfluss auf das Verhalten der Benutzer, was darauf hinweist, dass die Nutzer den Wert des LMS erkennen und auch in isolierten Situationen das System nutzen.


Angst vor dem Coronavirus und Unsicherheitsvermeidung (S. 9): Diese Faktoren moderieren die Beziehungen zwischen verschiedenen UTAUT2-Variablen und Verhaltensabsichten, was auf die Notwendigkeit hinweist, psychologische Faktoren bei der Implementierung von Technologien zu berücksichtigen.


4. Argumentationslinien:


Einfluss psychologischer Faktoren: Die Ergebnisse unterstreichen die Bedeutung psychologischer Faktoren wie Angst und Unsicherheitsvermeidung, die das Akzeptanz- und Nutzungsverhalten von LMS während der COVID-19-Pandemie beeinflussen.


Bedeutung von sozialer Isolation: Die soziale Isolation erhöht die Notwendigkeit und Akzeptanz von LMS als Mittel zur Aufrechterhaltung der Produktivität und sozialen Interaktion.


5. Verschlagwortung:


Lernsystemarchitektur: Analyse der Anwendung und Akzeptanz von LMS in der Telekommunikationsbranche.


Bildungstheorien: Anwendung des UTAUT2-Modells zur Erklärung der Technologieakzeptanz unter Berücksichtigung psychologischer Faktoren.


Technologieintegration: Integration von LMS zur Bewältigung der Herausforderungen durch soziale Isolation und Pandemiebedingungen.


Bewertungsmethoden: Bewertung der Einflüsse von Angst und Unsicherheitsvermeidung auf die Technologieakzeptanz.


Krisenreaktion im Bildungsbereich: Untersuchung der Rolle von LMS in der Reaktion auf die COVID-19-Pandemie und die damit verbundene soziale Isolation.


},
	file = {Chaudhry et al. - 2023 - Analyzing effect of fear and uncertainty avoidance.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/TUHA7YNC/Chaudhry et al. - 2023 - Analyzing effect of fear and uncertainty avoidance.pdf:application/pdf},
}

@article{alfalah_factors_2023,
	title = {Factors influencing students’ adoption and use of mobile learning management systems (m-{LMSs}): {A} quantitative study of {Saudi} {Arabia}},
	volume = {3},
	issn = {26670968},
	shorttitle = {Factors influencing students’ adoption and use of mobile learning management systems (m-{LMSs})},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2667096822000866},
	doi = {10.1016/j.jjimei.2022.100143},
	language = {en-GB},
	number = {1},
	urldate = {2023-11-22},
	journal = {International Journal of Information Management Data Insights},
	author = {Alfalah, Adel Abdulmohsen},
	month = apr,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Bewertungsmethoden, Bildungstheorien, \#1:Zeitschriftenartikel:learning:management:system, Lernsystemarchitektur, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {100143},
	annote = {1. Analyse der Studie "Factors influencing students’ adoption and use of mobile learning management systems (m-LMSs): A quantitative study of Saudi Arabia" von Adel Abdulmohsen Alfalah:
Die Studie untersucht die Faktoren, die die Akzeptanz und Nutzung von mobilen Lernmanagementsystemen (m-LMS) durch Universitätsstudenten in Saudi-Arabien beeinflussen. Dabei wird eine erweiterte Version des UTAUT-Modells empirisch getestet. Die Studie nutzt eine Online-Umfrage mit 258 Teilnehmenden, um die Hypothesen zu überprüfen.
2. Zusammenfassung:
Die Ergebnisse zeigen, dass sechs der acht vorgeschlagenen Hypothesen unterstützt wurden. Performance Expectancy (PE), Effort Expectancy (EE) und Lecturers' Influence (LI) hatten signifikante Auswirkungen auf die Verhaltensabsicht der Studierenden, m-LMS zu nutzen. Die wahrgenommene Mobilitätswert (PMV) und die akademische Relevanz (AR) beeinflussten ebenfalls PE, während die Unterstützung durch das Universitätsmanagement (UMS) keinen signifikanten Einfluss auf PE hatte, aber einen auf EE.
3. Kernaussagen anhand der Fundstellen:


Einfluss der Leistungserwartung (PE): PE hatte einen signifikanten positiven Einfluss auf die Nutzungsabsicht der Studierenden (S. 3).


Einfluss der Anstrengungserwartung (EE): EE zeigte ebenfalls einen signifikanten Einfluss auf die Nutzungsabsicht (S. 3).


Einfluss der Dozenten (LI): LI beeinflusste die Nutzungsabsicht positiv, was die Bedeutung der Meinung und Unterstützung durch Dozenten unterstreicht (S. 3).


Einfluss von PMV und AR: Beide hatten signifikante positive Auswirkungen auf PE, was die Bedeutung der wahrgenommenen Mobilität und akademischen Relevanz der m-LMS hervorhebt (S. 3).


4. Argumentationslinien:


Akzeptanz und Nutzung: Die Studie bestätigt, dass die Akzeptanz und Nutzung von m-LMS stark von den Erwartungen an die Leistung und den Anstrengungen sowie vom Einfluss der Dozenten abhängt.


Rolle der Mobilität und Relevanz: Die Ergebnisse betonen die Bedeutung der Mobilität und der akademischen Relevanz als Schlüsselfaktoren, die die Wahrnehmung der Leistungserwartung beeinflussen.


Kein direkter Einfluss von UMS auf PE: Die Analyse zeigt, dass die Unterstützung durch das Universitätsmanagement zwar die Anstrengungserwartung beeinflusst, aber keinen direkten Einfluss auf die Leistungserwartung hat.


5. Verschlagwortung:


Lernsystemarchitektur: Diskussion der Nutzung von m-LMS und deren Integration in den Bildungsprozess.


Bildungstheorien: Anwendung des erweiterten UTAUT-Modells zur Erklärung der Technologieakzeptanz.


Lehr- und Lerneffektivität: Einfluss von Dozenten und wahrgenommene Leistung auf die Nutzung von m-LMS.


Technologieintegration: Integration von mobilen Technologien in den Lernprozess und deren Einfluss auf das Lernverhalten.


Bewertungsmethoden: Untersuchung der Faktoren, die die Verhaltensintention zur Nutzung von m-LMS beeinflussen.


},
	file = {Alfalah - 2023 - Factors influencing students’ adoption and use of .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/MJP4SKA4/Alfalah - 2023 - Factors influencing students’ adoption and use of .pdf:application/pdf},
}

@article{choo_abrupt_2023,
	title = {Abrupt academic dishonesty: {Pressure}, opportunity, and deterrence},
	volume = {21},
	issn = {14728117},
	shorttitle = {Abrupt academic dishonesty},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1472811723000538},
	doi = {10.1016/j.ijme.2023.100815},
	abstract = {The first objective of this study was to explore whether students would be involved in abrupt academic dishonesty (AAD) at high levels of perceived pressure and low levels of perceived op­ portunities to cheat. We used Cusp R software to fit a cusp catastrophe model to the student cheating data. We found that students involved in AAD experienced high/low levels of perceived pressure/opportunity to cheat. The findings yield valuable insights into how the complex and nonlinear forces of perceived pressure and opportunity push students towards AAD in the classroom. The second objective was to design an original low-effort warning post (WP) in learning management systems and test whether it would reduce AAD based on the perceived psychological costs of being exposed (i.e., being reported to the Office of Student Conduct). We found that WP significantly reduced AAD, thereby contributing to an original deterrence of AAD in the classroom.},
	language = {en-GB},
	number = {2},
	urldate = {2023-11-22},
	journal = {The International Journal of Management Education},
	author = {Choo, Freddie and Tan, Kim},
	month = jul,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Bewertungsmethoden, Bildungstheorien, Promotion:Argumentation, \#1:Zeitschriftenartikel:learning:management:system, Krisenreaktion im Bildungsbereich, Lernsystemarchitektur, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {100815},
	annote = {1. Analyse der Studie "Abrupt academic dishonesty: Pressure, opportunity, and deterrence" von Choo und Tan (2023):
Diese Studie untersucht das plötzliche Auftreten von akademischer Unehrlichkeit unter Studierenden und verwendet dazu das Cusp-Katastrophenmodell. Es werden die Effekte von wahrgenommenem Druck und Gelegenheiten betrachtet und wie diese zusammen mit Abschreckungsmaßnahmen das Verhalten von Studierenden in akademischen Umgebungen beeinflussen.
2. Zusammenfassung:
Die Forschung zeigt, dass erhöhter Druck und Gelegenheiten zu betrügen zu abrupter akademischer Unehrlichkeit führen können. Eine innovative Maßnahme in Form eines "Low-Effort Warning Post" in Lernmanagementsystemen wurde entwickelt und getestet, um zu sehen, ob sie das Verhalten von Studierenden beeinflusst. Die Studie fand heraus, dass diese Warnungen die Häufigkeit von betrügerischem Verhalten signifikant reduzieren.
3. Kernaussagen anhand der Fundstellen:


Einfluss von Druck und Gelegenheit: Der wahrgenommene Druck und die wahrgenommenen Gelegenheiten beeinflussen signifikant das Auftreten von abrupter akademischer Unehrlichkeit. Der Druck wirkt dabei als "Splitting Variable" und die Gelegenheit als "Asymmetry Variable" im Cusp-Katastrophenmodell (S. 2-3).


Wirksamkeit der Abschreckung: Der "Low-Effort Warning Post" reduzierte die Häufigkeit von betrügerischem Verhalten erheblich, was auf die Wirksamkeit psychologischer Kosten als Abschreckung hinweist (S. 5).


4. Argumentationslinien:


Modellierung des Verhaltens: Die Verwendung des Cusp-Katastrophenmodells zur Erklärung abrupter Verhaltensänderungen unterstreicht die Komplexität der Faktoren, die zu akademischer Unehrlichkeit führen.


Abschreckung durch minimale Anstrengung: Die Einführung einfacher, aber effektiver Abschreckungsmaßnahmen in Lernmanagementsystemen könnte eine praktikable Strategie zur Verringerung von Betrugsfällen in akademischen Institutionen darstellen.


5. Verschlagwortung:


Lernsystemarchitektur: Untersuchung der Integration von Abschreckungsmaßnahmen in Lernmanagementsysteme zur Prävention von akademischer Unehrlichkeit.


Bildungstheorien: Anwendung des Cusp-Katastrophenmodells zur Analyse des Verhaltens von Studierenden unter Druck und bei Gelegenheiten zum Betrug.


Bewertungsmethoden: Analyse der Effektivität von Warnmeldungen als Abschreckungsmethode zur Reduzierung von akademischer Unehrlichkeit.


Krisenreaktion im Bildungsbereich: Betrachtung der Reaktion auf akademische Unehrlichkeit unter dem Druck von Leistungsanforderungen und Gelegenheiten.


},
	file = {Choo und Tan - 2023 - Abrupt academic dishonesty Pressure, opportunity,.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/WQ3JUHEK/Choo und Tan - 2023 - Abrupt academic dishonesty Pressure, opportunity,.pdf:application/pdf},
}

