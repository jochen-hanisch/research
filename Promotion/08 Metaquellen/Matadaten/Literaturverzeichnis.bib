	urldate = {2025-02-15},
	publisher = {Universitätsverlag Kiel {\textbar} Kiel University Publishing},
	author = {Brandt, Luisa},
	editor = {Welter, Nicole and Wilder, Nicolaus},
	month = feb,
	year = {2025},
	keywords = {Promotion:Literaturverzeichnis},
	annote = {{\textless}div class="codex-extract"{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Quelle (PDF):{\textless}/strong{\textgreater} /Users/jochenhanisch-johannsen/Zotero/storage/RLM7T7U5/Brandt - 2025 - Zur Internalisierung sexistischer Normen im Kontext cis-weiblicher Subjektivierungsprozesse.pdf{\textless}/p{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Extrakte (Treffer auf Muster):{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}ol{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 8{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}chen-Machen des Mädchens ist mit dieser einen Anrufung noch nicht abgeschlossen,sondern »wird von den verschiedensten Autoritäten und über diverse Zeitabschnittehinweg immer aufs Neue wiederholt, um die naturalisierte Wirkung zu verstärken oderanzufechten. Das Benennen setzt zugleich eine Grenze und wiederholt einschärfendeine Norm« (Butler 1995, S. 29). Das Subjekt ist nicht Urheber und Schöpfer der Dinge,{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 9{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}hand von Mayrings qualitativer Inhaltsanalyse bestimmt wurden und auch wichtigeTeilerkenntnisse zur Beantwortung der Forschungsfrage liefern. Es zeigt sich, dass dieSchilderungen der Befragten den theoretischen Ausführungen zur Definition und zuErscheinungsformen von Sexismus in hohem Maße entsprechen. Zudem verdeutlich-ten die Ergebnisse, mit welchen sexistischen Normen sich die befragte Gruppe kon-{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 10{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}chen: Die Verfasserin wählt den Begriff der »Normativitätsverschiebung« (S. 90), derzeigt, dass es zwar möglich scheint, sich von einzelnen Normen zu distanzieren, nichtaber von der Wirkung normativer Anforderungen insgesamt. Luisa Brandt legt mit dieser Arbeit eine beeindruckende, inspirierende und theoretischsowie empirisch anschlussfähige Ausarbeitung vor, die auf hohem Niveau überzeugt.{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 12{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}im Schatten und unter der Unterdrückung weiblicher Barbies leben. Die Frage danach,was unter Sexismus zu verstehen ist, wird im öffentlichen Diskurs häufig vernachläs-sigt. Auch wissenschaftlich gibt es keine einheitliche Definition des Begriffs. Sexismuskann verstanden werden als Ideologie einer patriarchalen Ordnung, deren allgemeineFunktion darin besteht, patriarchale Sozialbeziehungen zu rationalisieren und zu recht-{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 12{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}was unter Sexismus zu verstehen ist, wird im öffentlichen Diskurs häufig vernachläs-sigt. Auch wissenschaftlich gibt es keine einheitliche Definition des Begriffs. Sexismuskann verstanden werden als Ideologie einer patriarchalen Ordnung, deren allgemeineFunktion darin besteht, patriarchale Sozialbeziehungen zu rationalisieren und zu recht-fertigen (Manne 2020, S. 144). Näher wird der Begriff im theoretischen Teil dieser Arbeit{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 12{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}2 Sozialisation bezeichnet den »Prozess, in dem der Mensch in die ihn umgebende Gesellschaft […] hin- einwächst und zugleich zu einem eigenverantwortlich und eigensinnig handlungsfähigen Subjekt wird.« (Peuckert \&amp; Scherr 2010, S. 268). In ihren Anfängen wurde dem Subjekt in der Sozialisationstheorie eine{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 14{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}von Ermöglichung und Begrenzung findet sich sowohl in Erziehungs- als auch in Sub-jektivierungsprozessen, die miteinander zusammenhängen und als Teile voneinanderverstanden werden können. Zentrale Aufgabe pädagogischer Bestrebungen ist es, dieseAmbivalenz zu moderieren. Erziehung soll in diesem Sinne vermitteln zwischen demAnspruch der Individuen auf eine Existenz als eigenständige, handlungsmächtige Sub-{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 14{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}schlechterordnung nicht nur als strukturbildendes Moment der Gesellschaft, sondernauch als »strukturbildendes Moment in der Erziehungswissenschaft« (Baader \&amp; Rend-torff 2024, S. 18) verstanden werden. Daher ist eine subjekttheoretische Betrachtungvon Geschlecht, wie sie diese Arbeit mit der Untersuchung von Internalisierungsprozes-sen sexistischer Normen (verstanden als Mittel geschlechtsspezifischer Gesellschafts-{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 14{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}torff 2024, S. 18) verstanden werden. Daher ist eine subjekttheoretische Betrachtungvon Geschlecht, wie sie diese Arbeit mit der Untersuchung von Internalisierungsprozes-sen sexistischer Normen (verstanden als Mittel geschlechtsspezifischer Gesellschafts-strukturierung) anstrebt, pädagogisch relevant. Aus den bisherigen Ausführungen ergibt sich folgende Fragestellung, die im Rahmen{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 15{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}an ein Verständnis von Sexismus als spezifischer Machtstruktur herangeführt (5.2). Eswird zudem beleuchtet, dass Sexismus in verschiedenen Formen erscheint (5.3). Kapi-tel 5.4 erläutert, was in dieser Arbeit unter sexistischen Normen verstanden wird und wiediese mit Geschlechtsstereotypen zusammenhängen. Den theoretischen Teil abschließendwerden in Kapitel 6 die zuvor beschriebenen theoretischen Aspekte zusammengeführt,{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 16{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}dekonstruieren. So schreibt Micus-Loos (2004, S. 122):  »[Dem] Unvermögen, genau zu definieren, was eine ›Frau‹ ist, steht die Notwendig- keit gegenüber, diese analytische Kategorie anzuerkennen: Solange das Geschlech- terverhältnis ein soziales Ungleichheitsverhältnis ist, solange Menschen sich als{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 16{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}An dieser Stelle soll betont werden, dass Geschlecht und Geschlechtskategorienin der vorliegenden Arbeit als sozial konstruiert und nicht als natürlich gegeben ver-standen werden. ›Frau‹ und ›Mann‹ werden verstanden als soziale Positionen (Roig2023, S. 34). Wenn hier vom Geschlecht von Personen die Rede ist, von weiblichen,männlichen oder nicht-binären Personen, dann bezieht sich dies auf die eigene Identi-{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 17{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}bedeutet etymologisch »diesseitig« oder »übereinstimmend« (Fütty 2019, S. 39). Es handeltsich dabei um ein aktivistisches Konzept, das akademisch übernommen wurde (ebd.;Hornscheidt 2012, S. 115). Der Begriff cis-geschlechtlich bezeichnet Menschen, bei denendie gefühlte und gelebte Geschlechtsidentität mit dem Geschlechtseintrag in der Geburts-urkunde übereinstimmt. Die Verwendung des Präfixes ›cis-‹ stellt eine Schwerpunktver-{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 17{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}3 Trans* bezeichnet Personen, deren Geschlechtsidentität nicht mit dem Geschlechtseintrag in der Geburts- urkunde übereinstimmt (vgl. Fütty 2019, S. 17).4 Inter* bezeichnet Personen, deren genetische, anatomische und/oder hormonelle Geschlechtsmerkmale{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 17{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}3 Trans* bezeichnet Personen, deren Geschlechtsidentität nicht mit dem Geschlechtseintrag in der Geburts- urkunde übereinstimmt (vgl. Fütty 2019, S. 17).4 Inter* bezeichnet Personen, deren genetische, anatomische und/oder hormonelle Geschlechtsmerkmale von Geburt an nicht den Geschlechternormen von Mann oder Frau entsprechen (vgl. Intersexuelle Men- schen e. V. 2020).{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 18{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}Individuum (Reckwitz 2016, S. 125).  »Subjektivierung meint den permanenten Prozess, in dem Gesellschaften und Kul- turen die Individuen in Subjekte umformen, sie damit zu gesellschaftlich zurechen- baren, auf ihre Weise kompetenten, mit bestimmten Wünschen und Wissensformen{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 18{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}In diesem Prozess unterwerfen sich die Individuen gesellschaftlichen Strukturen undin dieser Unterwerfung werden sie zu sozial als autonom anerkannten Subjekten. DerSubjektbegriff beinhaltet also eine Doppeldeutigkeit: er bezeichnet eine agierende, auto-nome Instanz und etwas Unterworfenes (ebd., S. 126). »Das Subjekt wird demnachin einem ambivalenten Sinne über eine Entmächtigungsbewegung ermächtigt« (Färber{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 18{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}In dieser Arbeit wird der Subjektivierungsbegriff in der Tradition von Louis Althusser(1977), Michel Foucault (1979, 1987, 1997, 2021) und Judith Butler (1995, 2001, 2021)verstanden, die auf die grundlegende Abhängigkeit der Subjekte von der bestehendenOrdnung verweisen und die Bedeutung dieser Abhängigkeit in Bezug auf Handlungs-fähigkeit, Freiheit und Selbstbewusstsein kritisch diskutieren (Färber 2022, S. 23). Da-{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 19{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}(Althusser 1977, S. 142) ein. Althussers Subjektivierungskonzeption entstand im Rah-men seiner Theorie der Ideologie (ebd., S. 130 ff.). Ideologie bezeichnet nach dieser Theorie ein System von Ideen und Vorstellungen,welches das Bewusstsein eines Menschen oder einer gesellschaftlichen Gruppe be-herrscht. Die Ideologie ist es, die Individuen als konkrete Subjekte anruft. Auf diese{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 21{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}Kraftverhältnisse aneinander finden, indem sie sich zu Systemen verketten – oder die Verschiebungen und Widersprüche, die sie gegeneinander isolieren; und schließlich die Strategien, in denen sie zur Wirkung gelangen und deren große Linien und institutionelle Kristallisierungen sich in den Staatsapparaten, in der Gesetzgebung und in den gesellschaftlichen Hegemonien verkörpern«{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}/ol{\textgreater}{\textless}/div{\textgreater}},
	file = {Brandt - 2025 - Zur Internalisierung sexistischer Normen im Kontext cis-weiblicher Subjektivierungsprozesse:/Users/jochenhanisch-johannsen/Zotero/storage/RLM7T7U5/Brandt - 2025 - Zur Internalisierung sexistischer Normen im Kontext cis-weiblicher Subjektivierungsprozesse.pdf:application/pdf},
}

@article{gruning_funfdimensionale_2022,
	title = {Fünfdimensionale überarbeitete {Neugier}-{Skala} ({5DCR})},
	url = {https://zis.gesis.org/DoiId/zis320_exz},
	doi = {10.6102/ZIS320_EXZ},
	abstract = {Die überarbeitete fünfdimensionale Neugier-Skala (5DCR) von Kashdan et al. (2020) ist das umfangreichste bisher verfügbare Neugier-Inventar. Die 5DCR misst sechs Facetten der Neugier mit jeweils vier Items: Enthusiasmus zu erkunden, Deprivationsintoleranz, Stresstoleranz, generelle soziale Neugier, spezielle soziale Neugier, Suche nach Nervenkitzel. Die Skala wurde ins Deutsche adaptiert und an der deutschsprachigen Bevölkerung (N = 485; Grüning \&amp; Lechner, 2022) validiert. Die Reliabilität der sechs Facetten des 5DCR, die faktorielle Validität sowie die konvergente und diskriminante Validität wurden bestätigt. Das Instrument zeigt mindestens teilweise skalare Messinvarianz über Alter, Geschlecht, Bildung und verschiedene Länder (d.h. im Vergleich mit dem Vereinigten Königreich).},
	language = {de-DE},
	urldate = {2024-03-25},
	journal = {Zusammenstellung sozialwissenschaftlicher Items und Skalen (ZIS)},
	publisher = {[object Object]},
