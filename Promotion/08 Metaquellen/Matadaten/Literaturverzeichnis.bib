	keywords = {\#7:Buchteil:digital:Medien, Promotion:Literaturanalyse, Bildung, Multimedia, Kompetenz, FernUni-Hagen:MABM:M7C, Grounded Theory, Lehrer*innenbildung, Promotion:S:07 Digitale Medien, Promotion:Literaturverzeichnis},
	file = {paulus_et_al_2021_perspektiven_von_angehenden_lehrpersonen_auf_padagogische_medienkompetenzen_in.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/WH55WGVW/paulus_et_al_2021_perspektiven_von_angehenden_lehrpersonen_auf_padagogische_medienkompetenzen_in.pdf:application/pdf},
