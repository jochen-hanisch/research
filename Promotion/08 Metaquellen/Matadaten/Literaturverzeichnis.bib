	url = {https://link.springer.com/10.1007/978-3-031-34738-2_11},
	doi = {10.1007/978-3-031-34738-2_11},
	abstract = {One of the major challenges for evaluating the effectiveness of data visualizations and visual analytics tools arises from the fact that different users may be using these tools for different tasks. In this chapter, we present a simple example of how different tasks lead to different patterns of attention to the same underlying data visualizations. The experiment used eye tracking to record where people looked in scatterplot visualizations when given different tasks. We argue that the general approach used in this experiment could be applied systematically to task and feature taxonomies that have been developed by visualization researchers. Using eye tracking to study the impact of common tasks on how humans attend to common types of visualizations will support a deeper understanding of visualization cognition and the development of more robust methods for evaluating the effectiveness of visualizations.},
	language = {en},
	urldate = {2023-11-18},
