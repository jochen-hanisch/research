	year = {2020},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Depression, Anxiety, Attention deficit disorders, Aufmerksamkeits-Defizit-Hyperaktivitäts-Störung, Verhaltensstörung, Angst, Educational achievement, School achievement, Schulleistung, Promotion:S:11 Online Learning, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
