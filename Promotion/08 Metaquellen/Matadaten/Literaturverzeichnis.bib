	file = {Offergeld et al. - 2021 - „Ab morgen bitte online“ Vergleich digitaler Rahm.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/E9V8BZKN/Offergeld et al. - 2021 - „Ab morgen bitte online“ Vergleich digitaler Rahm.pdf:application/pdf},
