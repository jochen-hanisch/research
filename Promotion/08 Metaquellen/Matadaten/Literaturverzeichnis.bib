  keywords = {0:Zeitschriftenartikel:digital:learning,Baden-Wurtemberg,Baden-Wurttemberg,Baden-Württemberg,Bildung,Charité:Promotion,Content analysis,Datenerhebung,Digitalisierung,Digitalization,Förderprogramm,Hochschule,Hochschullehre,Inhaltsanalyse,Innovationsprozess,Kategorie,Leitfadeninterview,Nachhaltigkeit,Project,Projects (Learning Activities),Projekt,Promotion:Literaturanalyse,Remedial Programs,Studie,Sustainability,System,Tutorial programs,University lecturing,University teaching},
