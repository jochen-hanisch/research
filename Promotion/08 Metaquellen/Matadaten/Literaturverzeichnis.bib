	month = dec,
	year = {2022},
	keywords = {Promotion:Literaturanalyse, Promotion:Kerngedanke, Technologieintegration, Systemanpassung, Bildung, Multimedia, Promotion:FU3, \#9:Zeitschriftenartikel:digital:lernen, Promotion:S:09 Digital Lernen, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	annote = {Forschungsfragen
Hauptforschungsfrage „Wie ist das Wirkgefüge des angewendeten Learning-Management-Systems auf Akteure im digitalen Bildungsraum von Gesundheitsberufen gestaltet?“
Zuordnung der Quelle zu den spezifischen Forschungsfragen


