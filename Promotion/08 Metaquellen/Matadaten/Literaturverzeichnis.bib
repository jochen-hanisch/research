	editor = {Iliadis, Lazaros and Papaleonidas, Antonios and Angelov, Plamen and Jayne, Chrisina},
	year = {2023},
	doi = {10.1007/978-3-031-44198-1_35},
	note = {Series Title: Lecture Notes in Computer Science},
	keywords = {Charité:Promotion, Promotion:Literaturanalyse, \#0:Buchteil:digital:learning, Promotion:S:12 Digital Learning, Promotion:Literaturverzeichnis},
	pages = {419--431},
	file = {Li und Yang - 2023 - Joint Demosaicing and Denoising with Frequency Dom.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/4PD7SPMV/Li und Yang - 2023 - Joint Demosaicing and Denoising with Frequency Dom.pdf:application/pdf},
