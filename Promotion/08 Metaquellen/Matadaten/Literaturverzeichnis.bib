	keywords = {Charité:Promotion, Promotion:Literaturanalyse, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Technologieintegration, Promotion:FU2a, Systemanpassung, Promotion:Weiterführung, \#1:Zeitschriftenartikel:learning:management:system, Promotion:Relevanz:3, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
