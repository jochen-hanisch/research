@article{zainal_hubungan_2024,
	title = {Hubungan antara {Kemahiran} {Sosial} dan {Pembelajaran} {Secara} {Kolaboratif} dalam {Talian} di {Kalangan} {Pelajar} {UTHM}},
	volume = {5},
	abstract = {Online learning has evolved into a transformative approach, offering benefits such as enhanced accessibility and a flexible learning experience. Educational institutions welcome this innovative method for teaching and learning (PdP) purposes. However, there are some issues that result from the lack of in-person engagement, which hinders the growth of interpersonal skills, and technological obstacles, which cause disparities, underline the limitations of the method, emerge as an urgent problem statement. The challenge lies in finding a harmonious balance between the advantages of online learning, such as enhanced accessibility and flexible learning experiences, and the critical need for face-to-face interaction that fosters interpersonal skills. Additionally, addressing technological barriers becomes essential to ensure a more equitable and inclusive educational landscape. Despite these obstacles, the adaptability of online learning is particularly evident in times of crisis, requiring a balanced perspective to fully exploit its potential for effective and inclusive education. Therefore, The purpose of this study is to determine the social skills and online collaborative learning usage levels of UTHM students, as well as to investigate the correlation between these factors. Using online surveys and questionnaires, Universiti Tun Hussein Onn Malaysia (UTHM) obtained data from 203 respondents for quantitative study. Using the Statistical Package for Social Science (SPSS), the quantitative data will be analysed and the results will be presented as frequency, percentage, mean, and standard deviation. Notably, there is a substantial link between all the factors with social skills, with the highest correlation coefficient observed in the interaction aspect, reaching 0.904.},
	language = {ms-MY},
	number = {1},
	journal = {Research in management of technology and business},
	author = {Zainal, Nur Sabrina and Salim, Siti Aisyah},
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Promotion:FU2a, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	annote = {Hier ist die Analyse der Studie "Hubungan antara Kemahiran Sosial dan Pembelajaran Secara Kolaboratif dalam Talian di Kalangan Pelajar UTHM" von Nur Sabrina Zainal und Siti Aisyah Salim (2024):
Hauptthemen und Ziele der Forschung
Die Studie untersucht die Beziehung zwischen sozialen Fähigkeiten und dem Einsatz von Online-Kollaborativem Lernen unter Studierenden der Universiti Tun Hussein Onn Malaysia (UTHM). Ziel ist es, den Einfluss von sozialen Fähigkeiten auf das Engagement in Online-Kollaborationen zu ermitteln und zu bewerten, wie diese Fähigkeiten die Effektivität des Online-Lernens beeinflussen​.
Methoden und Datenquellen


Methoden: Die Studie verwendet eine quantitative Forschungsmethode, bei der Daten durch Online-Umfragen gesammelt werden. Die Umfragen beinhalten strukturierte Fragebögen, die Fragen zu sozialen Fähigkeiten und zur Nutzung von Online-Kollaborationsmethoden enthalten. Die Datenanalyse erfolgt mithilfe des Statistical Package for the Social Sciences (SPSS), das zur Berechnung von Häufigkeiten, Mittelwerten und Standardabweichungen verwendet wird​.


Datenquellen: Die Daten stammen von 203 Studierenden der Universiti Tun Hussein Onn Malaysia. Die Teilnehmer wurden zufällig aus verschiedenen Bildungsstufen ausgewählt, um eine repräsentative Stichprobe zu gewährleisten​.


Zentrale Forschungsergebnisse


Starke Korrelation: Es wurde eine signifikante positive Korrelation zwischen sozialen Fähigkeiten und der Nutzung von Online-Kollaborationen festgestellt. Insbesondere zeigte sich, dass Kommunikations- und Interaktionsfähigkeiten stark mit der Effektivität von Online-Kollaborationen korrelieren, mit einem Korrelationskoeffizienten von bis zu 0.904​.


Einfluss von sozialen Fähigkeiten: Soziale Fähigkeiten verbessern das Engagement und die Beteiligung der Studierenden in Online-Lernszenarien, indem sie den Austausch und die Zusammenarbeit erleichtern​.


Hindernisse und Herausforderungen: Technologische Barrieren und das Fehlen von Präsenzinteraktionen wurden als Hindernisse identifiziert, die das Potenzial von Online-Lernen einschränken können​.


Zusammenfassung
Die Studie analysiert den Einfluss von sozialen Fähigkeiten auf das Online-Kollaborative Lernen unter UTHM-Studierenden. Die Ergebnisse zeigen, dass soziale Fähigkeiten entscheidend für den Erfolg von Online-Kollaborationen sind, da sie die Kommunikation und das Engagement in Online-Lernumgebungen verbessern. Technologische Herausforderungen bleiben jedoch ein Hindernis, das überwunden werden muss, um das volle Potenzial des Online-Lernens auszuschöpfen.
Kernaussagen


Bedeutung sozialer Fähigkeiten: Soziale Fähigkeiten sind entscheidend für den Erfolg von Online-Kollaborationen, da sie die Kommunikation und das Engagement der Studierenden fördern​.


Technologische Barrieren: Herausforderungen wie technische Probleme und der Mangel an persönlichem Kontakt können die Effektivität von Online-Lernumgebungen einschränken​.


Argumentationslinien
Die Autoren argumentieren, dass soziale Fähigkeiten im Kontext des Online-Lernens eine zentrale Rolle spielen, um effektive Kollaborationen zu ermöglichen. Sie betonen, dass Bildungseinrichtungen Strategien entwickeln sollten, um soziale Fähigkeiten zu fördern und technologische Barrieren zu überwinden, um das Potenzial von Online-Lernumgebungen voll auszuschöpfen​.
Verschlagwortung


Kollaboratives Lernen: Die Studie untersucht die Rolle von sozialen Fähigkeiten im kollaborativen Online-Lernen.


Technologieintegration: Die Untersuchung hebt die Bedeutung der Integration digitaler Tools zur Unterstützung von Kollaborationen hervor.


Lehr- und Lerneffektivität: Es wird gezeigt, wie soziale Fähigkeiten die Effektivität von Lehr- und Lernprozessen in Online-Umgebungen steigern können.


Kategorisierung
Kerngedanke: Die Studie beleuchtet die wesentliche Rolle sozialer Fähigkeiten für den Erfolg von Online-Kollaborationen und zeigt auf, wie diese Fähigkeiten die Effektivität von Online-Lernumgebungen beeinflussen​.
Zuordnung zur Forschungsfrage


FU2a: Die Studie untersucht die Effekte sozialer Fähigkeiten im digitalen Bildungsraum und deren Einfluss auf kollaborative Lernprozesse​.


Relevanzbewertung


5 - Hoch relevant: Die Studie bietet umfassende Einblicke in die Rolle sozialer Fähigkeiten im Online-Lernen und ist direkt relevant für die Förderung von kollaborativen Lernprozessen in digitalen Umgebungen.


Diese Analyse bietet wertvolle Einsichten in die Bedeutung sozialer Fähigkeiten für den Erfolg von Online-Kollaborationen und die Herausforderungen, die es zu bewältigen gilt, um die Effektivität von Online-Lernumgebungen zu maximieren.
},
	file = {Zainal und Salim - 2024 - Hubungan antara Kemahiran Sosial dan Pembelajaran .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/2R5C4GPF/Zainal und Salim - 2024 - Hubungan antara Kemahiran Sosial dan Pembelajaran .pdf:application/pdf},
}

@article{egloffstein_evidence-based_2024,
	title = {Evidence-based development of online learning resources on {Artificial} {Intelligence} in vocational education and training: {Stakeholder} perspectives and implementation},
	volume = {38},
	issn = {09315020},
	shorttitle = {Evidence-based development of online learning resources on {Artificial} {Intelligence} in vocational education and training},
	url = {https://www.vep-landau.de/produkt/empirische-paedagogik-2024-38-1-kap-5-digital/},
	doi = {10.62350/DGOP8196},
	abstract = {This article describes the evidence-based development of online learning resources on Artificial Intelligence (AI) in vocational education and training. Within the target group and context analysis of the AI\_VET project, guided interviews with N = 48 stakeholders from vocational education and training were conducted and analyzed. The results reveal an ambiguous and rather superficial understanding of AI within the target group as well as a limited incorporation of AI into vocational practice despite a broad consensus regarding its increasing relevance. Recommendations for the design of online learning resources include a focus on AI basics to promote a foundational understanding, consideration of opportunities, risks and limitations in professional contexts, and the use of specific application examples. Building on this, the AI\_VET course series was implemented through a participatory approach. Initial evaluation results suggest differentiated usage of the course modules and acceptance among learners. The article concludes with a discussion of implications for the further integration of AI in vocational education and training, as well as the positioning of the developed offerings in AI education.
          , 
            Künstliche Intelligenz (KI) in der beruflichen Bildung. Im Rahmen der Zielgruppen- und Kontextanalyse des Projekts AI\_VET wurden leitfadengestützte Interviews mit N = 48 Stakeholder*innen aus der beruflichen Bildung durchgeführt und ausgewertet. Die Ergebnisse zeigen ein diffuses und eher oberflächliches Verständnis von KI innerhalb der Zielgruppe sowie eine mangelnde Verankerung von KI in der beruflichen Praxis, trotz eines breiten Konsenses hinsichtlich ihrer zunehmenden Relevanz. Konkrete Impulse für die Gestaltung von onlinebasierten Lernangeboten sind die Ausrichtung auf KI-Grundlagen, die Auseinandersetzung mit Chancen, Risiken und Limitationen in beruflichen Kontexten sowie die Nutzung konkreter Anwendungsbeispiele. Auf dieser Basis wurde die Kursreihe AI\_VET in einem partizipativen Ansatz implementiert. Erste Evaluationsergebnisse deuten auf eine differenzierte Nutzung der Kursbausteine sowie auf Akzeptanz von Seiten der Lernenden hin. Implikationen für die weitere Verankerung von KI in der beruflichen Bildung sowie die Einordnung der Angebote in den Kontext der KI-Bildung werden diskutiert.},
	language = {de-DE},
	number = {1},
	urldate = {2024-07-31},
	journal = {Empirische Pädagogik},
	author = {Egloffstein, Marc and Kögler, Kristina and Ifenthaler, Dirk},
	month = jun,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Technologieintegration, Bewertungsmethoden, Promotion:Weiterführung, Promotion:FU4b, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU4b},
	pages = {98--117},
	annote = {Analyse der Studie "Evidenzgestützte Entwicklung von onlinebasierten Lernangeboten zu Künstlicher Intelligenz in der beruflichen Bildung" von Marc Egloffstein, Kristina Kögler und Dirk Ifenthaler
1. Analyse
Hauptthemen und Ziele der Forschung:
Die Studie untersucht die Entwicklung von Online-Lernangeboten im Bereich Künstliche Intelligenz (KI) in der beruflichen Bildung. Ziel ist es, evidenzbasierte Bildungsressourcen zu entwickeln, die den Anforderungen und Erwartungen verschiedener Stakeholder gerecht werden. Die Autoren beleuchten die Notwendigkeit, KI in die berufliche Bildung zu integrieren, um den wachsenden Qualifikationsbedarf im digitalen Zeitalter zu decken. Der Beitrag konzentriert sich auf die Analyse von Perspektiven der beteiligten Stakeholder und die Umsetzung der gewonnenen Erkenntnisse in die Kursgestaltung​.
Methoden und Datenquellen:


Methoden: Die Studie nutzt qualitative Interviews mit 48 Stakeholdern aus der beruflichen Bildung, darunter Lehrpersonen, Ausbildende und Studierende. Diese Interviews wurden mit einem deduktiv-induktiven Ansatz analysiert, um die Vorstellungen und Bedürfnisse der Teilnehmer hinsichtlich KI in der Bildung zu verstehen​​.


Datenquellen: Die Daten wurden an den Universitäten Mannheim und Stuttgart im Rahmen des AI\_VET-Projekts gesammelt. Die Analyse konzentrierte sich auf die Kenntnisse und Erwartungen der Stakeholder sowie auf die aktuellen Herausforderungen bei der Implementierung von KI in der beruflichen Bildung​.


Zentrale Forschungsergebnisse:


Verständnis und Relevanz von KI: Die Befragten zeigten ein uneinheitliches Verständnis von KI, das von oberflächlichen Definitionen bis zu spezifischen Anwendungen reichte. Ein breiter Konsens bestand über die zunehmende Relevanz von KI für die berufliche Bildung​​.


Herausforderungen und Bedürfnisse: Zu den Herausforderungen zählen die Unsicherheiten in Bezug auf die praktische Umsetzung von KI sowie Bedenken hinsichtlich Datenschutz und Akzeptanz. Die Befragten äußerten den Wunsch nach klaren Anwendungsbeispielen und einem interaktiven Kursdesign​​.


Kursentwicklung und Implementierung: Die Ergebnisse der Interviews flossen in die Entwicklung von vier modularen Online-Kursen ein, die Grundkenntnisse über KI und deren Anwendungsmöglichkeiten vermitteln. Der Kursansatz wurde durch die Einbindung von Praxisbeispielen und interaktiven Elementen erweitert​​.


2. Zusammenfassung
Die Studie analysiert die Entwicklung und Implementierung von Online-Kursen zu Künstlicher Intelligenz in der beruflichen Bildung, basierend auf Stakeholder-Interviews. Die Ergebnisse verdeutlichen die Bedeutung eines modularen und praxisnahen Bildungsansatzes, um den unterschiedlichen Bedürfnissen der Lernenden gerecht zu werden. Die Autoren betonen die Notwendigkeit, KI-Kompetenzen in der beruflichen Bildung zu stärken, um zukünftige Anforderungen der Arbeitswelt zu erfüllen​.
3. Kernaussagen


Wachsende Bedeutung von KI: Es besteht ein Konsens über die zunehmende Relevanz von KI in der beruflichen Bildung und den damit verbundenen Qualifikationsbedarf​.


Vielfältige Herausforderungen: Die Implementierung von KI in der Bildung steht vor Herausforderungen wie fehlendem Wissen und Akzeptanzproblemen​.


Bedarfsgerechte Kursentwicklung: Die Entwicklung von Bildungsangeboten sollte die Bedürfnisse und Erwartungen der Stakeholder berücksichtigen und praxisnahe Inhalte bieten​.


4. Argumentationslinien
Die Autoren argumentieren, dass eine evidenzbasierte Entwicklung von Online-Lernangeboten im Bereich KI essenziell ist, um die Anforderungen der beruflichen Bildung zu erfüllen. Sie betonen, dass die Berücksichtigung der Perspektiven der Stakeholder und die Anpassung der Kursinhalte an deren Bedürfnisse entscheidend für den Erfolg solcher Bildungsinitiativen sind​.
5. Verschlagwortung


Technologieintegration: Untersuchung der Integration von KI-Technologien in die berufliche Bildung.


Lehr- und Lerneffektivität: Bewertung der Wirksamkeit von KI-gestützten Bildungsangeboten zur Verbesserung der beruflichen Bildung.


Bewertungsmethoden: Analyse der Methoden zur Entwicklung und Evaluation von Bildungsangeboten im Bereich KI.


6. Kategorisierung


Argumentation: Die Studie liefert durch qualitative Interviews und die darauf basierende Kursentwicklung überzeugende Argumente für die Notwendigkeit, KI-Kompetenzen in der beruflichen Bildung zu stärken und diese systematisch zu integrieren​.


7. Zuordnung zu Forschungsfragen
Passendste Forschungsunterfrage:


FU4b: Welche technisch-gestalterischen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?


Begründung: Die Studie untersucht die Implementierung und Gestaltung von KI-basierten Bildungsangeboten, die für die Entwicklung von LMS im Bildungsbereich relevant sind​.




8. Einordnung der Relevanz


Relevanzbewertung: 5 - Hoch relevant: Die Quelle bietet umfassende Informationen zur Integration und Entwicklung von KI in der beruflichen Bildung und ist direkt relevant für die Forschungsfragen.


},
	annote = {{\textless}div class="codex-extract"{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Quelle (PDF):{\textless}/strong{\textgreater} /Users/jochenhanisch-johannsen/Zotero/storage/UAM27IAS/Egloffstein et al. - 2024 - Evidence-based development of online learning reso.pdf{\textless}/p{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Extrakte (Treffer auf Muster):{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}ol{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 18{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}werb von domänenspezifischen, meist technologieorientierten KI-Kompetenzen(Ng. et al., 2023) abzielt, die weit über grundlegende Fähigkeiten und ein Bewusst-sein für die Technologie und ihre Wirkungen hinausgehen. Zum anderen in Richtungeiner transdisziplinären KI-Bildung, die KI als Grundlage in allen Disziplinen und Do-mänen sieht (Aliabadi, Singh \&amp; Wilson, 2023). Auf lange Sicht muss vor allem die{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 18{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}berufs‐ und wirtschaftspädagogischer Studiengänge. Verfügbar unter: www.dgfe.de/fileadmin/ OrdnerRedakteure/Sektionen/Sek07\_BerWiP/2014\_Basiscurriculum\_BWP.pdf [31.01.2024].Chiu, T. K. F. (2023). The impact of Generative AI (GenAI) on practices, policies and research direction in education: a case of ChatGPT and Midjourney. Interactive Learning Environments, 1-17. https://www. doi.org/10.1080/10494820.2023.2253861{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\te