@article{holzmann-littig_design_2023,
	title = {Design and {Transition} of an {Emergency} {E}-{Learning} {Pathology} {Course} for {Medical} {Students}-{Evaluation} of a {Novel} {Course} {Concept}},
	volume = {13},
	issn = {2254-9625},
	doi = {10.3390/ejihpe13010008},
	abstract = {BACKGROUND: Around the world, the emergency brought about by the COVID-19 pandemic forced medical schools to create numerous e-learning supplements to provide instruction during this crisis. The question now is to determine a way in which to capitalize on this momentum of digitization and harness the medical e-learning content created for the future. We have analyzed the transition of a pathology course to an emergency remote education online course and, in the second step, applied a flipped classroom approach including research skills training.
METHODS: In the summer semester of 2020, the pathology course at the Technical University of Munich was completely converted to an asynchronous online course. Its content was adapted in winter 2021 and incorporated into a flipped classroom concept in which research skills were taught at the same time.
RESULTS: Screencasts and lecture recordings were the most popular asynchronous teaching formats. Students reported developing a higher interest in pathology and research through group work. The amount of content was very challenging for some students.
CONCLUSION: Flipped classroom formats are a viable option when using pre-existing content. We recommend checking such content for technical and didactic quality and optimizing it if necessary. Content on research skills can be combined very well with clinical teaching content.},
	language = {en-GB},
	number = {1},
	journal = {European Journal of Investigation in Health, Psychology and Education},
	author = {Holzmann-Littig, Christopher and Jedlicska, Nana and Wijnen-Meijer, Marjo and Liesche-Starnecker, Friederike and Schmidt-Bäse, Karen and Renders, Lutz and Weimann, Katja and Konukiewitz, Björn and Schlegel, Jürgen},
	month = jan,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:FU4a, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Systemanpassung, Bildungstheorien, Krisenreaktion im Bildungsbereich, COVID-19, medical education, \#5:Zeitschriftenartikel:e-learning, e-learning, flipped classroom, pathology, remote education, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {112--129},
	annote = {Analyse der Studie „Design and Transition of an Emergency E-Learning Pathology Course for Medical Students—Evaluation of a Novel Course Concept“ von Holzmann-Littig et al. (2023)

1. Analyse
Hauptthemen und Ziele der Forschung
Ziel der Studie war die Entwicklung, Implementierung und Evaluation eines digitalen Pathologiekurses für Medizinstudierende im Rahmen der COVID-19-Pandemie. Der Kurs sollte sowohl pandemiebedingt kurzfristig einsatzfähig als auch langfristig nachhaltig nutzbar sein. Das Projekt verfolgte drei Hauptziele:


Entwicklung eines flipped classroom-basierten Kurskonzepts,


Integration von Forschungsfähigkeiten in die Pathologie-Lehre,


Förderung intrinsischer Motivation durch die Berücksichtigung der Self-Determination Theory (SDT).



Methoden und Datenquellen


Design: Zweiphasige Kursentwicklung (Emergency Remote Education → Flipped Classroom mit Projektphase).


Plattform: Moodle® für asynchrone Module und Zoom® für synchrone Elemente.


Didaktische Formate: Screencasts, animierte Videos, Fallvignetten, Quizzes, Gruppenarbeit mit Posterpräsentationen.


Evaluation: Standardisierte Fragebögen mit Likert-Skalen und Schulnoten sowie qualitative Freitextanalysen.


Datenerhebung: Zwei Kohorten (SoSe 2020: n=23; WiSe 2020/21: n=27), online-survey via EvaSys®.



Zentrale Forschungsergebnisse


Asynchrone Formate (Screencasts, animierte Videos) wurden am besten bewertet (Ø Note 1,51).


Quizzes stärkten Motivation und Lernerfolg (S. 121).


In der Projektphase wurden signifikante Zuwächse in Forschungsinteresse und methodischen Kompetenzenberichtet (z. B. Posterentwicklung Ø 4,41/5).


Die SDT-Komponenten Autonomie, Kompetenz und soziale Eingebundenheit wurden durch das Kursdesign gezielt adressiert.


Die Studierenden forderten stärker strukturierte Inhalte und wiesen auf Überforderung durch tägliche Inhalte hin (S. 120).


Die Möglichkeit zur Online-Umsetzung der gesamten Kursstruktur wurde als pandemieresilient bewertet.



2. Zusammenfassung
Die Studie von Holzmann-Littig et al. (2023) beschreibt die Umgestaltung eines klassischen Präsenzkurses in Pathologie zu einem digital gestützten Lehrformat an der TU München. Zunächst wurde ein asynchrones Onlineformat entwickelt (DigiPath), das im zweiten Schritt in ein Flipped-Classroom-Modell mit integrierter Projektarbeit überführt wurde. Dabei wurden nicht nur fachliche Inhalte vermittelt, sondern auch Kompetenzen in wissenschaftlichem Arbeiten gefördert. Die Evaluation zeigte hohe Zufriedenheit mit interaktiven Formaten, jedoch auch Herausforderungen hinsichtlich der Arbeitsbelastung und Strukturierung. Insgesamt wurde das Kursmodell als langfristig einsetzbar und motivationsfördernd eingeschätzt.

3. Kernaussagen mit Fundstellen


„Screencasts und animierte Videos wurden signifikant besser bewertet als Vorlesungsaufzeichnungen“ (S. 120).


„Quizzes erhöhten die Konzentration auf die Videos und gaben Rückmeldung über Lernerfolg“ (S. 121).


„Studierende berichteten von gesteigertem Interesse an Pathologie und wissenschaftlicher Arbeit“ (S. 121–122).


„Flipped-Classroom-Formate eignen sich zur nachhaltigen Nutzung pandemiebedingt erstellter Inhalte“ (S. 126).


„Self-Determination Theory wurde als theoretische Grundlage für die Motivationsförderung genutzt“ (S. 114).



4. Argumentationslinien mit Fundstellen
Die Autor:innen argumentieren entlang folgender logischer Struktur:


Notwendigkeit der Digitalisierung → Pandemiebedingter Übergang zur Emergency Remote Education (S. 113).


Qualitätsverlust temporärer Formate → Ziel: nachhaltige Integration durch didaktische Aufbereitung (S. 114).


Theoriegeleitete Motivation (SDT) → Design unter Berücksichtigung von Autonomie, Kompetenz, Zugehörigkeit (S. 114).


Verbindung von Fach- und Forschungskompetenz → Projektphase mit Posterarbeit zur Förderung von Transfer und Forschungslust (S. 117–122).


Evaluation und Skalierung → empirische Rückmeldung als Grundlage für zukünftige Entwicklungen (S. 122–125).



5. Verschlagwortung




Schlagwort


Begründung




Technologieintegration


Nutzung von Moodle®, Zoom®, Screencasts, Quizmodulen (S. 115–116).




Lehr- und Lerneffektivität


Evaluation des Lernerfolgs anhand von Quiz, Posterprojekten, Selbstwirksamkeit und SDT (S. 121–122).




Forschungsansätze


Integration von Forschungskompetenzen (Projektphase, Poster, Methodentraining) (S. 117–122).




Systemanpassung


Entwicklung eines hybriden Kursmodells, das zwischen digital und Präsenz wechselbar ist (S. 126).




Krisenreaktion im Bildungsbereich


Reaktion auf COVID-19 durch schnelle Umstellung und dauerhafte Weiterentwicklung (S. 113–114).




Bildungstheorien


Verwendung der Self-Determination Theory (Ryan \& Deci) als didaktischer Rahmen (S. 114).





6. Kategorisierung
Kategorie:Kerngedanke→ Die Studie entwickelt und evaluiert ein innovatives, theoriegeleitetes Kursdesign zur digitalen Pathologieausbildung, das sowohl in Pandemie- als auch in Regelbetriebsszenarien eingesetzt werden kann und forschungsbezogene Kompetenzen systematisch integriert.

7. Zuordnung zur Forschungsfrage
Passendste Forschungsunterfrage (FU):FU4a – Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?
Begründung:Die Studie beschreibt theoriegeleitet (Self-Determination Theory, Selbstgesteuertes Lernen) konkrete didaktische Mechanismen zur Motivationsförderung, Selbstwirksamkeit und Integration forschungsorientierter Lernprozesse.

8. Relevanzbewertung
5 – Hoch relevantDie Quelle ist direkt und umfassend relevant, da sie detailliert den Einsatz, die Weiterentwicklung und die bildungstheoretische Fundierung eines konkreten digitalen Lehr-Lern-Settings im Gesundheitsbereich beschreibt.
},
	file = {Volltext:/Users/jochenhanisch-johannsen/Zotero/storage/36EDSTQ4/Holzmann-Littig et al. - 2023 - Design and Transition of an Emergency E-Learning Pathology Course for Medical Students-Evaluation of.pdf:application/pdf},
}

