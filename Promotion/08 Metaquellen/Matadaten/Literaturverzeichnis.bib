@incollection{grosseck_accentuate_2024,
	address = {Singapore},
	title = {Accentuate the {Positive}: {Exploratory} {Case} {Study} of {ChatGPT} as a {Complementary} {Learning} {Tool}},
	isbn = {978-981-97-6135-7 978-981-97-6136-4},
	shorttitle = {Accentuate the {Positive}},
	url = {https://link.springer.com/10.1007/978-981-97-6136-4_13},
	doi = {10.1007/978-981-97-6136-4_13},
	abstract = {In this chapter, we explore the role of Artiﬁcial Intelligence (AI) and ChatGPT (Generative Pre-trained Transformer), within the scholarship of Teaching and Learning (T\&L). As educators, we are grappling with ChatGPT and trying to understand its role in both teaching and learning but also in assessment. Given educators understandable trepidation, we decided to embrace, accentuate the positive and ‘lean-in’ to ChatGPT. In this study, we explore an assessment case study and share how an assessment adaptation within an entrepreneurship module offers educators and students alike an opportunity to embrace ChatGPT and to learn from the potential that ChatGPT can bring to the classroom. Such an approach offers a constructive strategy by considering students as collaborators in the AI educational experience. We present the challenges for educators, followed by a discussion on the strategies educators can use to embrace AI. Finally, while acknowledging the ever-evolving educational landscape, we acknowledge the educator’s role in emphasising the role of authentic assessment, thus helping to develop students’ digital literacy, critical thinking and problem-solving skills, regardless of programme of study.},
	language = {en-GB},
	urldate = {2024-11-21},
	booktitle = {Digital {Assessment} in {Higher} {Education}},
	publisher = {Springer Nature Singapore},
	author = {Barrett, Gillian and Fitzgerald, Ciara and Ryan, Marie},
	editor = {Grosseck, Gabriela and Sava, Simona and Ion, Georgeta and Malita, Laura},
	year = {2024},
	note = {Series Title: Lecture Notes in Educational Technology},
	keywords = {Promotion:Literaturanalyse, \#0:Buchteil:digital:learning, GPT, Promotion:S:12 Digital Learning, Promotion:\#Promotion:GPT, Promotion:Literaturverzeichnis},
	pages = {285--304},
	annote = {Analyse des Artikels „Accentuate the Positive: Exploratory Case Study of ChatGPT as a Complementary Learning Tool“

1. Hauptthemen und Bezug zur systematischen Literaturanalyse
Fragestellungen und Ziele des Artikels:


Zielsetzung: Der Artikel untersucht, wie ChatGPT als unterstützendes Lernwerkzeug in Bildungskontexten eingesetzt werden kann, um personalisiertes und kollaboratives Lernen zu fördern.


Fragestellung: Wie können Assessments durch den Einsatz von ChatGPT so angepasst werden, dass studentisches Lernen unterstützt und gleichzeitig akademische Integrität gewahrt wird?


Ansatz: ChatGPT wird als Werkzeug für authentische Bewertung und die Entwicklung digitaler Kompetenzen von Studierenden betrachtet.


Bezug zur systematischen Literaturanalyse:


Der Artikel legt den Fokus auf die Anwendung von ChatGPT zur Unterstützung von Lern- und Lehrprozessen, nicht direkt auf die systematische Literaturanalyse. Allerdings wird die Fähigkeit von ChatGPT hervorgehoben, Inhalte zu analysieren, zu strukturieren und Reflexionen zu fördern, was relevant für Literaturanalyseprozesse ist.



2. Methodische Ansätze und Datenquellen
Methodische Ansätze:


Fallstudienbasiert: Der Artikel basiert auf einer Fallstudie in einem betriebswirtschaftlichen Kurs (Unternehmertum), in dem ChatGPT in Assessments integriert wurde.


Framework: Ein 3P-Rahmen (Prompts, Positivity, Potential) wird verwendet, um Interaktionen zwischen Studierenden und ChatGPT zu analysieren.


Relevanz für die Automatisierung der Literaturanalyse:


Das Framework ist bedingt übertragbar: Prompts und die Bedeutung der Benutzerführung sind direkt auf die Nutzung von GPT für die Literaturanalyse anwendbar.


Datenquellen:


Primärdaten: Beobachtungen aus studentischen Interaktionen mit ChatGPT.


Sekundärquellen: Pädagogische Theorien und frühere Studien zur Nutzung von KI in Bildungsprozessen.



3. Argumente für die Verwendung von GPT in der Literaturanalyse (Pro)


Effizienz: ChatGPT bietet die Möglichkeit, große Datenmengen schnell zu verarbeiten und erste Analysen durchzuführen.


Lernunterstützung: Förderung von kritischem Denken und digitaler Kompetenz durch die Interaktion mit generativer KI.


Personalisierung: ChatGPT ermöglicht maßgeschneiderte Lern- und Analyseerfahrungen, insbesondere durch Prompt-Optimierung.


Integration: KI-Tools können als Einstiegspunkt in komplexe Themen dienen und Studierenden dabei helfen, sich mit schwierigen Inhalten auseinanderzusetzen.



4. Argumente gegen die Verwendung von GPT in der Literaturanalyse (Contra)


Fehlende Präzision: Der Artikel zeigt, dass ChatGPT oft „halluzinierte“ Inhalte erzeugt, wie erfundene Referenzen oder ungenaue Fakten.


Positivitätsbias: Viele Nutzende akzeptieren Ergebnisse unkritisch und hinterfragen die Inhalte nicht ausreichend.


Erkennung von KI-Generiertem: Es ist schwierig, den Anteil von KI-unterstütztem Output in akademischen Arbeiten zu erkennen, was Herausforderungen für die Transparenz schafft.



5. Ethische und methodische Überlegungen


Ethische Implikationen: Der Artikel betont die Notwendigkeit, ChatGPT als Werkzeug transparent zu nutzen und Studierende über ethische Risiken aufzuklären.


Methodische Verbesserungen: Es wird vorgeschlagen, KI in Lehrpläne zu integrieren und Studierende anzuleiten, KI-Outputs kritisch zu prüfen und durch unabhängige Recherche zu validieren.



6. Relevanz für das Forschungsvorhaben und Forschungslücken
Beitrag zur Diskussion:


Der Artikel zeigt praxisnahe Ansätze, wie ChatGPT sinnvoll in akademischen Kontexten eingesetzt werden kann, insbesondere durch die Kombination von KI-Outputs mit manueller Analyse.


Forschungslücken:


Es fehlt an systematischen Studien zur optimalen Nutzung von ChatGPT für die Literaturanalyse und die Entwicklung von Standards zur Transparenz und Validität.



Zusammenfassung
Der Artikel betont die Vorteile von ChatGPT in der Bildung, insbesondere bei der Förderung digitaler Kompetenzen, kritischen Denkens und personalisierter Lernprozesse. Herausforderungen wie die Erkennung von KI-generiertem Output und die Notwendigkeit kritischer Reflexion werden klar benannt. Für Dein Forschungsvorhaben sind die Erkenntnisse zur Gestaltung von Prompts, der Integration von KI-Tools und der Vermittlung ethischer Kompetenzen direkt übertragbar. Eine klare Trennung zwischen menschlicher Reflexion und maschineller Unterstützung bleibt entscheidend.
},
	file = {Barrett et al. - 2024 - Accentuate the Positive Exploratory Case Study of ChatGPT as a Complementary Learning Tool:/Users/jochenhanisch-johannsen/Zotero/storage/RAFJUFE7/Barrett et al. - 2024 - Accentuate the Positive Exploratory Case Study of ChatGPT as a Complementary Learning Tool.pdf:application/pdf},
}

@article{hellmuth_soziales_2021,
	title = {Soziales {Lernen} digital unterstützen: {Wie} die {Klasse} zu einer {Gemeinschaft} wird},
	issn = {0933-422X},
	shorttitle = {Soziales {Lernen} digital unterstützen},
	url = {https://www.beltz.de/10.3262/PAED2106033},
	doi = {10.3262/PAED2106033},
	abstract = {Kennen sich die Schüler*innen untereinander schon? Sind sie einander sympathisch, helfen sie sich gegenseitig? Gibt es Freundschaften in der Klasse, werden Kinder ausgegrenzt? Dies sind Fragen, die sich Lehrer*innen bei der Übernahme einer Klasse oftmals stellen und die zeigen, wie wichtig gute Beziehungen unter den Schüler*innen sind.},
	language = {de-DE},
	number = {6},
	urldate = {2024-07-01},
	journal = {Pädagogik},
	author = {Hellmuth, Christoph and Mundelsee, Lukas and Jurkowski, Susanne},
	month = jun,
	year = {2021},
	keywords = {Promotion:Literaturanalyse, Kollaboratives Lernen, Lehr- und Lerneffektivität, Technologieintegration, Promotion:Relevanz:4, Promotion:Weiterführung, Promotion:FU3, Promotion:S:09 Digital Lernen, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU3},
	pages = {33--36},
	annote = {Analyse des Artikels „Soziales Lernen digital unterstützen: Wie die Klasse zu einer Gemeinschaft wird“ von Hellmuth et al. (2021)

1. Analyse
Hauptthemen und Ziele der Forschung


Thema: Förderung sozialer und emotionaler Kompetenzen sowie positiver Peer-Beziehungen im digitalen Klassenzimmer mithilfe von Gamification.


Ziel: Bewertung der Effekte des digitalen Tools Classcraft auf die Entwicklung von sozial-emotionalen Fähigkeiten und das Klassenklima.


Verwendete Methoden und Datenquellen


Methodik:


Einsatz von Classcraft über vier Wochen in einer achten Klasse (Experimentalgruppe) mit einer Parallelklasse als Kontrollgruppe.


Vorher-Nachher-Befragungen zu sozialer Integration, Klassenklima und sozial-emotionalen Fähigkeiten.


Validierte Fragebogenskalen zur Datenerhebung.




Datenquellen:


Schüler*innenbefragungen (N = 2 Klassen).


Statistische Analyse von Veränderungen in sozial-emotionalen Variablen und Klassenklima.




Zentrale Forschungsergebnisse


Klassenklima: Signifikante Verbesserung in der Experimentalgruppe, während die Kontrollgruppe eine leichte Verschlechterung zeigte.


Sozial-emotionale Fähigkeiten: Verbesserungen in beiden Klassen, jedoch kein zusätzlicher Effekt durch Classcraft.


Motivation und Engagement: Hohe Motivation und positive Wahrnehmung des Tools bei Lehrkräften und Schüler*innen.



2. Zusammenfassung
Der Artikel untersucht, wie digitales Lernen mit Classcraft soziale Interaktionen und das Klassenklima fördern kann. Während das Spiel positive Effekte auf das Klassenklima zeigte, konnten sozial-emotionale Fähigkeiten nicht gezielt verbessert werden. Die Ergebnisse unterstreichen die Potenziale von Gamification, weisen jedoch auf die Notwendigkeit hin, spezifische Aufgaben zur Förderung sozialer Kompetenzen zu integrieren.

3. Kernaussagen


Förderung von Peer-Beziehungen: Classcraft stärkt das Klassenklima durch positive Interdependenz und kooperative Aufgabenstrukturen (S. 34–35).


Grenzen der Förderung: Kein signifikanter Unterschied in der Entwicklung sozial-emotionaler Fähigkeiten zwischen den Gruppen (S. 35–36).


Praktische Umsetzbarkeit: Die Integration von Classcraft erfordert technische Voraussetzungen und kann zeitintensiv sein (S. 36).



4. Argumentationslinien


Theorie: Die Studie basiert auf den Prinzipien kooperativen Lernens, die positive soziale Interaktionen und Verantwortlichkeiten innerhalb der Gruppe fördern (S. 34).


Empirische Evidenz: Verbesserungen im Klassenklima und hohe Motivation der Schüler*innen bestätigen die Wirksamkeit von Gamification (S. 35).


Praktische Relevanz: Die Ergebnisse unterstützen die Integration digitaler Tools in den Unterricht zur Förderung sozialer Kompetenzen (S. 36).



5. Verschlagwortung


Kollaboratives Lernen: Einsatz von Gamification zur Förderung von Kooperation und Interdependenz im Klassenzimmer.


Lehr- und Lerneffektivität: Verbesserung des Klassenklimas und der Motivation durch interaktive Spielmechanismen.


Technologieintegration: Nutzung von Classcraft als digitales Tool zur Unterstützung sozialer Lernprozesse.



6. Kategorisierung
Kategorie: Weiterführung


Begründung: Die Studie hebt zukünftige Möglichkeiten hervor, sozial-emotionale Fähigkeiten gezielter durch spezifische Aufgaben und Belohnungssysteme zu fördern (S. 36).



7. Zuordnung zu Forschungsfragen
Passendste Forschungsunterfrage: FU3: „Wie sind Konzeption und relevante didaktische und bildungstechnologische Merkmale des systemisch-konstruktivistischen Learning-Management-Systems für Akteure im digitalen Bildungsraum von Gesundheitsberufen dargestellt?“


Begründung: Die Studie beschreibt detailliert die didaktische Gestaltung und praktische Anwendung eines digitalen Tools zur Förderung sozialer Kompetenzen (S. 34–35).



8. Relevanzbewertung


Direkte Relevanz: 5 (Praxisorientierte Erkenntnisse zur Verbesserung digitaler Bildungsplattformen).


Aktualität: 4 (Veröffentlichung 2021, weiterhin relevant, jedoch nicht hochaktuell).


Zitierhäufigkeit: 3 (Thematisch relevant, jedoch begrenzte Sichtbarkeit).


Gesamtbewertung: 4
},
	file = {Hellmuth et al. - 2021 - Soziales Lernen digital unterstützen Wie die Klas.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/R4KU3S5Y/Hellmuth et al. - 2021 - Soziales Lernen digital unterstützen Wie die Klas.pdf:application/pdf},
}

@article{hao_investigating_2024,
