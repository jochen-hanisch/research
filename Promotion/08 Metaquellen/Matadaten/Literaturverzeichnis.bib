@article{wang_topic_2024,
	title = {A topic map based learning management system to facilitate meaningful grammar learning: the case of {Japanese} grammar learning},
	volume = {11},
	issn = {2196-7091},
	shorttitle = {A topic map based learning management system to facilitate meaningful grammar learning},
	url = {https://slejournal.springeropen.com/articles/10.1186/s40561-024-00338-1},
	doi = {10.1186/s40561-024-00338-1},
	abstract = {Abstract
            This study investigates the effect of studying with topic maps provided by a self-developed language learning support system on (a) learning perception, (b) learning achievement and (c) variation in learning attitude and motivation, from the perspective of prior learning attitude, motivation and learning style. An analysis was conducted on the learning data of 90 participants for examining pre-test and post-test scores, learning perception, learning style indicators, attitude and motivation rankings before and after the study of target Japanese grammar content with the support of the system. The findings suggest that learners with high attitude/motivation perceived greater development of the habit of “learning from the comparison of related knowledge” and felt more satisfied with the learning situation in the system environment. Furthermore, the learners' attitude towards Japanese grammar learning and their motivation toward Japanese language learning were significantly stronger after the learning activity. It is also observed that (a) learner attitude towards Japanese grammar after studying with the system only had a positive correlation to prior attitudes; and (b) learner motivation towards Japanese language after studying with the system correlated highly with prior motivation and perception of development of the habit of “learning from the comparison of related knowledge.” Finally, from a learning style perspective, the analysis result suggests that “Global learners” expressed a stronger feeling about the usefulness of the comparison function of the system and their increment in motivation after using the system was higher than for “Sequential learners.” Moreover, between learning style indicators in the Sequential/Global dimension and level of learner expertise in the reported mental load scale, a significant interaction effect was found.},
	language = {en-GB},
	number = {1},
	urldate = {2025-01-01},
	journal = {Smart Learning Environments},
	author = {Wang, Jingyun and Wynn, Adam and Mendori, Takahiko and Hwang, Gwo-Jen},
	month = nov,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Bewertungsmethoden, Promotion:Argumentation, \#1:Zeitschriftenartikel:learning:management:system, Lernsystemarchitektur, Promotion:FU6, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {53},
	annote = {Analyse der Studie „A Topic Map Based Learning Management System to Facilitate Meaningful Grammar Learning: The Case of Japanese Grammar Learning“ von Wang et al. (2024)

1. Hauptthemen und Ziele der Forschung
Die Studie untersucht die Entwicklung und Evaluierung eines Topic-Map-basierten Learning-Management-Systems (CLLSS) zur Unterstützung des sinnhaften Grammatiklernens, speziell im Bereich der japanischen Grammatik.
Zentrale Forschungsfragen:


Wie beeinflusst CLLSS die Lernwahrnehmung und den Lernerfolg in Bezug auf Grammatiklernen?


Welche Rolle spielen Lernstil, Einstellung und Motivation für den Erfolg des Grammatiklernens mit CLLSS?


Verändert sich die Einstellung und Motivation der Lernenden durch die Nutzung des Systems?



2. Methoden und Datenquellen
Methoden:
Die Studie verwendet eine experimentelle Vergleichsanalyse mit Vorher-Nachher-Messungen.


Teilnehmer: 90 Studierende eines Japanischstudiengangs.


Untersuchungsgruppen:


Experimentelle Gruppe (CLLSS-Nutzung)


Kontrollgruppe (Lernen mit Lehrbuch)




Datenerhebung:


Pre- und Post-Tests zur Messung der Grammatikkompetenz


Fragebögen zu Lernwahrnehmung, Motivation und Einstellung


Lernstilanalyse (Sequential vs. Global, Active vs. Reflective)




Datenquellen:


Vergleich von Pre- und Post-Testergebnissen der Studierenden


Erhebung individueller Lernstile anhand des Felder-Silverman-Lernstilmodells


Statistische Analysen (ANOVA, t-Tests, Korrelationsanalysen)



3. Zentrale Forschungsergebnisse


CLLSS verbessert die Lernleistung signifikant


Studierende der experimentellen Gruppe erzielten höhere Post-Test-Ergebnisse als die Kontrollgruppe.


Lernende mit höherer anfänglicher Motivation profitierten stärker.




Veränderte Einstellung und Motivation nach Nutzung von CLLSS


Signifikante Verbesserung der Einstellung zur japanischen Grammatik (p {\textless} 0,001).


Erhöhte Motivation zum Japanischlernen nach der Nutzung des Systems (p {\textless} 0,001).




Zusammenhang zwischen Lernstil und Systemwahrnehmung


Globale Lernende profitierten stärker von der Vergleichsfunktion des Systems.


Aktive Lernende empfanden höhere kognitive Belastung als reflektive Lernende.





4. Zusammenfassung
Die Studie zeigt, dass ein Topic-Map-basiertes LMS (CLLSS) die Grammatikkompetenz, Motivation und Einstellung von Lernenden verbessert. Besonders globale Lernende und Lernende mit hoher Ausgangsmotivationprofitieren vom System. Gleichzeitig zeigt die Forschung, dass aktive Lernende durch fehlende soziale Interaktion eine höhere Belastung empfinden.

5. Kernaussagen


„Studierende, die mit CLLSS lernen, zeigen signifikant höhere Post-Test-Ergebnisse als die Kontrollgruppe.“ (S. 10)


„Nach Nutzung von CLLSS stieg sowohl die Einstellung zur Grammatik als auch die allgemeine Lernmotivation signifikant.“ (S. 11)


„Globale Lernende profitieren stärker von der Topic-Map-Visualisierung als sequentielle Lernende.“ (S. 13)



6. Argumentationslinien
Die Studie argumentiert, dass visuell strukturierte Grammatik-Lernsysteme eine effektive Alternative zum traditionellen Lehrbuchlernen sind.


Grundannahme: Ein LMS, das Wissen vernetzt darstellt, fördert eine tiefere Verarbeitung von Grammatikregeln. (S. 3)


Empirischer Beleg: Lernende mit CLLSS erreichen bessere Testergebnisse als die Kontrollgruppe. (S. 10)


Didaktische Implikationen: Besonders globale Lernende profitieren von der Visualisierung von Grammatikstrukturen. (S. 13)



7. Verschlagwortung




Schlagwort


Begründung




Lernsystemarchitektur


CLLSS ist ein speziell entwickeltes, visuell strukturiertes LMS für Grammatiklernen.




Lehr- und Lerneffektivität


Die Studie zeigt, dass das LMS signifikante Lernfortschritte ermöglicht.




Bewertungsmethoden


Pre- und Post-Tests sowie Fragebögen zur Messung von Einstellung und Motivation.





8. Kategorisierung
Kategorie: Argumentation


Kriterium: Die Studie kombiniert empirische Tests mit lernpsychologischen Konzepten zur Evaluation von CLLSS.


Beispiel: Die Lernfortschritte in der experimentellen Gruppe belegen, dass ein vernetztes Wissenssystem die Grammatikkompetenz verbessert. (S. 10)



9. Zuordnung zu einer Forschungsunterfrage (FU)
Passendste Forschungsunterfrage: FU6„Wie wird ein systemisch-konstruktivistisches Learning-Management-System als Kompetenzerwerbssystem bei Akteuren im digitalen Bildungsraum von Gesundheitsberufen beurteilt?“
Begründung:Das in der Studie untersuchte CLLSS nutzt ein konstruktivistisches Lernprinzip, indem es Grammatikstrukturen über ein vernetztes Thema-Map-System darstellt. Die Erkenntnisse über Lernstile, Motivation und visuelle Lernstrukturen sind direkt auf digitale Lernsysteme im Gesundheitsbereich übertragbar, insbesondere in Bezug auf strukturierte Wissensvermittlung und selbstgesteuertes Lernen.

10. Relevanzbewertung (1–5)
Relevanz: 5


Die Studie liefert konkrete empirische Erkenntnisse über die Wirksamkeit eines LMS.


Die Forschungsergebnisse sind direkt auf den digitalen Bildungsraum übertragbar.


Die Erkenntnisse zur Lernstilabhängigkeit und Motivation sind relevant für die Gestaltung systemisch-konstruktivistischer LMS.


},
	file = {Wang et al. - 2024 - A topic map based learning management system to facilitate meaningful grammar learning the case of:/Users/jochenhanisch-johannsen/Zotero/storage/7SVREXQI/Wang et al. - 2024 - A topic map based learning management system to facilitate meaningful grammar learning the case of.pdf:application/pdf},
}

