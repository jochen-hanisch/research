@article{li_systematic_2023,
	title = {A {Systematic} {Literature} {Review} of {Social} {Learning} {Theory} in {Online} {Learning} {Environments}},
	volume = {35},
	issn = {1040-726X, 1573-336X},
	url = {https://link.springer.com/10.1007/s10648-023-09827-0},
	doi = {10/gs57bh},
	abstract = {The emergence of educational technologies has spurred research interest in exploring effective ways to enhance human learning in digital environments. Social Learning Theory (SLT), as a crucial theory that offers a conceptual framework for understanding the role of human agency in learning, can shed light on the underlying mechanisms of learners’ social learning behaviors, such as engagement and collaboration, in online learning contexts. However, there is a gap in the literature regarding reviews of online learning studies grounded in SLT. Therefore, this systematic review aims to examine SLT-related online learning studies to investigate how SLT contribute to the understanding of the technology integration in human learning. The review includes two descriptive research questions on research trends and implementation categories, alongside two qualitative research questions investigating the significance of SLT concepts in understanding social learning online implementations. The PRISMA method was employed to select and analyze 60 studies. Deductive content analysis revealed two major educational affordances of social networking sites that result in social learning experiences: collaborative interaction and observational participation.},
	language = {en-GB},
	number = {4},
	urldate = {2023-11-18},
	journal = {Educational Psychology Review},
	author = {Li, Siyuan and Hong, Yi-Chun and Craig, Scotty D.},
	month = dec,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Kollaboratives Lernen, Promotion:FU4a, Promotion:Kerngedanke, Promotion:Relevanz:5, Bildungstheorien, \#0:Zeitschriftenartikel:digital:learning, Promotion:S:12 Digital Learning, Promotion:DRK-Düsseldorf, Promotion:Literaturverzeichnis},
	pages = {108},
	annote = {Analyse des Artikels „A Systematic Literature Review of Social Learning Theory in Online Learning Environments“ von Li et al. (2023)

1. Hauptthemen und Ziele der Forschung
Der Artikel bietet eine systematische Literaturübersicht zur Anwendung der Social Learning Theory (SLT) in Online-Lernumgebungen. Ziel ist es, bestehende Forschungslücken zu identifizieren und die Rolle von SLT in digitalen Lernprozessen zu untersuchen. Die Autoren analysieren verschiedene technologische Implementierungen, um zu bewerten, wie soziales Lernen online gefördert werden kann.

2. Methoden und Datenquellen


Methode:


Anwendung der PRISMA-Methode zur systematischen Auswahl relevanter Studien.


Deduktive Inhaltsanalyse zur Untersuchung theoretischer Konzepte von SLT in Online-Lernumgebungen.




Datenquellen:


60 ausgewählte Studien aus wissenschaftlichen Datenbanken (PsycInfo, ERIC, EBSCO).


Fokussierung auf Veröffentlichungen zwischen 2010 und 2021.




Analyse:


Klassifikation von Online-Lernumgebungen nach fünf Implementierungskategorien.


Bewertung der Effektivität anhand von Leistungsdaten und subjektiven Lernendenbewertungen.





3. Zentrale Forschungsergebnisse


Trends in der Social Learning Forschung:


Anstieg von SLT-basierten Studien seit 2020, insbesondere durch die COVID-19-Pandemie.


Fokussierung auf berufliche Weiterbildung und Lehrerbildung.




Wirksame Online-Implementierungen sozialer Lernmechanismen:


Interaktive und kollaborative Lernsysteme (ICLS) und Video-basierte Implementierungen (VI)erwiesen sich als besonders effektiv.


Massive Open Online Courses (MOOCs) sowie Text-basierte Implementierungen (TI) sind ebenfalls relevant.




SLT erklärt die Online-Implementierung über drei Hauptfaktoren:


Persönliche Faktoren: Individuelle Motivation, Vertrauen in soziale Medien und kognitive Ressourcen.


Verhaltensbezogene Faktoren: Partizipation, kollaboratives Lernen und Interaktion in digitalen Räumen.


Umweltbezogene Faktoren: Einfluss von Instruktionsdesigns und technologischer Infrastruktur.




Empfehlungen für zukünftige Implementierungen:


Kombination von kollaborativen und beobachtenden Lernprozessen in digitalen Plattformen.


Förderung von selbstgesteuertem Lernen durch adaptive Lernumgebungen.





Zusammenfassung
Die systematische Übersicht zeigt, dass soziales Lernen in Online-Umgebungen eine Schlüsselrolle spielt, jedoch eine klare theoretische Fundierung benötigt. Die Studien belegen, dass verschiedene digitale Lernformate unterschiedliche Stärken und Schwächen hinsichtlich sozialer Interaktion aufweisen. Die Autoren fordern eine stärkere Integration von SLT in digitale Bildungsforschung.

Kernaussagen


Interaktive Plattformen und Video-Lernen sind die effektivsten SLT-basierten Ansätze:


Besonders für berufliche Weiterbildung und Hochschulbildung geeignet (S. 10).




Social Learning erfordert gezielte Gestaltung von Online-Lernräumen:


Foren, Live-Streams und Lernvideos sollten kollaborativ genutzt werden (S. 12).




SLT kann helfen, digitale Lernkonzepte evidenzbasiert weiterzuentwickeln:


Triadic Reciprocal Determinism erklärt, wie Verhalten, kognitive Faktoren und Umwelt interagieren (S. 15).





Argumentationslinien


Technologie als Verstärker sozialer Lernprozesse:


Soziale Netzwerke und digitale Plattformen ermöglichen neue Formen des kollaborativen Lernens.




SLT als Theorierahmen für Online-Lernstrategien:


Die Autoren argumentieren, dass SLT ein fundamentales Modell zur Erklärung des digitalen Lernens ist.




Unterschiedliche Medienformate erfordern differenzierte Ansätze:


Beobachtendes Lernen in Videos vs. aktives Lernen in interaktiven Plattformen erfordert unterschiedliche didaktische Designs.





Verschlagwortung


Bildungstheorien:


Begründung: SLT wird als theoretisches Fundament für Online-Lernansätze verwendet.




Kollaboratives Lernen:


Begründung: Studien belegen die Bedeutung sozialer Interaktion und Gruppenprozesse für den Lernerfolg.




Forschungsansätze:


Begründung: Die Studie verwendet eine systematische Literaturübersicht, um bestehende Forschung zu kategorisieren.





Kategorisierung
Kategorie: ArgumentationBegründung: Der Artikel untermauert die Relevanz von SLT für Online-Lernen durch eine systematische Übersicht und die Identifikation effektiver Implementierungsstrategien.

Zuordnung zur Forschungsunterfrage
Passendste Forschungsunterfrage:FU4a„Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum beschrieben?“
Begründung:Der Artikel analysiert die Mechanismen sozialer Lernprozesse in Online-Umgebungen und wie diese in digitale Lernplattformen integriert werden können.

Relevanzbewertung


Relevanz: 5Der Artikel liefert eine fundierte systematische Analyse von SLT im digitalen Lernen und zeigt auf, wie Theorie und Praxis verknüpft werden können.


},
	file = {Li et al. - 2023 - A Systematic Literature Review of Social Learning .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/VV6EQDFK/Li et al. - 2023 - A Systematic Literature Review of Social Learning .pdf:application/pdf},
}

@article{schafer_virtual_2023,
	title = {Virtual {Reality} in der {Schule}: {Bedenken} und {Potenziale} aus {Sicht} der {Akteur}:innen in interdisziplinären {Ratingkonferenzen}},
	volume = {51},
