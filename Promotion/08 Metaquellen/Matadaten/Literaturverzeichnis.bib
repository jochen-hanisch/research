  title = {Automatisierte Vorlesungsaufzeichnungen mit Opencast Matterhorn an der Universität Osnabrück. Wissenswertes zum praktischen Einsatz des Systems, die technische Infrastruktur und mögliche Fallstricke},
  author = {Greweling, Christian and Rolf, Rüdiger and Meyer, Denis},
  namea = {Teaching Trends: Offen für neue Wege – Digitale Medien in der Hochschule (2014 : Oldenburg (Oldenburg))},
  nameatype = {collaborator},
  date = {2020-02-21},
