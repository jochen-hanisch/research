@article{biel_plattformubergreifendes_2025,
	title = {Plattformübergreifendes {KI}-{Empfehlungssystem} in einem {Digitalisierungstraining} für {Lehrkräfte} der {Erwachsenenbildung}},
	volume = {19},
	copyright = {Creative Commons Namensnennung 4.0 International},
	issn = {1993-6818},
	url = {https://www.pedocs.de/frontdoor.php?source_opus=33690},
	doi = {10.25656/01:33690},
	abstract = {The authors report on a pilot project in which AI for :DTrain, a digitalization training programme for adult education trainers was developed. The basis for :DTrain is a skillsoriented curriculum that describes professional digital skills. In this digitalization training programme, an AI application produces learning sequences by accessing data from different learning platforms. An education-oriented multiagent system is used. Agents are software programmes that plan tasks and also evaluate whether they have been successfully completed. On the basis of correct or incorrect responses, the system can generate modified learning sequences. This requires technical interfaces, and the developed AI application must harmonize data from different storage locations through socalled data mapping. In this article, the authors explain the technical requirements in detail so that learners can alternate between the systems smoothly. For example, they explain middleware, which functions as a translator between learning management systems, or authentication mechanisms, which check the identity of users as they change platforms. The educational programme makes use of the EULE learning management system of the German Institute for Adult Education (DIE) and the vhs.cloud of the German Adult Education Association (DVV). As prerequisites for such AIbased offerings in adult education, the authors mention open standards, highquality metadata, large amounts of data and a suitable technical infrastructure. (DIPF/Orig.)},
	language = {de},
	number = {55},
	urldate = {2025-07-27},
	journal = {Magazin erwachsenenbildung.at},
	publisher = {Bundesministerium für Frauen, Wissenschaft und Forschung : Wien},
	author = {Biel, Carmen and Klante, Sonja},
	collaborator = {{DIPF {\textbar} Leibniz-Institut für Bildungsforschung und Bildungsinformation}},
	year = {2025},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Promotion:Relevanz:5, Technologieintegration, Bewertungsmethoden, Systemanpassung, Bildungstheorien, Promotion:Weiterführung, \#1:Zeitschriftenartikel:learning:management:system, Deutschland, Digitalisierung, Digitalization, Germany, Promotion:FU4b, Lernsystemarchitektur, 370 Education, 370 Erziehung, Schul- und Bildungswesen, Professionalisierung, Professionalization, Kompetenz, Adult training, Erwachsenenbildung, Erwachsenenbildner, Training, Training (sports), Competency, Self-directed learning, Adult education, Artificial intelligence, Künstliche Intelligenz, Digitale Medien, Selbst gesteuertes Lernen, Lernangebot, Adaptives System, Adult education teacher, Adult educator, Lehr‑ und Lerneffektivität, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis, Promotion:sec:A-14, Promotion:sec:Technologiedefizit, Promotion:sec:MedienpaedagogischeRahmung, Promotion:sec:LMS-Bildungsraum-Begrenzte-Steuerbarkeit, Promotion:chap:04-02},
	pages = {66--75},
	annote = {Analyse der Studie „Plattformübergreifendes KI-Empfehlungssystem in einem Digitalisierungstraining für Lehrkräfte der Erwachsenenbildung“ von Biel \& Klante (2025)

1. Hauptthemen und Ziele der ForschungDer Beitrag beschreibt die Entwicklung und Erprobung eines plattformübergreifenden KI-Empfehlungssystems im Rahmen des Projekts KUPPEL, eingebettet in das Digitalisierungstraining :DTrain für Lehrkräfte der Erwachsenen- und Weiterbildung (EB/WB). Ziel ist es, mittels Künstlicher Intelligenz (KI) und adaptiven Multiagentensystemen individuelle, kompetenzorientierte Lernpfade über verschiedene Lernmanagementsysteme (LMS) hinweg zu generieren. Dabei werden sowohl technische Interoperabilität (Middleware, Schnittstellen, Datenmapping) als auch didaktische Grundlagen (kompetenzorientiertes Curriculum, GRETA-Kompetenzmodell) integriert, um die Professionalität und Digitalkompetenzen von Lehrenden zu stärken.

2. Methoden und Datenquellen


Methodischer Ansatz: Design-Based Research mit formativer Evaluation; kontinuierliche Anpassung der Systemarchitektur auf Grundlage von Bedarfsanalysen, Akzeptanzuntersuchungen und Komponententests.


Technische Umsetzung: Multiagentensystem (Lerneragent + Pädagogischer Agent) in einer Middleware, die Daten aus zwei LMS (EULE, vhs.cloud) integriert.


Didaktische Basis: :DTrain-Curriculum und erweitertes GRETA-Kompetenzmodell, ergänzt durch Assessments zur Kompetenz- und Niveaustufenerfassung.


Datenquellen: Nutzungs- und Profildaten der Lehrkräfte, Interaktionsdaten mit Lerninhalten, curriculare Metadaten, Kompetenzprofile.



3. Zentrale Forschungsergebnisse


Das entwickelte KI-System kann Lernpfade plattformübergreifend generieren, indem es Inhalte, Kompetenzziele und individuelle Lernpräferenzen verknüpft.


Die technische Machbarkeit der Interoperabilität zwischen offenen und proprietären LMS wurde demonstriert (u. a. durch Datenmapping, zentrale Authentifizierung).


Das GRETA-Kompetenzmodell ermöglicht eine präzisere Niveaustufung und damit gezieltere Empfehlungen, was das „Cold Start“-Problem von Empfehlungssystemen reduziert.


Die Integration adaptiver Mechanismen erhöht die Passgenauigkeit von Lerninhalten und fördert selbstgesteuertes Lernen, ohne Lehrende im digitalen Raum allein zu lassen.



4. ZusammenfassungDie Studie stellt ein KI-gestütztes, plattformübergreifendes Empfehlungssystem vor, das in einem Digitalisierungstraining für Lehrkräfte der EB/WB eingesetzt wird. Auf Basis eines kompetenzorientierten Curriculums (:DTrain) und des GRETA-Kompetenzmodells werden individuelle Lernsequenzen erstellt. Technisch wird dies durch ein Multiagentensystem in einer Middleware realisiert, die Daten aus zwei LMS integriert. Die formative Evaluation bestätigt sowohl die technische Umsetzbarkeit als auch den potenziellen Mehrwert für die Professionalitätsentwicklung von Lehrkräften.

5. Kernaussagen


Interoperabilität ist technisch umsetzbar: Middleware und Datenmapping ermöglichen die Verbindung unterschiedlicher LMS (S. 70).


Didaktische Fundierung ist entscheidend: Kompetenzmodelle wie GRETA strukturieren Inhalte und erleichtern adaptive Empfehlungen (S. 71).


Adaptive Systeme brauchen hochwertige Daten: Qualität von Metadaten und Assessments bestimmt die Passgenauigkeit der Lernempfehlungen (S. 69–71).


KI kann Lehrende entlasten: Durch personalisierte Lernpfade wird selbstgesteuertes Lernen unterstützt, ohne dass Orientierung verloren geht (S. 68).



6. Argumentationslinien


Ausgangspunkt ist die Herausforderung, Lehrkräfte der EB/WB in einer heterogenen und fragmentierten digitalen Bildungslandschaft passgenau zu unterstützen.


Konstruktivistische Didaktik und Adaptivität werden als Schlüssel zur Personalisierung hervorgehoben, da Lernende nicht allein auf ihre Suche und Filterkompetenz angewiesen sein sollten (S. 68).


KI-gestützte Empfehlungssysteme bieten hier einen Mehrwert, wenn sie mit soliden Kompetenzmodellen, hochwertigen Metadaten und interoperabler Technik kombiniert werden (S. 69–71).


Die technische Umsetzung zeigt, dass Multiagentensysteme in Middleware-Architekturen eine praxistaugliche Lösung für plattformübergreifende Lernszenarien darstellen können (S. 70).



7. Verschlagwortung


Lernsystemarchitektur – Beschreibung einer komplexen Systemarchitektur aus Middleware, Multiagentensystem und LMS-Anbindung.


Bildungstheorien – Bezug zu moderatem Konstruktivismus und adaptivem Lernen als didaktische Basis.


Lehr- und Lerneffektivität – Ziel der Verbesserung von Lernergebnissen durch passgenaue Inhalte.


Technologieintegration – Verknüpfung unterschiedlicher LMS (EULE, vhs.cloud) über technische Schnittstellen.


Systemanpassung – Anpassung der Lernpfade an Kompetenzstände, Präferenzen und Curriculumsziele.


Forschungsansätze – Einsatz von Design-Based Research zur iterativen Systemoptimierung.



8. KategorisierungKerngedanke – Die Verbindung von KI-basierter adaptiver Lernpfadgenerierung mit kompetenzorientierter Didaktik kann Lehrkräfte der EB/WB in ihrer Professionalitätsentwicklung effektiv und plattformübergreifend unterstützen (S. 69–71).

9. Zuordnung zu ForschungsunterfrageFU4b – Welche technisch-gestalterische Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?Begründung: Die Arbeit legt den Fokus auf die technische Architektur (Middleware, Multiagentensystem, Datenmapping, Schnittstellen) und deren Rolle bei der Unterstützung von Lernenden im digitalen Bildungsraum.

10. Relevanzbewertung5 – Hoch relevant: Die Studie liefert detaillierte technische und didaktische Mechanismen für ein komplexes, KI-gestütztes Lernsystem und deren Wirkung auf Lehrende.
},
	file = {Biel und Klante - 2025 - Plattformübergreifendes KI-Empfehlungssystem in einem Digitalisierungstraining für Lehrkräfte der Er:/Users/jochenhanisch-johannsen/Zotero/storage/XSMWECMW/Biel und Klante - 2025 - Plattformübergreifendes KI-Empfehlungssystem in einem Digitalisierungstraining für Lehrkräfte der Er.pdf:application/pdf},
}

@article{payer_adaptives_2025-1,
	title = {Adaptives {Lernen} und {Usability} im {Fokus}. {Ein} {E}-{Learning}-{Kurs} zum {Aufbau} von {KI}-{Literacy}},
	volume = {19},
	copyright = {Creative Commons Namensnennung 4.0 International},
	issn = {1993-6818},
	url = {https://www.pedocs.de/frontdoor.php?source_opus=33693},
	doi = {10.25656/01:33693},
	abstract = {How can artificial intelligence make learning outcomes more sustainable and increase one’s motivation to learn? The authors show how individualization and personalization through the integration of artificial intelligence can succeed in practice: Learners can choose their learning tempo by themselves and course content modules are offered in different degrees of difficulty. This avoids making too many and too few demands on learners and enables them to flexibly organize learning units according to their needs and time resources. In addition, avatars and chatbots can prompt them to interact. According to the authors, regular assessment of progress and repetition increase the learners’ confidence in their own abilities. All of these points are being implemented in the “AI in Practice” educational project, which was developed in cooperation with the University of Applied Sciences Burgenland and the Austrian Chamber of Commerce for in-company professional development. This course for professionals and leaders has an intuitive user interface that supports structured learning and avoids cognitive overload. Along with good usability, the authors stress the importance of didactic concepts that also facilitate exchange and discussion and argue for a high standard for data protection. This project recommends the participatory development of AI solutions through technology and adult education as well as regular inclusion of the participants’ experiences. (DIPF/Orig.)},
	language = {de},
	number = {55},
	urldate = {2025-07-27},
	journal = {Magazin erwachsenenbildung.at},
	publisher = {Bundesministerium für Frauen, Wissenschaft und Forschung : Wien},
	author = {Payer, Daniel and Worgatsch, Ronald},
	collaborator = {{DIPF {\textbar} Leibniz-Institut für Bildungsforschung und Bildungsinformation}},
	year = {2025},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Promotion:Kerngedanke, Technologieintegration, Bewertungsmethoden, Systemanpassung, Bildungstheorien, Datenschutz und IT-Sicherheit, Virtual learning, Learning, Lernplattform, Lernsystemarchitektur, Promotion:FU3, Promotion:Relevanz:3, 370 Education, 370 Erziehung, Schul- und Bildungswesen, Kompetenz, Adult training, Erwachsenenbildung, Competency, Austria, Österreich, Adult education, Betriebliche Weiterbildung, In-plant further education, In-service training, Lernen, Artificial intelligence, Künstliche Intelligenz, \#5:Zeitschriftenartikel:e-learning, E-learning, E-Learning, Lehr‑ und Lerneffektivität, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {96--104},
	annote = {Analyse des Artikels „Adaptives Lernen und Usability im Fokus. Ein E‑Learning‑Kurs zum Aufbau von KI‑Literacy“ (Payer \& Worgatsch, 2025)
Analyse
Hauptthemen und ‑ziele


Zielsetzung: Darstellung eines adaptiven, nutzungsfreundlichen E‑Learning‑Kurses („KI in der Praxis“) zur Förderung von KI‑Literacy in der betrieblichen Erwachsenenbildung. Im Fokus stehen Personalisierung, Usability und Accessibility sowie didaktische Leitlinien (ARCS‑Motivationsmodell; Mayers Prinzipien des multimedialen Lernens) (S. 96–99).


Zentrale Fragen (implizit): Wie lassen sich adaptive Lernpfade, UI/UX‑Gestaltung und KI‑gestützte Komponenten (Avatar, Chatbot) so kombinieren, dass Motivation, Selbstregulation und Lernerfolg steigen, ohne Datenschutz und Transparenz zu vernachlässigen (S. 96–101, 102)?


Methoden und Datenquellen


Beitragsart: Projektbericht mit didaktisch‑technischer Konzeption und theoriegeleiteter Begründung (Praxisrubrik). Es werden keine experimentellen Effekte berichtet; vielmehr wird auf theoretische Fundierung(u. a. Keller, 1987; Mayer, 2020; Cognitive Load Theory) und Sekundärstudien zu Usability und Motivation Bezug genommen (S. 98–101, 102–103).


Technische/didaktische Instrumente:


Adaptive Pfade nach einem Drei‑Ebenen‑Schema (Ziel‑, Konzept/Kompetenz‑, Unterstützungs‑/Feedback‑Ebene) (S. 98).


Usability‑Prinzipien (Kohärenz, Signaling, räumliche Kontiguität; CLT/MM‑Theorie) und Usability‑Testing(S. 99).


Accessibility nach WCAG 2.2 (Perceivable, Operable, Understandable, Robust; Untertitel, Transkripte, Kontraste) (S. 98–99).


KI‑gestützte Bausteine: KI‑Avatar, TTS‑Audio, inhaltsbezogener Chatbot, KI‑gestützte Gestaltungsevaluation (Kontrast‑/Typografie‑Check) (S. 99–100).




Datenlage: Nutzungsangabe („{\textgreater}100 Lernende“ aus mehreren Branchen), jedoch ohne kontrollierte Wirksamkeitsmessung; formative Rückmeldungen fließen in die iterative Gestaltung ein (S. 98, 102).


Zentrale Ergebnisse und Implikationen


Didaktische Umsetzung: Adaptive Sequenzen, modulare Schwierigkeitsgrade und regelmäßige Selbstüberprüfungen sollen Über‑/Unterforderung vermeiden und Selbstwirksamkeit stärken (S. 96–98, 100–101).


Usability → Motivation: Konsistenz, Kontrolle, Transparenz und klare Navigation steigern wahrgenommene Unterstützung, Aufgabenwert und Engagement; dies stützt sich auf einschlägige Studien (z. B. Alshammari et al., 2015; Evers et al., 2014; Wong \& Hughes, 2023) (S. 100–101).


Accessibility als Qualitätsmerkmal: Systematische WCAG‑Umsetzung erweitert Teilhabemöglichkeiten und reduziert kognitive Belastung (S. 98–99).


Ethisch‑rechtliche Rahmung: Datenschutz und Bias‑Reflexion sind integraler Bestandteil der Kursgestaltung und Vertrauensbildung (S. 101–102).


Rolle der Lehrenden: Keine Substitution, sondern veränderte Aufgabenprofile (Begleitung, Kontextualisierung, Diskurs) (S. 101–102).


Visuelle Anhaltspunkte: Die Übersicht der Kursinhalte (Screenshot der Plattform wîse up) auf Seite 97, Abb. 1 illustriert die strukturierte Navigation; eine Zwischenfrage zur dynamischen Pfadanpassung auf Seite 98, Abb. 2 verdeutlicht das Entscheidungs‑/Branching‑Design.

Zusammenfassung (prägnant)
Der Beitrag beschreibt Konzeption und Umsetzung eines adaptiven, barrierearmen E‑Learning‑Kurses zur KI‑Literacy für berufstätige Erwachsene. Theoretisch gestützt durch ARCS und Mayers Multimedia‑Prinzipien werden Personalisierung, Usability (Kohärenz, Signaling, Kontiguität), WCAG‑basierte Accessibility sowie KI‑Funktionen (Avatar, Chatbot, TTS, Design‑Checks) kombiniert. Erwartete Wirkungen sind höhere Motivation, Selbstwirksamkeit und bedarfsgerechter Kompetenzerwerb; zugleich werden Datenschutz und algorithmische Fairness thematisiert. Lehrende bleiben als moderierende und reflexionsfördernde Instanz zentral (S. 96–102).

Kernaussagen (mit Fundstellen)


Adaptive Lernwege verhindern Über‑/Unterforderung und fördern nachhaltigen Lernerfolg (S. 98).


Drei‑Ebenen‑Architektur (Ziel‑, Konzept/Kompetenz‑, Unterstützungs‑/Feedback‑Ebene) operationalisiert Adaptivität (S. 98).


Usability‑Prinzipien (Kohärenz, Signaling, Kontiguität) reduzieren kognitive Last und fokussieren Aufmerksamkeit (S. 99).


Kontrolle \& Transparenz für Lernende sind Schlüsselfaktoren benutzungsfreundlicher adaptiver Systeme (S. 98, 100).


Accessibility nach WCAG (POUR) ist didaktisch wie technisch verbindlich umzusetzen (S. 98–99).


KI‑Module (Avatar, Chatbot, TTS, Design‑Evaluation) unterstützen Interaktion, Aktualität und Barrierefreiheit (S. 99–100).


Lehrende bleiben zentral; KI verändert Rollen statt sie zu ersetzen (S. 101–102).


Datenschutz/Bias‑Reflexion erhöht Vertrauen und Akzeptanz (S. 101–102).



Argumentationslinien (mit Fundstellen)


Motivation \& Lernen → Designprinzipien: Aus ARCS und Multimedia‑Lernen folgt, dass konsistente, signalisierte, kontigente Darbietung Motivation und Verstehen erhöht → daher UI/UX‑Leitplanken und Adaptive Checks (S. 97–99).


Adaptivität → Personalisierung → Wirksamkeit: Wissensdiagnose und Pfadanpassung (Abb. 2) führen zu bedarfsgerechter Progression und höherem Aufgabenwert/Engagement (S. 98, 100–101).


Accessibility/Usability → Teilhabe \& kognitive Entlastung: WCAG‑konforme Umsetzung plus Usability‑Testing mindern Belastung, erweitern Zugang und stabilisieren Selbstregulation (S. 98–99).


Ethik \& Governance als Voraussetzung der Akzeptanz: Datenschutz und Bias‑Sensibilisierung sind notwendig für Vertrauen; Lehrende sichern Sinnstiftung und Diskursräume ab (S. 101–102).



Verschlagwortung (mit Begründung)


Lernsystemarchitektur: Drei‑Ebenen‑Modell der Adaptivität und modulare Pfadsteuerung (S. 98).


Bildungstheorien: ARCS‑Modell; Multimedia‑Lernprinzipien; Cognitive Load Theory als didaktische Basis (S. 97–99).


Lehr‑ und Lerneffektivität: Begründete Annahmen zu Motivation, Selbstwirksamkeit, Aufgabenwert und Engagement (S. 100–101).


Bewertungsmethoden: Usability‑Testing und formative Evaluation (inkl. KI‑gestützter Designprüfung) als Gestaltungs‑/Qualitätssicherung (S. 99–100).


Technologieintegration: Kombination von LMS‑Plattform (wîse up), KI‑Avatar, Chatbot, TTS und Accessibility‑Techniken (S. 97–100).


Datenschutz und IT‑Sicherheit: Datenschutz und Bias‑Thematik als integraler Bestandteil des Kurskonzepts (S. 101–102).


Systemanpassung: Laufende Pfadanpassung anhand Vorwissen/Präferenzen; Möglichkeit zum Überspringen/Zurückgreifen (S. 98).


Forschungsansätze: Theoriegeleitete, design‑orientierte Entwicklung mit Bezug auf empirische Usability‑/Motivationsforschung (S. 99–101).


(Die Schlagwörter „Kollaboratives Lernen“ und „Krisenreaktion im Bildungsbereich“ werden nicht explizit getragen und bleiben daher ungenannt.)

Kategorisiere (genau eine Kategorie)
Kerngedanke: Ein adaptives, WCAG‑konformes und usability‑fokussiertes Kursdesign – theoretisch fundiert durch ARCS und Multimedia‑Lernen – steigert Motivation, Selbstregulation und (erwarteten) Lernerfolg, während Lehrende als gestaltende Begleitung zentral bleiben (S. 97–102).

Zuordnung zur passenden Forschungsunterfrage (FU)
FU3 – Konzeption und relevante didaktische/bildungstechnologische MerkmaleBegründung: Der Beitrag liefert eine detaillierte Konzept‑ und Designbeschreibung eines KI‑Literacy‑Kurses (Architektur der Adaptivität, UI/UX‑Leitlinien, WCAG‑Implementierung, KI‑Tools) und reflektiert deren didaktische Funktionen – genau der Gegenstand von FU3 (S. 97–100, 101–102).

Einordnung der Relevanz (1–5)
3 – Mittelmäßig relevant.Begründung: Hohe Passung zu LMS‑Gestaltung (Adaptivität, UI/UX, Accessibility, KI‑Integration), jedoch ohnekontrollierte Wirksamkeitsdaten und nicht domänenspezifisch für Gesundheitsberufe; die übertragbaren Gestaltungsprinzipien stützen dennoch die Modellierung des „Wirkgefüges“ eines LMS.

Hinweise zu Forschungslücken


Wirksamkeitsnachweise: Es fehlen experimentelle/ quasi‑experimentelle Effekte (Lernleistung, Transfer, Retention) und Vergleiche gegen nicht‑adaptive Designs.


Nutzungsanalytik: Keine systematischen Lernanalytik‑Daten (z. B. Pfadnutzung, Abbruchpunkte).


Domänentransfer: Keine fachspezifische Evaluation (z. B. in Gesundheitsberufen) – hier wäre eine Übertragung mit domänenspezifischen Kompetenzen und Datenschutzanforderungen des Gesundheitssektors sinnvoll.


Barrierefreiheits‑Audit: WCAG‑Selbstauskunft ist plausibel; ein externes Audit (z. B. WCAG‑Konformitätsbericht) würde Evidenz stärken.



APA‑Quellennachweis
Payer, D., \& Worgatsch, R. (2025). Adaptives Lernen und Usability im Fokus. Ein E‑Learning‑Kurs zum Aufbau von KI‑Literacy. Magazin erwachsenenbildung.at, 19(55), 96–104. https://doi.org/10.25656/01:33693 (vgl. S. 96–104)
},
	file = {Payer und Worgatsch - 2025 - Adaptives Lernen und Usability im Fokus. Ein E-Learning-Kurs zum Aufbau von KI-Literacy:/Users/jochenhanisch-johannsen/Zotero/storage/WQLIAZ3I/Payer und Worgatsch - 2025 - Adaptives Lernen und Usability im Fokus. Ein E-Learning-Kurs zum Aufbau von KI-Literacy.pdf:application/pdf},
}

@article{schindler_glossar_2025,
