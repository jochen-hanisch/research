@unpublished{brandt_digitale_nodate,
	title = {Digitale {Transformation} in der medizinischen {Ausbildung}},
	language = {de-DE},
	author = {Brandt, Jenny and Frey, Nicolas},
	keywords = {Promotion:Literaturanalyse, Technologieintegration, Bildungstheorien, Promotion:Argumentation, Promotion:Relevanz:4, Promotion:FU4b, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU4b},
	annote = {Analyse der Studie "Digitale Transformation in der medizinischen Ausbildung: Eine Handreichung der Arbeitsgruppe 'Digitalisierung der Fachbereiche: Medizin'" von Brandt und Frey (2023)
Hauptthemen und Ziele der Forschung:
Die Handreichung von Brandt und Frey (2023) zielt darauf ab, medizinischen Fakultäten Leitlinien und Hilfestellungen zur digitalen Transformation der medizinischen Ausbildung zu bieten. Sie behandelt die Integration digitaler Kompetenzen in die Curricula, die Anwendung evidenzbasierter digitaler didaktischer Methoden und gibt Empfehlungen für die Implementierung neuer Lehrformate. Der Fokus liegt auf der Stärkung digitaler Kompetenzen und der Anpassung der Lehrmethoden an die sich verändernden Anforderungen im medizinischen Bereich (S. 4-7).
Methoden und Datenquellen:
Die Handreichung basiert auf einer umfassenden Literaturrecherche, Experteninterviews und Best-Practice-Beispielen aus verschiedenen medizinischen Fakultäten. Sie integriert Ergebnisse aus aktuellen Studien zur Digitalisierung der medizinischen Ausbildung und stützt sich auf Empfehlungen nationaler und internationaler Gremien (S. 5).
Zentrale Forschungsergebnisse:


Integration digitaler Kompetenzen: Der Nationale Kompetenzbasierte Lernzielkatalog Medizin (NKLM) wurde aktualisiert, um digitale Kompetenzen als zentrale Lernziele zu verankern. Dies umfasst die Nutzung von Künstlicher Intelligenz (KI), Telemedizin und digitalen Gesundheitsanwendungen (S. 10-11).


Evidenzbasierte didaktische Methoden: Die Handreichung betont die Bedeutung evidenzbasierter Methoden wie das Inverted Classroom Model (ICM) und die Nutzung von Lernmanagementsystemen (LMS) und Learning Analytics (S. 19-21).


Implementierung neuer Lehrformate: Es werden verschiedene Ansätze zur Integration digitaler Lehrinhalte in bestehende Curricula vorgestellt, darunter Blended Learning, Gamification und Virtual Reality (VR) (S. 19-34).


Zusammenfassung
Die Handreichung von Brandt und Frey (2023) bietet umfassende Leitlinien zur digitalen Transformation der medizinischen Ausbildung. Sie hebt die Bedeutung der Integration digitaler Kompetenzen in die Curricula hervor und betont die Anwendung evidenzbasierter didaktischer Methoden. Neue Lehrformate wie Blended Learning und VR werden als wirksame Ansätze zur Verbesserung der Lehr- und Lernergebnisse vorgestellt.
Kernaussagen


Aktualisierung des NKLM: Der Nationale Kompetenzbasierte Lernzielkatalog Medizin wurde erweitert, um digitale Kompetenzen zu integrieren (S. 10-11).


Evidenzbasierte Methoden: Die Handreichung empfiehlt evidenzbasierte didaktische Methoden wie das Inverted Classroom Model zur Unterstützung der digitalen Transformation (S. 19-21).


Argumentationslinien
Die Autoren argumentieren, dass die Integration digitaler Kompetenzen und die Anwendung evidenzbasierter Methoden entscheidend für die erfolgreiche digitale Transformation der medizinischen Ausbildung sind. Die Anpassung der Lehrformate an moderne Technologien wie KI und VR ist notwendig, um den zukünftigen Anforderungen im Gesundheitswesen gerecht zu werden (S. 4-7).
Verschlagwortung
Passendste Schlagworte und Begründungen:


Bildungstheorien: Die Handreichung basiert auf bildungstheoretischen Grundlagen und integriert diese in die Empfehlungen zur digitalen Transformation (S. 4-7).


Technologieintegration: Die Studie zeigt, wie verschiedene digitale Technologien in die medizinische Ausbildung integriert werden können (S. 19-34).


Kategorisierung


Argumentation: Die Handreichung nutzt bestehende Theorien und empirische Daten, um die Notwendigkeit der digitalen Transformation in der medizinischen Ausbildung zu unterstützen und konkrete Empfehlungen zu geben (S. 4-7).


Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU4b: Bildungstechnologische Mechanismen eines LMS.


Begründung: Die Handreichung analysiert die Integration von LMS und anderen digitalen Technologien in die medizinische Ausbildung, was direkt die Frage nach den bildungstechnologischen Mechanismen eines LMS betrifft (S. 19-21).
Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Handreichung untersucht umfassend die digitale Transformation der medizinischen Ausbildung und deren technologischen Aspekte).


Zitierhäufigkeit und Einfluss: 4 (Die Handreichung ist methodisch stark und behandelt ein aktuelles und relevantes Thema, das potenziell oft zitiert wird).


Aktualität: 5 (Die Handreichung ist von 2023 und behandelt ein hochaktuelles Thema).


Gesamtbewertung: 4.75
Schlussfolgerung
Die Handreichung von Brandt und Frey (2023) zeigt, dass die digitale Transformation der medizinischen Ausbildung entscheidend für die Anpassung an moderne Technologien und die Verbesserung der Lehr- und Lernergebnisse ist. Die Integration digitaler Kompetenzen und die Anwendung evidenzbasierter didaktischer Methoden sind zentrale Elemente dieser Transformation. Die Ergebnisse bieten wertvolle Leitlinien und Empfehlungen für die zukünftige Gestaltung und Implementierung digitaler Lehrformate in der medizinischen Ausbildung.
},
	file = {Brandt und Frey - Digitale Transformation in der medizinischen Ausbi.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/4UYIKCUF/Brandt und Frey - Digitale Transformation in der medizinischen Ausbi.pdf:application/pdf},
}

@article{seeber_digitalisierung_2024,
	title = {Digitalisierung in der beruflichen {Ausbildung}: {Implikationen} für {Lehr}-{Lern}- und {Diagnostikprozesse}},
	abstract = {Der Artikel von Seeber, Ziegler und Weyland (2024) untersucht die Implikationen der Digitalisierung für Lehr-Lern- und Diagnostikprozesse in der beruflichen Ausbildung. Hier sind die wichtigsten Punkte zusammengefasst:

Veränderungen im Beschäftigungssystem: Durch Digitalisierung ausgelöste Dynamiken führen zu neuen Produkten, Technologien und veränderten Arbeitsprozessen, was wiederum grundsätzliche Veränderungen bei Berufszuschnitten und Kompetenzanforderungen nach sich zieht.
Anpassung beruflicher Curricula: In Reaktion auf diese Dynamiken wurden viele Berufsbilder und Curricula überarbeitet, was eine Neuausrichtung der Kompetenzziele erfordert.
Wachsende Bedeutung digitaler und berufsübergreifender Kompetenzen: Neben spezifischen beruflichen Fähigkeiten werden allgemeine digitale Kompetenzen und überfachliche Fähigkeiten wie Abstraktionsvermögen, Problemlösekompetenz und kommunikative Fähigkeiten immer wichtiger.
Auswirkungen der Digitalisierung auf verschiedene Berufsfelder: Die Autoren unterteilen die Berufsfelder in kaufmännisch-administrative, gegenstandsbezogene und personenbezogene Dienstleistungen, wobei die Digitalisierung je nach Bereich unterschiedliche Auswirkungen hat, von der Flexibilisierung von Geschäftsprozessen bis hin zur Standardisierung von Arbeitsabläufen in personenbezogenen Dienstleistungen.
Technologieeinsatz in der Ausbildung: Der Artikel hebt die Notwendigkeit hervor, digitale Medien und Technologien zur Förderung der Ausbildungsqualität zu nutzen, etwa durch simulationsgestütztes Lernen, das die Kompetenzentwicklung unterstützt.
Differenzielle Effekte der Digitalisierung: Während in einigen Berufen die Digitalisierung eine komplexere Aufgabenstruktur fördert, könnte sie in anderen Bereichen zu einer Vereinfachung der Tätigkeiten führen. Die Autoren betonen die Notwendigkeit, Ausbildungskonzepte zu entwickeln, die sowohl kurzfristige Qualifikationsbedürfnisse als auch langfristige Bildungsziele berücksichtigen.
Diese Zusammenfassung basiert auf der detaillierten Analyse der Veränderungen in beruflichen Ausbildungssystemen und betont die Notwendigkeit einer fortlaufenden Anpassung an die digitalen Transformationsprozesse in der Arbeitswelt.

Referenz:
Seeber, S., Ziegler, B., \& Weyland, U. (2024). Digitalisierung in der beruflichen Ausbildung: Implikationen für Lehr-Lern- und Diagnostikprozesse. Zeitschrift für Pädagogik, 70(2), 129-141.},
	language = {de-DE},
	journal = {Zeitschrift für Pädagogik},
	author = {Seeber, Susan and Ziegler, Birgit and Weyland, Ulrike},
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Bewertungsmethoden, Systemanpassung, Promotion:Argumentation, \#6:Zeitschriftenartikel:Bildung:Technologie, Kompetenz, \#9:Zeitschriftenartikel:digital:lernen, Promotion:Literaturverzeichnis},
	file = {Seeber et al. - 2024 - Digitalisierung in der beruflichen Ausbildung Imp.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/RI29I94J/Seeber et al. - 2024 - Digitalisierung in der beruflichen Ausbildung Imp.pdf:application/pdf},
}

