	pages = {129--141},
	file = {Wedel et al. - 2024 - Analoges Lernen digital aufbereiten - die Unterstützung der digitalen Lehre durch Elemente analogen:/Users/jochenhanisch-johannsen/Zotero/storage/TZIYL2VR/Wedel et al. - 2024 - Analoges Lernen digital aufbereiten - die Unterstützung der digitalen Lehre durch Elemente analogen.pdf:application/pdf},
