@article{scholefield_prediction_2024,
	title = {Prediction of good neurological outcome after return of circulation following paediatric cardiac arrest: a systematic review and meta-analysis},
	issn = {03009572},
	shorttitle = {Prediction of good neurological outcome after return of circulation following paediatric cardiac arrest},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S030095722400858X},
	doi = {10.1016/j.resuscitation.2024.110483},
	abstract = {Methods: Medline, EMBASE and Cochrane Trials databases were searched (2010–2023). Sensitivity and false positive rates (FPR) for good neurological outcome (defined as either ‘no, mild, moderate disability or minimal change from baseline’) in paediatric survivors were calculated for each predictor. Risk of bias was assessed using the QUIPS tool.
Results: Thirty-five studies (2974 children) were included. The presence of any of the following had a FPR {\textless}30\% for predicting good neurological outcome with moderate (50-75\%) or high ({\textgreater}75\%) sensitivity: bilateral reactive pupillary light response within 12h; motor component ≥4 on the Glasgow Coma Scale score at 6h; bilateral somatosensory evoked potentials at 24-72h; sleep spindles, and continuous cortical activity on electroencephalography within 24h; or a normal brain MRI at 4-6d. Early (≤12h) normal lactate levels ({\textless}2mmol/L) or normal s100b, NSE or MBP levels predicted good neurological outcome with FPR rate {\textless}30\% and low ({\textless}50\%) sensitivity. All studies had moderate to high risk of bias with timing of measurement, definition of test, use of multi-modal tests, or outcome assessment heterogeneity.
Conclusions: Clinical examination, electrophysiology, neuroimaging or blood-biomarkers as individual tests can predict good neurological outcome after cardiac arrest in children. However, evidence is often low quality and studies are heterogeneous. Use of a standardised, multimodal, prognostic algorithm should be studied and is likely of added value over single modality testing.},
	language = {en},
	urldate = {2025-01-01},
	journal = {Resuscitation},
	author = {Scholefield, Barnaby R. and Tijssen, Janice and Ganesan, Saptharishi Lalgudi and Kool, Mirjam and Couto, Thomaz Bittencourt and Topjian, Alexis and Atkins, Dianne L. and Acworth, Jason and McDevitt, Will and Laughlin, Suzanne and Guerguerian, Anne-Marie},
	month = dec,
	year = {2024},
	keywords = {Promotion:Literaturverzeichnis},
	pages = {110483},
	annote = {{\textless}div class="codex-extract"{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Quelle (PDF):{\textless}/strong{\textgreater} /Users/jochenhanisch-johannsen/Zotero/storage/HPZ4CYQ6/Scholefield et al. - 2024 - Prediction of good neurological outcome after return of circulation following paediatric cardiac arr.pdf{\textless}/p{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Extrakte (Treffer auf Muster):{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}ol{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 1{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}Review Prediction of good neurological outcome after return of circulation followingpaediatric cardiac arrest: a systematic review and meta-analysis{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 1{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}Atkins, J. Acworth, W. McDevitt, S. Laughlin, A-M. Guerguerian, On behalf of International Liaison Committeeon Resuscitation (ILCOR) and ILCOR Pediatric Life Support Task Force, Prediction of good neurologicaloutcome after return of circulation following paediatric cardiac arrest: a systematic review and meta-analysis,Resuscitation (2024), doi: https://doi.org/10.1016/j.resuscitation.2024.110483{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 2{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}Title: Prediction of good neurological outcome after return of circulationfollowing paediatric cardiac arrest: a systematic review and meta-analysis{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 5{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}Aim: To evaluate the ability of blood-biomarkers, clinical examination, electrophysiology, orneuroimaging, assessed within 14 days from return of circulation to predict good neurologicaloutcome in children following out- or in-hospital cardiac arrest. Methods: Medline, EMBASE and Cochrane Trials databases were searched (2010–2023). Sensitivity{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 5{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}Methods: Medline, EMBASE and Cochrane Trials databases were searched (2010–2023). Sensitivityand false positive rates (FPR) for good neurological outcome (defined as either ‘no, mild, moderatedisability or minimal change from baseline’) in paediatric survivors were calculated for eachpredictor. Risk of bias was assessed using the QUIPS tool.{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 5{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}Results: Thirty-five studies (2974 children) were included. The presence of any of the following had aFPR \&lt;30\% for predicting good neurological outcome with moderate (50-75\%) or high (\&gt;75\%)sensitivity: bilateral reactive pupillary light response within 12h; motor component ≥4 on theGlasgow Coma Scale score at 6h; bilateral somatosensory evoked potentials at 24-72h; sleep{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 5{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}spindles, and continuous cortical activity on electroencephalography within 24h; or a normal brainMRI at 4-6d. Early (≤12h) normal lactate levels (\&lt;2mmol/L) or normal s100b, NSE or MBP levelspredicted good neurological outcome with FPR rate \&lt;30\% and low (\&lt;50\%) sensitivity. All studies hadmoderate to high risk of bias with timing of measurement, definition of test, use of multi-modaltests, or outcome assessment heterogeneity.{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 5{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}MRI at 4-6d. Early (≤12h) normal lactate levels (\&lt;2mmol/L) or normal s100b, NSE or MBP levelspredicted good neurological outcome with FPR rate \&lt;30\% and low (\&lt;50\%) sensitivity. All studies hadmoderate to high risk of bias with timing of measurement, definition of test, use of multi-modaltests, or outcome assessment heterogeneity.{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 5{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}predicted good neurological outcome with FPR rate \&lt;30\% and low (\&lt;50\%) sensitivity. All studies hadmoderate to high risk of bias with timing of measurement, definition of test, use of multi-modaltests, or outcome assessment heterogeneity. Conclusions: Clinical examination, electrophysiology, neuroimaging or blood-biomarkers as{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 5{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}Conclusions: Clinical examination, electrophysiology, neuroimaging or blood-biomarkers asindividual tests can predict good neurological outcome after cardiac arrest in children. However,evidence is often low quality and studies are heterogeneous. Use of a standardised, multimodal,prognostic algorithm should be studied and is likely of added value over single modality testing.{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 6{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}Introduction The inability to accurately predict good neurological outcome following paediatric cardiac arrestremains a major source of distress to families and clinicians. Overall, 5-20\% children survive an out ofhospital cardiac arrest (OHCA),(1-6) and 25-50\% of survivors will have a good neurological outcome.(1,{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 6{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}The inability to accurately predict good neurological outcome following paediatric cardiac arrestremains a major source of distress to families and clinicians. Overall, 5-20\% children survive an out ofhospital cardiac arrest (OHCA),(1-6) and 25-50\% of survivors will have a good neurological outcome.(1,5, 7) Outcomes are better for children following in-hospital cardiac arrest (IHCA) with 25-60\%{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 6{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}5, 7) Outcomes are better for children following in-hospital cardiac arrest (IHCA) with 25-60\% surviving and 50-90\% having a good neurological outcome.(6, 8, 9) Neurological injury resulting fromarrest-induced hypoxic-ischaemic encephalopathy (HIE) remains the main source of morbidity andmortality.(10-13){\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 6{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}We sought to systematically review the literature on tests conducted during the post-arrest phaseand report the ability of individual tests to predict good neurological outcome. This systematicreview was designed to inform practice recommendations by the International Liaison Committee onResuscitation (ILCOR) for the prediction of good neurological outcome in children following{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 6{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}and report the ability of individual tests to predict good neurological outcome. This systematicreview was designed to inform practice recommendations by the International Liaison Committee onResuscitation (ILCOR) for the prediction of good neurological outcome in children followingresuscitation for OHCA or IHCA.{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 7{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}Population, intervention, comparator, outcome, timeframe, and study design (PICOTS) framework{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 7{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}any setting) with a return of circulation (P), do tests (clinical examination, biomarkers,electrophysiology, or imaging) (I), recorded from return of circulation up to 14 days from cardiacarrest predict the risk of: survival with good neurological outcome(O) at Paediatric Intensive CareUnit (PICU) or hospital discharge, 30 days, 60 days, 180 days and/or 1 year (T)? We selected studieswhere the sensitivity and false-positive rate (FPR) of the index test were reported (S). Accuracy of{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 7{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}Unit (PICU) or hospital discharge, 30 days, 60 days, 180 days and/or 1 year (T)? We selected studieswhere the sensitivity and false-positive rate (FPR) of the index test were reported (S). Accuracy ofthe index test was assessed by comparing the studied outcome with the test-predicted outcome,which represent the comparator (C).{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 8{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}Main outcomes The primary outcome was survival with good neurological outcome. Good neurological outcome wasdefined as a Pediatric Cerebral Performance Category (PCPC) score of 1, 2 or 3, or a VinelandAdaptive Behavioural scale-II ≥ 70.(23) PCPC score ranges 1 (normal), 2 (mild disability), 3 (moderate{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}li{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Seite 8{\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}blockquote{\textgreater}{\textless}pre{\textgreater}disability), 4 (severe disability), 5 (coma), and 6 (death).(24) If studies used different definitions (e.g.PCPC 1-2, or no change from baseline) or measures, we report these separately defining goodneurological outcome in context with other assessment tools. Measures of effect{\textless}/pre{\textgreater}{\textless}/blockquote{\textgreater}{\textless}/li{\textgreater}{\textless}/ol{\textgreater}{\textless}/div{\textgreater}},
