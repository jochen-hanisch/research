@article{rohsmatthias2022Dae,
  title = {Digitalisierung als ethische Herausforderung für die Erwachsenenbildung. Ein Anstoß für die Entwicklung einer Bereichsethik aus Sicht der Erwachsenenbildungsforschung},
  author = {Rohs, Matthias and Bernhardsson-Laros, Nils},
  date = {2022-05-05},
  journaltitle = {Magazin erwachsenenbildung.at: Das Fachmedium für Forschung, Praxis und Diskurs},
  number = {44--45},
  pages = {14},
  publisher = {Bundesministerium für Bildung, Wissenschaft und Forschung},
  doi = {10/gp5kbd},
  url = {https://www.pedocs.de/frontdoor.php?source_opus=24471},
  urldate = {2022-05-14},
  abstract = {The digital transformation is both an opportunity and a challenge to anchor ethical issues more firmly in adult education discourse. What is missing is a generally binding ethical code that applies to the profession of adult education and thus an orientation for ethical action in digital teaching/learning settings. A deeper analysis is necessary on the macrodidactic as well as the microdidactic level. This includes the critically reflective analysis of the societal impacts of the digital transformation in educational programs for adults as well as the discussion of ethical aspects surrounding the use of digital teaching/ learning media to organize teaching/learning processes. The article gives reasons for the need for a scientifically informed discourse on ethical issues of educational activity in this context. Ethics should be understood and reinforced as its own area of content in adult education. (DIPF/Orig.)},
  langid = {ngerman},
  keywords = {0:Zeitschriftenartikel:digital:learning,Adult training,Bildung,Bildungsforschung,Bildungstheorien,Charité:Promotion,Datenschutz und IT-Sicherheit,Digitale Bildung,Digitalisierung,Digitalization,Educational research,Erwachsenenbildung,Ethik,Krisenreaktion im Bildungsbereich,Moral,Morals,Pädagogisches Handeln,Promotion:02-01_Q2,Promotion:FU4a,Promotion:Literaturanalyse,Promotion:Relevanz:4,Promotion:S:12 Digital Learning,Promotion:Weiterführung},
