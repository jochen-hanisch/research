@article{rakhlin_stability_nodate,
	title = {Stability of {K}-{Means} {Clustering}},
	abstract = {We phrase K-means clustering as an empirical risk minimization procedure over a class HK and explicitly calculate the covering number for this class. Next, we show that stability of K-means clustering is characterized by the geometry of HK with respect to the underlying distribution. We prove that in the case of a unique global minimizer, the clustering solution is stable with respect to complete changes of the data, while for the case of multiple minimizers, the change of Ω(n1/2) samples deﬁnes the transition between stability and instability. While for a ﬁnite number of minimizers this result follows from multinomial distribution estimates, the case of inﬁnite minimizers requires more reﬁned tools. We conclude by proving that stability of the functions in HK implies stability of the actual centers of the clusters. Since stability is often used for selecting the number of clusters in practice, we hope that our analysis serves as a starting point for ﬁnding theoretically grounded recipes for the choice of K.},
	language = {en},
	author = {Rakhlin, Alexander and Caponnetto, Andrea},
	keywords = {Promotion:04-04:4.4.4, Promotion:4.4.4 Dreidimenionale Clusteranalyse, Promotion:Literaturverzeichnis, Promotion:sec:A-15, Promotion:sec:Methodenkritik-Absicherung, Promotion:sec:mdaCV, Promotion:sec:Datenanalyse-Synthese, Promotion:chap:04-04},
	annote = {Begründung aus Sicht der mdaCV und der Theorie von Rakhlin \& Caponnetto (2006)


Silhouette-Score als Evidenz:
In deiner Analyse wurde bei K = 4 ein Silhouette-Score von über 0\{,\}97 erreicht. Das spricht für eine ausgezeichnete Trennschärfe und geringe Überschneidung der Cluster – ein zentrales Kriterium für Stabilität.


Stabilitätstheorie gemäß {\textbackslash}mathcal\{H\}\_K:
Laut Rakhlin \& Caponnetto hängt die Stabilität des K-Means-Algorithmus davon ab, ob für eine gegebene Clusteranzahl K die Minimierung des empirischen Risikos einen eindeutigen Minimierer ergibt. Bei stabiler Clustereinteilung (also geringer Sensitivität gegenüber kleinen Datenänderungen) lässt sich indirekt auf die Existenz eines solchen eindeutigen Minimierers schließen.


mdaCV-Testdaten sprechen für strukturelle Belastbarkeit:
Deine Tests mit zufälligen, manipulierten und realen Daten zeigen, dass bei K = 4 die Clustereinteilung robust gegenüber semantischem Rauschen ist – auch das ist ein indirekter Nachweis für Stabilität im Sinne der geometrischen Struktur von {\textbackslash}mathcal\{H\}\_K.


Semantische Interpretierbarkeit:
Die inhaltliche Nachvollziehbarkeit der vier Cluster (z. B. Instructional Design, Technologieintegration etc.) ist ein zusätzlicher, qualitativer Validitätsindikator.







Fazit:



Ja, deine Wahl von K = 4 ist sowohl empirisch begründet (Silhouette-Score, Testdatenvergleich) als auch theoretisch gestützt (gemäß der Analyse von Rakhlin \& Caponnetto zur Stabilität in {\textbackslash}mathcal\{H\}\_K). Sie ist im Rahmen der mdaCV als methodisch valide und stabil anzusehen – unter besonderer Betonung der Reproduzierbarkeit und semantischen Kohärenz deiner deduktiven Struktur.

},
	annote = {{\textless}!-- codex:methodenkritik:04-04 --{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Methodenkritik (Anschlussstelle: Clustering/Segmentierung im embedding-basierten Workflow, Robustheit der Kategorien){\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}p{\textgreater}Der Beitrag liefert die theoretische Schärfung für eine typische Schwachstelle embedding-basierter Strukturierungen: K-Means lässt sich als Empirical-Risk-Minimization fassen, und Stabilität ist nicht garantiert, sondern an die Geometrie der Zielfunktion bzw. an die Frage gekoppelt, ob ein eindeutiger globaler Minimierer existiert. Im Fall eines eindeutigen globalen Minimierers ist die Lösung stabil, bei mehreren Minimierern existiert ein Bereich, in dem relativ moderate Stichprobenänderungen einen Stabilitäts-zu-Instabilitäts-Übergang auslösen können. Das stützt in meiner Methodik die Forderung nach Robustheitsprüfungen (Sensitivität über Seeds/Splits/Resampling) und die Zurückbindung der Clusterverdichtungen an interpretative Anker, statt Cluster als „natürliche“ Kategorien zu reifizieren. (Rakhlin \& Caponnetto, o. J., S. 1–2){\textless}/p{\textgreater}{\textless}p{\textgreater}Wichtig ist auch der methodische Hinweis, dass Stabilität in der Praxis häufig zur Wahl von K verwendet wird und deshalb theoretisch fundierte Rezepte benötigt. Für mein Vorgehen heißt das: K wird nicht allein über eine scheinbare Stabilität gesetzt, sondern über eine Kombination aus theoriegeleiteten Erwartungen, empirischer Prüfung und dokumentierten Alternativen. (Rakhlin \& Caponnetto, o. J., S. 1){\textless}/p{\textgreater}},
	file = {PDF:/Users/jochenhanisch-johannsen/Zotero/storage/2U8T92S8/Rakhlin und Caponnetto - Stability of K-Means Clustering.pdf:application/pdf},
}

@incollection{park_fast_2011,
	address = {Berlin, Heidelberg},
	title = {Fast {Approximate} {Text} {Document} {Clustering} {Using} {Compressive} {Sampling}},
	copyright = {http://www.springer.com/tdm},
	isbn = {978-3-642-23782-9 978-3-642-23783-6},
