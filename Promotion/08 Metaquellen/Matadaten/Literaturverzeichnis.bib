@misc{markus_antonius_wirtz_kokonstruktion_2021,
	address = {Bern, Berlin},
	title = {Kokonstruktion},
	url = {https://dorsch.hogrefe.com/stichwort/kokonstruktion},
	language = {de-DE},
	urldate = {2025-12-29},
	journal = {Dorsch Lexikon der Psychologie},
	publisher = {Hogrefe Verlag},
	author = {Grell, Frithjof},
	editor = {{Markus Antonius Wirtz}},
	month = mar,
	year = {2021},
	keywords = {Definition, Promotion:Literaturverzeichnis, Kokonstruktion},
	annote = {[engl. coconstruction; lat. co- zusammen, construere errichten], [EW, PÄD], anknüpfend an Grundannahmen des Konstruktivismus wird mit dem Begriff der Kokonstruktion die Bedeutung sozialer Interaktionen und (meist sprachlicher) Aushandlungsprozesse zw. zwei und mehr Personen für indiv. Lern- und Bildungsprozesse hervorgehoben. Über diese generelle Einordnung hinaus wird der Begriff der Kokonstruktion sehr breit und uneinheitlich verwendet. Der mitunter stark abweichende Wortgebrauch ist dabei hauptsächlich seiner Verwurzelung in unterschiedlichen Begriffstraditionen geschuldet. In Anschluss an J. Youniss werden Aushandlungs- und Kooperationsprozesse unter eher gleichberechtigten Interaktionspartnern (Freundschaftsbeziehungen (Peergroup) als Kokonstruktion bez., wenn diese durch wechselseitige Rückmeldungen (Feedback), Kompromisse, Austausch von Sichtweisen etc. für alle Beteiligten neue Perspektiven sozialen und moralischen Lernens eröffnen. Während in dieser Sicht die Möglichkeiten der Kokonstruktion unter konstitutiv ungleichen Interaktionspartnern (z. B. Erwachsener – Kind) als sehr begrenzt eingeschätzt werden, wird mit dem Begriff der Kokonstruktion auf der anderen Seite gerade auf die spezif. Bedeutung der Beziehungen zw. kompetenteren Anderen und dem Lernenden hingewiesen. So wird in Anschluss an L.S. Vygotskij (Entwicklung, soziokultureller Ansatz nach Wygotski/Vygotskij) bes. die kult. Verankerung indiv. Entwicklungsprozesse betont. Lernprozesse (Lernen, Lernforschung) in kult. geprägten Handlungsstrukturen vollziehen sich demnach zunächst durch Interiorisierung von und zunehmend autonome und geläufige Teilnahme an kult. Diskursen. In Abgrenzung zum Begriff der indiv. Selbstbildung findet der Begriff der Kokonstruktion aktuell in der Elementarpädagogik (Vorschulerziehung) Verwendung, um neben der kindlichen Aktivität die unverzichtbare Rolle kompetenterer Personen (Eltern, Erzieherinnen und Lehrpersonen) für die kognitive Entwicklung und soziale Entwicklung zu betonen. I. d. S. wird die aktiv rekonstruierende Kokonstruktion als Schlüssel zur Umformung basaler psych. Funktionen in kult. geprägte höhere geistige Funktionen gesehen und setzt solche Interventionen (Vermittlung, Unterstützung, Anregung) durch kompetentere Interaktionspartner voraus.
Referenzen und vertiefende Literatur
Youniss, J. (1994). Soziale Konstruktion und psychische Entwicklung. Frankfurt: Suhrkamp.
},
}

@misc{wirtz_konstruktivismus_2021,
	address = {Bern, Berlin},
	title = {Konstruktivismus, radikaler},
	url = {https://dorsch.hogrefe.com/stichwort/konstruktivismus-radikaler},
	language = {de-DE},
	urldate = {2025-12-29},
	journal = {Dorsch Lexikon der Psychologie},
	publisher = {Hogrefe Verlag},
	editor = {Wirtz, Markus Antonius},
	month = nov,
	year = {2021},
	keywords = {Definition, Promotion:Literaturverzeichnis},
	annote = {Konstruktivismus, radikaler [engl. radical constructivism; lat. radix Wurzel], [PHI], der radikale Konstruktivismus ist eine Form eines Konstruktivismus, der auf Erkenntnissen der Neurobiologie aufbaut. Personen sind autopoietische, selbstreferenzielle, operativ geschlossene Systeme (Autopoiese). Jeder neuronale Zustand ist das Resultat einer Interaktion früherer neuronaler Zustände; die Reaktion der Sinnesorgane lässt keinen Schluss auf die Beschaffenheit der Ursache zu (spezifische Sinnesenergien). Die Vorstellung von einer äußeren Welt sei eine vom Gehirn konstruierte, überlebensdienliche Fiktion. Es gebe kein Wissen i. S. des erkenntnistheoretischen Realismus. Gegen den radikalen Konstruktivismus wird vor allem eingewendet, dass er selbstwiderlegend sei: Wenn wir nichts über die Realität wüssten, dann auch nicht, dass wir autopoietische Systeme sind.
},
}

@incollection{benner_lernen_2004,
	address = {Weinheim und Basel},
	title = {Lernen},
	isbn = {978-3-407-29112-7},
	language = {de-DE},
	booktitle = {Historisches {Wörterbuch} der {Pädagogik}},
	publisher = {Beltz Verlag},
	author = {Künzli, Rudolf},
	editor = {Benner, Dietrich and Oelkers, Jürgen},
	year = {2004},
	keywords = {Promotion:Literaturverzeichnis, Promotion:sec:Systemisch-konstruktivistische-Theorie, Promotion:chap:04-02},
	pages = {620--637},
	annote = {Einordnung des Lernbegriffs nach Künzli (2004)
(verwendbar für Abschnitt 2.2.2 oder als Brückenelement zwischen 2.1 und 2.2 – zur begrifflichen Rahmung subjektiver Lernprozesse im digitalen Bildungsraum)
Künzli (2004) entfaltet im Historischen Wörterbuch der Pädagogik eine systematische Differenzierung des Lernbegriffs zwischen alltagssprachlichen, psychologischen und pädagogischen Verwendungsweisen. Für die vorliegende Arbeit besonders anschlussfähig ist sein Hinweis, dass „Lernen“ nicht als neutraler oder technischer Vorgang, sondern als pädagogisch gerahmte Deutungskategorie verstanden werden muss, die stets auch normative Setzungen transportiert (S. 559–560).
Künzli zeichnet die Verschiebung von behavioristischen zu kognitivistischen und konstruktivistischen Lernmodellen nach. Dabei hebt er hervor, dass Lernen in der Pädagogik nicht allein über beobachtbares Verhalten, sondern über zumutbare Aneignungs- und Deutungsprozesse konzipiert wird – ein Ansatz, der in der systemisch-konstruktivistischen Perspektive der Dissertation aufgegriffen und durch subjektive Trägervariablen wie Bedürfnisse, Emotionen und Neugier erweitert wird (S. 561–562).
Besonders aufschlussreich ist Künzlis Kritik an funktionalistischen und ökonomisierten Lernbegriffen. Er warnt davor, Lernen mit bloßer Wissensaufnahme gleichzusetzen oder auf messbare Outcomes zu reduzieren. Stattdessen plädiert er für eine pädagogische Rekonstruktion des Lernbegriffs, der das lernende Subjekt, seine Biografie, Kontextbedingungen und Kontingenzerfahrungen in den Mittelpunkt stellt (S. 563–564). Diese Perspektive trägt wesentlich dazu bei, das in Abschnitt 2.5 eingeführte Modell als dynamisches, rückgekoppeltes System theoretisch zu fundieren.
Für die Gestaltung digitaler Bildungsräume ist Künzlis Position besonders relevant, da sie eine kritische Distanz zu technologisch-instrumentellen Lerndesigns erlaubt und gleichzeitig Wege aufzeigt, wie Lernräume als Ermöglichungsräume pädagogischer Kommunikation konzipiert werden können (S. 565).
},
	file = {Künzli - 2004 - Lernen:/Users/jochenhanisch-johannsen/Zotero/storage/TYG85TVD/Künzli - 2004 - Lernen.pdf:application/pdf},
}

@incollection{benner_didaktik_2004,
	address = {Weinheim und Basel},
	title = {Didaktik},
	isbn = {978-3-407-29112-7},
	language = {de-DE},
	booktitle = {Historisches {Wörterbuch} der {Pädagogik}},
	publisher = {Beltz Verlag},
	author = {Wigger, Lothar},
	editor = {Benner, Dietrich and Oelkers, Jürgen},
	year = {2004},
	keywords = {Promotion:Literaturverzeichnis},
	pages = {244--278},
	annote = {Einordnung des Didaktikbegriffs nach Wigger (2004)
(verwendbar für Abschnitt 2.2.2 der Dissertation – systemisch-konstruktivistische Theorie)
Der Beitrag von Wigger (2004) im Historischen Wörterbuch der Pädagogik entfaltet den Didaktikbegriff in historischer Tiefenschärfe und legt dabei besonderes Augenmerk auf die Transformation didaktischer Paradigmen seit dem 18. Jahrhundert. Er beschreibt die Entwicklung von der Instruktionsorientierung hin zu offeneren Konzepten reflexiver, subjektbezogener Bildung, wobei die klassische Frage nach der Steuerung des Lernprozesses zunehmend durch Fragen der Selbststeuerung, Sinnbildung und strukturellen Kopplung ersetzt wird.
Zentral ist Wiggers Unterscheidung zwischen Didaktik als Theorie des Unterrichts (bzw. der „Vermittlung“) und Didaktik als Theorie des Lernens unter bestimmten gesellschaftlichen Bedingungen. In dieser Differenz zeigt sich eine Bewegung weg vom engen Steuerungsverständnis hin zu einer systemisch angelegten Theorie pädagogischer Kommunikation, die von Eigenlogiken des Subjekts und des Bildungsprozesses ausgeht (S. 182–184).
Für systemisch-konstruktivistische Bildungsmodelle ist besonders Wiggers Verweis auf die Erweiterung des didaktischen Feldes durch kommunikations- und systemtheoretische Perspektiven von Relevanz. Er verweist auf Luhmanns Theorie sozialer Systeme, die pädagogische Prozesse als Kontingenzbewältigung in struktureller Kopplung beschreibt (S. 185). Damit wird Didaktik nicht als planbare Interaktion, sondern als Strukturangebot zur Ermöglichung von Anschlusskommunikation lesbar – ein Gedanke, der das hier entwickelte Modell des Bildungswirkgefüges theoretisch fundiert.
Zusammenfassend liefert Wigger (2004) eine begrifflich und historisch differenzierte Perspektive auf Didaktik, die systemische Theorieansätze anschlussfähig macht und den Übergang von einer technologischen zu einer kontingenzsensiblen Gestaltungsperspektive begründet.
},
	file = {Wigger - 2004 - Didaktik:/Users/jochenhanisch-johannsen/Zotero/storage/ESRN5WIT/Wigger - 2004 - Didaktik.pdf:application/pdf},
}

