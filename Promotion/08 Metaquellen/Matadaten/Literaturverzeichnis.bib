@incollection{wise2024Clt,
  title = {Collaborative {{Learning Theory}} and {{Analytics}}},
  booktitle = {Theory {{Informing}} and {{Arising}} from {{Learning Analytics}}},
  author = {Wise, Alyssa~Friend},
  editor = {Bartimote, Kathryn and Howard, Sarah K. and Gašević, Dragan},
  date = {2024},
  pages = {105--124},
  publisher = {Springer Nature Switzerland},
  location = {Cham},
  doi = {10.1007/978-3-031-60571-0_7},
  url = {https://link.springer.com/10.1007/978-3-031-60571-0_7},
  urldate = {2025-01-01},
  abstract = {While much work in learning analytics focuses on understanding and supporting the individual learner, a great deal of learning activity happens in groups, offering opportunities to generate insight into joint learning practices. How learners interact with each other in support of learning has been a topic of rich theorization for some time, from early work on face-to-face cooperation to more recent attention focused on computer-supported collaborative learning (CSCL). This chapter unpacks four different relationships between collaborative learning theory and learning analytics (Application, Testing/Refinement, Generation, and Implementation) by examining work related to theories of joint attention, online listening, and knowledge building. Considering the relationship between theory and analytics as mediated by elements of technology, pedagogy, epistemology, and data, the chapter offers guidance for selecting relevant collaborative learning theory for particular analytic uses and overviews central issues to be considered in such use (e.g. group versus individual units of analysis, leveraging constructs and/or process models, inclusion of temporality, appropriate audiences to interpret and act on analytic outputs).},
  isbn = {978-3-031-60570-3 978-3-031-60571-0},
  langid = {british},
  keywords = {b:Buchteil:online:learning,Charité:Promotion,Leraning:Analytics,Promotion:Literaturanalyse,Promotion:S:11 Online Learning},
  file = {/Users/jochen_hanisch-johannsen/Zotero/storage/GX6NSIIH/Wise - 2024 - Collaborative Learning Theory and Analytics.pdf}
}

@article{wisshak2021Weu,
  title = {Wie erleben und bewältigen Lehrende der berufsbezogenen Weiterbildung Folgen der Corona-Pandemie?},
  author = {Wißhak, Susanne and Hochholdinger, Sabine},
  date = {2021-11-19},
  journaltitle = {Zeitschrift für Weiterbildungsforschung},
  shortjournal = {ZfW},
  issn = {2364-0014, 2364-0022},
  doi = {10.1007/s40955-021-00193-4},
  url = {https://link.springer.com/10.1007/s40955-021-00193-4},
  urldate = {2021-11-28},
  abstract = {This qualitative study explores the question of how trainers in workrelated continuing education experienced and coped with the consequences of the COVID-19-pandemic in terms of the uncertainties and professional demands that accompanied it. Based on competency models for teachers in continuing education, we looked at the changes in their professional situation, the changed requirements with regard to digitalization, and their self-regulation and coping strategies. For this purpose, we evaluated 22 text-based contributions of a web parade from late summer 2020 using qualitative content analysis. We found that after initial uncertainty, trainers responded proactively and pragmatically, embracing digitization as a learning opportunity. To acquire the necessary competencies, they appear to use online trainer training and informal channels. From a didactic point of view, digitization seems to offer advantages for demand-oriented and effective continuing education, with simultaneous difficulties resulting from physical distance, especially for interaction and relationship building. Implications for the individual professionalization of trainers are discussed.},
  langid = {ngerman},
  keywords = {0:Zeitschriftenartikel:digital:learning,Charité:Promotion,Promotion:Literaturanalyse,Promotion:S:12 Digital Learning},
  annotation = {ZSCC: 0000000},
  file = {/Users/jochen_hanisch-johannsen/Zotero/storage/NSCC4L3Z/Wißhak und Hochholdinger - 2021 - Wie erleben und bewältigen Lehrende der berufsbezo.pdf}
}

