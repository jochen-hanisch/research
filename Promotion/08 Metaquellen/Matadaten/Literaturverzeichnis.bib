	keywords = {Charité:Promotion, Promotion:Literaturanalyse, \#0:Buchteil:digital:learning, Promotion:S:12 Digital Learning, Promotion:Literaturverzeichnis},
	pages = {309--316},
	file = {Bauters - 2024 - Embodied Learning – Are We Losing It.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/XIF9MTYV/Bauters - 2024 - Embodied Learning – Are We Losing It.pdf:application/pdf},
