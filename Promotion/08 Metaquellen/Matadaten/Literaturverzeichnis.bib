	doi = {10.1007/s00112-024-02006-7},
	abstract = {Fazit für die Praxis 4 Kinder und Jugendliche als „digital natives“ leben in einer Welt mit allzeit präsenten digitalen Medien. Die Aufgabe der sie begleitenden Erwachsenen ist es, sie im Umgang mit diesen zu Schulen.},
	language = {de-DE},
