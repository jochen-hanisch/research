	keywords = {Charité:Promotion, Promotion:Literaturanalyse, Promotion:FU4a, Promotion:Kerngedanke, Promotion:FU4b, Promotion:01-02, Promotion:Eye-Tracking, Leseprozess, Bilinguale, leises – lautes Lesen, Diagnostik, Promotion:01-02 Methodenquellen, Promotion:Literaturverzeichnis},
	file = {Krause und Ritter - 2024 - Lesen als Prozess Empirische Befunde und didaktis.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/VPWB7DW5/Krause und Ritter - 2024 - Lesen als Prozess Empirische Befunde und didaktis.pdf:application/pdf},
