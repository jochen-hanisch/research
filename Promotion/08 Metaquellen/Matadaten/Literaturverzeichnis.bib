@article{vonkeyserlingk2025Msl,
  title = {Motivation and Self-Regulated Learning as Predictors of Learning Resource Use in Learning Management Systems in Higher Education},
  author = {Von Keyserlingk, Luise and Schwerter, Jakob and Kunina-Habenicht, Olga and Lauermann, Fani},
  date = {2025-10-11},
  journaltitle = {Educational Psychology},
  shortjournal = {Educational Psychology},
  pages = {1--21},
  issn = {0144-3410, 1469-5820},
  doi = {10.1080/01443410.2025.2564891},
  url = {https://www.tandfonline.com/doi/full/10.1080/01443410.2025.2564891},
  urldate = {2025-10-14},
  abstract = {Learning resources provided in learning management systems (LMS) are often underutilised despite their effectiveness for student learning. This study examined how students’ motivation (i.e. expectancies, subjective task values [STVs], and cost values) and selfregulated learning (SRL; metacognitive strategies, internal resource management, procrastination) relate to their LMS resources utilisation and subsequent performance. Survey and digital trace data from 490 social science university students were analysed. Higher STVs positively predicted students’ use of learning resources, including lecture slides and practice quizzes, whereas procrastination negatively predicted resource utilisation. Greater use of practice quizzes was associated with improved exam grades. Moreover, STVs indirectly supported better exam performance through increased LMS resource utilisation, while procrastination had an indirect negative effect. Findings emphasise the critical role of motivation and SRL in influencing learning behaviours. Educators are encouraged to promote motivation, support SRL strategies, and include practice opportunities in LMS environments to support student learning.},
  langid = {english},
  keywords = {1:Zeitschriftenartikel:learning:management:system,Bildungstheorien,Charité:Promotion,Forschungsansätze,Lehr- und Lerneffektivität,Promotion:FU4a,Promotion:Kerngedanke,Promotion:Literaturanalyse,Promotion:Relevanz:5,Systemanpassung,Technologieintegration},
  file = {/Users/jochen_hanisch-johannsen/Zotero/storage/3DIMZ7EH/Von Keyserlingk et al. - 2025 - Motivation and self-regulated learning as predictors of learning resource use in learning management.pdf}
}

