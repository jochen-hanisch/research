  shorttitle = {Lernen mit und über digitale Medien im Sachunterricht},
  author = {Kunkel, Carmen and Peschel, Markus},
  date = {2020-08-13},
  journaltitle = {MedienPädagogik: Zeitschrift für Theorie und Praxis der Medienbildung},
