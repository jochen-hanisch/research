  title = {Wissenssicherung in lernenden Verwaltungen: Demografische Herausforderung, Aufgabenwandel und digitale Transformation am Beispiel Österreichische Bundesverwaltung},
  shorttitle = {Wissenssicherung in lernenden Verwaltungen},
  author = {Schuppan, Tino and Brüggemeier, Martin},
  date = {2024},
  publisher = {Nomos Verlagsgesellschaft mbH \& Co. KG},
  doi = {10.5771/9783748919339},
  url = {https://www.nomos-elibrary.de/index.php?doi=10.5771/9783748919339},
  urldate = {2023-12-23},
  abstract = {Under the influence of digitisation, work in the engine room of the ‘state ship’ is changing. At the same time, knowledge and skills are at risk of leaving the ship with the retiring Boomer generations. Using the Austrian federal administration as an example, this book identifies and analyses the challenges and solutions that can be found in practice in this regard. However, one-sided efforts to retain and transfer knowledge run the risk of putting themselves at a disadvantage when it comes to innovation. Instead of a carefully nurtured ‘legacy of the analogue world of administration’, what is needed is a strategic approach to what smart organisational learning and ‘unlearning’ need to be like in times of demographic change and digital transformation.},
  isbn = {978-3-7489-1933-9},
  langid = {ngerman},
  keywords = {0:Buch:digital:learning,Charité:Promotion,Promotion:Literaturanalyse,Promotion:S:12 Digital Learning},
  file = {/Users/jochen_hanisch-johannsen/Zotero/storage/2VNBQ27G/9783748919339-121.pdf;/Users/jochen_hanisch-johannsen/Zotero/storage/A9779KKN/9783748919339-129.pdf;/Users/jochen_hanisch-johannsen/Zotero/storage/ABGZFMGS/9783748919339-107.pdf;/Users/jochen_hanisch-johannsen/Zotero/storage/ABW4IWPI/Schuppan und Brüggemeier - 2024 - Wissenssicherung in lernenden Verwaltungen Demogr.pdf;/Users/jochen_hanisch-johannsen/Zotero/storage/HGGBE3HL/9783748919339-23.pdf;/Users/jochen_hanisch-johannsen/Zotero/storage/PAXWJ2WD/9783748919339-13.pdf;/Users/jochen_hanisch-johannsen/Zotero/storage/Q9YA5G8C/9783748919339-43.pdf}
