@article{yadav_high-performance_2023,
	title = {High-performance work system and learning orientation in offline, online, and hybrid workplaces: the mediating role of affective commitment},
	issn = {0969-6474, 0969-6474},
	shorttitle = {High-performance work system and learning orientation in offline, online, and hybrid workplaces},
	url = {https://www.emerald.com/insight/content/doi/10.1108/TLO-10-2022-0118/full/html},
	doi = {10/gs3qfb},
	abstract = {Purpose – The present study primarily aims to investigate the role of the high-performance work system (HPWS) in shaping learning orientation (LO). Moreover, the study delves into the examination of affective commitment’s (AC) role as a mediator. Additionally, the research extends to exploring the potential moderating impact of workplace settings, speciﬁcally ofﬂine, online and hybrid workplaces, on the mediated relationship.},
