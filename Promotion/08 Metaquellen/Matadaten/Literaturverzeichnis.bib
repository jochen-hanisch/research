	keywords = {Charité:Promotion, Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Systemanpassung, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {32--40},
	file = {Barta et al. - 2021 - Time Perspectives as The Predictors of Online Self.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/TQ63IH7P/Barta et al. - 2021 - Time Perspectives as The Predictors of Online Self.pdf:application/pdf},
