	year = {2023},
	keywords = {Charité:Promotion, Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:FU3, Promotion:FH, \#3:Zeitschriftenartikel:online:Lernumgebung, Promotion:S:03 Online-Lernumgebung, Promotion:Literaturverzeichnis},
