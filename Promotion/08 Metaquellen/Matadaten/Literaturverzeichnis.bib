	type = {Statistik},
	title = {Top 10 der {Länder} mit den höchsten {Umsätzen} im {Markt} für {Online}-{Bildung}},
	url = {https://de.statista.com/statistik/daten/studie/1401761/umfrage/top-10-laender-hoechste-umsaetze-markt-online-bildung/},
	abstract = {Laut Statista Market Insights wurden in den USA im Jahr 2022 rund 61,3 Milliarden US-Dollar im Markt für Online-Bildung erwirtschaftet. Die Vereinigten Staaten dominieren den Markt damit gemeinsam mit China (46,9 Milliarden US-Dollar) - auf dem dritten Platz folgt mit großem Abstand das Vereinigte Königreich. Hier wurden im Jahr 2022 rund acht Milliarden US-Dollar umgesetzt.},
