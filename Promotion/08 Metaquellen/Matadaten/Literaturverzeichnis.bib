	keywords = {Promotion:Literaturanalyse, \#0:Zeitschriftenartikel:digital:learning, Bildung, Virtuelle Arbeitswelt, On line, Online, Sozialwissenschaft, COVID-19, Pandemie, Gestaltung, Online-Kommunikation, Videokonferenz, Promotion:S:12 Digital Learning, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	file = {Susman, Krista - 2022 - Die Psychologie des virtuellen Raums. Begegnungsfö.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/NC546GFT/Susman, Krista - 2022 - Die Psychologie des virtuellen Raums. Begegnungsfö.pdf:application/pdf},
