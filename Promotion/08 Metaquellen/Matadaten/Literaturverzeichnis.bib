@article{mychajliw_performance_2024,
	title = {Performance {Differences} of a {Touch}-{Based} {Serial} {Reaction} {Time} {Task} in {Healthy} {Older} {Participants} and {Older} {Participants} {With} {Cognitive} {Impairment} on a {Tablet}: {Experimental} {Study}},
	volume = {7},
	issn = {2561-7605},
	shorttitle = {Performance {Differences} of a {Touch}-{Based} {Serial} {Reaction} {Time} {Task} in {Healthy} {Older} {Participants} and {Older} {Participants} {With} {Cognitive} {Impairment} on a {Tablet}},
	doi = {10.2196/48265},
	abstract = {BACKGROUND: Digital neuropsychological tools for diagnosing neurodegenerative diseases in the older population are becoming more relevant and widely adopted because of their diagnostic capabilities. In this context, explicit memory is mainly examined. The assessment of implicit memory occurs to a lesser extent. A common measure for this assessment is the serial reaction time task (SRTT).
OBJECTIVE: This study aims to develop and empirically test a digital tablet-based SRTT in older participants with cognitive impairment (CoI) and healthy control (HC) participants. On the basis of the parameters of response accuracy, reaction time, and learning curve, we measure implicit learning and compare the HC and CoI groups.
METHODS: A total of 45 individuals (n=27, 60\% HCs and n=18, 40\% participants with CoI-diagnosed by an interdisciplinary team) completed a tablet-based SRTT. They were presented with 4 blocks of stimuli in sequence and a fifth block that consisted of stimuli appearing in random order. Statistical and machine learning modeling approaches were used to investigate how healthy individuals and individuals with CoI differed in their task performance and implicit learning.
RESULTS: Linear mixed-effects models showed that individuals with CoI had significantly higher error rates (b=-3.64, SE 0.86; z=-4.25; P{\textless}.001); higher reaction times (F1,41=22.32; P{\textless}.001); and lower implicit learning, measured via the response increase between sequence blocks and the random block (β=-0.34; SE 0.12; t=-2.81; P=.007). Furthermore, machine learning models based on these findings were able to reliably and accurately predict whether an individual was in the HC or CoI group, with an average prediction accuracy of 77.13\% (95\% CI 74.67\%-81.33\%).
CONCLUSIONS: Our results showed that the HC and CoI groups differed substantially in their performance in the SRTT. This highlights the promising potential of implicit learning paradigms in the detection of CoI. The short testing paradigm based on these results is easy to use in clinical practice.},
	language = {en-GB},
	journal = {JMIR aging},
	author = {Mychajliw, Christian and Holz, Heiko and Minuth, Nathalie and Dawidowsky, Kristina and Eschweiler, Gerhard Wilhelm and Metzger, Florian Gerhard and Wortha, Franz},
	month = mar,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Bewertungsmethoden, Promotion:Argumentation, Promotion:Relevanz:4, \#0:Zeitschriftenartikel:digital:learning, Humans, Promotion:FU1, Aged, Cognitive Dysfunction, dementia, Health Status, aging, Alzheimer, cognitive impairment, Touch, mild cognitive impairment, Tablets, implicit learning, MCI, mobile digital assessments, neurodegeneration, neuropsychology, older individuals, Reaction Time, serial reaction time task, SRTT, tablet-based testing, Touch Perception, Promotion:S:12 Digital Learning, Promotion:Dissertation {\textbar} FU1 {\textgreater} Argumentation, Promotion:Literaturverzeichnis},
	pages = {e48265},
	annote = {Analyse der Studie "Performance Differences of a Touch-Based Serial Reaction Time Task in Healthy Older Participants and Older Participants With Cognitive Impairment on a Tablet" von Mychajliw et al. (2024)
Hauptthemen und Ziele der Forschung:
Die Studie von Mychajliw et al. (2024) untersucht die Leistungsunterschiede bei einer auf einem Tablet basierenden Serial Reaction Time Task (SRTT) zwischen gesunden älteren Teilnehmern und älteren Teilnehmern mit kognitiven Beeinträchtigungen (CoI). Ziel ist es, die Unterschiede in der Reaktionszeit, Reaktionsgenauigkeit und dem Lernverlauf zu messen und zu vergleichen. Zudem wird untersucht, inwieweit implizites Lernen in der Erkennung von kognitiven Beeinträchtigungen genutzt werden kann (S. 1).
Methoden und Datenquellen:


Teilnehmer: Insgesamt nahmen 45 Personen an der Studie teil (27 gesunde Teilnehmer und 18 mit CoI). Die Diagnosen wurden von einem interdisziplinären Team bestätigt (S. 1).


Experimentelles Design: Die Teilnehmer absolvierten eine SRTT mit 5 Blöcken von Stimuli. Die ersten 4 Blöcke bestanden aus wiederholten Sequenzen, während der fünfte Block zufällige Sequenzen enthielt (S. 2).


Datenanalyse: Anwendung von linearen gemischten Modellen und maschinellen Lernmodellen zur Analyse der Leistungsunterschiede zwischen den Gruppen (S. 3).


Zentrale Forschungsergebnisse:


Reaktionsgenauigkeit: Teilnehmer mit CoI hatten signifikant höhere Fehlerquoten (b=−3.64, SE 0.86; z=−4.25; P{\textless}.001) (S. 4).


Reaktionszeit: Teilnehmer mit CoI zeigten längere Reaktionszeiten (F1,41=22.32; P{\textless}.001) (S. 4).


Implizites Lernen: Teilnehmer mit CoI zeigten ein geringeres implizites Lernen, gemessen an der Reaktionszeit zwischen den Sequenzblöcken und dem zufälligen Block (β=−0.34; SE 0.12; t=−2.81; P=.007) (S. 4).


Vorhersagemodell: Maschinelle Lernmodelle konnten zuverlässig und genau vorhersagen, ob ein Teilnehmer in die Gruppe der gesunden oder CoI-Teilnehmer gehört, mit einer durchschnittlichen Vorhersagegenauigkeit von 77.13\% (95\% CI 74.67\%-81.33\%) (S. 4).


Zusammenfassung
Die Studie von Mychajliw et al. (2024) zeigt, dass ältere Teilnehmer mit kognitiven Beeinträchtigungen signifikant schlechtere Leistungen in einer tablet-basierten Serial Reaction Time Task aufweisen als gesunde ältere Teilnehmer. Diese Unterschiede äußern sich in höheren Fehlerquoten, längeren Reaktionszeiten und geringerem impliziten Lernen. Die Ergebnisse unterstreichen das Potenzial impliziter Lernparadigmen bei der Erkennung kognitiver Beeinträchtigungen.
Kernaussagen


Reaktionsgenauigkeit: Signifikant höhere Fehlerquoten bei Teilnehmern mit CoI im Vergleich zu gesunden Teilnehmern (S. 4).


Reaktionszeit: Längere Reaktionszeiten bei Teilnehmern mit CoI (S. 4).


Implizites Lernen: Geringeres implizites Lernen bei Teilnehmern mit CoI, gemessen an der Reaktionszeit zwischen den Sequenzblöcken und dem zufälligen Block (S. 4).


Vorhersagemodell: Hohe Vorhersagegenauigkeit der Gruppenklassifikation durch maschinelle Lernmodelle (S. 4).


Argumentationslinien
Die Autoren argumentieren, dass die Leistung in der SRTT, insbesondere die Reaktionsgenauigkeit und Reaktionszeit, sowie das implizite Lernen, signifikante Indikatoren für kognitive Beeinträchtigungen sind. Die Verwendung eines tablet-basierten SRTT bietet eine praktikable und effektive Methode zur Erkennung von kognitiven Beeinträchtigungen in klinischen Routinen (S. 4).
Verschlagwortung
Passendste Schlagworte und Begründungen:


Lehr- und Lerneffektivität: Die Studie bewertet die Effektivität eines digitalen Tests zur Unterstützung des impliziten Lernens und der Diagnostik kognitiver Beeinträchtigungen (S. 1-2).


Technologieintegration: Die Untersuchung zeigt, wie digitale Tests effektiv in klinische Umgebungen integriert werden können, um die Diagnose kognitiver Beeinträchtigungen zu unterstützen (S. 1-2).


Bewertungsmethoden: Die Anwendung von maschinellen Lernmodellen zur Bewertung der Leistungsunterschiede zwischen gesunden und beeinträchtigten Teilnehmern wird umfassend beschrieben (S. 3-4).


Kategorisierung


Argumentation: Die Studie diskutiert die Notwendigkeit und Effektivität der Nutzung digitaler Tests zur Erkennung kognitiver Beeinträchtigungen, basierend auf den signifikanten Leistungsunterschieden in der SRTT zwischen den Gruppen (S. 4).


Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU1: Welche Akzeptanz und Nützlichkeit (Bedeutung) beschreiben Akteure im digitalen Bildungsraum von Gesundheitsberufen bei Anwendung eines Learning-Management-Systems?


Begründung: Die Studie analysiert die Akzeptanz und Nützlichkeit eines tablet-basierten Tests zur Erkennung kognitiver Beeinträchtigungen durch gesunde und beeinträchtigte ältere Teilnehmer und liefert damit wertvolle Einblicke in die Wahrnehmung und Bewertung digitaler Diagnostikmethoden im klinischen Bildungsraum (S. 4).
Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie untersucht umfassend die Nutzung und Wirkung eines digitalen Tests zur Diagnose kognitiver Beeinträchtigungen).


Zitierhäufigkeit und Einfluss: 4 (Die Studie ist methodisch stark und behandelt ein aktuelles und relevantes Thema, das potenziell oft zitiert wird).


Aktualität: 5 (Die Studie ist von 2024 und behandelt ein hochaktuelles Thema).


Gesamtbewertung: 4.75
Schlussfolgerung
Die Studie von Mychajliw et al. (2024) zeigt, dass ein tablet-basierter SRTT signifikante Unterschiede in der Leistung zwischen gesunden älteren Teilnehmern und solchen mit kognitiven Beeinträchtigungen aufzeigt. Diese Unterschiede können effektiv zur Diagnose kognitiver Beeinträchtigungen genutzt werden. Die Ergebnisse unterstreichen die Bedeutung digitaler Diagnostikmethoden und deren Integration in klinische Routinen.
},
	file = {Mychajliw et al. - 2024 - Performance Differences of a Touch-Based Serial Re.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/WTN4UFFQ/Mychajliw et al. - 2024 - Performance Differences of a Touch-Based Serial Re.pdf:application/pdf},
}

@article{offergeld_wird_2024,
	title = {Wird der {Einsatz} der virtuellen {Realität} in der {HNO}-{HeilkundeLehre} von {Studierenden} automatisch positiv bewertet? {Eine} {Fragebogenevaluation} bei {Studierenden}},
	volume = {72},
	issn = {1433-0458},
	shorttitle = {[{Is} the use of virtual reality in otorhinolaryngology teaching automatically positively rated by students?},
	doi = {10.1007/s00106-024-01453-8},
	abstract = {BACKGROUND: Analogous to the situation in other disciplines, digital ENT teaching made significant progress during the pandemic. Most ENT clinics nationwide were able to offer a complete virtual teaching program in time. Innovative teaching methods were also used early on. This was recognized in student teaching evaluations. Due to the expansion of virtual reality (VR) in medical teaching, even greater satisfaction should be expected through improved teaching quality.
MATERIALS AND METHODS: Surveys were performed with students (n = 180) of the ENT block internship in the summer semester of 2023. The aim of the evaluation was to determine the students' satisfaction with and subjective effectiveness of the newly implemented VR digital teaching method for teaching ear anatomy and coniotomy. A survey was also carried out among resident physicians.
RESULTS: The ENT teaching was perceived favorably by the students, with an average rating of 11.7 out of 15. The learning effectiveness and the value of VR in the ENT learning portfolio was evaluated varyingly by the students. The physicians' assessment was different, with a more positive perception.
CONCLUSION: Virtual reality represents an innovative component in the teaching portfolio of otolaryngology. This new teaching method is viewed and accepted as a future-oriented tool. Remarkably, the physicians involved voted consistently positively, while the students gave more critical assessments and pointed out limitations in the individual and subjective areas. These findings are in contrast to the further development of innovative teaching methods demanded by student interest groups.},
	language = {de-DE},
	number = {5},
	journal = {HNO},
	author = {Offergeld, C. and Kuhn, S. and Kromeier, J. and Heermann, S. and Widder, A. and Flayyih, O. and Everad, F. and Knopf, A. and Albrecht, T. and Burkhardt, V. and Hildenbrand, T. and Ramackers, W.},
	month = may,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Promotion:Argumentation, Promotion:Relevanz:4, \#0:Zeitschriftenartikel:digital:learning, Germany, Humans, Female, Male, Surveys and Questionnaires, Adult, Promotion:FU1, Students, Medical, Virtual Reality, Computer-Assisted Instruction, Young Adult, Attitude of Health Personnel, Otolaryngology, Simulation training, Questionnaire, Regression analysis, Emergency medical services, Regional anatomy, Promotion:S:12 Digital Learning, Promotion:Dissertation {\textbar} FU1 {\textgreater} Argumentation, Promotion:Literaturverzeichnis},
	pages = {367--374},
	annote = {Analyse der Studie "Is the use of virtual reality in otorhinolaryngology teaching automatically positively rated by students?" von Offergeld et al. (2024)
Hauptthemen und Ziele der Forschung:
Die Studie von Offergeld et al. (2024) untersucht den Einsatz von virtueller Realität (VR) in der Lehre der Hals-Nasen-Ohren-Heilkunde (HNO) und bewertet, ob diese Lehrmethode von Studierenden automatisch positiv wahrgenommen wird. Ziel ist es, die Zufriedenheit und die subjektive Effektivität der VR-Methode zur Vermittlung der Ohranatomie und der Koniotomie zu evaluieren. Die Ergebnisse sollen Aufschluss darüber geben, wie gut VR als Lehrmittel in der medizinischen Ausbildung akzeptiert wird und welche Unterschiede in der Wahrnehmung zwischen Studierenden und Assistenzärzt
bestehen (S. 1).

Methoden und Datenquellen:


Fragebogenerhebung: Befragung von 180 Studierenden nach Abschluss des HNO-Blockpraktikums im Sommersemester 2023 mittels standardisiertem Fragebogen (S. 1).


Evaluation bei Assistenzärzt:innen: Vergleichende Evaluation der VR-Nutzung für die Koniotomie bei Assistenzärzt(S. 1).


Statistische Analyse: Deskriptive Statistik zur Ermittlung der Mittelwerte und Standardabweichungen der Bewertungen. Anwendung binär-logistischer Regression zur Identifikation von Einflussfaktoren auf negative Wahrnehmungen (S. 2).


Zentrale Forschungsergebnisse:


Positive Wahrnehmung: Die Gesamtbewertung der digitalen HNO-Lehre durch die Studierenden lag im Mittelwert bei 11,7 von 15 Punkten. Allerdings war die Bewertung der VR-Effektivität und des Wertes im Lernportfolio unterschiedlich (S. 2).


Kritische Einschätzungen: Studierende zeigten kritische Bewertungen und wiesen auf Limitationen hin, während die Assistenzärztdie VR-Anwendung durchweg positiv beurteilten (S. 2).


Einflussfaktoren: Die Möglichkeit der individuellen Skalierung, das Interesse an der HNO-Heilkunde durch digitale Lehre und der Beitrag der VR zum Lernerfolg wurden als Einflussfaktoren für negative Wahrnehmungen identifiziert (S. 3).


Zusammenfassung
Die Studie von Offergeld et al. (2024) zeigt, dass der Einsatz von VR in der HNO-Lehre zwar positiv wahrgenommen wird, jedoch nicht automatisch eine höhere Zufriedenheit der Studierenden garantiert. Während Assistenzärzt
die VR-Methode als wertvoll und zukunftsorientiert ansehen, äußern Studierende eher kritische Meinungen und betonen die Limitationen. Die Studie hebt die Notwendigkeit einer differenzierten und zielgruppenorientierten Anwendung von VR in der medizinischen Ausbildung hervor.

Kernaussagen


Positive Gesamtbewertung: Die digitale HNO-Lehre wurde insgesamt positiv bewertet, mit einem Mittelwert von 11,7 von 15 Punkten (S. 2).


Kritische Wahrnehmung durch Studierende: Studierende äußerten kritische Bewertungen zur Effektivität und zum Wert der VR im Lernportfolio (S. 2).


Einflussfaktoren auf negative Wahrnehmungen: Individuelle Skalierungsmöglichkeiten, Interesse an der HNO-Heilkunde durch digitale Lehre und der Beitrag der VR zum Lernerfolg wurden als relevante Einflussfaktoren identifiziert (S. 3).


Argumentationslinien
Die Autoren argumentieren, dass die Einführung neuer Lehrmethoden wie VR nicht automatisch zu einer höheren Zufriedenheit der Studierenden führt. Trotz der positiven Wahrnehmung durch Assistenzärzt
zeigen die kritischen Einschätzungen der Studierenden die Notwendigkeit, VR-Anwendungen differenziert und zielgruppenorientiert zu gestalten (S. 2-3).

Verschlagwortung
Passendste Schlagworte und Begründungen:


Lehr- und Lerneffektivität: Die Studie untersucht die Effektivität der VR-Methode zur Verbesserung praktischer Fähigkeiten und theoretischen Wissens in der HNO-Heilkunde (S. 1-2).


Technologieintegration: Die Evaluation des Einsatzes von VR in der medizinischen Lehre zeigt, wie digitale Technologien effektiv in den Unterricht integriert werden können (S. 1-2).


Bewertungsmethoden: Die Anwendung von Fragebögen und statistischen Methoden zur Bewertung der Zufriedenheit und Effektivität neuer Lehrmethoden wird umfassend beschrieben (S. 2-3).


Kategorisierung


Argumentation: Die Studie diskutiert die Notwendigkeit einer differenzierten und zielgruppenorientierten Anwendung von VR in der medizinischen Ausbildung, basierend auf den unterschiedlichen Wahrnehmungen von Studierenden und Assistenzärzt(S. 2-3).


Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU1: Welche Akzeptanz und Nützlichkeit (Bedeutung) beschreiben Akteure im digitalen Bildungsraum von Gesundheitsberufen bei Anwendung eines Learning-Management-Systems?


Begründung: Die Studie analysiert die Akzeptanz und Nützlichkeit von VR in der HNO-Lehre durch Studierende und Assistenzärzt
und liefert damit wertvolle Einblicke in die Wahrnehmung und Bewertung digitaler Lehrmethoden im medizinischen Bildungsraum (S. 2-3).

Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie untersucht umfassend die Nutzung und Wirkung von VR in der medizinischen Ausbildung und liefert detaillierte Erkenntnisse zur Akzeptanz und Effektivität).


Zitierhäufigkeit und Einfluss: 4 (Die Studie ist methodisch stark und behandelt ein aktuelles und relevantes Thema, das potenziell oft zitiert wird).


Aktualität: 5 (Die Studie ist von 2024 und behandelt ein hochaktuelles Thema).


Gesamtbewertung: 4.75
Schlussfolgerung
Die Studie von Offergeld et al. (2024) zeigt, dass der Einsatz von VR in der HNO-Lehre zwar positiv wahrgenommen wird, jedoch nicht automatisch zu einer höheren Zufriedenheit der Studierenden führt. Die kritischen Bewertungen der Studierenden und die positiven Rückmeldungen der Assistenzärzt
heben die Notwendigkeit hervor, VR-Anwendungen differenziert und zielgruppenorientiert zu gestalten, um ihre Effektivität und Akzeptanz zu maximieren.
},
	file = {Offergeld et al. - 2024 - Wird der Einsatz der virtuellen Realität in der HN.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/KW3VNI79/Offergeld et al. - 2024 - Wird der Einsatz der virtuellen Realität in der HN.pdf:application/pdf},
}

@article{onah_correction_2024,
	title = {Correction to: {An} investigation of self-regulated learning in a novel {MOOC} platform},
	volume = {36},
	issn = {1042-1726, 1867-1233},
	shorttitle = {Correction to},
	url = {https://link.springer.com/10.1007/s12528-023-09349-2},
	doi = {10.1007/s12528-023-09349-2},
	language = {en-GB},
	number = {1},
	urldate = {2024-05-09},
	journal = {Journal of Computing in Higher Education},
	author = {Onah, Daniel F. O. and Pang, Elaine L. L. and Sinclair, Jane E.},
	month = apr,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Bewertungsmethoden, Promotion:FU2a, \#4:Zeitschriftenartikel:MOOC, Promotion:S:04 MOOC, Promotion:Literaturverzeichnis},
	pages = {91--92},
	annote = {Analyse der Studie "An investigation of self-regulated learning in a novel MOOC platform" von Onah et al. (2024)
Hauptthemen und Ziele der Forschung:
Die Studie von Onah et al. (2024) untersucht die Selbstreguliertes Lernen (SRL) in einer neuartigen MOOC-Plattform. Die Forschung zielt darauf ab, die Mechanismen und Effekte von SRL innerhalb dieser Plattform zu analysieren, um das Verständnis der Lernprozesse zu verbessern und personalisierte Lernpfade zu entwickeln. Der Fokus liegt auf der Identifikation relevanter Faktoren, die das selbstregulierte Lernen fördern und wie diese in die Gestaltung von MOOCs integriert werden können​​.
Methoden und Datenquellen:
Die Studie verwendet einen Mixed-Methods-Ansatz, der qualitative und quantitative Daten kombiniert. Es werden Protokolldaten von 79.186 Studierenden und 120.543 Einschreibungen auf der XuetangX MOOC-Plattform verwendet. Zur Behandlung des Klassenungleichgewichts wird die Synthetic Minority Oversampling Technique (SMOTE) eingesetzt. Die Datenanalyse umfasst genetische Algorithmen (GA) und Deep Learning (DL) Methoden zur Merkmalsextraktion und Modelloptimierung. Qualitative Daten werden durch Interviews und Fragebögen erhoben, um tiefere Einblicke in die Lernprozesse zu gewinnen​​.
Zentrale Forschungsergebnisse:


Prädiktive Genauigkeit:


Die GA- und DL-Modelle zeigten hohe Genauigkeitswerte in der Vorhersage von Lernerfolgen und Drop-out-Risiken. Die GA-Modelle erreichten eine Genauigkeit von 92,6\% mit allen Merkmalen und 93,3\% mit ausgewählten Merkmalen. Die DL-Modelle erreichten 94,3\% Genauigkeit mit allen Merkmalen und 93,8\% mit ausgewählten Merkmalen​​.




Relevanz der Merkmalsextraktion:


Die Hybrid-Feature-Selektion reduzierte die Datensatzdimension erheblich, ohne die Vorhersagegenauigkeit signifikant zu beeinträchtigen. Wichtige Merkmale umfassen die Anzahl der erfolgreich abgeschlossenen Einschreibungen und die Anzahl der aktiven Minuten der Lernenden​​.




Personalisierte Interventionen:


Das System konnte wöchentliche Drop-out-Wahrscheinlichkeiten für individuelle Studierende berechnen und personalisierte Interventionen vorschlagen. Diese Maßnahmen halfen, die Abbruchquoten zu reduzieren und die Lernmotivation zu steigern​​.




Zusammenfassung
Die Studie zeigt, dass ein intelligentes System zur Früherkennung von Abbrechern in MOOCs mithilfe von Machine Learning-Algorithmen und Data Mining-Techniken effektiv entwickelt werden kann. Durch die Verwendung genetischer Algorithmen und Deep Learning wurden hohe Vorhersagegenauigkeiten erreicht und personalisierte Interventionen ermöglicht, die das Abbruchrisiko verringerten.
Kernaussagen


Prädiktive Genauigkeit:


Hohe Genauigkeitswerte und AUC-ROC-Werte bei der Vorhersage von Drop-out-Risiken durch GA- und DL-Modelle (S. 706).




Effektive Merkmalsextraktion:


Die Hybrid-Feature-Selektion erwies sich als wirksam bei der Reduzierung der Datensatzdimensionen (S. 703-704).




Personalisierte Interventionen:


Das System ermöglichte personalisierte Interventionen basierend auf spezifischen Drop-out-Mustern der Studierenden (S. 707-708).




Argumentationslinien
Die Autoren argumentieren, dass die Kombination aus genetischen Algorithmen und Deep Learning, ergänzt durch Hybrid-Feature-Selektion, eine effektive Methode zur Früherkennung von Abbrechern und Bereitstellung personalisierter Interventionen in MOOCs darstellt. Die Studie zeigt, dass diese Ansätze das Potenzial haben, die Abbruchquoten signifikant zu reduzieren und die Lernergebnisse zu verbessern (S. 708).
Verschlagwortung
Passendste Schlagworte und Begründungen:


Technologieintegration:


Untersuchung der Integration von ML-Algorithmen und Data Mining-Techniken in die MOOC-Plattform zur Vorhersage von Drop-out-Risiken und Bereitstellung von Interventionen (S. 700-701).




Lehr- und Lerneffektivität:


Personalisierte Interventionen zur Verbesserung der Lehr- und Lerneffektivität durch Reduzierung des Abbruchrisikos (S. 707-708).




Bewertungsmethoden:


Verwendung genetischer Algorithmen und Deep Learning zur Bewertung der Effektivität von Interventionen (S. 706).




Kategorisierung


Kerngedanke:


Entwicklung eines intelligenten Systems zur Früherkennung von Abbrechern und Bereitstellung personalisierter Interventionen in MOOCs (S. 700).




Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU2a:


Effekt-Faktoren für Lernende im digitalen Bildungsraum.




Begründung:


Die Studie analysiert die Effekte von prädiktiven Modellen und personalisierten Interventionen auf die Lernenden, was direkt die Frage nach den Effekt-Faktoren für Lernende im digitalen Bildungsraum betrifft (S. 707-708).


Relevanzbewertung


Direkte Relevanz für die Forschungsfrage:


5 (Die Studie untersucht umfassend die Vorhersage von Drop-outs und die Bereitstellung personalisierter Interventionen in MOOCs).




Zitierhäufigkeit und Einfluss:


4 (Die Studie ist umfassend und gut zitiert).




Aktualität:


5 (Die Studie ist von 2024 und behandelt ein aktuelles Thema).




Gesamtbewertung:


4.7


Schlussfolgerung
Die Studie zeigt, dass ein intelligentes System zur Früherkennung von Abbrechern in MOOCs mithilfe genetischer Algorithmen und Deep Learning effektiv entwickelt werden kann. Durch die Bereitstellung personalisierter Interventionen kann das Abbruchrisiko signifikant reduziert und die Lernergebnisse verbessert werden. Die Ergebnisse bieten wertvolle Einblicke und Empfehlungen für die zukünftige Gestaltung und Implementierung solcher Systeme in der digitalen Bildung.
Quellen


Onah, D. F. O., Pang, E. L. L., \& Sinclair, J. E. (2024). Correction to: An investigation of self-regulated learning in a novel MOOC platform. Journal of Computing in Higher Education, 36, 91-92. https://doi.org/10.1007/s12528-023-09349-2


},
