@article{hejazi2023Epp,
  title = {The {{Effect}} of {{Practice Prescription E-Learning System}} on {{Learning}} and {{Motivation}} of {{Pharmacy Students}}},
  author = {Hejazi, Yamin and Emadzadeh, Setareh and Yavari, Mehri and Mastour, Haniye and Azad, Sajjad and Taherzadeh, Zhila},
  date = {2023-09-23},
  journaltitle = {Technology, Knowledge and Learning},
  shortjournal = {Tech Know Learn},
  issn = {2211-1662, 2211-1670},
  doi = {10/gsswbd},
  url = {https://link.springer.com/10.1007/s10758-023-09688-0},
  urldate = {2023-09-28},
  abstract = {Pharmacy education has seen a transformation with e-learning. Using a computer-supported collaborative learning environment has proven effective in achieving the learning objectives of the new curriculum in this field. The educational institutions offer the pharmacy internship course in the classroom and educational pharmacies in the presence of students. Because of Covid-19 restrictions, classes are being held online. Achieving the desired learning outcomes for this lesson can be challenging because of its practical and skill-based nature. As a result, creating customized learning experiences that align with the lesson’s objectives is crucial. This study was quasi-experimental and involved students who had selected an internship. The control group received traditional instruction, while the intervention group was taught using a combination of conventional education and an application. The learning outcomes were evaluated through learning and motivation tests using the MSLQ questionnaire. The intervention group had a mean score of 79\,±\,0.117, while the control group had a mean score of 69\,±\,0.195, showing that the intervention group had significantly higher learning (p\,{$<$}\,0.05). Regarding motivation, the intervention group had a mean score of 110.4\,±\,17.76, while the control group had a mean score of 113.94\,±\,19.67, with no significant difference observed (p\,{$>$}\,0.05). The application’s simulated pharmacy environment improved the conditions for trainees to read different prescription sheets, providing a realistic learning experience. Using the application increased students’ learning. Even though there was no significant variation in motivation between the two sets, students who used the app expressed a greater interest in education.},
  langid = {english},
  keywords = {5:Zeitschriftenartikel:e-learning,Bildung,Charité:Promotion,Kollaboratives Lernen,Lehr- und Lerneffektivität,Multimedia,Promotion:Argumentation,Promotion:Literaturanalyse,Systemanpassung,Technologieintegration},
  file = {/Users/jochen_hanisch-johannsen/Zotero/storage/PIZLNUBL/Hejazi et al. - 2023 - The Effect of Practice Prescription E-Learning Sys.pdf}
}

@article{heldtinken2022Dmd,
  title = {Digitalisierung, Mediatisierung, Demokratie. Politische Medienbildung als Anliegen und Auftrag der Erwachsenenbildung},
  author = {Heldt, Inken},
  date = {2022-05-05},
  publisher = {Bundesministerium für Bildung, Wissenschaft und Forschung},
  doi = {10/gp5kbb},
  url = {https://www.pedocs.de/frontdoor.php?source_opus=24479},
  urldate = {2022-05-14},
  abstract = {The author's basic thesis is that the digital transformation is "political" in a much more encompassing sense than generally considered. For the political aspect of the digital transformation is not exhausted in politics-related intentions by people acting in the digital public sphere but is a fundamental component of the functional logic and conditions of digital spaces. The interests of a variety of actors pervade their configuration and infrastructure. This has far-reaching consequences for the content and goals of political media education, which have hardly found their way into educational practice. One main task is to make people aware of the mostly inaccessible techno-social structures that inevitably leave a mark on them and how they live together and lead to a critical questioning of these structures by (not) allocating opportunities and ordering knowledge and relevance. These mostly invisible mechanisms must enter into view so that people are able to take a good look at the power relations inherent to the digital transformation. Thus, educational subjects should be encouraged to organize digital change actively and democratically. (DIPF/Orig.)},
  langid = {ngerman},
  keywords = {7:Zeitschriftenartikel:digital:Medien,Adult training,Algorithm,Algorithms,Algorithmus,Bildung,Bildungstheorien,Charité:Promotion,Critical thinking,Datenschutz und IT-Sicherheit,Digitale Bildung,Digitalisierung,Digitalization,Erwachsenenbildung,Forschungsansätze,Information literacy,Information skills,Kompetenz,Kritisches Denken,Media pedagogics,Mediatisierung,Medienpädagogik,Mündigkeit,Partizipation,Politische Erwachsenenbildung,Promotion:FU1,Promotion:Kerngedanke,Promotion:Literaturanalyse,Promotion:Relevanz:5,Technologieintegration},
