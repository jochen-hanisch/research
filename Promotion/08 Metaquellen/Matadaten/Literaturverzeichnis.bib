@article{tedla_impacts_2024,
	title = {The impacts of computer-supported collaborative learning on students’ critical thinking: a meta-analysis},
	issn = {1360-2357, 1573-7608},
	shorttitle = {The impacts of computer-supported collaborative learning on students’ critical thinking},
	url = {https://link.springer.com/10.1007/s10639-024-12857-y},
	doi = {10.1007/s10639-024-12857-y},
	abstract = {Critical thinking (CT) is among the core abilities students need to acquire to overcome the unprecedented and ever-changing challenges of the 21st century and beyond. To facilitate the attainment of CT, numerous researchers worldwide have conducted empirical studies focusing on leveraging computer-supported collaborative learning (CSCL) to improve students’ CT. Notwithstanding the existence of empirical studies, meta-analyses that clearly show the overall effect sizes (ESs) of the impacts are wanting. The current meta-analysis aimed at filling this lacuna by examining 30 empirical studies that were conducted between the years 2014 and 2023, stored in databases such as Scopus, the Web of Science, ERIC and Google Scholar, and search engines such as Google and Ecosia and that met the inclusion criteria. The study included journal articles, conference papers and student theses. The total number of participants in the studies was 2,980, representing 11 countries. The results indicated that CSCL was an effective instructional approach to foster students’ CT with statistically significant levels of overall ES estimates (ES = 0.859, z = 8.55, p {\textless} .001, 95\% CI [0.661–1.055]). The results also indicated that there was no apparent evidence of publication bias (Egger’s regression = 0.478, p {\textgreater} .05). Instructional activities, technology usage, participants’ level of education, dimensions of CT, intervention duration and sample size were found to significantly moderate the overall ES estimate. Based on the results, recommendations are made regarding effective ways to use digital technology and collaborative learning for honing students’ CT.},
	language = {en-GB},
	urldate = {2024-07-04},
	journal = {Education and Information Technologies},
	author = {Tedla, Yoseph Gebrehiwot and Chen, Hsiu-Ling},
	month = jun,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Promotion:Relevanz:4, \#0:Zeitschriftenartikel:digital:learning, Promotion:S:12 Digital Learning, Promotion:Literaturverzeichnis},
	annote = {Analyse des Artikels "The impacts of computer-supported collaborative learning on students’ critical thinking: a meta-analysis" von Yoseph Gebrehiwot Tedla und Hsiu-Ling Chen (2024)
1. Analyse
Hauptthemen und -ziele der Forschung: Der Artikel untersucht die Auswirkungen von computerunterstütztem kollaborativem Lernen (CSCL) auf das kritische Denken (CT) der Schüler. Ziel der Forschung ist es, durch eine Meta-Analyse die Wirksamkeit von CSCL zur Förderung des kritischen Denkens zu bewerten und die moderierenden Faktoren zu identifizieren, die diese Beziehung beeinflussen.
Verwendete Methoden und Datenquellen:


Methodische Ansätze: Der Artikel folgt einem Meta-Analyse-Ansatz unter Verwendung der PRISMA-Leitlinien (Preferred Reporting Items for Systematic Reviews and Meta-Analyses). Insgesamt wurden 30 empirische Studien aus den Jahren 2014 bis 2023 analysiert.


Werkzeuge und Datenquellen: Datenbanken wie Scopus, Web of Science, ERIC und Google Scholar wurden genutzt, um relevante wissenschaftliche Artikel, Konferenzberichte und studentische Arbeiten zu identifizieren.


Zentrale Forschungsergebnisse:


Wirksamkeit von CSCL: CSCL erwies sich als effektive Unterrichtsmethode zur Förderung des kritischen Denkens der Schüler mit einer signifikanten Effektgröße (ES = 0.859, z = 8.55, p {\textless} .001, 95\% CI [0.661–1.055]).


Moderierende Faktoren: Faktoren wie Unterrichtsaktivitäten, Technologieeinsatz, Bildungsniveau der Teilnehmer, Dimensionen des kritischen Denkens, Interventionsdauer und Stichprobengröße moderierten signifikant die Gesamt-Effektgröße.


Fehlender Publikationsbias: Es gab keine Hinweise auf einen Publikationsbias (Egger’s Regression = 0.478, p {\textgreater} .05).


2. Zusammenfassung
Kernpunkte des Artikels:


Problemstellung: Untersuchung der Wirksamkeit von CSCL zur Förderung des kritischen Denkens und der moderierenden Faktoren.


Methodik: Meta-Analyse von 30 Studien unter Verwendung der PRISMA-Leitlinien, Daten aus Scopus, Web of Science, ERIC und Google Scholar.


Hauptergebnisse: CSCL fördert das kritische Denken signifikant, mehrere moderierende Faktoren beeinflussen die Effektstärke.


Schlussfolgerungen: CSCL ist eine effektive Methode zur Förderung des kritischen Denkens. Weitere Forschungen sollten die identifizierten moderierenden Faktoren genauer untersuchen.


3. Kernaussagen


Wirksamkeit von CSCL: „CSCL was an effective instructional approach to foster students’ CT with statistically significant levels of overall ES estimates (ES = 0.859, z = 8.55, p {\textless} .001, 95\% CI [0.661–1.055]).“ (S. 2)


Moderierende Faktoren: „Instructional activities, technology usage, participants’ level of education, dimensions of CT, intervention duration and sample size were found to significantly moderate the overall ES estimate.“ (S. 2)


Fehlender Publikationsbias: „The results also indicated that there was no apparent evidence of publication bias (Egger’s regression = 0.478, p {\textgreater} .05).“ (S. 2)


4. Argumentationslinien


Wichtigkeit von CSCL: Der Artikel argumentiert, dass CSCL eine wichtige Methode ist, um das kritische Denken der Schüler zu fördern, und dass es eine signifikante positive Wirkung hat.


Moderierende Faktoren: Es wird betont, dass verschiedene Faktoren die Wirksamkeit von CSCL beeinflussen, darunter die Art der Unterrichtsaktivitäten, der Technologieeinsatz und das Bildungsniveau der Teilnehmer.


Empfehlungen für die Zukunft: Der Artikel schlägt vor, dass zukünftige Forschungen die identifizierten moderierenden Faktoren genauer untersuchen sollten, um die pädagogische Praxis weiter zu verbessern.


5. Verschlagwortung


Lehr- und Lerneffektivität:


Begründung: Der Artikel untersucht die Effektivität von CSCL zur Förderung des kritischen Denkens der Schüler.


Fundstelle: S. 2




Technologieintegration:


Begründung: Der Artikel behandelt den Einsatz von Technologie zur Unterstützung kollaborativer Lernaktivitäten.


Fundstelle: S. 2




6. Kategorisierung


Kategorie: Weiterführung


Kriterium: Der Artikel bietet Empfehlungen für zukünftige Forschungen und die Weiterentwicklung von CSCL zur Unterstützung des kritischen Denkens.


Beispiel: Diskussion der Notwendigkeit weiterer empirischer Studien und praktischer Implementierungen. (S. 2)




7. Zuordnung zu Forschungsfragen


FU2b: Welche Effekt-Faktoren erläutern Lehrende im digitalen Bildungsraum von Gesundheitsberufen bei der Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems?


Begründung: Der Artikel untersucht die Faktoren, die die Wirksamkeit von CSCL zur Förderung des kritischen Denkens beeinflussen.


Fundstelle: S. 2




Gesamtbewertung: 4/5
Diese Analyse zeigt die Relevanz des Artikels für die Untersuchung der Wirksamkeit von CSCL zur Förderung des kritischen Denkens und der identifizierten moderierenden Faktoren. Die Forschung bietet wertvolle Einblicke in die aktuellen Entwicklungen und Herausforderungen in diesem Bereich und gibt Empfehlungen für zukünftige Forschungen.
},
	file = {Tedla und Chen - 2024 - The impacts of computer-supported collaborative le.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/48XBKGN5/Tedla und Chen - 2024 - The impacts of computer-supported collaborative le.pdf:application/pdf},
}

@article{liverano_educational_2024,
	title = {The educational potential of collaborative writing mediated by digital technology in times of pandemic: a scoping review},
	volume = {16},
	copyright = {http://creativecommons.org/licenses/by-nc-nd/4.0},
	issn = {2037-0849},
	shorttitle = {The educational potential of collaborative writing mediated by digital technology in times of pandemic},
	url = {https://www.sciendo.com/article/10.2478/rem-2024-0009},
	doi = {10.2478/rem-2024-0009},
	abstract = {Today's schools must respond to the evolving needs of students by adopting new pedagogical models and didactic devices. Information and communication technologies can be useful resources to focus on the learning of each individual student as a dynamic and relational process. Collaborative writing apps facilitate democratic and shared construction of knowledge through ICT (Van Leeuwen, Janssen, 2019). This approach fosters the transformation of knowledge through a trialogical approach to learning (Cesareni et al., 2018). This article analyzes the responses of a collaborative writing experience with apps in a school. The aim of this contribution is to highlight the most effective technology-mediated collaborative writing interventions that have been implemented during the Covid-19 pandemic. The focus is on their educational potential in terms of both cognitive and non-cognitive skills.},
	language = {en-GB},
	number = {1},
	urldate = {2024-07-01},
	journal = {Research on Education and Media},
	author = {Liverano, Giuseppe},
	month = jun,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Promotion:Relevanz:4, \#0:Zeitschriftenartikel:digital:learning, Promotion:Weiterführung, Datenschutz und IT-Sicherheit, Promotion:FU2b, Promotion:S:12 Digital Learning, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU2b},
	pages = {64--75},
	annote = {Analyse des Artikels "The educational potential of collaborative writing mediated by digital technology in times of pandemic: a scoping review" von Giuseppe Liverano (2024)
1. Analyse
Hauptthemen und -ziele der Forschung: Der Artikel untersucht das Bildungspotenzial des kollaborativen Schreibens, das durch digitale Technologie vermittelt wird, insbesondere während der COVID-19-Pandemie. Ziel der Forschung ist es, die effektivsten technologievermittelten kollaborativen Schreibinterventionen zu identifizieren und deren Auswirkungen auf kognitive und nicht-kognitive Fähigkeiten der Schüler zu bewerten.
Verwendete Methoden und Datenquellen:


Methodische Ansätze: Der Artikel folgt einem Scoping-Review-Ansatz unter Anwendung der PRISMA-Leitlinien (Preferred Reporting Items for Systematic Reviews and Meta-Analyses).


Werkzeuge und Datenquellen: Es wurden Datenbanken wie MDPI, ERIC und ScienceDirect genutzt, um relevante wissenschaftliche Artikel zu durchsuchen und auszuwählen. Die Auswahl erfolgte anhand spezifischer Filterkriterien wie Publikationsjahr, Art des Beitrags, Fachgebiet und Schlagwörter.


Zentrale Forschungsergebnisse:


