@incollection{kern_furer_selbstmanagementforderung_2023,
	address = {Berlin, Heidelberg},
	title = {Selbstmanagementförderung – {Edukation} bei dermatologischen {Reaktionen}},
	isbn = {978-3-662-66605-0 978-3-662-66606-7},
	url = {https://link.springer.com/10.1007/978-3-662-66606-7_9},
	doi = {10.1007/978-3-662-66606-7_9},
	language = {de-DE},
	urldate = {2023-12-30},
	booktitle = {Dermatologische {Reaktionen} bei onkologischen {Therapien}},
	publisher = {Springer Berlin Heidelberg},
	author = {Häusermann, Sara},
	editor = {Kern Fürer, Cornelia and Titzer, Harald and Bachmann-Mettler, Irène},
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Bewertungsmethoden, Bildungstheorien, Promotion:Argumentation, Promotion:Relevanz:2, Promotion:Fundament, Promotion:Literaturverzeichnis, AVIVA+},
	pages = {205--221},
	annote = {{\textless}div class="zotero-note"{\textgreater}{\textless}pre{\textgreater}**Analyse der Quelle „Selbstmanagementförderung – Edukation bei dermatologischen Reaktionen“ (Häusermann, 2023)** **1. Hauptthemen und Ziele der Forschung** Das Kapitel zielt darauf, Selbstmanagementförderung im Kontext dermatologischer Nebenwirkungen onkologischer Therapien als edukative Aufgabe zu strukturieren. Es verbindet Selbstmanagement, Lernen und Patient*innen-/Familienedukation und stellt „acht Pfeiler“ als didaktische Orientierung für edukative Sequenzen vor. (S. 205–210) **2. Methoden und Datenquellen** - **Texttyp:** Fachbuchkapitel/Leitkapitel (praxisorientiert, keine eigenständige empirische Studie).- **Datenbasis:** Literaturbezüge und Praxisbeispiele (Fallvignetten „Frau Casanova“, „Herr Haller“). (S. 206) **3. Zentrale Ergebnisse** - Selbstmanagement wird als mehrdimensionales Konstrukt geführt (Handlung/Verhalten + Rollen-/Emotionsarbeit) und benötigt professionelle Unterstützung. (S. 207)- Edukation wird als strukturierter Lernprozess verstanden, dessen Gelingen u. a. von Lernbiografie, Emotionslage und Motivation abhängt; personenzentrierte Grundhaltung wird betont. (S. 208)- AVIVA wird als schul-pädagogisches Strukturmodell für Edukationssequenzen in der Pflegepraxis herangezogen (AVIVA-PFE). (S. 218) **4. Zusammenfassung** Die Quelle liefert ein didaktisches Strukturangebot (Pfeiler + AVIVA) für professionelle Edukation in einem hochspezifischen Gesundheitskontext. Für deine Arbeit ist sie weniger als Digital-/LMS-Quelle relevant, aber als Transferbeleg dafür, dass Phasenmodelle (AVIVA) als Orchestrierungsheuristiken auch in professionellen, hochregulierten Settings verwendet werden. **5. Kernaussagen (mit Fundstellen)** - „Neben der Förderung des Selbstmanagements auf der Handlungs- und Verhaltensebene ist es zentral, dass Pflegefachpersonen … dabei unterstützen, Selbstvertrauen zu entwickeln, damit sie besser mit der veränderten Lebenssituation umzugehen lernen.“ (S. 207)- „Entscheidend für das Lernen im Kontext von Gesundheit/Krankheit ist auch die Gesundheitskompetenz … Informationen … zu finden, … zu verstehen, … zu beurteilen und anzuwenden.“ (S. 207)- „Zur Unterstützung des Transfers in die Pflegepraxis kann das aus der Schulpädagogik stammende AVIVA-Modell … hinzugezogen werden: AVIVA bedeutet ursprünglich … Ankommen und einstimmen … Vorwissen aktivieren … Informieren … Verarbeiten … Auswerten.“ (S. 218) **6. Argumentationslinien (mit Fundstellen)** Das Kapitel argumentiert, dass edukative Interventionen für Symptom‑/Selbstmanagement (1) an Lernfähigkeit/Motivation/Emotionslage anschließen müssen (S. 208), (2) als strukturierte didaktische Sequenzen zu konzipieren sind (Pfeilerlogik; S. 210–218) und (3) über Phasenmodelle wie AVIVA operationalisierbar werden, um Transfer in die Praxis zu unterstützen (S. 218). **7. Verschlagwortung (nur relevante Schlagwörter)** - **Bildungstheorien:** Lernen/Motivation/Selbstwirksamkeit als didaktische Rahmung von Edukation. (S. 207–208)- **Bewertungsmethoden:** indirekt, weil Edukation über Wissenssicherung/Überprüfung als Pfeiler geführt wird. (S. 217)- **Forschungsansätze:** praxisorientierter Theorie-/Konzeptbeitrag (keine eigene Studie). (S. 205–206) **8. Kategorisierung** **Kerngedanke:** Edukation ist eine strukturierte Orchestrierungsaufgabe; AVIVA fungiert als Heuristik, die Lernprozesse phasenweise rahmt und dadurch Transfer/Passung in die Praxis wahrscheinlicher machen soll. (S. 218) **9. Zuordnung zu der passendsten Forschungsunterfrage** **Nicht direkt zuordenbar.** Die Quelle adressiert keine digitalen Bildungsräume/LMS. Sie ist höchstens als Analogbeleg für AVIVA als Orchestrierungslogik in professionellen Bildungs-/Edukationskontexten nutzbar. **10. Relevanzbewertung** **2** **11. Schlussfolgerung** Als Beleg geeignet, dass AVIVA nicht auf Schule beschränkt ist und als strukturierende Heuristik in Gesundheits-/Pflegeedukation genutzt wird. Für deine LMS-/Wirkgefüge-Argumentation ist die Quelle eher peripher.{\textless}/pre{\textgreater}{\textless}/div{\textgreater}},
	file = {Häusermann - 2023 - Selbstmanagementförderung – Edukation bei dermatol.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/BXSWZLMV/Häusermann - 2023 - Selbstmanagementförderung – Edukation bei dermatol.pdf:application/pdf},
}

@incollection{mohring_messen_2013,
	address = {Wiesbaden},
	title = {Messen im {Zeitverlauf}},
	isbn = {978-3-531-18775-4 978-3-531-18776-1},
	url = {http://link.springer.com/10.1007/978-3-531-18776-1_6},
	doi = {10.1007/978-3-531-18776-1_6},
	abstract = {Das Messen von Veränderungen hat eine große Bedeutung in der Kommunikationswissenschaft. Viele zentrale Theorien und Ansätze befassen sich mit individuellen oder sozialen Wandlungsprozessen. Veränderungen lassen sich valide nur mithilfe von Längsschnittstudien untersuchen. Dabei kann man zwischen Trendstudien und Panelstudien unterscheiden. Eine besondere Bedeutung können auch Tagebucherhebungen haben. Trendstudien messen Veränderungen durch die wiederholte identische Messung mit jeweils neuen Samples. Panel führen die wiederholten Messungen mit den identischen Untersuchungssubjekten durch. Das Tagebuch kann im Prinzip als eine Sonderform des Panels angesehen werden, bei dem die Versuchsteilnehmerinnen und -teilnehmer in einer definierten zeitlichen Abfolge schriftliche Fragebögen ausfüllen. Jedes der Verfahren hat spezifische Vor- und Nachteile. Trendstudien sind im Vergleich wenig aufwändig und erlauben eine schnelle Abfolge von Messungen. Sie müssen auch nicht vorher geplant sein, sondern können durch Replikation vorhandener Studien entstehen. Panelstudien sind leistungsfähiger, da sie Wandlungsprozesse detaillierter beschreiben und sicherer bestimmen können; sie sind aber in der Durchführung aufwändiger. Tagebücher gelten als besonders valide und reliable Erhebungsform insbesondere zur Analyse der Mediennutzung, sie sind aber auch besonders aufwändig.},
	language = {de-DE},
	urldate = {2023-09-30},
	booktitle = {Handbuch standardisierte {Erhebungsverfahren} in der {Kommunikationswissenschaft}},
	publisher = {Springer Fachmedien Wiesbaden},
	author = {Scherer, Helmut and Naab, Teresa K.},
	editor = {Möhring, Wiebke and Schlütz, Daniela},
	year = {2013},
	keywords = {Forschungsansätze, Bewertungsmethoden, Promotion:Relevanz:3, Promotion:Fundament, Promotion:01-02 Methodenquellen, Promotion:Literaturverzeichnis, AVIVA+},
	pages = {103--123},
	annote = {{\textless}div class="zotero-note"{\textgreater}{\textless}pre{\textgreater}**Analyse der Quelle „Messen im Zeitverlauf“ (Scherer \&amp; Naab, 2013)** **1. Hauptthemen und Ziele der Forschung** Das Kapitel führt in Mess- und Erhebungsdesigns zur Analyse von Veränderungen ein (Längsschnitt). Es grenzt Trendstudien, Panelstudien und Tagebucherhebungen voneinander ab und diskutiert jeweilige Vor- und Nachteile für die valide Erfassung von Zeitverläufen. (S. 1) **2. Methoden und Datenquellen** - **Texttyp:** Methoden-/Handbuchkapitel (keine eigenständige empirische Studie).- **Inhalt:** definitorische und forschungslogische Systematisierung von Designs/Techniken (Trend, Panel, Tagebuch). (S. 1–3) **3. Zentrale Ergebnisse** - Veränderungen lassen sich „valide“ nur über Längsschnittdesigns erfassen; Querschnitte können Zeitverläufe höchstens rekonstruieren (mit Erinnerungsproblemen). (S. 2)- Trendstudien = identische Messung in Intervallen mit jeweils neuen Stichproben; Panel = wiederholte Messung bei denselben Subjekten; Tagebuch = Sonderform panelartiger Wiederholung. (S. 1–3) **4. Zusammenfassung** Die Quelle ist ein methodischer Referenzanker, um Zeitlogiken (Verläufe/Veränderungen) sauber zu unterscheiden und die jeweiligen Validitätsprobleme zu explizieren. Für deine Arbeit ist sie anschlussfähig, wenn du Zeitreihen-/Verlaufslogiken (z. B. „rechnerische Spur“, Indikatorik) methodisch absichern willst. **5. Kernaussagen (mit Fundstellen)** - „Veränderungen lassen sich valide nur mithilfe von Längsschnittstudien untersuchen.“ (S. 1)- „Nur Längsschnittstudien ermöglichen eine valide und reliable Erfassung von Zeitverläufen.“ (S. 2)- „Als Trendstudien bezeichnet man … die gleiche Erhebung mit identischem Messinstrument …; … für jeden Messzeitpunkt [wird] eine neue Stichprobe gezogen.“ (S. 3) **6. Argumentationslinien (mit Fundstellen)** Das Kapitel begründet die Relevanz von Zeitverlaufsmessung über zentrale Wandlungsprozesse (z. B. Diffusion, Medienwirkungen) (S. 2) und leitet daraus die Notwendigkeit geeigneter Designs ab. Es kontrastiert Querschnittrekonstruktionen mit Längsschnittdesigns (S. 2) und systematisiert Trendstudien als pragmatische, aber limitiere Lösung gegenüber Panel- und Tagebuchdesigns. (S. 1–3) **7. Verschlagwortung (nur relevante Schlagwörter)** - **Forschungsansätze:** Methodenkapitel zu Designs der Zeitverlaufsforschung (Trend/Panel/Tagebuch). (S. 1–3)- **Bewertungsmethoden:** im Sinne von Mess-/Designlogik zur Veränderungsmessung. (S. 1–3) **8. Kategorisierung** **Kerngedanke:** Zeitverläufe sind methodisch anspruchsvoll; valide Veränderungsmessung benötigt Längsschnittdesigns, die je nach Fragestellung unterschiedlich realisiert werden (Trend vs. Panel vs. Tagebuch). (S. 1–3) **9. Zuordnung zu der passendsten Forschungsunterfrage** **Nicht direkt zuordenbar.** Methodische Quellbasis; kann für Methodologie/Argumentationsabsicherung (Zeitlogik, Validität) herangezogen werden, nicht als LMS-/Akteursquelle. **10. Relevanzbewertung** **3** **11. Schlussfolgerung** Sinnvoll als methodischer Referenzbaustein für alle Stellen, an denen du Zeitlogik/Veränderung/Indikatorik argumentierst (z. B. Zeitreihe, Simulation, longitudinal gedachte Kopplungsdynamik).{\textless}/pre{\textgreater}{\textless}/div{\textgreater}},
	file = {Scherer und Naab - 2013 - Messen im Zeitverlauf.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/EGJD6GSD/Scherer und Naab - 2013 - Messen im Zeitverlauf.pdf:application/pdf},
}

