@article{choi_effectiveness_2018,
	title = {Effectiveness of the {Malnutrition} {eLearning} {Course} for {Global} {Capacity} {Building} in the {Management} of {Malnutrition}: {Cross}-{Country} {Interrupted} {Time}-{Series} {Study}},
	volume = {20},
	url = {http://www.jmir.org/2018/10/e10396/},
	doi = {10.2196/10396},
	abstract = {Background: Scaling up improved management of severe acute malnutrition has been identified as the nutrition intervention with the largest potential to reduce child mortality, but lack of operational capacity at all levels of the health system constrains scale-up. We therefore developed an interactive malnutrition eLearning course that is accessible at scale to build capacity of the health sector workforce to manage severely malnourished children according to the guidelines of the World Health Organization. Objective: The aim of this study was to test whether the malnutrition eLearning course improves knowledge and skills of in-service and preservice health professionals in managing children with severe acute malnutrition and enables them to apply the gained knowledge and skills in patient care. Methods: This 2-year prospective, longitudinal, cross-country, interrupted time-series study took place in Ghana, Guatemala, El Salvador, and Colombia between January 2015 and February 2017. A subset of 354 in-service health personnel from 12 hospitals and 2 Ministries of Health, 703 preservice trainees from 9 academic institutions, and 204 online users participated. Knowledge gained after training and retention over time was measured through pre- and postassessments comprising questions pertaining to screening, diagnosis, pathophysiology and treatment, and prevention of malnutrition. Comprehension, application, and integration of knowledge were tested. Changes in perception, confidence, and clinical practice were assessed through questionnaires and interviews. Results: Before the course, awareness of the World Health Organization guidelines was 36.73\% (389/1059) overall, and 26.3\% (94/358) among in-service professionals. The mean score gain in knowledge after access to the course in 606 participants who had pre- and postassessment data was 11.8 (95\% CI 10.8-12.9; P{\textless}.001)?a relative increase of 41.5\%. The proportion of participants who achieved a score above the pass mark posttraining was 58.7\% (356/606), compared with 18.2\% (110/606) in pretraining. Of the in-service professionals, 85.9\% (128/149) reported applying their knowledge by changing their clinical practice in screening, assessment, diagnosis, and management. This group demonstrated significantly increased retained knowledge 6 months after training (mean difference [SD] from preassessment of 12.1 [11.8]), retaining 65.8\% (12.1/18.4) of gained knowledge from the training. Changes in the management of malnutrition were reported by trained participants, and institutional, operational, and policy changes were also found. Conclusions: The malnutrition eLearning course improved knowledge, understanding, and skills of health professionals in the diagnosis and management of children with severe acute malnutrition, and changes in clinical practice and confidence were reported following the completion of the course.},
	number = {10},
	journal = {J Med Internet Res},
	author = {Choi, Sunhea and Yuen, Ming Ho and Annan, Reginald and Pickup, Trevor and Pulman, Andy and Monroy-Valle, Michele and Aduku, Linda Nana Esi and Kyei-Boateng, Samuel and Velásquez Monzón, Isabel Carmen and Portillo Sermeño, Elisa Carmen and Penn, Andrew and Ashworth, Ann and Jackson, A. Alan},
	month = oct,
	year = {2018},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Bildungstheorien, \#1:Zeitschriftenartikel:learning:management:system, Bildung, Multimedia, Digitale Bildung, Krisenreaktion im Bildungsbereich, quality improvement, capacity building, nutrition training and education, severe acute malnutrition, staff development, Transformation 🔵, WHO guidelines for malnutrition, Promotion:S:01 Learning Management System, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {e10396},
	annote = {1. Analyse
Die Studie von Choi et al. (2018) untersucht die Effektivität eines eLearning-Kurses zur Mangelernährung zur globalen Kapazitätsbildung im Management von Mangelernährung. Es wurde bewertet, ob der Kurs das Wissen und die Fähigkeiten von Gesundheitsfachkräften im Umgang mit schwerer akuter Mangelernährung verbessert und ob sie in der Lage sind, das erworbene Wissen und die Fähigkeiten in der Patientenversorgung anzuwenden.
2. Zusammenfassung
Die Studie zeigt, dass der eLearning-Kurs signifikant das Wissen und die Fähigkeiten der Teilnehmer verbesserte. Es gab eine substantielle Verbesserung der Wissensbasis vor und nach dem Kurs, mit einer durchschnittlichen Steigerung des Wissensscores von 41,5\%. Außerdem berichteten 85,9\% der in den Dienst gestellten Fachkräfte, dass sie das gelernte Wissen in ihrer klinischen Praxis anwenden.
3. Kernaussagen


Verbesserung des Wissens und der Fähigkeiten: Teilnehmer zeigten signifikante Verbesserungen in ihrem Verständnis und ihrer Fähigkeit, Kinder mit schwerer akuter Mangelernährung zu behandeln.


Anwendung des Wissens: Eine große Mehrheit der Gesundheitsfachkräfte wendete das Gelernte erfolgreich in ihrer klinischen Praxis an.


Nachhaltige Wissensretention: Die Retention des erlernten Wissens blieb über einen Zeitraum von sechs Monaten relativ stabil.


4. Argumentationslinien


Effektivität von eLearning: Die Studie stärkt das Argument, dass eLearning eine effektive Methode sein kann, um Gesundheitsfachkräfte umfassend zu schulen, insbesondere in Regionen, in denen traditionelle Schulungsressourcen begrenzt sind.


Implementierung in der Praxis: Die erfolgreiche Anwendung des erworbenen Wissens in der Praxis zeigt, dass eLearning über die bloße Wissensvermittlung hinausgeht und tatsächliche Änderungen in der Behandlungspraxis fördern kann.


5. Verschlagwortung


Lehr- und Lerneffektivität: Nachweis der Verbesserung der Lehr- und Lerneffektivität durch den eLearning-Ansatz.


Technologieintegration: Einsatz digitaler Bildungswerkzeuge zur Steigerung der Bildungskapazitäten.


Krisenreaktion im Bildungsbereich: Anwendung des eLearning zur Adressierung dringender globaler Gesundheitsprobleme wie der Mangelernährung.


Bildungstheorien: Unterstützung konstruktivistischer Lerntheorien durch praktische Anwendung und Interaktivität im eLearning-Kurs.


6. Kategorisierung


Transformation: Der Kurs führte zu veränderten Praktiken und erhöhtem Vertrauen unter den Gesundheitsfachkräften, was auf eine Transformation der Behandlungsansätze in der Praxis hindeutet.


Kerngedanke: Die zentrale Bedeutung der Studie liegt in der Demonstration, dass eLearning eine praktikable Lösung für die Weiterbildung von Gesundheitspersonal in kritischen und spezialisierten Bereichen wie der Mangelernährung ist.


},
	file = {Choi et al. - 2018 - Effectiveness of the Malnutrition eLearning Course.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/CBRIUH97/Choi et al. - 2018 - Effectiveness of the Malnutrition eLearning Course.pdf:application/pdf},
}

@article{lukaschek_applicability_2019,
	title = {Applicability of {Motivational} {Interviewing} for {Chronic} {Disease} {Management} in {Primary} {Care} {Following} a {Web}-{Based} {E}-{Learning} {Course}: {Cross}-{Sectional} {Study}},
	volume = {6},
	url = {http://mental.jmir.org/2019/4/e12540/},
	doi = {10.2196/12540},
	abstract = {Background: Motivational interviewing (MI) is an established communication method for enhancing intrinsic motivation for changing health behavior. E-learning can reduce the cost and time involved in providing continuing education and can be easily integrated into individual working arrangements and the daily routines of medical professionals. Thus, a Web-based course was devised to familiarize health professionals with different levels of education and expertise with MI techniques for patients with chronic conditions. Objective: The aim of this study was to report participants? opinion on the practicality of MI (as learned in the course) in daily practice, stratified by the level of education. Methods: Participants (N=607) of the MI Web-based training course evaluated the course over 18 months, using a self-administered questionnaire. The evaluation was analyzed descriptively and stratified for the level of education (medical students, physicians in specialist training [PSTs], and general practitioners [GPs]). Results: Participants rated the applicability of the skills and knowledge gained by the course as positive (medical students: 94\% [79/84] good; PSTs: 88.6\% [109/123] excellent; and GPs: 51.3\% [182/355] excellent). When asked whether they envisage the use of MI in the future, 79\% (67/84) of the students stated to a certain extent, 88.6\% (109/123) of the PSTs stated to a great extent, and 38.6\% (137/355) of GPs stated to a great extent. Participants acknowledged an improvement of communication skills such as inviting (medical students: 85\% [72/84]; PSTs: 90.2\% [111/123]; GPs: 37.2\% [132/355]) and encouraging (medical students: 81\% [68/84]; PSTs: 45.5\% [56/123]; GPs: 36.3\% [129/355]) patients to talk about behavior change and conveying respect for patient?s choices (medical students: 72\% [61/84]; PSTs: 50.0\% [61/123]; GPs: 23.4\% [83/355]). Conclusions: Participants confirmed the practicality of MI. However, the extent to which the practicality of MI was acknowledged as well as its expected benefits depended on the individual?s level of education/expertise.},
	number = {4},
	journal = {JMIR Ment Health},
	author = {Lukaschek, Karoline and Schneider, Nico and Schelle, Mercedes and Kirk, Bak Ulrik and Eriksson, Tina and Kunnamo, Ilkka and Rochfort, Andrée and Collins, Claire and Gensichen, Jochen},
	month = apr,
	year = {2019},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, \#1:Zeitschriftenartikel:learning:management:system, Digitale Bildung, Promotion:FU3, primary care, disease management, web-based learning, motivational interviewing, health behavior change, Promotion:S:01 Learning Management System, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU3},
	pages = {e12540},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:
Die Studie von Lukaschek et al. (2019) untersucht die Anwendbarkeit von Motivational Interviewing (MI) für das Management chronischer Erkrankungen in der Primärversorgung nach einem webbasierten E-Learning-Kurs. Ziel der Forschung ist es, die Meinungen der Teilnehmer über die Praktikabilität von MI im klinischen Alltag zu erfassen und nach Bildungsniveaus zu unterscheiden.
Verwendete Methoden und Datenquellen:


Design: Querschnittsstudie unter Verwendung eines selbstverwalteten Fragebogens.


Teilnehmer: 607 Teilnehmer aus verschiedenen europäischen Ländern, darunter Medizinstudenten, Ärzte in Weiterbildung und Allgemeinmediziner.


Bewertungsmethoden: Die Teilnehmer bewerteten die Anwendbarkeit der im Kurs erworbenen Fähigkeiten und Kenntnisse sowie die Verbesserung ihrer Kommunikationsfähigkeiten.


Zentrale Forschungsergebnisse:


Anwendbarkeit: 94\% der Medizinstudenten, 88,6\% der Ärzte in Weiterbildung und 51,3\% der Allgemeinmediziner bewerteten die Anwendbarkeit der im Kurs erworbenen Fähigkeiten als gut bis ausgezeichnet.


Zukunftsaussichten: 79\% der Medizinstudenten, 88,6\% der Ärzte in Weiterbildung und 38,6\% der Allgemeinmediziner gaben an, MI in Zukunft in großem Umfang nutzen zu wollen.


Kommunikationsfähigkeiten: Verbesserung der Kommunikationsfähigkeiten wurde von 85\% der Medizinstudenten, 90,2\% der Ärzte in Weiterbildung und 37,2\% der Allgemeinmediziner berichtet.


Zusammenfassung
Die Studie zeigt, dass MI nach einem webbasierten E-Learning-Kurs als praktikabel und nützlich für das Management chronischer Erkrankungen in der Primärversorgung angesehen wird. Die Bewertungen variieren jedoch je nach Bildungsniveau der Teilnehmer, wobei Medizinstudenten und Ärzte in Weiterbildung positiver eingestellt sind als Allgemeinmediziner.
Kernaussagen


„Die Mehrheit der Teilnehmer bewertete die Anwendbarkeit der im Kurs erworbenen Fähigkeiten als positiv.“ (S. 4)


„Medizinstudenten und Ärzte in Weiterbildung planen, MI in größerem Umfang zu nutzen als Allgemeinmediziner.“ (S. 5)


„Die Verbesserung der Kommunikationsfähigkeiten wurde von einer signifikanten Mehrheit der Teilnehmer berichtet.“ (S. 6)


Argumentationslinien


Praktikabilität von MI: Die Studie argumentiert, dass MI durch E-Learning-Kurse effektiv vermittelt werden kann, was die Praktikabilität und Anwendbarkeit im klinischen Alltag erhöht. (S. 4-5)


Bildungsniveau und MI: Unterschiede in der Bewertung der Praktikabilität von MI hängen stark vom Bildungsniveau und der klinischen Erfahrung der Teilnehmer ab. (S. 5-6)


Verbesserung der Kommunikationsfähigkeiten: Der Kurs trägt zur Verbesserung der Kommunikationsfähigkeiten bei, was entscheidend für den Erfolg von MI in der klinischen Praxis ist. (S. 6-7)


Verschlagwortung


Lehr- und Lerneffektivität: Untersuchung der Effektivität von E-Learning-Methoden zur Verbesserung der MI-Fähigkeiten und Kommunikationskompetenzen.


Technologieintegration: Nutzung von webbasierten E-Learning-Kursen zur Weiterbildung von medizinischem Personal.


Systemanpassung: Anpassung von MI-Techniken an die Bedürfnisse und Anforderungen der Primärversorgung.


Forschungsansätze: Anwendung von Querschnittsstudien zur Bewertung der Anwendbarkeit und Effektivität von MI nach E-Learning-Kursen.


Kategorisierung: Argumentation
Begründung:
Die Studie von Lukaschek et al. (2019) verwendet verschiedene Quellen und Theorien, um die Wirksamkeit und Praktikabilität von MI durch webbasierte E-Learning-Kurse zu unterstützen. Die detaillierte Analyse der Rückmeldungen und Bewertungen der Teilnehmer zeigt, dass E-Learning-Kurse effektiv zur Vermittlung von MI-Techniken beitragen können. Diese Argumentationslinien sind besonders relevant für die Forschungsfragen des Exposés, da sie die theoretischen und praktischen Aspekte der Anwendung von MI im klinischen Alltag beleuchten.
Kategorie: Argumentation
Zuordnung zur Forschungsfrage
FU3: Wie sind Konzeption und relevante didaktische und bildungstechnologische Merkmale des systemisch-konstruktivistischen Learning-Management-Systems für Akteure im digitalen Bildungsraum von Gesundheitsberufen dargestellt?
Begründung:
Die Studie untersucht die didaktischen und bildungstechnologischen Merkmale eines webbasierten E-Learning-Kurses zur Vermittlung von MI-Techniken. Diese Erkenntnisse sind besonders relevant, um die Konzeption und Implementierung von Learning-Management-Systemen (LMS) zu verstehen und zu optimieren. Die Argumentation der Studie unterstützt die Notwendigkeit, die Systeme an die spezifischen Anforderungen und Herausforderungen der digitalen Bildungsräume im Gesundheitswesen anzupassen.
},
	file = {Lukaschek et al. - 2019 - Applicability of Motivational Interviewing for Chr.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/UL63PUC6/Lukaschek et al. - 2019 - Applicability of Motivational Interviewing for Chr.pdf:application/pdf},
}

@article{smit_e-learning_2021,
	title = {e-{Learning} for {Instruction} and to {Improve} {Reproducibility} of {Scoring} {Tumor}-{Stroma} {Ratio} in {Colon} {Carcinoma}: {Performance} and {Reproducibility} {Assessment} in the {UNITED} {Study}},
	volume = {5},
	url = {https://formative.jmir.org/2021/3/e19408},
	doi = {10.2196/19408},
	abstract = {Background: The amount of stroma in the primary tumor is an important prognostic parameter. The tumor-stroma ratio (TSR) was previously validated by international research groups as a robust parameter with good interobserver agreement. Objective: The Uniform Noting for International Application of the Tumor-Stroma Ratio as an Easy Diagnostic Tool (UNITED) study was developed to bring the TSR to clinical implementation. As part of the study, an e-Learning module was constructed to confirm the reproducibility of scoring the TSR after proper instruction. Methods: The e-Learning module consists of an autoinstruction for TSR determination (instruction video or written protocol) and three sets of 40 cases (training, test, and repetition sets). Scoring the TSR is performed on hematoxylin and eosin?stained sections and takes only 1-2 minutes. Cases are considered stroma-low if the amount of stroma is ?50\%, whereas a stroma-high case is defined as {\textgreater}50\% stroma. Inter- and intraobserver agreements were determined based on the Cohen ? score after each set to evaluate the reproducibility. Results: Pathologists and pathology residents (N=63) with special interest in colorectal cancer participated in the e-Learning. Forty-nine participants started the e-Learning and 31 (63\%) finished the whole cycle (3 sets). A significant improvement was observed from the training set to the test set; the median ? score improved from 0.72 to 0.77 (P=.002). Conclusions: e-Learning is an effective method to instruct pathologists and pathology residents for scoring the TSR. The reliability of scoring improved from the training to the test set and did not fall back with the repetition set, confirming the reproducibility of the TSR scoring method. Trial Registration: The Netherlands Trial Registry NTR7270; https://www.trialregister.nl/trial/7072 International Registered Report Identifier (IRRID): RR2-10.2196/13464},
	number = {3},
	journal = {JMIR Form Res},
	author = {Smit, A. Marloes and van Pelt, W. Gabi and Dequeker, MC Elisabeth and Al Dieri, Raed and Tollenaar, AEM Rob and van Krieken, JM J. Han and Mesker, E. Wilma},
	month = mar,
	year = {2021},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, Bildung, Multimedia, Digitale Bildung, implementation, online learning, \#5:Zeitschriftenartikel:e-learning, cancer, validation, colon cancer, diagnostic, colon, prognosis, carcinoma, reproducibility, reproducibility study, tumor, tumor-stroma ratio, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {e19408},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:
Die Studie von Smit et al. (2021) untersucht den Einsatz eines E-Learning-Moduls zur Schulung von Pathologen und Pathologieresidenten im Scoring des Tumor-Stroma-Verhältnisses (TSR) bei Kolonkarzinomen. Ziel der Studie ist es, die Reproduzierbarkeit und Genauigkeit der TSR-Bewertung nach Anleitung durch E-Learning zu bestätigen und damit die klinische Anwendung des TSR zu erleichtern.
Verwendete Methoden und Datenquellen:
Das E-Learning-Modul besteht aus einem Einführungsvideo oder schriftlichem Protokoll zur TSR-Bewertung sowie drei Sätzen von 40 Fällen (Trainings-, Test- und Wiederholungssatz). Die TSR-Bewertung erfolgt auf H\&E-gefärbten Schnitten. Die Inter- und Intraobserver-Übereinstimmungen wurden anhand des Cohen-κ-Scores bestimmt, um die Reproduzierbarkeit zu bewerten.
Zentrale Forschungsergebnisse:
Von den 63 teilnehmenden Pathologen und Pathologieresidenten schlossen 31 die gesamte Lernzyklus ab. Es wurde eine signifikante Verbesserung der Interobserver-Übereinstimmung vom Trainings- zum Testsatz festgestellt (medianer κ-Score von 0.72 auf 0.77, P=.002). Diese Verbesserung blieb auch nach dem Wiederholungssatz bestehen (medianer κ-Score von 0.76).
Zusammenfassung
Die Studie zeigt, dass E-Learning eine effektive Methode ist, um Pathologen und Pathologieresidenten im Scoring des Tumor-Stroma-Verhältnisses zu schulen. Die Reproduzierbarkeit der TSR-Bewertung verbesserte sich nach der Teilnahme an dem E-Learning-Modul und blieb stabil, was die Nützlichkeit dieser Methode für die klinische Praxis unterstreicht.
Kernaussagen
	•	“Das Wissen der Teilnehmer verbesserte sich signifikant vom Trainings- zum Testsatz (medianer κ-Score von 0.72 auf 0.77, P=.002).” (S. 3)
	•	“Die Reproduzierbarkeit des TSR-Scorings blieb nach dem Wiederholungssatz stabil.” (S. 4)
	•	“E-Learning erwies sich als effektive Methode zur Schulung im TSR-Scoring.” (S. 6)
Argumentationslinien
	•	Die Studie argumentiert, dass E-Learning eine praktikable und effektive Methode zur Schulung von Pathologen und Pathologieresidenten in komplexen diagnostischen Verfahren darstellt.
	•	Es wird betont, dass die Nutzung von E-Learning die Reproduzierbarkeit und Genauigkeit des TSR-Scorings verbessert, was für die klinische Anwendung von entscheidender Bedeutung ist.
Verschlagwortung
	•	Technologieintegration: Die erfolgreiche Integration eines E-Learning-Moduls zur Schulung von Pathologen und Pathologieresidenten.
	•	Lehr- und Lerneffektivität: Signifikante Verbesserungen in der Genauigkeit und Reproduzierbarkeit des TSR-Scorings durch E-Learning.
	•	Systemanpassung: Die Anpassung der diagnostischen Schulungsmethoden an moderne E-Learning-Technologien.
	•	Forschungsansätze: Nutzung eines E-Learning-Moduls und die Bewertung der Effektivität durch kontrollierte Studien.
Kategorie: Argumentation
Diese Studie liefert überzeugende Argumente für die Integration von E-Learning in die medizinische Ausbildung, insbesondere für die Schulung komplexer diagnostischer Verfahren. Die Ergebnisse zeigen, dass durch gezieltes E-Learning die Genauigkeit und Reproduzierbarkeit der Diagnosen signifikant verbessert werden können, was die praktische Anwendung und die klinische Entscheidungsfindung unterstützt.
},
	file = {Smit et al. - 2021 - e-Learning for Instruction and to Improve Reproduc.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/ERRWY35Z/Smit et al. - 2021 - e-Learning for Instruction and to Improve Reproduc.pdf:application/pdf},
}

