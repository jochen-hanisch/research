@article{lipp2021Lad,
  title = {Learning Analytics – Didaktischer Benefit zur Verbesserung von Lehr-Lernprozessen? Implikationen aus dem Einsatz von Learning Analytics im Hochschulkontext},
  author = {Lipp, Silvia and Dreisiebner, Gernot and Leitner, Philipp and Ebner, Martin and Kopp, Michael and Stock, Michaela},
  date = {2021-07},
  journaltitle = {Berufs- und Wirtschaftspädagogik - online},
  number = {40},
  pages = {32},
  abstract = {Die Zunahme an digitalen Lernsettings führt zu einer Fülle an verfügbaren Daten zu Lehr- Lernprozessen. Gleichzeitig stellt die Interpretation dieser Daten die Akteurinnen und Akteure vor neue Herausforderungen. Learning Analytics umfassen die Aggregation und Interpretation von Lernendendaten mit dem Ziel, Lehr-Lernprozesse zu verbessern. Im Zentrum dieses Beitrages stehen die Implikationen, welche der Einsatz von Learning Analytics im Hochschulkontext mit sich bringt, exemplifiziert anhand der Implementierung in einem konkreten Forschungsprojekt. In einem ersten Schritt erfolgt eine literaturbasierte Aufarbeitung des didaktischen Potenzials aus dem Blickwinkel der Lernenden, Lehrenden sowie des Inhalts und des Learning Designs. Anhand einer qualitativen und quantitativen Begleitforschung eines aktuellen Projektes werden anschließend didaktische Implikationen für den Einsatz von Learning Analytics im Hochschulkontext abgeleitet. Deutlich wird, dass das in der Literatur verortete didaktische Potenzial auch in dieser Implementation zutage tritt, jedoch Learning Analytics gleichzeitig auch erhöhte Anforderungen an Lehrende und Lernende stellt.},
  langid = {ngerman},
  keywords = {9:Zeitschriftenartikel:digital:lernen,Charité:Promotion,Forschungsansätze,Lehr- und Lerneffektivität,Leraning:Analytics,Promotion:Argumentation,Promotion:Dissertation | FU1 > Argumentation,Promotion:FU1,Promotion:Literaturanalyse,Promotion:S:09 Digital Lernen,Systemanpassung,Technologieintegration},
  annotation = {ZSCC: NoCitationData[s0]},
  file = {/Users/jochen_hanisch-johannsen/Zotero/storage/53866ZZY/Lipp et al. - 2021 - Learning Analytics – Didaktischer Benefit zur Verb.pdf}
}

