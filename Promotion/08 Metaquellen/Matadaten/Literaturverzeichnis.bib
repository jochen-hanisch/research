@article{rajjoub2024Pcd,
  title = {P233. {{ChatGPT}} in the Decision-Making for the Diagnosis and Treatment of Lumbar Spinal Stenosis: A Comparative Analysis and Systematic Review},
  shorttitle = {P233. {{ChatGPT}} in the Decision-Making for the Diagnosis and Treatment of Lumbar Spinal Stenosis},
  author = {Rajjoub, Rami and Kurapatti, Mark and Kim, Jun Sup and Villada, Juan Sebastian Arroyave and Mejia, Mateo Restrepo and Ahmed, Wasil and Zaidat, Bashar and Tang, Justin and Cho, Samuel K.},
  date = {2024-09},
  journaltitle = {The Spine Journal},
  shortjournal = {The Spine Journal},
  volume = {24},
  number = {9},
  pages = {S179},
  issn = {15299430},
  doi = {10.1016/j.spinee.2024.06.356},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S1529943024006612},
  urldate = {2024-08-20},
  abstract = {BACKGROUND CONTEXT: Spine surgeons increasingly rely on guidelines like the North American Spine Society’s (NASS) Clinical Guideline for Degenerative Lumbar Spinal Stenosis for decision-making, but these are often outpaced by new research. ChatGPT, an AI language model trained on extensive text data, offers a novel approach to synthesizing medical knowledge for clinical decisions and may prove to be useful when assessing patients with lumbar spinal stenosis. PURPOSE: Our study aims to qualitatively evaluate ChatGPT’s performance when responding to clinical questions related to lumbar spinal stenosis and provide a review of the literature to corroborate or refute its findings. STUDY DESIGN/SETTING: Comparative analysis and systematic review. PATIENT SAMPLE: N/A OUTCOME MEASURES: There were a total of 14 questions from the NASS Evidence-Based Clinical Guidelines for Lumbar Spinal Stenosis that were assessed in this study. There were three questions related to the definitions and history of progression, one question about diagnostic tests, seven questions that assessed nonsurgical interventions, and three questions that summarized surgical interventions. METHODS: We prompted ChatGPT with questions from the NASS Evidence-based Clinical Guidelines for LSS and compared its generated responses with the recommendations provided by the guidelines. A review of the literature was performed via PubMed, OVID, and Cochrane on the diagnosis and treatment of lumbar spinal stenosis between January 2012 and April 2023. Eligible studies (1) evaluated adult patients (≥18 years) who had undergone an operative or nonoperative intervention for LSS; (2) reported postoperative outcomes that were related to the guidelines’ questions; and (3) included data that analyzed changes in function or outcomes compared to baseline. All studies before 2012 were excluded since these findings were already incorporated into the 2011 NASS guidelines. RESULTS: Fourteen questions proposed by the NASS guidelines for LSS were uploaded into ChatGPT and directly compared to the responses offered by NASS. Three questions were on the definition and history of LSS, one on diagnostic tests, seven on nonsurgical interventions and three on surgical interventions. The review process found 40 articles that were selected for inclusion that helped corroborate or contradict the responses that were generated by ChatGPT. The study found ChatGPT can provide accurate recommendations for managing lumbar stenosis, aligning with NASS guidelines in many areas but also offering insights in the absence of guideline evidence. ChatGPT closely matched guideline definitions for lumbar stenosis and diagnostic tests like MRIs and nerve function studies, but was less precise in discussing natural history and ranking diagnostic tests’ efficacy. It provided accurate nonsurgical intervention recommendations and understood the need for individualized treatment plans. In subjects lacking NASS guideline recommendations, such as exercise and therapy, manipulation, and pharmacological treatments, ChatGPT’s responses were generally in line with contemporary literature, though it sometimes missed newer evidence or gave imprecise ancillary treatment suggestions. CONCLUSIONS: ChatGPT’s responses were similar to findings in the current literature on LSS. These results demonstrate the potential for implementing ChatGPT into the spine surgeon’s workplace as a means of supporting the decision-making process for LSS diagnosis and treatment. However, our narrative summary only provides a limited literature review and additional research is needed to standardize our findings as means of validating ChatGPT’s use in the clinical space.},
  langid = {english},
  keywords = {Charité:Promotion,GPT},
  file = {/Users/jochen_hanisch-johannsen/Zotero/storage/ZHVF7EP9/Rajjoub et al. - 2024 - P233. ChatGPT in the decision-making for the diagn.pdf}
}

