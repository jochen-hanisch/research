@article{zhu_second_2024,
	title = {Second and {Foreign} {Language} {Vocabulary} {Learning} through {Digital} {Reading}: {A} {Meta}-{Analysis}},
	volume = {29},
	issn = {1360-2357, 1573-7608},
	shorttitle = {Second and {Foreign} {Language} {Vocabulary} {Learning} through {Digital} {Reading}},
	url = {https://link.springer.com/10.1007/s10639-023-11969-1},
	doi = {10.1007/s10639-023-11969-1},
	abstract = {Digital reading facilitates L2 development by allowing anytime-anywhere learning with various digital resources. Although there has been increasing research exploring the role of digital reading on L2 vocabulary learning, synthesized evidence regarding the overall facilitating power of digital reading is still lacking. This meta-analysis aggregates 21 important empirical studies published within the last 20 years and indexed in scholarly recognized databases, so as to provide a comprehensive panoramic assessment of how effectively digital reading has enhanced second and foreign language vocabulary acquisition with diversified learner backgrounds and learning environments. A total of 77 effect sizes were yielded across different studies, and random-effect modeling was employed for analyzing the study-level heterogeneity and sub-group variability. Results demonstrate that digital reading had an overall significant effect (dimmediate = 1.45, p {\textless} .01; ddeleayed = 2.98, p {\textless} .01) on L2 vocabulary learning of between-subject studies. For withinsubject studies, digital reading was found to have an upper-medium (d = 1.39, p {\textless} .01) and medium (d = .86, p {\textless} .01) effect on immediate and delayed L2 vocabulary post-tests. Moderating factor analysis results show that L2 proficiency, vocabulary test formats, and digital resources could robustly explain the variance of effect sizes. The findings have strong pedagogical implications on the effective design for digital reading tasks, including the development of adaptive learning algorithms and personalized lexical glosses. Recommendations for future research in the field are provided by pinpointing where to improve in terms of experimental design and the focus of the learner group.},
	language = {en-GB},
	number = {4},
	urldate = {2024-03-23},
	journal = {Education and Information Technologies},
	author = {Zhu, Tong and Zhang, Yanhui and Irwin, Derek},
	month = mar,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Bildungstheorien, \#0:Zeitschriftenartikel:digital:learning, Promotion:Weiterführung, Promotion:S:12 Digital Learning, Promotion:Literaturverzeichnis},
	pages = {4531--4563},
	file = {Zhu et al. - 2024 - Second and Foreign Language Vocabulary Learning th.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/DHYU3A7S/Zhu et al. - 2024 - Second and Foreign Language Vocabulary Learning th.pdf:application/pdf},
}

@article{engel_bildung_2023,
	title = {Bildung in der {Nächsten} {Gesellschaft}: {Eine} post-digitale {Sicht} auf {Technik} und {Lernen}},
	volume = {23},
	issn = {2190-4790},
	shorttitle = {Bildung in der {Nächsten} {Gesellschaft}},
	url = {https://www.medienpaed-ludwigsburg.de/article/view/505},
	doi = {10.21240/lbzm/23/04},
	abstract = {Die gesellschaftliche Medienwelt hat sich seit Dieter Baackes Arbeiten grundlegend verändert. Ging es in den 1970er Jahren um Massenmedien, die in der Freizeit von Jugendlichen zunehmend an Bedeutung gewannen, durchdringt die digitale Medientechnik heute die gesellschaftliche Kommunikation. Dirk Baecker beschreibt als zentrale Herausforderung der "Nächsten Gesellschaft" die Bewältigung des Kontrollverlusts, der durch das Verwobensein der Technik mit gesellschaftlichen Handlungspraktiken ihre Leistungsfähigkeit ausgeht. Aus postdigitaler Sicht lassen sich Transformationen von Ordnungen des Wissens durch das Zusammenspiel von (auch unsichtbaren, digitalen) Akteuren analysieren. Während die ursprüngliche Zielperspektive von Medienkompetenz wesentlich auf Partizipation, Diskurs und gesellschaftliche Veränderung ausgerichtet war, schreiben aktuelle Entwürfe einer "digitalen Kompetenz" die Unsicherheit, die mit den Einschnitten der digitalen Epoche einhergehen, regelmäßig dem Individuum zu. Die Idee eines autonomen Subjekts, das durch Bildung Mündigkeit und Souveränität gewinnt, wird jedoch brüchig. Es gilt, den Bildungsbegriff zu befragen, und an Ansätze relationaler Bildungsprozesse anzuschließen. Es geht um einen Bildungsbegriff, der die Bedeutung von Bildung in einer durch das Digitale geprägten Gesellschaft reflektiert und dabei die Idee von Souveränität und Subjektivation neu positioniert.},
	language = {de-DE},
	urldate = {2024-03-22},
	journal = {Ludwigsburger Beiträge zur Medienpädagogik},
	author = {Engel, Juliane and Kerres, Michael},
	month = oct,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Promotion:FU4a, Promotion:Kerngedanke, Bildungstheorien, Promotion:FU4b, \#9:Zeitschriftenartikel:digital:lernen, Promotion:FH, Promotion:S:09 Digital Lernen, Promotion:Literaturverzeichnis},
	file = {Engel und Kerres - 2023 - Bildung in der Nächsten Gesellschaft Eine post-di.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/KLVW6BZ3/Engel und Kerres - 2023 - Bildung in der Nächsten Gesellschaft Eine post-di.pdf:application/pdf},
}

@article{cornelius_mit_2023,
	title = {Mit einem interaktiven und digitalen {Selbstlernbuch} in die organische {Chemie} starten},
	copyright = {all rights reserved},
	url = {https://www.db-thueringen.de/receive/dbt_mods_00059412},
	doi = {10.22032/DBT.59412},
	abstract = {Um an der von Digitalität geprägten Arbeits- und Lebenswelt unserer Gesellschaft selbstbestimmt teilhaben zu können, ist ein breites Spektrum an digitalisierungsbezogenen Kompetenzen notwendig. Zur Vermittlung dieser Kompetenzen in der Schule, ist die Entwicklung und Erprobung von neuen Unterrichtsmethoden unter Einbezug digitaler Medien erforderlich. Eine gewinnbringende Methode, die digitalisierungsbezogenen Kompetenzen von SchülerInnen zu fördern und gleichzeitig fachliche Inhalte zu elaborieren, ist der Einsatz von digitalen und interaktiven Selbstlernbüchern im Unterricht. In diesem Beitrag sollen, neben den Einblicken in das digitale und interaktive Selbstlernbuch „Einführung in die organische Chemie“ mit seinen unterschiedlichen Bestandteilen, die ersten Ergebnisse der Begleitforschung präsentiert werden. Dabei liegt der Forschung unter anderem die Frage zu Grunde, welchen Einfluss die Arbeit mit dem digitalen und interaktiven Selbstlernbuch auf die Motivation und den digitalisierungsbezogenen Kompetenzerwerb hat.},
	language = {de-DE},
	urldate = {2024-03-11},
	journal = {DiCE-Tagung 2023 - Digitalisation in Chemistry Education},
	publisher = {[object Object]},
	author = {Cornelius, Soraya and Bohrmann-Linde, Claudia},
	collaborator = {{Thüringer Universitäts- Und Landesbibliothek Jena}},
	year = {2023},
	keywords = {370, Promotion:Literaturanalyse, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Technologieintegration, Systemanpassung, Bildungstheorien, Promotion:FU6, Promotion:Schlussfolgerung, \#9:Zeitschriftenartikel:digital:lernen, 540, digitale Selbstlernbücher, digitalisierungsbezogene Kompetenzen, selbststrukturiertes Lernen, Promotion:S:09 Digital Lernen, Promotion:Dissertation {\textbar} FU1 {\textgreater} Kerngedanke, Promotion:Literaturverzeichnis},
	pages = {vol. Vortrag},
	annote = {Analyse des Artikels “Mit einem interaktiven und digitalen Selbstlernbuch in die organische Chemie starten” von Soraya Cornelius und Claudia Bohrmann-Linde (2023)
1. Identifizierung und Beschreibung der Hauptthemen und -ziele der Forschung:
Der Artikel befasst sich mit der Einführung und Evaluation eines digitalen und interaktiven Selbstlernbuchs für den Chemieunterricht, speziell zur Einführung in die organische Chemie. Ziel ist es, die Auswirkungen des Selbstlernbuchs auf die Motivation der Schüler und den Erwerb digitalisierungsbezogener Kompetenzen zu untersuchen.
2. Erkennung der verwendeten Methoden und Datenquellen:
Die Autoren nutzen eine Kombination aus quantitativen und qualitativen Methoden, darunter Fragebogenerhebungen, Interviews und die Analyse von Lernfortschritten. Die Studie basiert auf den Erfahrungen und Rückmeldungen von Schülern der Klassenstufe 10 in Gymnasien und Realschulen über mehrere Schuljahre hinweg.
3. Erklärung der zentralen Forschungsergebnisse:
Die Ergebnisse zeigen, dass das digitale Selbstlernbuch die Motivation der Schüler steigert und ihnen hilft, wichtige digitale Kompetenzen zu erwerben. Insbesondere die interaktiven und produktiven Elemente des Selbstlernbuchs, wie die Erstellung von Erklärvideos, tragen zu einem erhöhten Selbstwirksamkeitserleben und einer höheren Motivation bei.
Zusammenfassung
Kernpunkte des Artikels:
	•	Problemstellung: Untersuchung der Effekte eines digitalen Selbstlernbuchs auf die Motivation und den Kompetenzerwerb der Schüler im Chemieunterricht.
	•	Methodik: Quantitative und qualitative Analyse durch Fragebögen, Interviews und Lernfortschrittsanalysen.
	•	Hauptergebnisse: Das digitale Selbstlernbuch steigert die Motivation der Schüler und fördert den Erwerb digitalisierungsbezogener Kompetenzen.
	•	Schlussfolgerungen: Digitale Selbstlernbücher sind ein effektives Mittel zur Förderung von Motivation und digitalen Kompetenzen, erfordern jedoch eine sorgfältige Implementierung und Begleitung durch Lehrkräfte.
Kernaussagen
	•	Der Einsatz digitaler Selbstlernbücher kann die Motivation der Schüler steigern und ihnen helfen, wichtige digitale Kompetenzen zu erwerben (S. 1).
	•	Interaktive und produktive Elemente, wie die Erstellung von Erklärvideos, tragen zu einem höheren Selbstwirksamkeitserleben bei (S. 3).
	•	Eine sorgfältige Einbindung und Begleitung der Schüler ist notwendig, um die Vorteile digitaler Selbstlernbücher voll auszuschöpfen (S. 5).
Argumentationslinien
	•	Aufbau der Argumente:
	•	Einleitung: Vorstellung der Bedeutung digitaler Kompetenzen und der Rolle von Selbstlernbüchern im Chemieunterricht.
	•	Theoretischer Rahmen: Diskussion der Grundlagen des selbststrukturierten Lernens und digitaler Bildung.
	•	Methoden: Beschreibung des Forschungsdesigns und der Datenerhebungsmethoden.
	•	Ergebnisse: Präsentation und Analyse der Befragungsergebnisse und Lernfortschritte.
	•	Schlussfolgerungen: Implikationen für die Praxis und Empfehlungen für die Implementierung digitaler Selbstlernbücher.
	•	Logische Verbindungen:
	•	Verknüpfung von Theorie und Praxis: Durch die Diskussion theoretischer Konzepte und deren Anwendung im Unterricht.
	•	Systematische Unterstützung: Durch empirische Daten und konkrete Beispiele aus dem Chemieunterricht.
Verschlagwortung
	•	Lehr- und Lerneffektivität: Der Artikel zeigt, wie digitale Selbstlernbücher die Motivation und den Kompetenzerwerb der Schüler fördern und somit die Effektivität des Lehr- und Lernprozesses verbessern.
	•	Technologieintegration: Die Integration verschiedener digitaler Tools und Formate in das Selbstlernbuch verdeutlicht die Komplexität und Bedeutung der Technologieintegration im Bildungsbereich.
	•	Kollaboratives Lernen: Die produktiven Aufgaben, wie die Erstellung von Erklärvideos, fördern die Zusammenarbeit und Kommunikation unter den Schülern.
Kategorisierung
	•	Kerngedanke: Der zentrale Gedanke des Artikels ist die Förderung von Motivation und digitalen Kompetenzen durch den Einsatz eines interaktiven und digitalen Selbstlernbuchs im Chemieunterricht.
Forschungsfragen Zuordnung
	•	Hauptforschungsfrage: Wie ist das Wirkgefüge des angewendeten Learning-Management-Systems auf Akteure im digitalen Bildungsraum von Gesundheitsberufen gestaltet?
	•	FU1: Welche Akzeptanz und Nützlichkeit (Bedeutung) beschreiben Akteure im digitalen Bildungsraum von Gesundheitsberufen bei Anwendung eines Learning-Management-Systems?
	•	FU3: Wie sind Konzeption und relevante didaktische und bildungstechnologische Merkmale des systemisch-konstruktivistischen Learning-Management-Systems für Akteure im digitalen Bildungsraum von Gesundheitsberufen dargestellt?
Der Artikel von Cornelius und Bohrmann-Linde passt zu diesen Forschungsfragen, da er die Konzeption und didaktischen Merkmale eines digitalen Selbstlernbuchs analysiert und die Akzeptanz und Nützlichkeit dieser Ansätze durch die Schüler untersucht. Insbesondere werden die bildungswissenschaftlichen Mechanismen und die Effektivität der didaktischen Methoden im Kontext des Chemieunterrichts diskutiert.
},
	annote = {Analyse von Cornelius, S. \& Bohrmann-Linde, C. (2023): Mit einem interaktiven und digitalen Selbstlernbuch in die organische Chemie starten
In: DiCE-Tagungsband 2023, DOI: 10.22032/dbt.59412

1. Hauptthemen und Ziele der Forschung
Cornelius \& Bohrmann-Linde (2023) präsentieren die Entwicklung, Implementierung und Evaluation eines digitalen, interaktiven Selbstlernbuchs für den Chemieunterricht (Kapitel: Einführung in die organische Chemie).Ziel des Projekts ist die Förderung von fachbezogenen und digitalisierungsbezogenen Kompetenzen durch ein didaktisch integriertes Lernmedium, das Selbstorganisation, Motivation und Medienkompetenz der Schüler*innen stärkt.
Die Forschung orientiert sich am OECD-Lernkompass 2030 und dem KMK-Strategiepapier zur Bildung in der digitalen Welt. Sie zielt darauf ab, Lernende zu befähigen, selbstbestimmt an einer digitalisierten Gesellschaft teilzuhaben, und Lehrkräften didaktische Wege aufzuzeigen, wie digitale Medien sinnvoll in den Fachunterricht integriert werden können.

2. Methoden und Datenquellen
a) Forschungsdesign
Das Projekt basiert auf einer iterativ angelegten Design-Based-Research-Studie mit quantitativer Begleitforschung.


Entwicklung und Erprobung des Selbstlernbuchs in mehreren Zyklen (Schuljahre 2020/21 bis 2022/23).


Teilnehmende: rund 550 Schüler*innen (Gymnasien und Realschulen, Jahrgangsstufe 10).


Datenerhebung: Drei Fragebögen (Pre-, Post- und Follow-up-Design).


Erhebungszeitraum: jeweils 7 Doppelstunden Unterricht.


b) Datenauswertung
Die quantitativen Daten wurden deskriptiv ausgewertet, insbesondere zu:


Motivation (Selbstbestimmungstheorie von Deci \& Ryan, 1993),


Erwerb digitalisierungsbezogener Kompetenzen,


Selbstorganisationsfähigkeit.


Zudem wurden Lehrkräfte-Feedbacks zur Lernbegleitung und Unterrichtseinbindung dokumentiert.

3. Zentrale Forschungsergebnisse
a) Struktur und Umsetzung des Selbstlernbuchs
Das digitale Selbstlernbuch „Einführung in die organische Chemie“ wurde auf iPads konzipiert und gliedert sich in fünf Kapitel, die fachliche und mediendidaktische Inhalte kombinieren:


Fachlich-experimenteller Strang: Grundkonzepte der organischen Chemie (Versuche, Beobachtungen, Auswertungen).


Mediendidaktisch-methodischer Strang: Kompetenzaufbau in Tools wie Pages, iMovie, FotoApp, LearningAppszur Erklärvideoproduktion.


Lernende arbeiten sowohl rezeptiv (Text, Video, Audio) als auch produktiv (Erklärvideos, Audio-Kommentare, Visualisierungen).


Abb. 2 (S. 3) illustriert die Verzahnung der beiden Stränge und zeigt, wie digitale Medien und chemiedidaktische Experimente synergetisch integriert werden.

b) Motivation und Selbstwirksamkeit
Die Evaluation zeigt eine hohe Akzeptanz und Motivation beim Einsatz des Selbstlernbuchs:


88 \% der Schüler*innen freuten sich auf den Unterricht mit iPads (Pre-Test).


81 \% erwarteten, ihre digitalen Kompetenzen zu erweitern.


Nach der Unterrichtseinheit empfanden 65 \% die Arbeit als „gewinnbringend“,67 \% bewerteten LearningApps als hilfreich,74 \% stuften die Übungen als lernwirksam ein.


Motivation zur Videoproduktion: ca. 62 \% der Schüler*innen fühlten sich motiviert, ein Erklärvideo zu erstellen (vgl. Abb. 5, S. 4).


Diese Ergebnisse bestätigen die Selbstbestimmungstheorie von Deci \& Ryan (1993):Das Erleben von Autonomie, Kompetenz und sozialer Eingebundenheit führte zu gesteigerter Lernmotivation.

c) Erwerb digitalisierungsbezogener Kompetenzen


56 \% der Befragten gaben an, mit dem Programm Pages gelernt zu haben.


46 \% bestätigten Kompetenzzuwächse bei der Erklärvideoproduktion.


65 \% lernten, wie man mit dem iPad ein Erklärvideo erstellt – im Vergleich zu nur 27 \%, die dies zuvor im Unterricht gelernt hatten.


Das Projekt zeigt somit, dass digitale Selbstlernbücher nicht nur Wissen vermitteln, sondern konkret mediale Handlungskompetenz fördern.

d) Didaktische Erkenntnisse


Der Unterricht mit Selbstlernbüchern verlangt ein hohes Maß an Selbstorganisation; 76 \% der Schüler*innen hatten zuvor keine Erfahrung mit selbststrukturiertem Lernen.


Erfolgsfaktoren:


Einführung in Zeitplanung und Arbeitsorganisation.


Strukturierende Lehrerbegleitung in frühen Phasen.


Einbindung von Reflexionsphasen und Plenumsdiskussionen.




Das Selbstlernbuch fungiert als didaktisches Werkzeug, kein Ersatz für Lehrinteraktion.



4. Zusammenfassung
Das Projekt zeigt, dass ein digitales Selbstlernbuch als innovatives Unterrichtsmedium den Transfer zwischen Fach- und Medienkompetenz fördert. Es verbindet experimentelles Arbeiten, digitale Mediennutzung und eigenständiges Lernen zu einem motivierenden Lernformat.
Die Ergebnisse bestätigen, dass:


digitale Medien die Lernmotivation steigern,


die Integration produktiver Aufgaben (z. B. Erklärvideos) die Reflexion vertieft,


digitale Kompetenzzuwächse durch aktives Handeln und Anwendung erzielt werden.


Gleichzeitig erfordert das Konzept strukturierende Lehrerunterstützung, um Überforderung und Motivationsverlust zu vermeiden.

5. Kernaussagen (mit Fundstellen)


„Ein digitales Selbstlernbuch ermöglicht den Erwerb fachlicher und digitalisierungsbezogener Kompetenzen zugleich.“ (S. 2)


„Die Arbeit im eigenen Tempo und das aktive Gestalten eigener Lernprodukte steigern Selbstwirksamkeit und Motivation.“ (S. 2)


„88 \% der Schüler*innen freuen sich auf die Arbeit mit iPads; 74 \% bewerten die Übungen als gewinnbringend.“ (S. 3–4)


„Selbstorganisation ist eine entscheidende Voraussetzung – 76 \% der Lernenden hatten zuvor keine Erfahrung mit selbststrukturiertem Lernen.“ (S. 4)


„Das Selbstlernbuch ist kein Allheilmittel, sondern erfordert Begleitung und Einbettung in didaktische Kontexte.“ (S. 4)



6. Argumentationslinien


Gesellschaftlicher Rahmen: Digitale Bildung ist Voraussetzung für Teilhabe (OECD 2030, KMK 2021).


Didaktisches Design: Selbstlernbücher ermöglichen individuelles, selbstgesteuertes Lernen mit digitalen Medien.


Empirie: Begleitforschung bestätigt Motivationszuwachs und Kompetenzentwicklung.


Implikation: Digitale Selbstlernformate erfordern gezielte Vorbereitung, Reflexionsphasen und Lehrkräftebegleitung.


Ziel: Verbindung von Fachkompetenz, Medienkompetenz und Selbstlernkompetenz zu einer ganzheitlichen digitalen Bildung.



7. Verschlagwortung




Schlagwort


Begründung




Bildungstheorien


Bezug auf Selbstbestimmungstheorie (Deci \& Ryan) und OECD-Lernkompass als theoretische Grundlage.




Lehr- und Lerneffektivität


Empirische Daten belegen Zuwächse in Motivation und Selbstwirksamkeit.




Technologieintegration


Nutzung digitaler Tools (iMovie, Pages, LearningApps) als Lehr-Lern-Werkzeuge.




Systemanpassung


Digitale Selbstlernbücher als neue Unterrichtsform erfordern strukturelle und organisatorische Anpassung.




Forschungsansätze


Design-Based-Research mit iterativer Evaluation in realen Unterrichtskontexten.





8. Kategorisierung
Kategorie: Schlussfolgerung
Begründung:Der Beitrag zieht auf Basis empirischer Erprobung und theoretischer Reflexion fundierte Schlussfolgerungen über Wirksamkeit, Chancen und Grenzen digitaler Selbstlernbücher.

9. Zuordnung zur Forschungsunterfrage
Passendste Forschungsunterfrage: FU6

„Wie wird ein systemisch-konstruktivistisches Learning-Management-System als Kompetenzerwerbssystem bei Akteur*innen im digitalen Bildungsraum von Gesundheitsberufen beurteilt?“

Begründung:Das Selbstlernbuch fungiert als Lernmanagement-System im Kleinformat, das selbstorganisiertes, reflexives und mediengestütztes Lernen ermöglicht – direkt vergleichbar mit Kompetenzerwerbsprozessen in digitalen Bildungsräumen.

10. Relevanzbewertung




