}

@article{krahe_evaluation_2022,
	title = {Evaluation eines strukturierten {E}‑{Learning}-basierten {Ansatzes} zur {Vermittlung} der {CT}-{Anatomie} der {Nasennebenhöhlen} bei {Medizinstudierenden}: {Eine} {Pilotstudie}},
	issn = {0017-6192, 1433-0458},
	shorttitle = {Evaluation eines strukturierten {E}‑{Learning}-basierten {Ansatzes} zur {Vermittlung} der {CT}-{Anatomie} der {Nasennebenhöhlen} bei {Medizinstudierenden}},
	url = {https://link.springer.com/10.1007/s00106-021-01141-x},
	doi = {10.1007/s00106-021-01141-x},
	abstract = {Zusammenfassung
            
              Hintergrund
              Die radiologische Anatomie ist in vielen Ländern kein integraler Bestandteil des Medizinstudiums. Die Radiologie scheint für neue online-basierte Lehrmethoden besonders geeignet.
            
            
              Ziel der Arbeit
              Das Ziel dieser Studie ist es, die Eignung des E‑Learnings zur Einführung komplexer Lerninhalte, wie der CT-Anatomie (radiologische Anatomie in der Computertomographie), zu prüfen und zu prüfen, ob die Identifikation wichtiger anatomischer Normvarianten durch Medizinstudent(inn)en durch eine Computertomographie-Checkliste verbessert werden kann.
            
            
              Material und Methoden
              Medizinstudierende wurden gebeten, Computertomographien (CT) der Nasennebenhöhlen auf anatomische Normvarianten vor und nach der Einführung der CLOSE-Kriterien (cribriform plate = Lamina cribrosa, Lamina papyracea, Onodi-Zelle = Sphenoethmoidale Zelle, sphenoid sinus = Keilbeinhöhle, ethmoidal artery = Arteria ethmoidalis anterior) zu untersuchen. Sowohl die CT-Anatomie als auch die CLOSE-Kriterien wurden mittels E‑Learning vermittelt. Die Rate der korrekt identifizierten Normvarianten und die Ergebnisse für die einzelnen CLOSE-Items wurden ermittelt. Die subjektive Evaluation des Nutzens der Checkliste und des E‑Learnings erfolgte mithilfe eines Fragebogens.
            
            
              Ergebnisse
              Zehn Studierende nahmen an dieser Pilotstudie teil. Die Rate der korrekt identifizierten anatomischen Normvarianten verbesserte sich nach der Einführung der CLOSE-Kriterien signifikant von 33,3 auf 61,1 \%. Die Analyse der einzelnen CLOSE-Items zeigte eine signifikante Verbesserung für C, S und E. Die subjektive Evaluation des E‑Learnings und der CT-Checkliste waren sehr positiv.
            
            
              Schlussfolgerung
              Komplexe Lerninhalte können Medizinstudierenden mittels E‑Learning vermittelt werden, auch wenn bisher kein Vorwissen in diesem Bereich besteht. Das E‑Learning wird als angemessene Methode zur Einführung der Thematik beurteilt. Ein strukturiertes Vorgehen mithilfe der CLOSE-Kriterien kann die Erkennung anatomischer Normvarianten signifikant verbessern.
            
          , 
            Abstract
            
              Background
              Computed tomography (CT) anatomy is not an integral part of undergraduate medical training in many countries. Radiology seems to be well suited for new online-based teaching methods.
            
            
              Objective
              The aim of this study was to evaluate whether e‑learning is appropriate for introducing complex learning contents such as sinus CT anatomy to novices and to assess whether identification of relevant anatomical variants in sinus CT scans by medical students can be improved with a sinus CT checklist.
            
            
              Materials and methods
              Medical students were asked to assess sinus CT scans for anatomical variants before and after implementation of the CLOSE mnemonic (cribriform plate, lamina papyracea, Onodi cell, sphenoid sinus pneumatization, and [anterior] ethmoidal artery). Sinus CT anatomy and the CLOSE mnemonic were introduced by e‑learning. The rate of correctly identified variants and the results of the individual CLOSE items were recorded. A questionnaire was distributed for subjective evaluation of the usefulness of the checklist and e‑learning.
            
            
              Results
              Ten students took part in this pilot study. The rate of correctly identified variants improved significantly, from 33.3 to 61.1\%. The analysis of the individual CLOSE items showed a significant improvement for C, S, and E. The subjective evaluation of the CLOSE mnemonic and e‑learning was very positive.
            
            
              Conclusion
              E‑learning was able to transfer complex learning contents in previously non-trained medical students and was evaluated as an appropriate introduction to the topics. Structured assessment of paranasal sinus CT scans using the CLOSE criteria can significantly improve the recognition of anatomical variants.},
	language = {de-DE},
	urldate = {2022-01-22},
	journal = {HNO},
	author = {Krahe, Anna Marleen and Ketterer, Manuel Christoph and Offergeld, Christian and Hildenbrand, Tanja},
	month = jan,
	year = {2022},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Technologieintegration, Bewertungsmethoden, Promotion:FU6, Promotion:Schlussfolgerung, Promotion:S:11 Online Learning, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	file = {Krahe et al. - 2022 - Evaluation eines strukturierten E‑Learning-basiert.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/J9TFYXGU/Krahe et al. - 2022 - Evaluation eines strukturierten E‑Learning-basiert.pdf:application/pdf},
}

@article{lin_university_2025,
	title = {University instructors’ changes of conceptions about teaching and learning in knowledge building professional development},
	issn = {0218-8791, 1742-6855},
	url = {https://www.tandfonline.com/doi/full/10.1080/02188791.2025.2473366},
	doi = {10.1080/02188791.2025.2473366},
	language = {en-GB},
	urldate = {2025-03-10},
	journal = {Asia Pacific Journal of Education},
	author = {Lin, Feng and Zhu, Gaoxia and Low, Wei Yan and Teo, Chew Lee},
	month = mar,
	year = {2025},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Technologieintegration, Systemanpassung, Promotion:Weiterführung, Lernsystemarchitektur, Promotion:FU3, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {1--15},
	annote = {Analyse des Artikels von Lin et al. (2025) „University instructors’ changes of conceptions about teaching and learning in knowledge building professional development“:

1. Hauptthemen und Ziele der Forschung
Die Studie untersucht, wie sich die Lehr- und Lernvorstellungen von Universitätsdozent:innen nach einer kurzen, intensiven „Knowledge Building Professional Development“ (KBPD)-Intervention verändern. Dabei steht im Fokus:


In welchem Ausmaß verändern sich die Vorstellungen über Lehren und Lernen durch KBPD?


In welchen spezifischen Aspekten verändern sich diese Vorstellungen?


Die Forschung basiert auf dem Knowledge Building (KB)-Ansatz, der eine gemeinschaftsbasierte, wissensgenerierende Lehrmethodik betont.

2. Methoden und Datenquellen
Methodische Ansätze


Mixed-Methods-Ansatz: Kombination aus qualitativen und quantitativen Methoden.


Intervention (KBPD-Programm):


Drei synchron durchgeführte Workshops (je 3 Stunden).


Asynchrone Lernaktivitäten zwischen den Sitzungen.


Anwendung von Erfahrungslernen und Erwachsenenbildungstheorien (Kolb, 1984; Knowles et al., 2015).




Datenquellen


10 Universitätsdozent:innen (Alter: 31–65 Jahre) aus Singapur mit 4 bis 23 Jahren Lehrerfahrung.


Datenarten:


Lehrdokumente (z. B. Reflexionsberichte, Lehrmaterialien).


Surveys zur Erfassung von Lehrvorstellungen (z. B. „Teaching and Learning Conceptions Questionnaire“).


Interviews zur qualitativen Analyse der Wahrnehmungsveränderungen.





3. Zentrale Forschungsergebnisse


Erhöhte Akzeptanz von konstruktivistischen Lehrmodellen


Vor KBPD: Lehrkräfte betrachteten Studierende eher als passive Wissensrezipient:innen.


Nach KBPD: Sie förderten stärker gemeinschaftliches Wissenskonstruktionsprozesse.


Messbar in einer signifikanten Verschiebung auf der „Teaching and Learning Continuum“-Skala.




Tiefere Einsicht in kollaboratives Lernen


Vor KBPD: Kollaboration wurde als reine Gruppenarbeit verstanden.


Nach KBPD: Gemeinsame Wissensgenerierung und Ideensynthese wurden als Kernelemente erkannt.




Förderung der Lernenden-Autonomie


Nach der Schulung gaben Lehrkräfte mehr Verantwortung an Studierende ab (z. B. durch offene Fragen, studentengeleitete Diskussionen).




Rolle von „Knowledge Forum“ (KF) als Katalysator für Wandel


Digitale Plattform zur Förderung von Diskurs und Wissensaufbau.


Unterstützt eine kontinuierliche, reflexive Unterrichtskultur.




Barrieren für nachhaltige Veränderungen


Zeitliche Einschränkungen (knappe Lehrpläne, wenig Raum für Experimente).


Studierendenwiderstand gegen neue Methoden.


Institutionelle Strukturen (bewertungszentrierte Lehre statt Wissensgenerierung).





4. Zusammenfassung
Die Studie zeigt, dass eine kurze, gezielte KBPD-Schulung dazu führen kann, dass Universitätsdozent:innen vom traditionellen Wissenstransfer hin zu einem kollaborativen, wissensgenerierenden Unterrichtsansatz wechseln. Tiefgreifende strukturelle Veränderungen (z. B. in Prüfungsformaten oder Lehrplänen) sind jedoch nötig, um den Wandel nachhaltig zu verankern.

5. Kernaussagen (mit Seitenangaben)


Lehrkräfte verschoben ihre Vorstellung von passivem Lernen zu aktivem Wissensaufbau (S. 7).


Die Nutzung von Knowledge Forum stärkte kollaborative Lehrstrategien (S. 9).


Zeitliche und institutionelle Rahmenbedingungen beeinflussen die nachhaltige Umsetzung (S. 12).



6. Argumentationslinien
Die Studie entwickelt ihre Argumentation in drei Schritten:


Theoretischer Rahmen


Definition von Wissenskonstruktion als pädagogisches Prinzip.


Bedeutung von Lehrvorstellungen für Lehrpraktiken.




Empirische Untersuchung


Vergleich der Lehrvorstellungen vor und nach der KBPD-Intervention.


Messung der Veränderungen durch Surveys und Reflexionsberichte.




Implikationen für Hochschulbildung


Empfehlungen für die Gestaltung zukünftiger Fortbildungsprogramme.


Notwendigkeit institutioneller Unterstützung für langfristige Veränderungen.





7. Verschlagwortung (nur vordefinierte Schlagwörter)


Lernsystemarchitektur – Analyse, wie Knowledge Forum als digitale Plattform den Wissensaufbau unterstützt.


Lehr- und Lerneffektivität – Bewertung, wie sich Lehrmethoden nach der KBPD-Intervention verändert haben.


Systemanpassung – Herausforderungen bei der nachhaltigen Implementierung neuer Lehrmethoden.


Technologieintegration – Nutzung von „Knowledge Forum“ als digitale Plattform zur Förderung des Lernens.


Forschungsansätze – Anwendung von Mixed-Methods zur Untersuchung von Lehrveränderungen.



8. Kategorisierung
Weiterführung:


Die Studie zeigt, wie ein gezieltes Weiterbildungsprogramm die Lehrvorstellungen von Universitätsdozent:innen beeinflussen kann, wodurch neue Perspektiven auf digitale Bildung und kollaboratives Lernen entstehen (S. 13).



9. Zuordnung zur Forschungsunterfrage
Passendste Forschungsunterfrage:FU3: Wie sind Konzeption und relevante didaktische und bildungstechnologische Merkmale des systemisch-konstruktivistischen Learning-Management-Systems für Akteure im digitalen Bildungsraum von Gesundheitsberufen dargestellt?


Begründung:Die Studie untersucht, wie Lehrkräfte digitale Technologien und konstruktivistische Methoden in ihre Lehre integrieren, was direkt auf die Gestaltung von LMS im digitalen Bildungsraum übertragbar ist.



10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5(Die Studie untersucht, wie digitale Plattformen und konstruktivistische Ansätze in der Hochschulbildung umgesetzt werden).


Zitierhäufigkeit und Einfluss: 4(Publikation in einer renommierten Fachzeitschrift für Bildungsforschung, mit hoher methodischer Qualität).


Aktualität: 5(Veröffentlichung aus dem Jahr 2025, hochaktuell für die Forschung zu digitalen Bildungsformaten).


Gesamtbewertung: 5 (hoch relevant)

11. Schlussfolgerung
Die Studie von Lin et al. (2025) zeigt, dass ein gezieltes, kompaktes Fortbildungsprogramm die Lehrkonzeptionen von Universitätsdozent:innen signifikant verändern kann. Während digitale Werkzeuge wie Knowledge Forum kollaboratives Lernen unterstützen, bleibt die nachhaltige Umsetzung eine Herausforderung aufgrund zeitlicher und institutioneller Einschränkungen. Die Forschung liefert wertvolle Erkenntnisse zur Transformation von Lehrmethoden in digitalen Bildungsräumen.
},
	file = {Lin et al. - 2025 - University instructors’ changes of conceptions about teaching and learning in knowledge building pro:/Users/jochenhanisch-johannsen/Zotero/storage/AJ3ZXX4R/Lin et al. - 2025 - University instructors’ changes of conceptions about teaching and learning in knowledge building pro.pdf:application/pdf},
}

@article{jarvenoja_investigating_2025,
	title = {Investigating peer influence on collaborative group members' motivation through the lens of socially shared regulation of learning},
	issn = {0007-0998, 2044-8279},
	url = {https://bpspsychub.onlinelibrary.wiley.com/doi/10.1111/bjep.12754},
	doi = {10.1111/bjep.12754},
	abstract = {Background: Social context and peers significantly impact students' motivation, especially in collaborative learning settings. However, there is limited evidence on how students strategically influence each other's motivation through socially shared regulation of learning (SSRL). Aims: This study examined secondary school students' SSRL during collaborative learning, focusing on how groups regulate motivation and how these regulation processes influence individual situational motivation through peer interactions. Sample: The participants were 95 secondary school students (13–16 years) performing a collaborative science task in 31 groups.
Methods: Collaborative learning was videotaped to capture motivation regulation from social interactions. Four times during the task, individual perceptions of peer influence on motivation and motivation regulation were collected with situational self-reports, and individual stimulated-recall interviews were conducted after the task.
Results: The results showed that motivation regulation is embedded within broader SSRL processes. When motivation regulation coincided more likely with cognitive regulation, students perceived significantly higher peer influence on motivation. In interviews, students highlighted cognitive and social aspects of SSRL as crucial for their situational motivation but did not hardly recognize any direct motivation regulation strategies.
Conclusions: This study contributes to the methodological advancements for studying motivation as situation- and context-specific,emphasizingtheuseofdifferentdatachannels to capture the dynamic interplay between the individual- and group-level aspects throughout the learning process. For},
	language = {en-GB},
	urldate = {2025-02-23},
	journal = {British Journal of Educational Psychology},
	author = {Järvenoja, Hanna and Törmänen, Tiina and Lehtoaho, Emma and Turunen, Marjo and Suoraniemi, Jasmiina and Edwards, Justin},
	month = feb,
	year = {2025},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:FU4a, Promotion:Kerngedanke, Bewertungsmethoden, Promotion:Relevanz:4, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {bjep.12754},
	annote = {Analyse des Artikels von Järvenoja et al. (2025) „Investigating peer influence on collaborative group members' motivation through the lens of socially shared regulation of learning“:

1. Hauptthemen und Ziele der Forschung
Die Studie untersucht den Einfluss von Peers auf die Motivation von Lernenden in kollaborativen Lernsettings unter dem theoretischen Rahmen der sozial geteilten Regulation des Lernens (SSRL). Ziel ist es, zu analysieren, wie sich Peer-Interaktionen auf die situative Motivation auswirken und wie Lernende strategisch ihre eigene sowie die Gruppenmotivation regulieren.
Kernfragen der Forschung:


Wie häufig regulieren Gruppen ihre Motivation während eines kollaborativen Lernprozesses?


Wie nehmen Lernende den Einfluss von Gruppenmitgliedern auf ihre eigene situative Motivation wahr?


Welche Strategien zur Motivationserhaltung oder -steigerung lassen sich aus qualitativen Daten ableiten?



2. Methoden und Datenquellen
Methodische Ansätze


Multimodale Prozessanalyse: Kombination aus Videoanalysen, Selbstberichtsfragebögen und stimulierten Rückrufinterviews.


Situationsspezifische Erhebungen: Mehrfache Selbstberichte zur Motivation während des Lernprozesses.


Qualitative Videoanalyse: Identifikation von SSRL-Episoden mit Fokussierung auf kognitive und motivationale Regulation.


Statistische Analysen: Lineare gemischte Modelle zur Analyse der Gruppeneffekte auf Motivation.


Datenquellen


Teilnehmer: 95 Schüler:innen (13–16 Jahre) in 31 Gruppen.


Lernaufgabe: Gemeinsame Entwicklung eines Wasserfilters in vier Phasen.


Datenerfassung: Videoaufzeichnungen, Selbstberichte nach jeder Phase, Interviews zur Reflexion des Lernprozesses.



3. Zentrale Forschungsergebnisse


Motivationale Regulation tritt seltener auf als kognitive Regulation


Gruppen fokussieren sich primär auf kognitive Strategien, Motivation wird nur in spezifischen Situationen reguliert.


Besonders am Ende der Aufgabe (Phase 4) wird Motivation häufiger reguliert, wenn die Aufgabe abgeschlossen werden muss.




Peer-Einfluss auf Motivation ist situationsabhängig


Gruppenmitglieder motivieren sich gegenseitig eher indirekt durch eine positive soziale Atmosphäre als durch direkte Motivationsstrategien.


Lernende erkennen selten explizite Motivationsregulationen, obwohl diese in den Videos beobachtbar sind.




Indirekte Motivationserhaltungsstrategien dominieren


Gleichberechtigte Partizipation: Aktive Beteiligung aller Gruppenmitglieder steigert Motivation.


Positive emotionale Atmosphäre: Teamgeist und ermutigende Kommunikation stärken Motivation.


Funktionale soziale Interaktion: Klare Kommunikation und harmonische Zusammenarbeit fördern Engagement.





4. Zusammenfassung
Die Studie zeigt, dass Motivation in kollaborativen Gruppen eher indirekt durch soziale Prozesse als durch explizite Motivationsstrategien reguliert wird. Während kognitive Regulation häufiger auftritt, beeinflusst die soziale Dynamik der Gruppe maßgeblich die individuelle situative Motivation. Besonders die Schaffung einer positiven Lernatmosphäreund gleichberechtigte Partizipation tragen dazu bei, die Motivation aufrechtzuerhalten.

5. Kernaussagen (mit Seitenangaben)


Motivation wird weniger direkt reguliert als kognitive Prozesse (S. 9).


Peer-Einfluss auf Motivation ist besonders in schwierigen Lernphasen relevant (S. 12).


Lernende erkennen motivationale Unterstützung primär in indirekten sozialen Interaktionen (S. 14).


Positive Gruppenatmosphäre ist entscheidend für motivationale Stabilität (S. 16).



6. Argumentationslinien
Die Studie entwickelt ihre Argumentation in drei Schritten:


Theoretische Grundlage


Motivation ist kontextabhängig und wird in Gruppen durch soziale Interaktionen geprägt.


SSRL ermöglicht ein gemeinsames Regulationsverhalten, das Lernende unterstützt.




Empirische Analyse


Selbstberichte und Videoanalysen zeigen, dass Motivation eher indirekt als explizit reguliert wird.


Gruppeninteraktionen beeinflussen situative Motivation und kognitive Regulation simultan.




Implikationen für die Praxis


Förderung von bewusster Motivationserhaltung in Gruppen durch gezielte Interventionen.


Entwicklung von Lernstrategien zur expliziten Motivationsregulation.





7. Verschlagwortung (nur vordefinierte Schlagwörter)


Kollaboratives Lernen – Die Studie untersucht motivationale Prozesse innerhalb von Gruppeninteraktionen.


Lehr- und Lerneffektivität – Motivation wird als entscheidender Faktor für das Engagement und die Leistung in Gruppen erkannt.


Bewertungsmethoden – Nutzung von multimodalen Methoden zur Untersuchung von Motivation in Echtzeit.


Forschungsansätze – Kombination qualitativer und quantitativer Methoden zur Analyse von Motivation und sozialer Interaktion.



8. Kategorisierung
Kerngedanke:


Die Studie zeigt, dass Motivation in kollaborativen Lernumgebungen durch soziale Dynamiken und positive Gruppeninteraktionen reguliert wird (S. 17).



9. Zuordnung zur Forschungsunterfrage
Passendste Forschungsunterfrage:FU4a: Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?


Begründung:Die Studie untersucht, wie Motivation in Gruppen durch soziale Prozesse reguliert wird, was für digitale Lernumgebungen relevant ist, in denen kollaboratives Lernen eine zentrale Rolle spielt.



10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 4(Die Studie untersucht kollaboratives Lernen und Motivation, jedoch nicht spezifisch im Gesundheitsbereich).


Zitierhäufigkeit und Einfluss: 5(Publikation in einer hochrangigen Fachzeitschrift für Bildungspsychologie, hohe methodische Qualität).


Aktualität: 5(Veröffentlichung 2025, daher hochaktuell für die Forschung zu Motivation und kollaborativem Lernen).


Gesamtbewertung: 4 (hoch relevant)

11. Schlussfolgerung
Die Studie von Järvenoja et al. (2025) zeigt, dass Peer-Interaktionen in kollaborativen Lernprozessen einen zentralen Einfluss auf die Motivation der Lernenden haben. Insbesondere positive soziale Dynamiken, gleichberechtigte Partizipation und funktionale Kommunikation sind entscheidend für die Aufrechterhaltung der Motivation. Diese Erkenntnisse sind für die Gestaltung von Lernmanagementsystemen und kollaborativen digitalen Lernplattformen von hoher Bedeutung.
},
	file = {Järvenoja et al. - 2025 - Investigating peer influence on collaborative group members' motivation through the lens of socially:/Users/jochenhanisch-johannsen/Zotero/storage/XSXCHSUL/Järvenoja et al. - 2025 - Investigating peer influence on collaborative group members' motivation through the lens of socially.pdf:application/pdf},
}

@article{xiao_exploratory_2025,
	title = {An exploratory multimodal study of the roles of teacher-student interaction and emotion in academic performance in online classrooms},
	issn = {1360-2357, 1573-7608},
	url = {https://link.springer.com/10.1007/s10639-025-13426-7},
	doi = {10.1007/s10639-025-13426-7},
	abstract = {Teacher-student interaction is critical for providing learners with support and maintaining effective communication during the teaching process. The online teacherstudent interaction mode, has posed challenges to the effectiveness of online classes. However, how to conduct effective interaction in online classes to improve learning outcomes remains unclear. This study used multimodal data analysis of platform behavior and emotional data to investigate the impacts of teacher-student interaction and emotions on students’ academic performance in an online classroom setting. Findings indicate that adult learners’ interactive behaviors, particularly the number of podium appearances and the number of rewards received, positively affect their quiz performance in real time. Additionally, negative emotion frequency collected within a time window shorter than the entire online class was positively correlated with quiz performance. The preliminary results of this study inspire and guide teachers in understanding classroom dynamics and optimizing the teaching process effectively and promptly.},
	language = {en-GB},
	urldate = {2025-02-15},
	journal = {Education and Information Technologies},
	author = {Xiao, Jun and Chen, Mo and Yang, Yule and Liu, Mengting},
	month = feb,
	year = {2025},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Promotion:FU2a, Promotion:Relevanz:4, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU2a},
	annote = {Analyse des Artikels von Xiao et al. (2025) „An exploratory multimodal study of the roles of teacher-student interaction and emotion in academic performance in online classrooms“:

1. Hauptthemen und Ziele der Forschung
Die Studie untersucht die Auswirkungen von Lehrkraft-Schüler-Interaktionen und emotionalen Reaktionen auf die akademische Leistung in Online-Klassenzimmern. Dabei wird eine multimodale Datenerhebung genutzt, um das Verhalten von Studierenden auf Online-Plattformen sowie deren emotionale Zustände während des Lernprozesses zu analysieren.
Zentrale Forschungsfragen:


Welche interaktiven Verhaltensweisen (z. B. Anzahl der Handhebungen, Kamera-On-Zeiten) verbessern die akademische Leistung?


Inwiefern reflektieren emotionale Reaktionen (z. B. Gesichtsausdrücke) die akademische Leistung der Studierenden?


Welche Kombination von Verhaltens- und Emotionsindikatoren kann die akademische Leistung am besten vorhersagen?



2. Methoden und Datenquellen
Methodische Ansätze


Multimodale Datenerhebung: Kombination von Plattform-Interaktionsdaten und Emotionserkennungsdaten.


Statistische Analysen: Korrelationen und multiple Regressionsanalysen zur Identifikation relevanter Faktoren für den Lernerfolg.


Experimentelles Design: Auswahl interaktiver Online-Kurse zur Erhebung von Verhalten und Emotionen.


Datenquellen


Teilnehmer: 387 erwachsene Studierende an der Shanghai Open University.


Verhaltensdaten: Anzahl der Mikrofonnutzungen, Podiumsdauer, Anzahl der Belohnungen, Handhebungen, Kamerazeit etc.


Leistungsdaten: Quiz-Ergebnisse als Maß für akademische Leistung.


Emotionale Daten: Gesichtsausdrücke (positive, negative, neutrale Emotionen) erfasst durch Webcam-Analyse mit FaceReader-Software.



3. Zentrale Forschungsergebnisse


Lehrkraft-Schüler-Interaktion beeinflusst akademische Leistung signifikant


Häufigere Podiumsauftritte und erhaltene Belohnungen korrelieren positiv mit besseren Quiz-Ergebnissen.


Die Anzahl der Handhebungen zeigt im multimodalen Kontext eine stärkere Vorhersagekraft für akademische Erfolge.




Emotionale Reaktionen beeinflussen die akademische Leistung


Negative Emotionen (z. B. Frustration) korrelieren positiv mit der Quiz-Leistung.


Studierende mit höheren negativen Emotionsanteilen zeigen teilweise bessere Lernergebnisse.




Multimodale Kombinationen von Verhaltens- und Emotionsdaten liefern bessere Vorhersagen


Kombinationen aus Interaktions- und emotionalen Indikatoren können Lernleistungen besser prognostizieren als Einzelvariablen.


Besonders Handhebungen in Kombination mit negativen Emotionen erwiesen sich als signifikante Prädiktoren für höhere Quiz-Ergebnisse.





4. Zusammenfassung
Die Studie zeigt, dass Interaktionsverhalten und emotionale Faktoren eine entscheidende Rolle für den Lernerfolg in Online-Klassenzimmern spielen. Besonders aktive Beteiligung (z. B. Podiumsnutzung, Handhebungen) und die Fähigkeit, negative Emotionen produktiv zu nutzen, können die akademische Leistung steigern. Diese Erkenntnisse sind für die Optimierung von Online-Lehrformaten von Bedeutung.

5. Kernaussagen (mit Seitenangaben)


Podiumsnutzung und erhaltene Belohnungen fördern bessere akademische Leistung (S. 24).


Häufigere Handhebungen sind im multimodalen Kontext ein starker Prädiktor für Lernerfolg (S. 32).


Negative Emotionen können einen positiven Einfluss auf Lernprozesse haben (S. 41).


Multimodale Daten liefern genauere Vorhersagen als einzelne Verhaltens- oder Emotionsparameter (S. 46).



6. Argumentationslinien
Die Studie entwickelt ihre Argumentation in drei Schritten:


Theoretischer Rahmen


Kombination von Lehrkraft-Schüler-Interaktion und Emotionsforschung.


Nutzung von multimodalen Datenanalyseansätzen zur Untersuchung von Online-Lernszenarien.




Empirische Analyse


Identifikation relevanter Interaktionsmuster und emotionaler Zustände durch statistische Analysen.


Untersuchung der Korrelationen zwischen Verhaltens- und Leistungsindikatoren.




Schlussfolgerungen und Implikationen


Online-Lernen kann durch gezielte Gestaltung der Interaktionsmöglichkeiten optimiert werden.


Negative Emotionen können Teil produktiver Lernprozesse sein, wenn sie kognitiv aktivierend wirken.





7. Verschlagwortung (nur vordefinierte Schlagwörter)


Lehr- und Lerneffektivität – Die Studie untersucht, wie Interaktionsverhalten die akademische Leistung beeinflusst.


Kollaboratives Lernen – Die Rolle der Lehrkraft-Schüler-Interaktion im Online-Raum wird detailliert analysiert.


Bewertungsmethoden – Messung der akademischen Leistung anhand von Quiz-Ergebnissen.


Technologieintegration – Einsatz von multimodalen Technologien zur Erfassung von Emotionen und Verhalten.


Forschungsansätze – Anwendung von multimodaler Datenanalyse zur Untersuchung von Online-Lernprozessen.



8. Kategorisierung
Kerngedanke:


Die Studie zeigt, dass Lehrkraft-Schüler-Interaktion und emotionale Zustände signifikante Prädiktoren für akademische Leistungen in Online-Klassenzimmern sind (S. 49).



9. Zuordnung zur Forschungsunterfrage
Passendste Forschungsunterfrage:FU2a: Welchen Effekt erläutern Lernende im digitalen Bildungsraum von Gesundheitsberufen bei der Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems?


Begründung:Die Studie analysiert, wie Lernende auf Interaktionsmöglichkeiten in Online-Kursen reagieren und welche Effekte dies auf ihre akademische Leistung hat.



10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 4(Die Studie liefert zentrale Erkenntnisse über Interaktionsmechanismen, jedoch nicht spezifisch für Gesundheitsberufe).


Zitierhäufigkeit und Einfluss: 5(Publikation in einem renommierten Journal für digitale Bildungstechnologien).


Aktualität: 5(Veröffentlichung für 2025, hochaktuell für die Forschung zu Online-Lernprozessen).


Gesamtbewertung: 4 (hoch relevant)

11. Schlussfolgerung
Die Studie von Xiao et al. (2025) zeigt, dass Lehrkraft-Schüler-Interaktionen und emotionale Reaktionen zentrale Mechanismen für den Lernerfolg in Online-Klassenzimmern sind. Besonders aktive Beteiligung und das produktive Nutzen negativer Emotionen tragen zur Verbesserung der akademischen Leistung bei. Diese Erkenntnisse sind für die Entwicklung von datengestützten Online-Lernplattformen und Lehrmethoden von hoher Relevanz.
