	author = {Çağlar, Tolga and Altıntaş, Ilkay and De Callafon, Raymond A.},
	editor = {Paszynski, Maciej and Barnard, Amanda S. and Zhang, Yongjie Jessica},
	year = {2025},
	doi = {10.1007/978-3-031-97567-7_9},
	note = {Series Title: Lecture Notes in Computer Science},
	keywords = {Charité:Promotion, Promotion:Literaturanalyse, Forschungsansätze, Technologieintegration, Bewertungsmethoden, Systemanpassung, Promotion:Argumentation, Promotion:FU4b, Lernsystemarchitektur, Promotion:Relevanz:3, \#0:Buchteil:digital:learning, Promotion:S:12 Digital Learning, Promotion:Literaturverzeichnis},
	pages = {95--109},
