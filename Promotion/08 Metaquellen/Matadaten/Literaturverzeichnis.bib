@inproceedings{breiweHsue,
  title = {„Die, die zu Hause sind: Übt einfach weiter.“},
  booktitle = {Beiträge zum 28. Kongress der Deutschen Gesellschaft für Erziehungswissenschaft},
  author = {Breiwe, René and Liegmann, Anke B and Racherbäumer, Kathrin and Schwehr, Marion and Bau, Jessica},
  editor = {Heinemann, Alisha and Karakaşoğlu, Yasemin and Linnemann, Tobias and Rose, Nadine and Sturm, Tanja},
  date = {2023},
  publisher = {Verlag Barbara Budrich},
  abstract = {In times of the pandemic, teachers are challenged to do remote teaching. In the sense of the culture of digitality (Stalder 2019), new virtual, hybrid, participatory, and even transnational teaching and learning spaces that emerge as a result can be simultaneously individualized and networked. In contrast, there are attachments to traditional notions of teaching that are oriented toward paradigms of orality, scriptography, and typography (Krommer 2019). Thus, face-to-face instruction is normatively considered the teaching, while digitized forms of instruction are seen as compensatory substitutes (Krommer/Wampfler 2021). In this article, it is analyzed on the basis of ethnographic observations of hybrid teaching whether and to what extent digitalized forms of teaching-learning are associated with transformative developments of teaching in terms of the culture of diversity and digitality. It is shown that instructional practices follow a conventional order of teaching that runs counter to the transformative potentials of diversity and digitality.},
  eventtitle = {28. Kongress der Deutschen Gesellschaft für Erziehungswissenschaft},
  langid = {ngerman},
  keywords = {⛔ No DOI found,0:Konferenz-Paper:digital:learning,Charité:Promotion,Promotion:Literaturanalyse,Promotion:S:12 Digital Learning},
  file = {/Users/jochen_hanisch-johannsen/Zotero/storage/ZN3WDQNM/Breiwe et al. - „Die, die zu Hause sind Übt einfach weiter.“.pdf}
}

