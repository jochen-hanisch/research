  keywords = {7:Zeitschriftenartikel:digital:Medien,Adult pedagogics,Bildung,Charité:Promotion,Competency,Deutschland,Digitale Bildung,Erwachsenenbildner,Erwachsenenpädagogik,Further education,Germany,Kompetenz,Lehr- und Lerneffektivität,Media competence,Media pedagogics,Media skills,Medienpädagogik,Modell,Pedagogics for adults,Professionalisierung,Professionalization,Promotion:02-01_Q2,Promotion:Argumentation,Promotion:FU5,Promotion:Literaturanalyse,Promotion:Relevanz:4,Promotion:S:07 Digitale Medien,Technologieintegration,Weiterbildner,Weiterbildung},
  file = {/Users/jochen_hanisch-johannsen/Zotero/storage/7CH2KGDV/Alberti, Vanessa et al. - 2022 - Digitale Kompetenzen Lehrender. Zur Möglichkeit ih.pdf}
