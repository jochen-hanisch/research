@article{zhang_global_2015,
	title = {Global {Outreach} of a {Locally}-{Developed} {Mobile} {Phone} {App} for {Undergraduate} {Psychiatry} {Education}},
	volume = {1},
	url = {https://pubmed.ncbi.nlm.nih.gov/27731838/},
	abstract = {Background: Over the past decade, there have been massive developments in both Web-based and mobile phone technologies. Mobile phones are well accepted by students, trainees, and doctors. A review of the current literature has identified the following specialties that have used mobile phones in education: pediatrics, ophthalmology, nephrology, plastic surgery, orthopedics, pharmacology, and urology. However, to date, there are no published papers examining the application of the latest mobile phone technologies for psychiatry education internationally. Objectives: The main objectives of this study are (1) to determine the feasibility and receptiveness of a locally-developed psychiatry mobile phone app and user perspectives (both quantitative and qualitative) towards it, and (2) to determine the receptiveness of a locally-developed app for psychiatry education internationally. Methods: A Web-based app that contained textbook contents, videos, and quizzes was developed using HTML5 technologies in 2012. Native apps were subsequently developed in 2013. Information about the apps was disseminated locally to Singaporean medical students, but the respective native apps were made available on the app stores. A user perspective survey was conducted locally to determine student?s perception of the app. Results: From the inception of the app until the time of preparation of this manuscript, there have been a cumulative total of 28,500 unique visits of the responsive HTML5 Web-based mobile phone app. There have been a cumulative total of 2200 downloads of the Mastering Psychiatry app from the Apple app store and 7000 downloads of the same app from the Android app store. The initial user perspective survey conducted locally highlighted that approximately a total of 95.2\% (177/186) of students felt that having a psychiatry mobile phone app was deemed to be useful. Further chi-squared analysis demonstrated that there was a significant difference between males and females in their perception of having textbook contents in the mobile phone app (?24=12.9, P=.0012). Conclusions: To the best of our knowledge, this is the first study to demonstrate the feasibility and global acceptance of a local, self-designed educational app for psychiatry education. Whilst the current research has managed to demonstrate the feasibility and acceptance of such an app, future studies would be warranted to look, in-depth, into whether there are cultural differences in terms of perceptions towards having such an app in psychiatry and what contents different cultures and cohorts of students might want within an app.},
	language = {en-US},
	number = {1},
	urldate = {2024-06-14},
	journal = {JMIR Medical Education},
	author = {Zhang, WB Melvyn and Cheok, CS Christopher and Ho, CM Roger},
	month = jun,
	year = {2015},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Bewertungsmethoden, Promotion:Argumentation, \#6:Zeitschriftenartikel:Bildung:Technologie, Digitale Bildung, Promotion:Relevanz:3, education, Promotion:FU1, feasibility, psychiatry, mobile phones, mobile phone apps, proof of concept, Promotion:S:06 Bildungstechnologie, Promotion:Dissertation {\textbar} FU1 {\textgreater} Argumentation, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU1},
	pages = {e3},
	annote = {Analyse des Artikels „Global Outreach of a Locally-Developed Mobile Phone App for Undergraduate Psychiatry Education“ von Zhang et al. (2015)

1. Analyse
Hauptthemen und Ziele der Forschung


Thema: Untersuchung der globalen Akzeptanz und Wirksamkeit einer lokal entwickelten mobilen App (Mastering Psychiatry) für die psychiatrische Ausbildung von Medizinstudierenden.


Ziel: Bewertung der Machbarkeit, Akzeptanz und der Perspektiven von Nutzer*innen sowohl lokal (Singapur) als auch international.


Verwendete Methoden und Datenquellen


Methodik:


Entwicklung einer mobilen App mit HTML5-Technologie, später als native App für iOS und Android veröffentlicht.


Fragebogengestützte Umfrage zur Bewertung der Nutzersicht (quantitativ und qualitativ).


Usability-Tests und Feedback von 185 Medizinstudierenden.




Datenquellen:


28.500 Besuche der HTML5-App.


9.200 Downloads der nativen Apps (7.000 für Android, 2.200 für iOS).




Zentrale Forschungsergebnisse


Hohe Akzeptanz: 95,2 \% der Befragten hielten die App für nützlich; 71,4 \% sahen sie als sinnvolle Ergänzung zu Lehrbüchern.


Globaler Nutzen: Studierende aus mehreren Ländern griffen auf die App zu, wobei Singapur den Großteil der Nutzer*innen stellte.


Technische Qualität: Die App erzielte im Durchschnitt 4+ Sterne auf beiden Plattformen, mit überwiegend positivem Feedback.



2. Zusammenfassung
Die mobile App Mastering Psychiatry demonstriert die Machbarkeit und Akzeptanz digitaler Technologien in der medizinischen Ausbildung. Die Ergebnisse zeigen, dass mobile Bildungsplattformen wie diese App dazu beitragen können, den Zugang zu hochwertiger psychiatrischer Ausbildung zu verbessern, insbesondere in Regionen mit eingeschränktem Zugang zu traditionellen Ressourcen.

3. Kernaussagen


Hohe Nutzerzufriedenheit: Die Mehrheit der Studierenden empfand die App als nützlich und praxisrelevant (S. 8).


Flexibilität und Skalierbarkeit: Die App ermöglichte das Lernen „on the go“ und unterstützte interaktive Lernmethoden (S. 10).


Internationale Reichweite: Neben Singapur waren die USA und Malaysia die Länder mit der höchsten Nutzeranzahl (S. 9).



4. Argumentationslinien


Theoretische Grundlage: Die Studie betont die Rolle mobiler Technologien in der Überbrückung geografischer und ressourcenbezogener Bildungslücken (S. 6).


Empirische Evidenz: Die hohe Anzahl an Downloads und das positive Feedback bestätigen die Machbarkeit und Akzeptanz der App (S. 9).


Praktische Relevanz: Die App dient als skalierbares Modell für die Implementierung mobiler Lernressourcen in anderen Fachbereichen (S. 11).



5. Verschlagwortung


Technologieintegration: Der Artikel untersucht die Anwendung von mobilen Apps zur Unterstützung der psychiatrischen Ausbildung.


Lehr- und Lerneffektivität: Die Studie zeigt, dass digitale Lernplattformen das Lernen effizienter und flexibler gestalten können.


Systemanpassung: Die App demonstriert eine anpassungsfähige und nutzerfreundliche Gestaltung für verschiedene Bildungsbedürfnisse.



6. Kategorisierung
Kategorie: Kerngedanke


Begründung: Die Arbeit zeigt, wie mobile Bildungsplattformen erfolgreich in der medizinischen Ausbildung eingesetzt werden können, um globale Bildungslücken zu schließen (S. 12).



7. Zuordnung zu Forschungsfragen
Passendste Forschungsunterfrage: FU3: „Wie sind Konzeption und relevante didaktische und bildungstechnologische Merkmale des systemisch-konstruktivistischen Learning-Management-Systems für Akteure im digitalen Bildungsraum von Gesundheitsberufen dargestellt?“


Begründung: Der Artikel beschreibt detailliert die didaktische Gestaltung und die technologischen Merkmale der App (S. 8–10).



8. Relevanzbewertung


Direkte Relevanz: 5 (Hoch relevant für die Integration mobiler Apps in die medizinische Ausbildung).


Aktualität: 3 (Veröffentlichung 2015, methodisch relevant, aber weniger aktuell).


Zitierhäufigkeit: 4 (Globale Relevanz und praxisorientierter Beitrag).


Gesamtbewertung: 4
},
	file = {Zhang et al. - 2015 - Global Outreach of a Locally-Developed Mobile Phon.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/IYCVFT7U/Zhang et al. - 2015 - Global Outreach of a Locally-Developed Mobile Phon.pdf:application/pdf},
}

@article{wirzberger_padagogik_2019,
	title = {Pädagogik trifft {Psychologie} und {Informatik}: {Interdisziplinäre} {Perspektiven} zur {Gestaltung} intelligenter {Bildungstechnologien}},
	abstract = {Wie lassen sich Lernsituationen bestmöglich auf die Lernenden abstimmen, um damit individuelle und gesellschaftlich relevante Bildungsziele nachhaltig zu erreichen? Die Antwort darauf suche ich durch die Verbindung von pädagogischer Theorie, psychologischer Methodik und intelligenten Algorithmen. Die daraus entstehenden intelligenten Technologien bieten die Möglichkeit, auf individuelle Bedarfe unterschiedlicher Lernender in verschiedenen Kontexten gezielt einzugehen. Dazu müssen sie allerdings fähig sein, sich auf spezifische Charakteristika der Lernenden und der Situation einzustellen. Dies bedeutet, beobachtete Zustände korrekt zu interpretieren und mit dem notwendigen Maß an Unterstützung angemessen darauf zu reagieren. In meinen Forschungsprojekten setze ich mich mit Aspekten der Lernenden und der Lernsituation auseinander, die für die Schaffung solcher Systeme wichtig sind. Im Beitrag möchte ich vier ausgewählte Schwerpunkte meiner Arbeit vorstellen.},
