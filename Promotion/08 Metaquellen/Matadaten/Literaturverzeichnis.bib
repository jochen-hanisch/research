@incollection{isaias_supporting_2024,
	address = {Cham},
	title = {Supporting {Students}’ {Mathematical} {Problem} {Solving} {Through} {Computational} {Thinking} and {Programming}: {A} {Use}-{Modify}-{Create} {Approach}},
	isbn = {978-3-031-66461-8 978-3-031-66462-5},
	shorttitle = {Supporting {Students}’ {Mathematical} {Problem} {Solving} {Through} {Computational} {Thinking} and {Programming}},
	url = {https://link.springer.com/10.1007/978-3-031-66462-5_11},
	doi = {10.1007/978-3-031-66462-5_11},
	abstract = {This chapter explores a Use-Modify-Create approach in assisting students’ mathematical problem-solving skills through mathematical thinking (MT), computational thinking (CT), and programming activities. The approach aims to gradually introduce students to new challenges and concepts through three stages of learning: Use, modify and create, within a mathematical educational context. The research design is a case study conducted in the context of a first-year undergraduate course on programming with applications in mathematics. Data collection involves participant observation of students’ mathematical problem solving, wherein the researcher assumes the roles of teacher and group activity facilitator. The observations are carried out in eight separate sessions with students at the undergraduate level, solving a mathematical task. Data analysis adopts an inductive strategy based on the interplay between the Use-Modify-Create framework and the empirical data. The main findings of the study are threefold. Firstly, the connections between MT, CT, and programming prove weak for most students. Secondly, while some students claim that the Use-Modify-Create approach has supported their understanding to some extent, its overall impact remains unclear. Thirdly, the teacher’s role as a mediator and facilitator is crucial to students’ progress. Implications drawn from the results aim to enhance students’ mathematical problem-solving skills through better design and implementation of the Use-Modify-Create approach, particularly in integrating MT, CT, and programming.},
	language = {en-GB},
	urldate = {2024-08-17},
	booktitle = {Artificial {Intelligence} for {Supporting} {Human} {Cognition} and {Exploratory} {Learning} in the {Digital} {Age}},
	publisher = {Springer Nature Switzerland},
	author = {Hadjerrouit, Said and Hansen, Nils Kristian},
	editor = {Isaias, Pedro and Sampson, Demetrios G. and Ifenthaler, Dirk},
	year = {2024},
	note = {Series Title: Cognition and Exploratory Learning in the Digital Age},
	keywords = {Promotion:Literaturanalyse, \#b:Buchteil:online:learning, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {203--219},
	file = {Hadjerrouit und Hansen - 2024 - Supporting Students’ Mathematical Problem Solving .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/C7XXAGPU/Hadjerrouit und Hansen - 2024 - Supporting Students’ Mathematical Problem Solving .pdf:application/pdf},
}

@article{hull_use_2024,
	title = {The {Use} of a {Multimedia}-{Enabled}, {Serialized} {Worked}-{Example} {Artifact} in an {Online} {Environment} for {Secondary} {Education}},
	issn = {0738-0569, 1528-7033},
	url = {https://www.tandfonline.com/doi/full/10.1080/07380569.2024.2390396},
	doi = {10.1080/07380569.2024.2390396},
	abstract = {High school students in rural and semi-rural areas are disadvantaged because their schools struggle to attract and retain instructors who are qualified to teach career and technology courses that ready students for the knowledge economy. The effects of the pandemic moved much knowledge-economy work online by adopting study-from-home (SFH) models; however, educational institutions have been slow to validate corresponding study-from-home instructional models. In response, the current study developed study-from-home instruction using a multimedia-enabled, serialized worked-example artifact to teach financial accounting and modeling for high school students. The study featured grounded theories that inform the design of SFH instruction and online facilitation for a yearlong study. The instruction aimed to promote the far transfer of domain-specific, career-development knowledge regarding financial accounting and modeling. To do so, authors conducted a quasi-experiment with 50 students from five public high schools in rural and semi-rural East Texas. The result shows that socially situated SFH instruction whose design follows the principles of cognitive load theory, situated learning, and cognitive apprenticeship promoted mastery-of-learning outcomes over the course of an academic year. Our findings indicate a promising new direction in the design of remote instruction that delivers complex content to small-screen mobile devices for high school students.},
	language = {en-GB},
	urldate = {2024-08-17},
	journal = {Computers in the Schools},
	author = {Hull, David Michael and Sung, Woonhee},
	month = aug,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Lehr- und Lerneffektivität, Systemanpassung, Promotion:Argumentation, Promotion:Relevanz:4, Promotion:FU4b, Lernsystemarchitektur, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {1--19},
	annote = {Analyse der Studie "The Use of a Multimedia-Enabled, Serialized Worked-Example Artifact in an Online Environment for Secondary Education" von Hull \& Sung (2024)
1. Hauptthemen und Ziele der Forschung
Die Studie von Hull \& Sung (2024) untersucht die Wirksamkeit eines multimedial unterstützten, serialisierten Worked-Example-Artefakts im Rahmen des Online-Unterrichts für Schülerinnen und Schüler der Sekundarstufe in ländlichen und semi-ländlichen Regionen. Ziel der Forschung ist es, zu evaluieren, wie diese Form der instruktionalen Unterstützung dazu beitragen kann, fachspezifisches Wissen in den Bereichen Finanzbuchhaltung und Modellierung zu vermitteln, insbesondere in einem Umfeld, das durch begrenzte Ressourcen und die Notwendigkeit von Fernunterricht gekennzeichnet ist.
2. Methoden und Datenquellen
Methoden:


Die Studie implementierte ein quasi-experimentelles Design, bei dem 50 Schülerinnen und Schüler aus fünf öffentlichen Schulen in Osttexas über ein akademisches Jahr hinweg an einem Fernunterrichtsprogramm teilnahmen.


Die Unterrichtsstrategie umfasste die Nutzung eines multimedialen, serialisierten Worked-Example-Artefakts, das über mobile Geräte zugänglich war und in einem sozialen Lernkontext verankert wurde. Diese Methode wurde durch Theorien wie die Cognitive Load Theory und das kognitive Lehrlingsmodell gestützt.


Datenquellen:


Die Daten stammen aus verschiedenen Erhebungen während des Schuljahres, bei denen die Lernfortschritte der Schülerinnen und Schüler hinsichtlich der Anwendung von fachspezifischem Wissen in den Bereichen Liquidität und Rentabilität gemessen wurden. Die Datenerhebung erfolgte zu vier verschiedenen Zeitpunkten: August 2020, Dezember 2020, Januar 2021 und April 2021.


3. Zentrale Forschungsergebnisse


Verbesserung der Lernleistungen:


Die Studie zeigte signifikante Verbesserungen in der Anwendung des erworbenen Wissens zu den Themen Liquidität und Rentabilität, insbesondere nach der Einführung des Worked-Example-Artefakts. Die Lernfortschritte waren zu allen Erhebungszeitpunkten statistisch signifikant.




Cognitive Load und Lerneffektivität:


Die Ergebnisse unterstützen die Annahme, dass der Einsatz von multimedial unterstützten Worked-Examples die kognitive Belastung reduziert und somit das Lernen komplexer Inhalte fördert.




Langfristige Wissensübertragung:


Die Studie fand heraus, dass die Verwendung des serialisierten Worked-Example-Artefakts nicht nur kurzfristige Lerneffekte, sondern auch eine nachhaltige Wissensübertragung ermöglichte, die über den Verlauf des Schuljahres hinweg stabil blieb.




4. Zusammenfassung
Die Studie untersucht die Wirkung eines multimedialen, serialisierten Worked-Example-Artefakts im Online-Unterricht an Sekundarschulen in ländlichen Regionen. Die Ergebnisse zeigen, dass diese Methode das Lernen komplexer fachspezifischer Inhalte signifikant verbessert und gleichzeitig die kognitive Belastung der Lernenden reduziert.
5. Kernaussagen


Lernfortschritt: Signifikante Verbesserungen in der Anwendung von Wissen über Liquidität und Rentabilität wurden nach Einführung des Worked-Example-Artefakts festgestellt. (S. 12)


Cognitive Load Theory: Die Verwendung des serialisierten Worked-Example-Artefakts unterstützt das Lernen durch Reduktion der kognitiven Belastung. (S. 7)


Nachhaltige Wissensübertragung: Die positiven Effekte des Lernansatzes blieben über das Schuljahr hinweg erhalten. (S. 14)


6. Argumentationslinien
Die Autoren argumentieren, dass der Einsatz von multimedialen, serialisierten Worked-Examples im Online-Unterricht eine effektive Strategie zur Vermittlung komplexer Inhalte darstellt, insbesondere in Umgebungen, die durch begrenzte Ressourcen und Fernunterricht geprägt sind. Diese Methode ermöglicht es, die kognitive Belastung zu reduzieren und gleichzeitig die Lernwirksamkeit zu erhöhen. (S. 16)
7. Verschlagwortung


Lernsystemarchitektur: Die Studie untersucht die spezifische Gestaltung und den Einsatz von multimedialen Worked-Examples in Online-Lernumgebungen.


Lehr- und Lerneffektivität: Die Forschung belegt die Wirksamkeit von Worked-Examples zur Verbesserung der Lernleistung und Wissensübertragung.


Systemanpassung: Die Anpassung der Unterrichtsmethoden an die Bedürfnisse von Schülerinnen und Schülern in ländlichen Gebieten wird thematisiert.


8. Kategorisierung
Argumentation: Die Studie stützt sich auf theoretische Modelle wie die Cognitive Load Theory, um die Wirksamkeit des Einsatzes von Worked-Examples im Online-Unterricht zu untermauern und zeigt auf, wie diese Methode die kognitive Belastung verringert und das Lernen fördert. (S. 17)
9. Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU4b: Welche technisch-gestalterischen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?


Begründung: Die Studie untersucht, wie technische und gestalterische Mechanismen (wie Worked-Examples) effektiv in einem digitalen Bildungsumfeld eingesetzt werden können, um das Lernen zu fördern.


10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie liefert wichtige Erkenntnisse zur Anwendung und Wirksamkeit von multimedialen Unterrichtsstrategien in digitalen Bildungssystemen).


Zitierhäufigkeit und Einfluss: 4 (Die Studie ist aktuell und bietet wertvolle Einblicke für die Bildungsforschung).


Aktualität: 5 (Veröffentlichung im Jahr 2024, daher sehr aktuell).


Gesamtbewertung: 4.7
11. Schlussfolgerung
Die Studie von Hull \& Sung (2024) zeigt, dass der Einsatz von multimedialen, serialisierten Worked-Examples im Online-Unterricht eine effektive Methode zur Vermittlung komplexer fachspezifischer Inhalte darstellt. Diese Methode trägt dazu bei, die kognitive Belastung zu verringern und das langfristige Lernen zu fördern, insbesondere in Umgebungen mit begrenzten Ressourcen.
},
	file = {Hull und Sung - 2024 - The Use of a Multimedia-Enabled, Serialized Worked.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/5PS3GAUE/Hull und Sung - 2024 - The Use of a Multimedia-Enabled, Serialized Worked.pdf:application/pdf},
}

@article{grassinger_durch_2024,
	title = {Durch ein {Online}-{Self}-{Assessment} angeregte {Selbstreflexion} von {Lernerfahrungen} im {Praktikum}: {Eine} {Studie} zum {Zusammenhang} der {Selbstreflexion} mit motivationalen {Zielen}, dem {Erleben} motivationaler {Erwartungsdiskrepanz} und der {Verunsicherung} ob der {Studienwahl}},
	copyright = {https://creativecommons.org/licenses/by-nc-nd/4.0},
	issn = {1010-0652, 1664-2910},
	shorttitle = {Durch ein {Online}-{Self}-{Assessment} angeregte {Selbstreflexion} von {Lernerfahrungen} im {Praktikum}},
	url = {https://econtent.hogrefe.com/doi/10.1024/1010-0652/a000376},
	doi = {10.1024/1010-0652/a000376},
	abstract = {Online self-assessments are discussed as an instrument to support self-regulated learning behavior of students. Online self-assessments can stimulate self-reflection on current learning experiences, a phase of self-regulated learning behavior, and can manifest itself in more elaborate self-reflection knowledge. It was hypothesized that self-reflection knowledge stimulated by an online self-assessment is relat­ ed to individual mastery and work avoidance goals (H1) and is associated with experiencing motivational expectancy discrepancy as well as uncertainty about the appropriate study choice (H2). These two hypotheses were tested on a sample of 299 student teachers. The findings showed that mastery goals favored self-knowledge about the learning situation through an online self-assessment, but work avoidance goals were not related to it. An increased self-reflection knowledge stimulated by an online self-assessment was also associated with the experience of a positive motivational expectation discrepancy, but not with uncertainty about the appropriate study choice.},
	language = {de-DE},
	urldate = {2024-02-10},
	journal = {Zeitschrift für Pädagogische Psychologie},
	author = {Grassinger, Robert and Schnebel, Stefanie},
	month = feb,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Bewertungsmethoden, Systemanpassung, Promotion:Argumentation, Promotion:FU5, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {1010--0652/a000376},
	annote = {Analyse der Studie "Durch ein Online-Self-Assessment angeregte Selbstreflexion von Lernerfahrungen im Praktikum" von Grassinger und Schnebel (2024)
1. Hauptthemen und Ziele der Forschung
Die Studie von Grassinger und Schnebel (2024) untersucht den Einfluss von Online-Self-Assessments (OSA) auf die Selbstreflexion von Studierenden im Rahmen ihres Lehramtspraktikums. Das Hauptziel der Forschung ist es, zu verstehen, wie OSA die Selbstreflexionserkenntnis der Studierenden beeinflusst und wie diese Erkenntnisse mit ihren motivationalen Zielen sowie der erlebten Erwartungsdiskrepanz und Verunsicherung hinsichtlich der Studienwahl zusammenhängen.
2. Methoden und Datenquellen
Methoden:


Die Studie verwendet ein quantitatives Design mit einer Stichprobe von 299 Lehramtsstudierenden, die ein Online-Self-Assessment nach Abschluss ihres ersten Praktikums durchführten.


Die Studierenden wurden entweder einer Gruppe zugeteilt, die nur die Fragen des OSA beantwortete (kriteriale Bezugsnorm), oder einer Gruppe, die zusätzlich Feedback erhielt (soziale Bezugsnorm).


Die Selbstreflexionserkenntnis, Lernziele, Arbeitsvermeidungsziele sowie das Erleben motivationaler Erwartungsdiskrepanz und die Verunsicherung hinsichtlich der Studienwahl wurden mithilfe von standardisierten Skalen gemessen.


Datenquellen:


Die Daten stammen aus den Antworten der Studierenden auf das OSA und die dazugehörigen Fragebögen, die direkt nach Abschluss des Praktikums und des OSA erhoben wurden.


3. Zentrale Forschungsergebnisse


Selbstreflexionserkenntnis:


Studierende, die hohe Lernziele verfolgten, zeigten eine ausgeprägtere Selbstreflexionserkenntnis nach dem OSA. Arbeitsvermeidungsziele hatten hingegen keinen signifikanten Einfluss auf die Selbstreflexionserkenntnis.




Motivationale Erwartungsdiskrepanz:


Die Studie fand heraus, dass eine erhöhte Selbstreflexionserkenntnis durch das OSA mit einer positiven motivationalen Erwartungsdiskrepanz (d.h. übertroffene Erwartungen) einhergeht. Es zeigte sich jedoch kein signifikanter Zusammenhang zwischen der Selbstreflexionserkenntnis und einer Verunsicherung ob der Studienwahl.




Feedback versus keine Rückmeldung:


Es gab keinen signifikanten Unterschied in der Selbstreflexionserkenntnis zwischen Studierenden, die nur die Fragen beantworteten, und denen, die zusätzlich Feedback erhielten.




4. Zusammenfassung
Die Studie untersucht den Einfluss von Online-Self-Assessments auf die Selbstreflexion von Lehramtsstudierenden nach ihrem Praktikum. Die Ergebnisse zeigen, dass hohe Lernziele mit einer stärkeren Selbstreflexionserkenntnis verbunden sind, während Arbeitsvermeidungsziele keinen signifikanten Einfluss haben. Das Erleben einer positiven motivationalen Erwartungsdiskrepanz korreliert mit einer erhöhten Selbstreflexionserkenntnis, jedoch nicht mit einer Verunsicherung hinsichtlich der Studienwahl.
5. Kernaussagen


Lernziele und Selbstreflexion: Studierende mit ausgeprägten Lernzielen berichten eine stärkere Selbstreflexionserkenntnis nach dem OSA. (S. 8)


Motivationale Erwartungsdiskrepanz: Eine positive motivationalen Erwartungsdiskrepanz korreliert mit einer erhöhten Selbstreflexionserkenntnis. (S. 9)


Feedback ohne Mehrwert: Es besteht kein signifikanter Unterschied in der Selbstreflexionserkenntnis zwischen den Gruppen mit und ohne Feedback. (S. 10)


6. Argumentationslinien
Die Autoren argumentieren, dass OSAs ein nützliches Instrument zur Förderung der Selbstreflexion in der Lehramtsausbildung sein können, insbesondere für Studierende mit hohen Lernzielen. Sie zeigen auf, dass das Erleben von positiven motivationalen Erwartungsdiskrepanzen durch OSAs verstärkt werden kann, jedoch keine signifikante Auswirkung auf die Unsicherheit hinsichtlich der Studienwahl hat. (S. 10-11)
7. Verschlagwortung


Lehr- und Lerneffektivität: Die Studie untersucht die Effektivität von OSAs zur Förderung der Selbstreflexion und Lernzielorientierung.


Bewertungsmethoden: Die Rolle von OSAs als formative Assessment-Tools wird analysiert.


Systemanpassung: Anpassung des OSA zur Unterstützung der Selbstregulation und Reflexion in der Lehramtsausbildung.


8. Kategorisierung
Argumentation: Die Studie argumentiert überzeugend, dass Online-Self-Assessments die Selbstreflexion von Studierenden fördern können, insbesondere durch die Verstärkung positiver motivationaler Erwartungsdiskrepanzen, ohne jedoch signifikante Auswirkungen auf die Unsicherheit hinsichtlich der Studienwahl zu haben. (S. 11)
9. Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU5: Welche Möglichkeiten und Grenzen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems durch Akteure im digitalen Bildungsraum von Gesundheitsberufen analysiert?


Begründung: Die Untersuchung bietet wertvolle Erkenntnisse darüber, wie Selbstreflexion und motivationale Diskrepanzen durch digitale Self-Assessment-Tools beeinflusst werden können, was für die Analyse von LMS in der digitalen Bildung relevant ist.


10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie liefert wichtige Erkenntnisse über den Einfluss von Self-Assessments auf die Selbstreflexion und motivationale Diskrepanzen).


Zitierhäufigkeit und Einfluss: 4 (Die Studie ist relevant für die Bildungsforschung, insbesondere in der Lehramtsausbildung).


Aktualität: 5 (Veröffentlichung im Jahr 2024, daher sehr aktuell).


Gesamtbewertung: 4.7
11. Schlussfolgerung
Die Studie von Grassinger und Schnebel (2024) zeigt, dass Online-Self-Assessments eine effektive Methode sein können, um die Selbstreflexion und das Lernen von Lehramtsstudierenden zu fördern. Die Ergebnisse legen nahe, dass solche Assessment-Tools insbesondere für Studierende mit hohen Lernzielen nützlich sind, wobei Feedback allein nicht notwendigerweise die Reflexion verbessert.
},
	file = {Grassinger und Schnebel - 2024 - Durch ein Online-Self-Assessment angeregte Selbstr.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/XUAWZSXF/Grassinger und Schnebel - 2024 - Durch ein Online-Self-Assessment angeregte Selbstr.pdf:application/pdf},
}

@incollection{isaias_predicting_2024,
	address = {Cham},
	title = {Predicting the {Academic} {Performance} of {Programming} {Students} {Using} {Logs} from an {Online} {Learning} {System}: {Toward} {Providing} {Timely} {Guidance} and {Feedback} to {Students}},
	isbn = {978-3-031-66461-8 978-3-031-66462-5},
	shorttitle = {Predicting the {Academic} {Performance} of {Programming} {Students} {Using} {Logs} from an {Online} {Learning} {System}},
	url = {https://link.springer.com/10.1007/978-3-031-66462-5_8},
	doi = {10.1007/978-3-031-66462-5_8},
	abstract = {In this study, we developed a programming learning system that presents instructors with the trends of an entire class and the coding status of individual students in programming practice classes. A survey filled by faculty members confirmed that the “understand students’ coding status” objective was sufficiently satisfied, and that the system helped faculty members provide appropriate guidance and timely advice to students. In addition, we created and evaluated a multiple regression analysis model using the operation logs from the programming exercise system for predictions and effective feedback provision to students. With the model, we could predict final exam scores using system operation logs from the early-­ stages of the course. Additionally, we could update the score predictions based on each week’s class logs and provide feedback to students. This predictive model has implications for educational practice and allows for timely interventions for learner success. Furthermore, we confirmed the model’s good performance by comparing the scores predicted using past data with the actual scores. The study is particularly strong in identifying key variables and presenting detailed statistical analyses. This makes its conclusions both valuable and actionable for educators. We believe that this system be instrumental in improving the performance of students in programming classes.},
	language = {en-GB},
	urldate = {2024-08-17},
	booktitle = {Artificial {Intelligence} for {Supporting} {Human} {Cognition} and {Exploratory} {Learning} in the {Digital} {Age}},
	publisher = {Springer Nature Switzerland},
	author = {Tanaka, Tetsuo and Ueda, Mari},
	editor = {Isaias, Pedro and Sampson, Demetrios G. and Ifenthaler, Dirk},
	year = {2024},
	note = {Series Title: Cognition and Exploratory Learning in the Digital Age},
	keywords = {Promotion:Literaturanalyse, \#b:Buchteil:online:learning, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {139--157},
	file = {Tanaka und Ueda - 2024 - Predicting the Academic Performance of Programming.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/6UA5W9E8/Tanaka und Ueda - 2024 - Predicting the Academic Performance of Programming.pdf:application/pdf},
}

@article{weinhandl_employing_2024,
	title = {Employing a multi-layered approach for validating mathematics student personas in technology-enhanced learning environments},
	volume = {11},
	issn = {2331-186X},
	url = {https://www.tandfonline.com/doi/full/10.1080/2331186X.2024.2389361},
	doi = {10.1080/2331186X.2024.2389361},
	abstract = {One goal of mathematics education is to adapt features of digital learning materials to students’ characteristics. This paper presents a multi-layered research approach to identify key aspects of mathematics students within the persona approach. Data for this research was collected from 5,624 mathematics students using an instrument focusing on 15 scales addressing psychological constructs. The data was analysed using factor analysis. The results of our study show that mathematical self-confidence, aspiration towards mathematics, performance orientation, intra- and interpersonal aspects of learning mathematics, and actions and reactions are the most pronounced persona dimensions of mathematics students. The dimensions of student personas identified in this research – specifically aspiration towards mathematics, and intra- and interpersonal aspects of learning mathematics – are the most critical novelty brought by this study.},
	language = {en-GB},
	number = {1},
	urldate = {2024-08-17},
	journal = {Cogent Education},
	author = {Weinhandl, Robert and Mayerhofer, Martin and Große, Cornelia S. and Anđić, Branko},
	month = dec,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Systemanpassung, Promotion:FU4b, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {2389361},
	annote = {Analyse der Studie "Employing a multi-layered approach for validating mathematics student personas in technology-enhanced learning environments" von Weinhandl et al. (2024)
1. Hauptthemen und Ziele der Forschung
Die Studie von Weinhandl et al. (2024) untersucht die Entwicklung und Validierung von Personas für Mathematikschüler in technologieunterstützten Lernumgebungen. Ziel der Forschung ist es, durch einen mehrschichtigen Ansatz die wesentlichen Dimensionen und Charakteristika von Mathematikschülern zu identifizieren, um die Entwicklung digitaler Lernressourcen besser an die Bedürfnisse dieser Schüler anzupassen.
2. Methoden und Datenquellen
Methoden:


Die Studie verwendet einen mehrschichtigen Forschungsansatz, der sowohl qualitative als auch quantitative Methoden umfasst. In der ersten Phase wurden qualitative Daten von Mathematiklehrern gesammelt und analysiert, um vorläufige Personas zu entwickeln. Diese wurden in einer zweiten Phase qualitativ validiert und in einer dritten Phase quantitativ getestet.


In der vierten Phase führte das Team eine umfangreiche, landesweite quantitative Studie durch, bei der Daten von 5.624 Mathematikschülern in Österreich gesammelt wurden. Diese Daten wurden mittels Faktorenanalyse analysiert, um die zentralen Dimensionen der Schüler-Personas zu identifizieren.


Datenquellen:


Die Daten stammen von 5.624 Schülerinnen und Schülern aus 141 Schulen in Österreich, die an einer Fragebogenstudie teilnahmen. Diese Umfrage umfasste 15 Skalen, die verschiedene psychologische Konstrukte abdecken, die für das Lernen von Mathematik relevant sind.


3. Zentrale Forschungsergebnisse


Dimensionen der Mathematikschüler-Personas:


Die Studie identifiziert fünf zentrale Dimensionen, die die Charakteristika von Mathematikschülern beschreiben: mathematisches Selbstvertrauen, Streben nach Mathematik, Leistungsorientierung, intra- und interpersonelle Aspekte des Mathematiklernens sowie Handlungen und Reaktionen.




Mathematisches Selbstvertrauen:


Diese Dimension umfasst das Selbstkonzept in Bezug auf Mathematik, die Selbstwirksamkeit und die Prüfungsangst. Ein hohes mathematisches Selbstvertrauen korreliert mit einer positiven Einstellung zu mathematischen Fähigkeiten und einer geringen Prüfungsangst.




Streben nach Mathematik:


Diese Dimension umfasst das Interesse an Mathematik, die Bedeutung von Mathematik für die Zukunft sowie die Tendenz, schwierige Aufgaben zu vermeiden.




Leistungsorientierung:


Diese Dimension betont das Bestreben, gute Noten zu erreichen und sich mit anderen zu vergleichen.




Intra- und interpersonelle Aspekte:


Diese Dimension beinhaltet die Autonomie beim Lernen sowie die soziale Verbundenheit beim Lernen von Mathematik.




Handlungen und Reaktionen:


Diese Dimension bezieht sich auf die aktive Teilnahme am Unterricht und die emotionalen Reaktionen auf Fehler.




4. Zusammenfassung
Die Studie untersucht die Entwicklung und Validierung von Personas für Mathematikschüler in technologieunterstützten Lernumgebungen. Die Ergebnisse zeigen, dass fünf zentrale Dimensionen für die Charakterisierung von Mathematikschülern relevant sind, die als Grundlage für die Entwicklung von Lernressourcen und Technologien dienen können.
5. Kernaussagen


Mathematisches Selbstvertrauen: Hohe mathematische Selbstsicherheit korreliert stark mit positiven Einstellungen und geringer Prüfungsangst. (S. 11)


Streben nach Mathematik: Diese Dimension umfasst das Interesse an Mathematik und die Bedeutung, die Schüler der Mathematik für ihre Zukunft beimessen. (S. 12)


Leistungsorientierung: Schüler, die sich stark auf Leistung konzentrieren, vergleichen sich häufiger mit anderen und streben nach hohen Noten. (S. 13)


6. Argumentationslinien
Die Autoren argumentieren, dass die Entwicklung von Personas auf der Basis dieser fünf Dimensionen entscheidend dazu beitragen kann, digitale Lernressourcen besser auf die Bedürfnisse von Mathematikschülern abzustimmen. Durch das Verständnis dieser Dimensionen können Entwickler und Pädagogen gezieltere und effektivere Lernmaterialien erstellen. (S. 14)
7. Verschlagwortung


Technologieintegration: Die Studie analysiert, wie Technologie in das Mathematiklernen integriert wird und wie diese Integration durch die Charakteristika der Schüler beeinflusst wird.


Lehr- und Lerneffektivität: Die Untersuchung der Effektivität von technologieunterstützten Lernumgebungen im Hinblick auf die spezifischen Bedürfnisse und Merkmale von Mathematikschülern.


Systemanpassung: Die Studie zeigt auf, wie Lernsysteme an die unterschiedlichen Bedürfnisse der Schüler angepasst werden können.


8. Kategorisierung
Kerngedanke: Die Studie identifiziert und beschreibt die wesentlichen Dimensionen, die Mathematikschüler in technologieunterstützten Lernumgebungen charakterisieren, und betont deren Bedeutung für die Entwicklung gezielter digitaler Lernressourcen. (S. 15)
9. Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU4b: Welche technisch-gestalterischen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?


Begründung: Die Studie untersucht, wie technologische und didaktische Mechanismen gezielt auf die Bedürfnisse von Lernenden abgestimmt werden können, was für die Anpassung von Lernmanagementsystemen relevant ist.


10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie liefert grundlegende Erkenntnisse über die Anpassung von Lernressourcen an die Bedürfnisse spezifischer Lerngruppen).


Zitierhäufigkeit und Einfluss: 4 (Die Studie ist aktuell und behandelt ein bedeutendes Thema in der Bildungsforschung).


Aktualität: 5 (Veröffentlichung im Jahr 2024, daher sehr aktuell).


Gesamtbewertung: 4.7
11. Schlussfolgerung
Die Studie von Weinhandl et al. (2024) zeigt, dass die Identifizierung und Berücksichtigung der spezifischen Bedürfnisse von Mathematikschülern durch die Entwicklung von Personas entscheidend für die Erstellung effektiver technologieunterstützter Lernumgebungen ist. Diese Erkenntnisse können dazu beitragen, die Qualität und Wirksamkeit von digitalen Bildungsressourcen zu verbessern.
},
	file = {Weinhandl et al. - 2024 - Employing a multi-layered approach for validating .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/LANSL4VA/Weinhandl et al. - 2024 - Employing a multi-layered approach for validating .pdf:application/pdf},
}

@article{sedawi_toward_2024,
	title = {Toward epistemic justice in socio-scientific decision-making: {How} youth make sense of lively {COVID}-19 and vaccines data},
	issn = {1050-8406, 1532-7809},
	shorttitle = {Toward epistemic justice in socio-scientific decision-making},
	url = {https://www.tandfonline.com/doi/full/10.1080/10508406.2024.2381205},
	doi = {10.1080/10508406.2024.2381205},
	abstract = {Background: Studies of socio-scientific decisionmaking in times of crisis are in their infancy. This study investigates how minoritized youth engage and make sense of newly developed COVID-19 vac­ cines and their intersections with the evolving multipandemic. Guided by theories of lively data, data sense and epistemic injustice, we center the experi­ ence of four Palestinian Arab minority youth in Israel context throughout the ongoing pandemic.},
	language = {en-GB},
	urldate = {2024-08-17},
	journal = {Journal of the Learning Sciences},
	author = {Sedawi, Wisam and Calabrese Barton, Angela},
	month = aug,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Systemanpassung, Bildungstheorien, Promotion:Argumentation, Promotion:Relevanz:4, Promotion:FU5, Krisenreaktion im Bildungsbereich, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {1--52},
	annote = {Analyse der Studie "Toward epistemic justice in socio-scientific decision-making: How youth make sense of lively COVID-19 and vaccines data" von Sedawi \& Calabrese Barton (2024)
1. Hauptthemen und Ziele der Forschung
Die Studie von Sedawi \& Calabrese Barton (2024) untersucht, wie Jugendliche aus marginalisierten Gemeinschaften in Israel, insbesondere palästinensische arabische Jugendliche, während der COVID-19-Pandemie mit Daten umgehen und Entscheidungen treffen. Ziel ist es, die Rolle von "lively data" und die damit verbundenen Herausforderungen der epistemischen Gerechtigkeit im Kontext soziowissenschaftlicher Entscheidungen zu beleuchten.
2. Methoden und Datenquellen
Methoden:


Die Studie verwendet eine kritische Grounded-Theory-Methodologie, um die Erfahrungen der Jugendlichen zu analysieren. Dies erfolgt durch längere Interviews und Erfahrungsproben.


Gegen-Narrative werden genutzt, um die Stimmen und Erfahrungen der Jugendlichen zu dokumentieren und marginalisiertes Wissen in den Vordergrund zu rücken.


Datenquellen:


Die Daten stammen aus Langzeitinterviews und Erfahrungsproben mit vier palästinensisch-arabischen Jugendlichen in Israel während der Pandemie. Diese qualitativen Daten werden genutzt, um die komplexen Wechselwirkungen zwischen den Erfahrungen der Jugendlichen und den pandemiebezogenen Daten zu verstehen.


3. Zentrale Forschungsergebnisse


Verständnis der Pandemie:


Die Jugendlichen entwickelten ein tiefes Verständnis der multidimensionalen Natur der Krise durch ihre Interaktionen mit COVID-19-Daten. Ihre Entscheidungen und ihr Wissen änderten sich im Laufe der Pandemie, reflektierend die sich ändernde Wahrnehmung von Gesundheitsgefahren, Impfstoffwirksamkeit sowie die politischen und wissenschaftlichen Narrative.




Epistemische Gerechtigkeit:


Die Studie zeigt, wie das Wissen und die Erfahrungen der Jugendlichen oft marginalisiert wurden. Die Jugendlichen nutzten jedoch ihre Agentenpositionen, um ihre Daten in die Diskussion einzubringen und zur epistemischen Gerechtigkeit beizutragen.




Lively Data und Entscheidungsfindung:


Die Interaktionen der Jugendlichen mit "lively data" zeigen, wie Daten in realen Kontexten dynamisch und emotional aufgeladen sind. Diese lebendigen Daten beeinflussten ihre Entscheidungen und ihre Fähigkeit, wissenschaftliche, soziale und politische Daten kritisch zu hinterfragen und zu nutzen.




4. Zusammenfassung
Die Studie untersucht, wie marginalisierte Jugendliche während der COVID-19-Pandemie mit Daten umgehen und Entscheidungen treffen. Sie zeigt, dass "lively data" eine entscheidende Rolle bei der Entscheidungsfindung spielt und dass epistemische Gerechtigkeit erreicht werden kann, wenn die Erfahrungen und das Wissen dieser Jugendlichen in den Diskurs integriert werden.
5. Kernaussagen


Verständnis der Pandemie: Jugendliche entwickelten ein mehrdimensionales Verständnis der Krise durch ihre sinnlichen und emotionalen Interaktionen mit COVID-19-Daten. (S. 11)


Epistemische Gerechtigkeit: Die Studie beleuchtet die Wichtigkeit, marginalisiertes Wissen und Erfahrungen in wissenschaftliche und politische Diskurse zu integrieren. (S. 14)


Lively Data: "Lively data" beeinflusst die Entscheidungsprozesse der Jugendlichen und hilft ihnen, kritische Fragen über ihre Lebensrealitäten zu stellen. (S. 17)


6. Argumentationslinien
Die Autoren argumentieren, dass das Einbeziehen der Erfahrungen von Jugendlichen aus marginalisierten Gemeinschaften in die wissenschaftliche und politische Diskussion ein wichtiger Schritt zur Erreichung epistemischer Gerechtigkeit ist. Dies kann dazu beitragen, dass wissenschaftliche und politische Entscheidungen relevanter und gerechter für alle Teile der Gesellschaft werden. (S. 19)
7. Verschlagwortung


Bildungstheorien: Die Studie untersucht, wie epistemische Gerechtigkeit als theoretischer Rahmen genutzt wird, um das Verständnis und die Entscheidungen von Jugendlichen zu analysieren.


Systemanpassung: Die Forschung zeigt, wie Bildungs- und Entscheidungssysteme angepasst werden müssen, um die Stimmen marginalisierter Gruppen zu integrieren.


Krisenreaktion im Bildungsbereich: Die Untersuchung beleuchtet, wie Bildungssysteme in Krisenzeiten angepasst werden, um epistemische Gerechtigkeit zu fördern.


8. Kategorisierung
Argumentation: Die Studie untermauert argumentativ die Notwendigkeit, epistemische Gerechtigkeit durch die Integration von marginalisierten Erfahrungen in den wissenschaftlichen und politischen Diskurs zu erreichen, um gerechtere Entscheidungen zu treffen. (S. 20)
9. Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU5: Welche Möglichkeiten und Grenzen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems durch Akteure im digitalen Bildungsraum von Gesundheitsberufen analysiert?


Begründung: Die Studie liefert wertvolle Erkenntnisse darüber, wie marginalisierte Gruppen und deren Erfahrungen in Entscheidungsprozesse eingebunden werden können, was für die Analyse von Möglichkeiten und Grenzen in digitalen Bildungssystemen relevant ist.


10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie bietet tiefe Einblicke in die Rolle von Daten und epistemischer Gerechtigkeit in Entscheidungskontexten).


Zitierhäufigkeit und Einfluss: 4 (Die Studie ist neu und behandelt ein innovatives Thema).


Aktualität: 5 (Veröffentlichung im Jahr 2024, daher sehr aktuell).


Gesamtbewertung: 4.7
11. Schlussfolgerung
Die Studie von Sedawi \& Calabrese Barton (2024) verdeutlicht die Bedeutung von "lively data" und epistemischer Gerechtigkeit bei der Entscheidungsfindung in Krisenzeiten. Durch die Einbeziehung der Erfahrungen und des Wissens von Jugendlichen aus marginalisierten Gemeinschaften trägt die Forschung dazu bei, gerechtere und relevantere wissenschaftliche und politische Entscheidungen zu treffen.
},
	file = {Sedawi und Calabrese Barton - 2024 - Toward epistemic justice in socio-scientific decis.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/SJ2WLEUE/Sedawi und Calabrese Barton - 2024 - Toward epistemic justice in socio-scientific decis.pdf:application/pdf},
}

@article{moore_using_2023,
	title = {Using a {Telehealth} {Simulation} to {Prepare} {Nursing} {Students} for {Intraprofessional} {Collaboration}},
	volume = {78},
	issn = {18761399},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1876139923000130},
	doi = {10.1016/j.ecns.2023.02.007},
	abstract = {Background: This pilot study measured the effect of a telehealth simulation-based learning experience on undergraduate (BSN) and graduate (NP) nursing students’ readiness for intraprofessional collaboration. Facilitators organized a sample of 66 on-campus BSN and eight online NP students into groups of 1NP student : 6-9 BSN students.
Method: During the simulation, the “school nurse” (BSN student) collaborated with a telehealth provider (NP student) to provide patient care. The Teamwork and Collaboration Subscale (TCS) of the Readiness for Interprofessional Learning Scale (RIPLS) measured the students’ intraprofessional collaboration. Results were analyzed using descriptive and inferential strategies. Responses to an open-ended question were content analyzed.
Results: TCS scores increased from pre- to post-simulation suggesting the simulation increased learner’s readiness for intraprofessional collaboration. Students expressed enthusiastic appreciation for the simulation experience and the importance of developing intraprofessional collaboration skills.
Conclusion: Study findings support the use of telehealth simulations to develop nursing students’ intraprofessional collaboration skills.},
	language = {en-GB},
	urldate = {2024-08-17},
	journal = {Clinical Simulation in Nursing},
	author = {Moore, Jeanne and Jairath, Nalini and Montejo, Leigh and O'Brien, Sandra and Want, David},
	month = may,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Kollaboratives Lernen, Promotion:FU4a, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Telemedizin, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {1--6},
	annote = {Analyse der Studie "Using a Telehealth Simulation to Prepare Nursing Students for Intraprofessional Collaboration" von Moore et al. (2023)
1. Hauptthemen und Ziele der Forschung
Die Studie von Moore et al. (2023) untersucht die Wirksamkeit einer Telehealth-Simulation, die entwickelt wurde, um die intraprofessionelle Zusammenarbeit zwischen Bachelor- (BSN) und Master- (NP) Pflege-Studierenden zu fördern. Ziel der Studie ist es, herauszufinden, ob die Simulation das kollaborative Arbeiten in der virtuellen Patientenversorgung verbessern kann, indem sie die Bereitschaft und Fähigkeiten der Studierenden zur intraprofessionellen Zusammenarbeit erhöht.
2. Methoden und Datenquellen
Methoden:


Die Studie verwendet ein Simulationsbasiertes Lernereignis (SBLE), bei dem BSN- und NP-Studierende gemeinsam in einem simulierten Telehealth-Szenario zusammenarbeiten.


Die Teamwork and Collaboration Subscale (TCS) der Readiness for Interprofessional Learning Scale (RIPLS) wurde verwendet, um die Bereitschaft der Studierenden zur intraprofessionellen Zusammenarbeit vor und nach der Simulation zu messen.


Zusätzlich wurden qualitative Daten durch offene Fragen erhoben, um die subjektiven Erfahrungen der Studierenden während der Simulation zu erfassen.


Datenquellen:


Die Stichprobe umfasste 66 BSN- und 8 NP-Studierende, die an einer Simulationsveranstaltung teilnahmen. Die Daten wurden durch prä- und post-simulative Erhebungen mittels der TCS sowie durch qualitative Inhaltsanalysen der offenen Antworten gesammelt.


3. Zentrale Forschungsergebnisse


Erhöhung der Kollaborationsbereitschaft:


Die Ergebnisse zeigen, dass die TCS-Werte sowohl bei BSN- als auch bei NP-Studierenden nach der Simulation anstiegen, was auf eine gesteigerte Bereitschaft zur Zusammenarbeit hinweist. Allerdings waren diese Unterschiede statistisch nicht signifikant.




Positive Wahrnehmung der Simulation:


Qualitative Rückmeldungen der Studierenden betonten die Nützlichkeit und den Realismus der Simulation. Die Studierenden hoben die Bedeutung der interprofessionellen Kommunikation und Zusammenarbeit hervor.




Herausforderungen der Telehealth-Nutzung:


Die Simulation verdeutlichte die Wichtigkeit technischer Kompetenzen und die Notwendigkeit einer klaren Kommunikation, um effektiv in einem Telehealth-Setting zusammenarbeiten zu können.




4. Zusammenfassung
Die Studie untersucht die Auswirkungen einer Telehealth-Simulation auf die intraprofessionelle Zusammenarbeit von Pflege-Studierenden. Die Ergebnisse zeigen, dass die Simulation das Bewusstsein und die Bereitschaft zur Zusammenarbeit stärkt, auch wenn die quantitativen Verbesserungen nicht signifikant waren. Qualitative Daten unterstreichen die positiven Erfahrungen der Studierenden mit dem Simulationsszenario.
5. Kernaussagen


Steigerung der Kollaborationsbereitschaft: Die Teilnahme an der Simulation führte zu einer erhöhten Bereitschaft zur intraprofessionellen Zusammenarbeit, auch wenn die quantitativen Verbesserungen nicht signifikant waren. (S. 4)


Positive Lernerfahrung: Die Studierenden beschrieben die Simulation als realistisch und hilfreich für das Verständnis der Rolle von Telehealth in der Patientenversorgung. (S. 5)


Wichtigkeit technischer Fähigkeiten: Technische Kompetenzen sind entscheidend für die erfolgreiche Durchführung von Telehealth-Simulationen und sollten in die Ausbildung integriert werden. (S. 5)


6. Argumentationslinien
Die Autoren argumentieren, dass Telehealth-Simulationen ein wertvolles Werkzeug zur Förderung der intraprofessionellen Zusammenarbeit in der Pflegeausbildung sein können. Sie betonen, dass diese Art von Simulationen nicht nur die technischen Fähigkeiten der Studierenden verbessert, sondern auch das Verständnis und die Umsetzung von Teamarbeit in virtuellen Pflegeumgebungen fördert. (S. 6)
7. Verschlagwortung


Technologieintegration: Die Studie untersucht die Integration von Telehealth-Technologien in die Pflegeausbildung und deren Einfluss auf die Zusammenarbeit.


Lehr- und Lerneffektivität: Die Forschung zeigt, wie Simulationen die Lernprozesse in der Pflegeausbildung verbessern können.


Kollaboratives Lernen: Die Studie beleuchtet die Förderung von Teamarbeit und interprofessioneller Zusammenarbeit durch simulationsbasiertes Lernen.


8. Kategorisierung
Kerngedanke: Die Studie zeigt, dass Telehealth-Simulationen dazu beitragen können, die kollaborativen Fähigkeiten von Pflege-Studierenden zu verbessern, indem sie praxisnahe und technologiegestützte Lernumgebungen schaffen. (S. 6)
9. Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU4a: Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?


Begründung: Die Studie untersucht die Auswirkungen einer technologiebasierten Lernumgebung auf die Zusammenarbeit von Studierenden, was relevante Einblicke für ähnliche Anwendungen in LMS bietet.


10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie liefert wichtige Erkenntnisse zur Anwendung von Simulationen zur Förderung der Zusammenarbeit in der Pflegeausbildung).


Zitierhäufigkeit und Einfluss: 4 (Die Studie ist neu und bietet wertvolle Einblicke für zukünftige Forschungen).


Aktualität: 5 (Veröffentlichung im Jahr 2023, daher sehr aktuell).


Gesamtbewertung: 4.7
11. Schlussfolgerung
Die Studie von Moore et al. (2023) zeigt, dass Telehealth-Simulationen ein vielversprechender Ansatz sind, um die intraprofessionelle Zusammenarbeit in der Pflegeausbildung zu fördern. Die Ergebnisse legen nahe, dass solche Simulationen in die Lehrpläne integriert werden sollten, um die technischen und kollaborativen Fähigkeiten von Pflege-Studierenden zu stärken.
},
	file = {Moore et al. - 2023 - Using a Telehealth Simulation to Prepare Nursing S.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/RLWSKAUV/Moore et al. - 2023 - Using a Telehealth Simulation to Prepare Nursing S.pdf:application/pdf},
}

