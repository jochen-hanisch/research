	keywords = {Promotion:01-02, Promotion:01-02 Methodenquellen, Promotion:Literaturverzeichnis},
	pages = {1--17},
	file = {Polakovská und Řiháček - 2021 - What is it like to live with medically unexplained.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/JE4IPD9V/Polakovská und Řiháček - 2021 - What is it like to live with medically unexplained.pdf:application/pdf},
}

@article{masood_haidari_meta-summary_2023,
	title = {A {Meta}-{Summary} {Study} of {Qualitative} {Research} on {Good} {Teacher} {Characteristics}},
	volume = {CİLT 3 SAYI 1},
	issn = {2791-8351},
	url = {https://iedres.com/?mod=tammetin&makaleadi=&key=64795},
	doi = {10/gs28rp},
	abstract = {This study synthesizes the primary qualitative research findings on the views of students, teachers, school administrators, and parents about the characteristics of a good or effective teacher in the Turkish context. Therefore, a meta-summary method of qualitative research synthesis was employed to aggregate knowledge from the primary qualitative studies published in peer-reviewed journals between 2000 and 2022 in Turkey. Thirty-one research reports meeting the inclusion criteria were included in the analysis. All these reports were assessed based on a set of quality assessment criteria for qualitative studies. Then, the qualitative findings were extracted from the primary research reports, edited, grouped, and abstracted, and the frequency effect sizes were computed for each conceptualized statement of findings. The analyses yielded 42 abstracted statements regarding good teacher characteristics with frequency effect sizes of 19.4–80\% clustered under three dimensions, namely personal characteristics, professional characteristics, and characteristics related to teacher-student relationships. The personal characteristics underlined the key personality traits of teachers and their skills. Their professional characteristics were addressed under professional attitudes and professional skills. The findings also highlighted practical measures or characteristics to consider for healthy teacher-student relationships. The study concludes by discussing major findings, limitations, and implications for education and future research.},
	language = {en-GB},
	number = {CİLT 3 SAYI 1},
	urldate = {2023-10-30},
	journal = {Uluslararası İnovatif Eğitim Araştırmacısı},
	author = {Masood Haidari, Sayed and Koçoğlu, Ayhan},
	year = {2023},
	keywords = {Promotion:01-02, Promotion:01-02 Methodenquellen, Promotion:Literaturverzeichnis},
	pages = {1--14},
	file = {Masood Haidari und Koçoğlu - 2023 - A Meta-Summary Study of Qualitative Research on Go.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/XMHTUVXE/Masood Haidari und Koçoğlu - 2023 - A Meta-Summary Study of Qualitative Research on Go.pdf:application/pdf},
