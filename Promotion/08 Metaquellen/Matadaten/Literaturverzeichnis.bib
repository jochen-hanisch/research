	note = {ZSCC: 0000001},
	keywords = {Charité:Promotion, Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Bildungstheorien, Promotion:Weiterführung, Promotion:FU3, \#9:Zeitschriftenartikel:digital:lernen, Promotion:S:09 Digital Lernen, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {647--674},
