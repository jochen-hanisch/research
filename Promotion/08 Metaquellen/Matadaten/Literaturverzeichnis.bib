},
	file = {Pratiwi et al. - 2024 - Hasil Belajar Kognitif Materi Geografi Kelas X Men.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/H2LZE9D4/Pratiwi et al. - 2024 - Hasil Belajar Kognitif Materi Geografi Kelas X Men.pdf:application/pdf},
