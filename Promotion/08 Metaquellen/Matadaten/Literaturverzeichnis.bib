	title = {Blended {Learning} {Mobility}: {Konzepte}, {Erfahrungen}, {Perspektiven} aus dem {Projekt} „{Digital} and {International} {Virtual} {Academic} {Cooperation}“ ({DIVA})},
	volume = {22},
