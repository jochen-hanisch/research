  keywords = {5:Zeitschriftenartikel:e-learning,Charité:Promotion,Forschungsansätze,Kollaboratives Lernen,Lehr- und Lerneffektivität,Lernsystemarchitektur,Promotion:FU3,Promotion:Kerngedanke,Promotion:Literaturanalyse,Promotion:Relevanz:5,Promotion:S:05 E-Learning,Systemanpassung,Technologieintegration},
