@article{douma_e-learning_2017,
	title = {An {E}-{Learning} {Module} to {Improve} {Nongenetic} {Health} {Professionals}? {Assessment} of {Colorectal} {Cancer} {Genetic} {Risk}: {Feasibility} {Study}},
