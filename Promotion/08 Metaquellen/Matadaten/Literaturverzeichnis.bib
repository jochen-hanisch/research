  title = {Bildung in der digitalen Welt: Über Wirkungsannahmen und die soziale Konstruktion des Digitalen},
  shorttitle = {Bildung in der digitalen Welt},
  author = {Kerres, Michael},
  date = {2020-04-24},
  journaltitle = {MedienPädagogik: Zeitschrift für Theorie und Praxis der Medienbildung},
