	shorttitle = {Game-{Based} {Learning} {Analytics}},
	url = {https://link.springer.com/10.1007/978-3-031-74138-8_9},
	doi = {10.1007/978-3-031-74138-8_9},
	abstract = {Game-Based Learning Analytics (GBLA) is a method of integrating Game-Based Learning and Learning Analytics to enhance the eﬀectiveness of the learning process in educational games by providing actionable learning analytics information to players within the game environment. This paper presents initial insights from an integrated design process to achieve this goal. Through a series of interdisciplinary workshops culminating in a participant playtest session, this paper highlights the challenges and opportunities that arise from this integration. The ﬁndings point to the importance of early consideration of learning analytics in game design, the challenges of conceptualizing the diﬀerences between game feedback and learning feedback, and how learners interpret learning feedback within the context of the game. This work lays the groundwork for future research and development in the interaction between Game-Based Learning and Learning Analytics.},
