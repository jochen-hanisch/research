@incollection{grunder2024Dtm,
  title = {Digitale Transformation = mehr Nachhaltigkeit in der Logistik?: Die digitale Transformation in der Schweizer Logistikbranche und ihre Auswirkungen auf die Nachhaltigkeit},
  shorttitle = {Digitale Transformation = mehr Nachhaltigkeit in der Logistik?},
  booktitle = {Transformationen gestalten},
  author = {Grunder, Nils Lorenz and Pešková, Marie and Gees, Thomas},
  editor = {Tokarski, Kim Oliver and Endrissat, Nada and Kissling-Näf, Ingrid},
  date = {2024},
