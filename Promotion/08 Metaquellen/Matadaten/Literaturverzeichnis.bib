@article{claflin_building_2020,
	title = {Building a {Successful} {Massive} {Open} {Online} {Course} {About} {Multiple} {Sclerosis}: {A} {Process} {Description}},
	volume = {22},
	url = {https://www.jmir.org/2020/7/e16687},
	doi = {10.2196/16687},
	abstract = {Background: Over the course of a year, we developed and tested a 6-week massive open online course (MOOC) on multiple sclerosis (MS) in consultation with the MS community. The course targeted the MS community and interested laypeople and was titled Understanding MS. The primary purpose of the course was to improve MS knowledge, health literacy, and resilience among participants. The final version of the MOOC made available for open enrollment was ranked first among all MOOCs released in 2019 (n{\textgreater}2400) based on participant reviews. Objective: The aim of this study was to present a detailed description and assessment of the development process of the Understanding MS MOOC. Methods: The development process included a course development focus group; the creation of more than 50 content videos and related text, quizzes, activities, and discussion prompts; the creation of original images and animations; a pilot study; and collaborations with people living with MS, MS nurses, allied health care practitioners, and neurologists and researchers from 4 universities. Results: Overall, the process was efficient and effective. With a few small changes, we recommend this approach to those seeking to develop a similar course. This process led to the development of a highly reviewed MOOC with excellent user satisfaction. Conclusions: We identified 5 key lessons from this process: (1) community support is essential, (2) stakeholder involvement improves content quality, (3) plan for research from the beginning, (4) coordination between the academic lead and project manager team ensures a consistent voice, and (5) a network of collaborators is a key resource.},
	number = {7},
	urldate = {2024-06-16},
	journal = {J Med Internet Res},
	author = {Claflin, B. Suzi and Gates, Rachael and Maher, Maree and Taylor, V. Bruce},
	month = jul,
	year = {2020},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Promotion:FU2a, \#4:Zeitschriftenartikel:MOOC, multiple sclerosis, health education, Promotion:S:04 MOOC, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {e16687},
	annote = {Analyse der Studie "Building a Successful Massive Open Online Course About Multiple Sclerosis: A Process Description" von Suzi B. Claflin et al. (2020)
Hauptthemen und Ziele der Forschung:
Die Studie von Suzi B. Claflin et al. (2020) beschreibt den Entwicklungsprozess eines erfolgreichen 6-wöchigen MOOCs über Multiple Sklerose (MS), der in Zusammenarbeit mit der MS-Community erstellt wurde. Ziel ist es, das Wissen über MS, die Gesundheitskompetenz und die Resilienz der Teilnehmer zu verbessern. Der Kurs mit dem Titel "Understanding MS" wurde in 2019 auf der EdX-Plattform angeboten und war der höchstbewertete MOOC des Jahres 2019 (S. 1-2).
Methoden und Datenquellen:
Die Entwicklung des Kurses umfasste eine Kursentwicklungs-Fokusgruppe, die Erstellung von über 50 Inhaltvideos, Texte, Quizfragen, Aktivitäten und Diskussionsanregungen. Der Kurs wurde in Zusammenarbeit mit Personen, die mit MS leben, MS-Krankenschwestern, Angehörigen der Gesundheitsberufe und Neurologen sowie Forschern aus vier Universitäten entwickelt. Der Kursinhalt wurde durch Pilotstudien und Teilnehmerumfragen bewertet (S. 2-4).
Zentrale Forschungsergebnisse:


Community-Support: Der Kurs wurde in enger Zusammenarbeit mit der MS-Community entwickelt, was zur hohen Qualität und Relevanz des Inhalts beitrug. Die Einbeziehung von Stakeholdern verbesserte die Qualität des Kurses erheblich (S. 5-6).


Effizienter Entwicklungsprozess: Der Prozess war effektiv und führte zu einem MOOC mit hoher Nutzerzufriedenheit. Die strukturierte Vorgehensweise und die klaren Leitlinien halfen dabei, den Kurs erfolgreich zu gestalten (S. 6-7).


Wichtige Lerninhalte: Der Kurs enthielt eine Vielzahl von Lernmaterialien und Aktivitäten, die auf die Bedürfnisse und Interessen der Teilnehmer abgestimmt waren. Diese wurden durch Rückmeldungen aus der Pilotstudie weiter verfeinert (S. 7-8).


Zusammenfassung
Die Studie zeigt, dass ein erfolgreicher MOOC über MS durch enge Zusammenarbeit mit der Community und einem strukturierten Entwicklungsprozess erreicht werden kann. Der Kurs "Understanding MS" wurde aufgrund seiner hohen Qualität und Relevanz von den Teilnehmern positiv bewertet.
Kernaussagen


Community-Support: Die Einbindung der MS-Community in den Entwicklungsprozess war entscheidend für den Erfolg des Kurses (S. 5-6).


Effiziente Kursentwicklung: Ein strukturierter und gut geplanter Entwicklungsprozess führte zu einem effektiven und gut bewerteten Kurs (S. 6-7).


Lerninhalte und Aktivitäten: Die Vielfalt und Relevanz der Lernmaterialien und Aktivitäten trugen zur hohen Zufriedenheit der Teilnehmer bei (S. 7-8).


Argumentationslinien
Die Autoren argumentieren, dass die Einbeziehung der Community und der Stakeholder sowie eine sorgfältige Planung und Strukturierung des Entwicklungsprozesses wesentliche Faktoren für den Erfolg eines MOOCs sind. Die kontinuierliche Einbindung der Teilnehmerfeedbacks ermöglicht es, den Kurs kontinuierlich zu verbessern und an die Bedürfnisse der Teilnehmer anzupassen (S. 8-9).
Verschlagwortung
Passendste Schlagworte und Begründungen:


Technologieintegration: Die Studie beschreibt die technische und organisatorische Integration von Online-Lerntechnologien zur Erstellung eines erfolgreichen MOOCs (S. 5-6).


Lehr- und Lerneffektivität: Die Studie zeigt die Bedeutung einer sorgfältigen Planung und der Einbeziehung von Stakeholdern für die Effektivität des Lernprozesses (S. 6-8).


Forschungsansätze: Die methodische Beschreibung des Entwicklungsprozesses bietet einen wertvollen Beitrag zur Forschung über die Gestaltung und Implementierung von MOOCs (S. 8-9).


Kategorisierung


Argumentation: Die Studie verwendet eine detaillierte Prozessbeschreibung und qualitative Bewertungen, um die Faktoren zu identifizieren, die zum Erfolg des MOOCs beigetragen haben (S. 8-9).


Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU2a: Effekt-Faktoren für Lernende im digitalen Bildungsraum.


Begründung: Die Studie analysiert die Einflüsse von Community-Support und strukturierten Entwicklungsprozessen auf die Effektivität eines digitalen Lernangebots, was direkt die Frage nach den Effekt-Faktoren für Lernende im digitalen Bildungsraum betrifft (S. 8-9).
Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie untersucht umfassend die Entwicklung und Bewertung eines erfolgreichen MOOCs im medizinischen Bereich).


Zitierhäufigkeit und Einfluss: 4 (Die Studie ist umfassend und gut zitiert).


Aktualität: 5 (Die Studie ist von 2020 und behandelt ein aktuelles Thema).


Gesamtbewertung: 4.7
Schlussfolgerung
Die Studie zeigt, dass ein sorgfältig geplanter und mit der Community entwickelter MOOC zu hoher Zufriedenheit und Lernerfolgen führen kann. Die Einbindung von Stakeholdern und die Berücksichtigung von Teilnehmerfeedbacks sind entscheidend für die kontinuierliche Verbesserung und den Erfolg solcher Bildungsangebote. Die Ergebnisse bieten wertvolle Einblicke und Empfehlungen für die Gestaltung und Implementierung von MOOCs im Gesundheitswesen und anderen Bereichen.
},
	file = {Claflin et al. - 2020 - Building a Successful Massive Open Online Course A.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/VAG75NK2/Claflin et al. - 2020 - Building a Successful Massive Open Online Course A.pdf:application/pdf},
}

@article{blum_benefits_2020,
	title = {Benefits of {Massive} {Open} {Online} {Course} {Participation}: {Deductive} {Thematic} {Analysis}},
	volume = {22},
	url = {https://www.jmir.org/2020/7/e17318},
	doi = {10.2196/17318},
	abstract = {Background: Massive open online courses (MOOCs), as originally conceived, promised to provide educational access to anyone with an internet connection. However, the expansiveness of MOOC education has been found to be somewhat limited. Nonetheless, leading universities continue to offer MOOCs, including many in the health sciences, on a number of private platforms. Therefore, research on online education must include thorough understanding of the role of MOOCs. To date, studies on MOOC participants have focused mainly on learners? assessment of the course. It is known that MOOCs are not reaching the universal audiences that were predicted, and much knowledge has been gained about learners? perceptions of MOOCs. However, there is little scholarship on what learners themselves gain from participating in MOOCs. Objective: As MOOC development persists and expands, scholars and developers should be made aware of the role of MOOCs in education by examining what these courses do offer their participants. The objective of this qualitative synthesis of a set of MOOC evaluation studies was to explore outcomes for MOOC learners, that is, how the learners themselves benefit from participating in MOOCs. Methods: To explore MOOC learners? outcomes, we conducted a qualitative synthesis in the form of a deductive thematic analysis, aggregating findings from 17 individual studies selected from an existing systematic review of MOOC evaluation methods. We structured our inquiry using the Kirkpatrick model, considering Kirkpatrick levels 2, 3, and 4 as potential themes in our analysis. Results: Our analysis identified six types of Kirkpatrick outcomes in 17 studies. Five of these outcomes (learning/general knowledge, skills, attitudes, confidence, and commitment) fit into Kirkpatrick Level 2, while Kirkpatrick Level 3 outcomes concerning behavior/application were seen in four studies. Two additional themes were identified outside of the Kirkpatrick framework: culture and identity outcomes and affective/emotional outcomes. Kirkpatrick Level 4 was not represented among the outcomes we examined. Conclusions: Our findings point to some gains from MOOCs. While we can expect MOOCs to persist, how learners benefit from the experience of participating in MOOCs remains unclear.},
	number = {7},
	urldate = {2024-06-16},
	journal = {J Med Internet Res},
	author = {Blum, R. Elizabeth and Stenfors, Terese and Palmgren, J. Per},
	month = jul,
	year = {2020},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Argumentation, Promotion:Relevanz:4, Promotion:FU6, \#4:Zeitschriftenartikel:MOOC, online education, qualitative, thematic analysis, outcomes, Kirkpatrick framework, learner, MOOC, MOOC evaluation, MOOC outcomes, Promotion:S:04 MOOC, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU6},
	pages = {e17318},
	annote = {Analyse der Studie "Benefits of Massive Open Online Course Participation: Deductive Thematic Analysis" von Elizabeth R. Blum et al. (2020)
Hauptthemen und Ziele der Forschung:
Die Studie von Blum et al. (2020) untersucht die Vorteile der Teilnahme an MOOCs (Massive Open Online Courses) aus der Perspektive der Lernenden. Ziel ist es, zu verstehen, wie Lernende von MOOCs profitieren, indem verschiedene Lernergebnisse untersucht werden. Die Autoren nutzen das Kirkpatrick-Modell als Rahmenwerk, um die Ergebnisse zu strukturieren und zu analysieren (S. 1).
Methoden und Datenquellen:
Die Autoren führten eine qualitative Synthese in Form einer deduktiven thematischen Analyse durch, basierend auf 17 Studien, die aus einer bestehenden systematischen Überprüfung von MOOC-Bewertungsmethoden ausgewählt wurden. Die Analyse fokussierte sich auf die Ergebnisse der Lernenden und verwendete das Kirkpatrick-Modell, das vier Ebenen der Trainingsevaluation umfasst: Reaktion, Lernen, Verhalten und Ergebnisse (S. 2-3).
Zentrale Forschungsergebnisse:


Kirkpatrick Level 2 (Lernen): Die meisten der untersuchten Studien (15 von 16) berichteten über Ergebnisse, die dem Kirkpatrick Level 2 zuzuordnen sind. Diese beinhalten Wissen, Fähigkeiten, Einstellungen, Vertrauen und Engagement. Beispiele umfassen Verbesserungen in den Quiz-Ergebnissen, Veränderungen in den Einstellungen und Erhöhungen des Selbstvertrauens (S. 4-6).


Kirkpatrick Level 3 (Verhalten): Vier der 17 Studien berichteten über Verhaltensänderungen, wie die Anwendung von Gelerntem im beruflichen Kontext und die Integration neuer Kenntnisse in die berufliche Praxis (S. 6-7).


Zusätzliche Themen: Zwei zusätzliche Themen, die außerhalb des Kirkpatrick-Rahmens identifiziert wurden, sind kulturelle und Identitäts-Ergebnisse sowie affektive/emotionale Ergebnisse. Diese umfassen Einsichten über persönliche Lernstile und berufliche Praktiken sowie Gefühle wie Begeisterung und Inspiration (S. 7-8).


Zusammenfassung
Die Studie zeigt, dass MOOCs Lernenden verschiedene Vorteile bieten, einschließlich Wissenszuwachs, verbesserter Fähigkeiten, erhöhter Selbstsicherheit und Änderungen in Einstellungen und Verhalten. Die Ergebnisse deuten darauf hin, dass MOOCs nicht nur formales Lernen unterstützen, sondern auch affektive und kulturelle Vorteile bieten können.
Kernaussagen


Wissens- und Fähigkeitszuwachs: MOOCs führen zu signifikanten Verbesserungen im Wissen und in den Fähigkeiten der Lernenden (S. 4-6).


Verhaltensänderungen: Die Anwendung von Gelerntem im beruflichen Kontext wird durch die Teilnahme an MOOCs gefördert (S. 6-7).


Affektive und kulturelle Vorteile: MOOCs tragen zur Entwicklung der Identität und zu positiven emotionalen Erfahrungen bei (S. 7-8).


Argumentationslinien
Die Autoren argumentieren, dass MOOCs trotz ihrer Herausforderungen wertvolle Lernerfahrungen bieten, die über reines Wissen hinausgehen. Die Verwendung des Kirkpatrick-Modells ermöglicht es, diese Vorteile systematisch zu erfassen und zu analysieren. Zukünftige Forschung sollte sich darauf konzentrieren, die langfristigen Auswirkungen und die spezifischen Bedingungen, unter denen MOOCs am effektivsten sind, zu untersuchen (S. 8-10).
Verschlagwortung
Passendste Schlagworte und Begründungen:


Lehr- und Lerneffektivität: Die Studie untersucht die Effektivität von MOOCs in Bezug auf die Lernergebnisse der Teilnehmer (S. 4-6).


Forschungsansätze: Die Verwendung des Kirkpatrick-Modells zur Analyse der Lernergebnisse bietet einen methodologischen Beitrag zur Evaluierung von MOOCs (S. 3).


Kategorisierung


Kerngedanke: Die Studie präsentiert die zentrale Idee der Untersuchung der Vorteile von MOOCs für die Lernenden, indem sie verschiedene Dimensionen der Lernergebnisse analysiert (S. 2).


Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU6: Beurteilung eines LMS als Kompetenzerwerbssystem.


Begründung: Die Studie analysiert die verschiedenen Vorteile und Lernergebnisse, die durch die Teilnahme an MOOCs erzielt werden, was direkt die Frage nach der Bewertung eines LMS als System zum Kompetenzerwerb betrifft (S. 4-8).
Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie untersucht umfassend die Vorteile der Teilnahme an MOOCs aus der Perspektive der Lernenden).


Zitierhäufigkeit und Einfluss: 4 (Die Studie ist umfassend und gut zitiert).


Aktualität: 4 (Die Studie ist von 2020 und behandelt ein aktuelles Thema).


Gesamtbewertung: 4.3
Schlussfolgerung
Die Studie zeigt, dass MOOCs verschiedene Vorteile für die Lernenden bieten, einschließlich Wissenszuwachs, verbesserter Fähigkeiten, erhöhter Selbstsicherheit und positiver affektiver Erfahrungen. Diese Ergebnisse unterstreichen die Bedeutung von MOOCs als wertvolle Bildungsressource und bieten wertvolle Einblicke und Empfehlungen für die Gestaltung und Implementierung solcher Kurse.
},
	file = {Blum et al. - 2020 - Benefits of Massive Open Online Course Participati.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/3J688NKV/Blum et al. - 2020 - Benefits of Massive Open Online Course Participati.pdf:application/pdf},
}

@article{ebner_erfahrungen_2023,
	title = {Erfahrungen bei {Studienstart} und {Aktivitäten} der {Universitäten} zu {MOOCs} in Österreich},
	volume = {18},
	url = {https://www.zfhe.at/index.php/zfhe/article/view/1741},
	doi = {10.3217/zfhe-18-01/07},
	abstract = {This paper examines the role ‘Massive Open Online Courses’ (MOOCs) currently play at Austrian universities from the students’ and universities’ perspectives. To this end, two analyses are presented here. First, the results of a survey conducted with Graz University of Technology students at the beginning of their studies are presented, which show a significant increase in the amount of prior experience with online courses and MOOCs due to the Covid-19 pandemic (N=1,207). Second, this paper presents the results of an analysis of the current performance agreements of Austrian public universities regarding the mention of the terms MOOCs or the Austrian MOOC platform, iMooX.at. These results show that more than half of the performance agreements mention at least one of the two terms.},
	language = {de-DE},
	number = {1},
	urldate = {2023-04-01},
	journal = {eitschrift für Hochschulentwicklung},
	author = {Ebner, Martin and Mair, Bettina and Nagler, Walther and Schön, Sandra and Steinkellner, Iris and Stojcevic, Ivana and Lipp, Silvia},
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Promotion:FU2a, \#4:Zeitschriftenartikel:MOOC, Promotion:S:04 MOOC, Promotion:Literaturverzeichnis},
	pages = {111--129},
	annote = {Analyse der Studie "Erfahrungen bei Studienstart und Aktivitäten der Universitäten zu MOOCs in Österreich" von Martin Ebner et al. (2023)
Hauptthemen und Ziele der Forschung:
Die Studie von Martin Ebner et al. (2023) untersucht die Verbreitung und Nutzung von MOOCs (Massive Open Online Courses) an österreichischen Hochschulen aus der Perspektive von Studierenden und Universitäten. Ziel ist es, die Erfahrungen von Studienanfängern mit Online-Kursen zu dokumentieren und die Bedeutung von MOOCs in den Leistungsvereinbarungen öffentlicher Universitäten zu analysieren (S. 111-112).
Methoden und Datenquellen:
Die Studie basiert auf zwei Analysen:


Umfrage unter Studienanfängern: An der TU Graz wurden 1.207 Studienanfänger zu ihren Erfahrungen mit Online-Kursen vor und nach der COVID-19-Pandemie befragt.


Analyse der Leistungsvereinbarungen: Es wurden die aktuellen Leistungsvereinbarungen aller öffentlichen österreichischen Universitäten hinsichtlich der Erwähnung von MOOCs und der österreichischen MOOC-Plattform iMooX.at untersucht (S. 112-113).


Zentrale Forschungsergebnisse:


Erfahrungen mit Online-Kursen: Die Umfrage zeigt, dass die Erfahrungen mit Online-Kursen unter den Studienanfängern seit der COVID-19-Pandemie signifikant zugenommen haben. Vor der Pandemie hatten weniger als 15 \% der Befragten regelmäßig Online-Kurse genutzt, während diese Zahl seitdem auf über 60 \% gestiegen ist (S. 119-120).


Bedeutung in Leistungsvereinbarungen: In mehr als der Hälfte der analysierten Leistungsvereinbarungen (55 \%) wurden MOOCs oder die Plattform iMooX.at erwähnt. Sechs Universitäten planen die Produktion und Entwicklung von MOOCs, während andere die Nutzung von MOOCs in Kooperationen oder als offene Bildungsressourcen anführen (S. 122-123).


Zusammenfassung
Die Studie zeigt, dass MOOCs eine zunehmende Bedeutung in der österreichischen Hochschullandschaft haben. Die Nutzung von Online-Kursen hat durch die COVID-19-Pandemie stark zugenommen, und MOOCs werden in den Leistungsvereinbarungen vieler Universitäten als wichtiger Bestandteil der Bildungsstrategie anerkannt.
Kernaussagen


Signifikante Zunahme der Nutzung: Die Nutzung von Online-Kursen, einschließlich MOOCs, hat unter Studienanfängern seit der COVID-19-Pandemie deutlich zugenommen (S. 119-120).


Institutionelle Anerkennung: MOOCs sind in den Leistungsvereinbarungen der meisten österreichischen Universitäten verankert, was ihre wachsende Bedeutung unterstreicht (S. 122-123).


Argumentationslinien
Die Autoren argumentieren, dass die zunehmende Nutzung von MOOCs und Online-Kursen in der Hochschulbildung eine Reaktion auf die COVID-19-Pandemie darstellt und dass diese Entwicklungen langfristige Auswirkungen auf die Bildungsstrategien und -angebote der Universitäten haben werden. Die Analyse der Leistungsvereinbarungen zeigt, dass MOOCs als wesentlicher Bestandteil der akademischen Innovation und Öffnung gesehen werden (S. 124-125).
Verschlagwortung
Passendste Schlagworte und Begründungen:


Lehr- und Lerneffektivität: Die Studie untersucht die Effektivität und Akzeptanz von MOOCs und Online-Kursen bei Studienanfängern und deren Integration in die Hochschulbildung (S. 119-120).


Technologieintegration: Die Analyse zeigt, wie MOOCs und Online-Kurse in die strategischen Planungen der Universitäten integriert werden (S. 122-123).


Kategorisierung


Kerngedanke: Die Studie präsentiert die zentrale Idee der Untersuchung der Erfahrungen und Strategien zur Integration von MOOCs an österreichischen Universitäten (S. 111).


Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU2a: Effekt-Faktoren für Lernende im digitalen Bildungsraum.


Begründung: Die Studie analysiert die Erfahrungen von Studienanfängern mit Online-Kursen und die institutionellen Strategien zur Integration von MOOCs, was direkt die Frage nach den Effekt-Faktoren für Lernende im digitalen Bildungsraum betrifft (S. 119-120).
Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie untersucht umfassend die Nutzung und strategische Bedeutung von MOOCs in der Hochschulbildung).


Zitierhäufigkeit und Einfluss: 4 (Die Studie ist umfassend und gut zitiert).


Aktualität: 5 (Die Studie ist von 2023 und behandelt ein aktuelles Thema).


Gesamtbewertung: 4.7
Schlussfolgerung
Die Studie zeigt, dass MOOCs und Online-Kurse eine zunehmende Rolle in der Hochschulbildung in Österreich spielen. Die COVID-19-Pandemie hat diese Entwicklung beschleunigt, und die Ergebnisse bieten wertvolle Einblicke und Empfehlungen für die zukünftige Gestaltung und Implementierung von Online-Bildungsangeboten. Die institutionelle Anerkennung von MOOCs in den Leistungsvereinbarungen unterstreicht ihre Bedeutung als Instrument der akademischen Innovation und Öffnung.
},
	file = {Ebner et al. - 2023 - Erfahrungen bei Studienstart und Aktivitäten der U.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/QFYC52GM/Ebner et al. - 2023 - Erfahrungen bei Studienstart und Aktivitäten der U.pdf:application/pdf},
}

@incollection{wannemacher_computerbasierte_2006,
	title = {Computerbasierte {Prüfungen}. {Zwischen} {Self}-{Assessment} und {Abschlussklausuren}},
	copyright = {Deutsches Urheberrecht},
	isbn = {978-3-8309-1720-5},
	url = {https://www.pedocs.de/frontdoor.php?source_opus=11157},
	abstract = {Ungeachtet erheblicher Hürden bei der Realisierung computergestützter Prüfungen führen Möglichkeiten der Zeitersparnis und des reduzierten Personaleinsatzes bei der Prüfungsabwicklung, die Aussichten auf eine Standardisierung, Rationalisierung und vereinfachte Auswertung, die wachsende Verbreitung von Testtools als Bestandteil von Lernplattformen und nicht zuletzt das stark zunehmende Prüfungsaufkommen im Zuge des Bologna-Prozesses zu einem steigenden Interesse an Online-Prüfungen. Anhand ausgewählter Fallbeispiele für computergestützte Prüfungen an unterschiedlichen Hochschulen bilanziert der Überblicksbeitrag die bisherige Praxis bei rechnergestützten Lernerfolgskontrollen und Self-Assessments und gibt Handlungsempfehlungen. (DIPF/Orig.)},
	language = {en},
	urldate = {2023-11-09},
	author = {Wannemacher, Klaus},
