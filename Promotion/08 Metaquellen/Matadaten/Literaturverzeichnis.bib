@article{gyamfi_impact_2024,
	title = {Impact of an instructional guide and examples on the quality of feedback: insights from a randomised controlled study},
	volume = {72},
	issn = {1042-1629, 1556-6501},
	shorttitle = {Impact of an instructional guide and examples on the quality of feedback},
	url = {https://link.springer.com/10.1007/s11423-024-10346-0},
	doi = {10.1007/s11423-024-10346-0},
	abstract = {While the provision of peer feedback has been widely recommended to enhance learning, many students are inexperienced in this area and would benefit from guidance. This study therefore examines the impact of instructions and examples on the quality of feedback provided by students on peer-developed learning resources produced via an online system, RiPPLE. A randomised controlled experiment with 195 students was conducted to investigate the efficacy of the approach. While the treatment group had access to instructions and examples to support their provision of feedback, the control group had no such assistance. Students’ feedback comments were coded using an adaptation of the S.P.A.R.K. (Specific, Prescriptive, Actionable, Referenced, Kind) model. The results indicate that the instructional guide and examples led to students writing more comprehensive comments. The intervention notably enhanced the presence of feedback traits matching the S.P.A.R.K. model and increased instances where multiple traits of quality were observed in a single comment. However, despite the guide’s impact, the students’ ability to provide actionable feedback was limited. These findings demonstrate the potential of developing and integrating structured guidance and examples into online peer feedback platforms.},
	language = {en-GB},
	number = {3},
	urldate = {2024-07-21},
	journal = {Educational technology research and development},
	author = {Gyamfi, George and Hanna, Barbara E. and Khosravi, Hassan},
	month = jun,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:FU4a, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {1419--1437},
	annote = {Analyse des Artikels „Impact of an instructional guide and examples on the quality of feedback: Insights from a randomised controlled study“ von Gyamfi et al. (2024)

1. Hauptthemen und Ziele der Forschung
Der Artikel untersucht, wie sich eine strukturierte Anleitung mit Beispielen auf die Qualität von Peer-Feedback auswirkt. Ziel ist es, die Effektivität von Feedback-Trainings auf die Länge und Qualität von Peer-Kommentaren in einem personalisierten Online-Lernumfeld namens RiPPLE zu bewerten. Die Studie analysiert, wie Feedback-Tipps und das S.P.A.R.K.-Modell (Specific, Prescriptive, Actionable, Referenced, Kind) die Evaluationskompetenz und die Feedback-Qualität verbessern können.

2. Methoden und Datenquellen


Design: Randomisiertes kontrolliertes Experiment (RCT) mit 195 Studierenden in einem angewandten Linguistikkurs.


Datenquellen:


7231 moderierte Lernressourcen.


5907 qualitativ analysierte Kommentare.


Vergleich zwischen einer Trainingsgruppe (95 Studierende) und einer Kontrollgruppe (100 Studierende).




Bewertung: Kombination aus quantitativer (Länge der Kommentare) und qualitativer Analyse (Vorhandensein von S.P.A.R.K.-Merkmalen).



3. Zentrale Forschungsergebnisse


Längere Kommentare: Die Trainingsgruppe verfasste im Durchschnitt signifikant längere Kommentare (M = 26,23 Wörter) im Vergleich zur Kontrollgruppe (M = 21,47 Wörter).


Höhere Qualität: Kommentare der Trainingsgruppe zeigten häufiger S.P.A.R.K.-Merkmale (71,2 \% vs. 59,1 \% in der Kontrollgruppe).


Multidimensionale Qualität: Die Trainingsgruppe verfasste mehr Kommentare mit mehreren S.P.A.R.K.-Merkmalen gleichzeitig (87 \% vs. 55,7 \%).


Schwierigkeit bei „Actionable“-Feedback: Beide Gruppen hatten Schwierigkeiten, konkrete, umsetzbare Verbesserungsvorschläge zu geben, obwohl die Trainingsgruppe besser abschnitt.



Zusammenfassung
Die Studie zeigt, dass eine strukturierte Anleitung die Qualität von Peer-Feedback signifikant verbessern kann. Die Verwendung von Feedback-Tipps und Beispielen förderte längere und qualitativ hochwertigere Kommentare, insbesondere in Hinblick auf die Kriterien des S.P.A.R.K.-Modells. Die Ergebnisse unterstreichen das Potenzial leicht zugänglicher Trainingsansätze, um die Feedback-Kompetenz in digitalen Lernumgebungen zu stärken.

Kernaussagen


Bedeutung von Trainings: Strukturierte Anleitungen fördern die Feedback-Qualität und verbessern die Evaluationskompetenz von Studierenden (S. 1433).


S.P.A.R.K.-Modell: Das Modell bietet eine effektive Basis für die Analyse und Verbesserung von Peer-Feedback (S. 1430).


Nachhaltige Verbesserungen: Auch bei kurzen Interventionen sind positive Effekte erkennbar, was die Praktikabilität solcher Ansätze unterstreicht (S. 1434).



Argumentationslinien
Die Autoren argumentieren, dass Trainings zur Feedback-Qualität nicht nur die Kompetenz der Studierenden fördern, sondern auch das Vertrauen in Peer-Feedback stärken können. Sie empfehlen den Einsatz solcher Trainings als integralen Bestandteil digitaler Lernumgebungen (S. 1435).

Verschlagwortung


Lehr- und Lerneffektivität:Begründung: Die Studie zeigt, wie Trainingsansätze die Qualität von Peer-Feedback und damit die Effektivität von Lernprozessen verbessern können. (S. 1433)


Bewertungsmethoden:Begründung: Die Forschung verwendet qualitative und quantitative Analysen, um die Wirkung von Trainings zu bewerten. (S. 1430)


Technologieintegration:Begründung: Die Plattform RiPPLE bietet eine technologiegestützte Umgebung für personalisiertes Lernen und Feedback. (S. 1423)



Kategorisierung
Kerngedanke: Die Studie zeigt, wie strukturierte Anleitungen und Beispiele die Qualität und den Umfang von Peer-Feedback signifikant verbessern können, indem sie die Evaluationskompetenz der Lernenden stärken. (S. 1433)

Zuordnung zur Forschungsunterfrage
Passendste Forschungsunterfrage:FU4a:„Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum beschrieben?“
Begründung:Der Artikel zeigt, wie spezifische Trainingsmechanismen die Evaluations- und Feedback-Kompetenz der Studierenden fördern, was als bildungswissenschaftlicher Mechanismus im Rahmen digitaler Bildungsräume interpretiert werden kann.

Relevanzbewertung


Relevanz: 5 (Die Studie liefert empirische Evidenz zur Verbesserung von Peer-Feedback in digitalen Lernumgebungen und unterstützt die Entwicklung effektiver Trainingsstrategien.)


},
