	editor = {{Geschäftsstelle beim Stifterverband}},
	year = {2021},
	keywords = {\#7:Buchteil:digital:Medien, Promotion:Literaturanalyse, Leraning:Analytics, Promotion:S:07 Digitale Medien, Promotion:Literaturverzeichnis},
	pages = {215--231},
	file = {Scheidig und Holmeier - 2021 - Learning Analytics aus institutioneller Perspektiv.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/L793JYYA/Scheidig und Holmeier - 2021 - Learning Analytics aus institutioneller Perspektiv.pdf:application/pdf},
