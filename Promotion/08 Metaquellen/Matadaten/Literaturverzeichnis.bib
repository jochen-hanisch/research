	pmid = {38123791},
	pmcid = {PMC10733361},
	keywords = {Charité:Promotion, Promotion:01-02, Humans, Longitudinal Studies, Promotion:Eye-Tracking, Cohort Studies, Magnetic Resonance Imaging, Prospective Studies, ROC Curve, Promotion:01-02 Methodenquellen, Promotion:Literaturverzeichnis},
	pages = {22745},
	file = {Volltext:/Users/jochenhanisch-johannsen/Zotero/storage/MJKSKRDR/Schuppert et al. - 2023 - Automated image quality assessment for selecting a.pdf:application/pdf},
