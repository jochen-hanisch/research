}

@article{majid_promoting_2024,
	title = {Promoting and {Assessing} {Collaborative} {Learning} using {Learning} {Analytics} in {Higher} {Education}– {Overview} of {Drivers} and {Wheels}},
	volume = {12},
	abstract = {Learning analytics leverages the use of technology to gather and analyse data about student performance, engagement, and learning behaviours, which can help educators make informed decisions about how to improve learning outcomes. In higher education, learning analytics can provide insights into student engagement, performance, and learning pathways. Collaborative learning in higher education involves a group of students working together towards a common goal or task. Collaborative learning encourages students to work together to solve problems, analyse information, and make decisions, especially in self-directed learning environment. Through discussion and debate, students develop critical thinking skills and learn to approach problems from different perspectives to enhance problem-solving skills. Collaborative learning provides opportunities for students to work with others from diverse backgrounds, helping them develop interpersonal skills such as communication, teamwork, and leadership. While collaborative learning helps students to foster critical thinking and develop interpersonal skills, students’ activities and engagement in collaborative learning are not properly assessed and measured. Student performance indicators are highly dependent on the learning activities and resources used in the learning management system based on individual basis. The ability and potential of learning analytics to track students’ behaviour and performance in team, and to monitor the effectiveness of their sharing and communication is not fully utilised in higher education. This paper addresses this issue and aims to provide an overview of collaborative learning analytics. The overview elaborates essential elements in collaborative learning and defines features in analytics to support collaborative learning. The overview is expected to guide to educators and developers in promoting and assessing students’ performance based on collaborative works.},
	language = {en-GB},
	number = {1},
	journal = {Educatum JSMT},
	author = {Majid, Norjumaahtul Adawwiah Ab and Judi, Hairulliza Mohamad},
	month = aug,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Kollaboratives Lernen, Promotion:Relevanz:5, Technologieintegration, Bewertungsmethoden, Promotion:Weiterführung, Promotion:FU5, \#1:Zeitschriftenartikel:learning:management:system, Datenschutz und IT-Sicherheit, Leraning:Analytics, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU5},
	annote = {Analyse der Studie "Promoting and Assessing Collaborative Learning using Learning Analytics in Higher Education: Overview of Drivers and Wheels" von Norjumaahtul Adawwiah Ab Majid und Hairulliza Mohamad Judi (2025)
1. Hauptthemen und Ziele der Forschung
Die Studie von Majid und Judi untersucht die Rolle von Learning Analytics bei der Förderung und Bewertung von kollaborativem Lernen in der Hochschulbildung. Das Hauptziel ist es, die treibenden Kräfte und Herausforderungen bei der Integration von Learning Analytics in kollaborative Lernumgebungen zu verstehen. Die Autoren zielen darauf ab, einen Rahmen für kollaborative Learning Analytics zu entwickeln, der Forschern und Entwicklern als Leitfaden dient, um die Leistung von Studierenden in kollaborativen Lernumgebungen zu fördern und zu bewerten.
2. Methoden und Datenquellen
Die Studie basiert auf einer umfassenden Literaturübersicht und einem empirischen Test des entwickelten Rahmens an einer Stichprobe von 360 Studierenden einer öffentlichen Universität in Indien. Die empirische Analyse wurde durch eine Konfirmatorische Faktorenanalyse (CFA) unterstützt, um die hypothesisierten Konstrukte des Modells zu validieren. Dabei wurden Daten aus verschiedenen Quellen wie Learning Management Systems (LMS), sozialen Medien und Sensoren gesammelt.
3. Zentrale Forschungsergebnisse


Integration von Learning Analytics: Die Ergebnisse zeigen, dass die Integration von Learning Analytics in kollaborative Lernumgebungen signifikant zur Verbesserung der Studierendenleistung beitragen kann, indem sie die Interaktivität zwischen Lehrenden und Studierenden sowie unter den Studierenden selbst fördert.


Bedeutung von Interaktivität und Feedback: Die Interaktivität mit Lehrenden, die Interaktivität mit Peers und das Teilen von Informationen erwiesen sich als entscheidende Faktoren für das Engagement der Studierenden, was wiederum positive Auswirkungen auf ihre akademischen Leistungen hatte.


Herausforderungen und Datenschutz: Die Autoren betonen die Notwendigkeit, Datenschutzbedenken zu berücksichtigen, insbesondere im Hinblick auf die Sammlung und Verarbeitung von sensiblen Daten in kollaborativen Lernanalysen.


4. Zusammenfassung
Die Studie untersucht die Nutzung von Learning Analytics zur Förderung und Bewertung kollaborativen Lernens in der Hochschulbildung. Sie zeigt, dass Learning Analytics die Interaktivität und das Engagement der Studierenden verbessern kann, was zu besseren Lernergebnissen führt. Der entwickelte Rahmen soll als Leitfaden dienen, um Learning Analytics effektiver in kollaborative Lernumgebungen zu integrieren und gleichzeitig Datenschutz- und Sicherheitsfragen zu adressieren.
5. Kernaussagen


Interaktivität als Schlüssel: "Interactivity with instructors, interactivity with peers, and sharing behaviour significantly influence students' engagement, which in turn has a notable impact on their academic performance." (S. 45)


Datenschutz und Sicherheit: "Issues related to privacy and security need to be addressed in the design and development of learning analytics systems." (S. 46)


6. Argumentationslinien
Die Autoren argumentieren, dass Learning Analytics ein mächtiges Werkzeug zur Verbesserung kollaborativer Lernprozesse ist, vorausgesetzt, dass die Systeme sorgfältig entworfen werden, um Datenschutz- und Sicherheitsbedenken zu berücksichtigen. Sie unterstreichen, dass die Interaktivität zwischen Studierenden und Lehrenden sowie unter den Studierenden selbst der zentrale Mechanismus ist, der durch Learning Analytics unterstützt werden kann, um die Lernergebnisse zu optimieren.
7. Verschlagwortung


Kollaboratives Lernen: Die Studie fokussiert sich auf die Verbesserung des kollaborativen Lernens durch die Anwendung von Learning Analytics.


Bewertungsmethoden: Die Autoren untersuchen, wie Learning Analytics genutzt werden kann, um das Engagement und die Leistung der Studierenden in kollaborativen Lernumgebungen zu bewerten.


Technologieintegration: Es wird diskutiert, wie Learning Analytics in bestehende Bildungstechnologien integriert werden kann, um kollaborative Lernprozesse zu unterstützen.


Datenschutz und IT-Sicherheit: Die Studie adressiert Datenschutz- und Sicherheitsfragen im Zusammenhang mit der Nutzung von Learning Analytics in kollaborativen Lernumgebungen.


8. Kategorisierung: Weiterführung
Weiterführung: Die Studie legt nahe, dass zukünftige Forschung sich darauf konzentrieren sollte, datenschutzfreundliche Learning-Analytics-Tools zu entwickeln, die das kollaborative Lernen unterstützen und gleichzeitig die Privatsphäre der Studierenden wahren. Es wird vorgeschlagen, mehr theoretisch fundierte Ansätze zu entwickeln, um die Integration von Learning Analytics in kollaborative Lernumgebungen zu verbessern.
9. Zuordnung zur passenden Forschungsunterfrage
FU5: Welche Möglichkeiten und Grenzen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems durch Akteure im digitalen Bildungsraum von Gesundheitsberufen analysiert?


Begründung: Die Studie untersucht die Potenziale und Herausforderungen der Nutzung von Learning Analytics in kollaborativen Lernumgebungen, was wichtige Einblicke in die Grenzen und Möglichkeiten solcher Systeme im Bildungsbereich bietet.


10. Relevanzbewertung


Relevanz für die Forschungsfrage: 5 (Die Studie liefert wertvolle Einsichten in die Nutzung von Learning Analytics zur Unterstützung kollaborativen Lernens.)


Zitierhäufigkeit und Einfluss: 4 (Das Thema ist hochrelevant und die Studie ist aktuell, obwohl die Zitierhäufigkeit aufgrund der Neuheit der Studie noch gering sein könnte.)


Aktualität: 5 (Veröffentlichung im Jahr 2025, also sehr aktuell.)


Gesamtbewertung: 4.7


11. Schlussfolgerung
Die Studie von Majid und Judi bietet eine fundierte Analyse der Rolle von Learning Analytics im kollaborativen Lernen. Sie betont die Bedeutung der Interaktivität und des Datenschutzes und schlägt vor, dass zukünftige Forschungsarbeiten sich auf die Entwicklung datenschutzfreundlicher Analytics-Tools konzentrieren sollten, die das kollaborative Lernen weiter verbessern können.
},
	file = {Majid und Judi - 2025 - Promoting and Assessing Collaborative Learning usi.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/XPE5GZ6W/Majid und Judi - 2025 - Promoting and Assessing Collaborative Learning usi.pdf:application/pdf},
}

@article{sonmez_comprehensive_2024,
	title = {A {Comprehensive} {Bibliometric} {Analysis} of {Learning} {Analytics} in {Education} {Research}},
	volume = {6},
	url = {https://doi.org/10.46328/ijonse.234},
	abstract = {The purpose of this study is to present data on the use of learning analytics in the field of education. For this purpose, data available in the Web of Science database were examined using bibliometric analysis. The publication distribution varied between 2011 and 2022, with the number of publications reaching its peak in 2020 and declining thereafter. Findings from co-authorship analysis indicate that Dragan Gašević is the most prolific author and the most cited researcher in the field of learning analytics. Results of co-authorship analysis by country suggest that researchers affiliated with institutions in Australia engage in more collaborative work and cooperation. Results of co-authorship analysis by organizations demonstrate that Monash University in Australia is the organization with the highest level of collaboration with other organizations. The most cited work is Ferguson's (2012) article titled "Learning analytics: drivers, developments and challenges." The most frequently used keywords in conjunction with learning analytics are higher education, educational data mining, online learning, learning design, and self-regulated learning. In recent years, there has been a focus on learning analytics related to learning management systems (LMS) rather than MOOCs in learning environments. The British Journal of Educational Technology, which was established in 1970, is the most cited journal that is commonly referenced in the articles. It is hoped that this study will serve as a valuable reference for researchers interested in the field and guide them in making accurate inferences based on a broad perspective.},
	language = {en-GB},
	number = {3},
	journal = {International Journal on Studies in Education (IJonSE)},
	author = {Sönmez, Esra Ergül},
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Bildungstheorien, Promotion:Relevanz:4, Promotion:Weiterführung, \#1:Zeitschriftenartikel:learning:management:system, Promotion:FU3, Leraning:Analytics, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {446--462},
	annote = {Analyse der Studie "A Comprehensive Bibliometric Analysis of Learning Analytics in Education Research" von Esra Ergül Sönmez
1. Analyse
Hauptthemen und Ziele der Forschung:
Die Studie von Esra Ergül Sönmez (2024) zielt darauf ab, die Nutzung von Learning Analytics im Bildungsbereich durch eine umfassende bibliometrische Analyse darzustellen. Der Fokus liegt darauf, die Verteilung von Publikationen und deren Zitationen im Zeitraum von 2011 bis 2022 zu untersuchen und die zentralen Akteure, Länder und Organisationen in der Forschung zu identifizieren. Ziel ist es, durch die Analyse von Co-Autorschafts-Netzwerken, Schlüsselwörtern und Zitationsquellen ein umfassendes Bild des Forschungsfeldes zu schaffen.
Methoden und Datenquellen:
Die Forschung nutzt die bibliometrische Analysemethode und greift auf Daten der Web of Science-Datenbank zu, wobei ausschließlich Artikel in der Kategorie "Education Educational Research" berücksichtigt werden. Die Datenanalyse erfolgte mittels des Tools VOSviewer, welches bibliometrische Netzwerke visualisiert und interpretiert.
Zentrale Forschungsergebnisse:


Verteilung von Publikationen: Die Anzahl der Veröffentlichungen über Learning Analytics erreichte 2020 ihren Höhepunkt, gefolgt von einem Rückgang. Die Anzahl der Zitationen blieb jedoch konstant hoch, was darauf hindeutet, dass das Feld weiterhin bedeutend ist, obwohl es an Popularität verloren hat.


Co-Autorschafts-Netzwerke: Dragan Gašević ist der produktivste und meistzitierte Autor im Bereich Learning Analytics. Australien zeigt die stärkste internationale Zusammenarbeit und wird als führend im Bereich angesehen, insbesondere durch Institutionen wie Monash University und Open University.


Einflussreiche Zitationsquellen: Das am häufigsten zitierte Werk ist Fergusons Artikel von 2012 über die Treiber, Entwicklungen und Herausforderungen von Learning Analytics. Zu den führenden Zeitschriften gehören "Computers \& Education" und "Educational Technology \& Society".


Keyword-Analyse: Die häufigsten Keywords sind "higher education", "educational data mining", und "online learning". Es zeigt sich eine Verschiebung der Forschung von MOOCs hin zu Learning Management Systems (LMS), insbesondere im Kontext der COVID-19-Pandemie.


2. Zusammenfassung
Der Artikel bietet eine umfassende bibliometrische Analyse von Learning Analytics in der Bildungsforschung, indem er Publikations- und Zitationsmuster analysiert und zentrale Autoren, Länder und Institutionen identifiziert. Die Ergebnisse zeigen, dass Australien führend in der Forschung ist und dass Learning Analytics vor allem im Hochschulbereich Anwendung findet. Die Studie unterstreicht die Bedeutung von Learning Management Systems gegenüber MOOCs und zeigt, dass Learning Analytics trotz eines Rückgangs an Veröffentlichungen weiterhin von zentraler Bedeutung bleibt.
3. Kernaussagen


Learning Analytics in der Forschung: Der Bereich hat seit 2011 signifikant an Bedeutung gewonnen und ist besonders im Hochschulbereich relevant. (S. 459)


Zentrale Akteure: Dragan Gašević und australische Institutionen wie die Monash University sind führend in der Forschung und Zusammenarbeit. (S. 451, 453)


Entwicklungsschwerpunkte: Es gibt eine Verschiebung von MOOCs zu LMS in der Learning Analytics Forschung. (S. 458)


4. Argumentationslinien
Die Autorin argumentiert, dass Learning Analytics ein sich entwickelndes Forschungsfeld ist, das durch interdisziplinäre Zusammenarbeit und den verstärkten Einsatz von Technologien in der Bildung geprägt ist. Australien wird als Vorreiter genannt, was durch starke internationale Netzwerke und die Nutzung von Learning Analytics in verschiedenen Bildungskontexten unterstützt wird. (S. 460)
5. Verschlagwortung


Technologieintegration: Die Studie untersucht die Nutzung und Integration von Learning Analytics in Bildungssystemen.


Lehr- und Lerneffektivität: Learning Analytics wird verwendet, um die Effektivität von Lernprozessen zu messen und zu verbessern.


Bildungstheorien: Die Untersuchung von Lernverhalten und -ergebnissen in verschiedenen Bildungskontexten ist zentral für die Anwendung von Learning Analytics.


6. Kategorisierung


Kerngedanke: Die Studie fokussiert sich auf die umfassende Analyse von Publikations- und Zitationsmustern, um die Entwicklung und die aktuellen Trends im Bereich Learning Analytics zu verstehen und zukünftige Forschungsbedarfe zu identifizieren. (S. 462)


7. Zuordnung zu Forschungsfragen
Passendste Forschungsunterfrage:


FU3: Wie sind Konzeption und relevante didaktische und bildungstechnologische Merkmale des systemisch-konstruktivistischen Learning-Management-Systems für Akteure im digitalen Bildungsraum von Gesundheitsberufen dargestellt?


Begründung: Die Studie befasst sich mit der Analyse von Learning Analytics im Kontext von Bildungssystemen und deren technologischen Merkmalen, was zur Beantwortung dieser Frage beiträgt.




8. Einordnung der Relevanz, Bewertungsskala


Relevanzbewertung: 4 - Relevant: Die Quelle liefert wichtige Informationen, die zur Beantwortung der Forschungsfrage beitragen, insbesondere in Bezug auf die Entwicklung und Anwendung von Learning Analytics in Bildungssystemen.


},
	file = {Sönmez - A Comprehensive Bibliometric Analysis of Learning .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/CH67WAKE/Sönmez - A Comprehensive Bibliometric Analysis of Learning .pdf:application/pdf},
}

@article{jankovski_eyes_2017,
	title = {The {Eyes} {Have} {It}:  {Using} {Eye} {Tracking} {Technology} {To} {Assess}  {The} {Usability} {Of} {Learning} {Management} {Systems}  {In} {Elementary} {Schools}},
	copyright = {Creative Commons Attribution 4.0, Open Access},
	shorttitle = {The {Eyes} {Have} {It}},
	url = {https://zenodo.org/record/1034181},
	doi = {10.5281/ZENODO.1034181},
	abstract = {Twenty-six students from a sixth grade math class in Upstate New York received guardian approval to participate in a study that gathered data pertaining to student navigation ability, information retrieval ability, and satisfaction in regards to the Learning Management System (LMS) their school utilized. Data collection began with the researchers attending math classes for observation and to conduct cognitive walkthroughs with the students to gather information about their experiences and navigation through the LMS. An eye tracker and the associated eye tracking software were utilized to monitor and detect patterns of eye movements when the students were looking at a device screen. For this study, students were monitored by the eye tracker while they attempted to complete several tasks from the experiment. By measuring the length of time taken by students as they completed tasks on the LMS, quantitative data can be collected and used later in the experiment. After analyzing the time metrics and the eye tracking data produced and feedback given on the questionnaire distributed at the beginning of the experiment, a targeted LMS page was slightly modified in hopes to increase the effectiveness of the page, based on user interface design standards. Well defined organization, accessibility, and usability in an LMS is essential to allow learners to focus to be on their curriculums, and not how to access their assignments. An in-depth analysis of navigation through an LMS will allow for a better understanding of how users interact with the structure of their curriculum in an electronic format. The study described in this paper intended to address the question of whether an LMS used in an elementary school setting can provide users with an interface that optimizes the accessibility and usability of their class materials.},
	language = {en-GB},
	urldate = {2024-07-14},
	publisher = {Zenodo},
	author = {Jankovski, Christopher and Schofield, Damian},
	month = oct,
	year = {2017},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Bewertungsmethoden, Promotion:Argumentation, Promotion:Relevanz:4, \#1:Zeitschriftenartikel:learning:management:system, Promotion:01-02, education, Promotion:Eye-Tracking, Promotion:FU1, human computer interaction, learning management systems, usability, Promotion:01-02 Methodenquellen, Promotion:S:01 Learning Management System, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Dissertation {\textbar} FU1 {\textgreater} Argumentation, Promotion:Literaturverzeichnis, Eye-Tracking, Promotion:sec:A-9-FU1},
	annote = {Analyse der Studie "The Eyes Have It: Using Eye Tracking Technology to Assess the Usability of Learning Management Systems in Elementary Schools" von Jankovski und Schofield (2017)
Hauptthemen und Ziele der Forschung:
Die Studie von Jankovski und Schofield (2017) untersucht die Benutzerfreundlichkeit eines Learning Management Systems (LMS) in Grundschulen durch den Einsatz von Eye-Tracking-Technologie. Ziel ist es, die Navigationsfähigkeit, Informationsabruffähigkeit und Zufriedenheit der Schüler zu analysieren, um die Benutzeroberfläche des LMS zu optimieren und den Zugang zu Lehrmaterialien zu verbessern.
Methoden und Datenquellen:


Methoden: Die Studie verwendet Eye-Tracking-Technologie und begleitende Software, um Augenbewegungen der Schüler zu überwachen, während sie Aufgaben auf dem LMS durchführen. Es wurden kognitive Walkthroughs und Fragebögen verwendet, um qualitative Daten über die Benutzererfahrung der Schüler zu sammeln.


Datenquellen: Die Stichprobe umfasste 26 Schüler einer sechsten Klasse in Upstate New York. Die Forscher beobachteten den Unterricht, führten kognitive Walkthroughs durch und sammelten Eye-Tracking-Daten sowie Feedback über Fragebögen.


Zentrale Forschungsergebnisse:


Navigationsfähigkeit: Die Eye-Tracking-Daten zeigten spezifische Muster in den Augenbewegungen der Schüler, die auf Schwierigkeiten bei der Navigation durch das LMS hinwiesen.


Informationsabruf: Schüler benötigten unterschiedlich lange Zeit, um Informationen im LMS zu finden, was auf Verbesserungsmöglichkeiten in der Benutzeroberfläche hinwies.


Zufriedenheit: Die Rückmeldungen aus den Fragebögen deuteten darauf hin, dass die Schüler die Benutzerfreundlichkeit des LMS unterschiedlich wahrnahmen, was die Notwendigkeit von Anpassungen bestätigte.


Optimierung der Benutzeroberfläche: Basierend auf den gesammelten Daten wurden gezielte Anpassungen an der LMS-Benutzeroberfläche vorgenommen, um die Effektivität und Benutzerfreundlichkeit zu erhöhen.


Zusammenfassung
Die Studie analysiert die Benutzerfreundlichkeit eines LMS in Grundschulen mithilfe von Eye-Tracking-Technologie. Die Ergebnisse zeigen, dass spezifische Navigations- und Informationsabrufprobleme bestehen, die durch gezielte Anpassungen der Benutzeroberfläche verbessert werden können. Die Zufriedenheit der Schüler variierte, was die Notwendigkeit einer benutzerzentrierten Optimierung des LMS unterstreicht.
Kernaussagen


Navigationsfähigkeit: Eye-Tracking-Daten zeigten Navigationsprobleme, die auf Optimierungsbedarf hinweisen.


Informationsabruf: Unterschiede in der Zeit, die Schüler benötigten, um Informationen zu finden, weisen auf Verbesserungsmöglichkeiten in der Benutzeroberfläche hin.


Zufriedenheit: Variierende Rückmeldungen zur Benutzerfreundlichkeit des LMS unterstreichen die Notwendigkeit benutzerzentrierter Anpassungen.


Argumentationslinien
Die Autoren argumentieren, dass die Verwendung von Eye-Tracking-Technologie eine effektive Methode ist, um die Benutzerfreundlichkeit eines LMS zu analysieren und gezielte Verbesserungen vorzunehmen. Sie betonen die Bedeutung gut definierter Organisation, Zugänglichkeit und Benutzerfreundlichkeit, um den Schülern zu ermöglichen, sich auf ihre Lerninhalte statt auf die Navigation durch das LMS zu konzentrieren.
Verschlagwortung
Passendste Schlagworte und Begründungen:


Technologieintegration: Die Studie untersucht die Integration von Eye-Tracking-Technologie zur Analyse und Verbesserung eines LMS.


Lehr- und Lerneffektivität: Die Ergebnisse zeigen, wie benutzerzentrierte Anpassungen eines LMS zur Verbesserung der Lehr- und Lerneffektivität beitragen können.


Bewertungsmethoden: Der Einsatz von Eye-Tracking als Bewertungsmethode für die Benutzerfreundlichkeit eines LMS stellt eine innovative Bewertungsmethode dar.


Kategorisierung


Argumentation: Die Studie nutzt Eye-Tracking-Daten und qualitative Rückmeldungen, um zu argumentieren, dass eine benutzerzentrierte Anpassung eines LMS die Benutzerfreundlichkeit und Zufriedenheit der Schüler verbessern kann. Die Ergebnisse werden durch detaillierte Analysen der Augenbewegungen und der Benutzererfahrungen untermauert.


Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU1: Akzeptanz und Nützlichkeit eines LMS im digitalen Bildungsraum.


Begründung: Die Studie analysiert die Akzeptanz und Nützlichkeit eines LMS durch die Schüler und untersucht, wie diese durch gezielte Anpassungen der Benutzeroberfläche verbessert werden können.
Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie untersucht umfassend die Benutzerfreundlichkeit und Nützlichkeit eines LMS in Grundschulen).


Zitierhäufigkeit und Einfluss: 4 (Die Studie ist umfassend und gut zitiert).


Aktualität: 3 (Die Studie ist von 2017 und daher nicht ganz aktuell, aber relevant für das Thema).


Gesamtbewertung: 4.0
Schlussfolgerung
Die Studie zeigt, dass Eye-Tracking-Technologie eine effektive Methode zur Analyse und Verbesserung der Benutzerfreundlichkeit eines LMS ist. Durch gezielte Anpassungen können die Navigationsfähigkeit und die Zufriedenheit der Schüler verbessert werden. Die Ergebnisse bieten wertvolle Einblicke und Empfehlungen für die zukünftige Gestaltung und Implementierung von LMS in Bildungsumgebungen.
},
	file = {Jankovski und Schofield - 2017 - The Eyes Have It  Using Eye Tracking Technology T.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/XYVT5HQE/Jankovski und Schofield - 2017 - The Eyes Have It  Using Eye Tracking Technology T.pdf:application/pdf},
}

@article{kawtar_design_2024,
	title = {Design and {Modeling} of {Educational} {Scenarios} for {Collaborative} {Online} {Learning} {Activities}},
