@article{osten_sind_2023,
	title = {Sind {Live}-{Vorlesungen} ein {Auslaufmodell}? {Eine} {Umfrage} zum {Einfluss} synchroner {Online}- {Vorlesungen} auf die {Wahrnehmung} der {Lehre} und die {Prüfungsergebnisse}},
	volume = {40},
	issn = {2366-5017},
	number = {4},
	journal = {GMS Journal for Medical Education},
	author = {Osten, Jannik and Behrens, Victoria and Behrens, Sadie and Herrler, Andreas and Clarner, Tim},
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Learning Management System (LMS), Bildungstheorien, Promotion:Argumentation, \#1:Zeitschriftenartikel:learning:management:system, Bildung, Krisenreaktion im Bildungsbereich, Wissenschaft, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {10--18},
	annote = {1. Analyse
Die Studie von Osten et al. (2023) analysiert die Wirksamkeit von synchronen Online-Vorlesungen im Vergleich zu traditionellen Live-Vorlesungen im Bereich der medizinischen Ausbildung, speziell in der mikroskopischen Anatomie. Die Forscher untersuchten die Auswirkungen des Vorlesungsformats auf die Wahrnehmung des Kurses, die Motivation der Studierenden und die Prüfungsergebnisse während der COVID-19-Pandemie.
2. Zusammenfassung
Die Studie fand heraus, dass in dem Jahr, in dem Online-Vorlesungen angeboten wurden (2021), die Studierenden eine höhere Motivation aufwiesen, sich mit den Lerninhalten auseinanderzusetzen, und die Qualität der Studienmaterialien besser bewerteten. Zudem gab es weniger Durchfallquoten im Vergleich zu dem Jahr ohne Online-Vorlesungen (2020). Dies deutet darauf hin, dass Online-Vorlesungen effektiv dazu beitragen können, Studierende besser auf Prüfungen vorzubereiten und ihr Lernerlebnis positiv zu beeinflussen.
3. Kernaussagen


Verbesserung der Studienmotivation und -materialbewertung: Die Einführung von Online-Vorlesungen im Jahr 2021 führte zu einer signifikanten Verbesserung in der Wahrnehmung der Studienmaterialien und der Motivation der Studierenden.


Reduktion der Durchfallquoten: Die Durchfallquoten waren im Jahr 2021 signifikant niedriger als im Jahr 2020, was die Effektivität von Online-Vorlesungen unterstreicht.


Bevorzugung von Online-Vorlesungen: Die Studierenden zogen Online-Vorlesungen den traditionellen Vorlesungen vor, insbesondere in einem selbstgesteuerten Lernumfeld.


4. Argumentationslinien


Effektivität von Online-Vorlesungen: Die Studie argumentiert, dass Online-Vorlesungen eine wichtige Rolle dabei spielen können, neue Studierende an das Hochschulniveau anzupassen, insbesondere in einem Fach wie der mikroskopischen Anatomie, das ein hohes Maß an visuellem und konzeptuellem Verständnis erfordert.


Anpassungsfähigkeit des Lehrplans: Es wird die Notwendigkeit hervorgehoben, Lehrpläne flexibel zu gestalten und digitale Technologien einzubeziehen, um die Lehr- und Lernprozesse zu verbessern.


5. Verschlagwortung


Lehr- und Lerneffektivität: Die Studie zeigt, wie Online-Vorlesungen die Effektivität des Lehr- und Lernprozesses verbessern können.


Technologieintegration: Die Integration von digitalen Technologien in den Lehrplan wurde als kritisch für die Verbesserung der Bildungsergebnisse identifiziert.


Krisenreaktion im Bildungsbereich: Die Studie zeigt, wie flexibel Hochschulen auf die COVID-19-Pandemie reagieren können, indem sie digitale Lehrformate implementieren.


Bildungstheorien: Die Ergebnisse unterstützen die Theorie, dass technologiegestütztes Lernen die studentische Einbindung und das Verständnis in komplexen Fächern verbessern kann.


Forschungsansätze: Die Untersuchung bietet ein Beispiel für die Anwendung empirischer Forschungsmethoden zur Bewertung der Wirksamkeit von Lehrstrategien im digitalen Zeitalter.


},
	file = {Osten et al. - 2023 - Sind Live-Vorlesungen einAuslaufmodell EineUmfrag.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/V22NKU8J/Osten et al. - 2023 - Sind Live-Vorlesungen einAuslaufmodell EineUmfrag.pdf:application/pdf},
}

@article{kolski_nutzung_2015,
	title = {Nutzung und {Zukunft} von {Wiki}-{Systemen} in der veterinärmedizinischen {Lehre} – {Eine} {Umfrage} unter {Dozierenden} im deutschsprachigen {Raum}},
	volume = {5},
	issn = {1860-3572},
	abstract = {Objectives: Wiki systems are becoming increasingly important in university teaching. Not much is known about the opinion of lecturers of veterinary medicine regarding the active participation of students in teaching, their opinion on wiki systems and their motivation to use them in courses and to improve the quality of information. The objective of the present study was to evaluate how lecturers of veterinary medicine estimate learning management systems and the production of text or material by students in courses, if they rate wiki systems as an appropriate tool for teaching, if they would use wiki systems for their courses and if they are willing to improve the quality of information.
Methods: The data collection was carried out as an online survey using a five-point Likert scale. Lecturers of veterinary medicine in Germany, Austria and Switzerland were contacted (n=approx. 1700) out of which 139 completed (8.2\%) the survey.
Results: Most lecturers use LMS and consider it to be suitable for providing course material. Half of all respondents indicated that they believe that students achieve greater learning success by developing their own learning material. In courses 23.0\% of their students develop own materials. The majority of lecturers considered wiki systems as an appropriate and complementary tool for teaching (53.6\%). A collection of wiki articles is seen as useful (56.6\%), particularly when experts review the contents. One third of the lecturers would use wiki systems for the creation of material by students, but 82.5\% have not yet used them in teaching. One third is willing to participate in the review of articles with regard to their quality.
Conclusion: The results show that many lecturers are willing to use veterinary wiki systems and that they regard them useful for teaching. According to the opinion of the majority of lecturers, the creation of material by students can lead to greater learning success and wiki systems are suitable for this purpose. We are about to develop strategies to support the implementation of wiki systems into veterinary education and a peer review system supported by lecturers. In a further project the actual learning success provided by the active use of wiki-systems by students will be evaluated.},
	language = {de-DE},
	number = {2},
	journal = {GMS Journal for Medical Education},
	author = {Kolski, Darius and {Wolfgang Heuwieser} and Arlt, Sebastian},
	year = {2015},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Kollaboratives Lernen, Promotion:Kerngedanke, Technologieintegration, Bewertungsmethoden, \#1:Zeitschriftenartikel:learning:management:system, Datenschutz und IT-Sicherheit, Bildung, Multimedia, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {8--15},
	annote = {1. Analyse
Die Studie von Kolski et al. (2015) untersucht die Nutzung und zukünftige Potenziale von Wiki-Systemen in der veterinärmedizinischen Ausbildung. Die Autoren haben eine Umfrage unter Dozierenden im deutschsprachigen Raum durchgeführt, um Einstellungen gegenüber Wiki-Systemen zu erkunden, insbesondere im Hinblick auf die aktive Beteiligung der Studierenden bei der Erstellung von Lerninhalten.
2. Zusammenfassung
Die Ergebnisse der Umfrage zeigen, dass viele Dozierende bereit sind, Wiki-Systeme in der Lehre zu verwenden und diese als nützlich betrachten. Die Studie hebt hervor, dass Wiki-Systeme die aktive Beteiligung der Studierenden fördern und als ergänzendes Instrument zur bestehenden Lehrinfrastruktur dienen können. Es wird auch festgestellt, dass eine Herausforderung in der Qualitätssicherung der von Studierenden erstellten Inhalte liegt.
3. Kernaussagen


Bereitschaft zur Nutzung: Viele Dozierende sind offen für den Einsatz von Wiki-Systemen und sehen deren Nutzen in der Lehre (S. 10).


Aktive Beteiligung und Lernerfolg: Die Mehrheit der Dozierenden glaubt, dass die aktive Beteiligung der Studierenden durch das Erstellen von Inhalten den Lernerfolg steigert (S. 11).


Qualitätssicherung: Ein Drittel der Dozierenden äußert Bedenken hinsichtlich der Qualität der Informationen in Wiki-Systemen, wobei eine starke Präferenz für eine Überprüfung durch Experten vor der Veröffentlichung besteht (S. 12).


4. Argumentationslinien


Förderung kollaborativen Lernens: Wiki-Systeme werden als effektives Werkzeug gesehen, um kollaboratives und aktives Lernen zu fördern.


Herausforderungen und Lösungsansätze: Die Qualitätssicherung stellt eine Herausforderung dar, die durch strukturierte Überprüfungsprozesse und möglicherweise durch peer-reviews angegangen werden kann.


5. Verschlagwortung


Kollaboratives Lernen: Die Studie betont die Bedeutung von Wiki-Systemen zur Förderung kollaborativen Lernens.


Technologieintegration: Die Integration von Wiki-Systemen in die Lehrpraxis zeigt die zunehmende Verschmelzung von Technologie und Bildung.


Bewertungsmethoden: Die Notwendigkeit, effektive Bewertungsmethoden für von Studierenden erstellte Inhalte zu entwickeln, wird hervorgehoben.


Forschungsansätze: Die Umfrage selbst sowie die geplante weitere Forschung zu den Auswirkungen der Nutzung von Wiki-Systemen bieten einen methodologischen Rahmen für zukünftige Bildungsforschung.


Datenschutz und IT-Sicherheit: Die Bedenken bezüglich der Informationsqualität in Wiki-Systemen heben die Notwendigkeit hervor, Datenschutz und Sicherheit in digitalen Lernumgebungen zu gewährleisten.


Diese Analyse zeigt, dass Wiki-Systeme ein vielversprechendes Werkzeug für die veterinärmedizinische Bildung sein können, wobei die Herausforderungen der Qualitätssicherung und die aktive Beteiligung der Lernenden wichtige Aspekte sind.
},
	file = {Kolski et al. - 2015 - Nutzung und Zukunft von Wiki-Systemen in der veter.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/AUNXLUYY/Kolski et al. - 2015 - Nutzung und Zukunft von Wiki-Systemen in der veter.pdf:application/pdf},
}

@article{srikesavan_web-based_2017,
	title = {A {Web}-{Based} {Training} {Resource} for {Therapists} to {Deliver} an {Evidence}-{Based} {Exercise} {Program} for {Rheumatoid} {Arthritis} of the {Hand} ({iSARAH}): {Design}, {Development}, and {Usability} {Testing}},
	volume = {19},
	url = {http://www.jmir.org/2017/12/e411/},
	doi = {10.2196/jmir.8424},
	abstract = {Background: The Strengthening and Stretching for Rheumatoid Arthritis of the Hand (SARAH) is a tailored, progressive exercise program for people having difficulties with wrist and hand function due to rheumatoid arthritis (RA). The program was evaluated in a large-scale clinical trial and was found to improve hand function, was safe to deliver, and was cost-effective. These findings led to the SARAH program being recommended in the UK National Institute for Health and Care Excellence guidelines for the management of adults with RA. To facilitate the uptake of this evidence-based program by clinicians, we proposed a Web-based training program for SARAH (iSARAH) to educate and train physiotherapists and occupational therapists on delivering the SARAH program in their practice. The overall iSARAH implementation project was guided by the 5 phases of the analysis, design, development, implementation, and evaluation (ADDIE) system design model. Objective: The objective of our study was to conduct the first 3 phases of the model in the development of the iSARAH project. Methods: Following publication of the trial, the SARAH program materials were made available to therapists to download from the trial website for use in clinical practice. A total of 35 therapists who downloaded these materials completed an online survey to provide feedback on practice trends in prescribing hand exercises for people with RA, perceived barriers and facilitators to using the SARAH program in clinical practice, and their preferences for the content and Web features of iSARAH. The development and design of iSARAH were further guided by a team of multidisciplinary health professionals (n=17) who took part in a half-day development meeting. We developed the preliminary version of iSARAH and tested it among therapists (n=10) to identify and rectify usability issues and to produce the final version. Results: The major recommendations made by therapists and the multidisciplinary team were having a simple Web design and layout, clear exercise pictures and videos, and compatibility of iSARAH on various browsers and devices. We rectified all usability issues in the preliminary version to develop the final version of iSARAH, which included 4 short modules and additional sections on self-assessment, frequently asked questions, and a resource library. Conclusions: The use of the ADDIE design model and engagement of end users in the development and evaluation phases have rendered iSARAH a convenient, easy-to-use, and effective Web-based learning resource for therapists on how to deliver the SARAH program. There is also huge potential for adapting iSARAH across different cultures and languages, thus opening more opportunities for wider uptake and application of the SARAH program into practice.},
	number = {12},
	journal = {J Med Internet Res},
	author = {Srikesavan, Swarnalatha Cynthia and Williamson, Esther and Eldridge, Lucy and Heine, Peter and Adams, Jo and Cranston, Tim and Lamb, E. Sarah},
	month = dec,
	year = {2017},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, \#1:Zeitschriftenartikel:learning:management:system, Bildung, Multimedia, implementation, rheumatoid arthritis, hand exercises, hand function, online training, Promotion:S:01 Learning Management System, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {e411},
	annote = {1. Analyse
Die Studie von Srikesavan et al. (2017) beschreibt die Entwicklung und Usability-Testing eines webbasierten Trainingsprogramms (iSARAH), das darauf abzielt, Therapeuten in der Auslieferung eines evidenzbasierten Übungsprogramms für rheumatoide Arthritis der Hand zu schulen. Das Programm verwendet das ADDIE-Modell (Analyse, Design, Entwicklung, Implementierung, Evaluation) für dessen Entwicklung.
2. Zusammenfassung
iSARAH wurde entwickelt, um Therapeuten durch eine Online-Plattform auszubilden, die multimodales Lernen unterstützt. Dies umfasst Textmaterialien, Multimedia und Bewertungen. Durch Benutzerfeedback und iterative Designanpassungen wurde die endgültige Version von iSARAH geschaffen, die eine benutzerfreundliche, effektive Schulungsressource bietet.
3. Kernaussagen


Benutzerzentriertes Design: Feedback von Therapeuten und multidisziplinären Teams wurde genutzt, um die Benutzerfreundlichkeit und das Design von iSARAH zu optimieren.


Effektivität und Zugänglichkeit: iSARAH wurde als effektives Werkzeug zur Schulung von Therapeuten bewertet, wobei dessen Zugänglichkeit durch Web-basierte Technologie erhöht wird.


Potential für breite Anwendung: iSARAH hat das Potenzial, über verschiedene Kulturen und Sprachen hinweg angepasst und angewendet zu werden.


4. Argumentationslinien


Wichtigkeit der benutzerzentrierten Entwicklung: Die Einbeziehung von Endnutzern ist entscheidend für die Entwicklung effektiver Bildungsressourcen.


Technologie als Brücke im Wissenstransfer: Die Verwendung von Online-Plattformen kann effektiv Barrieren in der Wissensvermittlung überwinden und breitere Zugänglichkeit ermöglichen.


5. Verschlagwortung


Technologieintegration: Anwendung moderner Technologien zur Unterstützung der Bildung.


Lehr- und Lerneffektivität: Verbesserung der Fähigkeiten und des Wissens der Therapeuten durch strukturiertes Online-Lernen.


Systemanpassung: Anpassung des Schulungsprogramms an unterschiedliche Benutzerbedürfnisse und -umgebungen.


6. Kategorisierung


Transformation: iSARAH transformiert die Art und Weise, wie Schulungen für Therapeuten durchgeführt werden, indem es digitale Technologien nutzt, um effektivere und zugänglichere Lernmethoden bereitzustellen.


Kerngedanke: Der Kerngedanke von iSARAH liegt in seiner Fähigkeit, evidenzbasierte Übungsprogramme effizient an Therapeuten zu vermitteln und deren Implementierung in die Praxis zu erleichtern.


},
	file = {Srikesavan et al. - 2017 - A Web-Based Training Resource for Therapists to De.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/9QKMF8WJ/Srikesavan et al. - 2017 - A Web-Based Training Resource for Therapists to De.pdf:application/pdf},
}

@article{zhang_game_2021,
	title = {Game {Experience} and {Learning} {Effects} of a {Scoring}-{Based} {Mechanic} for {Logistical} {Aspects} of {Pediatric} {Emergency} {Medicine}: {Development} and {Feasibility} {Study}},
	volume = {9},
	url = {https://games.jmir.org/2021/1/e21988},
	doi = {10.2196/21988},
	abstract = {Background: Using serious games for learning in operations management is well established. However, especially for logistics skills in health care operations, there is little work on the design of game mechanics for learning engagement and the achievement of the desired learning goals. Objective: This contribution presents a serious game design representing patient flow characteristics, systemic resource configurations, and the roles of the players based on a real Swedish emergency ward. The game was tested in a set of game-based learning practices in the modalities of a physical board game and an online multiplayer serious game that implemented the same game structure. Methods: First, survey scores were collected using the Game Experience Questionnaire Core and Social Presence Modules to evaluate the experience and acceptance of the proposed design to gamify real processes in emergency care. Second, lag sequential analysis was applied to analyze the impact of the game mechanics on learning behavior transitions. Lastly, regression analysis was used to understand whether learning engagement attributes could potentially serve as significant predicting variables for logistical performance in a simulated learning environment. Results: A total of 36 students from courses in engineering and management at KTH Royal Institute of Technology participated in both game-based learning practices during the autumn and spring semesters of 2019 and 2020. For the Core Module, significant differences were found for the scores for negative affect and tension compared with the rest of the module. For the Social Presence Module, significant differences were found in the scores for the psychological involvement ? negative feelings dimension compared with the rest of the module. During the process of content generation, the participant had access to circulating management resources and could edit profiles. The standard regression analysis output yielded a ?R2 of 0.796 (F14,31=2725.49, P{\textless}.001) for the board version and 0.702 (F24,31=2635.31, P{\textless}.001) for the multiplayer online version after the learning engagement attributes. Conclusions: The high scores of positive affect and immersion compared to the low scores of negative feelings demonstrated the motivating and cognitive involvement impact of the game. The proposed game mechanics have visible effects on significant correlation parameters between the majority of scoring features and changes in learning engagement attributes. Therefore, we conclude that for enhancing learning in logistical aspects of health care, serious games that are steered by well-designed scoring mechanisms can be used.},
	number = {1},
	journal = {JMIR Serious Games},
	author = {Zhang, Cevin and Baalsrud Hauge, Jannicke and Härenstam, Pukk Karin and Meijer, Sebastiaan},
	month = mar,
	year = {2021},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Weiterführung, \#1:Zeitschriftenartikel:learning:management:system, Bildung, Multimedia, Krisenreaktion im Bildungsbereich, Lernsystemarchitektur, serious game, experience, learning engagement, emergency department, learning behavior transition, logistical performance, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {e21988},
	annote = {1. Analyse
Hauptthemen und -ziele der Forschung: Die Studie untersucht die Lerneffekte und Spielerfahrungen eines Scoring-basierten Spielsystems, das in der Ausbildung für logistische Aspekte der pädiatrischen Notfallmedizin eingesetzt wird. Ziel ist es, zu analysieren, wie das Spiel die Lernbeteiligung und das Engagement der Spieler beeinflusst und welche Auswirkungen dies auf die Leistung hat (S. 2).
Verwendete Methoden und Datenquellen: Die Methode umfasst die Verwendung eines spielbasierten Ansatzes, bei dem die Teilnehmer in einem simulierten Notfallumfeld Aufgaben lösen müssen. Die Spieleraktivitäten und Entscheidungen wurden über ein spezifisches Punktesystem bewertet, das Feedback zu logistischen Entscheidungen liefert (S. 4).
Zentrale Forschungsergebnisse: Es wurde festgestellt, dass das Scoring-System signifikant positive Auswirkungen auf die Lernengagement-Merkmale der Spieler hatte und zu einer erhöhten Motivation und Beteiligung führte. Die Ergebnisse zeigen, dass solche Spielmechanismen effektiv eingesetzt werden können, um Lernprozesse in komplexen und stressigen Umgebungen wie der Notfallmedizin zu unterstützen (S. 6).
2. Zusammenfassung
Die Studie von Zhang et al. belegt die Wirksamkeit von spielbasierten Lernmethoden, speziell durch die Anwendung eines Scoring-Systems, das eng mit den logistischen Abläufen einer pädiatrischen Notfallabteilung verbunden ist. Die Ergebnisse unterstreichen, dass derartige Ansätze nicht nur das Engagement und die Motivation der Lernenden steigern, sondern auch deren Leistungsfähigkeit in simulationsbasierten Lernumgebungen verbessern können.
3. Kernaussagen


Positiver Einfluss auf Lernengagement: Das Scoring-System steigerte die Lernbeteiligung und die Motivation der Spieler signifikant (S. 6).


Verbesserung der logistischen Leistung: Die Spieler zeigten verbesserte Leistungen in den logistischen Aspekten des Spiels, was auf die effektive Anwendung des Punktesystems zurückzuführen ist (S. 10).


Anwendung in der Notfallmedizin: Das Spiel demonstriert die Anwendbarkeit von Serious Games in der Ausbildung von medizinischem Personal, insbesondere in der Notfallmedizin (S. 5).


4. Argumentationslinien
Die Studie argumentiert, dass das Design von Serious Games, insbesondere solche, die ein durchdachtes Scoring-System integrieren, das Engagement und die Lernleistung in komplexen Bildungsbereichen wie der Notfallmedizin signifikant verbessern kann. Die Forscher betonen die Bedeutung der direkten Rückmeldung durch das Spiel, welche es den Spielern ermöglicht, ihre Entscheidungen und Handlungen in Echtzeit zu überprüfen und anzupassen.
5. Verschlagwortung


Lernsystemarchitektur: Das Design des Spiels zeigt eine innovative Anwendung von Spielmechaniken zur Förderung des Lernens in komplexen Umgebungen.


Lehr- und Lerneffektivität: Die effektive Nutzung des Scoring-Systems zur Steigerung des Engagements und der Leistung der Spieler unterstreicht die hohe Lehr- und Lerneffektivität des Ansatzes.


Technologieintegration: Die Integration von Serious Games in die medizinische Ausbildung zeigt, wie Technologien effektiv zur Verbesserung der Bildung eingesetzt werden können.


Krisenreaktion im Bildungsbereich: Das Spiel wird als Trainingswerkzeug für Notfallsituationen in der Medizin eingesetzt, was seine Rolle als Krisenreaktionsinstrument unterstreicht.


Systemanpassung: Die Anpassungsfähigkeit des Spiels an spezifische Bildungsbedürfnisse in der Notfallmedizin demonstriert, wie flexible Bildungssysteme aufgebaut und genutzt werden können.


},
	file = {Zhang et al. - 2021 - Game Experience and Learning Effects of a Scoring-.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/YDSKFU8Z/Zhang et al. - 2021 - Game Experience and Learning Effects of a Scoring-.pdf:application/pdf},
}

@article{lang_legal_2021,
	title = {Legal and {Ethical} {Considerations} for the {Design} and {Use} of {Web} {Portals} for {Researchers}, {Clinicians}, and {Patients}: {Scoping} {Literature} {Review}},
	volume = {23},
	url = {https://www.jmir.org/2021/11/e26450},
	doi = {10.2196/26450},
	abstract = {Background: This study aims to identify a novel potential use for web portals in health care and health research: their adoption for the purposes of rapidly sharing health research findings with clinicians, scientists, and patients. In the era of precision medicine and learning health systems, the translation of research findings into targeted therapies depends on the availability of big data and emerging research results. Web portals may work to promote the availability of novel research, working in tandem with traditional scientific publications and conference proceedings. Objective: This study aims to assess the potential use of web portals, which facilitate the sharing of health research findings among researchers, clinicians, patients, and the public. It also summarizes the potential legal, ethical, and policy implications associated with such tools for public use and in the management of patient care for complex diseases. Methods: This study broadly adopts the methods for scoping literature reviews outlined by Arskey and O?Malley in 2005. Raised by the integration of web portals into patient care for complex diseases, we systematically searched 3 databases, PubMed, Scopus, and WestLaw Next, for sources describing web portals for sharing health research findings among clinicians, researchers, and patients and their associated legal, ethical, and policy challenges. Of the 719 candidate source citations, 22 were retained for the review. Results: We found varied and inconsistent treatment of web portals for sharing health research findings among clinicians, researchers, and patients. Although the literature supports the view that portals of this kind are potentially highly promising, they remain novel and are not yet widely adopted. We also found a wide range of discussions on the legal, ethical, and policy issues related to the use of web portals to share research data. Conclusions: We identified 5 important legal and ethical challenges: privacy and confidentiality, patient health literacy, equity, training, and decision-making. We contend that each of these has meaningful implications for the increased integration of web portals into clinical care.},
	number = {11},
	journal = {J Med Internet Res},
	author = {Lang, Michael and Lemieux, Sébastien and Hébert, Josée and Sauvageau, Guy and Zawati, H. Ma'n},
