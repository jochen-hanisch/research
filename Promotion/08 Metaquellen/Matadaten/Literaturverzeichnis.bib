@article{duffy_online_2023,
	title = {An online case-based teaching and assessment program on clinical history-taking skills and reasoning using simulated patients in response to the {COVID}-19 pandemic},
	volume = {23},
	issn = {1472-6920},
	url = {https://bmcmededuc.biomedcentral.com/articles/10.1186/s12909-022-03950-2},
	doi = {10/gs569v},
	abstract = {Background:  The COVID-19 pandemic has created unprecedented challenges for medical students and educators worldwide. Groups 1, 2 and 3 of year 3, semester 2 medical students at the Royal College of Surgeons in Ireland (n = 275) had only completed 2, 5 and 7 weeks, respectively, of their scheduled 10-week clinical medicine and surgery attachments, prior to the Irish shutdown of all in-person non-essential activities, including medical student education.
Methods:  We developed and delivered an online case-based program, focused on history-taking skills and clinical reasoning, using simulated patients and video technologies. 12 tutorials were delivered over 6 weeks to 35 subgroups of 8 students in line with program learning outcomes. Both simulated patients (n = 36), and tutors (n = 45, from retired clinical professors to newly graduated physicians), were rapidly upskilled in Blackboard Collaborate and Microsoft Teams, and also in the provision of constructive feedback. We evaluated this newly developed program by the following three criteria: student attendance, achieved grades, and student feedback.
Results:  Attendance at the 12 tutorials was higher amongst group 1 and 2 students (75 and 73\%) by comparison with group 3 students (60\%) (p = {\textless} 0.001). Of the 273 students that sat the Year 3 Semester 2 online long case assessment, 93\% were successful. Despite group 1 students having the least prior clinical experience, results were similar to those of groups 2 and 3 (1st honors, 2nd honors, pass, and fail grades for group 1, 39\%, 33\%, 23\% and 6\%; group 2, 34\%, 41\%, 17\% and 8\%; group 3, 39\%, 25\%, 28\% and 7\%) (p = 0.48). An increased attendance rate at tutorials was associated with higher numbers of honors grades (p = {\textless} 0.001). Anonymous feedback from the students demonstrated considerable satisfaction with program: {\textgreater} 85\% agreed that the online program was interactive and very educational.
Conclusions:  Use of online video technology, tutors of varied experience, and simulated patients were demonstrated to replicate patient encounters, and to facilitate the development of clinical skills remotely during the COVID19 pandemic.},
	language = {en-GB},
	number = {1},
	urldate = {2023-11-18},
	journal = {BMC Medical Education},
	author = {Duffy, Barbara and Tully, Roisin and Stanton, Alice V.},
	month = jan,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:FU4a, Promotion:Weiterführung, Bildungstechnologie, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {4},
	file = {Duffy et al. - 2023 - An online case-based teaching and assessment progr.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/SXR6CIS9/Duffy et al. - 2023 - An online case-based teaching and assessment progr.pdf:application/pdf},
}

@article{goble_development_2023,
	title = {Development and evaluation of an online surgical elective for medical students},
	volume = {23},
	issn = {1472-6920},
	url = {https://bmcmededuc.biomedcentral.com/articles/10.1186/s12909-023-04180-w},
	doi = {10/gs567f},
	abstract = {Background  Decreased experiential learning opportunities exacerbated by the COVID-19 pandemic have increased development of online surgical educational courses. To what extent may such courses provide exposure to broad and accessible surgical education?
Methods  Surge is a 6-week online surgical elective hosted within a virtual learning environment, covering all surgical specialties. Course content is mapped to the Royal College of Surgeons’ Undergraduate Curriculum in Surgery. Each week consultant surgeons discuss their specialty in short videos on anatomy, pathology and lifestyle of a surgeon. Students also engage with learning activities; further reading lists; formative quizzes and live sessions including suturing practice. Participants were medical students undertaking third-year electives at the University of Sheffield. Pre- and post-course questionnaires investigated student interest in surgery, understanding of steps required to pursue a surgical career and confidence in surgical environments. Qualitative data was collected via free-text responses and analysed with content analysis. Quantitative data was collected using 5-point Likert scales (1 = Strongly Disagree; 5 = Strongly Agree) and analysed using the Wilcoxon signed-rank test.
Results  Twenty-two students participated in Surge over five 6-week cohorts. Examination of free-text responses revealed students gained increased understanding of available surgical career options. Students felt better informed regarding different surgical specialties (median score 2.5 vs. 4, p = 0.000) and steps required to develop a surgical portfolio (median score 2 vs. 5, p = 0.000). Additionally, confidence in understanding of relevant intraoperative steps improved (median score 3 vs. 4, p = 0.000).
Conclusion  These data demonstrate Surge increased student confidence and understanding of surgical careers despite reduced in-person opportunities to engage with surgical education. Surge will continue to be developed and evaluated on a larger scale.},
	language = {en-GB},
	number = {1},
	urldate = {2023-11-18},
	journal = {BMC Medical Education},
	author = {Goble, Mary and Chapman, Neil},
	month = apr,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:FU4a, Technologieintegration, Bewertungsmethoden, Promotion:Relevanz:4, Promotion:Schlussfolgerung, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {254},
	annote = {Analyse der Studie "Development and Evaluation of an Online Surgical Elective for Medical Students" von Goble \& Chapman (2023)

1. Hauptthemen und Ziele der Forschung
Die Studie untersucht die Entwicklung und Evaluation des Online-Kurses Surge, einer sechswöchigen chirurgischen Online-Elektive für Medizinstudierende. Das zentrale Ziel ist es, herauszufinden, inwieweit der Kurs Studierenden eine breite und zugängliche chirurgische Ausbildung bietet, insbesondere vor dem Hintergrund eingeschränkter klinischer Praktika während der COVID-19-Pandemie. Neben der Vermittlung von Fachwissen soll der Kurs das Interesse an chirurgischen Karrieren steigern, das Vertrauen der Studierenden im Operationsumfeld erhöhen und die Möglichkeiten zur Karriereplanung im chirurgischen Bereich verbessern.

2. Methoden und Datenquellen


Design: Evaluationsstudie mit qualitativen und quantitativen Methoden.


Datenquellen:


Fragebögen (prä- und post-Kurs, 5-Punkte-Likert-Skala).


Freitextantworten zur qualitativen Analyse der Kurserfahrungen.


Retentionstest bei einer Subgruppe zur Überprüfung des Lernfortschritts.




Analysen:


Quantitative Analyse mittels Wilcoxon Signed-Rank Test.


Qualitative Inhaltsanalyse zur Interpretation von Studierendenkommentaren.




Stichprobe: 26 Medizinstudierende in fünf Kohorten; 22 vollständige Datensätze für die Analyse.



3. Zentrale Forschungsergebnisse


Erhöhte informierte Karriereentscheidungen:


Studierende fühlten sich signifikant besser informiert über chirurgische Spezialgebiete (Median 2,5 vs. 4, p = 0,000).


Die Kenntnis über den Aufbau eines chirurgischen Karriereportfolios verbesserte sich erheblich (Median 2 vs. 5, p = 0,000).




Veränderung der Einstellung zur Chirurgie:


Die generelle Interessenssteigerung an einer chirurgischen Karriere war signifikant (Median 3,5 vs. 4, p = 0,03).


Die wahrgenommenen Möglichkeiten zur Erkundung von Karriereoptionen verbesserten sich (Median 3 vs. 4, p = 0,05).




Erhöhte Selbstsicherheit in chirurgischen Umgebungen:


Studierende fühlten sich sicherer im Gespräch mit Chirurg*innen (Median 3 vs. 4, p = 0,001).


Das Verständnis operativer Abläufe nahm signifikant zu (Median 3 vs. 4, p = 0,000).




Online-Lernen als Ergänzung:


Die Studierenden bewerteten Online-Kurse als geeignet für die Entwicklung eines chirurgischen Interesses (p = 0,008).


Keine signifikante Veränderung in der Einschätzung, dass Online-Kurse Präsenzlernen ersetzen können (p = 0,655).




Keine Verbesserung bei praktischen Fertigkeiten:


Keine signifikante Veränderung der Sicherheit beim Assistieren im OP (p = 0,09).


Suturierübungen wurden nicht als besonders wertvoll erachtet.





4. Kernaussagen (mit Fundstellen)


„Surge increased student confidence and understanding of surgical careers despite reduced in-person opportunities.“ (S. 1)


„Students felt better informed regarding different surgical specialties and the steps required to develop a surgical portfolio.“ (S. 3)


„A major effect of the course was that students agreed to feeling better informed regarding surgical specialties (median score 2.5 vs. 4, p = 0.000).“ (S. 4)


„Despite the opportunity to practice their suturing skills, students did not highlight this as a particularly valuable addition to the course.“ (S. 5)



5. Argumentationslinien


Digitale Plattformen als effektive Ergänzung zur chirurgischen Ausbildung:


Surge konnte die Zugänglichkeit zur chirurgischen Ausbildung verbessern, insbesondere unter pandemiebedingten Einschränkungen. (S. 3-4)




Karriereförderung durch Online-Interaktion mit Experten:


Das Kursformat ermöglichte direkte Interaktionen mit Chirurg*innen und förderte das Verständnis chirurgischer Karrierewege. (S. 3)




Mentorship in virtuellen Lernumgebungen:


Studierende empfanden die Interviews mit Chirurg*innen als wertvolle Möglichkeit zur virtuellen Mentorship. (S. 5)




Limitationen der praktischen Ausbildung:


Trotz Online-Suturierübungen ergab sich keine signifikante Verbesserung der Assistenzfähigkeiten im OP. (S. 5)





6. Verschlagwortung


Technologieintegration – Nutzung von Moodle zur Organisation eines chirurgischen Online-Kurses.


Lehr- und Lerneffektivität – Messung des Lernerfolgs durch prä- und post-Kurs-Fragebögen.


Bewertungsmethoden – Einsatz der Wilcoxon Signed-Rank Tests zur Analyse von Studierendenantworten.


Kollaboratives Lernen – Interaktion mit Chirurg*innen durch Live-Sessions und Video-Interviews.


Forschungsansätze – Kombination von qualitativen und quantitativen Methoden zur Evaluation eines LMS.



7. Kategorisierung
Kategorie: Schlussfolgerung


Surge verbessert die chirurgische Ausbildung, indem es eine niedrigschwellige, digitale Alternative zur traditionellen chirurgischen Ausbildung bereitstellt. Die Studie belegt, dass Online-Kurse Interesse an chirurgischen Karrieren fördern, jedoch die praktische Ausbildung nicht vollständig ersetzen können. (S. 5-6)



8. Zuordnung zur Forschungsfrage
Passendste Forschungsunterfrage:


FU4a: Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?


Begründung: Die Studie analysiert, wie ein digitales chirurgisches Lernsystem das Wissen, das Vertrauen und die Karriereplanung von Studierenden beeinflusst.



9. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 4 (Starke methodische und inhaltliche Relevanz, jedoch nicht spezifisch für Gesundheitsberufe).


Zitierhäufigkeit und Einfluss: 3 (Neue Studie, begrenzte Anzahl an Zitaten).


Aktualität: 5 (Publikation von 2023, hoher Bezug zu aktuellen Entwicklungen).


Gesamtbewertung: 4 (Relevant)

10. Schlussfolgerung
Die Studie zeigt, dass digitale chirurgische Lernplattformen eine wirksame Ergänzung zur traditionellen Ausbildung sein können, indem sie Studierende in einem flexiblen, zugänglichen Format auf chirurgische Karrieren vorbereiten. Surgekonnte Wissen und Vertrauen in chirurgische Fachgebiete stärken, jedoch die praktische Ausbildung nicht vollständig ersetzen. Weitere Forschung ist erforderlich, um die langfristige Wirkung solcher Programme zu validieren.
},
