@article{chairuddin_utilization_2024,
	title = {Utilization of {Quiz} {Kreator} in {Student} {Achievement} {Assessment} in {Elementary} {School}},
	volume = {2},
	copyright = {https://creativecommons.org/licenses/by-sa/4.0},
	issn = {3030-8372, 3026-7102},
	url = {https://journal.ypidathu.or.id/index.php/ijlul/article/view/975},
	doi = {10.70177/ijlul.v2i2.975},
	abstract = {Background. The world of education is inseparable from various learning components. The utilization of technology cannot be separated from the world of education. One of them is the use of Quiz Kreator for student achievement assessment in elementary schools. Quiz Kreator is one of the online applications used to create quizzes, including multiple choice quizzes and true false quizzes.
Purpose. This study aims to determine how student achievement in elementary schools after using the Quiz Kreator application in the learning process.
Method. The researcher used quantitative research methods, namely by distributing questionnaires to elementary school students. The questionnaire was distributed online.
Results. The results showed that the use of Quiz Kreator in assessing student achievement in elementary schools has a positive impact on students. The use of Quiz Kreator as an assessment tool that is well designed and relevant to the material being taught, can improve student achievement. Quiz Kreator can provide assessment results automatically and accurately. This can also help teachers in assessing student achievement more objectively.
Conclusion. the use of Quiz Kreator in assessing student achievement in elementary schools can be utilized well. The use of this Quiz Kreator application can improve student achievement in the learning process.},
	language = {en-GB},
	number = {2},
	urldate = {2024-08-24},
	journal = {International Journal of Language and Ubiquitous Learning},
	author = {Chairuddin, Chairuddin and Hidayat, Rahmat and Nasruddin, Nasruddin and Kadayloding, Kamaruddeen and Toepak, Erwin Prasetya},
	month = aug,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Technologieintegration, Promotion:Argumentation, Promotion:Relevanz:4, Promotion:FU3, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU3},
	pages = {314--326},
	annote = {Analyse der Studie "Utilization of Quiz Kreator in Student Achievement Assessment in Elementary School" von Chairuddin et al. (2024)
1. Hauptthemen und Ziele der Forschung
Die Studie von Chairuddin et al. untersucht den Einsatz der Anwendung "Quiz Kreator" zur Bewertung der Schülerleistungen in Grundschulen. Das Hauptziel der Forschung ist es, herauszufinden, wie sich die Nutzung dieser digitalen Plattform auf die Lernergebnisse der Schüler auswirkt und ob sie eine effektive Methode zur Leistungsbewertung darstellt.
2. Methoden und Datenquellen
Die Studie verwendet einen quantitativen Forschungsansatz. Daten wurden durch Online-Fragebögen erhoben, die an Grundschüler in Kolaka, Indonesien, verteilt wurden. Die Fragebögen umfassten Fragen zur Nutzung des Quiz Kreator, zur Zufriedenheit der Schüler mit dem Tool und zu deren Wahrnehmung des Einflusses auf ihre schulischen Leistungen. Die gesammelten Daten wurden statistisch analysiert, um die Auswirkungen der Anwendung auf die Leistung der Schüler zu bestimmen.
3. Zentrale Forschungsergebnisse


Positive Auswirkungen auf die Schülerleistungen: Die Ergebnisse zeigen, dass die Verwendung des Quiz Kreator die Schülerleistungen positiv beeinflusst hat. Die Anwendung erleichtert es den Schülern, ihre Lernergebnisse sofort zu sehen, was ihre Motivation und ihr Engagement im Lernprozess erhöht.


Verbesserung der Bewertungsgenauigkeit: Lehrer berichteten, dass der Quiz Kreator eine präzise und schnelle Auswertung der Schülerleistungen ermöglicht, was die Objektivität und Effizienz der Bewertung verbessert.


Nutzerfreundlichkeit und Akzeptanz: Sowohl Lehrer als auch Schüler empfanden die Nutzung des Quiz Kreator als benutzerfreundlich und hilfreich im Unterrichtsprozess. Besonders hervorgehoben wurde die einfache Handhabung und die unmittelbare Rückmeldung durch das Tool.


4. Zusammenfassung
Die Studie zeigt, dass der Einsatz des Quiz Kreator in der Grundschule eine wirksame Methode zur Leistungsbewertung darstellt. Die positiven Rückmeldungen von Schülern und Lehrern unterstreichen das Potenzial dieser Technologie, das Lernen zu unterstützen und die Bewertung von Schülerleistungen zu optimieren.
5. Kernaussagen


Steigerung der Schülerleistungen: "The use of Quiz Kreator has significantly improved student achievement in elementary schools by providing instant feedback and engaging students in the learning process." (S. 319)


Erleichterung der Lehrtätigkeit: "Teachers found that Quiz Kreator simplifies the assessment process, making it easier to evaluate student performance accurately." (S. 320)


6. Argumentationslinien
Die Autoren argumentieren, dass digitale Tools wie der Quiz Kreator eine wertvolle Ergänzung zum traditionellen Unterricht darstellen. Sie betonen, dass solche Technologien nicht nur die Schülerleistungen verbessern, sondern auch die Lehrtätigkeit erleichtern und objektivieren können. Allerdings wird auch darauf hingewiesen, dass die erfolgreiche Integration solcher Tools in den Unterricht von der Anpassung der Lehrmethoden und der Schulung der Lehrkräfte abhängt.
7. Verschlagwortung


Technologieintegration: Die Studie untersucht, wie der Quiz Kreator in den Unterricht integriert werden kann, um die Lern- und Bewertungsprozesse zu verbessern.


Lehr- und Lerneffektivität: Es wird analysiert, wie die Nutzung von digitalen Tools wie dem Quiz Kreator die Effektivität des Unterrichts steigern kann.


Bewertungsmethoden: Die Studie beleuchtet die Auswirkungen des Quiz Kreator auf die Genauigkeit und Objektivität der Leistungsbewertung von Schülern.


Systemanpassung: Diskutiert wird, wie das Schulsystem an den Einsatz solcher digitalen Werkzeuge angepasst werden kann, um den größtmöglichen Nutzen zu erzielen.


8. Kategorisierung: Argumentation
Argumentation: Die Studie stellt die Vorteile und Herausforderungen der Integration von Quiz Kreator in den Schulalltag dar. Die Autoren argumentieren, dass die Technologie sowohl die Leistungsbewertung verbessern als auch das Engagement der Schüler fördern kann. Gleichzeitig wird auf die Notwendigkeit hingewiesen, Lehrkräfte entsprechend zu schulen und die Lehrmethoden anzupassen, um die Vorteile vollständig nutzen zu können.
9. Zuordnung zur passenden Forschungsunterfrage
FU3: Wie sind Konzeption und relevante didaktische und bildungstechnologische Merkmale des systemisch-konstruktivistischen Learning-Management-Systems für Akteure im digitalen Bildungsraum von Gesundheitsberufen dargestellt?


Begründung: Die Studie liefert Einblicke in die Konzeption und Anwendung eines digitalen Tools zur Leistungsbewertung, was für die Untersuchung von bildungstechnologischen Systemen im Bildungsbereich von Bedeutung ist.


10. Relevanzbewertung


Relevanz für die Forschungsfrage: 5 (Die Studie bietet wertvolle Erkenntnisse zur Integration und Wirkung digitaler Werkzeuge im Schulalltag.)


Zitierhäufigkeit und Einfluss: 4 (Die Forschung ist aktuell und relevant, muss aber möglicherweise noch in der wissenschaftlichen Diskussion verankert werden.)


Aktualität: 5 (Veröffentlichung im Jahr 2024, also sehr aktuell.)


Gesamtbewertung: 4.7


11. Schlussfolgerung
Die Studie von Chairuddin et al. zeigt deutlich, dass der Einsatz von Quiz Kreator in der Grundschule eine effektive Methode zur Leistungsbewertung und -verbesserung ist. Die Ergebnisse unterstreichen das Potenzial digitaler Tools, den Unterricht zu bereichern und objektivere Bewertungsmethoden zu ermöglichen. Zukünftige Forschung sollte sich darauf konzentrieren, wie solche Tools noch besser in den Schulalltag integriert und die Lehrkräfte entsprechend geschult werden können.
},
	file = {Chairuddin et al. - 2024 - Utilization of Quiz Kreator in Student Achievement.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/LHBUYTYH/Chairuddin et al. - 2024 - Utilization of Quiz Kreator in Student Achievement.pdf:application/pdf},
}

@article{martinez_de_miguel_lopez_alisis_2024,
	title = {Análisis retrospectivo de la percepción sobre herramientas para el desarrollo de actividades colaborativas en entornos virtuales},
	volume = {27},
	copyright = {https://creativecommons.org/licenses/by/4.0},
	issn = {1390-3306, 1138-2783},
	url = {https://revistas.uned.es/index.php/ried/article/view/38983},
	doi = {10.5944/ried.27.2.38983},
	abstract = {Virtual learning environments are technological systems designed to use electronic media to enable nonface-to-face education and interaction between students to take place. The research presented here considered six academic years and was carried out against the backdrop of the impact that these environments are having on higher education. It used a non-experimental, retrospective, cross-sectional approach, and was conducted within the qualitative phenomenological paradigm. The participants were 211 students who were engaged in an online postgraduate course. The aim was to identify the benefits and difficulties the students encountered when they used collaborative tools in their learning process, and the group dynamics that were established. Portfolios, forums and focus groups were the mechanisms used for data collection. The results showed a great diversity in how digital tools were used, how they were adapted to the complexity of the virtual classroom and the multi-professional profile of the participants. However, in general, the participants displayed a strong need for connection in order to share their concerns, develop bonds and build collective knowledge. There was greater emphasis on collaborative tasks during and after the pandemic than in previous periods. It was concluded that the integration of online collaboration tools among postgraduate students to carry out academic activities reflected the key role that virtual environments play in the shaping of meaningful interdisciplinary and socialisation educational experiences. In addition, the role of the group's own self-regulation in terms of maturity, networking, chronological adjustments and understanding of the task at hand was essential in the participants’ ability to overcome the challenges they encountered.},
	language = {en-GB},
	number = {2},
	urldate = {2024-08-24},
	journal = {RIED-Revista Iberoamericana de Educación a Distancia},
	author = {Martínez De Miguel López, Silvia and Bernárdez-Gómez, Abraham and Salmeron Aroca, Juan Antonio},
	month = apr,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Kollaboratives Lernen, Promotion:FU4a, Promotion:Relevanz:5, Technologieintegration, Systemanpassung, Promotion:Argumentation, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	annote = {Analyse der Studie "Análisis retrospectivo de la percepción sobre herramientas para el desarrollo de actividades colaborativas en entornos virtuales" von Martínez De Miguel López et al. (2024)
1. Hauptthemen und Ziele der Forschung
Die Studie von Martínez De Miguel López et al. (2024) untersucht die Wahrnehmung von Studierenden über den Einsatz von digitalen Werkzeugen zur Durchführung kollaborativer Aktivitäten in virtuellen Lernumgebungen im Rahmen eines postgradualen Studiengangs. Ziel der Forschung ist es, die Vorteile und Schwierigkeiten, die die Studierenden bei der Nutzung dieser Werkzeuge erleben, zu identifizieren und die Dynamiken zu analysieren, die sich bei der Gruppenarbeit über mehrere akademische Jahre hinweg herausgebildet haben.
2. Methoden und Datenquellen
Die Studie verwendet einen nicht-experimentellen, retrospektiven, querschnittlichen Ansatz, der im qualitativen, phänomenologischen Paradigma verankert ist. Die Teilnehmer der Studie waren 211 Studierende, die in einem Online-Masterstudiengang an der Universität Murcia eingeschrieben waren. Die Datenerhebung erfolgte durch die Analyse von Portfolios, Foren und Fokusgruppen über sechs akademische Jahre hinweg, um die Erfahrungen und Wahrnehmungen der Studierenden zu verstehen.
3. Zentrale Forschungsergebnisse


Vielseitige Nutzung von digitalen Werkzeugen: Die Ergebnisse zeigen eine große Vielfalt in der Nutzung digitaler Werkzeuge und deren Anpassung an die Komplexität des virtuellen Klassenzimmers sowie an das multiprofessionelle Profil der Teilnehmer.


Bedürfnis nach Verbindung und kollektiver Wissensbildung: Es wurde ein starkes Bedürfnis der Studierenden festgestellt, sich zu verbinden, um Sorgen zu teilen, Bindungen aufzubauen und kollektives Wissen zu schaffen.


Erhöhte Betonung kollaborativer Aufgaben während und nach der Pandemie: Im Vergleich zu den Vorjahren wurde während und nach der Pandemie ein größerer Schwerpunkt auf kollaborative Aufgaben gelegt.


4. Zusammenfassung
Die Studie analysiert die studentische Wahrnehmung der Nutzung von digitalen Werkzeugen zur Durchführung kollaborativer Aktivitäten in virtuellen Umgebungen und identifiziert sowohl die Vorteile als auch die Herausforderungen, die damit verbunden sind. Die Ergebnisse zeigen, dass die Studierenden ein starkes Bedürfnis nach sozialer Interaktion und kollektiver Wissensbildung haben, insbesondere in post-pandemischen Lernumgebungen.
5. Kernaussagen


Anpassungsfähigkeit der digitalen Werkzeuge: "La diversidad en el empleo de herramientas digitales refleja la adaptación a la complejidad del aula virtual y al perfil multiprofesional de los participantes." (S. 10)


Wichtigkeit der sozialen Interaktion: "Los participantes muestran una marcada necesidad de conexión para compartir inquietudes, establecer vínculos y construir conocimiento colectivo." (S. 12)


6. Argumentationslinien
Die Autoren argumentieren, dass virtuelle Lernumgebungen und die darin eingesetzten digitalen Werkzeuge eine bedeutende Rolle bei der Schaffung von sinnvollen interdisziplinären und sozialen Bildungserfahrungen spielen. Sie betonen, dass die Selbstregulation der Gruppen und das Verständnis der verwendeten Werkzeuge entscheidend sind, um die Herausforderungen zu überwinden, die in kollaborativen Lernprozessen auftreten können.
7. Verschlagwortung


Kollaboratives Lernen: Die Studie untersucht, wie kollaborative Lernaktivitäten in virtuellen Umgebungen gestaltet und wahrgenommen werden.


Technologieintegration: Es wird analysiert, wie digitale Werkzeuge in den Lernprozess integriert werden, um kollaboratives Lernen zu fördern.


Systemanpassung: Die Studie diskutiert, wie virtuelle Lernumgebungen an die Bedürfnisse von Studierenden angepasst werden müssen, um effektives Lernen zu ermöglichen.


8. Kategorisierung: Argumentation
Argumentation: Die Studie argumentiert, dass digitale Werkzeuge und virtuelle Lernumgebungen wesentliche Komponenten für das Gelingen kollaborativer Lernprozesse darstellen. Die Autoren betonen, dass sowohl die technischen als auch die sozialen Aspekte dieser Werkzeuge und Umgebungen berücksichtigt werden müssen, um ihre Wirksamkeit zu maximieren.
9. Zuordnung zur passenden Forschungsunterfrage
FU4a: Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?


Begründung: Die Untersuchung der Wahrnehmung von kollaborativen Lernprozessen und der Nutzung digitaler Werkzeuge liefert wertvolle Einblicke in die Mechanismen, die das Lernen und die Zusammenarbeit in digitalen Bildungsräumen beeinflussen können.


10. Relevanzbewertung


Relevanz für die Forschungsfrage: 5 (Die Studie bietet detaillierte Einblicke in die Herausforderungen und Vorteile von kollaborativen Lernprozessen in virtuellen Umgebungen.)


Zitierhäufigkeit und Einfluss: 4 (Die Forschung ist aktuell und relevant, muss aber möglicherweise noch weiter in der wissenschaftlichen Diskussion verankert werden.)


Aktualität: 5 (Veröffentlichung im Jahr 2024, also sehr aktuell.)


Gesamtbewertung: 4.7


11. Schlussfolgerung
Die Studie von Martínez De Miguel López et al. zeigt deutlich, dass virtuelle Lernumgebungen und digitale Werkzeuge entscheidend für die Förderung von kollaborativen Lernprozessen sind. Die Ergebnisse unterstreichen die Bedeutung der sozialen Interaktion und der Gruppenregulation, um erfolgreiche Lernprozesse zu ermöglichen. Zukünftige Forschung sollte sich darauf konzentrieren, wie diese Werkzeuge und Umgebungen weiter optimiert werden können, um den Lernprozess zu unterstützen.
},
	file = {Martínez De Miguel López et al. - 2024 - Análisis retrospectivo de la percepción sobre herr.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/9Y79PH98/Martínez De Miguel López et al. - 2024 - Análisis retrospectivo de la percepción sobre herr.pdf:application/pdf},
}

@incollection{santos_motivational_2024,
	address = {Cham},
	title = {Motivational {Dynamics} and {Platform} {Design} in {Online} {Communities} of {Teachers}: {A} {Multi}-case {Study}},
	volume = {14890},
	isbn = {978-3-031-67997-1 978-3-031-67998-8},
	shorttitle = {Motivational {Dynamics} and {Platform} {Design} in {Online} {Communities} of {Teachers}},
	url = {https://link.springer.com/10.1007/978-3-031-67998-8_3},
	doi = {10.1007/978-3-031-67998-8_3},
	abstract = {A multi-case study with three online communities that use customized instantiations of the Integrated Learning Design Environment (ILDE) platform is presented to explore and understand how teachers’ motivations to participate in OCs are related to their perceptions about incentives and features implemented in OC supporting platforms. Data was collected following a mixed-method approach. A cross-case analysis, including a correlation analysis of teachers’ motivations and their perception about different incentive mechanisms, suggests that there is a relationship between these factors. Teachers’ main motivation is to gain knowledge, and they perceive recommendation systems, tutorials, news sections and social features as the most interesting features to be implemented in an OC of teachers. In contrast, they consider reputation as the least important motivator, and they do not perceive features such as users’ rankings or contributors’ acknowledgement sections as important. These results contribute to the improvement of the supporting platforms for OC of teachers and the integration in teaching practice.},
	language = {en-GB},
	urldate = {2024-08-24},
	booktitle = {Collaboration {Technologies} and {Social} {Computing}},
	publisher = {Springer Nature Switzerland},
	author = {Santos, Patricia and Gutierrez-Paez, Nicolas and Hernández-Leo, Davinia and Michos, Konstantinos and Carrió, Mar},
	editor = {Santos, Patricia and Álvarez, Claudio and Hernández-Leo, Davinia and Kobayashi, Minoru and Zurita, Gustavo},
	year = {2024},
	note = {Series Title: Lecture Notes in Computer Science},
	keywords = {Promotion:Literaturanalyse, \#b:Buchteil:online:learning, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {29--44},
	file = {Santos et al. - 2024 - Motivational Dynamics and Platform Design in Onlin.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/R7GCG8T7/Santos et al. - 2024 - Motivational Dynamics and Platform Design in Onlin.pdf:application/pdf},
}

@incollection{santos_exploratory_2024,
	address = {Cham},
	title = {An {Exploratory} {Study} on {Empathy} and {Online} {Discussions} in {Computer} {Supported} {Collaborative} {Learning}},
	volume = {14890},
	isbn = {978-3-031-67997-1 978-3-031-67998-8},
	url = {https://link.springer.com/10.1007/978-3-031-67998-8_9},
	doi = {10.1007/978-3-031-67998-8_9},
	abstract = {Empathy, the ability to understand and share the feelings of others, is integral to effective communication and social interaction. In collaborative learning environments, empathy assumes even greater signiﬁcance as it facilitates idea exchange and problem-solving among students. While previous studies have explored the role of empathy in collaboration, research focusing speciﬁcally on its impact on Computer-Supported Collaborative Learning (CSCL) remains limited. Therefore, this study aims to investigate the relationship between students’ levels of affective and cognitive empathy and their chat discussion behavior within a CSCL environment. An exploratory descriptive study with 188 students from Spain (N = 133) and Brazil (N = 55) (Mage = 15.7 years) examined how affective and cognitive empathy inﬂuence student’s online discussion within a CSCL environment. This study provides initial insights into the relationship between empathy and online collaboration. The ﬁndings indicate a positive correlation between students’ levels of Perspective Taking and messages oriented to socialization. While, groups with higher max values under cognitive and affective empathy demonstrated a positive correlation with task-oriented messages. This study provides novel insights into the emergence of empathy within CSCL environments and has implications for the design of online collaborative learning platforms and educational technologies.},
	language = {en-GB},
	urldate = {2024-08-24},
	booktitle = {Collaboration {Technologies} and {Social} {Computing}},
	publisher = {Springer Nature Switzerland},
	author = {Theophilou, Emily and Sánchez-Reina, J. Roberto and Odakura, Valguima and Hernández-Leo, Davinia},
	editor = {Santos, Patricia and Álvarez, Claudio and Hernández-Leo, Davinia and Kobayashi, Minoru and Zurita, Gustavo},
	year = {2024},
	note = {Series Title: Lecture Notes in Computer Science},
	keywords = {Promotion:Literaturanalyse, \#b:Buchteil:online:learning, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {129--143},
	file = {Theophilou et al. - 2024 - An Exploratory Study on Empathy and Online Discuss.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/UP7JLPX5/Theophilou et al. - 2024 - An Exploratory Study on Empathy and Online Discuss.pdf:application/pdf},
}

@incollection{santos_generative_2024,
	address = {Cham},
	title = {Generative {AI} {Chatbot} in {PyramidApp}: {Students}’ {Behaviors} and {Design} {Principles}},
	volume = {14890},
	isbn = {978-3-031-67997-1 978-3-031-67998-8},
	shorttitle = {Generative {AI} {Chatbot} in {PyramidApp}},
	url = {https://link.springer.com/10.1007/978-3-031-67998-8_19},
	doi = {10.1007/978-3-031-67998-8_19},
	abstract = {Generative Artiﬁcial Intelligence (GenAI) offers new opportunities to implement useful features within Computer Supported Collaborative Learning (CSCL) environments. Despite these growing prospects, there is still limited research concerning the application of GenAI in learning environments. This work in progress aims to evaluate the mediation of a masked GenAI chatbot in the setting of the CSCL web application PyramidApp. A quasi-experimental within-subjects study was designed to assess the effect of GenAI chatbot intervention within the environment of PyramidApp. In the setting of 9 online activities, we evaluated the effect of the GenAI chatbot activity in 105 conversational chat rooms. The ﬁndings revealed that the GenAI chatbot provides useful feedback as students rate the chatbot’s answers higher than their peers’ answers (MChatbot = 4.11, MStudents = 3.91). The presence of the chatbot has an effect on group communication with the length of messages increased in chat rooms where the chatbot was present. Moreover, chatbot behavior to rate the students’ answers was correlated with the students’ behavior. The present study offers valuable insights into the optimal strategies for integrating a GenAI Large Language Model into educational tools and computer supported learning.},
	language = {en-GB},
	urldate = {2024-08-24},
	booktitle = {Collaboration {Technologies} and {Social} {Computing}},
	publisher = {Springer Nature Switzerland},
	author = {Gutiérrez-Ferré, Aldric and Hernández-Leo, Davinia and Sánchez-Reina, J. Roberto},
	editor = {Santos, Patricia and Álvarez, Claudio and Hernández-Leo, Davinia and Kobayashi, Minoru and Zurita, Gustavo},
	year = {2024},
	note = {Series Title: Lecture Notes in Computer Science},
	keywords = {Promotion:Literaturanalyse, \#b:Buchteil:online:learning, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {248--256},
	file = {Gutiérrez-Ferré et al. - 2024 - Generative AI Chatbot in PyramidApp Students’ Beh.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/IZXIIVPM/Gutiérrez-Ferré et al. - 2024 - Generative AI Chatbot in PyramidApp Students’ Beh.pdf:application/pdf},
