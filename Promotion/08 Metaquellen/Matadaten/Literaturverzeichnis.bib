@incollection{isaias_meta-analysis_2024,
	address = {Cham},
	title = {Meta-analysis of the {Influence} of {Gamification} {Elements} on {Motivation} on {E}-learning {Platforms}},
	isbn = {978-3-031-66461-8 978-3-031-66462-5},
	url = {https://link.springer.com/10.1007/978-3-031-66462-5_13},
	doi = {10.1007/978-3-031-66462-5_13},
	abstract = {Gamification is the use of game elements in a non-game context to encourage desired behaviours. It has been identified as a promising strategy for improving user motivation on e-learning platforms. Since previous literature reviews and meta-analyses only considered gamification and learning efforts without focusing directly on the gamification elements and their impact, a research gap was identified. Based on the studies analysed, the most commonly used gamification elements in the literature were identified and examined to determine whether there are any significant results in terms of motivational changes. Three areas of research questions were formulated for this meta-analysis: Which gamification elements should be used to increase learning motivation in asynchronous e-learning? Which success factors should be considered to increase the motivation of the learners when using gamification elements? Is there a specific selection of gamification elements that significantly increase motivation in asynchronous e-learning? The literature search process followed the PRISMA (Preferred Reporting Items for Systematic Reviews and Meta-Analyses) methodology. Afterward, the studies were examined to determine their relevance based on defined inclusion and exclusion criteria. The next step was title and abstract screening, followed by a full-text screening. A complementary search of the included literature was then conducted using snowballing techniques. Finally, the most relevant literature was reviewed using quality assessment criteria. Our analysis concluded that the most promising gamification elements are badges, leaderboards, level up systems and progress bars. The combination of elements increases users’ motivation significantly, especially the combination of badges with leaderboards or level up systems. These insights can contribute to the design of e-learning platforms and online courses.},
	language = {en-GB},
	urldate = {2024-08-17},
	booktitle = {Artificial {Intelligence} for {Supporting} {Human} {Cognition} and {Exploratory} {Learning} in the {Digital} {Age}},
	publisher = {Springer Nature Switzerland},
	author = {Schuhbauer, Heidi and Popp, Tobias Harald},
	editor = {Isaias, Pedro and Sampson, Demetrios G. and Ifenthaler, Dirk},
	year = {2024},
	note = {Series Title: Cognition and Exploratory Learning in the Digital Age},
	keywords = {Promotion:Literaturanalyse, \#5:Buchteil:e-learning, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {239--256},
	file = {Schuhbauer und Popp - 2024 - Meta-analysis of the Influence of Gamification Ele.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/4FY6RH4P/Schuhbauer und Popp - 2024 - Meta-analysis of the Influence of Gamification Ele.pdf:application/pdf},
}

@article{lenz_generative_2024,
	title = {Generative {Künstliche} {Intelligenz}: {Chancen} und {Stolpersteine} für die {Entwicklung} von {Organisationen}},
	volume = {31},
	issn = {1618-808X, 1862-2577},
	shorttitle = {Generative {Künstliche} {Intelligenz}},
	url = {https://link.springer.com/10.1007/s11613-024-00889-9},
	doi = {10.1007/s11613-024-00889-9},
	abstract = {This article examines the extent to which generative artiﬁcial intelligence (AI) is changing interaction in social systems. The speciﬁcs of deep learning as a form of machine learning are discussed. Organizational consulting must largely reposition itself in order to effectively support the introduction of AI. An action concept for organizational consulting is developed on the theoretical basis of management cybernetics. It is explained that organizational consulting already begins with the development of a digital strategy and, in particular, should also enable cross-organizational networking.},
	language = {de-DE},
	number = {3},
	urldate = {2024-08-17},
	journal = {Organisationsberatung, Supervision, Coaching},
	author = {Lenz, Ulrich},
	month = sep,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Technologieintegration, Systemanpassung, Promotion:Relevanz:4, Promotion:Weiterführung, \#1:Zeitschriftenartikel:learning:management:system, Promotion:FU4b, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {323--336},
	annote = {Analyse der Studie "Generative Künstliche Intelligenz: Chancen und Stolpersteine für die Entwicklung von Organisationen" von Ulrich Lenz (2024)
1. Hauptthemen und Ziele der Forschung
Die Studie von Ulrich Lenz (2024) untersucht die Auswirkungen und Herausforderungen der Einführung generativer Künstlicher Intelligenz (KI) in Organisationen. Der Fokus liegt darauf, wie generative KI die Interaktionen in sozialen Systemen verändert und welche Anforderungen sich daraus für die Organisationsberatung ergeben. Ziel der Studie ist es, ein Handlungskonzept für die Organisationsberatung zu entwickeln, das auf den Prinzipien der Managementkybernetik basiert und die spezifischen Herausforderungen der KI-Integration adressiert.
2. Methoden und Datenquellen
Methoden:


Der Ansatz der Studie ist theoretisch-analytisch und basiert auf der Managementkybernetik als Rahmenwerk zur Steuerung komplexer Systeme. Lenz entwickelt ein konzeptionelles Modell, das die Einbindung von KI in die strategische und operative Steuerung von Organisationen unterstützt.


Es werden Erkenntnisse aus der Literatur sowie aktuelle Fallstudien und Praxisbeispiele herangezogen, um die entwickelten Konzepte zu untermauern und deren praktische Anwendbarkeit zu demonstrieren.


Datenquellen:


Die Studie nutzt eine Vielzahl von Quellen, darunter wissenschaftliche Literatur, Berichte von Unternehmensberatungen und aktuelle Studien zur wirtschaftlichen und gesellschaftlichen Wirkung von generativer KI. Es werden auch Beispiele aus der Unternehmenspraxis analysiert, um die theoretischen Überlegungen zu illustrieren.


3. Zentrale Forschungsergebnisse


Veränderung der Interaktionen in Organisationen:


Generative KI verändert die Art und Weise, wie Entscheidungen in Organisationen getroffen werden, indem sie neue Formen der Mensch-Maschine-Interaktion ermöglicht. Diese Veränderungen erfordern eine Anpassung der Organisationsstrukturen und -prozesse.




Anforderungen an die Organisationsberatung:


Die Einführung generativer KI erfordert eine tiefgreifende Transformation der Organisationsberatung. Beratungsansätze müssen die Komplexität und Dynamik von KI-gestützten Systemen berücksichtigen und auf eine enge Verzahnung von technischer und sozialer Systemsteuerung abzielen.




Managementkybernetik als Handlungsrahmen:


Lenz plädiert für den Einsatz der Managementkybernetik als geeignetes Rahmenwerk, um die Herausforderungen der KI-Integration zu meistern. Dieser Ansatz betont die Notwendigkeit einer kontinuierlichen Anpassung und Selbstorganisation innerhalb der Organisationen.




4. Zusammenfassung
Die Studie diskutiert die disruptiven Auswirkungen generativer KI auf Organisationsstrukturen und -prozesse. Sie hebt hervor, dass eine erfolgreiche Integration von KI eine umfassende Transformation der Organisationsberatung erfordert, die sowohl technische als auch soziale Aspekte berücksichtigt. Managementkybernetik wird als geeignetes Modell vorgestellt, um die Komplexität der KI-Einführung zu steuern und nachhaltige Veränderungen zu ermöglichen.
5. Kernaussagen


Veränderung der Organisationsinteraktionen: Generative KI verändert grundlegend die Art und Weise, wie Entscheidungen in Organisationen getroffen und Interaktionen gestaltet werden. (S. 325)


Erweiterte Rolle der Organisationsberatung: Die Organisationsberatung muss ihre Methoden anpassen, um die dynamischen und komplexen Anforderungen der KI-Einführung zu bewältigen. (S. 330)


Managementkybernetik: Dieses Modell bietet einen strukturierten Ansatz, um die Steuerung komplexer Systeme wie Organisationen im Kontext von KI zu gestalten. (S. 331)


6. Argumentationslinien
Die Autoren argumentieren, dass die traditionelle Organisationsberatung nicht mehr ausreicht, um die Herausforderungen der KI-Integration zu bewältigen. Stattdessen muss ein systemischer Ansatz verfolgt werden, der die Wechselwirkungen zwischen technischen Systemen und sozialen Prozessen in den Mittelpunkt stellt. Die Managementkybernetik bietet hierfür einen geeigneten Rahmen, der eine kontinuierliche Anpassung und Selbstorganisation fördert. (S. 333)
7. Verschlagwortung


Technologieintegration: Die Studie analysiert die Integration generativer KI in Organisationsprozesse und die damit verbundenen Herausforderungen.


Systemanpassung: Es wird erörtert, wie Organisationen ihre Strukturen und Prozesse an die Anforderungen der KI anpassen müssen.


Forschungsansätze: Der Einsatz von Managementkybernetik als Modell zur Steuerung komplexer Systeme wird als zukunftsweisender Forschungsansatz hervorgehoben.


8. Kategorisierung
Kerngedanke: Die Studie betont, dass die Integration generativer KI eine tiefgreifende Transformation in Organisationen erfordert, die nur durch einen systemischen Ansatz wie die Managementkybernetik erfolgreich gesteuert werden kann. (S. 335)
9. Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU4b: Welche technisch-gestalterischen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?


Begründung: Die Studie untersucht die technische Integration von generativer KI und deren Einfluss auf Organisationsprozesse, was relevante Einblicke für die Anpassung von Lernmanagementsystemen bieten könnte.


10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie bietet fundierte Erkenntnisse zur Transformation von Organisationsstrukturen durch generative KI).


Zitierhäufigkeit und Einfluss: 4 (Die Studie ist aktuell und behandelt ein bedeutendes Thema im Bereich der Organisationsentwicklung).


Aktualität: 5 (Veröffentlichung im Jahr 2024, also sehr aktuell).


Gesamtbewertung: 4.7
11. Schlussfolgerung
Die Studie von Lenz (2024) zeigt, dass die Einführung generativer KI in Organisationen eine umfassende Transformation der Organisationsberatung erfordert. Der Einsatz der Managementkybernetik als Steuerungsmodell ermöglicht es, die komplexen Herausforderungen der KI-Integration zu bewältigen und nachhaltige Organisationsentwicklungen zu fördern.
},
	file = {Lenz - 2024 - Generative Künstliche Intelligenz Chancen und Sto.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/4P3UFG5X/Lenz - 2024 - Generative Künstliche Intelligenz Chancen und Sto.pdf:application/pdf},
}

@article{spenard_e-learning_2022,
	title = {E-learning use in the review of neonatal resuscitation program in physicians: a scoping review},
	volume = {42},
	issn = {0743-8346, 1476-5543},
	shorttitle = {E-learning use in the review of neonatal resuscitation program in physicians},
	url = {https://www.nature.com/articles/s41372-022-01411-8},
	doi = {10.1038/s41372-022-01411-8},
	abstract = {OBJECTIVE: To determine if e-learning interventions are efﬁcient to review Neonatal Resuscitation Program (NRP) and to prevent performance deterioration in neonatal resuscitation of already-certiﬁed healthcare professionals. STUDY DESIGN: In this scoping review, we searched for manuscripts published until June 2020 in ﬁve databases. We included all studies on e-learning use for NRP review in already-certiﬁed healthcare providers.
RESULTS: Among 593 abstracts retrieved, 38 full-text articles were assessed for eligibility. Five studies were included. Four studies evaluated the effectiveness of e-learning interventions immediately or months after their completion by providers. These interventions did not consistently enhance their NRP knowledge and their performance. One study showed that a growth mindset can inﬂuence positively neonatal resuscitation performance after an e-learning simulation.
CONCLUSION: There is not enough evidence to conclude that e-learning interventions can prevent neonatal resuscitation knowledge and performance decay in already-certiﬁed providers. More research is needed on the use of e-learning simulationbased scenarios to improve NRP retention. Journal of Perinatology (2022) 42:1527–1532; https://doi.org/10.1038/s41372-022-01411-8 1234567890();,:},
	language = {en-GB},
	number = {11},
	urldate = {2024-08-17},
	journal = {Journal of Perinatology},
	author = {Spénard, Sarah and Postolow, Fabiana and Curran, Vernon},
	month = nov,
	year = {2022},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Bewertungsmethoden, Promotion:FU5, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {1527--1532},
	annote = {Analyse der Studie "E-learning use in the review of neonatal resuscitation program in physicians: a scoping review" von Spénard et al. (2022)
1. Hauptthemen und Ziele der Forschung
Die Studie von Spénard et al. (2022) untersucht die Wirksamkeit von E-Learning-Interventionen zur Auffrischung des Neonatalen Reanimationsprogramms (NRP) bei bereits zertifizierten Gesundheitsfachkräften. Das Hauptziel ist es herauszufinden, ob E-Learning-Methoden das Wissen und die Leistung dieser Fachkräfte in der Neonatalen Reanimation langfristig erhalten können, um die Leistungseinbußen zu minimieren, die nach der ursprünglichen Zertifizierung auftreten.
2. Methoden und Datenquellen
Methoden:


Die Studie ist eine Scoping-Review, die nach PRISMA-Richtlinien durchgeführt wurde. Die Autoren suchten in fünf Datenbanken nach Studien, die bis Juni 2020 veröffentlicht wurden und die sich mit E-Learning zur Auffrischung von NRP bei bereits zertifizierten Gesundheitsfachkräften befassten.


Insgesamt wurden 593 Abstracts gesichtet, von denen 38 Volltextartikel auf ihre Eignung geprüft wurden. Fünf Studien erfüllten schließlich die Einschlusskriterien und wurden in die Überprüfung aufgenommen.


Datenquellen:


Die Daten stammen aus einer Reihe von Studien, die verschiedene E-Learning-Interventionen für die Auffrischung von NRP untersuchten. Die Studien umfassten unterschiedliche Teilnehmergruppen, darunter Neonatologen, Kinderärzte, medizinische Trainees, Pflegekräfte und andere Gesundheitsfachkräfte.


3. Zentrale Forschungsergebnisse


Leistungsabfall nach der Zertifizierung:


Die Studien zeigten, dass das Wissen und die Fähigkeiten zur Neonatalen Reanimation in den Monaten nach der Zertifizierung signifikant abnahmen. E-Learning-Interventionen konnten diesen Abfall jedoch nicht konsequent verhindern.




Wirksamkeit von E-Learning-Interventionen:


Die Studien lieferten gemischte Ergebnisse bezüglich der Effektivität von E-Learning. Während einige Studien eine sofortige Verbesserung der Fähigkeiten nach E-Learning-Interventionen zeigten, war dies nicht in allen Fällen langfristig haltbar.




Bedeutung des Growth Mindset:


Eine der Studien hob hervor, dass ein Growth Mindset – also die Überzeugung, dass Fähigkeiten durch Anstrengung und Lernen verbessert werden können – die Leistung in E-Learning-Simulationen positiv beeinflussen kann.




4. Zusammenfassung
Die Studie bewertet die Wirksamkeit von E-Learning als Methode zur Auffrischung von NRP-Fähigkeiten bei bereits zertifizierten Gesundheitsfachkräften. Die Ergebnisse zeigen, dass E-Learning-Interventionen das Wissen und die Fähigkeiten in der Neonatalen Reanimation nicht konsistent aufrechterhalten konnten. Es besteht ein Bedarf an weiteren Forschungen, insbesondere zu E-Learning-Szenarien, die auf Simulationen basieren.
5. Kernaussagen


Leistungsabfall: E-Learning-Interventionen konnten den Abfall von Wissen und Fähigkeiten in der Neonatalen Reanimation nicht konsequent verhindern. (S. 1529)


Mixed Results: Die Ergebnisse zur Wirksamkeit von E-Learning-Interventionen waren gemischt und zeigten sowohl kurzfristige Verbesserungen als auch langfristige Herausforderungen. (S. 1530)


Growth Mindset: Ein Growth Mindset kann die Wirksamkeit von E-Learning-Interventionen verbessern. (S. 1531)


6. Argumentationslinien
Die Autoren argumentieren, dass die derzeitigen E-Learning-Interventionen zur Auffrischung von NRP möglicherweise nicht ausreichend sind, um die langfristige Aufrechterhaltung von Wissen und Fähigkeiten sicherzustellen. Sie betonen die Notwendigkeit weiterer Forschung, um effektivere E-Learning-Strategien zu entwickeln, die den Leistungsabfall nach der Zertifizierung verhindern. (S. 1532)
7. Verschlagwortung


Lehr- und Lerneffektivität: Die Studie befasst sich mit der Effektivität von E-Learning-Methoden zur Auffrischung von Fachwissen und -fähigkeiten im Gesundheitswesen.


Bewertungsmethoden: Die Untersuchung der verschiedenen E-Learning-Strategien und ihrer Auswirkungen auf die langfristige Wissens- und Fähigkeitsretention.


Forschungsansätze: Die Anwendung von Scoping-Reviews zur Bewertung der Wirksamkeit von E-Learning in spezifischen medizinischen Kontexten.


8. Kategorisierung
Weiterführung: Die Studie identifiziert Lücken in der aktuellen Forschung zu E-Learning-Methoden und schlägt vor, dass weitere Untersuchungen erforderlich sind, um die langfristige Wirksamkeit von E-Learning bei der Auffrischung von medizinischen Fähigkeiten zu verbessern. (S. 1532)
9. Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


