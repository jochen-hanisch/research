  doi = {10/grsthx},
  url = {https://www.pedocs.de/frontdoor.php?source_opus=18470},
  urldate = {2023-02-17},
  abstract = {Das Zentrum für Informationsmanagement und virtuelle Lehre der Universität Osnabrück (virtUOS) betreibt an der Universität Osnabrück einen zentralen Vorlesungsaufzeichnungsdienst. Hierbei werden derzeit ca. 70 Vorlesungen mit fast 1.000 einzelnen Terminen pro Jahr aufgezeichnet. Dieser Dienst ist weitgehend automatisiert und wird mit nur 1,2 Vollzeit-Äquivalenten (VZä) betrieben. Als Basis wird "Opencast Matterhorn" genutzt, eine Open-Source-Software, die sowohl von einer Community aus zahlreichen europäischen und amerikanischen Universitäten als auch von diversen Firmen entwickelt wird. Auch das virtUOS und der ELAN e.V. beteiligen sich an der Weiterentwicklung. In diesem Text soll ein Einblick in den Einsatz von "Matterhorn" und die Entwicklungen rund um "Opencast Matterhorn" gewährt werden. Es wird über praktische Erfahrungen aus dem Betrieb an der Universität Osnabrück berichtet werden. Zusätzlich werden wir einen Blick über den Tellerrand werfen, welche Nutzungszahlen mit Matterhorn an einigen großen Universitäten möglich sind. (DIPF/Orig.)},
  langid = {ngerman},
  keywords = {7:Zeitschriftenartikel:digital:Medien,Academic sector,Automatisierungstechnik,Bewertungsmethoden,Bildung,Charité:Promotion,Deployment,Dienstleistung,Einsatz,Hochschullehre,Internet,Lecture,Lehr- und Lerneffektivität,Multimedia,Osnabrück,Osnabrueck,Practice,Praxis,Promotion:02-01_Q2,Promotion:02-01_Q3,Promotion:Argumentation,Promotion:FU4b,Promotion:Literaturanalyse,Promotion:S:07 Digitale Medien,Services,Softwaretechnologie,Technologieintegration,Universität,University,University lecturing,University teaching,Videoaufzeichnung,Vorlesung},
