@article{gorzen_evaluation_nodate,
	title = {Evaluation of a framework for the integrating of {Learning} {Analytics} in {Virtual} {Reality}},
	abstract = {The sustainable integration of Learning Analytics (complying with the FAIR principles) in an eXtended Reality application is complex. Following an iterative process, a framework and ecosystem were developed to overcome this and provide guidance for producing research software with reproducibility, reusability, and accuracy in mind. Using the solution, the requirements for new projects have been seamlessly expanded. We observed seven Computer Science students while integrating Learning Analytics into a Virtual Reality application to explore the current state of the framework and ecosystem regarding productivity, workflow, usability, functionality, and challenges. This paper presents and reflects the method and results of our observation study.},
	language = {en},
	author = {Görzen, Sergej and Heinemann, Birte and Schroeder, Ulrik},
	keywords = {Promotion:Literaturanalyse, Leraning:Analytics, Promotion:S:15 Learning Analytics, Promotion:Literaturverzeichnis},
	file = {Görzen et al. - Evaluation of a framework for the integrating of Learning Analytics in Virtual Reality:/Users/jochenhanisch-johannsen/Zotero/storage/TKCM9U5Y/Görzen et al. - Evaluation of a framework for the integrating of Learning Analytics in Virtual Reality.pdf:application/pdf},
}

@article{teng_systematic_nodate,
	title = {Systematic {Review} on the {Application} of {Multimodal} {Learning} {Analytics} to {Personalize} {Students}’ {Learning}},
	abstract = {In personalized learning (PL), learning processes are customized to account for student skills and preferences. However, as PL is generally based on a single data type, it cannot wholly represent students’ learning behaviors and progress. Hence, it is crucial to leverage Multimodal Learning Analytics (MMLA) in PL to alleviate these restrictions. A systematic literature review was conducted to explore the use of MMLA in PL and investigate its benefits across several contexts and approaches. The underexplored aspects of MMLA in PL, like the gaps in topics, pedagogies, learning settings and environments, populations, and modalities studied, are addressed, and MMLA’s potential to provide real-time tailored feedback and improve engagement is discussed.},
	language = {en},
	author = {Teng, Khor Ean and Ping, Tan Le and Leta, Chan Shi Hui},
	keywords = {Promotion:Literaturanalyse, Leraning:Analytics, Promotion:S:15 Learning Analytics, Promotion:Literaturverzeichnis},
	file = {Teng et al. - Systematic Review on the Application of Multimodal Learning Analytics to Personalize Students’ Learn:/Users/jochenhanisch-johannsen/Zotero/storage/D82S52AB/Teng et al. - Systematic Review on the Application of Multimodal Learning Analytics to Personalize Students’ Learn.pdf:application/pdf},
}

@inproceedings{xu_using_2024,
	title = {Using {Learning} {Analytics} in {Understanding} {College} {Students}’ {Behavior} in {ChatGPT}-{Facilitated} {Programming} {Learning}},
	url = {https://repository.isls.org/handle/1/11165},
	doi = {10.22318/icls2024.110098},
	abstract = {As a typical generative artificial intelligence tool, ChatGPT has gained wide attention in its application to programming. However, few researchers have conducted empirical studies to explore how learners use ChatGPT for programming learning. This study analyzes learners' programming learning behaviors to explore the characteristics of different performance learners using ChatGPT-assisted programming learning. The study analyzes the programming process of 15 learners adopting the fine-grained programming behavior method. The results indicate that: (1) Learners regard ChatGPT as a useful programming learning resource and rely on it to guide their learning process. (2) Learners tend to copy debug error messages to ChatGPT and copy its feedback, which may potentially weaken their deep understanding of the code. (3) High-performing group learners use ChatGPT more frequently for programming assistance while low-performing group learners use ChatGPT the least. Based on the findings, this study proposes suggestions for using ChatGPT to assist college students in programming learning.},
	language = {en},
	urldate = {2024-07-07},
	author = {Xu, Jie and Sun, Dan and Li, Yan},
	month = jun,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, GPT, Leraning:Analytics, Promotion:S:15 Learning Analytics, Promotion:\#Promotion:GPT, Promotion:Literaturverzeichnis},
	pages = {75--82},
	annote = {Analyse des Artikels „Using Learning Analytics in Understanding College Students’ Behavior in ChatGPT-Facilitated Programming Learning“ von Xu et al. im Kontext des Forschungsvorhabens
1. Hauptthemen und Bezug zur systematischen Literaturanalyse


Fragestellungen und Ziele: Der Artikel untersucht, wie ChatGPT von Studierenden zur Unterstützung des Programmierlernens eingesetzt wird. Die Fragestellungen konzentrieren sich auf Verhaltensmuster und Unterschiede zwischen Studierenden verschiedener Leistungsgruppen, um Empfehlungen für den effektiven Einsatz von ChatGPT zu entwickeln.


Bezug zur systematischen Literaturanalyse: Der Artikel zeigt, wie ChatGPT als interaktives Assistenztool genutzt wird, um komplexe Aufgaben zu lösen. Die Untersuchung von Verhaltensmustern und die Anwendung von Analysemethoden können auf die Analyse von Literaturnutzungsmustern übertragen werden, insbesondere zur Verbesserung der Effizienz und Relevanz in der systematischen Analyse.


2. Methodische Ansätze und Datenquellen


Methodische Ansätze: Es wurden Daten aus Screen-Recording und Clickstream-Analysen gesammelt und mithilfe eines kodierten Schemas analysiert. Das Verhalten der Studierenden wurde in 10-Sekunden-Intervallen annotiert und mithilfe von Lagged-Sequence-Analysen untersucht.


Datenquellen und Technologien: Verwendet wurden 3.600 Minuten Videoaufzeichnungen von 15 Studierenden, die in einer ChatGPT-gestützten Python-Programmierungssitzung interagierten. Das eingesetzte Modell war GPT-3.5-turbo, das in einer selbst angepassten Plattform integriert war. Diese Methodik zeigt Parallelen zu datengetriebenen Ansätzen, die in der Literaturanalyse nützlich sind.


3. Argumente für die Verwendung von GPT in der Literaturanalyse (Pro)


Vorteile und Chancen:


Effizienz: ChatGPT ermöglicht schnelle Antworten und die Synthese komplexer Informationen.


Individualisierung: Studierende können spezifische Fragen stellen und personalisierte Antworten erhalten.


Mustererkennung: Die Analyse der Nutzungsmuster zeigt, dass ChatGPT gezielt bei der Fehlerbehebung und dem Debugging eingesetzt wird.




Beispiele: Der Artikel zeigt, dass fortgeschrittene Studierende ChatGPT effektiver nutzen, um komplexere Programmierprobleme zu lösen, was für die Literaturanalyse auf die differenzierte Nutzung von GPT-Modellen übertragen werden kann.


4. Argumente gegen die Verwendung von GPT in der Literaturanalyse (Contra)


Herausforderungen und Einschränkungen:


Abhängigkeit: Weniger leistungsstarke Studierende tendieren dazu, ChatGPT mechanisch zu nutzen, ohne die Logik der Ergebnisse zu verstehen.


Fehlende Tiefe: Ein zu starker Fokus auf die Automatisierung kann das tiefere Verständnis und kritisches Denken einschränken.


Black-Box-Problematik: Die mangelnde Transparenz der GPT-Modelle führt zu Unsicherheiten über die Herkunft der Ergebnisse.




Risiken für die Validität: Wie in der Programmierung kann auch in der Literaturanalyse eine übermäßige Abhängigkeit von GPT-Outputs die Qualität und Integrität der Ergebnisse beeinträchtigen.


5. Ethische und methodische Überlegungen


Ethische Implikationen: Der Artikel betont die Bedeutung der Förderung kritischen Denkens und die Notwendigkeit, Abhängigkeit von KI-Tools zu minimieren. Es wird gefordert, dass Lehrkräfte klare Anleitungen für den Einsatz von ChatGPT bereitstellen.


Methodische Verbesserungen: Die Autoren schlagen vor, Lernende zu ermutigen, spezifischere Fragen zu stellen, und betonen die Wichtigkeit von Reflexion und Feedback, um die Nutzung von ChatGPT zu optimieren.


6. Relevanz für das Forschungsvorhaben und Forschungslücken


Diskussionsbeitrag: Der Artikel liefert wertvolle Einblicke in die Verhaltensmuster bei der Nutzung von GPT-Modellen und zeigt, wie diese auf Lern- und Analyseprozesse angewendet werden können. Dies ist direkt relevant für die Untersuchung von Nutzungsmustern in der Literaturanalyse.


Forschungslücken:


Die Studie beschränkt sich auf eine kleine Stichprobe und spezifische Anwendungsfälle. Es fehlen umfassendere Untersuchungen zu Langzeitwirkungen.


Die Notwendigkeit, die Interaktionen zwischen Mensch und GPT-Modellen besser zu verstehen, bleibt offen.




Zusammenfassung
Der Artikel verdeutlicht die potenziellen Vorteile von ChatGPT für das Lernen und die Problemlösung, zeigt jedoch gleichzeitig, dass Abhängigkeit und unkritische Nutzung die Lernergebnisse beeinträchtigen können. Für die Literaturanalyse bieten die beschriebenen Methoden zur Verhaltensanalyse und die Empfehlungen zur Optimierung der Nutzung von GPT-Modellen wertvolle Ansätze. Die Integration von Reflexionsprozessen und die Förderung spezifischer Eingabeaufforderungen könnten die Effizienz und Relevanz in der systematischen Literaturanalyse erheblich verbessern. Die Erkenntnisse sind direkt auf das Forschungsvorhaben übertragbar und könnten zur Entwicklung fundierterer GPT-gestützter Analyseverfahren beitragen.
},
	file = {Xu et al. - 2024 - Using Learning Analytics in Understanding College .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/XPCFFWQJ/Xu et al. - 2024 - Using Learning Analytics in Understanding College .pdf:application/pdf},
}

@article{hernandez-leo_chatgpt_nodate,
	title = {{ChatGPT} and {Generative} {AI} in {Higher} {Education}: {User}-{Centered} {Perspectives} and {Implications} for {Learning} {Analytics}},
	abstract = {The increasing availability of easy-to-access generative Artificial Intelligence (AI) tools, like ChatGPT, calls for a need in education to devise new learning scenarios in view of their potential and challenges. Learning Analytics (LA) can play an important role in the understanding and optimization of responsible and reflective uses of AI tools in education. This paper contributes to the exploration of this role, adopting a human-centered perspective. The paper studies the perspectives of professors and students participating in a 'generative AI for learning' training at a public university in Spain. Considering these perspectives, the paper discusses new requirements for learning analytics in these new learning scenarios using AI. The perspectives highlight the potential of these tools as learning assistants, enabling improved use of study time, stimulating creativity, and facilitating personalized feedback. Stakeholders also points out several ethical concerns and risks that may hinder learning. These preliminary results emphasize the need for LA to differentiate between AI-assisted and AI-complement actions and human intelligence at work, aligned with pedagogical intentions. The paper formulates high-level constructs for learning analytics differentiating those actions, illustrated with examples. The paper also discusses that ethical concerns, like student inequality in accessing advanced tools, should be factored into analytics and decision-making tools.},
	language = {en},
	author = {Hernández-Leo, Davinia},
	keywords = {Promotion:Literaturanalyse, GPT, Leraning:Analytics, Promotion:S:15 Learning Analytics, Promotion:\#Promotion:GPT, Promotion:Literaturverzeichnis},
	file = {Hernández-Leo - ChatGPT and Generative AI in Higher Education Use.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/VBW2F8BS/Hernández-Leo - ChatGPT and Generative AI in Higher Education Use.pdf:application/pdf},
}

@article{junge_anfange_2023,
	title = {Anfänge von {Learning} {Analytics} in einem {Blended}-{Learning}-{Curriculum} für {Allgemeinmedizin} an der {Universität} des {Saarlandes} –ein quantitativer Überblick},
	volume = {40},
	number = {6},
	journal = {GMS Journal for Medical Education},
	author = {Junge, Helene and Schuster, Kerstin and Salzmann, Aline and Volz-Willems, Sara and Jäger, Johannes and Dupont, Fabian},
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Technologieintegration, Promotion:FU2a, Systemanpassung, Promotion:Argumentation, Leraning:Analytics, \#8:Zeitschriftenartikel:blended:learning, Promotion:S:08 Blended Learning, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU2a},
	pages = {10--19},
	annote = {Analyse der Studie „First steps of learning analytics in a blended learning general practice curriculum at Saarland University – a quantitative approach“ von Helene Junge et al. (2023)


Hauptthemen und Ziele der Forschung: Die Studie untersucht den Einsatz von Learning Analytics in einem Blended-Learning-Curriculum für Allgemeinmedizin an der Universität des Saarlandes. Ziel ist es, das digitale Lernverhalten der Studierenden zu analysieren und zu verstehen, inwiefern dieses mit den Ergebnissen in formativen Assessments und Prüfungen korreliert. Die Autoren streben an, Rückschlüsse darauf zu ziehen, wie digitale Lernaktivitäten zur Prüfungsvorbereitung effektiv genutzt werden können.


Methoden und Datenquellen: Die Studie verwendet eine quantitative Methode zur Analyse von Nutzerdaten der Lernplattform AMBOSS®. Daten von 195 Studierenden aus dem 5. Studienjahr wurden gesammelt, um ihr Lernverhalten und ihre Leistung im Rahmen von Multiple-Choice-Fragesitzungen (MCQ) und formativen Assessments zu untersuchen. Eine Referenzkohorte von 10.534 Studierenden aus 35 deutschen Universitäten diente als Vergleich.


Zentrale Forschungsergebnisse:


Die Studierenden, die in ein Blended-Learning-Curriculum eingebunden waren, nutzten die digitalen Lernmaterialien signifikant häufiger als die Referenzkohorte (U=48777, p{\textless}0,001).


Es gab moderate Korrelationen zwischen der Anzahl gelesener Lernkarten und den Ergebnissen im formativen Assessment (ρ=0,331, p=0,005), sowie zwischen den FA-Scores und den Prüfungsergebnissen im Sommersemester (ρ=0,505, p{\textless}0,001).


Die Ergebnisse unterstreichen, dass formative Assessments in einem Blended-Learning-Curriculum einen positiven Einfluss auf die Prüfungsvorbereitung haben können.




Zusammenfassung: Die Studie hebt hervor, dass die Integration digitaler Lernaktivitäten in ein Blended-Learning-Curriculum zu einer erhöhten Nutzung dieser Aktivitäten führt und sich positiv auf die Leistungen in formativen Assessments und Prüfungen auswirkt. Dies deutet darauf hin, dass Learning Analytics zur Überwachung und Unterstützung des Lernverhaltens effektiv eingesetzt werden kann.


Kernaussagen:


Studierende nutzen digitale Lernmaterialien häufiger, wenn sie in ein Blended-Learning-Curriculum integriert sind (S. 12).


Formative Assessments korrelieren positiv mit den Prüfungsergebnissen und können somit als Indikator für den Lernerfolg dienen (S. 14).


Learning Analytics bietet Potenzial zur Überwachung des Lernfortschritts und zur gezielten Unterstützung von Lernenden (S. 16).




Argumentationslinien: Die Autoren argumentieren, dass Learning Analytics ein nützliches Werkzeug ist, um das Lernverhalten von Studierenden zu überwachen und die Effizienz digitaler Lernmethoden zu bewerten. Sie unterstreichen, dass formative Assessments ein effektives Mittel zur Prüfungsvorbereitung sind, wenn sie in ein gut strukturiertes Blended-Learning-Curriculum integriert werden (S. 14-16).


Verschlagwortung:


Technologieintegration: Die Studie analysiert die Integration von AMBOSS® als Teil des Blended-Learning-Curriculums und dessen Einfluss auf das Lernverhalten der Studierenden.


Lehr- und Lerneffektivität: Die Wirksamkeit von formativen Assessments zur Prüfungsvorbereitung wird detailliert untersucht und positiv bewertet.


Systemanpassung: Die Studie zeigt, wie digitale Lernplattformen an die Bedürfnisse von Medizinstudierenden angepasst werden können, um den Lernerfolg zu fördern.




Kategorisierung:


Argumentation: Die Arbeit belegt durch quantitative Daten, dass Learning Analytics zur Verbesserung des Lernverhaltens und der Lernergebnisse beitragen kann.




Zuordnung zu den Forschungsfragen: Diese Studie passt zur Forschungsfrage FU2a: „Welchen Effekt erläutern Lernende im digitalen Bildungsraum von Gesundheitsberufen bei der Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems?“


Begründung: Die Arbeit untersucht die Auswirkungen digitaler Lernmethoden auf das Lernverhalten und die Leistung von Medizinstudierenden, was direkt auf die Effekte von Learning-Management-Systemen in der Gesundheitsbildung anwendbar ist.




Relevanzbewertung:




5 - Hoch relevant: Die Studie liefert wichtige Einblicke in die Nutzung von Learning Analytics und digitalen Lernmethoden zur Verbesserung der Lernleistung und ist damit direkt relevant für die Forschung im Bereich des digitalen Lernens in Gesundheitsberufen.



},
	file = {zma001653.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/XPQ6QAJF/Junge et al. - 2023 - Anfänge von Learning Analytics in einem Blended-Learning-Curriculum für Allgemeinmedizin an der Univ.pdf:application/pdf},
}

