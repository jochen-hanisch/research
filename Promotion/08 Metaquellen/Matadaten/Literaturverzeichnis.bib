}

@article{estipona_teaching_2025,
	title = {Teaching from the {Remote}: {Investigating} {Teachers}’ {Educational} {Presence} and {Instructional} {Experiences} in {Using} {Alternative} {Learning} {Modalities}},
	volume = {4},
