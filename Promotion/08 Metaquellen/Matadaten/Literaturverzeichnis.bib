@article{ghanem_medical_2025,
	title = {Medical students’ knowledge, attitudes, and practices toward generative artificial intelligence in {Egypt} 2024: a {Cross}-{Sectional} study},
	volume = {25},
	issn = {1472-6920},
	shorttitle = {Medical students’ knowledge, attitudes, and practices toward generative artificial intelligence in {Egypt} 2024},
	url = {https://bmcmededuc.biomedcentral.com/articles/10.1186/s12909-025-07329-x},
	doi = {10.1186/s12909-025-07329-x},
	abstract = {Background Generative artificial intelligence (generative AI) has revolutionized the healthcare system for medical students and their educational process worldwide. Several studies assessed its efficacy in improving medical studies learning, and others assessed medical students’ knowledge and attitudes about generative AI. So, we aim to determine the knowledge, attitudes, and practices of generative AI among medical students in Egypt.
Methods In 2024, a cross-sectional study using a semi-structured questionnaire was performed, targeting 423 students as a convenient sample from 10 selected Egyptian universities by simple random sampling. The questionnaire was distributed via online platforms such as WhatsApp, Facebook, X, Telegram, and Messenger. Data about sociodemographic characteristics, students’ general knowledge about generative AI and its limitations, and their attitudes and practices, respectively, were collected.
Results About 2{\textbackslash}3 (61.5\%) of the studied students had satisfactory knowledge about generative AI and (44.7\%) had a positive attitude. Males demonstrated significantly higher knowledge than females (69.3\% vs. 55\%, P-value = 0.003). Knowledge level also differs significantly by university (P-value {\textless} 0.001), with Suez-Canal and 6th October university students achieving the highest satisfactory scores. Key significant predictors that affect knowledge level include gender, university and study phase according to binary logistic regression results. Furthermore, there is a positive correlation between satisfactory knowledge and Practice level (r = 0.303, P {\textless} 0.001). Finally, most students use generative AI to check Grammar and prepare their homework or assignments.
Conclusion and recommendations There is moderate knowledge and positive attitude about AI that were reflected in medical students’ practice. However, knowledge about AI influenced by gender, university and study phase. Importantly, better knowledge significantly correlates with greater generative AI practice. Offering specialized courses or faculty modules about AI enhance awareness among Egyptian medical students. Such initiatives will enable them to gain knowledge and apply it effectively and wisely. Medical students’ knowledge, attitudes,},
	language = {en-GB},
	number = {1},
	urldate = {2025-06-03},
	journal = {BMC Medical Education},
	author = {Ghanem, Omar A. and Hagag, Abdelmonam M. and Kormod, Muhammed E. and El-Refaay, Mennatullah A. and Khedr, Alaa Mahmoud and Abozaid, Omnia M. and Abdelmoaty, Karim M. and Hamed, Mona S.},
	month = may,
	year = {2025},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Bewertungsmethoden, Promotion:Relevanz:4, Promotion:FU6, Promotion:Schlussfolgerung, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {790},
	annote = {Analyse der Studie „Medical students’ knowledge, attitudes, and practices toward generative artificial intelligence in Egypt 2024: A Cross-Sectional study“ von Ghanem et al. (2025)

1. Hauptthemen und Ziele der Forschung
Ziel der Studie ist die systematische Untersuchung des Wissens, der Einstellungen und der praktischen Nutzung generativer KI (GenAI) durch Medizinstudierende in Ägypten. Dabei liegt der Fokus auf Unterschieden nach Geschlecht, Universität und Studienphase sowie auf dem Zusammenhang zwischen Wissen und Nutzung. Die Forschung soll zur Integration generativer KI in das Curriculum medizinischer Fakultäten beitragenGhanem et al. - 2025 - ….

2. Methoden und Datenquellen


Studiendesign: Querschnittsstudie (März 2024).


Stichprobe: 423 Studierende aus 10 ägyptischen Universitäten, Convenience Sample (Online-Fragebogen).


Erhebungsinstrument: Semistrukturierter Fragebogen mit validierten Skalen für Wissen, Einstellung und Nutzung (Cronbach’s Alpha = 0,708).


Auswertung: Deskriptive Statistik, Chi²-Test, Mann-Whitney, Pearson-Korrelation, logistische Regression (SPSS v27)Ghanem et al. - 2025 - ….



3. Zentrale Forschungsergebnisse


Wissen: 61,5 \% der Studierenden verfügten über zufriedenstellende Kenntnisse. Männer hatten signifikant höheres Wissen als Frauen (69,3 \% vs. 55 \%; p = 0,003). Unterschiede zeigten sich auch zwischen den Universitäten und Studienphasen (z. B. 6th October University: 85,7 \% zufriedenstellend)Ghanem et al. - 2025 - ….


Einstellung: 44,7 \% der Studierenden zeigten eine positive Haltung gegenüber generativer KI. Mehrheit befürwortet deren Integration in die Ausbildung (z. B. 74,3 \% Zustimmung zur Vermittlung generativer KI im Studium)Ghanem et al. - 2025 - ….


Nutzung: Studierende nutzten GenAI hauptsächlich für:


Grammatik-/Rechtschreibprüfung (28,1 \% häufig)


Hausaufgaben (29,1 \% häufig)


Recherche (30,7 \% häufig)


Weniger für Prüfungsvorbereitung oder PersönlichkeitsentwicklungGhanem et al. - 2025 - ….




Zusammenhang: Höheres Wissen korrelierte positiv mit häufigerer Nutzung von GenAI (r = 0,303; p {\textless} 0,001)Ghanem et al. - 2025 - ….



4. Zusammenfassung
Die Studie zeigt, dass ägyptische Medizinstudierende über ein mittleres Maß an Wissen über generative KI verfügen und dieser tendenziell positiv gegenüberstehen. Nutzung erfolgt bisher vorrangig im organisatorisch-praktischen Bereich. Die Autorinnen fordern gezielte Curriculumsentwicklungen, um die technische und ethische Kompetenz künftiger Ärztinnen im Umgang mit GenAI zu stärkenGhanem et al. - 2025 - ….

5. Kernaussagen


Wissensstand: „About 61.5\% of the studied students had satisfactory knowledge about generative AI.“ (S. 1)Ghanem et al. - 2025 - …


Geschlechterunterschied: „Males demonstrated significantly higher knowledge than females (69.3\% vs. 55\%, P=0.003).“ (S. 1)Ghanem et al. - 2025 - …


Korrelation Wissen/Nutzung: „There is a positive correlation between satisfactory knowledge and Practice level (r=0.303, P{\textless}0.001).“ (S. 1)Ghanem et al. - 2025 - …


Einstellung: „(74.3\%) agreed to want medical students to learn generative AI“ (S. 4, Abb. 3)Ghanem et al. - 2025 - …


Nutzung: „Most students use generative AI to check Grammar and prepare their homework or assignments.“ (S. 1)Ghanem et al. - 2025 - …



6. Argumentationslinien
Die Autor*innen entwickeln ihre Argumentation entlang der Prämisse, dass GenAI künftig eine Schlüsselrolle in der Medizin spielen wird. Daraus leiten sie die Notwendigkeit ab, bereits Medizinstudierende umfassend in Technik, Ethik und Anwendung dieser Technologie einzuführen. Die empirischen Befunde (v. a. Wissensdefizite und positive Haltungen) werden zur Begründung von curricularen Interventionen herangezogenGhanem et al. - 2025 - ….

7. Verschlagwortung


Technologieintegration: Thematischer Fokus auf Einführung von GenAI in medizinische Curricula.


Lehr- und Lerneffektivität: Ziel ist die Effizienzsteigerung durch GenAI-Einsatz im Studium.


