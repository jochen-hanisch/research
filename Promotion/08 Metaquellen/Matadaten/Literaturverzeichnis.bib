@article{yousef_usability_2015,
	title = {A usability evaluation of a blended {MOOC} environment: {An} experimental case study},
	volume = {16},
	issn = {1492-3831},
	shorttitle = {A usability evaluation of a blended {MOOC} environment},
	url = {http://www.irrodl.org/index.php/irrodl/article/view/2032},
	doi = {10.19173/irrodl.v16i2.2032},
	abstract = {In the past few years, there has been an increasing interest in Massive Open Online Courses (MOOCs) as a new form of Technology-Enhanced Learning (TEL), in higher education and beyond. Recognizing the limitations of standalone MOOCs, blended MOOCs (bMOOCs) that aim at bringing in-class (i.e. face-to-face) interactions and online learning components together have emerged as an alternative MOOC model of teaching and learning in a higher education context. In this paper, we present the design, implementation, and evaluation details of a bMOOC course on “Teaching Methodologies” at Fayoum University, Egypt in cooperation with RWTH Aachen University, Germany, provided using the bMOOC platform L2P-bMOOC. In order to gauge the usability and effectiveness of the course, we employed an evaluation approach based on Conole’s 12 dimensions rubrics, ISONORM 9241/110-S as a general usability evaluation, and a custom effectiveness questionnaire reflecting the different MOOC stakeholder perspectives.},
	language = {en-GB},
	number = {2},
	urldate = {2024-11-17},
	journal = {The International Review of Research in Open and Distributed Learning},
	author = {Yousef, Ahmed Mohamed Fahmy and Chatti, Mohamed Amine and Schroeder, Ulrik and Wosnitza, Marold},
	month = apr,
	year = {2015},
	keywords = {Promotion:Literaturanalyse, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Promotion:Relevanz:4, Promotion:FU5, \#4:Zeitschriftenartikel:MOOC, Promotion:S:04 MOOC, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU5},
	annote = {Hier ist die strukturierte Analyse und Zusammenfassung des Artikels „A Usability Evaluation of a Blended MOOC Environment: An Experimental Case Study“ von Yousef et al. (2015):

Analyse
1. Hauptthemen und Ziele der Forschung


Hauptthemen:


Evaluation der Usability und Effektivität eines blended MOOC (bMOOC) Systems.


Untersuchung von Designkriterien und deren Einfluss auf die Lernerfahrung.


Verknüpfung von traditionellen MOOC-Ansätzen (cMOOCs, xMOOCs) mit Präsenzveranstaltungen.




Ziele:


Entwicklung von Designrichtlinien für bMOOCs.


Identifikation von Usability-Problemen und Vorschlägen zur Optimierung.




2. Methoden und Datenquellen


Methoden:


Einsatz von Conole’s 12 Dimensions Rubrics, ISONORM 9241/110-S und maßgeschneiderten Fragebögen.


Quantitative und qualitative Datenerhebung bei 128 Teilnehmenden.


Evaluierung durch gemischte Methoden mit Fokus auf Benutzerfreundlichkeit und Effektivität.




Datenquellen:


Daten aus der Nutzung der bMOOC-Plattform „L2P-bMOOC“ an der RWTH Aachen und Fayoum University.


Logfiles, Interaktionsdaten und Umfragen.




3. Zentrale Forschungsergebnisse


Usability:


ISONORM 9241/110-S ergab eine Gesamtbewertung von 93,3, was eine hohe Benutzerfreundlichkeit widerspiegelt.


Herausforderungen bestanden in der Fehlerbehandlung und der Navigation.




Effektivität:


Blended Learning erhöhte die Motivation und Interaktion der Teilnehmenden (M = 4.4 von 5).


Flexibilität und hoher Content-Standard wurden besonders geschätzt.


Selbstorganisiertes Lernen wurde gefördert, allerdings gab es Schwächen bei der Überwachung von Peer-Aktivitäten.




Designkriterien:


Hohe Bedeutung von Interaktivität, wie Videoannotationen, und der Einbindung von sozialen Funktionen.





Zusammenfassung
Der Artikel untersucht die Usability und Effektivität einer bMOOC-Plattform, die traditionelle Online- und Präsenzlehre verbindet. Die Ergebnisse zeigen, dass bMOOCs eine effektive und motivierende Lernumgebung schaffen können, insbesondere durch interaktive Features und flexible Nutzung. Die Plattform förderte selbstorganisiertes Lernen, wies jedoch Schwächen in der Unterstützung von Peer-Interaktionen und der Fehlerbehandlung auf.

Kernaussagen


Blended Learning stärkt die Motivation: Face-to-Face-Interaktionen in Kombination mit digitalen Inhalten steigern das Engagement (S. 82-83).


Hohe Benutzerfreundlichkeit: Trotz kleinerer Herausforderungen ist die Plattform effektiv und benutzerfreundlich (S. 80-81).


Optimierung durch Interaktivität: Features wie Videoannotationen und Gruppendiskussionen fördern das kollaborative Lernen (S. 86-88).



Argumentationslinien


Hauptthese: bMOOCs können durch ein hybrides Design die Schwächen traditioneller MOOCs überwinden und effektives Lernen fördern.


Unterstützende Evidenz: Interaktive Elemente wie Videoannotationen und Diskussionstools verbesserten die Lernerfahrung (S. 87-88).


Implikationen: Zukünftige bMOOCs sollten stärker auf adaptive Technologien und Peer-Interaktion setzen (S. 89-90).



Verschlagwortung


Technologieintegration: Nutzung von digitalen Tools wie Videoannotationen zur Verbesserung der Lernerfahrung.


Kollaboratives Lernen: Förderung von Gruppeninteraktionen und Austausch durch Plattformfunktionen.


Lehr- und Lerneffektivität: Verknüpfung von Präsenzlehre und Online-Elementen zur Steigerung von Motivation und Lernerfolg.



Kategorisierung
Kategorie: KerngedankeBegründung: Der Artikel entwickelt ein zentrales Verständnis für die Verbindung von MOOCs und Blended Learning und beschreibt, wie diese Lernumgebungen durch innovative Designkriterien optimiert werden können.

Zuordnung zu Forschungsfragen


Passendste Forschungsfrage: FU5: Welche Möglichkeiten und Grenzen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems durch Akteure im digitalen Bildungsraum analysiert?


Begründung: Der Artikel beleuchtet die Stärken und Schwächen eines hybriden Ansatzes, der zentrale Elemente von LMS-Designs integriert.



Relevanzbewertung


Aktualität: 3 (Veröffentlichung 2015, Erkenntnisse jedoch weiterhin relevant).


Direkte Relevanz: 4 (Bietet wertvolle Einblicke in die Verbindung von Online- und Präsenzlehre).


Gesamtbewertung: 4 (Relevante Grundlage für die Weiterentwicklung hybrider Lernmodelle).


