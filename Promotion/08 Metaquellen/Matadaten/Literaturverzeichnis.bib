  title = {Motivational {{Dynamics}} and {{Platform Design}} in {{Online Communities}} of {{Teachers}}: {{A Multi-case Study}}},
  shorttitle = {Motivational {{Dynamics}} and {{Platform Design}} in {{Online Communities}} of {{Teachers}}},
