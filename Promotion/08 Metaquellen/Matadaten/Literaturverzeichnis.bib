}

@incollection{dyrna_methoden_2021,
	address = {Münster ; New York},
	title = {Methoden, {Medien} oder {Werkzeuge}? {Eine} technologische {Klassifizierung} von digitalen {Bildungsmedien}},
	url = {https://www.pedocs.de/volltexte/2023/26615/pdf/MidW_78_Dyrna_Guenther_Methoden_Medien_oder_Werkzeuge.pdf},
	abstract = {Anknüpfungsfähige empirische Untersuchungen von Erfolgsfaktoren und Herausforderungen von Bildungsprozessen, die unter dem stetigen Einfluss der voranschreitenden digitalen Transformation stehen, erfordern eine fundierte und einheitliche theoretische Grundlage. Diesbezüglich fehlt beispielsweise nach wie vor eine zeitgemäße systematische Differenzierung von (digitalen) Medien zur Unterstützung von Bildungsprozessen. Hier knüpfen die Autorin und der Autor im vorliegenden Beitrag an. Nach einer eingänglichen kritischen Betrachtung von bestehenden chronologischen und didaktischen Taxonomien leiten sie unter einer trennscharfen Verwendung von einschlägigen Termini eine technologische Klassifizierung her. Sie grenzt Bildungsmedien auf der ersten Ebene nach dem Technologieeinsatz bei ihrer Produktion und Rezeption voneinander ab. Auf der zweiten Ebene werden tertiäre Medien in Bezug auf ihre Rolle im Produktions-, Distributions- bzw. Rezeptionsprozess unterschieden. Die medientechnische Infrastruktur wird ebenso wie die technologischen Bildungsressourcen und -Werkzeuge auf zwei zusätzlichen Sub-Ebenen weiterführend ausdifferenziert. Abschließend diskutieren die Autorin und der Autor die erarbeitete Systematisierung kritisch. (DIPF/Orig.)},
	language = {de-DE},
	urldate = {2022-01-28},
	booktitle = {Bildung in der digitalen {Transformation}},
	author = {Dyrna, Jonathan and Günther, Franziska},
	editor = {Wollersheim, Heinz-Werner and Karapanos, Marios and Pengel, Norbert},
	collaborator = {Martin, Anne},
	year = {2021},
	keywords = {\#7:Buchteil:digital:Medien, Promotion:Literaturanalyse, Technologieintegration, Bewertungsmethoden, Promotion:Relevanz:4, Promotion:Weiterführung, Lernsystemarchitektur, Promotion:FU3, FernUni-Hagen:MABM:M6, Promotion:S:07 Digitale Medien, Promotion:2.4 Exkurs: Technologiedefizit, Promotion:Literaturverzeichnis, Promotion:sec:TechnischeArchitektur, Promotion:chap:04-03},
	pages = {19--30},
	annote = {Analyse: Methoden, Medien oder Werkzeuge? Eine technologische Klassifizierung von digitalen Bildungsmedien von Dyrna, Günther\# Analyse: *Methoden, Medien oder Werkzeuge? Eine technologische Klassifizierung von digitalen Bildungsmedien* von Dyrna, Günther

\#\# 1. Hauptthemen und Ziele der Forschung
- Der Artikel thematisiert die verschiedenen Kategorien digitaler Bildungsmedien und zielt darauf ab, eine technologische Klassifizierung zu erstellen. Das Hauptziel ist es, klar zu definieren, wie digitale Medien in Bildungseinrichtungen als Methoden, Werkzeuge oder Medien eingesetzt werden können.

\#\# 2. Methoden und Datenquellen
- Der Artikel verwendet eine kombinierte qualitative und quantitative Methodik. Literaturrecherche und Expertenbefragungen wurden zur Datensammlung eingesetzt. Die Autoren führten außerdem Fallstudien an verschiedenen Bildungseinrichtungen durch, um praxisbezogene Erkenntnisse zu gewinnen.

\#\# 3. Zentrale Forschungsergebnisse
- Es wurde festgestellt, dass digitale Bildungsmedien oft uneinheitlich verwendet und klassifiziert werden. Die Studie identifiziert Kriterien zur Unterscheidung zwischen Medien, Methoden und Werkzeugen und führt eine Systematik ein, die den Einsatz digitaler Medien in Bildungsprozessen klarer strukturiert.

\#\# 4. Zusammenfassung des Artikels
- **Problemstellung**: Unklare Klassifizierung und uneinheitlicher Einsatz digitaler Bildungsmedien führen zu Ineffizienzen im Bildungssektor.
 - Methodik: Einsatz qualitativer und quantitativer Methoden, darunter Literaturrecherche, Experteninterviews und Fallstudien.
 - Hauptergebnisse: Etablierung von Klassifizierungskriterien für digitale Bildungsmedien.
 - Schlussfolgerungen: Eine vereinheitlichte Klassifizierung erleichtert den effektiven Einsatz digitaler Medien in Bildungsumgebungen.
