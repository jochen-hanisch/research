}

@article{asada_possibility_2023,
	title = {The possibility of {Moodle}-based e-portfolio with database module for medical education},
	volume = {3},
	issn = {2185-9922},
	url = {https://iaiai.org/letters/index.php/lir/article/view/125},
	doi = {10/gsswbc},
	abstract = {In medical education, e-portfolios are needed both for supporting students’ self-learning and for quality assurance of education based on the global standards. Although there are some e-portfolio systems, it is sometimes complicated to use both learning management systems and e-portfolios. In this study, a Moodle-based e-portfolio with database module are proposed for the minimal portfolio use in medical education. Although it has a limited feature compared to the e-portfolios as commonly used, the advantages of the system are that it is unified and easy to use, and that data can be exported easily.},
	language = {en-GB},
	urldate = {2023-09-28},
	journal = {IIAI Letters on Institutional Research},
	author = {Asada, Yoshikazu},
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Bewertungsmethoden, \#1:Zeitschriftenartikel:learning:management:system, Bildung, Multimedia, Krisenreaktion im Bildungsbereich, E-Portfolio, Promotion:S:17 E-Portfolio, Promotion:3.5 ePortfolio als ..., Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {1},
	annote = {Die Studie von Asada (2023) befasst sich mit der Entwicklung eines Moodle-basierten E-Portfolio-Systems mit Datenbankmodul für die medizinische Ausbildung. Der Fokus liegt auf der Möglichkeit, Lernlogs und klinische Ausbildungserfahrungen systematisch zu erfassen und zu analysieren.
1. Analyse der Quelle
Die Studie untersucht den Einsatz von Moodle, einer weit verbreiteten Lernmanagementplattform, zur Verbesserung des Managements und der Analyse von studentischen Lernlogs in der medizinischen Ausbildung. Sie zielt darauf ab, die Funktionalität von Moodle durch die Nutzung des Standarddatenbankmoduls zu erweitern, um ein E-Portfolio-System zu schaffen, das sowohl flexibel als auch anpassungsfähig ist.
2. Zusammenfassung der Kernaussagen
Asada schlägt vor, das Datenbankmodul von Moodle zu nutzen, um ein minimalistisches E-Portfolio zu erstellen, das die Erfassung und Bewertung von studentischen Lernaktivitäten ermöglicht. Dieses System soll insbesondere für die Dokumentation klinischer Ausbildungen und die formativen Bewertungen verwendet werden. Der Ansatz zielt darauf ab, eine kostengünstige und technisch leicht umsetzbare Lösung zu bieten, die die bestehenden Funktionen von Moodle optimal nutzt.
3. Darstellung der Kernaussagen anhand der Fundstellen


Einsatz des Datenbankmoduls: Moodle's Datenbankmodul wird genutzt, um ein anpassbares E-Portfolio zu erstellen, das Lernlogs und Bewertungen effektiv verwaltet (S. 2-3).


Design und Benutzerfreundlichkeit: Das System wird so gestaltet, dass es leicht von Lehrkräften und Studierenden genutzt werden kann, wobei besonderes Augenmerk auf die Bedienbarkeit und die Anpassungsfähigkeit an verschiedene Lehr- und Lernanforderungen gelegt wird (S. 4-5).


Datenauswertung und -export: Es werden Möglichkeiten zur effizienten Datenauswertung und zum Export der gesammelten Daten diskutiert, um die Nutzung in der Bewertung und Qualitätssicherung zu unterstützen (S. 6-7).


4. Argumentationslinien
Asada argumentiert, dass die Nutzung von Standardfunktionen innerhalb von Moodle, wie das Datenbankmodul, eine praktikable und kosteneffiziente Lösung bietet, um die Anforderungen der medizinischen Ausbildung zu erfüllen. Durch die Anpassung dieser Funktionen kann eine effektive Plattform für die Sammlung und Analyse von Bildungsdaten geschaffen werden, die die pädagogische Qualität und die Bewertung verbessert.
5. Verschlagwortung


Technologieintegration: Integration des Moodle-Datenbankmoduls zur Unterstützung von E-Portfolios in der medizinischen Bildung.


Lehr- und Lerneffektivität: Fokus auf die Verbesserung der Lehr- und Lernprozesse durch systematische Datenerfassung und Analyse.


Bewertungsmethoden: Nutzung der Daten für formative und summative Bewertungen innerhalb medizinischer Lehrpläne.


Forschungsansätze: Anwendung von technologischen Lösungen zur Verbesserung der pädagogischen Praxis und Forschung.


Krisenreaktion im Bildungsbereich: Anpassung von Lehrstrategien an digitale Formate, insbesondere im Kontext der Pandemie und der zunehmenden Digitalisierung.


Diese Studie zeigt einen innovativen Ansatz zur Nutzung bestehender LMS-Funktionen zur Unterstützung komplexer Bildungsprozesse in der medizinischen Ausbildung und könnte als Modell für andere Disziplinen und Bildungskontexte dienen.
},
	file = {Asada - 2023 - The possibility of Moodle-based e-portfolio with d.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/2YWG5YYJ/Asada - 2023 - The possibility of Moodle-based e-portfolio with d.pdf:application/pdf},
}

@article{nicolaidou_virtual_2015,
	title = {A {Virtual} {Emergency} {Telemedicine} {Serious} {Game} in {Medical} {Training}: {A} {Quantitative}, {Professional} {Feedback}-{Informed} {Evaluation} {Study}},
	volume = {17},
	issn = {1438-8871},
	shorttitle = {A {Virtual} {Emergency} {Telemedicine} {Serious} {Game} in {Medical} {Training}},
	url = {http://www.jmir.org/2015/6/e150/},
	doi = {10/f7hfmd},
	abstract = {Background: Serious games involving virtual patients in medical education can provide a controlled setting within which players can learn in an engaging way, while avoiding the risks associated with real patients. Moreover, serious games align with medical students’ preferred learning styles. The Virtual Emergency TeleMedicine (VETM) game is a simulation-based game that was developed in collaboration with the mEducator Best Practice network in response to calls to integrate serious games in medical education and training. The VETM game makes use of data from an electrocardiogram to train practicing doctors, nurses, or medical students for problem-solving in real-life clinical scenarios through a telemedicine system and virtual patients. The study responds to two gaps: the limited number of games in emergency cardiology and the lack of evaluations by professionals. Objective: The objective of this study is a quantitative, professional feedback-informed evaluation of one scenario of VETM, involving cardiovascular complications. The study has the following research question: “What are professionals’ perceptions of the potential of the Virtual Emergency Telemedicine game for training people involved in the assessment and management of emergency cases?” Methods: The evaluation of the VETM game was conducted with 90 professional ambulance crew nursing personnel specializing in the assessment and management of emergency cases. After collaboratively trying out one VETM scenario, participants individually completed an evaluation of the game (36 questions on a 5-point Likert scale) and provided written and verbal comments. The instrument assessed six dimensions of the game: (1) user interface, (2) difficulty level, (3) feedback, (4) educational value, (5) user engagement, and (6) terminology. Data sources of the study were 90 questionnaires, including written comments from 51 participants, 24 interviews with 55 participants, and 379 log files of their interaction with the game.},
	language = {en-GB},
	number = {6},
	urldate = {2023-02-09},
	journal = {Journal of Medical Internet Research},
	author = {Nicolaidou, Iolie and Antoniades, Athos and Constantinou, Riana and Marangos, Charis and Kyriacou, Efthyvoulos and Bamidis, Panagiotis and Dafli, Eleni and Pattichis, Constantinos S},
	month = jun,
	year = {2015},
	keywords = {Feedback, Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, \#1:Zeitschriftenartikel:learning:management:system, Bildung, Multimedia, Krisenreaktion im Bildungsbereich, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {e150},
	annote = {1. Analyse
Hauptthemen und -ziele der Forschung: Die Studie von Nicolaidou et al. evaluiert ein Virtual Emergency Telemedicine Serious Game, das in der medizinischen Ausbildung eingesetzt wird, um Notfallbehandlungen mittels Telemedizin zu simulieren. Hauptziel ist es, das Trainingspotenzial dieses Spiels quantitativ und auf Basis professionellen Feedbacks zu bewerten, insbesondere für die Behandlung kardiovaskulärer Notfälle.
Verwendete Methoden und Datenquellen: Die Evaluation erfolgte durch 90 professionelle Notfallpflegekräfte, die das Spiel testeten und anschließend anhand eines 36-Fragen-Likert-Skalen-Fragebogens bewerteten. Zusätzlich wurden schriftliche Kommentare und Interviews zur qualitativen Feedback-Erfassung genutzt. Log-Dateien der Interaktionen mit dem Spiel wurden ebenfalls analysiert.
Zentrale Forschungsergebnisse: Das Spiel wurde in allen Dimensionen (Benutzeroberfläche, Schwierigkeitsgrad, Feedback, Bildungswert, Engagement und Terminologie) positiv bewertet, wobei das Engagement der Nutzer am höchsten bewertet wurde. Schwierigkeiten bestanden in der adäquaten Darstellung von Fachtermini und in der Ausführung bestimmter medizinischer Handlungen unter Zeitdruck.
2. Zusammenfassung
Die Studie zeigt, dass das Virtual Emergency Telemedicine Serious Game ein vielversprechendes Werkzeug zur Schulung von medizinischem Personal in der Notfallbehandlung mittels Telemedizin ist. Die positive Bewertung durch Fachkräfte unterstreicht den Bildungswert und das Engagement, das das Spiel bei den Nutzern hervorruft. Weiterhin zeigt die Studie die Notwendigkeit einer weiteren Validierung und möglicher Verbesserungen in Bezug auf Sprache und fachliche Genauigkeit.
3. Kernaussagen


"Das Spiel zeigt signifikantes Potenzial als Bildungswerkzeug in der Notfallausbildung." (S. 10)


"Die Spielinteraktion fördert das Engagement und die praktische Problemlösungsfähigkeit der Nutzer." (S. 11)


"Verbesserungsvorschläge betreffen vor allem die Terminologie und die Realitätsnähe der medizinischen Simulation." (S. 13)


4. Argumentationslinien
Die positive Resonanz der Fachkräfte unterstreicht die Effektivität des Spiels als Trainingswerkzeug, wobei das realistische Szenario und das sofortige Feedback als besonders wertvoll hervorgehoben werden. Die Kritikpunkte betreffen hauptsächlich die Sprachbarriere und die Komplexität der medizinischen Handlungen, die eine stärkere Anpassung an die realen Bedingungen erfordern.
5. Verschlagwortung


Technologieintegration: Die Integration von telemedizinischen Simulationswerkzeugen in die medizinische Ausbildung.


Lehr- und Lerneffektivität: Das hohe Maß an Engagement und die praktische Anwendung des Gelernten zeigen die Effektivität des Lehransatzes.


Systemanpassung: Anpassungen im Spiel, basierend auf dem Feedback von Nutzern, zeigen die Notwendigkeit, die Simulationsumgebung kontinuierlich zu verbessern.


Forschungsansätze: Die methodische Vorgehensweise der Evaluierung und das Feedback der Fachkräfte liefern wichtige Erkenntnisse für zukünftige Entwicklungen.


Krisenreaktion im Bildungsbereich: Die Fähigkeit des Spiels, Notfallsituationen realitätsnah zu simulieren, bereitet medizinisches Personal effektiv auf echte Notfälle vor.


},
	annote = {Die Arbeit von Nicolaidou et al. (2015) untersucht das Virtual Emergency TeleMedicine (VETM)-Spiel als Werkzeug für die medizinische Ausbildung in Notfallsituationen. Dabei werden Feedback-Mechanismen und deren pädagogischer Wert in einem technologiegestützten Kontext evaluiert. Hier ist die Bewertung der Quelle anhand deines Ansatzes von Feedback, Reflexion und Reentry:

1. Stärken der Arbeit im Vergleich zu deinem Modell
a) Feedback als Kern des Lernens


Übereinstimmung:


Feedback wird als integraler Bestandteil des VETM-Spiels angesehen, der die Lernenden direkt nach jeder Handlung informiert. Dies passt zu deinem Modell, das Feedback als initialen Impuls des Lernens betrachtet.


Das Spiel bietet „sofortiges Feedback“ und „zusammenfassende Berichte“, die den Nutzer bei der Selbstreflexion unterstützen.




b) Förderung der Reflexion


Strukturierte Reflexion:


Das Spiel ermöglicht eine Bewertung von Entscheidungen (z. B. „korrekt“ oder „fehlerhaft“), wodurch die Nutzer ihre Fehler analysieren können.


Reflexion wird durch die Spielstruktur gefördert, indem Lernende ihre Erfolge und Fehler systematisch beobachten und bewerten.




c) Potenzieller Reentry-Prozess


Anpassung durch Feed-Forward:


Das Spiel bietet „Lessons learned“-Berichte, die implizit als Vorbereitung für zukünftige Aufgaben dienen und damit einen Reentry-Prozess anstoßen könnten.


Die Nutzung ähnlicher Szenarien fördert den Wiederholungsprozess und die Integration von Lerninhalten.





2. Schwächen im Vergleich zu deinem Modell
a) Bewertung im Feedback


Unterschied zu deinem Ansatz:


Feedback im Spiel ist oft bewertend (z. B. Punktevergabe, richtig/falsch). Dein Modell betont die Neutralität von Feedback und sieht die Bewertung erst im Reflexionsprozess vor.




b) Reentry nicht explizit adressiert


Während das Spiel feed-forward-Elemente bietet, fehlt eine systematische Betrachtung, wie neue Operationen oder Verhaltensweisen langfristig in die Struktur des Lernenden integriert werden.


c) Begrenzung auf spezifischen Kontext


Die Arbeit konzentriert sich ausschließlich auf medizinische Notfallausbildung. Dein Ansatz hingegen ist universell und kann auf alle Arten von Systemen und Lernprozessen angewendet werden.



3. Gesellschaftliche und individuelle Relevanz


Die Studie zeigt, wie technologische Hilfsmittel wie VETM das Lernen in hochverantwortlichen Berufen fördern können. Dies entspricht deinem Ziel, Lernprozesse für komplexe Systeme wie medizinisches Personal zu optimieren.


Einschränkung: Die Studie adressiert keine systemischen oder emergenten Lernprozesse, sondern bleibt auf individuelle Leistungen beschränkt.



4. Fazit: Ergänzende Perspektive
Die Arbeit von Nicolaidou et al. liefert wertvolle Erkenntnisse über die Rolle von Feedback und Technologie in der medizinischen Ausbildung. Dein Modell könnte diese Perspektive erweitern, indem es:


Feedback als neutralen Impuls beschreibt.


Reflexion als umfassenderen Prozess der Bedeutungskonstruktion integriert.


Den Reentry-Prozess detailliert und universell einbindet.


Das VETM-Spiel bietet ein praktisches Beispiel für die Anwendbarkeit deines Modells in spezifischen Lernszenarien, bleibt jedoch hinter der systemischen Universalität deines Ansatzes zurück.
4o
},
	file = {Nicolaidou et al. - 2015 - A Virtual Emergency Telemedicine Serious Game in M.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/QGLYYAIW/Nicolaidou et al. - 2015 - A Virtual Emergency Telemedicine Serious Game in M.pdf:application/pdf},
}

@article{schaper_entwicklung_2020,
	title = {Entwicklung und {Validierung} eines {Modells} zur {E}-{Lehrkompetenz}},
	volume = {37},
	issn = {1424-3636},
	url = {https://www.medienpaed.com/article/view/766},
	doi = {10.21240/mpaed/37/2020.07.17.X},
	abstract = {The use of E-learning in higher education is no matter of course. Many different experiences in projects implementing E-learning at universities have demonstrated that. One of the influential factors that is responsible for the sustainable use of E-learning in higher education teaching are the competences of the university teachers to use the new media to conduct a didactically well designed course and to achieve additional values for learning and teaching using E-learning. With reference to this background and in the context of a big research and development project to spread and perpetuate E-learning at the University of Paderborn a structural competence model to describe E-teaching competences of university teachers was developed. The main goal of this model was to develop and implement measures of competence development in a needs oriented way. The competence model allows the well-founded and differentiated description of competence requirements for different E-learning scenarios and also the deduction of needs oriented competence development measures. The article describes how the structural competence model with eight dimensions, 39 sub-dimensions and 283 competence facets (including knowledge, ability and motivational/attitudinal facets) was developed and formulated with reference to theoretical conceptions of the domain and additional empirical steps. Furthermore, the model of E-teaching was validated with the help of empirical steps concerning the content, structural and criteria oriented validation of the model. The methods to raise the data and to statistically analyze them are reported to demonstrate the validation process.},
	language = {de-DE},
	urldate = {2022-03-01},
	journal = {MedienPädagogik: Zeitschrift für Theorie und Praxis der Medienbildung},
	author = {Schaper, Niclas},
	month = jul,
	year = {2020},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Weiterführung, Kompetenzentwicklung, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {313--342},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:
Die Studie von Niclas Schaper (2020) befasst sich mit der Entwicklung und Validierung eines Modells zur E-Lehrkompetenz. Ziel ist es, die spezifischen Kompetenzen von Lehrenden zu identifizieren und zu beschreiben, die erforderlich sind, um E-Learning-Elemente effektiv in die Hochschullehre zu integrieren und dabei Mehrwerte für das Lernen und Lehren zu erzielen.
Verwendete Methoden und Datenquellen:


Modellentwicklung: Das Modell wurde im Rahmen des Projekts Locomotion an der Universität Paderborn entwickelt und umfasst acht Dimensionen, 39 Subdimensionen und 283 Einzelfacetten, die Wissens-, Fähigkeits- und motivations-/einstellungsbezogene Aspekte abdecken.


Validierung: Das Modell wurde durch verschiedene empirische Schritte validiert, darunter Expert*innen-Ratings zur inhaltlichen Validität, strukturelle Validierung mittels Faktorenanalysen und kriteriumsbezogene Validierung durch Erhebung von Lehrqualität und Lernerfolg.


Zentrale Forschungsergebnisse:


Kompetenzmodell: Das entwickelte Modell beschreibt detailliert die erforderlichen Kompetenzen für unterschiedliche E-Learning-Szenarien an Hochschulen.


Inhaltliche Validierung: Expert*innen-Ratings bestätigten die Relevanz der Kompetenzfacetten für verschiedene E-Learning-Szenarien.


Strukturelle Validierung: Die Skalen zur Selbsteinschätzung der E-Lehrkompetenz zeigten zufriedenstellende bis gute Reliabilitäten.


Kriteriumsbezogene Validierung: Ein partiell vermittelter Effekt der E-Lehrkompetenz über die Lehrqualität auf den Lernerfolg wurde festgestellt.


Zusammenfassung
Die Studie zeigt, dass die Qualifizierung und Förderung von Lehrenden im Umgang mit E-Learning an Hochschulen durch ein umfassendes Kompetenzmodell unterstützt werden kann. Das Modell ermöglicht eine detaillierte Beschreibung und Erfassung der notwendigen Kompetenzen und bietet eine Grundlage für die Entwicklung bedarfsgerechter Fördermaßnahmen.
Kernaussagen


„Kompetenzen der Lehrenden, mit den neuen medialen Möglichkeiten den eigenen Unterricht didaktisch sinnvoll zu gestalten und Mehrwerte beim Lernen und Lehren zu erzielen, sind ein zentraler Faktor für den nachhaltigen Einsatz von E-Learning.“ (S. 313)


„Das Kompetenzstrukturmodell zur E-Lehrkompetenz umfasst insgesamt acht Dimensionen, 39 Subdimensionen und 283 Einzelfacetten, die in Wissen, Fähigkeiten und motivationale Aspekte unterteilt sind.“ (S. 314)


„Die Validierung des Modells zeigte, dass die im Modell beschriebenen Kompetenzfacetten handlungsrelevante Aspekte für zentrale Anwendungsszenarien des E-Learning-Einsatzes an Hochschulen widerspiegeln.“ (S. 339)


Argumentationslinien


Bedarf an E-Lehrkompetenz: Die Studie argumentiert, dass die nachhaltige Integration von E-Learning in der Hochschullehre von den Kompetenzen der Lehrenden abhängt, E-Learning didaktisch sinnvoll einzusetzen. (S. 313)


Umfassendes Kompetenzmodell: Das entwickelte Modell ermöglicht eine differenzierte Beschreibung der für verschiedene E-Learning-Szenarien erforderlichen Kompetenzen und kann zur Entwicklung bedarfsgerechter Fördermaßnahmen genutzt werden. (S. 314)


Validierungsergebnisse: Die empirischen Schritte zur Validierung des Modells belegen dessen Tragfähigkeit und Relevanz für die Praxis. (S. 327, 331)


Verschlagwortung


Lehr- und Lerneffektivität: Untersuchung der Kompetenzen, die zur effektiven Nutzung von E-Learning erforderlich sind.


Technologieintegration: Integration und Nutzung digitaler Werkzeuge und Plattformen in der Hochschullehre.


Systemanpassung: Anpassung von Lehrmethoden und -modellen an die Erfordernisse von E-Learning.


Forschungsansätze: Entwicklung und Validierung von Kompetenzmodellen zur Unterstützung der Hochschullehre.


Kategorisierung: Weiterführung
Begründung:
Die Forschung von Schaper (2020) bietet weiterführende Ideen zur systematischen Qualifizierung von Lehrenden für den Einsatz von E-Learning. Durch die detaillierte Beschreibung der erforderlichen Kompetenzen und die Validierung des Modells liefert die Studie wertvolle Erkenntnisse, die als Basis für die Entwicklung weiterer Maßnahmen und Modelle zur Förderung der E-Lehrkompetenz dienen können. Diese Vorschläge und Konzepte sind wesentliche Schritte zur Weiterentwicklung des Forschungsfeldes. Dies ist besonders relevant für die Forschungsfrage "Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems in Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?". Die Erkenntnisse und Vorschläge aus der Studie tragen dazu bei, die Mechanismen zur Förderung der E-Lehrkompetenz und deren Wirkung auf Lehrende im digitalen Bildungsraum besser zu verstehen und weiterzuentwickeln.
Kategorie: Weiterführung
},
	file = {Schaper - 2020 - Entwicklung und Validierung eines Modells zur E-Le.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/H3DFQ59R/Schaper - 2020 - Entwicklung und Validierung eines Modells zur E-Le.pdf:application/pdf},
}

@article{stunden_replicating_2021,
	title = {Replicating {Anatomical} {Teaching} {Specimens} {Using} {3D} {Modeling} {Embedded} {Within} a {Multimodal} e-{Learning} {Course}: {Pre}-{Post} {Study} {Exploring} the {Impact} on {Medical} {Education} {During} {COVID}-19},
	volume = {7},
	issn = {2369-3762},
	shorttitle = {Replicating {Anatomical} {Teaching} {Specimens} {Using} {3D} {Modeling} {Embedded} {Within} a {Multimodal} e-{Learning} {Course}},
	url = {https://mededu.jmir.org/2021/4/e30533},
	doi = {10.2196/30533},
	abstract = {Background: The COVID-19 pandemic has had significant effects on anatomy education. During the pandemic, students have had no access to cadavers, which has been the principal method of learning anatomy. We created and tested a customized congenital heart disease e-learning course for medical students that contained interactive 3D models of anonymized pediatric congenital heart defects.
Objective: The aim of this study is to assess whether a multimodal e-learning course contributed to learning outcomes in a cohort of first-year undergraduate medical students studying congenital heart diseases. The secondary aim is to assess student attitudes and experiences associated with multimodal e-learning.
Methods: The pre-post study design involved 290 first-year undergraduate medical students. Recruitment was conducted by course instructors. Data were collected before and after using the course. The primary outcome was knowledge acquisition (test scores). The secondary outcomes included attitudes and experiences, time to complete the modules, and browser metadata.
Results: A total of 141 students were included in the final analysis. Students’ knowledge significantly improved by an average of 44.6\% (63/141) when using the course (SD 1.7\%; Z=−10.287; P{\textless}.001). Most students (108/122, 88.3\%) were highly motivated to learn with the course, and most (114/122, 93.5\%) reported positive experiences with the course. There was a strong correlation between attitudes and experiences, which was statistically significant (rs=0.687; P{\textless}.001; n=122). No relationships were found between the change in test scores and attitudes (P=.70) or experiences (P=.47). Students most frequently completed the e-learning course with Chrome (109/141, 77.3\%) and on Apple macOS (86/141, 61\%) or Windows 10 (52/141, 36.9\%). Most students (117/141, 83\%) had devices with high-definition screens. Most students (83/141, 58.9\%) completed the course in {\textless}3 hours.
Conclusions: Multimodal e-learning could be a viable solution in improving learning outcomes and experiences for undergraduate medical students who do not have access to cadavers. Future research should focus on validating long-term learning outcomes.},
	language = {en-GB},
	number = {4},
	urldate = {2021-12-12},
	journal = {JMIR Medical Education},
	author = {Stunden, Chelsea and Zakani, Sima and Martin, Avery and Moodley, Shreya and Jacob, John},
	month = nov,
	year = {2021},
	keywords = {Promotion:Literaturanalyse, Promotion:Argumentation, Bildung, Multimedia, education, \#5:Zeitschriftenartikel:e-learning, 3D models, cardiac anatomy, pathologic anatomy, congenital heart disease, learning aids, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {e30533},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:
Die Studie von Stunden et al. (2021) untersucht die Auswirkungen eines multimodalen E-Learning-Kurses, der 3D-Modelle zur Darstellung von angeborenen Herzfehlern (CHD) verwendet, auf das Wissen und die Einstellung von Medizinstudierenden. Ziel ist es, die Wirksamkeit dieses E-Learning-Ansatzes im Vergleich zu herkömmlichen Methoden während der COVID-19-Pandemie zu bewerten, insbesondere angesichts der eingeschränkten Verfügbarkeit von Kadavern für anatomische Studien.
Verwendete Methoden und Datenquellen:
Die Studie verwendet ein Pre-Post-Design mit 290 Medizinstudierenden im ersten Studienjahr. Daten wurden durch Vor- und Nachtests sowie Feedback-Fragebögen gesammelt. Die primären Messgrößen waren der Wissenszuwachs (Testergebnisse) und sekundäre Messgrößen umfassten Einstellungen und Erfahrungen der Studierenden sowie die benötigte Zeit zur Absolvierung der Module und Browser-Metadaten.
Zentrale Forschungsergebnisse:
Die Ergebnisse zeigen, dass das Wissen der Studierenden nach der Teilnahme am Kurs signifikant um durchschnittlich 44,6 \% zunahm (p {\textless} .001). Die meisten Studierenden (88,3 \%) waren hoch motiviert, mit dem Kurs zu lernen, und berichteten von positiven Erfahrungen (93,5 \%). Es gab eine starke Korrelation zwischen Einstellungen und Erfahrungen der Studierenden, jedoch keine signifikante Beziehung zwischen den Testergebnissen und den Einstellungen oder Erfahrungen.
Zusammenfassung
Die Studie zeigt, dass multimodales E-Learning eine effektive Lösung sein kann, um das Lernen und die Erfahrungen von Medizinstudierenden zu verbessern, insbesondere wenn der Zugang zu Kadavern eingeschränkt ist. Die Ergebnisse unterstützen die Integration von 3D-Modellen und interaktiven Lernmaterialien in die medizinische Ausbildung.
Kernaussagen
	•	“Das Wissen der Studierenden verbesserte sich signifikant um durchschnittlich 44,6 \% durch den E-Learning-Kurs.” (S. 5)
	•	“Die meisten Studierenden waren hoch motiviert, mit dem Kurs zu lernen, und berichteten von positiven Erfahrungen.” (S. 7)
	•	“Es gab eine starke Korrelation zwischen den Einstellungen und Erfahrungen der Studierenden.” (S. 9)
Argumentationslinien
	•	Die Studie betont die Bedeutung von multimodalem E-Learning zur Überbrückung der Lücke, die durch den eingeschränkten Zugang zu Kadavern während der COVID-19-Pandemie entstanden ist.
	•	Es wird argumentiert, dass die Integration von 3D-Modellen in den Lehrplan eine effektive Methode zur Verbesserung des Wissens und der Motivation der Studierenden darstellt.
Verschlagwortung
	•	Technologieintegration: Die Nutzung von 3D-Modellen und interaktiven E-Learning-Materialien zeigt die erfolgreiche Integration moderner Technologien in die medizinische Ausbildung.
	•	Lehr- und Lerneffektivität: Die signifikanten Wissenszuwächse und positiven Rückmeldungen der Studierenden zeigen die Effektivität des E-Learning-Ansatzes.
	•	Systemanpassung: Die Studie zeigt, wie Lehrmethoden an die Herausforderungen der Pandemie angepasst werden können, um weiterhin qualitativ hochwertige Ausbildung zu gewährleisten.
	•	Krisenreaktion im Bildungsbereich: Die Untersuchung befasst sich mit den Anpassungen im Bildungsbereich während der COVID-19-Pandemie und den daraus resultierenden neuen Lehrmethoden.
Kategorie: Argumentation
Diese Studie liefert überzeugende Argumente für die Einführung und Nutzung von E-Learning in der medizinischen Ausbildung. Die positiven Ergebnisse hinsichtlich des Wissenszuwachses und der Zufriedenheit der Studierenden zeigen, dass E-Learning eine wirksame Methode zur Verbesserung des Lernens und der Erfahrungen der Studierenden sein kann, besonders unter den Herausforderungen der COVID-19-Pandemie.
},
	file = {Stunden et al. - 2021 - Replicating Anatomical Teaching Specimens Using 3D.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/QCG8LK7C/Stunden et al. - 2021 - Replicating Anatomical Teaching Specimens Using 3D.pdf:application/pdf},
}

@article{barteit_how_2018,
	title = {How {Self}-{Directed} e-{Learning} {Contributes} to {Training} for {Medical} {Licentiate} {Practitioners} in {Zambia}: {Evaluation} of the {Pilot} {Phase} of a {Mixed}-{Methods} {Study}},
	volume = {4},
	issn = {2369-3762},
	shorttitle = {How {Self}-{Directed} e-{Learning} {Contributes} to {Training} for {Medical} {Licentiate} {Practitioners} in {Zambia}},
	url = {http://mededu.jmir.org/2018/2/e10222/},
	doi = {10.2196/10222},
	abstract = {Background: Zambia faces a severe shortage of health workers, particularly in rural areas. To tackle this shortage, the Medical Licentiate program was initiated at Chainama College of Health Sciences in the capital, Lusaka, in 2002. The objective of the program was to alleviate the shortage of human resources in curative care. On-the-job training is conducted in decentralized teaching hospitals throughout Zambia. However, the program faces significant challenges such as shortages of senior medical instructors and learning materials.
Objective: Our aim was to address these challenges by introducing a self-directed, e-learning platform with an offline tablet as part of a collaborative blended-learning intervention to supplement local teaching and training.
Methods: The pilot phase of the e-learning platform was evaluated using a mixed-methods approach with a convergent parallel design. Various methods were employed to test the data’s adequacy and potential for generating valid results. Methods included questionnaires according to the technology acceptance model and information system success model by DeLone and McLean, semistructured interviews, learner diaries, pretesting, the collection of usage data, exam results, demographics, and informal feedback. Outcome measures included usage, adoption, efficiency, acceptance, user-friendliness, and gained knowledge and skills.
Results: In total, 52 students and 17 medical instructors participated in the pilot evaluation. The questionnaire results showed a high acceptance of the technology ({\textgreater}80\%) and high agreement ({\textgreater}75\%) with the e-learning platform. Semistructured interview results showed an overall appreciation of the e-learning intervention, but the need for more e-learning materials. Respondents identified a need for multimedia materials that transfer skills such as medical procedure visualization and interactive exercises to practice procedural knowledge. The learning diaries identified the lack of specific learning materials and potential shortcomings of existing learning materials. However, students were satisfied with the current e-learning content. The majority of students used the e-learning platform offline on their tablets; online e-learning was underutilized.
Conclusions: The pilot phase of the tablet-based e-learning platform to support the self-directed learning intervention was well received and appreciated by students and medical instructors of Chainama College of Health Sciences. E-learning for knowledge acquisition appears to be adequate and feasible for this low-resource educational environment. Our evaluation results guide the further development of the full implementation of the e-learning platform in this educational setting. E-learning materials should reflect curriculum requirements, and additional multimedia and interactive content is needed, as well as improved integration and active participation from medical instructors in the e-learning processes.},
	language = {en-GB},
	number = {2},
	urldate = {2021-11-12},
	journal = {JMIR Medical Education},
	author = {Barteit, Sandra and Jahn, Albrecht and Bowa, Annel and Lüders, Sigrid and Malunga, Gregory and Marimo, Clemence and Wolter, Sigrid and Neuhann, Florian},
	month = nov,
	year = {2018},
	note = {ZSCC: NoCitationData[s0]},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, Promotion:FU5, Bildung, Multimedia, Digitale Bildung, evaluation, effectiveness, \#5:Zeitschriftenartikel:e-learning, adoption, health care workers, intervention, rural health, sub-Saharan Africa, sustainability, Promotion:S:05 E-Learning, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {e10222},
	annote = {Analyse des Artikels „How Self-Directed e-Learning Contributes to Training for Medical Licentiate Practitioners in Zambia: Evaluation of the Pilot Phase“ von Barteit et al. (2018)

1. Hauptthemen und Ziele der Forschung
Der Artikel untersucht die Einführung und Evaluation einer E-Learning-Plattform für medizinische Ausbildungsprogramme in ressourcenarmen Regionen. Ziel ist es, die Effektivität, Akzeptanz und Herausforderungen eines selbstgesteuerten E-Learning-Systems zur Unterstützung der Ausbildung von Medical Licentiate Practitioners (MLs) in Sambia zu bewerten.

2. Methoden und Datenquellen


Design:


Mixed-Methods-Ansatz mit konvergentem parallelem Design.


Kombination aus qualitativen und quantitativen Methoden zur Evaluierung der Plattform.




Datenquellen:


Fragebögen basierend auf dem Technology Acceptance Model (TAM) und dem Information System Success Model (IS).


Semistrukturierte Interviews mit Studierenden und Dozierenden.


Lerntagebücher, Nutzungsstatistiken und Testergebnisse vor und nach der Intervention.




Evaluation:


Erhebung der Akzeptanz, Effizienz, Benutzerfreundlichkeit und Wissenszuwächse durch Pre- und Posttests sowie qualitative Feedbacks.





3. Zentrale Forschungsergebnisse


Akzeptanz und Nutzung:


Hohe Akzeptanz der Technologie ({\textgreater}80 \%) bei Studierenden und Dozierenden.


Offline-Nutzung der Plattform auf Tablets dominierte aufgrund mangelnder Internetverfügbarkeit.




Herausforderungen:


Mangel an multimedialen Lernmaterialien und technischem Support.


Eingeschränkte Nutzung durch fehlende SIM-Karten und geringes Engagement der Lehrenden.




Wissenszuwachs:


Positive Rückmeldungen zur Integration der E-Learning-Plattform in den Ausbildungsalltag, jedoch keine signifikanten Korrelationen zwischen Nutzung und Testergebnissen.




Empfehlungen:


Verbesserung der Qualität und Quantität der Inhalte, stärkere Einbindung der Dozierenden und nachhaltige IT-Infrastruktur.





Zusammenfassung
Die Pilotphase zeigt, dass selbstgesteuertes E-Learning in ressourcenarmen Regionen eine praktikable Methode zur Unterstützung medizinischer Ausbildungen darstellt. Die Plattform wurde gut angenommen, zeigte jedoch Schwächen bei der Bereitstellung interaktiver Materialien und der technischen Unterstützung.

Kernaussagen


Hohe Akzeptanz:


Studierende und Dozierende bewerteten die Plattform als benutzerfreundlich und hilfreich (S. 4).




Technische Herausforderungen:


Offline-Zugang und begrenzte technische Unterstützung beeinträchtigten die Effizienz der Nutzung (S. 10).




Integration in den Lernprozess:


Die Plattform erleichterte die Integration von Theorie und Praxis im klinischen Alltag (S. 11).





Argumentationslinien


Technologie als Zugang zu Bildung:


E-Learning bietet eine flexible Lösung für Bildung in Regionen mit eingeschränkten Ressourcen.




Notwendigkeit von Multimedia:


Die Integration von interaktiven und multimedialen Inhalten wird als essenziell für den langfristigen Erfolg hervorgehoben.




Nachhaltigkeit durch Training:


Ein stärkeres Engagement der Dozierenden und nachhaltige IT-Infrastrukturen sind entscheidend für die langfristige Implementierung.





Verschlagwortung


Technologieintegration:


Begründung: Der Artikel analysiert die Nutzung einer E-Learning-Plattform und deren Auswirkungen auf den Bildungsprozess.




Lehr- und Lerneffektivität:


Begründung: Fokus auf die Evaluierung der Effizienz und Akzeptanz der Plattform bei medizinischen Fachkräften.




Systemanpassung:


Begründung: Empfehlungen zur Anpassung der Plattform an die Bedürfnisse der Zielgruppe und an technische Gegebenheiten.





Kategorisierung
Kategorie: ArgumentationBegründung: Die Studie entwickelt eine fundierte Argumentation für den Nutzen und die Herausforderungen selbstgesteuerten E-Learnings in ressourcenarmen Regionen.

Zuordnung zur Forschungsunterfrage
Passendste Forschungsunterfrage:FU5:„Welche Möglichkeiten und Grenzen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems durch Akteure im digitalen Bildungsraum von Gesundheitsberufen analysiert?“
Begründung:Die Untersuchung analysiert die Potenziale und Herausforderungen eines LMS in einem spezifischen medizinischen Kontext und bietet praktische Empfehlungen zur Anpassung an ressourcenarme Umgebungen.

Relevanzbewertung


Relevanz: 5Die Studie liefert praxisnahe und empirisch fundierte Erkenntnisse zur Implementierung und Anpassung von E-Learning-Systemen in der medizinischen Aus- und Weiterbildung.


},
	file = {Barteit et al. - 2018 - How Self-Directed e-Learning Contributes to Traini.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/EVJQJRPU/Barteit et al. - 2018 - How Self-Directed e-Learning Contributes to Traini.pdf:application/pdf},
}

@article{de_leeuw_how_2019,
	title = {How {We} {Evaluate} {Postgraduate} {Medical} {E}-{Learning}: {Systematic} {Review}},
	volume = {5},
	issn = {2369-3762},
	shorttitle = {How {We} {Evaluate} {Postgraduate} {Medical} {E}-{Learning}},
	url = {http://mededu.jmir.org/2019/1/e13128/},
	doi = {10.2196/13128},
	abstract = {Background: Electronic learning (e-learning) in postgraduate medical education has seen a rapid evolution; however, we tend to evaluate it only on its primary outcome or learning aim, whereas its effectiveness also depends on its instructional design. We believe it is important to have an overview of all the methods currently used to evaluate e-learning design so that the preferred method may be identified and the next steps needed to continue to evaluate postgraduate medical e-learning may be outlined.
Objective: This study aimed to identify and compare the outcomes and methods used to evaluate postgraduate medical e-learning.
Methods: We performed a systematic literature review using the Web of Science, PubMed, Education Resources Information Center, and Cumulative Index of Nursing and Allied Health Literature databases. Studies that used postgraduates as participants and evaluated any form of e-learning were included. Studies without any evaluation outcome (eg, just a description of e-learning) were excluded.
Results: The initial search identified 5973 articles, of which we used 418 for our analysis. The types of studies were trials, prospective cohorts, case reports, and reviews. The primary outcomes of the included studies were knowledge, skills, and attitude. A total of 12 instruments were used to evaluate a specific primary outcome, such as laparoscopic skills or stress related to training. The secondary outcomes mainly evaluated satisfaction, motivation, efficiency, and usefulness. We found 13 e-learning design methods across 19 studies (4\% 19/418). The methods evaluated usability, motivational characteristics, and the use of learning styles or were based on instructional design theories, such as Gagne’s instructional design, the Heidelberg inventory, Kern’s curriculum development steps, and a scale based on the cognitive load theory. Finally, 2 instruments attempted to evaluate several aspects of a design, based on the experience of creating e-learning.
Conclusions: Evaluating the effect of e-learning design is complicated. Given the diversity of e-learning methods, there are many ways to carry out such an evaluation, and probably, many ways to do so correctly. However, the current literature shows us that we have yet to reach any form of consensus about which indicators to evaluate. There is a great need for an evaluation tool that is properly constructed, validated, and tested. This could be a more homogeneous way to compare the effects of e-learning and for the authors of e-learning to continue to improve their product.},
	language = {en-GB},
	number = {1},
	urldate = {2021-11-12},
	journal = {JMIR Medical Education},
	author = {de Leeuw, Robert and de Soet, Anneloes and van der Horst, Sabine and Walsh, Kieran and Westerman, Michiel and Scheele, Fedde},
	month = apr,
	year = {2019},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, Datenschutz und IT-Sicherheit, Promotion:FU3, distance education, \#5:Zeitschriftenartikel:e-learning, learning, professional education, Promotion:S:05 E-Learning, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {e13128},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:
Die Studie von de Leeuw et al. (2019) untersucht die verschiedenen Methoden und Ergebnisse, die zur Bewertung von E-Learning in der postgradualen medizinischen Ausbildung (PGMeL) verwendet werden. Ziel der Forschung ist es, einen umfassenden Überblick über die derzeit verwendeten Evaluationsmethoden zu geben und die am häufigsten bewerteten Ergebnisse zu identifizieren.
Verwendete Methoden und Datenquellen:


Design: Systematische Literaturübersicht.


Datenquellen: Web of Science, PubMed, Education Resources Information Center, und Cumulative Index of Nursing and Allied Health Literature.


Einschlusskriterien: Studien, die postgraduale Teilnehmer einbeziehen und irgendeine Form von E-Learning evaluieren.


Ausschlusskriterien: Studien ohne Evaluationsausgang (z. B. nur Beschreibung von E-Learning).


Zentrale Forschungsergebnisse:


Primäre Ergebnisse: Wissen (n=286), Fähigkeiten (n=130), und Einstellungen (n=2).


Sekundäre Ergebnisse: Zufriedenheit (n=99), Selbstwirksamkeit (n=60), Einhaltung in der Praxis (n=33), und Zeitaufwand (n=32).


Evaluationsmethoden: 13 verschiedene Evaluationsmethoden, darunter Gagnes Instruktionsdesign, das Heidelberg Inventar, Kern’s Curriculum-Entwicklungsschritte und eine Skala basierend auf der kognitiven Last-Theorie.


Zusammenfassung
Die Studie zeigt, dass die Bewertung des Designs von E-Learning-Komponenten komplex ist und dass es viele verschiedene Ansätze zur Durchführung solcher Bewertungen gibt. Es gibt keinen Konsens darüber, welche Indikatoren evaluiert werden sollten, was die Vergleichbarkeit der Ergebnisse erschwert. Es besteht ein dringender Bedarf an einem validierten Evaluationsinstrument, das eine einheitlichere Bewertung der Auswirkungen von E-Learning ermöglicht.
Kernaussagen


„Die Evaluierung des Designs von E-Learning-Komponenten ist komplex und es gibt viele verschiedene Ansätze, dies korrekt durchzuführen.“ (S. 9)


„Es besteht ein dringender Bedarf an einem validierten Evaluationsinstrument, um die Vergleichbarkeit der Auswirkungen von E-Learning zu verbessern.“ (S. 10)


„Die primären Ergebnisse der Studien umfassten Wissen, Fähigkeiten und Einstellungen, während die sekundären Ergebnisse Zufriedenheit, Selbstwirksamkeit und Einhaltung in der Praxis umfassten.“ (S. 5)


Argumentationslinien


Vielfalt der Evaluationsmethoden: Die Studie argumentiert, dass die Vielfalt der verwendeten Evaluationsmethoden und -ergebnisse die Vergleichbarkeit und Validität der Ergebnisse erschwert. (S. 4-5)


Bedarf an standardisierten Instrumenten: Es wird betont, dass ein standardisiertes und validiertes Evaluationsinstrument notwendig ist, um die Wirkung von E-Learning-Programmen zu bewerten und zu vergleichen. (S. 9-10)


Fokus auf primäre und sekundäre Ergebnisse: Die Studie zeigt, dass primäre Ergebnisse (z. B. Wissen und Fähigkeiten) häufiger bewertet werden als sekundäre Ergebnisse (z. B. Zufriedenheit und Selbstwirksamkeit). (S. 5-6)


Verschlagwortung


Lehr- und Lerneffektivität: Untersuchung der Wirksamkeit und Evaluationsmethoden von E-Learning-Programmen in der postgradualen medizinischen Ausbildung.


Forschungsansätze: Systematische Literaturübersicht zur Identifikation und Analyse von Evaluationsmethoden.


Technologieintegration: Evaluierung von E-Learning-Tools und deren Effektivität in der medizinischen Ausbildung.


Systemanpassung: Anpassung der Evaluationsmethoden an die spezifischen Anforderungen und Herausforderungen der postgradualen medizinischen Ausbildung.


Datenschutz und IT-Sicherheit: Überprüfung der Verwendung sicherer und zuverlässiger Evaluationsinstrumente.


Kategorisierung: Argumentation
Begründung:
Die Studie von de Leeuw et al. (2019) verwendet verschiedene Quellen und Theorien, um die Vielfalt der derzeit verwendeten Evaluationsmethoden und -ergebnisse zu unterstützen. Durch die systematische Analyse der Literatur wird argumentiert, dass ein standardisiertes und validiertes Evaluationsinstrument notwendig ist, um die Wirkung von E-Learning-Programmen zu bewerten. Diese Argumentationslinien sind besonders relevant für die Forschungsfragen des Exposés, da sie die theoretischen und praktischen Aspekte der Evaluierung von E-Learning-Methoden im digitalen Bildungsraum beleuchten.
Kategorie: Argumentation
Zuordnung zur Forschungsfrage
FU3: Wie sind Konzeption und relevante didaktische und bildungstechnologische Merkmale des systemisch-konstruktivistischen Learning-Management-Systems für Akteure im digitalen Bildungsraum von Gesundheitsberufen dargestellt?
Begründung:
Die Studie untersucht die Konzeption und relevanten didaktischen sowie bildungstechnologischen Merkmale der verschiedenen Evaluationsmethoden und -ergebnisse von E-Learning-Programmen. Diese Erkenntnisse sind besonders relevant, um die Konzeption und Implementierung von Learning-Management-Systemen (LMS) zu verstehen und zu optimieren. Die Argumentation der Studie unterstützt die Notwendigkeit, die Systeme an die spezifischen Anforderungen und Herausforderungen der digitalen Bildungsräume im Gesundheitswesen anzupassen.
},
	file = {de Leeuw et al. - 2019 - How We Evaluate Postgraduate Medical E-Learning S.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/G36NPDAM/de Leeuw et al. - 2019 - How We Evaluate Postgraduate Medical E-Learning S.pdf:application/pdf},
}

@article{forster_how_2021,
	title = {How to {Plan} and {Perform} {E}-{Learning} in {Family} {Medicine} {Vocational} {Training}},
	abstract = {As of the start of the COVID-19-pandemic, basis undergraduate, postgraduate as well as continuous medical education had often been switched to e-learning. This is a chance and a challenge at the same time. In this work, we describe the e-learning experiences of the competence center for postgraduate medical education in Baden-Württemberg. We aim to support broad implementation of e-learning by the exchange of educational as well as organizational approaches. In March 2020, we planned synchronic (live) webinars with asynchronic preparation and postprocessing (flipped classroom). We focused on elements to improve interaction. All the process was managed with respect to the program curriculum in a multicentered team. In 2020, n = 263 postgraduate trainees in family medicine (FM trainees) participated in n = 12 online single seminar days of the KWBW Verbundweiterbildungplus. Due to multiple participation, they induced n = 379 participations. N = 353 evaluations could be included (93,1 \% response rate). 77 \% (n = 182/236) assessed the use of the software Zoom® with satisfying or very satisfying, 75 \% (n = 122/163) the use of the software Heiconf® with satisfying or very satisfying. 59 \% (n = 208) wanted to continue with seminar days during workdays, whereas 26 \% (n = 91) wished for trainings on Saturdays. A technical check was rated as very helpful. From the organizational point of view, an additional lecturer (= moderator) was necessary. Some lecturers needed extra support in advance of the e-learning. We provide didactic elements that can help to improve the interaction between participants which have to be planned ahead. We present a successful approach to face the educational and organizational challenges of e-learning. E-learning was broadly accepted which supports permanent implementation. However, social and collegial interaction is both, most challenging and most important for postgraduate training in family medicine. Therefore, approaches supporting the interaction in e-learning should be developed and implemented.},
	language = {de-DE},
	journal = {Zeitschrift für Allgemeinmedizin},
	author = {Förster, Christian and Eismann-Schweimler, Jessica and Stengel, Sandra and Bischoff, Martina and Fuchs, Monika and Graf, Andreas},
	year = {2021},
	note = {ZSCC: NoCitationData[s0]},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, Promotion:FH, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {9},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:
Die Studie von Förster et al. (2021) beschreibt die Planung und Durchführung von E-Learning in der allgemeinmedizinischen Weiterbildung im Rahmen des KWBW-Verbundweiterbildungplus-Programms während der COVID-19-Pandemie. Ziel der Studie ist es, die Erfahrungen bei der Umstellung von Präsenzseminaren auf digitale Formate zu dokumentieren und didaktische sowie organisatorische Empfehlungen zu geben.
Verwendete Methoden und Datenquellen:
	•	Design: Werkstattbericht und empirische Evaluation
	•	Datenquellen: Umfragen und Feedback von Teilnehmerinnen und Referentinnen
	•	Evaluationsmethoden: Online-Umfragen und semi-strukturierte Interviews
Zentrale Forschungsergebnisse:
	•	Nutzung und Akzeptanz: Die E-Learning-Formate wurden von den Ärzt*innen in Weiterbildung (ÄiW) gut angenommen, mit einer Teilnahmequote von 93,1\% an der Evaluation.
	•	Didaktische und organisatorische Herausforderungen: Notwendigkeit von Doppelmoderation, Technik-Checks und die Anpassung der Seminarthemen an die Online-Formate.
	•	Interaktive Elemente: Nutzung von Tools wie TED-Umfragen, virtuellen Gruppenräumen und der Flipped-Classroom-Methode zur Förderung der Interaktivität.
Zusammenfassung
Die Studie zeigt, dass die Umstellung auf E-Learning in der allgemeinmedizinischen Weiterbildung erfolgreich umgesetzt wurde. Die Teilnehmer*innen bewerteten die Online-Seminare positiv, und die didaktischen Methoden, insbesondere der Flipped Classroom und interaktive Tools, trugen zur Effektivität der Seminare bei. Technische Unterstützung und Doppelmoderation erwiesen sich als notwendig für den reibungslosen Ablauf.
Kernaussagen
	•	„Die E-Learning-Formate wurden von den Ärzt*innen in Weiterbildung (ÄiW) gut angenommen, mit einer Teilnahmequote von 93,1\% an der Evaluation.“ (S. 319)
	•	„Die Nutzung von Tools wie TED-Umfragen, virtuellen Gruppenräumen und der Flipped-Classroom-Methode förderte die Interaktivität.“ (S. 321)
	•	„Technische Unterstützung und Doppelmoderation erwiesen sich als notwendig für den reibungslosen Ablauf.“ (S. 322)
Argumentationslinien
	•	Positive Akzeptanz: Die hohe Teilnahmequote und die positive Bewertung durch die ÄiW zeigen, dass E-Learning ein effektives Format für die allgemeinmedizinische Weiterbildung sein kann. (S. 319)
	•	Interaktive Didaktik: Die Verwendung von interaktiven Tools und Methoden wie Flipped Classroom förderte das Engagement und den Lernerfolg der Teilnehmer*innen. (S. 321)
	•	Notwendigkeit technischer Unterstützung: Die Studie betont die Bedeutung von Technik-Checks und Doppelmoderation, um technische Probleme zu minimieren und den Ablauf der Seminare zu sichern. (S. 322)
Verschlagwortung
	•	Lehr- und Lerneffektivität: Untersuchung der Effektivität von E-Learning-Formaten in der allgemeinmedizinischen Weiterbildung.
	•	Technologieintegration: Nutzung und Bewertung von Webkonferenzplattformen und interaktiven Tools zur Unterstützung der Weiterbildung.
	•	Systemanpassung: Anpassung der Seminarthemen und Lehrmethoden an die Online-Formate.
	•	Forschungsansätze: Empirische Evaluation der Umstellung auf E-Learning im Rahmen eines Weiterbildungsprogramms.
Kategorisierung: Argumentation
Begründung:
Die Studie von Förster et al. (2021) liefert umfassende Argumente für die erfolgreiche Implementierung und Akzeptanz von E-Learning-Formaten in der allgemeinmedizinischen Weiterbildung. Die positiven Bewertungen und die hohe Teilnahmequote unterstützen die These, dass E-Learning eine effektive Alternative zu Präsenzseminaren sein kann, insbesondere in Zeiten der COVID-19-Pandemie. Diese Argumentationslinien sind besonders relevant für die Forschungsfragen des Exposés, da sie die praktischen Aspekte der Implementierung und Optimierung von E-Learning im digitalen Bildungsraum beleuchten.
Kategorie: Argumentation
Zuordnung zur Forschungsfrage
FH: Wie ist das Wirkgefüge des angewendeten Learning-Management-Systems auf Akteure im digitalen Bildungsraum von Gesundheitsberufen gestaltet?
Begründung:
Die Studie untersucht die Implementierung und Auswirkungen von E-Learning-Formaten im Rahmen eines Weiterbildungsprogramms und analysiert die didaktischen und organisatorischen Mechanismen, die die Effektivität und Akzeptanz beeinflussen. Diese Erkenntnisse sind besonders relevant, um das Wirkgefüge eines Learning-Management-Systems im digitalen Bildungsraum von Gesundheitsberufen zu verstehen und zu optimieren.
},
	file = {Förster et al. - 2021 - How to Plan and Perform E-Learning in Family Medic.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/WG22QSLK/Förster et al. - 2021 - How to Plan and Perform E-Learning in Family Medic.pdf:application/pdf},
}

