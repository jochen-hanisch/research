@article{nguyen_impact_2025,
	title = {The impact of community of inquiry on university students’ behavioral intention towards blended learning in {Vietnam}: the moderating of “understanding {Covid}-19”},
	volume = {12},
	copyright = {https://creativecommons.org/licenses/by-nc-nd/4.0},
	issn = {2662-9992},
	shorttitle = {The impact of community of inquiry on university students’ behavioral intention towards blended learning in {Vietnam}},
	url = {https://www.nature.com/articles/s41599-025-04930-9},
	doi = {10.1057/s41599-025-04930-9},
	language = {en},
	number = {1},
	urldate = {2025-07-07},
	journal = {Humanities and Social Sciences Communications},
	publisher = {Springer Science and Business Media LLC},
	author = {Nguyen, Duc Trung and Tran, Van Dat},
	month = jul,
	year = {2025},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:FU4a, Promotion:Kerngedanke, Promotion:Relevanz:5, Systemanpassung, Bildungstheorien, \#8:Zeitschriftenartikel:blended:learning, Promotion:S:08 Blended Learning, Promotion:Literaturverzeichnis},
	annote = {Analyse der Studie „The impact of community of inquiry on university students’ behavioral intention towards blended learning“ von Nguyen \& Tran (2025)

1. Hauptthemen und Ziele der Forschung
Die Studie von Nguyen und Tran (2025) untersucht, inwiefern die „Community of Inquiry“ (CoI) – bestehend aus sozialer, kognitiver und lehrender Präsenz – das wahrgenommene Lernen, die Zufriedenheit und die Verhaltensabsicht zur Nutzung von Blended Learning bei Universitätsstudierenden beeinflusst. Ziel ist es, die theoretischen Annahmen der CoI zu überprüfen und deren Rolle in der digitalen Hochschullehre zu modellieren.

2. Methoden und Datenquellen


Methodik: Strukturgleichungsmodellierung (SEM) mit SmartPLS


Datenbasis: 382 vollständig ausgefüllte Fragebögen von Studierenden vietnamesischer Universitäten


Messinstrumente: Validierte Skalen zur Messung der drei CoI-Komponenten sowie Zufriedenheit, wahrgenommenes Lernen und Verhaltensabsicht



3. Zentrale Forschungsergebnisse


Starke positive Effekte der lehrenden und sozialen Präsenz auf die kognitive Präsenz (S. 7)


Kognitive Präsenz wirkt sich signifikant auf das wahrgenommene Lernen und die Zufriedenheit aus (S. 8)


Sowohl Zufriedenheit als auch wahrgenommenes Lernen korrelieren stark mit der Verhaltensabsicht, Blended Learning weiter zu nutzen (S. 9)


Lehrende Präsenz hat einen indirekten Einfluss auf die Verhaltensintention – vermittelt über kognitive Präsenz und Zufriedenheit (S. 10)



4. Zusammenfassung
Die Studie belegt die zentrale Bedeutung der Community of Inquiry für den Erfolg und die Akzeptanz von Blended-Learning-Formaten. Lehrende, soziale und kognitive Präsenz sind Schlüsselfaktoren, die sich signifikant auf Lernwahrnehmung, Zufriedenheit und Nutzungsbereitschaft auswirken. Damit liefert die Studie einen theoretisch fundierten Rahmen für die Gestaltung digitaler Lernumgebungen.

5. Kernaussagen


“Teaching presence strongly affects cognitive presence” (S. 7)


“Cognitive presence influences perceived learning and satisfaction” (S. 8)


“Perceived learning and satisfaction are significant predictors of behavioral intention” (S. 9)


“Social presence indirectly impacts behavioral intention via satisfaction” (S. 10)



6. Argumentationslinien


Die Autoren beginnen mit einer theoretischen Fundierung des CoI-Modells (S. 2–3).


Anschließend wird die Beziehung zwischen den Präsenzformen empirisch geprüft, wobei insbesondere kognitive Präsenz als vermittelnde Variable fungiert (S. 6–8).


Die Ergebnisse werden in einem strukturmodelltheoretischen Pfadmodell dargestellt, das kausale Beziehungen verdeutlicht (S. 8–9).


Daraus leiten die Autor*innen implizite Handlungsempfehlungen für die Gestaltung von Blended-Learning-Settings ab (S. 10).



7. Verschlagwortung


BildungstheorienBegründung: Die Studie operationalisiert und testet das theoretisch fundierte Community of Inquiry-Modell, das ein zentrales Rahmenwerk zur Analyse digitaler Lernräume ist.


Lehr- und LerneffektivitätBegründung: Es werden Wirkzusammenhänge zwischen Lehrdesign (lehrende Präsenz), Lernprozessen (kognitive Präsenz) und Lerneffektivität (wahrgenommenes Lernen) modelliert.


ForschungsansätzeBegründung: Es wird ein quantitatives, hypothesenprüfendes Forschungsdesign mit SEM eingesetzt, das methodisch anspruchsvoll und gut dokumentiert ist.


SystemanpassungBegründung: Die Ergebnisse liefern Anhaltspunkte für die gezielte Ausgestaltung von Blended-Learning-Systemen im Sinne differenzierter Präsenzdimensionen.



8. Kategorisierung
Kerngedanke

Die Wirkung digitaler Lernsysteme hängt maßgeblich von der Integration und Balance der drei Präsenzformen des Community-of-Inquiry-Modells ab. Besonders kognitive Präsenz stellt eine vermittelnde Instanz zwischen Lehrintervention und nachhaltigem Lernerfolg dar. (vgl. S. 7–10)


9. Zuordnung zur passenden Forschungsunterfrage
FU4a

Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?

Begründung:Die Studie beschreibt die kognitiven und sozialen Mechanismen (kognitive, soziale, lehrende Präsenz), die Lernerfahrungen strukturieren. Diese theoretisch fundierten Mechanismen sind auch für die Gestaltung systemisch-konstruktivistischer LMS im Gesundheitsbereich hochrelevant.

10. Relevanzbewertung


Direkte Relevanz: 5


Theoriebezug: 5


Anwendungsbezug auf Lernräume in Gesundheitsberufen übertragbar: 4


Gesamtbewertung: 5 – hoch relevant
},
	file = {PDF:/Users/jochenhanisch-johannsen/Zotero/storage/54ZVR2AC/Nguyen und Tran - 2025 - The impact of community of inquiry on university students’ behavioral intention towards blended lear.pdf:application/pdf},
}

@article{hansen_typology_2025,
	title = {A typology of bureaucratic education tools: uncovering the relational complexity of large language models},
	copyright = {http://creativecommons.org/licenses/by/4.0/},
	issn = {0142-5692, 1465-3346},
	shorttitle = {A typology of bureaucratic education tools},
	url = {https://www.tandfonline.com/doi/full/10.1080/01425692.2025.2519488},
	doi = {10.1080/01425692.2025.2519488},
	abstract = {Generative artificial intelligence products are often heralded as a solution to the problems of education bureaucracies by providing individualised learning opportunities in a cost-effective way. We posit that this claim has not been critically examined from a relational and material sociological perspective. In this conceptual paper we therefore mobilise a relational and material sociology to query the relational potentials of large language models (LLMs) as compared to more traditional education tools. We conclude that the appeal of LLM tools like ChatGPT resides in their seemingly endless mutability, i.e. the tools appear to change to respond to their users’needs. The relational challenge is to ensure that this apparent movement on the part of the tool does not lead to stasis on the part of the learner. Our discussion brings to the fore the often forgotten cognitive and pedagogical functions of seemingly‘dumb’and static learning tools.},
	language = {en},
	urldate = {2025-07-12},
	journal = {British Journal of Sociology of Education},
	publisher = {Informa UK Limited},
	author = {Hansen, Morten and Carrigan, Mark},
	month = jun,
	year = {2025},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Forschungsansätze, Promotion:FU4a, Promotion:Kerngedanke, Technologieintegration, Systemanpassung, Bildungstheorien, Promotion:Relevanz:4, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {1--17},
	annote = {Analyse der Studie „A typology of bureaucratic education tools: uncovering the relational complexity of large language models“ von Hansen \& Carrigan (2025)

1. Hauptthemen und Ziele der Forschung
Die Studie von Hansen und Carrigan (2025) entwickelt eine differenzierte Typologie von Bildungstools und untersucht, wie digitale Systeme – insbesondere Large Language Models (LLMs) wie ChatGPT – in bürokratische Bildungskontexte eingebettet werden. Ziel ist es, mithilfe einer relationalen und materialistischen Perspektive die Komplexität der Mensch-Technik-Relationen zu beleuchten und aufzuzeigen, welche pädagogischen Implikationen aus der spezifischen Einbindung von LLMs in institutionelle Strukturen entstehen.

2. Methoden und Datenquellen


Forschungsdesign: Theoretisch-konzeptionell; keine empirische Datenerhebung.


Theorierahmen:


Relationale Soziologie (Crossley, Donati, Archer)


Material Turn in der Bildung (z. B. Latour, Arendt, Crawford)


Kritische Technik- und Bürokratieforschung




Analytischer Zugang:


Entwicklung einer Typologie dreier Bildungstools:


Fixed Tools (z. B. Whiteboard, Lehrbuch)


Automated Tools (z. B. Lernplattformen mit festen Pfaden)


Mutable Tools (z. B. LLMs, Chatbots)







3. Zentrale Forschungsergebnisse


Toolwirkungen sind relational: Werkzeuge entfalten ihre pädagogische Wirkung nicht in sich selbst, sondern im Zusammenspiel mit Subjekten, Konventionen und institutionellen Settings.


LLMs als „mutable tools“ erzeugen ein scheinbares Gefühl von Flexibilität, können jedoch reflexive Bildungsprozesse untergraben, wenn sie Effizienz über Relationalität stellen.


Warnung vor „technokratischem Lösungsglauben“: LLMs können bestehende strukturelle Defizite in der Bildung kaschieren, statt sie zu adressieren.


Tafel als widerständiges Medium: In der Gegenüberstellung erscheint z. B. die klassische Tafel als Werkzeug, das durch seine Sperrigkeit gerade zur Reflexion und relationalen Aushandlung zwingt.



4. Zusammenfassung
Hansen und Carrigan (2025) präsentieren eine theoretisch fundierte Typologie von Bildungstechnologien im bürokratischen Kontext. Anhand der Unterscheidung zwischen fixed, automated und mutable tools zeigen sie auf, dass die zunehmende Implementierung von LLMs eine Verschiebung in der pädagogischen Beziehung zwischen Lernenden, Lehrenden und Technologie bedeutet. Sie argumentieren, dass diese Tools – trotz ihrer scheinbaren Offenheit – Risiken für die Selbstbildung und Relationalität bergen, insbesondere wenn sie in bestehende bürokratische Steuerungslogiken eingebunden sind.

5. Kernaussagen (mit Fundstellen)


„What kind of jig are LLMs presented to be?“ – Die Autor*innen hinterfragen die handlungsleitenden Rahmen, in die LLMs eingebettet werden (S. 11).


„Mutable tools may in fact perpetuate relational evils by making the lack of student agency and learning less visible.“ (S. 14).


„Automated tools relieve the teacher from relational friction – but at the cost of pedagogical meaning-making.“ (S. 12).


„The relation is the site of education, not the tool.“ – Betonung der relationalen Bedingtheit von Bildung (S. 7).



6. Argumentationslinien


Ausgangspunkt: Wachsende Integration digitaler Tools in Bildungssysteme.


Kritische Reflexion: Technik wird häufig als neutrale, nützliche Erweiterung verstanden – dies greift zu kurz.


Typologie: Die Einteilung in fixed, automated und mutable tools macht sichtbar, dass Tools pädagogische Relationen präfigurieren.


LLMs als ambivalente Werkzeuge: Sie versprechen individuelle Passung, können aber strukturelle Entfremdung fördern.


Schlussfolgerung: Bildungsprozesse müssen relational gedacht und gestaltet werden – Tools können dies nur unterstützen, nicht ersetzen.



7. Verschlagwortung




Schlagwort


Begründung




Bildungstheorien


Die Studie operiert auf einem hochtheoretischen Niveau und arbeitet mit relational-soziologischen und bildungsphilosophischen Ansätzen.




Systemanpassung


Thematisiert wird die systemische Einpassung von Tools (insbesondere LLMs) in bürokratische Logiken und deren Effekte auf pädagogische Relationen.




Technologieintegration


LLMs werden als neue technologische Artefakte in Bildungssysteme eingebettet und mit klassischen Tools verglichen.




Forschungsansätze


Konzeptuelle Theoriebildung, keine empirische Forschung – aber klarer Beitrag zur Strukturierung des Feldes und zur Weiterentwicklung theoretischer Modelle.





8. Kategorisierung
Kategorie: Kerngedanke

Die Autor*innen entwickeln die zentrale Hypothese, dass Werkzeuge wie LLMs nicht isoliert als neutral-technische Innovationen verstanden werden dürfen, sondern als Teil relationaler Ordnungen, die pädagogisches Handeln strukturieren. Bildung ist nicht technologie-, sondern beziehungsbasiert.


9. Zuordnung zur Forschungsunterfrage
Forschungsunterfrage (FU4a):„Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?“
Begründung:Obwohl die Studie keinen direkten Bezug zu Gesundheitsberufen oder zu LMS hat, liefert sie relevante theoretische Einsichten zu den relationalen Mechanismen, die beim Einsatz von Bildungstechnologie wirksam werden – insbesondere im Hinblick auf agency, Reflexion und Pädagogik.

10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 3


Zitierfähigkeit und Einfluss: 5


Aktualität: 5


Gesamtbewertung: 4

11. Schlussfolgerung
Hansen und Carrigan (2025) bieten eine theoretisch anspruchsvolle, kritisch-reflexive Auseinandersetzung mit der Rolle von Technologien wie LLMs im Bildungssystem. Ihre konzeptionelle Typologie hilft dabei, die pädagogische Qualität und Wirkweise von Tools jenseits bloßer Effizienzargumente zu analysieren. Für das Wirkgefüge systemisch-konstruktivistischer LMS liefert die Studie wichtige Impulse zur Reflexion der Relationen zwischen Technik, Subjekt und Institution.
},
	file = {PDF:/Users/jochenhanisch-johannsen/Zotero/storage/LKK9YXFV/Hansen und Carrigan - 2025 - A typology of bureaucratic education tools uncovering the relational complexity of large language m.pdf:application/pdf},
}

@article{rigopouli_whale_2025,
	title = {The {Whale} {Optimization} {Algorithm} and {Markov} {Chain} {Monte} {Carlo}-{Based} {Approach} for {Optimizing} {Teacher} {Professional} {Development} in {Creative} {Learning} {Design} with {Technology}},
	volume = {18},
	copyright = {https://creativecommons.org/licenses/by/4.0/},
	issn = {1999-4893},
	url = {https://www.mdpi.com/1999-4893/18/7/407},
	doi = {10.3390/a18070407},
	abstract = {In this article, we present a hybrid optimization methodology using the whale optimization algorithm and Markov Chain Monte Carlo sampling technique in a teachers’ training development program regarding creativity in technology-enhanced learning design. Finding the best possible training for creativity in learning design with technology is a complex task, as many dynamic and multi-model variables need to be taken into consideration. When designing the best possible training, the whale optimization algorithm helped us in determining the right methods, resources, content, and assessment. A further Markov Chain Monte Carlo-based approach helped us in deciding with accuracy that these were the correct parameters of our training. In this article, we show that metaheuristic algorithms like the whale optimization algorithm, validated by a Markov chain technique like Markov Chain Monte Carlo, can help not only in areas like machine learning but also in ﬁelds without structured data, like creativity in technology-enhanced learning design. The best possible training for a teacher’s professional development in creative learning design is collaborative, hands-on, and utilizes creativity deﬁnitions for the product along with technology integration learning design models.},
