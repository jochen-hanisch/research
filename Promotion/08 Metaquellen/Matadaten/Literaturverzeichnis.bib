	year = {2024},
	doi = {10.1007/978-981-97-6136-4_13},
	note = {Series Title: Lecture Notes in Educational Technology},
	keywords = {Charité:Promotion, Promotion:Literaturanalyse, \#0:Buchteil:digital:learning, GPT, Promotion:S:12 Digital Learning, Promotion:\#Promotion:GPT, Promotion:Literaturverzeichnis},
	pages = {285--304},
	file = {Barrett et al. - 2024 - Accentuate the Positive Exploratory Case Study of ChatGPT as a Complementary Learning Tool:/Users/jochenhanisch-johannsen/Zotero/storage/RAFJUFE7/Barrett et al. - 2024 - Accentuate the Positive Exploratory Case Study of ChatGPT as a Complementary Learning Tool.pdf:application/pdf},
