@article{biswas_ml-based_2024,
	title = {{ML}-based intelligent real-time feedback system for blended classroom},
	volume = {29},
	issn = {1360-2357, 1573-7608},
	url = {https://link.springer.com/10.1007/s10639-023-11949-5},
	doi = {10.1007/s10639-023-11949-5},
	abstract = {The application of machine learning (ML) has grown and is now used to enhance learning outcomes. In blended classroom settings, ML, emerging smartphones and wearable technologies are commonly used to improve teaching and learning. The combination of these advanced technologies and ML plays a crucial role in enhancing real-time feedback quality. However, there are abundant scopes of improvement and strong need for further careful investigations in this area. We propose an MLbased intelligent real-time feedback system to address current research challenges for blended classrooms. The proposed system provides real-time feedback to students and teachers. We build an Android application for our intelligent feedback interfaces. The user interfaces use students’ academic performance prediction models with real-time states and dynamic feedback timings based on historic feedback statistics. In addition, the feedback scheduling algorithms, choices of peripheral devices for real-time feedback, and feedback modalities to optimize fatigue make our system interfaces intelligent and novel. The end users well-received the intelligent features and technology of the proposed system. Our empirical findings indicate that unique design elements, such as dynamic timing, choice of peripheral devices, and modalities of real-time feedback, are crucial in integrating the system with blended classes. The intelligent characteristics of the proposed system have been appreciated by a large proportion of the end-users (90.90\% of teachers and 84.21\% of students) for use in real-time blended classroom environments. The higher comparative system usability scale (SUS) scores with benchmarks show real promise of the system design.},
	language = {en-GB},
	number = {4},
	urldate = {2024-03-23},
	journal = {Education and Information Technologies},
	author = {Biswas, Ujjwal and Bhattacharya, Samit},
	month = mar,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Technologieintegration, Systemanpassung, Promotion:Argumentation, Promotion:FU4b, \#8:Zeitschriftenartikel:blended:learning, Promotion:S:08 Blended Learning, Promotion:Literaturverzeichnis},
	pages = {3923--3951},
	annote = {Analyse der Studie „ML-based intelligent real-time feedback system for blended classroom“ von Ujjwal Biswas und Samit Bhattacharya (2024)


Hauptthemen und Ziele der Forschung: Die Studie untersucht die Entwicklung und Implementierung eines intelligenten Feedback-Systems, das auf maschinellem Lernen (ML) basiert und in Echtzeit Rückmeldungen an Lehrkräfte und Lernende in Blended-Learning-Klassenzimmern gibt. Das Ziel der Forschung ist es, die Effektivität von Feedback in Echtzeit zu optimieren, um kognitive Ermüdung zu reduzieren und die aktive Teilnahme im Unterricht zu fördern.


Methoden und Datenquellen: Die Studie beschreibt ein mehrstufiges Forschungsdesign, das aus der Systementwicklung, Implementierung und empirischen Validierung besteht. Dabei werden ML-Modelle zur Vorhersage der akademischen Leistung von Studierenden entwickelt. Das Feedback wird über mobile Geräte und tragbare Technologien wie Smartwatches und Smartphones bereitgestellt. Um die Wirksamkeit zu bewerten, wurden mehrere empirische Studien mit Lehrenden und Studierenden durchgeführt, wobei quantitative und qualitative Methoden zum Einsatz kamen.


Zentrale Forschungsergebnisse:


Das vorgeschlagene System erzielte eine hohe Akzeptanz bei den Nutzern: 90,90 \% der Lehrenden und 84,21 \% der Studierenden bewerteten die intelligenten Funktionen des Feedback-Systems positiv.


Dynamische Feedback-Zeitintervalle, die auf historischen Daten basieren, tragen dazu bei, die kognitive Ermüdung zu minimieren.


Das System konnte in Echtzeit auf den Status der Lernenden reagieren, wodurch die individuelle Unterstützung von Lernenden verbessert wurde.




Zusammenfassung: Die Studie zeigt, dass das ML-basierte Echtzeit-Feedback-System durch die Kombination von maschinellem Lernen und tragbaren Technologien die Lernumgebung in Blended-Learning-Szenarien verbessert. Durch die Anpassung der Feedback-Zeitpunkte und -Modalitäten konnte die kognitive Belastung der Studierenden reduziert und die Lehrenden in Echtzeit unterstützt werden.


Kernaussagen:


Dynamische Zeitintervalle für das Feedback trugen dazu bei, die kognitive Ermüdung der Studierenden zu reduzieren und die Lehr-Lern-Interaktionen zu verbessern (S. 3926-3927).


Das System konnte erfolgreich die Leistung der Studierenden vorhersagen und individualisiertes Feedback basierend auf diesen Vorhersagen bereitstellen (S. 3930).


90,90 \% der Lehrenden und 84,21 \% der Studierenden äußerten sich positiv zur Anwendung des intelligenten Feedback-Systems (S. 3925).




Argumentationslinien: Die Autoren argumentieren, dass maschinelles Lernen und tragbare Technologien effektive Werkzeuge sind, um die Echtzeit-Lehr-Lern-Interaktionen in Blended-Learning-Klassenzimmern zu verbessern. Sie heben hervor, dass die Optimierung von Feedback-Zeitpunkten und -Modalitäten dazu beiträgt, die aktive Teilnahme der Studierenden zu fördern und die Lehrenden bei der Überwachung der Lernfortschritte zu unterstützen (S. 3933-3934).


Verschlagwortung:


Technologieintegration: Die Studie zeigt, wie tragbare Technologien und maschinelles Lernen integriert werden, um ein intelligentes Feedback-System zu schaffen.


Lehr- und Lerneffektivität: Das Feedback-System verbessert die Effektivität von Lehr- und Lernprozessen durch gezielte Rückmeldungen.


Systemanpassung: Die Anpassung des Feedback-Systems an individuelle Lernbedürfnisse und Echtzeit-Anforderungen wird betont.




Kategorisierung:


Argumentation: Die Studie untermauert, dass der Einsatz von ML-basierten Feedback-Systemen in Echtzeit eine wirksame Methode ist, um Blended-Learning-Umgebungen zu optimieren und die Lernleistung zu steigern.




Zuordnung zu den Forschungsfragen: Die Studie passt zur Forschungsfrage FU4b: „Welche technisch-gestalterische Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?“


Begründung: Die Arbeit untersucht technische Mechanismen, wie maschinelles Lernen und tragbare Geräte zur Optimierung von Feedback und Lernprozessen eingesetzt werden können.




Relevanzbewertung:




5 - Hoch relevant: Die Studie bietet innovative Ansätze für die Integration von Echtzeit-Feedback in Blended-Learning-Klassenzimmern und ist direkt relevant für die Untersuchung der technisch-gestalterischen Mechanismen in digitalen Bildungsumgebungen.


},
	file = {Biswas und Bhattacharya - 2024 - ML-based intelligent real-time feedback system for.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/4UME6P77/Biswas und Bhattacharya - 2024 - ML-based intelligent real-time feedback system for.pdf:application/pdf},
}

