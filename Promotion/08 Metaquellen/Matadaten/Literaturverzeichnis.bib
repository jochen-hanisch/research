@article{deutscher_hochschulverband_neugier_2004,
	title = {Neugier, {Spiel} und {Lernen}: {Verhaltensbiologische} {Anmerkungen} zur {Kindheit}},
	shorttitle = {Neugier, {Spiel} und {Lernen}},
	url = {https://www.degruyter.com/document/doi/10.1515/9783110506341-013/html},
	doi = {10.1515/9783110506341-013},
	abstract = {Alle Säugetiere sind in ihrer Kindheit und Jugend „Neugierwesen“, die aktiv neue Situationen und Objekte aufsuchen und erkunden. Neugierverhalten zeigt viele Übereinstimmungen mit Spielverhalten, und beide Bereiche sind untrennbar mit dem Lernen verbunden. So wird ein Experimentierfeld geschaffen, das zu Innovationen führen kann. Neugierverhalten und Spiel treten jedoch nicht von selber auf. Hierfür bedarf es eines „entspannten Feldes“, das sowohl Anregung als auch Sicherheit bietet. Wenn „entspannte Felder“ während der Entwicklung zur Verfügung stehen, erfolgen zahlreiche Lernprozesse aus eigenem Antrieb und bedürfen nicht der weiteren Motivierung durch externe Faktoren. Bezüglich der Ausprägung des Neugier-, Spiel- und Lernverhaltens existieren große Unterschiede zwischen den Individuen. Diese sind multifaktoriell bedingt und nicht auf einzelne Merkmale, wie z.B. die genetische Ausstattung, zurückzuführen. Generell hat jedoch das Vorhandensein von Bindungspartnern während der frühen Ontogenese positive Effekte für die weitere Entwicklung.},
	language = {de-DE},
	urldate = {2024-03-26},
	journal = {Zeitschrift für Pädagogik},
	author = {Sachser, Norbert},
	editor = {{Deutscher Hochschulverband}},
	month = dec,
	year = {2004},
	keywords = {Charité:Promotion, DRK-Bildungszentrum Düsseldorf, Promotion:Literaturverzeichnis},
	pages = {89--98},
	file = {Sachser - 2004 - Neugier, Spiel und Lernen Verhaltensbiologische A.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/IF66W8V8/Sachser - 2004 - Neugier, Spiel und Lernen Verhaltensbiologische A.pdf:application/pdf},
