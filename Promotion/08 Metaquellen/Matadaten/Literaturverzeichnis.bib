@techreport{hanisch-johannsen_wirkung_2026,
	address = {Hürth},
	type = {Arbeitspapier},
	title = {Wirkung},
	url = {https://zenodo.org/records/18728202},
	doi = {10.5281/zenodo.18728202},
	abstract = {Der Beitrag entwickelt einen disziplinübergreifend anschlussfähigen Wirkbegriff, der Wirkung als verlaufsmodifizierende, anschlussrelevante Differenz innerhalb eines relationalen Gefüges bestimmt. Ausgangspunkt ist die Beobachtung, dass „Wirkung“ in Medizin, Psychologie, Bildungs- und Sozialwissenschaften zwar zentral verwendet, jedoch selten explizit und systematisch definiert wird. Die Herleitung erfolgt in mehreren Verdichtungsschritten: von der alltagssprachlichen Ursache-Wirkung-Semantik über eine erkenntnistheoretische Problematisierung notwendiger Verknüpfungen (Hume) und eine relationale Bestimmung von Zustandsänderungen in der Physik bis hin zur systemtheoretischen Reformulierung von Wirkung als operativ anschlussrelevante Differenz. In der formaltheoretischen Fundierung (Spencer Brown, Bateson) erhält der Begriff seine präzise Struktur: Wirkung liegt dort vor, wo eine Differenz weitere Differenzen im Verlauf generiert.

Auf dieser Grundlage werden ontologische, epistemologische und systemisch-operative Folgerungen sowie methodologische, modelltheoretische, probabilistische, bildungstheoretische und verantwortungstheoretische Implikationen entfaltet. Wirkung ist demnach weder als übertragene Kraft noch als notwendige Kausalfolge zu verstehen, sondern als rekonstruierbare Verschiebung von Anschlussmöglichkeiten und Anschlusswahrscheinlichkeiten. Der Begriff erlaubt eine differenzierte Beschreibung dynamischer Prozesse in komplexen Kontexten, ohne auf lineare Kausalmodelle reduziert zu bleiben, und bietet damit eine konzeptuelle Grundlage für die Analyse von Wirkgefügen in Bildungs-, Organisations- und Versorgungssystemen.},
