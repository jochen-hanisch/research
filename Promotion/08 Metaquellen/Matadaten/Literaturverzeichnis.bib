  publisher = {Nomos Verlagsgesellschaft mbH \& Co. KG},
  doi = {10.5771/9783748904922},
  url = {https://www.nomos-elibrary.de/index.php?doi=10.5771/9783748904922},
  urldate = {2022-06-22},
  abstract = {Die digitale Transformation aller Lebensbereiche schreitet unaufhaltsam voran. Auch vor Hochschulpforten macht sie keinen Halt. Doch im Schatten des Erfolgs neuer Bildungstechnologien verbergen sich bislang ungeahnte Herausforderungen für den Datenschutz. Welche dies sind und wie sie sich bewältigen lassen, untersucht erstmals die vorliegende Arbeit umfassend.             Am Beispiel der Massive Open Online Courses (MOOCs) untersucht Jonas Botta vornehmlich die drohende Totalerfassung der E-Learner im virtuellen Seminarraum, die geschäftsmäßige Weitergabe ihrer Daten an Dritte und das spezielle Risiko transatlantischer Datenübermittlungen angesichts des defizitären EU-US Privacy Shield. Dadurch schließt die Arbeit nicht nur die bestehende Forschungslücke zu den Online-Kursen, sondern leistet zugleich auch einen wichtigen Beitrag dazu, vertiefte Einblicke in die DS-GVO und die einschlägigen deutschen Datenschutzvorschriften zu erlangen.},
  isbn = {978-3-7489-0492-2},
  langid = {ngerman},
  keywords = {4:Buch:MOOC,Charité:Promotion,Promotion:02-01_Q2,Promotion:02-01_Q3,Promotion:Literaturanalyse,Promotion:S:04 MOOC},
  file = {/Users/jochen_hanisch-johannsen/Zotero/storage/KAPLC24P/Botta - 2020 - Datenschutz bei E-Learning-Plattformen Rechtliche.pdf;/Users/jochen_hanisch-johannsen/Zotero/storage/TFYXFWLN/Botta - 2020 - Datenschutz bei E-Learning-Plattformen Rechtliche.pdf;/Users/jochen_hanisch-johannsen/Zotero/storage/Z7FNWLAU/Botta - 2020 - Datenschutz bei E-Learning-Plattformen Rechtliche.pdf}
