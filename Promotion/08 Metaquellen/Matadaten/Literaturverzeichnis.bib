	keywords = {Promotion:Literaturanalyse, Bildung, Digitale Bildung, Digitalisierung, Digitalization, Promotion:Literaturanalyse:Berichte, Virtual learning, Hochschule, Methode, Lehrerbildung, Teachers' training, Kompetenz, Berufliche Bildung, Further education, Weiterbildung, COVID-19, Pandemie, Hochschulbildung, Partizipation, Bildungsbiografie, School career, Further education for teachers, Further training for teachers, Lehrerfortbildung, Qualität, Quality, Correspondence studies, Distance study, Fernunterricht, Media competence, Media skills, Virtuelle Hochschule, Kollaboration, \#0:Bericht:digital:learning, Learning by playing, Älterer Erwachsener, Correspondence university, Interactive learning, Lernangebot, Öffentliche Verwaltung, Older Adults, Online service, Online-Angebot, Teaching method, Promotion:S:13 Berichte, Promotion:Literaturverzeichnis},
