@misc{statista_research_department_statistic_id1366858_gruende-fuer--nutzung-von-learning-management-systems--deutschland-2022png_nodate,
	type = {Statistik},
	title = {Aus welchen {Gründen} setzt/plant {Ihr} {Unternehmen} ein {LMS} ein(zusetzen)?},
	language = {de-DE},
	publisher = {Statista Research Department},
	author = {{Statista}},
	year = {2024},
	keywords = {Promotion:\# Abbildungen (ohne Quelle), Promotion:1.1.3 Thematische Relevanz, Promotion:Literaturverzeichnis},
	annote = {Diese Abbildung von Statista (2024), die sich mit den Gründen für den Einsatz von Learning-Management-Systemen (LMS) in Unternehmen befasst, lässt sich sinnvoll in Deine Dissertation integrieren – vorausgesetzt, die kontextuelle Einbettung erfolgt präzise und nicht illustrativ, sondern analytisch-herleitend. Eine rein dekorative Verwendung wäre nicht gerechtfertigt.
Begründete Einordnung:
1. Relevanz zur zentralen Forschungsfrage:
Du analysierst das Wirkgefüge eines konkreten LMS in einem hochspezialisierten, pädagogisch-medizinischen Anwendungskontext. Die Abbildung zeigt, welche organisationalen Funktionen und Wirkungsabsichten Unternehmen mit dem Einsatz eines LMS verknüpfen. Damit bietet sie eine empirisch abgesicherte Außenperspektive auf Nutzungsmotive, die sich mit den in Deiner Arbeit theoretisch und empirisch entwickelten Wirkungsebenen kontrastiv in Beziehung setzen lassen.
2. Verknüpfungspotenzial:
Die in der Grafik ausgewiesenen Hauptmotive (z. B. „Selbstgesteuertes Lernen“, „Automatisierung“, „Personalisierung“) lassen sich direkt mit systemischen Operationen aus Deinem Modell verbinden:
Selbststeuerung → Koppelung mit Reentry-Mechanismen im Lernraum.
Personalisierung → Referenz auf reflexive Feedbackschleifen.
Automatisierung → Anbindung an die operative Architektur Deines LMS.
Zukunftskompetenzen → Anknüpfung an Deine Perspektive auf High-Responsibility-Teams und programmatic assessment.
3. Mögliche Kapitelintegration:
Kapitel 3.4 (operative Architektur): hier könnte die Grafik als Gegenfolie dienen, um zu zeigen, inwiefern Dein LMS über die typischen Motive hinausgeht oder andere Systemlogiken verfolgt.
Kapitel 6.3 (gestalterische Implikationen): dort lässt sich die Grafik als Reflexionsfolie nutzen, um die praktisch-normativen Zielsetzungen von Unternehmen in ihrer systemischen Reichweite zu reflektieren und mit Deinem spezifischen Interventionsdesign ins Verhältnis zu setzen.
Einschränkung:
Die Studie basiert auf einer Befragung von 371 Unternehmen in Deutschland (2022), also einem eher wirtschaftlich geprägten Kontext. Eine direkte Übertragung auf Deinen gesundheits- und bildungsbezogenen Forschungsrahmen ist nicht möglich, kann jedoch bewusst gemacht werden. Der Kontrast erzeugt Erkenntnispotenzial, wenn er diskursiv gerahmt wird.
Fazit:
Einbindung empfehlenswert, sofern
die Abbildung in eine konzeptuelle Argumentation eingebettet wird,
sie als Gegenfolie zur Herausarbeitung eigener Spezifika dient,
der Kontextunterschied kenntlich gemacht wird (z. B. durch eine analytische Fußnote).
Ein möglicher Einsatzort wäre ein „Ankerpunkt“-Absatz zur Marktlogik des LMS-Einsatzes im Unterschied zu systemisch-didaktischer Gestaltung im medizinischen Bildungsraum.
},
	file = {Statista - 2024 - Aus welchen Gründen setztplant Ihr Unternehmen ein LMS ein(zusetzen):/Users/jochenhanisch-johannsen/Zotero/storage/CB5K2ZNS/Statista - 2024 - Aus welchen Gründen setztplant Ihr Unternehmen ein LMS ein(zusetzen).png:image/png},
}

