@article{kaduk_webcam_2023,
	title = {Webcam eye tracking close to laboratory standards: {Comparing} a new webcam-based system and the {EyeLink} 1000},
	volume = {56},
	issn = {1554-3528},
	shorttitle = {Webcam eye tracking close to laboratory standards},
	url = {https://link.springer.com/10.3758/s13428-023-02237-8},
	doi = {10.3758/s13428-023-02237-8},
	abstract = {This paper aims to compare a new webcam-based eye-tracking system, integrated into the Labvanced platform for online experiments, to a “gold standard” lab-based eye tracker (EyeLink 1000 - SR Research). Specifically, we simultaneously recorded data with both eye trackers in five different tasks, analyzing their real-time performance. These tasks were a subset of a standardized test battery for eye trackers, including a Large Grid task, Smooth Pursuit eye movements, viewing natural images, and two Head Movements tasks (roll, yaw). The results show that the webcam-based system achieved an overall accuracy of 1.4°, and a precision of 1.1° (standard deviation (SD) across subjects), an error of about 0.5° larger than the EyeLink system. Interestingly, both accuracy (1.3°) and precision (0.9°) were slightly better for centrally presented targets, the region of interest in many psychophysical experiments. Remarkably, the correlation of raw gaze samples between the EyeLink and webcam-based was at about 90\% for the Large Grid task and about 80\% for Free View and Smooth Pursuit. Overall, these results put the performance of the webcam-based system roughly on par with mobile eye-tracking devices (Ehinger et al. PeerJ, 7, e7086, 2019; Tonsen et al., 2020) and demonstrate substantial improvement compared to existing webcam eye-tracking solutions (Papoutsaki et al., 2017).},
	language = {en},
	number = {5},
	urldate = {2025-12-01},
	journal = {Behavior Research Methods},
	author = {Kaduk, Tobiasz and Goeke, Caspar and Finger, Holger and König, Peter},
	month = oct,
	year = {2023},
	keywords = {Promotion:Literaturverzeichnis, Promotion:sec:FU-Herleitung, Promotion:sec:Diskussion-Methodenreflexion, Promotion:sec:EyeTracking, Promotion:sec:EyeTracking-Absicherung, Promotion:sec:EyeTracking-Design, Promotion:sec:Diskussion-Konstrukte-Datenspur, Promotion:chap:04-04, Promotion:chap:04-06, Promotion:chap:04-01},
	pages = {5002--5022},
	file = {PDF:/Users/jochenhanisch-johannsen/Zotero/storage/VH6ESBGL/Kaduk et al. - 2023 - Webcam eye tracking close to laboratory standards Comparing a new webcam-based system and the EyeLi.pdf:application/pdf},
}

@inproceedings{rodziewicz-cybulska_measuring_2022,
	address = {Seattle WA USA},
	title = {Measuring {Cognitive} {Effort} with {Pupillary} {Activity} and {Fixational} {Eye} {Movements} {When} {Reading}: {Longitudinal} {Comparison} of {Children} {With} and {Without} {Primary} {Music} {Education}},
	isbn = {978-1-4503-9252-5},
	shorttitle = {Measuring {Cognitive} {Effort} with {Pupillary} {Activity} and {Fixational} {Eye} {Movements} {When} {Reading}},
	url = {https://dl.acm.org/doi/10.1145/3517031.3529636},
	doi = {10.1145/3517031.3529636},
	abstract = {This article evaluates the Low/High Index of Pupillary Activity (LHIPA), a measure of cognitive effort based on pupil response, in the context of reading. At the beginning of 2nd and 3rd grade, 107 children (8-9 y.o.) from music and general primary school were asked to read 40 sentences with keywords differing in length and frequency while their eye movements were recorded. Sentences with low frequency or long keywords received more attention than sentences with high frequent or short keywords. The word frequency and length effects were more pronounced in younger children. At the 2nd grade, music children dwelt less on sentences with short frequent keywords than on sentences with long frequent keywords. As expected LHIPA decreased over sentences with low frequency short keywords suggesting more cognitive effort at earlier stages of reading ability. This finding shows the utility of LHIPA as a measure of cognitive effort in education.},
	language = {en},
	urldate = {2025-12-01},
	booktitle = {2022 {Symposium} on {Eye} {Tracking} {Research} and {Applications}},
	publisher = {ACM},
	author = {Rodziewicz-Cybulska, Agata and Krejtz, Krzysztof and Duchowski, Andrew T. and Krejtz, Izabela},
	month = jun,
	year = {2022},
	keywords = {Promotion:Literaturverzeichnis, Promotion:sec:EyeTracking-Design, Promotion:chap:04-04},
	pages = {1--8},
	file = {PDF:/Users/jochenhanisch-johannsen/Zotero/storage/R2VILAX6/Rodziewicz-Cybulska et al. - 2022 - Measuring Cognitive Effort with Pupillary Activity and Fixational Eye Movements When Reading Longit.pdf:application/pdf},
}

@article{yang_webcam-based_2021,
	title = {Webcam-based online eye-tracking for behavioral research},
	volume = {16},
	copyright = {http://creativecommons.org/licenses/by-nc-nd/3.0/},
	issn = {1930-2975},
	url = {https://www.cambridge.org/core/product/identifier/S1930297500008512/type/journal_article},
	doi = {10.1017/S1930297500008512},
	abstract = {Experiments are increasingly moving online. This poses a major challenge for researchers who rely on in-lab techniques such as eye-tracking. Researchers in computer science have developed web-based eye-tracking applications (WebGazer; Papoutsaki et al., 2016) but they have yet to see them used in behavioral research. This is likely due to the extensive calibration and validation procedure, inconsistent temporal resolution (Semmelmann \& Weigelt, 2018), and the challenge of integrating it into experimental software. Here, we incorporate WebGazer into a JavaScript library widely used by behavioral researchers (jsPsych) and adjust the procedure and code to reduce calibration/validation and improve the temporal resolution (from 100–1000 ms to 20–30 ms). We test this procedure with a decision-making study on Amazon MTurk, replicating previous in-lab ﬁndings on the relationship between gaze and choice, with little degradation in spatial or temporal resolution. This provides evidence that online web-based eye-tracking is feasible in behavioral research.},
	language = {en},
	number = {6},
	urldate = {2025-12-01},
	journal = {Judgment and Decision Making},
	author = {Yang, Xiaozhi and Krajbich, Ian},
	month = nov,
	year = {2021},
	keywords = {Promotion:Literaturverzeichnis, Promotion:sec:Methodenkritik-Absicherung, Promotion:sec:EyeTracking-Design, Promotion:chap:04-04},
	pages = {1485--1505},
	annote = {{\textless}!-- codex:methodenkritik:04-04 --{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Methodenkritik (Anschlussstelle: webcam-basiertes Eye-Tracking, Datenqualität, Ausschlusslogiken){\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}p{\textgreater}Yang \& Krajbich begründen, warum webcam-basiertes Eye-Tracking in Behavioral Research bislang zögerlich eingesetzt wird: u. a. wegen aufwendiger Kalibrier-/Validierungsprozeduren, inkonsistenter zeitlicher Auflösung und Integrationsaufwand. Auch wenn sie technische Verbesserungen berichten (u. a. bessere Temporalauflösung), bleibt methodisch entscheidend, dass Datenerhebung ohne strenge Qualitätskontrollen (Calibration/Validation, laufende Checks) nicht tragfähig ist. Das stützt in meiner Methodik die Setzung, Eye-Tracking als qualifikationsbedürftige Zusatzspur zu führen und Validierungslogiken nicht zu überspringen. (Yang \& Krajbich, 2021, S. 1){\textless}/p{\textgreater}{\textless}p{\textgreater}Der Beitrag liefert zudem eine sehr konkrete Grenze: Online-Settings produzieren hohe Ausschlussraten; in ihrer Studie wird ein großer Teil der Probanden ausgeschlossen (hier: mehr als die Hälfte), woraus potenzielle Selektions- und Generalisierbarkeitsprobleme folgen. Für mein Vorgehen heißt das, dass Ausschlusskriterien, Abbruchraten und Hardwarechecks als Teil der Methode transparent zu berichten und in der Interpretation mitzudenken sind. (Yang \& Krajbich, 2021, S. 17){\textless}/p{\textgreater}{\textless}p{\textgreater}Schließlich wird die Frage der Persistenz der räumlichen Auflösung über die Zeit als offenes Problem markiert; daher sind laufende Validierungspunkte bzw. Rekalibrationen als Designentscheidung methodisch begründbar. (Yang \& Krajbich, 2021, S. 9){\textless}/p{\textgreater}},
	file = {PDF:/Users/jochenhanisch-johannsen/Zotero/storage/KCRJNPVK/Yang und Krajbich - 2021 - Webcam-based online eye-tracking for behavioral research.pdf:application/pdf},
}

@inproceedings{wisiecka_comparison_2022,
	address = {Seattle WA USA},
	title = {Comparison of {Webcam} and {Remote} {Eye} {Tracking}},
	isbn = {978-1-4503-9252-5},
	url = {https://dl.acm.org/doi/10.1145/3517031.3529615},
	doi = {10.1145/3517031.3529615},
	abstract = {We compare the measurement error and validity of webcam-based eye tracking to that of a remote eye tracker as well as software integration of both. We ran a study with n = 83 participants, consisting of a point detection task and an emotional visual search task under three between-subjects experimental conditions (webcam-based, remote, and integrated). We analyzed location-based (e.g., fixations) and process-based eye tracking metrics (ambient-focal attention dynamics). Despite higher measurement error of webcam eye tracking, our results in all three experimental conditions were in line with theoretical expectations. For example, time to first fixation toward happy faces was significantly shorter than toward sad faces (the happiness-superiority effect). As expected, we also observed the switch from ambient to focal attention depending on complexity of the visual stimuli. We conclude that webcam-based eye tracking is a viable, low-cost alternative to remote eye tracking.},
	language = {en},
	urldate = {2025-12-01},
	booktitle = {2022 {Symposium} on {Eye} {Tracking} {Research} and {Applications}},
	publisher = {ACM},
	author = {Wisiecka, Katarzyna and Krejtz, Krzysztof and Krejtz, Izabela and Sromek, Damian and Cellary, Adam and Lewandowska, Beata and Duchowski, Andrew},
	month = jun,
	year = {2022},
	keywords = {Promotion:Literaturverzeichnis, Promotion:sec:Diskussion-Methodenreflexion, Promotion:sec:EyeTracking, Promotion:sec:EyeTracking-Absicherung, Promotion:sec:Methodenkritik-Absicherung, Promotion:sec:EyeTracking-Design, Promotion:sec:Diskussion-Konstrukte-Datenspur, Promotion:chap:04-04, Promotion:chap:04-06},
	pages = {1--7},
	annote = {{\textless}!-- codex:methodenkritik:04-04 --{\textgreater}{\textless}p{\textgreater}{\textless}strong{\textgreater}Methodenkritik (Anschlussstelle: Messfehler von webcam-basiertem Eye-Tracking, Interpretationsgrenzen){\textless}/strong{\textgreater}{\textless}/p{\textgreater}{\textless}p{\textgreater}Der Beitrag liefert eine klare, empirische Einordnung: Webcam-basiertes Eye-Tracking wird zwar als vielversprechend gerahmt, aber zugleich explizit mit geringerer Accuracy und Precision verbunden; damit ist die Methode als skalierbarer Näherungszugang zu verstehen, nicht als gleichwertiger Ersatz für präzise Labormessungen. Das stützt in meiner Methodik die Entscheidung, gaze-basierte Befunde nur in robusten/aggregierten Formen zu interpretieren und argumentativ zu triangulieren. (Wisiecka et al., 2022, S. 1){\textless}/p{\textgreater}{\textless}p{\textgreater}Für die Operationalisierung ist die Messfehleranalyse zentral: In der Punktdetektionsaufgabe zeigt sich ein signifikanter Unterschied der Messfehler zwischen Bedingungen; der durchschnittliche Fehler ist in der Webcam-Bedingung höher (M = 45.1px, SE = 2.81) als in der Remote-Bedingung (M = 34.2px, SE = 2.75). Damit wird Messfehler als systematischer Faktor sichtbar, der in der Interpretation (AOIs, Schwellen, Sensitivität) berücksichtigt werden muss. (Wisiecka et al., 2022, S. 5){\textless}/p{\textgreater}},
	file = {PDF:/Users/jochenhanisch-johannsen/Zotero/storage/V3KW4HTL/Wisiecka et al. - 2022 - Comparison of Webcam and Remote Eye Tracking.pdf:application/pdf},
}

