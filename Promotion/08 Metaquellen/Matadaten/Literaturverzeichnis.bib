@article{macznik_online_2015,
	title = {Online technology use in physiotherapy teaching and learning: a systematic review of effectiveness and users’ perceptions},
	volume = {15},
	issn = {1472-6920},
	shorttitle = {Online technology use in physiotherapy teaching and learning},
	url = {http://bmcmededuc.biomedcentral.com/articles/10.1186/s12909-015-0429-8},
	doi = {10/gb3382},
	abstract = {Background: The use of online technologies in health professionals’ education, including physiotherapy, has been advocated as effective and well-accepted tools for enhancing student learning. The aim of this study was to critically review the effectiveness, and user perceptions of online technology for physiotherapy teaching and learning.
Methods: Following databases were systematically searched on the 31st of August 2013 for articles describing implementation of online technologies into physiotherapy teaching and learning: ERIC, CINAHL, Web of Science, Academic search complete, ProQuest Nursing and Allied Health Source, Medline, Embase, and Scopus. No language, design or publishing date restrictions were imposed. Risk of bias was assessed using the 2011 Mixed Methods Appraisal Tool checklist (MMAT).
Results: A total of 4133 articles were retrieved; 22 articles met the inclusion criteria and were accepted for final analysis: 15 on the effectiveness of technology, and 14 on users’ perceptions. Included studies used three designs: case study (14 articles), controlled trial (3), and randomized controlled trial (5). Studies investigated both pre-registration physiotherapy students (1523) and physiotherapy professionals (171). The quality of studies ranged from 67 to 100 \% on the MMAT checklist which can be considered moderate to excellent. More than half of the studies (68 \%) received scores greater than 80 \%. Studies typically investigated websites and discussion boards. The websites are effective in enhancing practical skills performance, and discussion boards in knowledge acquisition, as well as in development of critical and reflective thinking. Students’ perceptions of the use of websites were mostly positive, providing students with entertaining, easy accessible resources. Perceived barriers to the use of websites included difficulties with internet connection, insufficiently interactive material, or personal preference for paper-based materials. Discussion boards were perceived as deepening students’ thinking and facilitating reflection, allowing for learning from multiple perspectives, and providing easy communication and support.
Conclusions: The results of this review suggest that online technologies (i.e., websites and discussion boards) have many benefits to offer for physiotherapy teaching and learning; There was minimal evidence of barriers for the use of online technologies, however, addressing the identified ones could enhance adherence to use of online technologies in health professionals’ education.},
	language = {en-GB},
	number = {1},
	urldate = {2023-11-18},
	journal = {BMC Medical Education},
	author = {Mącznik, Aleksandra K. and Ribeiro, Daniel Cury and Baxter, G. David},
	month = dec,
	year = {2015},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Bewertungsmethoden, Promotion:FU6, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {160},
	annote = {Analyse der Studie „Online Technology Use in Physiotherapy Teaching and Learning: A Systematic Review of Effectiveness and Users’ Perceptions“ von Mącznik et al. (2015)

1. Hauptthemen und Ziele der Forschung
Die Studie untersucht die Wirksamkeit und Nutzerwahrnehmung von Online-Technologien im Physiotherapieunterricht. Sie zielt darauf ab, zu analysieren, wie effektiv webbasierte Lernressourcen und digitale Plattformen für die Vermittlung physiotherapeutischer Inhalte sind und welche Vor- und Nachteile sie aus Sicht der Studierenden und Lehrenden haben​Mącznik et al. - 2015 -….
Zentrale Forschungsfragen:


Wie wirksam sind Online-Technologien für das Lernen und Lehren in der Physiotherapie?


Wie bewerten Studierende und Fachleute die Vorteile und Hindernisse bei der Nutzung von Online-Technologien im physiotherapeutischen Bildungsbereich?



2. Methoden und Datenquellen
Methoden:


Systematische Literaturübersicht nach den PRISMA-Richtlinien.


Durchsuchung von acht Datenbanken (ERIC, CINAHL, Web of Science, Academic Search Complete, ProQuest Nursing \& Allied Health Source, Medline, Embase, Scopus) bis zum 31. August 2013.


Einschlusskriterien:


Studien zur Implementierung von Online-Technologien in der Physiotherapieausbildung.


Keine Einschränkungen bezüglich Designs oder Sprachen.




Bewertung der Studienqualität mit dem Mixed Methods Appraisal Tool (MMAT).


Datenquellen:


22 Studien mit insgesamt 1694 Teilnehmenden, darunter 1523 Physiotherapiestudierende und 171 Physiotherapie-Professionals.


Untersuchung von Websites, Diskussionsforen, Wikis, Podcasts, Blogging und virtuellen Fallstudien.


Daten zur Wirksamkeit und Wahrnehmung dieser Technologien wurden extrahiert und analysiert​Mącznik et al. - 2015 -….



3. Zentrale Forschungsergebnisse


Websites und Diskussionsforen verbessern Lernleistungen signifikant


Websites fördern die praktische Anwendung von Wissen, indem sie z. B. interaktive Videos und Fallstudien integrieren.


Diskussionsforen verbessern kritisches und reflektierendes Denken und fördern den interdisziplinären Austausch​Mącznik et al. - 2015 -….




Positive Wahrnehmung, aber einige Barrieren bei der Nutzung


Studierende fanden Websites unterhaltsam und einfach zugänglich, jedoch wurden oft mangelnde Interaktivität und technische Probleme (z. B. schlechte Internetverbindung) als Hindernisse genannt.


Diskussionsforen wurden als förderlich für Reflexion und tieferes Verständnis empfunden, insbesondere durch den Austausch mehrerer Perspektiven​Mącznik et al. - 2015 -….




Kombination mehrerer Lerntechnologien zeigt den größten Nutzen


Blended-Learning-Ansätze (Kombination aus Online- und Präsenzlernen) wurden als besonders effektiv bewertet.


Websites und Diskussionsforen waren die am häufigsten untersuchten Technologien, da sie die aktivste Teilnahme der Studierenden förderten​Mącznik et al. - 2015 -….





4. Zusammenfassung
Die Studie zeigt, dass Online-Technologien einen signifikanten positiven Einfluss auf das Lernen und Lehren in der Physiotherapie haben. Websites und Diskussionsforen sind besonders effektiv für die Entwicklung praktischer Fähigkeiten und kritischen Denkens, während technische Barrieren und Präferenzen für traditionelle Lehrmethoden einige Herausforderungen darstellen​Mącznik et al. - 2015 -….

5. Kernaussagen


„Webbasierte Plattformen unterstützen die Entwicklung praktischer Fähigkeiten und kritischen Denkens in der Physiotherapieausbildung.“ (S. 7)


„Studierende bevorzugen digitale Lernmethoden, wenn sie interaktiv gestaltet sind und technische Probleme minimiert werden.“ (S. 10)


„Die Kombination von Websites und Diskussionsforen bietet die größten Vorteile für das selbstgesteuerte Lernen.“(S. 12)



6. Argumentationslinien
Die Studie argumentiert, dass Online-Technologien für den Physiotherapieunterricht einen bedeutenden Beitrag leisten können, wenn sie interaktiv gestaltet und gut in bestehende Lehrpläne integriert werden:


Grundannahme: Studierende profitieren von digitalen Technologien, aber der Erfolg hängt von der didaktischen Gestaltung ab. (S. 5)


Empirischer Beleg: Studien zeigten eine signifikante Verbesserung der praktischen Fähigkeiten und des kritischen Denkens durch Websites und Diskussionsforen. (S. 9)


Didaktische Implikationen: Hochschulen sollten Blended-Learning-Ansätze implementieren, um die Vorteile von Online-Technologien optimal zu nutzen. (S. 13)



7. Verschlagwortung




Schlagwort


Begründung




Technologieintegration


Analyse der Integration von Websites und Diskussionsforen in die Physiotherapieausbildung.




Lehr- und Lerneffektivität


Untersuchung der Effekte von Online-Technologien auf praktische Fähigkeiten und kritisches Denken.




Bewertungsmethoden


Anwendung der MMAT-Checkliste zur Bewertung der Studienqualität.





8. Kategorisierung
Kategorie: Kerngedanke


Kriterium: Die Studie beleuchtet elementare Mechanismen der Online-Technologien im Physiotherapieunterricht.


Beispiel: Die systematische Analyse zeigt, dass Websites und Diskussionsforen besonders effektiv sind, um praktisches und kritisches Denken zu fördern. (S. 9)



9. Zuordnung zu einer Forschungsunterfrage (FU)
Passendste Forschungsunterfrage: FU6„Wie wird ein systemisch-konstruktivistisches Learning-Management-System als Kompetenzerwerbssystem bei Akteuren im digitalen Bildungsraum von Gesundheitsberufen beurteilt?“
Begründung:Die Studie liefert eine systematische Analyse, welche digitalen Lerntechnologien sich besonders für den Kompetenzerwerb in der Physiotherapie eignen. Diese Erkenntnisse sind direkt übertragbar auf die Gestaltung systemisch-konstruktivistischer LMS in der Gesundheitsbildung​Mącznik et al. - 2015 -….

10. Relevanzbewertung (1–5)
Relevanz: 5


Direkte Anwendbarkeit: Die Studie liefert fundierte Erkenntnisse über die Nutzung von Online-Technologien im Gesundheitsbereich.


Technologieübertragbarkeit: Die Ergebnisse sind hochrelevant für digitale Bildungsplattformen, insbesondere für LMS in der Physiotherapie.


Innovationspotenzial: Die Erkenntnisse könnten zur Optimierung interaktiver und praxisorientierter Online-Lernmodule beitragen.


},
	file = {Mącznik et al. - 2015 - Online technology use in physiotherapy teaching an.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/Y23GIS9V/Mącznik et al. - 2015 - Online technology use in physiotherapy teaching an.pdf:application/pdf},
}

@article{bandono_collaborative_2023,
	title = {Collaborative {Learning} in {Higher} {Education} in the {Fourth} {Industrial} {Revolution}: {A} {Systematic} {Literature} {Review} and {Future} {Research}},
	volume = {22},
	issn = {16942493, 16942116},
	shorttitle = {Collaborative {Learning} in {Higher} {Education} in the {Fourth} {Industrial} {Revolution}},
	url = {https://ijlter.org/index.php/ijlter/article/view/8806/pdf},
	doi = {10/gs39fq},
	abstract = {The goal of this study is to determine the variables and difficulties that contribute to collaborative learning at tertiary institutions during the fourth industrial revolution and future research gaps. This study employs a systematic literature review to summarise and provide a comprehensive understanding of collaborative learning. The systematic literature review process used the Preferred Reporting Items for Systematic Review and Meta-Analysis Protocols (PRISMA-P) technique between 2008 and 2022, supported by NVivo and Microsoft Excel. A systematic literature review, which is an appropriate method for strengthening research issues and gaps, was conducted with 61 papers. It should be noted that this manuscript only presents work from the Scopus database with journal criteria. This study has identified six factors related to collaborative learning in tertiary institutions in the fourth industrial revolution era including Task \& Context, Environment, Social, Technology, Teacher, and Learner. This study presents a comprehensive literature assessment of collaborative learning in tertiary institutions during the fourth industrial revolution in order to acquire a clear grasp of its importance and application in higher education. Furthermore, Several higher education models have adopted the online-based collaborative learning paradigm, according to the study's findings.},
	language = {en-GB},
	number = {10},
	urldate = {2023-11-08},
	journal = {International Journal of Learning, Teaching and Educational Research},
	author = {Bandono, Adi and Mukhlis, Mukhlis and Susilo, A K and Prabowo, A R},
	month = oct,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Promotion:FU5, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {209--230},
	annote = {Analyse des Artikels „Collaborative Learning in Higher Education in the Fourth Industrial Revolution: A Systematic Literature Review and Future Research“ von Bandono et al. (2023)

1. Hauptthemen und Ziele der Forschung
Der Artikel untersucht die Faktoren und Herausforderungen von kollaborativem Lernen (Collaborative Learning, CL) in der Hochschulbildung im Zeitalter der vierten industriellen Revolution (4IR). Ziel ist es, durch eine systematische Literaturübersicht die Schlüsselkomponenten und Forschungslücken zu identifizieren, um zukünftige Forschungsfragen zu formulieren.

2. Methoden und Datenquellen


Methode: Systematische Literaturübersicht (Systematic Literature Review, SLR) unter Verwendung des PRISMA-P-Protokolls.


Datenquellen:


Analyse von 61 Studien aus der Scopus-Datenbank (Zeitraum: 2008–2022).


Methoden wie Inhaltsanalyse und Clusterbildung mittels NVivo und Excel.




Fokusbereiche: Task \& Context, Environment, Social, Technology, Teacher, Learner.



3. Zentrale Forschungsergebnisse


Faktoren des kollaborativen Lernens:


Sechs Einflussfaktoren: Aufgaben \& Kontext, Lernumgebung, soziale Interaktion, Technologie, Lehrende und Lernende.


Kollaborative Lernmethoden fördern Selbstwirksamkeit, kritisches Denken und soziale Kompetenzen.




Herausforderungen:


Technische Barrieren (z. B. Zugang zu KI-Tools und Infrastruktur in Entwicklungsländern).


Widerstand von Lehrenden gegenüber neuen digitalen Lehrmethoden.


Zeitintensive Entwicklung kollaborativer Lernressourcen.




Forschungslücken:


Mangel an empirischen Studien zu KI- und maschinellem Lernen (ML) in kollaborativen Lernumgebungen.


Unzureichende Studien zu langfristigen Effekten kollaborativer Lernstrategien.





Zusammenfassung
Der Artikel bietet eine umfassende Übersicht über kollaboratives Lernen in der Hochschulbildung und zeigt, wie technologische Innovationen es ermöglichen, kollaborative Ansätze stärker zu nutzen. Er identifiziert zugleich bestehende Herausforderungen und Forschungslücken, insbesondere in Bezug auf technologische Integration und die Akzeptanz bei Lehrenden.

Kernaussagen


Bedeutung von CL: Kollaboratives Lernen stärkt soziale, kognitive und technische Fähigkeiten der Studierenden (S. 211).


Technologie als Enabler: Technologien wie KI und ML könnten die Effektivität von CL-Methoden signifikant steigern, stehen aber vor infrastrukturellen Herausforderungen (S. 223).


Soziale Interaktion: Positive soziale Dynamiken sind essenziell für den Erfolg kollaborativer Ansätze, sowohl online als auch offline (S. 219).



Argumentationslinien
Die Autoren argumentieren, dass die vierte industrielle Revolution einen Wandel hin zu technologiegestütztem kollaborativem Lernen erfordert. Sie betonen die Notwendigkeit von Anpassungen an technologische Fortschritte und sozialen Wandel, um CL effektiver zu gestalten. (S. 220)

Verschlagwortung


Kollaboratives Lernen:Begründung: Der Artikel untersucht explizit kollaboratives Lernen in der Hochschulbildung und dessen Bedeutung für die 4IR. (S. 212)


Technologieintegration:Begründung: Fokus auf den Einfluss von KI und digitalen Werkzeugen auf kollaborative Lernprozesse. (S. 223)


Lehr- und Lerneffektivität:Begründung: Untersuchung der Wirksamkeit von kollaborativen Lernstrategien auf Lernprozesse. (S. 218)



Kategorisierung
Weiterführung: Der Artikel entwickelt Forschungsfragen und identifiziert Möglichkeiten zur Verbesserung kollaborativer Lernansätze, insbesondere durch die Integration neuer Technologien und die Überwindung struktureller Hürden. (S. 223)

Zuordnung zur Forschungsunterfrage
Passendste Forschungsunterfrage:FU5:„Welche Möglichkeiten und Grenzen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems durch Akteure im digitalen Bildungsraum von Gesundheitsberufen analysiert?“
Begründung:Der Artikel analysiert Potenziale und Herausforderungen von kollaborativem Lernen und liefert Erkenntnisse zu technologischen und sozialen Faktoren, die auf digitale Bildungsräume übertragbar sind.

Relevanzbewertung


Relevanz: 5 (Der Artikel bietet eine systematische und fundierte Analyse von Faktoren und Herausforderungen kollaborativen Lernens, die sich direkt auf digitale Bildungssysteme übertragen lassen.)


},
	file = {Bandono et al. - 2023 - Collaborative Learning in Higher Education in the .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/3SCVJJ53/Bandono et al. - 2023 - Collaborative Learning in Higher Education in the .pdf:application/pdf},
}

@article{yadav_high-performance_2023,
	title = {High-performance work system and learning orientation in offline, online, and hybrid workplaces: the mediating role of affective commitment},
	issn = {0969-6474, 0969-6474},
	shorttitle = {High-performance work system and learning orientation in offline, online, and hybrid workplaces},
	url = {https://www.emerald.com/insight/content/doi/10.1108/TLO-10-2022-0118/full/html},
	doi = {10/gs3qfb},
	abstract = {Purpose – The present study primarily aims to investigate the role of the high-performance work system (HPWS) in shaping learning orientation (LO). Moreover, the study delves into the examination of affective commitment’s (AC) role as a mediator. Additionally, the research extends to exploring the potential moderating impact of workplace settings, speciﬁcally ofﬂine, online and hybrid workplaces, on the mediated relationship.},
	language = {en-GB},
	urldate = {2023-11-04},
	journal = {The Learning Organization},
	author = {Yadav, Rohit and Yadav, Mohit and Vihari, Nitin Simha},
	month = oct,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Lehr- und Lerneffektivität, Promotion:FU4a, Promotion:Kerngedanke, Technologieintegration, Bewertungsmethoden, Systemanpassung, Promotion:Relevanz:4, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	annote = {Analyse der Studie "High-Performance Work System and Learning Orientation in Offline, Online, and Hybrid Workplaces: The Mediating Role of Affective Commitment" (Yadav et al., 2023)

1. Hauptthemen und Ziele der Forschung
Die Studie von Yadav et al. (2023) untersucht den Einfluss von High-Performance Work Systems (HPWS) auf die Lernorientierung (Learning Orientation, LO) von Mitarbeitenden in unterschiedlichen Arbeitsumgebungen (offline, online und hybrid).
Zentrale Ziele:


Direkte Wirkung: Untersuchen, ob HPWS die Lernorientierung von Mitarbeitenden verbessert.


Mediierende Rolle: Überprüfen, ob affektive Bindung (Affective Commitment, AC) als Vermittler zwischen HPWS und Lernorientierung fungiert.


Moderierende Rolle der Arbeitsumgebung: Analysieren, ob der Zusammenhang zwischen HPWS, affektiver Bindung und Lernorientierung je nach Arbeitsumgebung (offline, online, hybrid) unterschiedlich ausfällt.



2. Methoden und Datenquellen
Methoden:


Quantitative Studie mit 360 IT-Mitarbeitenden aus Indien.


Datenerhebung: Online-Fragebögen mit standardisierten Skalen zur Messung von HPWS, affektiver Bindung und Lernorientierung.


Statistische Analyse:


Strukturgleichungsmodellierung (SEM) und konfirmatorische Faktorenanalyse (CFA) zur Überprüfung der Kausalbeziehungen.


Mediationsanalyse mit PROCESS-Makro (Hayes, 2013).


Moderierte Mediationsanalyse, um den Einfluss der Arbeitsumgebung auf die Vermittlungsprozesse zu testen.




Datenquellen:


HPWS: 11-Item-Skala (Jyoti \& Dev, 2016).


Lernorientierung: 10-Item-Skala (Yuan et al., 2018).


Affektive Bindung: 5-Item-Skala (Meyer et al., 1993).


Arbeitsumgebung: Kategorisierung in offline, online, hybrid (nominal skaliert).



3. Zentrale Forschungsergebnisse


HPWS hat einen positiven Einfluss auf die Lernorientierung (LO).


Mitarbeitende, die HPWS erleben, zeigen stärkere intrinsische Motivation zum Lernen. (S. 10-11)




Affektive Bindung (AC) vermittelt den Zusammenhang zwischen HPWS und LO.


Mitarbeitende mit hoher HPWS-Exposition entwickeln eine stärkere emotionale Bindung zum Unternehmen, was wiederum ihre Lernorientierung erhöht. (S. 12-13)




Moderierende Wirkung der Arbeitsumgebung:


Offline \& Hybrid: Der mediierende Effekt der affektiven Bindung ist signifikant.


Online: Kein signifikanter Zusammenhang zwischen HPWS, affektiver Bindung und Lernorientierung. (S. 14)




Implikation für hybride Arbeitsmodelle:


Hybride Arbeitsumgebungen bieten eine bessere Balance zwischen organisationaler Unterstützung und Autonomie, was HPWS effektiver macht. (S. 15)





4. Zusammenfassung
Die Studie zeigt, dass HPWS eine zentrale Rolle bei der Förderung der Lernorientierung spielt, indem sie die affektive Bindung der Mitarbeitenden stärkt. Der Effekt variiert je nach Arbeitsumgebung: Offline und hybride Modelle verstärken die positiven Effekte von HPWS, während sie im reinen Online-Arbeitsumfeld abgeschwächt sind.

5. Kernaussagen


HPWS erhöht die affektive Bindung und fördert dadurch Lernorientierung. (S. 11)


Die Effekte sind in hybriden und offline Arbeitsumgebungen stärker als in Online-Umgebungen. (S. 14)


Hybride Arbeitsmodelle bieten die besten Voraussetzungen für lernorientierte Mitarbeitende. (S. 15)



6. Argumentationslinien
Die Autor:innen argumentieren, dass High-Performance Work Systems (HPWS) durch affektive Bindung die Lernorientierung fördern. Sie zeigen, dass die Arbeitsumgebung eine entscheidende Rolle spielt, da Online-Umgebungen weniger förderlich für affektive Bindung und Lernverhalten sind. (S. 16-17)

7. Verschlagwortung
(1) Lehr- und Lerneffektivität
HPWS beeinflusst die Lernorientierung der Mitarbeitenden positiv. (S. 10-12)
(2) Technologieintegration
Unterschiede in Online-, Offline- und Hybrid-Arbeitsmodellen werden untersucht. (S. 13-15)
(3) Systemanpassung
Die Studie zeigt, dass HPWS je nach Arbeitsumgebung unterschiedlich wirkt. (S. 15-16)
(4) Bewertungsmethoden
Einsatz von Strukturgleichungsmodellierung und Mediationsanalysen zur Bewertung von Lerneffekten. (S. 11-12)

8. Kategorisierung
Kategorie: Kerngedanke


Begründung: Die Studie zeigt, dass High-Performance Work Systems über affektive Bindung die Lernorientierung beeinflussen, jedoch abhängig von der Arbeitsumgebung. (S. 14-16)



9. Zuordnung zu Forschungsfragen
Passendste Forschungsunterfrage:
FU4a – Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?
Begründung:
Die Studie untersucht, wie unterschiedliche Arbeitsumgebungen das Lernen beeinflussen und bietet somit wichtige Einblicke in bildungswissenschaftliche Mechanismen in digitalen Lernräumen. (S. 14-15)

10. Relevanzbewertung




Kriterium


Bewertung (1-5)




Direkte Relevanz für die Forschungsfrage


4




Zitierhäufigkeit und Einfluss


3




Aktualität


5




Gesamtbewertung: 4

Die Studie liefert wertvolle Erkenntnisse zur Rolle von HPWS in unterschiedlichen Arbeitsumgebungen und deren Einfluss auf Lernprozesse.


11. Schlussfolgerung
Die Studie von Yadav et al. (2023) zeigt, dass High-Performance Work Systems (HPWS) eine Schlüsselrolle bei der Förderung von Lernorientierung spielen, indem sie die affektive Bindung der Mitarbeitenden stärken. Die Effekte sind in Offline- und Hybrid-Umgebungen deutlich stärker als in Online-Umgebungen, was Implikationen für das Design zukünftiger Lern- und Arbeitsumgebungen hat.

Fazit:


Die Studie ist hochrelevant für digitale Bildungs- und Arbeitskontexte.


Sie liefert fundierte Erkenntnisse zu den Wirkmechanismen von HPWS auf Lernverhalten.


Hybride Arbeitsumgebungen bieten die besten Bedingungen für effektive Lernorientierung und sollten bevorzugt werden.


},
	file = {Yadav et al. - 2023 - High-performance work system and learning orientat.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/SDI2Z9I3/Yadav et al. - 2023 - High-performance work system and learning orientat.pdf:application/pdf},
}

@article{xue_examining_2023,
	title = {Examining the {Affordances} of an {Online} {Learning} {Platform}: {A} {Usefulness} {Theoretical} {Perspective}},
	volume = {13},
	issn = {2158-2440, 2158-2440},
	shorttitle = {Examining the {Affordances} of an {Online} {Learning} {Platform}},
	url = {http://journals.sagepub.com/doi/10.1177/21582440231202821},
	doi = {10/gsv83n},
	abstract = {This study examined the affordances of an online learning platform used in a Chinese university for online teaching and learning during the pandemic period. A usefulness theoretical perspective was adopted to examine three types of affordances of the platform, namely, educational affordances, social affordances, and technological affordances. Both quantitative and qualitative data were collected and analyzed, including survey questionnaires, observation, and semi-structured interviews. A range of educational affordances emerged from the results, including Representation, Resource sharing, Community-building, Promoting interaction, and Administration. However, despite the respondents’ perceived ease of use of the platform, results indicate that the platform played a limited role in increasing learners’ social presence. A framework for examining usefulness has been developed based on the results. Pedagogical implications are proposed and suggestions for future research are provided.},
	language = {en-GB},
	number = {4},
	urldate = {2023-10-17},
	journal = {SAGE Open},
	author = {Xue, Sijia and Wang, Chuang and Muhaimaiti, Mirebanguli},
	month = oct,
	year = {2023},
