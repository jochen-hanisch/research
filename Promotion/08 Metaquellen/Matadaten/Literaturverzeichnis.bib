	author = {Ambad, Ranjit and Dhok, Archana and Jha, Roshan K.},
	month = dec,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#5:Zeitschriftenartikel:e-learning, e-learning, Asynchronous learning, learning biochemistry, learning management system, synchronous learning, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {S3695--S3698},
