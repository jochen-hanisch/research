	journal = {Algorithms},
	publisher = {MDPI AG},
	author = {Rigopouli, Kalliopi and Kotsifakos, Dimitrios and Psaromiligkos, Yannis},
	month = jul,
	year = {2025},
	keywords = {Promotion:Literaturverzeichnis},
