@article{katz_simulation_2017,
	title = {Simulation {Training}: {Evaluating} the {Instructor}?s {Contribution} to a {Wizard} of {Oz} {Simulator} in {Obstetrics} and {Gynecology} {Ultrasound} {Training}},
	volume = {3},
	url = {http://mededu.jmir.org/2017/1/e8/},
	doi = {10.2196/mededu.6312},
	abstract = {Background: Workplaces today demand graduates who are prepared with field-specific knowledge, advanced social skills, problem-solving skills, and integration capabilities. Meeting these goals with didactic learning (DL) is becoming increasingly difficult. Enhanced training methods that would better prepare tomorrow?s graduates must be more engaging and game-like, such as feedback based e-learning or simulation-based training, while saving time. Empirical evidence regarding the effectiveness of advanced learning methods is lacking. Objective quantitative research comparing advanced training methods with DL is sparse. Objectives: This quantitative study assessed the effectiveness of a computerized interactive simulator coupled with an instructor who monitored students? progress and provided Web-based immediate feedback. Methods: A low-cost, globally accessible, telemedicine simulator, developed at the Technion?Israel Institute of Technology, Haifa, Israel?was used. A previous study in the field of interventional cardiology, evaluating the efficacy of the simulator to enhanced learning via knowledge exams, presented promising results of average scores varying from 94\% after training and 54\% before training (n=20) with P{\textless}.001. Two independent experiments involving obstetrics and gynecology (Ob-Gyn) physicians and senior ultrasound sonographers, with 32 subjects, were conducted using a new interactive concept of the WOZ (Wizard of OZ) simulator platform. The contribution of an instructor to learning outcomes was evaluated by comparing students? knowledge before and after each interactive instructor-led session as well as after fully automated e-learning in the field of Ob-Gyn. Results from objective knowledge tests were analyzed using hypothesis testing and model fitting. Results: A significant advantage (P=.01) was found in favor of the WOZ training approach. Content type and training audience were not significant. Conclusions: This study evaluated the contribution of an integrated teaching environment using a computerized interactive simulator, with an instructor providing immediate Web-based immediate feedback to trainees. Involvement of an instructor in the simulation-based training process provided better learning outcomes that varied training content and trainee populations did not affect the overall learning gains.},
	number = {1},
	journal = {JMIR Med Educ},
	author = {Katz, Aric and Tepper, Ronnie and Shtub, Avraham},
	month = apr,
	year = {2017},
	keywords = {Feedback, Simulation, Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, Promotion:FU4b, distance learning, \#5:Zeitschriftenartikel:e-learning, evaluation research, Promotion:S:05 E-Learning, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU4b},
	pages = {e8},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:
Die Studie von Katz et al. (2017) untersucht die Wirksamkeit eines computerbasierten, interaktiven Simulators mit Instruktor-Unterstützung (Wizard of Oz, WOZ) im Vergleich zu einem vollständig automatisierten E-Learning-Ansatz. Ziel der Forschung ist es, den Einfluss der Instruktor-Unterstützung auf die Lernergebnisse von Ärztinnen und Ärzten sowie Ultraschalltechnikerinnen im Bereich der Geburtshilfe und Gynäkologie zu bewerten.
Verwendete Methoden und Datenquellen:


Design: Quantitative Vergleichsstudie


Datenquellen: Wissensprüfungen vor und nach den Trainings, sowie Fragebögen zur Zufriedenheit und Bewertung der Lernumgebung.


Teilnehmer: 32 Personen, darunter 18 Ärzte und 14 Ultraschalltechnikerinnen.


Evaluationsmethoden: Vorher-Nachher-Wissensprüfungen, statistische Analysen mittels gemischter Modelle und Varianzanalysen.


Zentrale Forschungsergebnisse:


Wissenszuwachs: Die WOZ-Gruppe zeigte signifikant höhere Wissenszuwächse im Vergleich zur E-Learning-Gruppe.


Ärzte: WOZ 79\% (SD 24) vs. E-Learning 64\% (SD 13).


Ultraschalltechnikerinnen: WOZ 83\% (SD 7) vs. E-Learning 63\% (SD 11).




Interaktivität: Der Beitrag des Instruktors im WOZ-Ansatz führte zu einer besseren Verständnisvermittlung und Lernkorrektur durch sofortiges Feedback.


Statistische Signifikanz: Der Unterschied in den Lernergebnissen zwischen WOZ und E-Learning war signifikant (P=.01), unabhängig von der Art der Teilnehmer (Ärzte oder Ultraschalltechnikerinnen).


Zusammenfassung
Die Studie zeigt, dass der WOZ-Ansatz mit Instruktor-Unterstützung signifikant bessere Lernergebnisse erzielt als ein vollständig automatisiertes E-Learning-Format. Die Ergebnisse deuten darauf hin, dass die Interaktivität und das sofortige Feedback durch den Instruktor entscheidend zur Verbesserung des Wissens und der Fertigkeiten der Lernenden beitragen.
Kernaussagen


„Der WOZ-Ansatz führte zu signifikant höheren Wissenszuwächsen bei den Teilnehmern im Vergleich zum vollständig automatisierten E-Learning.“ (S. 6)


„Die Unterstützung durch einen Instruktor im WOZ-Ansatz ermöglichte eine bessere Verständnisvermittlung und sofortige Korrektur von Fehlvorstellungen.“ (S. 7)


„Der Einfluss des Trainingstyps (WOZ vs. E-Learning) war unabhängig von der Art der Teilnehmer (Ärzte oder Ultraschalltechnikerinnen).“ (S. 8)


Argumentationslinien


Vorteile der Instruktor-Unterstützung: Die Studie argumentiert, dass die Unterstützung durch einen Instruktor, der sofortiges Web-basiertes Feedback gibt, die Lernresultate signifikant verbessert. (S. 7)


Effektivität des WOZ-Ansatzes: Der WOZ-Ansatz erwies sich als effektiver, um Lernende in medizinischen Fachgebieten zu schulen, insbesondere durch die Einbindung von Echtzeit-Feedback und Interaktivität. (S. 8)


Unabhängigkeit von Teilnehmertypen: Die Ergebnisse zeigen, dass die Art der Teilnehmer (Ärzte oder Ultraschalltechnikerinnen) keinen signifikanten Einfluss auf die Effektivität des Trainingsansatzes hatte. (S. 9)


Verschlagwortung


Lehr- und Lerneffektivität: Untersuchung der Effektivität des WOZ-Ansatzes zur Verbesserung der Wissensvermittlung und der praktischen Fertigkeiten.


Technologieintegration: Nutzung eines computerbasierten Simulators mit Instruktor-Unterstützung zur medizinischen Ausbildung.


Systemanpassung: Anpassung des Simulationsansatzes an die spezifischen Bedürfnisse der Lernenden im Bereich der Geburtshilfe und Gynäkologie.


Forschungsansätze: Quantitative Vergleichsstudie zur Bewertung der Wirksamkeit von Simulationstrainings mit und ohne Instruktor-Unterstützung.


Kategorisierung: Argumentation
Begründung:
Die Studie von Katz et al. (2017) liefert starke Argumente für die Wirksamkeit der Instruktor-Unterstützung im WOZ-Ansatz zur Verbesserung der Lernergebnisse im Vergleich zu einem vollständig automatisierten E-Learning-Ansatz. Durch die detaillierte Analyse der Wissenszuwächse und die statistische Signifikanz der Ergebnisse wird argumentiert, dass interaktive, instruktor-unterstützte Lernmethoden im medizinischen Bildungsbereich überlegen sind. Diese Argumentationslinien sind besonders relevant für die Forschungsfragen des Exposés, da sie die praktischen und theoretischen Aspekte der Lernoptimierung im digitalen Bildungsraum beleuchten.
Kategorie: Argumentation
Zuordnung zur Forschungsfrage
FU4b: Welche bildungstechnologischen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems in Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?
Begründung:
Die Studie untersucht die bildungstechnologischen Mechanismen des WOZ-Ansatzes und ihre Auswirkungen auf die Wissensvermittlung und die praktischen Fertigkeiten der Lernenden. Diese Erkenntnisse sind besonders relevant, um die Mechanismen eines systemisch-konstruktivistischen Learning-Management-Systems im digitalen Bildungsraum von Gesundheitsberufen zu verstehen und zu optimieren.
},
	file = {Katz et al. - 2017 - Simulation Training Evaluating the Instructors C.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/BSPFMH8Q/Katz et al. - 2017 - Simulation Training Evaluating the Instructors C.pdf:application/pdf},
}

@article{de_ruijter_effectiveness_2018,
	title = {The {Effectiveness} of a {Computer}-{Tailored} {E}-{Learning} {Program} for {Practice} {Nurses} to {Improve} {Their} {Adherence} to {Smoking} {Cessation} {Counseling} {Guidelines}: {Randomized} {Controlled} {Trial}},
	volume = {20},
	url = {http://www.jmir.org/2018/5/e193/},
	doi = {10.2196/jmir.9276},
	abstract = {Background: Improving practice nurses? (PN) adherence to smoking cessation counseling guidelines will benefit the quality of smoking cessation care and will potentially lead to higher smoking abstinence rates. However, support programs to aid PNs in improving their guideline uptake and adherence do not exist yet. Objective: The aim of this study was to assess the effects of a novel computer-tailored electronic learning (e-learning) program on PNs? smoking cessation guideline adherence. Methods: A Web-based randomized controlled trial (RCT) was conducted in which an intervention group (N=147) with full access to the e-learning program for 6 months was compared with a control group (N=122) without access. Data collection was fully automated at baseline and 6-month follow-up via online questionnaires, assessing PNs? demographics, work-related factors, potential behavioral predictors based on the I-Change model, and guideline adherence. PNs also completed counseling checklists to retrieve self-reported counseling activities for each consultation with a smoker (N=1175). To assess the program?s effectiveness in improving PNs? guideline adherence (ie, overall adherence and adherence to individual counseling guideline steps), mixed linear and logistic regression analyses were conducted, thus accommodating for the smokers being nested within PNs. Potential effect moderation by work-related factors and behavioral predictors was also examined. Results: After 6 months, 121 PNs in the intervention group (82.3\%, 121/147) and 103 in the control group (84.4\%, 103/122) completed the follow-up questionnaire. Mixed linear regression analysis revealed that counseling experience moderated the program?s effect on PNs? overall guideline adherence (beta=.589; 95\% CI 0.111-1.068; PHolm-Bonferroni =.048), indicating a positive program effect on adherence for PNs with a more than average level of counseling experience. Mixed logistic regression analyses regarding adherence to individual guideline steps revealed a trend toward moderating effects of baseline levels of behavioral predictors and counseling experience. More specifically, for PNs with less favorable scores on behavioral predictors (eg, low baseline self-efficacy) and high levels of counseling experience, the program significantly increased adherence. Conclusions: Results from our RCT showed that among PNs with more than average counseling experience, the e-learning program resulted in significantly better smoking cessation guideline adherence. Experienced PNs might have been better able to translate the content of our e-learning program into practically applicable counseling strategies compared with less experienced colleagues. Less favorable baseline levels of behavioral predictors among PNs possibly contributed to this effect, as there was more room for improvement by consulting the tailored content of the e-learning program. To further substantiate the effectiveness of e-learning programs on guideline adherence by health care professionals (HCPs), it is important to assess how to support a wider range of HCPs. Trial Registration: Netherlands Trial Register NTR4436; http://www.trialregister.nl/trialreg/admin/rctview.asp?TC=4436 (Archived by WebCite at http://www.webcitation.org/6zJQuSRq0)},
	number = {5},
	journal = {J Med Internet Res},
	author = {de Ruijter, Dennis and Candel, Math and Smit, Suzanne Eline and de Vries, Hein and Hoving, Ciska},
	month = may,
	year = {2018},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, Promotion:FU4b, online learning, \#5:Zeitschriftenartikel:e-learning, smoking cessation, randomized controlled trial, advanced practice nursing, guideline adherence, Promotion:S:05 E-Learning, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {e193},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:
Die Studie von de Ruijter et al. (2018) untersucht die Effektivität eines computer-gestützten E-Learning-Programms, um die Einhaltung von Rauchstopp-Beratungslinien durch Praxiskrankenschwestern (PNs) zu verbessern. Ziel der Forschung ist es, die Auswirkungen dieses Programms auf die Adhärenz zu Richtlinien für die Rauchstopp-Beratung zu bewerten und zu verstehen, wie unterschiedliche Verhaltensprädiktoren diese Adhärenz beeinflussen.
Verwendete Methoden und Datenquellen:


Design: Randomisierte kontrollierte Studie.


Teilnehmer: 269 Praxiskrankenschwestern, aufgeteilt in eine Interventionsgruppe (n=147) mit Zugang zum E-Learning-Programm und eine Kontrollgruppe (n=122) ohne Zugang.


Evaluationsmethoden: Online-Fragebögen zur Erhebung von demographischen Daten, arbeitsbezogenen Faktoren, potentiellen Verhaltensprädiktoren und Adhärenz zu Richtlinien. PNs füllten auch Beratungschecklisten aus, um selbstberichtete Beratungstätigkeiten zu erfassen.


Zentrale Forschungsergebnisse:


Verbesserte Adhärenz: Die Interventionsgruppe zeigte nach 6 Monaten eine signifikant bessere Adhärenz zu den Rauchstopp-Richtlinien im Vergleich zur Kontrollgruppe, insbesondere bei PNs mit überdurchschnittlicher Beratungserfahrung.


Moderierende Faktoren: Verhaltensprädiktoren wie Selbstwirksamkeit und wahrgenommene Vorteile der Richtliniennutzung beeinflussten die Effektivität des Programms. PNs mit niedrigerer Selbstwirksamkeit und höherem sozialem Rückhalt zeigten größere Verbesserungen.


Nutzung des Programms: Die Nutzung des E-Learning-Programms war generell gering, aber PNs mit mehr Beratungserfahrung nutzten das Programm häufiger und erzielten dadurch bessere Adhärenzraten.


Zusammenfassung
Die Studie zeigt, dass ein computer-gestütztes E-Learning-Programm die Adhärenz von Praxiskrankenschwestern zu Rauchstopp-Richtlinien signifikant verbessern kann, insbesondere bei erfahrenen PNs. Die Ergebnisse unterstreichen die Bedeutung von Verhaltensprädiktoren wie Selbstwirksamkeit und sozialem Rückhalt für die Wirksamkeit solcher Programme.
Kernaussagen


„Die Interventionsgruppe zeigte nach 6 Monaten eine signifikant bessere Adhärenz zu den Rauchstopp-Richtlinien im Vergleich zur Kontrollgruppe.“ (S. 7)


„Verhaltensprädiktoren wie Selbstwirksamkeit und wahrgenommene Vorteile der Richtliniennutzung beeinflussten die Effektivität des Programms.“ (S. 8)


„PNs mit mehr Beratungserfahrung nutzten das Programm häufiger und erzielten dadurch bessere Adhärenzraten.“ (S. 9)


Argumentationslinien


Effektivität von E-Learning: Die Studie argumentiert, dass E-Learning-Programme effektiv sein können, um die Adhärenz zu medizinischen Richtlinien zu verbessern, insbesondere wenn sie auf individuelle Verhaltensprädiktoren abgestimmt sind. (S. 7-8)


Bedeutung von Beratungserfahrung: Die Ergebnisse zeigen, dass erfahrene PNs besser in der Lage sind, die Inhalte des E-Learning-Programms in ihre Beratungspraxis zu integrieren, was zu einer besseren Adhärenz führt. (S. 9-10)


Niedrige Nutzung: Trotz der positiven Auswirkungen war die Nutzung des Programms gering, was auf die Notwendigkeit hinweist, Strategien zur Förderung der Programmnutzung zu entwickeln. (S. 11)


Verschlagwortung


Technologieintegration: Nutzung eines computer-gestützten E-Learning-Programms zur Verbesserung der Adhärenz zu Rauchstopp-Richtlinien.


Lehr- und Lerneffektivität: Untersuchung der Effektivität von E-Learning-Programmen zur Verbesserung der Adhärenz zu medizinischen Richtlinien.


Systemanpassung: Anpassung des E-Learning-Programms an die spezifischen Bedürfnisse und Präferenzen der Praxiskrankenschwestern.


Forschungsansätze: Randomisierte kontrollierte Studie zur Bewertung der Wirksamkeit von E-Learning-Methoden.


Kategorisierung: Argumentation
Begründung:
Die Studie von de Ruijter et al. (2018) verwendet verschiedene quantitative und qualitative Methoden, um die Effektivität eines computer-gestützten E-Learning-Programms zu bewerten. Durch die detaillierte Analyse der unterschiedlichen Auswirkungen des Programms auf die Adhärenz zu Richtlinien und die Rolle von Verhaltensprädiktoren wird argumentiert, dass ein individuell abgestimmtes E-Learning-Programm notwendig ist, um die Adhärenz zu medizinischen Richtlinien zu verbessern. Diese Argumentationslinien sind besonders relevant für die Forschungsfragen des Exposés, da sie die theoretischen und praktischen Aspekte der Implementierung von E-Learning-Methoden im digitalen Bildungsraum beleuchten.
Kategorie: Argumentation
Zuordnung zur Forschungsfrage
FU4b: Welche bildungstechnologischen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems in Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?
Begründung:
Die Studie untersucht die bildungstechnologischen Mechanismen, die durch die Anwendung eines computer-gestützten E-Learning-Programms aktiviert werden, um die Adhärenz zu medizinischen Richtlinien zu verbessern. Diese Erkenntnisse sind besonders relevant, um die Wirkungen eines systemisch-konstruktivistischen Learning-Management-Systems auf die Akteure im digitalen Bildungsraum von Gesundheitsberufen zu verstehen und zu optimieren.
},
	file = {de Ruijter et al. - 2018 - The Effectiveness of a Computer-Tailored E-Learnin.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/XIQ7YNGT/de Ruijter et al. - 2018 - The Effectiveness of a Computer-Tailored E-Learnin.pdf:application/pdf},
}

@article{clavier_use_2019,
	title = {Use of the {Smartphone} {App} {WhatsApp} as an {E}-{Learning} {Method} for {Medical} {Residents}: {Multicenter} {Controlled} {Randomized} {Trial}},
	volume = {7},
	url = {http://mhealth.jmir.org/2019/4/e12825/},
	doi = {10.2196/12825},
	abstract = {Background: The WhatsApp smartphone app is the most widely used instant messaging app in the world. Recent studies reported the use of WhatsApp for educational purposes, but there is no prospective study comparing WhatsApp?s pedagogical effectiveness to that of any other teaching modality. Objective: The main objective of this study was to measure the impact of a learning program via WhatsApp on clinical reasoning in medical residents. Methods: This prospective, randomized, multicenter study was conducted among first- and second-year anesthesiology residents (offline recruitment) from four university hospitals in France. Residents were randomized in two groups of online teaching (WhatsApp and control). The WhatsApp group benefited from daily delivery of teaching documents on the WhatsApp app and a weekly clinical case supervised by a senior physician. In the control group, residents had access to the same documents via a traditional computer electronic learning (e-learning) platform. Medical reasoning was self-assessed online by a script concordance test (SCT; primary parameter), and medical knowledge was assessed using multiple-choice questions (MCQs). The residents also completed an online satisfaction questionnaire. Results: In this study, 62 residents were randomized (32 to the WhatsApp group and 30 to the control group) and 22 residents in each group answered the online final evaluation. We found a difference between the WhatsApp and control groups for SCTs (60\% [SD 9\%] vs 68\% [SD 11\%]; P=.006) but no difference for MCQs (18/30 [SD 4] vs 16/30 [SD 4]; P=.22). Concerning satisfaction, there was a better global satisfaction rate in the WhatsApp group than in the control group (8/10 [interquartile range 8-9] vs 8/10 [interquartile range 8-8]; P=.049). Conclusions: Compared to traditional e-learning, the use of WhatsApp for teaching residents was associated with worse clinical reasoning despite better global appreciation. The use of WhatsApp probably contributes to the dispersion of attention linked to the use of the smartphone. The impact of smartphones on clinical reasoning should be studied further.},
	number = {4},
	journal = {JMIR Mhealth Uhealth},
	author = {Clavier, Thomas and Ramen, Julie and Dureuil, Bertrand and Veber, Benoit and Hanouz, Jean-Luc and Dupont, Hervé and Lebuffe, Gilles and Besnier, Emmanuel and Compere, Vincent},
	month = apr,
	year = {2019},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Promotion:FU2a, Systemanpassung, Promotion:Argumentation, Außergewöhnlich 🟣, mobile phone, \#5:Zeitschriftenartikel:e-learning, educational measurement, smartphone, mobile applications, WhatsApp, anesthesiology, trauma, teaching materials, education, medical, graduate/methods, hemorrhage, internship and residency, Promotion:S:05 E-Learning, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {e12825},
	annote = {Kernstudie identifiziert für das Forschungsprojekt "Wirkgefüge im digitalen Bildungsraum":


Titel: Use of the Smartphone App WhatsApp as an E-Learning Method for Medical Residents: Multicenter Controlled Randomized Trial


Autoren: Clavier, T., Ramen, J., Dureuil, B., Veber, B., Hanouz, J.-L., Dupont, H., Lebuffe, G., Besnier, E., \& Compere, V.


Publiziert in: JMIR Mhealth Uhealth


Band/Volume: 7


Ausgabe: 4


