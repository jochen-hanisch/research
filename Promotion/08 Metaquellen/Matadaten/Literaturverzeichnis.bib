@article{wooLpe,
  title = {Learning Prompt Engineering for Academic Writing with {{ChatGPT}}: {{Postgraduate}} Students' Motivation, Cognitive Load, and Satisfaction},
  author = {Woo, David James and Wang, Deliang and Yung, Tim and Guo, Kai},
  abstract = {This mixed methods study explored postgraduate students' perceptions of learning to write with ChatGPT in support of their MA in Hong Kong History program. In a workshop format, 27 students were introduced to ChatGPT task capabilities and prompt engineering, and jointly constructed ChatGPT prompts while attempting to write a 500-word dissertation research proposal. Data collected included a pre-workshop motivation questionnaire and a postworkshop questionnaire with Likert scale items on motivation, cognitive load, and satisfaction. Results revealed no significant difference in students’ motivation before and after the workshop, but mean motivation scores increased slightly. Students reported low cognitive load and expressed high satisfaction with the workshop overall. Findings indicate ChatGPT’s potential to engage postgraduate students in the classroom and to support discipline-specific academic writing. For students to ethically use ChatGPT to support their academic writing, educators can consider designing and implementing prompt engineering activities and materials.},
