	keywords = {Charité:Promotion, Promotion:Literaturanalyse, \#0:Zeitschriftenartikel:digital:learning, Promotion:S:12 Digital Learning, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {297--322},
	file = {Niesyto und Junge - 2020 - Digitale Medien in der Grundschullehrerbildung Er.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/D47RV8B9/Niesyto und Junge - 2020 - Digitale Medien in der Grundschullehrerbildung Er.pdf:application/pdf},
