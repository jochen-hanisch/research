@article{suwanbamrung_evaluating_2025,
	title = {Evaluating the effectiveness of the integrated research subject research-based learning online ({IRS}-{RBLO}) model: retrospective record review study},
	volume = {25},
	issn = {1472-6920},
	shorttitle = {Evaluating the effectiveness of the integrated research subject research-based learning online ({IRS}-{RBLO}) model},
	url = {https://bmcmededuc.biomedcentral.com/articles/10.1186/s12909-025-07325-1},
	doi = {10.1186/s12909-025-07325-1},
	abstract = {Background The Integrated research subject-research-based learning online (IRS-RBLO) model is developed based on research-based learning, the components of the research process, and elements of online learning design. We aimed to evaluate the effectiveness of the IRS-RBLO in enhancing the learning outcome and research knowledge among community public health students at Walailak University, Thailand.
Methods This study applied a retrospective record review of 67 complete records out of 80 fourth-year community public health students of Walailak University to study the effectiveness of the IRS-RBLO model through research knowledge and learning outcomes. Research knowledge and learning outcomes were assessed using 40 multiple choice questions and 40 Likert scale questioners, respectively. The T-test was applied to analyze research knowledge before (1st week) and during learning (7th week), and ANOVA statistics to analyze students’ learning outcomes before (1st week), during (7th week), and after (16th week) learning with the IRS-RBLO model.
Results Students exhibited a significant difference in research knowledge (p =.00), with 35.88\% percentage increase in aggregate knowledge assessment score before and during; and learning outcomes before, during, and after learning with the IRS-RBLO model (P =.00), with 17.44\% increase in overall learning outcome increase between the scores of before and after. However, it showed variable results while comparing before and during (P {\textless}.001), before and after (P =.001), and during and after (P =.045) learning with the IRS-RBLO model.
Conclusions The IRS-RBLO model has shown its significant difference in research knowledge and learning outcomes. We recommend the broader implementation of the model, and future research may explore instructor opinions, and investigate educational policy implications to further validate the model’s effectiveness. Clinical trial number Not applicable.},
	language = {en-GB},
	number = {1},
	urldate = {2025-06-03},
	journal = {BMC Medical Education},
	author = {Suwanbamrung, Charuai and Israel, Eskinder and Mehraj, Sandeep Kumar and Stanikzai, Muhammad Haroon and Ageru, Temesgen Anjulo and Jaroenpool, Jiraporn and Pibul, Panatda and Shohaimi, Shamarina and Kercho, Melkamu Worku},
	month = may,
	year = {2025},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:FU4a, Promotion:Relevanz:5, Technologieintegration, Systemanpassung, Promotion:Schlussfolgerung, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {775},
	annote = {Analyse der Studie „Evaluating the effectiveness of the integrated research subject research-based learning online (IRS-RBLO) model“ von Suwanbamrung et al. (2025)

1. Hauptthemen und Ziele der Forschung
Die Studie untersucht die Effektivität des IRS-RBLO-Modells – eines didaktischen Konzepts, das Forschungskompetenz, Online-Lernmethoden und aktive Lernansätze integriert. Ziel ist es, die Wirkung dieses Modells auf das Forschungswissen und die Lernergebnisse von Public-Health-Studierenden an der Walailak University (Thailand) zu evaluierenSuwanbamrung et al. - 2….

2. Methoden und Datenquellen


Design: Retrospektive Aktenanalyse (16 Wochen).


Stichprobe: 67 vollständige Datensätze von insgesamt 80 Studierenden im 4. Jahr des Public-Health-Studiengangs.


Datenerhebung: Dokumentenanalyse (Leistungsnachweise, Bewertungsbögen, Fragebögen).


Instrumente:


Forschungswissen: 40 Multiple-Choice-Fragen (z. B. Forschungsdesign, Datenerhebung, Methodik).


Lernergebnis: 40 Items (Likert-Skala) gemäß Thai Qualifications Framework (TQF: HEd) und UK Professional Standards Framework (UKPSF), 5 Kompetenzdimensionen.




Analyseverfahren: T-Test (Wissen: Woche 1 vs. Woche 7), ANOVA (Lernergebnisse Woche 1, 7, 16)Suwanbamrung et al. - 2….



3. Zentrale Forschungsergebnisse


Forschungswissen:


Vorher: 25/40 Punkte; währenddessen: 33.97/40 Punkte → +35,88 \% Zuwachs, signifikant (P {\textless} 0.001)Suwanbamrung et al. - 2….




Lernergebnisse:


Zunahme um +17,44 \% von Woche 1 zu Woche 16 (siehe Abb. 1 auf S. 7).


Signifikante Unterschiede in fast allen Bereichen:


Wissen, Kognition, Analysekompetenz zeigten Verbesserungen auch zwischen Woche 7 und 16.


Ethik, Interpersonale Verantwortung zeigten keinen signifikanten Zuwachs nach Woche 7Suwanbamrung et al. - 2….






Statistik: Alle Gesamtunterschiede im Lernzuwachs signifikant (ANOVA, F = 59.667; P {\textless} 0.001)Suwanbamrung et al. - 2….



4. Zusammenfassung
Das IRS-RBLO-Modell verbessert signifikant sowohl das Forschungswissen als auch die Lernergebnisse. Die Studie zeigt, dass durch die Integration von Forschung, Online-Lernen und aktiver Lehre die Kompetenzen der Studierenden messbar gesteigert werden können. Besonders effektiv erwies sich das Modell bei kognitiven, analytischen und kommunikativen Fähigkeiten, weniger stark bei ethischen und sozialen AspektenSuwanbamrung et al. - 2….

5. Kernaussagen


Wissenszuwachs: „The aggregate knowledge showed a statistically significant difference (P {\textless} .001) with 35.88 \% score difference“ (S. 5)Suwanbamrung et al. - 2….


Lernergebnisse: „Overall learning outcome showed 17.44 \% increase between the scores of before and after“ (S. 5, Abb. 1)Suwanbamrung et al. - 2….


Didaktisches Fazit: „The model helped students translate their theoretical knowledge to practical knowledge [...] and provided structured assessment and timely feedback“ (S. 5)Suwanbamrung et al. - 2….


Grenzen der Wirksamkeit: „No statistically significant difference in ethics and interpersonal skills and responsibility between week 7 and 16“ (S. 6, Tabelle 2)Suwanbamrung et al. - 2….



6. Argumentationslinien
Die Argumentation folgt dem Aufbau:


Ausgangslage: COVID-19 → Umstellung auf Online-Lehre.


Einführung eines systemisch konstruierten, forschungsbasierten Online-Modells (IRS-RBLO).


Empirische Evaluation anhand quantitativer Vergleichswerte.


Schlussfolgerung: Wirksamkeit des Modells → Empfehlung zur breiteren ImplementierungSuwanbamrung et al. - 2….



7. Verschlagwortung


Forschungsansätze: Retrospektive Querschnittsstudie mit klar definiertem, operationalisiertem Design.


Technologieintegration: Online-Teaching, digitale Kollaboration und Blended Learning wurden systematisch verzahnt.


Lehr- und Lerneffektivität: Deutlicher Kompetenzzuwachs, vor allem in kognitiven Bereichen.


Systemanpassung: Reaktion auf pandemiebedingte Herausforderungen durch strukturierte Modellanpassung.



8. Kategorisierung
Kategorie: SchlussfolgerungBegründung: Die Studie zieht evidenzbasierte Schlussfolgerungen aus einem strukturieren Modellvergleich und leitet daraus bildungspolitische sowie curriculare Empfehlungen abSuwanbamrung et al. - 2….

9. Zuordnung zu Forschungsunterfrage
Passendste Forschungsunterfrage:


FU4a: Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?


Begründung: Die Studie analysiert Wirkzusammenhänge zwischen systemischer didaktischer Modellanwendung und Kompetenzentwicklung unter Einsatz digitaler Lehrmittel im Gesundheitskontext.

10. Relevanzbewertung


Direkte Relevanz für die FU: 5


Tiefe der Analyse und empirische Fundierung: 5


Curriculare Anschlussfähigkeit: 5


Gesamtbewertung: 5

11. Schlussfolgerung
Die IRS-RBLO-Studie zeigt eindrucksvoll, dass forschungsbasiertes, digital integriertes Lernen im Public-Health-Kontext die Kompetenzentwicklung systematisch steigern kann. Der nachweisbare Effekt auf Wissen, Problemlösefähigkeit und Methodenanwendung ist hoch relevant für die Gestaltung zukünftiger Curricula im digitalen Bildungsraum der Gesundheitsberufe.
