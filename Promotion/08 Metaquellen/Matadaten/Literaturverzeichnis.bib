@article{dornebusch_digitale_2022,
	series = {Themenheft},
	title = {Digitale {Kompetenzen} umfassend und integrativ erwerben: {Vorstellung} des {Seminars} ‹{Lehren} und {Lernen} in der digitalen {Welt}›},
	issn = {1424-3636, 1424-3636},
	abstract = {Digital skills are now also indispensable in everyday school life. The utilization of digital tools for preparing and following up lessons or entire events have to be performed virtually under the pandemic conditions can be seen as an example of digital change in education. However, it is unclear how prospective teachers can actually acquire these digital competencies. To counteract this, concrete concepts are essential to promote the acquisition of competencies in this area. It is also unclear how this acquisition of competencies can be sufficient developed during the course of study. This paper shows one way to do so. This article presents the seminar «Teaching and learning in the digital world» at the TU-Dresden in the supplementary area (interdisciplinary) for student teachers. The seminar approaches the topic from two perspectives, teaching and learning «with» and «about» digital media. In addition to presenting the seminar, the article discusses the extension of the topic of «inclusive educational processes». The article shows how an established seminar concept on the digital educational context aims to introduce prospective teachers to the basics of inclusion in addition to digital competencies. The article hopes to inspire people on the integration and connection between digital and inclusion topics in teaching formats.},
	language = {de-DE},
	number = {48},
	journal = {MedienPädagogik Zeitschrift für Theorie und Praxis der Medienbildung},
	author = {Dornebusch, Konrad},
	editor = {Reich-Stiebert, Natalia and Raimann, ennifer and Thorbrügge, Carsten and Schäfer, Len Ole},
	month = jun,
	year = {2022},
	keywords = {Promotion:Literaturanalyse, Kollaboratives Lernen, Lehr- und Lerneffektivität, Technologieintegration, Bildungstheorien, Promotion:Argumentation, Promotion:Relevanz:4, \#0:Zeitschriftenartikel:digital:learning, Promotion:FU3, Promotion:S:12 Digital Learning, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {9},
	annote = {Analyse des Artikels „Digitale Kompetenzen umfassend und integrativ erwerben: Vorstellung des Seminars ‹Lehren und Lernen in der digitalen Welt›“ von Dornebusch (2022)

1. Hauptthemen und Ziele der Forschung
Der Artikel beschreibt ein Seminar, das an der Technischen Universität Dresden entwickelt wurde, um digitale Kompetenzen und inklusive Bildungsprozesse in der Lehrer:innenbildung zu fördern. Ziel ist es, Lehramtsstudierende durch Blended-Learning-Ansätze praxisnah auf die Herausforderungen digitaler und inklusiver Bildung vorzubereiten.

2. Methoden und Datenquellen


Seminarkonzept:


Blended-Learning-Format mit fünf Online-Selbstlernphasen und fünf Präsenzterminen.


Fokus auf Lernen „mit“ und „über“ digitale Medien, basierend auf dem 4C/ID-Modell (Merriënboer und Kirschner, 2007).




Evaluationsmethoden:


Anwendung des Kirkpatrick-Modells (2016) zur Messung von Zufriedenheit, Wissenserwerb und Anwendung des Gelernten.




Datenquellen:


Evaluationsdaten von 22 Teilnehmenden aus den ersten Semestern.


Vergleich der studentischen Abgaben nach festgelegten Kriterien.





3. Zentrale Forschungsergebnisse


Erwerb digitaler Kompetenzen:


Studierende entwickelten Unterrichtspläne, die den didaktischen Einsatz digitaler Medien umfassen.


Lernen „mit“ digitalen Medien war leichter umzusetzen als Lernen „über“ digitale Medien.




Inklusion im digitalen Kontext:


Erweiterung des Seminars durch Aspekte wie barrierefreie digitale Tools und die Integration inklusiver Perspektiven.


Themen wie „Sprache-zu-Text-Umwandlung“ oder „Apps für inklusives Lernen“ wurden in das Seminar integriert.




Praktische Anwendung und Akzeptanz:


Hohe Zufriedenheit mit dem Blended-Learning-Format, insbesondere aufgrund der Flexibilität und Praxisnähe.





Zusammenfassung
Das Seminar „Lehren und Lernen in der digitalen Welt“ bietet ein umfassendes Konzept zur Vermittlung digitaler Kompetenzen und zur Integration inklusiver Bildungsansätze. Es nutzt Blended-Learning-Formate und praxisnahe Aufgaben, um angehende Lehrkräfte auf digitale und heterogene Lernumgebungen vorzubereiten.

Kernaussagen


Blended-Learning fördert Flexibilität und Praxisnähe:


Studierende schätzen die Möglichkeit, theoretische Inhalte in praktischen Aufgaben anzuwenden. (S. 88)




Digitale und inklusive Kompetenzen:


Die Kombination von inklusiver Bildung und digitalem Lernen bereitet Studierende auf die Anforderungen moderner Klassenzimmer vor. (S. 92)




Herausforderungen bei der Umsetzung:


Die Integration von Themen wie „Lernen über digitale Medien“ erfordert zusätzliche Unterstützung. (S. 90)





Argumentationslinien


Synergie von Theorie und Praxis:


Das Seminar verbindet theoretische Modelle mit praxisorientierten Ansätzen, um nachhaltiges Lernen zu fördern.




Fokus auf Inklusion:


Digitale Kompetenzen werden explizit mit inklusiven Ansätzen verknüpft, um Diversität in der Bildung zu unterstützen.




Innovative Didaktik:


Die Anwendung des 4C/ID-Modells bietet eine strukturierte Grundlage für die Entwicklung komplexer Kompetenzen.





Verschlagwortung


Bildungstheorien:


Begründung: Das Seminar basiert auf theoretischen Modellen wie dem 4C/ID-Modell und dem Dagstuhl-Dreieck.




Lehr- und Lerneffektivität:


Begründung: Die Evaluierung zeigt, dass das Blended-Learning-Format die Lernziele effektiv unterstützt.




Technologieintegration:


Begründung: Der Einsatz digitaler Tools wie OPAL oder Puppet Pals wird analysiert und reflektiert.





Kategorisierung
Kategorie: KerngedankeBegründung: Der Artikel konzentriert sich auf die Verbindung von Theorie, digitaler Kompetenzförderung und inklusiver Bildung als zentralen Ansatzpunkt für die Lehrer:innenbildung.

Zuordnung zur Forschungsunterfrage
Passendste Forschungsunterfrage:FU3:„Wie sind Konzeption und relevante didaktische und bildungstechnologische Merkmale des systemisch-konstruktivistischen Learning-Management-Systems für Akteure im digitalen Bildungsraum dargestellt?“
Begründung:Die Studie beschreibt detailliert, wie ein LMS und didaktische Ansätze für die Förderung digitaler und inklusiver Kompetenzen kombiniert werden können.

Relevanzbewertung


Relevanz: 5Die Arbeit liefert fundierte Einblicke in die Gestaltung von Seminaren zur Förderung digitaler und inklusiver Kompetenzen und zeigt klare Ansätze zur Integration in digitale Bildungssysteme.


},
	file = {Dornebusch - 2022 - Digitale Kompetenzen umfassend und integrativ erwe.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/29TUNV2J/Dornebusch - 2022 - Digitale Kompetenzen umfassend und integrativ erwe.pdf:application/pdf},
}

@article{hurley_evaluation_2019,
	title = {Evaluation of an {E}-{Learning} {Training} {Program} to {Support} {Implementation} of a {Group}-{Based}, {Theory}-{Driven}, {Self}-{Management} {Intervention} {For} {Osteoarthritis} and {Low}-{Back} {Pain}: {Pre}-{Post} {Study}},
	volume = {21},
	url = {https://www.jmir.org/2019/3/e11123/},
	doi = {10.2196/11123},
	abstract = {Background: By adaptation of the face-to-face physiotherapist-training program previously used in the Self-management of Osteoarthritis and Low back pain through Activity and Skills (SOLAS) feasibility trial, an asynchronous, interactive, Web-based, e-learning training program (E-SOLAS) underpinned by behavior and learning theories was developed. Objective: This study investigated the effect of the E-SOLAS training program on relevant outcomes of effective training and implementation. Methods: Thirteen physiotherapists from across Ireland were trained via E-SOLAS by using mixed methods, and seven physiotherapists progressed to implementation of the 6-week group-based SOLAS intervention. The effectiveness of E-SOLAS was evaluated using the Kirkpatrick model at the levels of reaction (physiotherapist engagement and satisfaction with E-SOLAS training methods and content), learning (pre- to posttraining changes in physiotherapists? confidence and knowledge in delivering SOLAS content and self-determination theory-based communication strategies, administered via a SurveyMonkey questionnaire), and behavior (fidelity to delivery of SOLAS content using physiotherapist-completed weekly checklists). During implementation, five physiotherapists audio recorded delivery of one class, and the communication between physiotherapists and clients was assessed using the Health Care Climate Questionnaire (HCCQ), the Controlling Coach Behaviour Scale (CCBS), and an intervention-specific measure (ISM; 7-point Likert scale). A range of implementation outcomes were evaluated during training and delivery (ie, acceptability, appropriateness, feasibility, fidelity, and sustainability of E-SOLAS) using a posttraining feedback questionnaire and individual semistructured telephone interviews. Results: With regard to their reaction, physiotherapists (n=13) were very satisfied with E-SOLAS posttraining (median 5.0; interquartile range 1.0; min-max 4.0-5.0) and completed training within 3-4 weeks. With regard to learning, there were significant increases in physiotherapists? confidence and knowledge in delivery of all SOLAS intervention components (P{\textless}.05). Physiotherapists? confidence in 7 of 10 self-determination theory-based communication strategies increased (P{\textless}.05), whereas physiotherapists? knowledge of self-determination theory-based strategies remained high posttraining (P{\textgreater}.05). In terms of behavior, physiotherapists delivered SOLAS in a needs supportive manner (HCCQ: median 5.2, interquartile range 1.3, min-max 3.7-5.8; CCBS: median 6.6, interquartile range 1.0, min-max 5.6-7.0; ISM: median 4.5, interquartile range 1.2, min-max 2.8-4.8). Fidelity scores were high for SOLAS content delivery (total \%mean fidelity score 93.5\%; SD 4.9\%). The posttraining questionnaire and postdelivery qualitative interviews showed that physiotherapists found E-SOLAS acceptable, appropriate, feasible, and sustainable within primary care services to support the implementation of the SOLAS intervention. Conclusions: This study provides preliminary evidence of the effectiveness, acceptability, and feasibility of an e-learning program to train physiotherapists to deliver a group-based self-management complex intervention in primary care settings, which is equivalent to face-to-face training outcomes and would support inclusion of physiotherapists in a definitive trial of SOLAS.},
	number = {3},
	journal = {J Med Internet Res},
	author = {Hurley, A. Deirdre and Keogh, Alison and Mc Ardle, Danielle and Hall, M. Amanda and Richmond, Helen and Guerin, Suzanne and Magdalinski, Tara and Matthews, James},
	month = mar,
	year = {2019},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Technologieintegration, Bewertungsmethoden, Promotion:Argumentation, Promotion:FU5, Digitale Bildung, evaluation, implementation, effectiveness, digital learning, \#5:Zeitschriftenartikel:e-learning, program evaluation, low-back pain, osteoarthritis, physiotherapy, technology-enhanced learning, Promotion:S:05 E-Learning, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {e11123},
	annote = {Analyse des Artikels „Evaluation of an E-Learning Training Program to Support Implementation of a Group-Based, Theory-Driven, Self-Management Intervention For Osteoarthritis and Low-Back Pain“ von Hurley et al. (2019)

1. Hauptthemen und Ziele der Forschung
Der Artikel evaluiert die Wirksamkeit und Implementierbarkeit des E-Learning-Programms E-SOLAS (Self-management of Osteoarthritis and Low back pain through Activity and Skills). Ziel ist es, Physiotherapeut*innen für die Durchführung einer theoriegestützten, gruppenbasierten Selbstmanagementintervention auszubilden. Es wird untersucht, ob E-SOLAS mit traditionellen Präsenzschulungen vergleichbare Ergebnisse hinsichtlich Wissenserwerb, Kompetenzentwicklung und Implementierung erzielen kann.

2. Methoden und Datenquellen


Design:


Pre-Post-Studie mit 13 teilnehmenden Physiotherapeut*innen.


Anwendung des Kirkpatrick-Modells zur Evaluierung der Trainingsergebnisse (Reaktion, Lernen, Verhalten).




Datenquellen:


Umfragen zur Selbstwahrnehmung von Wissen und Kompetenzen.


Fidelity-Checklisten und Audioaufnahmen zur Bewertung der Implementierung.


Qualitative Interviews zur Akzeptanz und Nachhaltigkeit.




E-SOLAS-Struktur:


Sechs Module, die theoretisches Wissen (z. B. Selbstbestimmungstheorie), Kommunikationsstrategien und praktische Übungen abdecken.


Nutzung der Lernplattform Curatr mit Gamification-Elementen.





3. Zentrale Forschungsergebnisse


Wissenserwerb und Kompetenzentwicklung:


Signifikante Verbesserungen im Wissen über Inhalte und Kommunikationsstrategien.


Erhöhte Selbstwirksamkeit und Kompetenz im Umgang mit Selbstmanagement-Techniken.




Verhaltensänderung:


Die Intervention wurde mit hoher Treue (Fidelity-Score 93,5 \%) und Kompetenz umgesetzt.




Akzeptanz und Nachhaltigkeit:


Hohe Zufriedenheit mit dem E-Learning-Format.


Flexibilität und Zeitersparnis als Hauptvorteile gegenüber Präsenzschulungen.




Herausforderungen:


Technische Schwierigkeiten bei der Nutzung der Plattform.


Bedarf an weiterer Unterstützung für spezifische Kommunikationsstrategien.





Zusammenfassung
Das E-Learning-Programm E-SOLAS erweist sich als wirksame und nachhaltige Methode zur Schulung von Physiotherapeut*innen in der Primärversorgung. Es ermöglicht eine flexible und skalierbare Alternative zu Präsenzschulungen, ohne Kompromisse bei der Qualität einzugehen. Die Studie zeigt, dass digitale Trainingsprogramme eine effektive Möglichkeit bieten, Verhalten und Wissen im klinischen Kontext zu fördern.

Kernaussagen


E-Learning als effektive Alternative:


Vergleichbare Ergebnisse zu traditionellen Schulungen hinsichtlich Wissen, Kompetenz und Implementierungstreue (S. 13).




Stärkung der Selbstwirksamkeit:


Die Schulung erhöht die Selbstwirksamkeit von Physiotherapeut*innen bei der Durchführung von Selbstmanagementinterventionen (S. 9).




Technologieintegration:


Die Integration von Gamification und asynchronem Lernen fördert die Akzeptanz und den Lernerfolg (S. 4).





Argumentationslinien


Flexibilität und Skalierbarkeit:


E-SOLAS bietet eine skalierbare Lösung für groß angelegte Schulungen im Gesundheitswesen.




Wissenschaftliche Fundierung:


Die Nutzung der Selbstbestimmungstheorie und des Kirkpatrick-Modells unterstreicht die theoretische Fundierung des Programms.




Praktische Implikationen:


Ergebnisse unterstützen die Integration von E-Learning in die berufliche Weiterbildung von Gesundheitsfachkräften.





Verschlagwortung


Lehr- und Lerneffektivität:


Begründung: Fokus auf die Evaluation von Wissenserwerb und Verhaltensänderungen.




Technologieintegration:


Begründung: Nutzung digitaler Plattformen und Gamification zur Unterstützung des Lernprozesses.




Bewertungsmethoden:


Begründung: Einsatz des Kirkpatrick-Modells zur Bewertung der Trainingsergebnisse.





Kategorisierung
Kategorie: ArgumentationBegründung: Der Artikel entwickelt eine klare Argumentation für die Effektivität und Nachhaltigkeit von E-Learning im Vergleich zu traditionellen Schulungsmethoden.

Zuordnung zur Forschungsunterfrage
Passendste Forschungsunterfrage:FU5:„Welche Möglichkeiten und Grenzen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems durch Akteure im digitalen Bildungsraum von Gesundheitsberufen analysiert?“
Begründung:Die Studie beleuchtet die Potenziale und Herausforderungen eines digitalen Lernsystems zur beruflichen Weiterbildung im Gesundheitswesen.

Relevanzbewertung


Relevanz: 5Die Studie bietet wertvolle Einblicke in die Implementierung und Effektivität digitaler Bildungssysteme und liefert eine starke empirische Grundlage.


},
	file = {Hurley et al. - 2019 - Evaluation of an E-Learning Training Program to Su.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/5I633GKF/Hurley et al. - 2019 - Evaluation of an E-Learning Training Program to Su.pdf:application/pdf},
}

@article{feldman-maggor_perspectives_2024,
	title = {Perspectives of {Generative} {AI} in {Chemistry} {Education} {Within} the {TPACK} {Framework}},
	issn = {1059-0145, 1573-1839},
	url = {https://link.springer.com/10.1007/s10956-024-10147-3},
	doi = {10.1007/s10956-024-10147-3},
	abstract = {Artificial intelligence (AI) has made remarkable strides in recent years, finding applications in various fields, including chemistry research and industry. Its integration into chemistry education has gained attention more recently, particularly with the advent of generative AI (GAI) tools. However, there is a need to understand how teachers’ knowledge can impact their ability to integrate these tools into their practice. This position paper emphasizes two central points. First, teachers technological pedagogical content knowledge (TPACK) is essential for more accurate and responsible use of GAI. Second, prompt engineering—the practice of delivering instructions to GAI tools—requires knowledge that falls partially under the technological dimension of TPACK but also includes AI-related competencies that do not fit into any aspect of the framework, for example, the awareness of GAI-related issues such as bias, discrimination, and hallucinations. These points are demonstrated using ChatGPT on three examples drawn from chemistry education. This position paper extends the discussion about the types of knowledge teachers need to apply GAI effectively, highlights the need to further develop theoretical frameworks for teachers’ knowledge in the age of GAI, and, to address that, suggests ways to extend existing frameworks such as TPACK with AI-related dimensions.},
	language = {en},
	urldate = {2025-01-01},
	journal = {Journal of Science Education and Technology},
	author = {Feldman-Maggor, Yael and Blonder, Ron and Alexandron, Giora},
	month = aug,
	year = {2024},
	keywords = {Promotion:Literaturverzeichnis},
	file = {Feldman-Maggor et al. - 2024 - Perspectives of Generative AI in Chemistry Education Within the TPACK Framework:/Users/jochenhanisch-johannsen/Zotero/storage/HF9EZUIP/Feldman-Maggor et al. - 2024 - Perspectives of Generative AI in Chemistry Education Within the TPACK Framework.pdf:application/pdf},
}

@misc{low_data_2023,
	title = {Data {Dialogue} with {ChatGPT}: {Using} {Code} {Interpreter} to {Simulate} and {Analyse} {Experimental} {Data}},
	shorttitle = {Data {Dialogue} with {ChatGPT}},
	url = {http://arxiv.org/abs/2311.12415},
	abstract = {Artificial Intelligence (AI) has the potential to fundamentally change the educational landscape. So far, much of the physics education research relating to AI has focused on lecture-based assessment and the ability of ChatGPT to answer conceptual surveys and traditional exam-style questions. In this study, we shift the focus by investigating ChatGPT's ability to complete an introductory mechanics laboratory activity by using Code Interpreter, a recent plugin that allows users to generate and analyse data by writing and running Python code `behind the scenes'. By uploading a common `spring constant' lab activity using Code Interpreter, we investigate the ability of ChatGPT to interpret the activity, generate realistic model data, produce a line-fit, and calculate the reduced chi square statistic. By analysing our interactions with ChatGPT, along with the Python code generated by Code Interpreter, we assess how the quality and accuracy of ChatGPT's responses depends on different levels of prompt detail. We find that although ChatGPT is capable of completing the lab activity and generating plausible-looking data, the quality of the output is highly dependent on the detail and specificity of the text prompts provided. We find that the data generation process adopted by ChatGPT in this study leads to heteroscedasticity in the simulated data, which may be difficult for novice learners to spot. We also find that when real experimental data is uploaded via Code Interpreter, ChatGPT is capable of correctly plotting and fitting the data, calculating the spring constant and associated uncertainty, and calculating the reduced chi square statistic. This work offers new insights into the capabilities of Code Interpreter within a laboratory setting and highlights a variety of text-prompt strategies for the effective use of Code Interpreter in a lab context.},
	language = {en},
	urldate = {2024-08-21},
	publisher = {arXiv},
	author = {Low, Andrew and Kalender, Z. Yasemin},
	month = dec,
	year = {2023},
	note = {arXiv:2311.12415 [physics]},
	keywords = {GPT, Physics - Physics Education, Promotion:Literaturverzeichnis, Promotion:sec:P-QIA, Promotion:sec:A-15, Promotion:sec:Methodenkritik-Absicherung, Promotion:chap:04-04},
	annote = {Analyse des Artikels „Data Dialogue with ChatGPT: Using Code Interpreter to Simulate and Analyse Experimental Data“ von Andrew Low und Z. Yasemin Kalender
1. Hauptthemen und Bezug zur systematischen Literaturanalyse
Der Artikel untersucht die Nutzung des Code Interpreters von ChatGPT für die Durchführung und Analyse eines physikalischen Laborversuchs zur Federkonstantenbestimmung. Ziel ist es, die Fähigkeit des Tools zu bewerten, experimentelle Daten zu simulieren, zu analysieren und zu interpretieren. Für die systematische Literaturanalyse bietet der Artikel wertvolle Ansätze zur Nutzung von GPT-gestützten Tools zur Datenverarbeitung, insbesondere durch die iterative Verbesserung von Prompts und die Visualisierung komplexer Daten.
2. Methodische Ansätze und Datenquellen


Methodik: Drei Ansätze wurden getestet:


Einfache Prompts zur Datenanalyse.


Detaillierte Prompts mit expliziten Anweisungen zu Datenvisualisierung und Unsicherheiten.


Analyse realer experimenteller Daten.




Datenquellen: Simulierte Daten und reale experimentelle Daten aus einem Federexperiment, das typischerweise in einem Erstsemester-Physiklabor durchgeführt wird.


3. Argumente für die Verwendung von GPT und Code Interpreter in der Datenanalyse (Pro)


Datenvisualisierung: Der Code Interpreter kann Daten zuverlässig visualisieren, inklusive Fehlerbalken und statistischer Auswertungen.


Fehlerfortpflanzung: Das Tool berücksichtigt Unsicherheiten und propagiert diese korrekt, wenn detaillierte Prompts bereitgestellt werden.


Iterative Verbesserungen: Durch präzisere Prompts konnte die Qualität der Analyse signifikant gesteigert werden.


Integration realer Daten: Der Code Interpreter verarbeitete reale experimentelle Daten korrekt und führte eine orthogonale Distanzregression (ODR) durch.


4. Argumente gegen die Verwendung von GPT und Code Interpreter in der Datenanalyse (Contra)


Abhängigkeit von Prompts: Die Qualität der Ergebnisse hängt stark von der Genauigkeit und Detailtiefe der Prompts ab.


Fehleranfälligkeit: In einigen Fällen wurden falsche Unsicherheiten berechnet, z. B. konstante Fehler für alle Messwerte unabhängig von deren Größe.


Heteroskedastizität: Die von GPT generierten Daten wiesen unrealistische Varianzen auf, was in der Praxis zu Fehlinterpretationen führen könnte.


Inkonsistenz: Identische Prompts führten in mehreren Sitzungen zu unterschiedlichen Ergebnissen.


5. Ethische und methodische Überlegungen


Ethische Aspekte: Transparenz und die Förderung von kritischem Denken bei Studierenden sind essenziell, um die Ergebnisse der KI richtig zu interpretieren.


Methodische Empfehlungen: Die Kombination aus KI-gestützten Tools und menschlicher Expertise wird empfohlen, um sicherzustellen, dass Fehler erkannt und behoben werden.


6. Relevanz für das Forschungsvorhaben und Forschungslücken
Die Ergebnisse zeigen, wie GPT-basierte Tools die systematische Literaturanalyse durch Datenverarbeitung und Visualisierung bereichern können. Forschungslücken bestehen in der Untersuchung von Langzeiteffekten der KI-Nutzung in der Ausbildung und in der Entwicklung standardisierter Prompts zur Optimierung der Ergebnisse.
Zusammenfassung
Der Artikel demonstriert die Fähigkeit von ChatGPTs Code Interpreter, physikalische Laboraktivitäten zu simulieren und zu analysieren, betont jedoch die Abhängigkeit von detaillierten und präzisen Prompts. Die beschriebenen Ansätze und Herausforderungen sind direkt auf die systematische Literaturanalyse übertragbar, insbesondere bei der iterativen Datenanalyse und -interpretation. Der Einsatz solcher Tools erfordert jedoch eine kritische Überprüfung durch erfahrene Benutzer, um Fehler und Inkonsistenzen zu vermeiden.
},
	annote = {Comment: 17 pages, 7 figures},
	file = {Low und Kalender - 2023 - Data Dialogue with ChatGPT Using Code Interpreter.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/RB5TM8L3/Low und Kalender - 2023 - Data Dialogue with ChatGPT Using Code Interpreter.pdf:application/pdf},
}

@article{bhullar_chatgpt_2024,
	title = {{ChatGPT} in higher education - a synthesis of the literature and a future research agenda},
	issn = {1360-2357, 1573-7608},
	url = {https://link.springer.com/10.1007/s10639-024-12723-x},
	doi = {10.1007/s10639-024-12723-x},
	abstract = {ChatGPT has emerged as a significant subject of research and exploration, casting a critical spotlight on teaching and learning practices in the higher education domain. This study examines the most influential articles, leading journals, and productive countries concerning citations and publications related to ChatGPT in higher education, while also shedding light on emerging thematic and geographic clusters within research on ChatGPT’s role and challenges in teaching and learning at higher education institutions. Forty-seven research papers from the Scopus database were shortlisted for bibliometric analysis. The findings indicate that the use of ChatGPT in higher education, particularly issues of academic integrity and research, has been studied extensively by scholars in the United States, who have produced the largest volume of publications, alongside the highest number of citations. This study uncovers four distinct thematic clusters (academic integrity, learning environment, student engagement, and scholarly research) and highlights the predominant areas of focus in research related to ChatGPT in higher education, including student examinations, academic integrity, student learning, and field-specific research, through a country-based bibliographic analysis. Plagiarism is a significant concern in the use of ChatGPT, which may reduce students’ ability to produce imaginative, inventive, and original material. This study offers valuable insights into the current state of ChatGPT in higher education literature, providing essential guidance for scholars, researchers, and policymakers.},
	language = {en},
	urldate = {2024-05-09},
	journal = {Education and Information Technologies},
	author = {Bhullar, Pritpal Singh and Joshi, Mahesh and Chugh, Ritesh},
	month = may,
	year = {2024},
	note = {@bhullar\_chatgpt\_2024},
	keywords = {GPT, Promotion:Literaturverzeichnis, Promotion:chap:04-04},
	annote = {Analyse des Artikels „ChatGPT in higher education – a synthesis of the literature and a future research agenda“ von Bhullar et al.
1. Hauptthemen und Bezug zur systematischen Literaturanalyse


Hauptthema: Der Artikel bietet eine umfassende Übersicht über die Forschung zu ChatGPT im Hochschulbereich. Er identifiziert Schlüsselthemen, Herausforderungen und Potenziale von ChatGPT in der Bildung durch bibliometrische Analysen und Literaturübersicht.


Bezug zur Literaturanalyse: Die Untersuchung thematischer Cluster (z. B. akademische Integrität, Lernumgebungen, studentisches Engagement und Forschung) zeigt, wie ChatGPT für Datenaggregation, thematische Kategorisierung und Literaturübersicht genutzt werden kann.


2. Methodische Ansätze und Datenquellen


Methodik:


Systematische Literaturrecherche mit Scopus-Datenbank.


Verwendung von VOSviewer zur Analyse von Bibliometrie und thematischen Clustern.


Einhaltung der PRISMA-Richtlinien für Systematik und Transparenz.




Datenquellen: Analyse von 47 wissenschaftlichen Artikeln, die bis Mai 2023 veröffentlicht wurden, wobei qualitativ (31) und quantitativ (11) orientierte Studien sowie 4 Literaturübersichten einbezogen wurden.


3. Argumente für die Verwendung von GPT in der Literaturanalyse (Pro)


Effizienz: ChatGPT kann große Mengen wissenschaftlicher Artikel zusammenfassen und systematisch kategorisieren.


Personalisierung: Es bietet individuelle Unterstützung bei der Themenstrukturierung und Datenaggregation.


Innovative Anwendungen: Unterstützt die Erstellung von Literaturübersichten und Hypothesen durch thematische Cluster und Bibliometrie.


Beispiele: Der Artikel hebt hervor, wie ChatGPT zur Überprüfung von Hausaufgaben und zur Optimierung von Essays genutzt werden kann.


4. Argumente gegen die Verwendung von GPT in der Literaturanalyse (Contra)


Fehlende Genauigkeit: GPT kann falsche oder unvollständige Ergebnisse liefern, insbesondere bei spezialisierten Themen.


Plagiatsrisiken: ChatGPT erleichtert akademische Täuschungen durch die Generierung schwer nachweisbarer Inhalte.


Bias und Datenbeschränkungen: Modelle basieren auf voreingenommenen Daten und sind nicht für alle Themenbereiche umfassend geeignet.


Beispiele: Fehlinterpretationen und inkonsistente Ergebnisse wurden bei der Beurteilung von Prüfungsantworten festgestellt.


5. Ethische und methodische Überlegungen


Ethische Aspekte: Transparenz und klare Richtlinien für die Nutzung von ChatGPT sind essenziell, insbesondere bei der Angabe von Quellen und der Kennzeichnung von KI-generierten Inhalten.


Methodische Empfehlungen: Einführung von KI-Kompetenztrainings und Integration von „AI-Literacy“ in Curricula.


6. Relevanz für das Forschungsvorhaben und Forschungslücken


Diskussionsbeitrag: Der Artikel zeigt, wie GPT-basierte Technologien systematisch in die Forschung und Lehre integriert werden können, hebt jedoch die Bedeutung menschlicher Kontrolle hervor.


Forschungslücken:


Entwicklung von „ChatGPT-proof“-Bewertungskriterien.


Langzeitstudien zu den Auswirkungen von GPT auf Kreativität und Lernprozesse.


Forschung zur Integration in Disziplinen jenseits von Medizin und Tourismus.




Zusammenfassung
Der Artikel beleuchtet die Potenziale von ChatGPT, das in der Hochschulbildung als Werkzeug zur Effizienzsteigerung und Personalisierung eingesetzt wird. Gleichzeitig unterstreicht er ethische Herausforderungen und methodische Limitationen. Für die systematische Literaturanalyse ist der Artikel besonders relevant, da er methodische Ansätze wie die Nutzung bibliometrischer Werkzeuge und thematische Clusterung beschreibt, die direkt auf die Literaturanalyse übertragbar sind. Die Erkenntnisse legen nahe, dass eine reflektierte Integration von ChatGPT das Forschungspotenzial erweitern, aber menschliche Expertise nicht ersetzen sollte.
},
	file = {Bhullar et al. - 2024 - ChatGPT in higher education - a synthesis of the l.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/BFXTUYV7/Bhullar et al. - 2024 - ChatGPT in higher education - a synthesis of the l.pdf:application/pdf},
}

@article{hackbart_field_2024,
	title = {A {Field} {Study} on {Students}’ {Competence} {Expectations} of {Lecturers}},
	abstract = {The Pygmalion effect, which is the influence of teachers’ competence expectations of learners, has been widely studied, but not learners’ competence expectations of teachers. High learner expectations of teachers’ competence seem to have a positive effect on learners themselves, e.g., on motivation and performance. Little is known about the effects of learners’ expectation on teachers’ experience and behavior. In this field study, the relationship between university students’ initial competence expectations of lecturers on their experience during and evaluation of a course session was explored for both students (N = 871 responses; multiple participations possible) and lecturers (N = 41). Multilevel analyses (controlling for students’ initial warmth and attractiveness perceptions of lecturers) showed that students’ competence expectations of their lecturers were positively related to their motivation (interest and boredom) and negatively related to their perceptions of disruptions. The relationship between students’ competence expectations and lecturers’ experience was more unsystematic: positive correlations were found with the rating of the lecturers’ own positive emotions and their feelings of competence, and a negative correlation was found with their disruption mismanagement. In summary, students’ expectations of lecturers seem to be relevant in a teaching-learning context, even though mostly small effect sizes could be shown.},
	language = {en-GB},
	author = {Hackbart, Marcel and Thies, Barbara},
	month = jul,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Bildungstheorien, Promotion:Argumentation, Promotion:Relevanz:4, \#1:Zeitschriftenartikel:learning:management:system, Promotion:FU2b, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {22},
	annote = {Hier ist die strukturierte Analyse und Zusammenfassung des Artikels „Students as Pygmalions: A Field Study on Students’ Competence Expectations of Lecturers“ von Hackbart \& Thies (2024):

Analyse
1. Hauptthemen und Ziele der Forschung


Hauptthemen:


Untersuchung des Einflusses von Kompetenzerwartungen der Studierenden gegenüber Lehrpersonen auf deren eigene Motivation, Emotionen und Verhalten sowie auf die Interaktionen im Lehr-Lern-Kontext.


Theoretische Einbettung in den Pygmalion-Effekt und das transaktionale Modell der Lehrenden-Lernenden-Interaktion.




Ziele:


Analyse der Beziehung zwischen den Kompetenzerwartungen der Studierenden und deren Wahrnehmungen sowie Erfahrungen während der Lehrveranstaltungen.


Untersuchung, wie diese Erwartungen die Lehrpersonen selbst beeinflussen.




2. Methoden und Datenquellen


Methoden:


Feldstudie mit 42 universitären Kursen.


Datenerhebung mittels Fragebögen, die vor und nach der Lehrveranstaltung ausgefüllt wurden.


Multilevel-Analysen und Hierarchische Regression zur Analyse der Beziehungen.




Datenquellen:


871 Datensätze von Studierenden und 41 Dozierenden.


Fragebögen basierend auf etablierten Skalen für Kompetenz, Wärme, Emotionen und Wahrnehmung von Störungen.




3. Zentrale Forschungsergebnisse


Studierende:


Hohe Kompetenzerwartungen korrelieren positiv mit Interesse und geringerem wahrgenommenen Störverhalten.


Die wahrgenommene Wärme der Lehrperson beeinflusst emotionale Faktoren wie Freude und Frustration stärker.




Lehrende:


Kompetenzerwartungen der Studierenden korrelieren positiv mit der Selbsteinschätzung der eigenen Kompetenz und positiven Emotionen.


Negativer Zusammenhang mit der Wahrnehmung von Störungsmanagement.




Effektgrößen: Meist klein bis moderat, stärker auf Gruppenebene.



Zusammenfassung
Die Studie untersucht, wie die Kompetenzerwartungen von Studierenden Lehr-Lern-Interaktionen beeinflussen. Hohe Erwartungen an die Kompetenz der Lehrenden wirken sich positiv auf das Engagement und die Motivation der Studierenden aus. Für die Lehrenden resultieren solche Erwartungen in einer verbesserten Selbsteinschätzung ihrer Kompetenz und positiven Emotionen. Die Ergebnisse stützen theoretische Modelle wie das transaktionale Modell von Nickel (1985), weisen jedoch auf begrenzte Effektgrößen und eine inkonsistente Wirkung hin.

Kernaussagen


Positive Erwartungen fördern Motivation: Hohe Kompetenzerwartungen der Studierenden erhöhen Interesse und vermindern wahrgenommene Störungen (S. 12).


Einfluss auf Lehrende: Erwartungen der Studierenden stärken positive Emotionen und die wahrgenommene Kompetenz der Lehrenden (S. 14).


Theoretische Bedeutung: Die Ergebnisse stützen den Pygmalion-Effekt und unterstreichen die Bedeutung von transaktionalen Modellen in Lehr-Lern-Kontexten (S. 15).



Argumentationslinien


Hauptthese: Kompetenzerwartungen der Studierenden haben selbst-erfüllende Effekte, die Motivation und Interaktion im Lehr-Lern-Kontext beeinflussen.


Unterstützende Evidenz: Ergebnisse zeigen signifikante Zusammenhänge zwischen den Erwartungen der Studierenden und ihrer Wahrnehmung der Lehrveranstaltung sowie der Selbsteinschätzung der Lehrenden (S. 13-14).


Implikationen: Die Bedeutung von Erwartungen sollte in der Hochschuldidaktik stärker berücksichtigt werden, insbesondere bei der Gestaltung von Lehrangeboten (S. 16).



Verschlagwortung


Lehr- und Lerneffektivität: Der Einfluss von Erwartungen auf Motivation und Wahrnehmung wird analysiert.


Bildungstheorien: Untersuchung des Pygmalion-Effekts und des transaktionalen Modells.


Forschungsansätze: Feldstudie mit multilevel-analytischem Ansatz zur Validierung theoretischer Annahmen.



Kategorisierung
Kategorie: ArgumentationBegründung: Der Artikel zeigt, wie Kompetenzerwartungen der Studierenden sich auf verschiedene Ebenen von Interaktion und Wahrnehmung auswirken und stützt dies durch Datenanalysen.

Zuordnung zu Forschungsfragen


Passendste Forschungsfrage: FU2b: Welche Effekt-Faktoren erläutern Lehrende im digitalen Bildungsraum von Gesundheitsberufen bei der Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems?


Begründung: Die Studie untersucht die Wahrnehmung und Erfahrung von Lehrenden und deren Zusammenhang mit externen Erwartungen.



Relevanzbewertung


Aktualität: 5 (2024, sehr aktuell).


Direkte Relevanz: 4 (Liefert wertvolle Einblicke, jedoch in begrenztem Hochschulkontext).


Gesamtbewertung: 4 (Hoch relevant, insbesondere für Theorien und Lehrgestaltung).


},
	file = {Hackbart und Thies - A Field Study on Students’ Competence Expectations of Lecturers:/Users/jochenhanisch-johannsen/Zotero/storage/IA2UA2YF/Hackbart und Thies - A Field Study on Students’ Competence Expectations of Lecturers.pdf:application/pdf},
}

@article{hava_exploring_2024,
	title = {Exploring the relationship between teachers’ competencies in {AI}-{TPACK} and digital proficiency},
	issn = {1360-2357, 1573-7608},
	url = {https://link.springer.com/10.1007/s10639-024-12939-x},
	doi = {10.1007/s10639-024-12939-x},
	abstract = {In recent years, there has been a growing emphasis on integrating Artificial Intelligence (AI) applications in educational settings. As a result, it is essential to assess teachers’ competencies in Technological, Pedagogical, and Content Knowledge (TPACK) as it pertains to AI and examine the factors that influence these competencies. This study aims to analyze the impact of digital proficiency on teachers’ AI-TPACK competencies. The study utilized a correlational survey model and involved 401 teachers from various provinces and departments in Turkey. The data collection tools included a personal information form, an AI-TPACK scale, and a digital proficiency scale. The collected data were analyzed using structural equation modeling. The research findings revealed that teachers’ AI-TPACK competencies were below average, whereas their levels of digital proficiency were above average. Furthermore, a significant relationship between teachers’ AI-TPACK and digital proficiency levels was identified, with digital proficiency as a significant predictor of AI-TPACK competencies. Based on the research findings, recommendations for future studies are provided.},
	language = {en},
	urldate = {2024-11-14},
	journal = {Education and Information Technologies},
	author = {Hava, Kevser and Babayiğit, Özgür},
	month = aug,
	year = {2024},
	keywords = {Promotion:Literaturverzeichnis},
	file = {Hava und Babayiğit - 2024 - Exploring the relationship between teachers’ competencies in AI-TPACK and digital proficiency:/Users/jochenhanisch-johannsen/Zotero/storage/XH97A6ZX/Hava und Babayiğit - 2024 - Exploring the relationship between teachers’ competencies in AI-TPACK and digital proficiency.pdf:application/pdf},
}

