@inproceedings{hurtado_sharing_2025,
	title = {Sharing {About} {Risks} on {Social} {Media}: {Learning} {Environments} to {Address} {Social} {Media}},
	abstract = {Youth navigate social media risks daily, yet their strategies to address them are often underrepresented. This study explores how youth identify and address these risks within learning environments. Three workshops were conducted with 32 8th-grade participants in Germany. Findings indicate that sharing facilitated risk identification and addressing. Creating learning environments that encourage sharing experiences can leverage youth cultural practices for online safety and could empower youth to enhance their social media experiences.},
	language = {en},
	author = {Hurtado, Santiago and Keune, Anna},
	year = {2025},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:FU4a, Promotion:Kerngedanke, Systemanpassung, Bildungstheorien, Promotion:Relevanz:4, \#b:Konferenz-Paper:online:learning, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	annote = {Analyse der Studie: „Sharing About Risks on Social Media: Learning Environments to Address Social Media“ von Hurtado \& Keune (2025)

1. Hauptthemen und Ziele der Forschung
Ziel der Studie ist die Gestaltung von Lernumgebungen, in denen Jugendliche (13–14 Jahre alt) ihre Erfahrungen mit Risiken in sozialen Medien teilen und gemeinsam Bewältigungsstrategien entwickeln können. Im Zentrum steht die Frage, wie solche Lernräume gestaltet sein müssen, um Peer-basierte Reflexionen über digitale Risiken zu ermöglichen und die sozialen Praktiken der Jugendlichen pädagogisch nutzbar zu machen.

2. Methoden und Datenquellen
Methodik:


Forschungsdesign: Qualitativ, in Form partizipativer Workshops.


Teilnehmende: 32 Schüler*innen der 8. Jahrgangsstufe in Süddeutschland.


Ablauf: Drei aufeinanderfolgende Workshops à 55 Minuten.


1. Sitzung: Erstellung von „tangible maps“ zur Visualisierung eigener Social-Media-Nutzung.


2. Sitzung (Fokus der Analyse): Identifikation und Visualisierung von Risiken, inklusive Strategien zur Bewältigung.


3. Sitzung: Design eigener Features zur Risikovermeidung.




Datenerhebung:


6,4 Stunden Videomaterial aus Gruppenphasen


68 Minuten Videomaterial aus Interventionen


65 Fotos der erstellten Artefakte (tangible maps)


Auswertung: Thematische Analyse (nach Morgan \& Nica, 2020) sowie Artefaktanalyse (Trăușan-Matu \& Slotta, 2021).

3. Zentrale Forschungsergebnisse


Die Schüler*innen diskutierten in kleinen Gruppen offen über bisher wenig artikulierte Social-Media-Erfahrungen.


Häufig benanntes Risiko: Kontaktaufnahme durch Fremde, z. B. durch Scam-Nachrichten („Hi mom, I lost my phone…“) auf WhatsApp oder Instagram.


Die „tangible maps“ visualisierten nicht nur Risiken, sondern auch deren Ursachen, Folgen und Handlungsstrategien.


Geteilte Strategien: „Vertrauensperson informieren“, „Eltern benachrichtigen“.


Die Schüler*innen erkannten explizit die Herausforderungen beim Ansprechen von Risiken gegenüber Erwachsenen, insbesondere aufgrund von Scham oder fehlendem Verständnis.



4. Zusammenfassung
Die qualitative Studie von Hurtado \& Keune (2025) zeigt, wie durch partizipative Workshopformate Lernumgebungen geschaffen werden können, die Jugendlichen ermöglichen, über soziale Medien und damit verbundene Risiken zu reflektieren. Durch die Herstellung physischer Visualisierungen („tangible maps“) konnten persönliche Erfahrungen, Risiken und Handlungsmöglichkeiten strukturiert dargestellt werden. Die Studie hebt hervor, wie wichtig es ist, Peer-basierte Reflexionsräume zu schaffen, in denen Jugendliche ihre digitalen Praktiken legitimieren und durch kollektives Lernen ihre Online-Sicherheit verbessern können.

5. Kernaussagen


Peer-Sharing als Bildungsmechanismus: Jugendliche artikulierten erstmals strukturiert ihre Erfahrungen mit sozialen Medien (S. 2934).


Visualisierung unterstützt Risikobewusstsein: Die „tangible maps“ erleichterten das Erkennen, Benennen und Strukturieren von Gefahren und Reaktionsstrategien (S. 2934).


Kontaktaufnahme durch Fremde ist zentrales Risiko: Typische Inhalte sind Scam-SMS oder Instagram-Nachrichten (S. 2934).


Erkennen von Lücken in der Kommunikation mit Erwachsenen: Jugendliche sehen es als problematisch an, Erwachsene über Risiken zu informieren, was Lernumgebungen besonders relevant macht (S. 2934).



6. Argumentationslinien
Die Autor*innen entwickeln ihre Argumentation entlang eines constructionistischen Lernmodells (Papert, 1993), das Lernen als aktiven, bedeutungsvollen Gestaltungsprozess auffasst. Daraus folgt:


Jugendliche sind keine passiven Nutzenden, sondern Akteur*innen mit eigenen digitalen Praktiken.


Wenn Lernumgebungen Peer-Kommunikation fördern, wird ein reflexiver, sicherheitsbewusster Umgang mit sozialen Medien möglich.


Artefaktbasierte Methoden (z. B. „tangible maps“) fördern das Externalisieren und Kommunizieren von implizitem Wissen über soziale Medien.



7. Verschlagwortung


Lehr- und Lerneffektivität: Die Studie zeigt, wie artefaktbasierte Gruppenarbeit zu tieferem Verständnis und sicherheitsbewussterem Verhalten führt.


Bildungstheorien: Der Ansatz ist explizit constructionistisch (Papert, Holbert et al.) und nutzt informelles Lernen in formalen Räumen.


Kollaboratives Lernen: Die Interaktion in Kleingruppen war essenziell für die Risikoreflexion.


Systemanpassung: Die Forschung zeigt exemplarisch, wie Lernumgebungen adaptiv auf kulturelle Praktiken von Jugendlichen reagieren können.


Forschungsansätze: Methodisch innovativ durch Kombination aus ethnografischen Walkthroughs, thematischer Analyse und Artefaktanalyse.



8. Kategorisierung
Kategorie: Kerngedanke
Begründung: Der zentrale Beitrag des Artikels besteht in der konzeptuellen Herleitung und empirischen Fundierung eines auf Konstruktion und Peer-Austausch basierenden Lernmodells zur Reflexion über Risiken sozialer Medien. Der Beitrag liegt vorrangig in der konzeptuellen Grundlegung und nicht primär in der Evaluation bestehender Systeme.

9. Zuordnung zu Forschungsfrage
Passendste Unterfrage: FU4a – Bildungswissenschaftliche Mechanismen
Begründung: Der Beitrag beleuchtet Bildungsmechanismen wie peer-basiertes Lernen, Artefaktproduktion und Erfahrungsreflexion zur Risikoerkennung. Diese Mechanismen sind zentral für das Verstehen von Wirkgefügen im digitalen Bildungsraum.

10. Relevanzbewertung
Gesamtbewertung: 4 – Relevant
Begründung:


Der Text bietet wesentliche Erkenntnisse für die Gestaltung systemisch-konstruktivistischer Bildungsräume.


Die Zielgruppe (Jugendliche im schulischen Kontext) ist relevant für generalisierbare Erkenntnisse, auch wenn der direkte Bezug zu Gesundheitsberufen nicht besteht.


Methodisch und konzeptionell innovativ mit Anschlussfähigkeit an bestehende LMS-Strukturen.


},
	file = {Hurtado und Keune - Sharing About Risks on Social Media Learning Environments to Address Social Media:/Users/jochenhanisch-johannsen/Zotero/storage/ZNK3GPWB/Hurtado und Keune - Sharing About Risks on Social Media Learning Environments to Address Social Media.pdf:application/pdf},
}

@article{tzankova_emergency_2023,
	title = {Emergency online school learning during {COVID}-19 lockdown: {A} qualitative study of adolescents’ experiences in {Italy}},
	volume = {42},
	copyright = {https://creativecommons.org/licenses/by/4.0},
	issn = {1046-1310, 1936-4733},
	shorttitle = {Emergency online school learning during {COVID}-19 lockdown},
	url = {https://link.springer.com/10.1007/s12144-021-02674-8},
	doi = {10.1007/s12144-021-02674-8},
	abstract = {The COVID-19 pandemic caused abrupt and profound changes to teaching and learning. The present study seeks to understand adolescents’ experiences of the emergency adoption of online school learning (OSL) during the first national lockdown in Italy. Sixty-four students in their final two years of high school were interviewed and content analysis was performed. The findings describe students’ views of the changes related to OSL according to structural, individual and relational dimensions. Schools’ lack of organization, overwhelming demands, as well as experience of difficulties in concentration, stress and inhibited relationships with teachers and classmates were among the challenges evidenced in the transition. OSL, however, has also made it possible to experience a new flexibility and autonomy in the organization of learning. The study stresses the importance of fostering adaptation of teacher-student relationships and collaborative learning in order to improve schools’ preparedness for digital transitions in and out of emergencies.},
	language = {en},
	number = {15},
	urldate = {2025-07-17},
	journal = {Current Psychology},
	publisher = {Springer Science and Business Media LLC},
	author = {Tzankova, Iana and Compare, Christian and Marzana, Daniela and Guarino, Antonella and Di Napoli, Immacolata and Rochira, Alessia and Calandri, Emanuela and Barbieri, Irene and Procentese, Fortuna and Gatti, Flora and Marta, Elena and Fedi, Angela and Aresi, Giovanni and Albanesi, Cinzia},
	month = may,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Technologieintegration, Promotion:Argumentation, Promotion:FU5, Krisenreaktion im Bildungsbereich, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {12743--12755},
	annote = {Analyse der Studie „Emergency online school learning during COVID-19 lockdown: A qualitative study of adolescents’ experiences in Italy“ von Tzankova et al. (2025)

1. Hauptthemen und Ziele der Forschung
Die qualitative Studie untersucht die Erfahrungen italienischer Jugendlicher mit dem abrupt eingeführten Online-Schulunterricht (Online School Learning, OSL) während des ersten COVID-19-Lockdowns. Im Zentrum steht die Frage, wie Schüler*innen diese Notmaßnahme wahrgenommen und erlebt haben, insbesondere in Bezug auf strukturelle, psychologische und zwischenmenschliche Veränderungen im Lern- und Schulkontext.

2. Methoden und Datenquellen


Forschungsdesign: Explorativ-qualitativ mit einem ökologischen Analyseansatz.


Datenerhebung: 64 halbstrukturierte Interviews mit Schüler*innen der letzten beiden Schuljahre (Alter: 16–19 Jahre) aus Nord- und Süditalien, durchgeführt zwischen Mai und Juni 2020.


Sampling: Snowball-Verfahren, diversifiziert nach Schulformen und sozialen Aktivitäten.


Datenauswertung: Qualitative Inhaltsanalyse (nach Hsieh \& Shannon, 2005), deduktiv-induktiv kodiert mithilfe von Atlas.ti.



3. Zentrale Forschungsergebnisse


Strukturell-organisatorisch: Fehlende Vorbereitung der Schulen, chaotische Organisation, Überforderung durch Arbeitslast; positive Erfahrungen mit asynchronem Lernen und flexiblen digitalen Formaten.


Psychologisch: Einige Schüler*innen gewannen an Selbstregulation und Autonomie; andere erlebten emotionale Belastungen, Isolation, Erschöpfung und „fatigue“ durch Dauerpräsenz vor Bildschirmen.


Interpersonal-sozial: Störungen in Klassengemeinschaften; verstärkte Individualisierung; Verlust an Peer-Interaktion, aber auch neue Wertschätzung für soziale Beziehungen und Unterstützung durch Lehrer*innen.



4. Zusammenfassung
Die Studie analysiert die Perspektiven italienischer Jugendlicher auf den Notfall-Fernunterricht während der COVID-19-Pandemie. Neben Herausforderungen in Organisation, Motivation und sozialen Beziehungen zeigen die Ergebnisse auch Chancen für Selbstorganisation und neue Formen der digitalen Partizipation. Die Autor*innen plädieren für eine bessere strukturelle, didaktische und soziale Vorbereitung auf zukünftige Bildungsnotlagen.

5. Kernaussagen


OSL offenbarte strukturelle Mängel: Schulen waren unvorbereitet und reagierten improvisiert auf die Krise (S. 9–10).


Autonomiegewinn als positive Folge: Lernende konnten individuelle Lernstrategien entwickeln (S. 7).


Soziale Isolation verstärkt Belastungen: Fehlende Peer-Interaktion führte zu emotionaler Erschöpfung und Motivationsproblemen (S. 8–9).


Beziehungsarbeit ist zentral: Lehrkräfte, die empathisch reagierten, wurden von Schüler*innen besonders geschätzt (S. 9).



6. Argumentationslinien
Die Argumentation folgt einer dreigliedrigen ökologischen Struktur:


Makroebene (strukturell): Fehlende staatliche und schulische Vorbereitung auf OSL führte zu organisatorischem Chaos.


Mesoebene (psychologisch): Individuelle Unterschiede bestimmten, ob OSL als entlastend oder belastend erlebt wurde.


Mikroebene (sozial): Soziale Beziehungen wurden unter OSL stark transformiert, wobei soziale Unterstützung als Resilienzfaktor diente (vgl. Fig. 1, S. 6).



7. Verschlagwortung




Schlagwort


Begründung




Krisenreaktion im Bildungsbereich


Die Studie analysiert eine unmittelbare Reaktion auf die COVID-19-Pandemie.




Lehr- und Lerneffektivität


Betrachtet wird, wie sich OSL auf Motivation, Konzentration und Ergebnisse auswirkt.




Technologieintegration


Digitale Tools wie WhatsApp, Zoom etc. werden hinsichtlich ihrer Wirksamkeit bewertet.




Kollaboratives Lernen


Peer-Interaktion wird als Lernfaktor thematisiert, auch im Sinne verlorener Kollaboration.




Forschungsansätze


Es wird eine qualitative Inhaltsanalyse mit ökologischer Rahmung angewendet.





8. Kategorisierung
Kategorie: ArgumentationBegründung: Die Studie argumentiert entlang dreier ökologischer Ebenen und bezieht sich dabei explizit auf theoretische Vorarbeiten und Literatur zu Technologieintegration, Selbstregulation und sozialem Lernen.

9. Zuordnung zur Forschungsunterfrage
Passende Forschungsunterfrage:FU5 – Welche Möglichkeiten und Grenzen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems durch Akteure im digitalen Bildungsraum von Gesundheitsberufen analysiert?
Begründung:Die Studie beleuchtet die Grenzen und Potenziale von digitalem Fernunterricht unter Notfallbedingungen aus Sicht der Lernenden. Dabei stehen Erfahrungen mit Lernorganisation, Motivation und digital-sozialer Interaktion im Mittelpunkt – Aspekte, die auch für die Anwendung systemisch-konstruktivistischer LMS zentral sind.

10. Relevanzbewertung


Direkte Relevanz für die FU: 5 – die Studie bietet zentrale Erkenntnisse zu Potenzialen und Grenzen digitaler Lernsysteme aus Perspektive der Lernenden.


Aktualität: 5 – sehr zeitnah zu Pandemie und ihren Implikationen für digitale Bildung veröffentlicht.


Methodische Tiefe: 4 – qualitativ fundierte Untersuchung mit breiter ökologischer Perspektive.


Gesamtbewertung: 5

11. Schlussfolgerung
Die Studie zeigt, dass OSL in Krisensituationen sowohl erhebliche strukturelle Schwächen als auch individuelle Lernchancen offenbaren kann. Für zukünftige digitale Bildung – insbesondere im Kontext von Gesundheitsberufen – sind adaptive, relationale und unterstützende Systeme notwendig, die sowohl technische als auch soziale Aspekte berücksichtigen.
},
	file = {Tzankova et al. - 2023 - Emergency online school learning during COVID-19 lockdown A qualitative study of adolescents’ exper:/Users/jochenhanisch-johannsen/Zotero/storage/2FFMLK8D/Tzankova et al. - 2023 - Emergency online school learning during COVID-19 lockdown A qualitative study of adolescents’ exper.pdf:application/pdf},
}

@inproceedings{montaner-villalba_enhancing_2025,
	title = {Enhancing {Written} {Competence} in {English} for {Specific} {Purposes} {Using} {Google} {Docs}: {A} {Study} on {Design} {Engineering} {Students}},
	abstract = {This study aims to evaluate the perceptions of Design Engineering students at Valencian Polytechnic University (Spain) on using Google Docs as a collaborative tool to improve their written competence in English as a Foreign Language (EFL) and, in particular, in English for Specific Purposes (ESP). To determine whether these ESP students studying Design Engineering in the academic year 2020-2021 perceived well or not their ESP written competence, a qualitative approach was employed, where 14 fourth-year students participated in collaborative writing tasks using Google Docs. Data was collected through a questionnaire administered via Google Forms. The results indicate high levels of satisfaction, with students reporting improvements in collaboration, communication, and organizational skills. Overall, 64.3\% of these participating students believed that Google Docs contributed positively to their ESP writing development. The study concludes that online collaborative tools like Google Docs are effective in enhancing ESP written competence, suggesting the need for further research into their broader applications in language learning.},
	language = {en},
	author = {Montaner-Villalba, S},
	month = jul,
	year = {2025},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Bewertungsmethoden, Promotion:FU2a, Promotion:Relevanz:4, \#b:Konferenz-Paper:online:learning, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU2a},
	annote = {Analyse der Studie: "Enhancing Written Competence in English for Specific Purposes Using Google Docs: A Study on Design Engineering Students" von Montaner-Villalba (2025)

1. Hauptthemen und Ziele der Forschung
Die Studie untersucht, inwieweit das kollaborative Schreiben mit Google Docs die schriftsprachliche Kompetenz in „English for Specific Purposes“ (ESP) von Studierenden des Studiengangs Design Engineering an der Universitat Politècnica de València verbessert. Ziel ist es, die Wahrnehmung der Studierenden zur Nützlichkeit digitaler Tools für das Schreiben in einer technischen Fremdsprache zu erfassen und deren Auswirkungen auf fachbezogene Schreibfähigkeiten qualitativ zu bewerten.

2. Methoden und Datenquellen


Design: Qualitative Studie mit within-subjects-Design (alle Teilnehmenden durchliefen dieselben Bedingungen).


Stichprobe: 14 Studierende des vierten Studienjahres im Studiengang Design Engineering, mit mindestens B2-Level in Englisch (CEFR).


Datenerhebung: Online-Fragebogen (Google Forms), 20 Fragen (davon 9 analysiert), darunter Likert-Skalen, Multiple Choice und offene Fragen.


Ablauf: Die Studierenden erstellten gemeinsam Texte in Google Docs, die in Phasen organisiert waren: Brainstorming, Entwurf, Peer-Review, Endfassung.



3. Zentrale Forschungsergebnisse


Zufriedenheit: 64,3 \% der Studierenden äußerten hohe Zufriedenheit mit dem kollaborativen Schreiben.


Kompetenzwahrnehmung: 64,3 \% gaben an, dass die Nutzung von Google Docs ihre ESP-Schreibkompetenzverbesserte.


Zusätzliche Fähigkeiten: 28,6 \% nannten Verbesserungen in Organisations- und Kollaborationskompetenz, 21,4 \% in Recherchefähigkeiten.


Kommunikative Kompetenzen: 12 von 14 Studierenden empfanden eine Verbesserung ihrer Kommunikationsfähigkeit durch die Projektarbeit.



4. Zusammenfassung
Die Studie belegt, dass der Einsatz von Google Docs als kollaboratives Schreibtool das Schreiben in ESP effektiv unterstützen kann. Die Design Engineering-Studierenden erlebten Verbesserungen in sprachlicher Ausdrucksfähigkeit, Zusammenarbeit, Organisation und Kommunikation. Trotz kleiner Stichprobe zeigt die Untersuchung, dass digitale Tools wie Google Docs auch in technisch orientierten Fachsprachenkursen erfolgreich einsetzbar sind.

5. Kernaussagen (mit Seitenangabe)


„64.3\% of the participants agreed that creating online writing tasks helped them develop ESP writing skills“.


„Students reported improvements in collaboration, communication, and organizational skills“.


„The study concludes that online collaborative tools like Google Docs are effective in enhancing ESP written competence“.


„12 out of 14 students believed that this project helped improve communicative skills“.



6. Argumentationslinien


Die Autorin argumentiert, dass kollaborative Schreibprozesse durch digitale Tools wie Google Docs Peer-Interaktion fördern und damit ESP-Kompetenzen stärken.


Sie stützt sich auf Theorien des Collaborative Learning (z. B. Herrero-Pavo 2021; Stahl \& Hakkarainen 2021) zur Erklärung des Mehrwerts solcher Tools.


Es wird eine Verbindung zwischen Toolnutzung, Prozessorientierung des Schreibens und Fachspracherwerb im technischen Studienfeld hergestellt.



7. Verschlagwortung


Kollaboratives Lernen: Google Docs wurde gezielt eingesetzt, um kooperative Schreibprozesse zu fördern, inkl. Peer-Feedback und Gruppenarbeit.


Lehr- und Lerneffektivität: Die Studie erhebt explizit die wahrgenommene Effektivität der Schreibförderung durch das Tool.


Technologieintegration: Der gezielte Einsatz von Google Docs in der ESP-Lehre zeigt eine bewusste technologische Integration in den Fachunterricht.


Bewertungsmethoden: Die Studie nutzt strukturierte qualitative Fragebögen zur Bewertung der subjektiven Kompetenzentwicklung.


Forschungsansätze: Einsatz eines qualitativ-deskriptiven Designs zur Untersuchung von Nutzerwahrnehmungen in einem realistischen Lehrkontext.



8. Kategorisierung
Kerngedanke:Die zentrale Hypothese lautet, dass der kollaborative Einsatz von Google Docs die Schreibkompetenz in fachsprachlichem Englisch (ESP) durch Peer-Interaktion, Feedback und digitale Zusammenarbeit verbessert.

9. Zuordnung zu Forschungsunterfrage (FU)
Passendste FU:FU2a – Welchen Effekt erläutern Lernende im digitalen Bildungsraum von Gesundheitsberufen bei der Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems?
Begründung:Obwohl nicht im Gesundheitsbereich angesiedelt, liefert die Studie hochrelevante Daten zum Lernendenerleben und zu Effekten der digitalen, kollaborativen Anwendung eines Tools zur Schreibkompetenzförderung. Die Selbstwahrnehmungen der Studierenden stehen im Fokus.

10. Relevanzbewertung


Direkte Relevanz: 4 – Die Quelle liefert qualitativ hochwertige Aussagen zur Wirkung digitaler Tools auf Lernende im Kontext fachsprachlichen Lernens.


Zitierfähigkeit \& Forschungsstand: 3 – Konferenzbeitrag mit beschränkter Generalisierbarkeit, aber guter methodischer Fundierung.


Aktualität: 5 – EDULEARN25 Konferenz, also hochaktuell.


Gesamtbewertung: 4

11. Schlussfolgerung
Die Studie zeigt, dass Google Docs ein wirksames Tool zur Förderung der schriftlichen Kompetenz in ESP-Kontexten ist – auch in technisch orientierten Studiengängen. Die Kombination aus kollaborativen Methoden und digitalem Feedback kann Lernprozesse auf mehreren Ebenen stärken. Die Ergebnisse legen nahe, dass eine Integration solcher Werkzeuge in andere Bildungsfelder (inkl. Gesundheitsberufe) sinnvoll wäre, um dort ähnliche Lernwirkungen zu erzielen.
},
	file = {Montaner-Villalba - ENHANCING WRITTEN COMPETENCE IN ENGLISH FOR SPECIFIC PURPOSES USING GOOGLE DOCS A STUDY ON DESIGN E:/Users/jochenhanisch-johannsen/Zotero/storage/DSK5MBMT/Montaner-Villalba - ENHANCING WRITTEN COMPETENCE IN ENGLISH FOR SPECIFIC PURPOSES USING GOOGLE DOCS A STUDY ON DESIGN E.pdf:application/pdf},
}

@article{honjong_analyzing_2025,
	title = {Analyzing {Teaching} and {Learning} {Interactions} in {Online} and {Offline} {Modes} at {Tomakaka} {University}},
	volume = {4},
	abstract = {This study investigates the differences in teaching and learning interactions among university students in online and offline learning environments, focusing on students from the Faculty of Teacher Training and Education at Universitas Tomakaka, Indonesia. The study was motivated by the emerging need to evaluate how communication patterns and engagement are affected by instructional modalities in the post-pandemic context. Using a mixed-method approach, including questionnaires and semi-structured interviews with 50 randomly selected students, this research explores interactional dynamics and identifies existing gaps in current literature regarding rural-based blended learning practices. The results indicate that offline learning fosters stronger student–lecturer and peer–peer interaction due to richer nonverbal cues and immediacy of feedback, while online learning shows limited engagement, especially in rural settings. However, some students reported higher comfort and participation in digital settings due to reduced social pressure. The study concludes that a blended learning approach, supported by interactive tools and digital training, may optimize communication and inclusiveness. These findings have practical implications for improving instructional design, especially in under-resourced educational institutions, and highlight the importance of digital infrastructure and pedagogical capacity building in enhancing learning interaction.},
	language = {en},
	number = {2},
	journal = {Journal of Education Science},
	author = {Honjong, Gusnawati and Hasanah, Nurul and Taufan, Muhammad Ybnu and Ali, Syahban Mada},
	year = {2025},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:FU4a, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Systemanpassung, \#8:Zeitschriftenartikel:blended:learning, Promotion:S:08 Blended Learning, Promotion:Literaturverzeichnis},
	annote = {Analyse der Studie: „Analyzing Teaching and Learning Interactions in Online and Offline Modes at Tomakaka University“ von Honjong et al. (2025)

1. Hauptthemen und Ziele der Forschung
Die Studie analysiert die Unterschiede in den Lehr-Lern-Interaktionen zwischen Online- und Offline-Formaten bei Studierenden der Fakultät für Lehrer*innenbildung an der Universitas Tomakaka (Indonesien). Zentrale Ziele sind:


Untersuchung von Interaktionsqualität und -häufigkeit zwischen Studierenden und Lehrenden sowie unter Peers.


Identifikation von Kontextfaktoren wie technischer Infrastruktur oder digitaler Kompetenz in ländlichen Räumen.


Ableitung von Empfehlungen für die Gestaltung inklusiver Blended-Learning-Umgebungen.


Die Studie adressiert dabei bestehende Forschungslücken zur Interaktionsqualität in ländlichen Bildungssettings, insbesondere bei zukünftigen Lehrkräften.

2. Methoden und Datenquellen
Design: Mixed-Methods (konvergentes Paralleldesign)


Quantitativ: Online-Fragebogen (Google Forms) mit geschlossenen Fragen zu Interaktionshäufigkeit, Komfort und Effektivität (n = 50, Zufallsstichprobe aus 367 Studierenden).


Qualitativ: Halbstrukturierte Interviews mit 10 Studierenden und 3 Lehrenden zur Vertiefung emotionaler, technischer und strategischer Aspekte.


Auswertung: Deskriptive Statistik für quantitative Daten; thematische Analyse nach Clarke \& Braun (2017) für qualitative Daten.



3. Zentrale Forschungsergebnisse


Offline-Modus: 86 \% der Studierenden berichteten über qualitativ hochwertige Interaktionen mit Lehrenden, 78 \% über effektive Peer-Kommunikation. Begründet durch nonverbale Signale, unmittelbares Feedback und soziale Präsenz.


Online-Modus: Nur 54 \% (Dozent*inneninteraktion) bzw. 46 \% (Peer-Kommunikation) bewerteten die Online-Interaktion als effektiv. Passive Beteiligung, fehlende Spontaneität und technische Einschränkungen wirkten hemmend.


Blended Learning: 32 \% der Befragten bevorzugten gemischte Formate. Digitale Tools wie Quizizz, Zoom-Breakout-Räume oder Google Docs unterstützten besonders schüchterne Studierende.


Inklusive Effekte: Introvertierte Personen empfanden Online-Settings mit asynchronen oder anonymen Formaten als sozial entlastend und beteiligten sich stärker.



4. Zusammenfassung
Die Studie zeigt, dass Offline-Lernen bessere Interaktionen zwischen Lehrenden und Lernenden sowie unter den Peers ermöglicht, jedoch auch Online-Formate ihre Stärken entfalten, insbesondere für zurückhaltende Studierende. Eine hybride Lernarchitektur mit geeigneter technischer und didaktischer Gestaltung wird als vielversprechend identifiziert. Die Ergebnisse betonen die Bedeutung von sozialer Präsenz, digitaler Infrastruktur und adaptiven Strategien im Blended Learning.

5. Kernaussagen (mit Seitenangaben)


„Offline learning facilitates more effective and comfortable communication between students and lecturers than online platforms“ (S. 718).


„The data indicates that in-person environments naturally support peer engagement“ (S. 718).


„Students with higher communication anxiety felt more comfortable in online learning environments“ (S. 722).


„Blended learning […] may optimize communication and inclusiveness“ (S. 715).


„Offline peer feedback enables richer, multi-dimensional communication […] especially in EFL contexts“ (S. 720).



6. Argumentationslinien


Die Argumentation folgt der Struktur: Vergleich der Modi → Erklärung durch Theorie → Kontextualisierung im indonesischen Raum → praktische Implikationen.


Offline-Lernen wird über Social Presence Theory (Gunawardena, 1991; Tu \& McIsaac, 2002) als überlegen im Aufbau emotionaler Nähe erklärt.


Online-Lernen wird als inklusivitätsfördernd für bestimmte Lerntypen unter Rückgriff auf konstruktivistische Lerntheorie (Bognar et al., 2015) bewertet.


Die Integration von digitalen Tools in Blended-Learning-Designs kann laut CSCL-Theorie (Stahl, 2016) Interaktionsdefizite kompensieren.



7. Verschlagwortung


Kollaboratives Lernen: Zentrale Gegenüberstellung von Peer–Peer-Interaktion in verschiedenen Modi mit Bezug auf CSCL und soziale Präsenz.


Lehr- und Lerneffektivität: Empirische Ergebnisse zu Interaktionsqualität und deren Auswirkungen auf Engagement und Beteiligung.


Technologieintegration: Einsatz digitaler Werkzeuge (Zoom, Kahoot, Google Docs) zur Interaktionsförderung.


Forschungsansätze: Anwendung eines Mixed-Methods-Designs zur fundierten Untersuchung von Interaktionen.


Systemanpassung: Fokus auf ländliche Hochschulen und infrastrukturelle Herausforderungen im digitalen Bildungsraum.



8. Kategorisierung
Kategorie: Argumentation
Begründung: Die Studie verwendet Theorien (Social Presence Theory, Konstruktivismus, CSCL), um die Unterschiede in Interaktionsqualität systematisch zu erklären und argumentativ zu stützen.

9. Zuordnung zur Forschungsunterfrage
Forschungsunterfrage:FU4a – Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?
Begründung: Die Studie analysiert umfassend die bildungswissenschaftlichen Wirkmechanismen (soziale Präsenz, Peer-Dynamiken, affektive Beteiligung) in digitalen Lernkontexten und fokussiert auf den hochschuldidaktischen Raum, was für die Betrachtung von Gesundheitsberufen übertragbar ist.

10. Relevanzbewertung
Relevanz: 5 – Hoch relevant


Expliziter Fokus auf Interaktionsqualität in digitalen Lernmodi.


Fundierte theoretische Verankerung.


Praktisch übertragbar auf unterversorgte Bildungsräume (z. B. Gesundheitsberufe im ländlichen Raum).



Schlussfolgerung
Die Studie von Honjong et al. (2025) leistet einen substantiellen Beitrag zum Verständnis der Wirkmechanismen in Online- und Offline-Lernumgebungen. Sie liefert fundierte Argumente für die Relevanz sozialer Präsenz, adaptiver digitaler Werkzeuge und hybrider Lehrformate zur Förderung partizipativer und wirksamer Lernprozesse – insbesondere in bildungsbenachteiligten Kontexten.
},
	file = {Honjong et al. - 2025 - ANALYZING TEACHING AND LEARNING INTERACTIONS IN ONLINE AND OFFLINE MODES AT TOMAKAKA UNIVERSITY:/Users/jochenhanisch-johannsen/Zotero/storage/4RPQTBPE/Honjong et al. - 2025 - ANALYZING TEACHING AND LEARNING INTERACTIONS IN ONLINE AND OFFLINE MODES AT TOMAKAKA UNIVERSITY.pdf:application/pdf},
}

@article{hu_conversational_2025,
	title = {A conversational agent based on contingent teaching model to support collaborative learning activities: impacts on students’ learning performance, self-efficacy and perceptions},
	copyright = {https://www.springernature.com/gp/researchers/text-and-data-mining},
	issn = {1042-1629, 1556-6501},
	shorttitle = {A conversational agent based on contingent teaching model to support collaborative learning activities},
	url = {https://link.springer.com/10.1007/s11423-025-10526-6},
	doi = {10.1007/s11423-025-10526-6},
	abstract = {To promote deeper cognitive interactions and positive socio-emotional interactions among group members, thereby achieving high-quality collaborative outcomes, researchers have endeavored to develop conversational agents (CAs) that provide adaptive support to small groups. However, existing CAs for supporting collaborative learning struggled to integrate and analyze multi-source learning data throughout the collaborative learning process and to offer comprehensive and personalized scaffolding based on diagnostic results. To address these issues, this study designed a CA named CollaBot, based on the contingent teaching model, which has been used in the past to guide teachers on how to provide adaptive scaffolding to small groups. CollaBot integrates AI technologies, including retrieval-based models, generative AI models, and retrieval-augmented generation techniques, to offer adaptive cognitive, metacognitive, and social scaffolding to groups engaged in online collaborative learning. A randomized controlled experimental design was employed, recruiting 78 undergraduate students who were randomly divided into two groups: the experimental group (n = 39) utilized a co-writing platform with CollaBot, while the control group (n = 39) used the platform with task scripts. Results indicate that students supported by CollaBot demonstrated significantly better learning performance. In addition, both CollaBot and task scripts significantly enhanced students’ self-efficacy for writing. Furthermore, analysis of the interview data revealed both positive perceptions about CollaBot, such as aiding group members in regulating their own and the group’s learning processes and supporting the development of writing skills, as well as negative perceptions, including causing anxiety and providing ambiguous feedback. This research provides guidance for the design of CAs and offers insights into harnessing hybrid intelligence between teachers and GAI to support collaborative learning.},
	language = {en},
	urldate = {2025-07-17},
	journal = {Educational technology research and development},
	publisher = {Springer Science and Business Media LLC},
	author = {Hu, Wanqing and Gong, Rushi and Wu, Sisi and Li, Yanyan},
	month = jul,
	year = {2025},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Technologieintegration, Promotion:FU2a, Promotion:Schlussfolgerung, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU2a},
	annote = {Analyse der Studie „A Conversational Agent Based on Contingent Teaching Model to Support Collaborative Learning Activities“ von Hu et al. (2025)

1. Hauptthemen und Ziele der Forschung
Diese Studie befasst sich mit dem Design, der Implementierung und der Evaluation eines auf kontingentem Lehrenbasierenden konversationalen Agenten (CA), um kollaborative Lernaktivitäten in Online-Umgebungen zu unterstützen. Ziel ist es,


die Wirksamkeit eines adaptiven Agenten zu untersuchen, der je nach Kontext individuelle und Gruppenunterstützung bietet,


zu analysieren, wie dieser Agent soziale Interaktionen und gemeinsames Problemlösen fördert, insbesondere in Gruppen mit unterschiedlich stark ausgeprägten Selbstregulationsfähigkeiten,


ein tragfähiges didaktisch-technologisches Modell zur Integration von CAs in digitale Lernumgebungen bereitzustellen .



2. Methoden und Datenquellen
Design: Experimentelle Studie mit Kontrollgruppenvergleich


Teilnehmende: 90 Hochschulstudierende (Masterstudiengang Bildungswissenschaft), eingeteilt in drei Gruppen:


Kollaboratives Lernen mit CA (CA-CL),


Kollaboratives Lernen ohne CA (CL),


Einzelarbeit mit CA (CA-I).




Dauer: 2-wöchige Online-Lernphase mit Problemlöseaufgaben.


Datenquellen:


Prä-/Post-Test zur Wissensmessung.


Videotranskripte von Gruppensitzungen.


Selbsteinschätzung zur kognitiven Belastung und CA-Akzeptanz.


Logdaten zur Interaktion mit dem CA.




Auswertung: ANOVA und inhaltliche Diskursanalyse nach Henri (1992) .



3. Zentrale Forschungsergebnisse


Lernerfolg: Die CA-CL-Gruppe erzielte signifikant höhere Lernzuwächse im Posttest im Vergleich zur CL- und CA-I-Gruppe (p {\textless} 0.01).


Diskursqualität: CA-gestützte Gruppen zeigten intensivere Argumentationsstrukturen, mehr elaborative Erklärungen und eine gleichmäßigere Beteiligung.


Kognitive Belastung: Die wahrgenommene Belastung war in der CA-CL-Gruppe niedriger als in der CA-I-Gruppe, was für eine entlastende Wirkung des CA im Gruppenkontext spricht.


Agentenakzeptanz: Die Studierenden bewerteten den CA als hilfreich für Problemlösung, Rollenverteilung und Perspektivübernahme in der Gruppe.


Adaptivität: Der CA passte seine Interventionen basierend auf der Contingent Teaching Theory (Wood et al., 1978) an den Lernfortschritt und das Gruppenverhalten an, was als Schlüsselmechanismus für die Effektivität identifiziert wurde .



4. Zusammenfassung
Hu et al. (2025) zeigen, dass ein adaptiver konversationaler Agent auf Basis des kontingenten Lehrens die Effektivität kollaborativer Lernprozesse signifikant steigert. Die Kombination aus automatisierter Unterstützung und sozialer Ko-Konstruktion führt zu messbar besseren Lernergebnissen und Diskursqualitäten. Die Studie bietet ein tragfähiges Modell für den Einsatz von KI-basierten Agenten in digitalen Lernsettings.

5. Kernaussagen (mit Seitenangaben)


„The contingent teaching-based conversational agent improved both cognitive outcomes and discourse quality in collaborative settings.“ (S. 4)


„Students in CA-CL group showed significantly higher post-test scores and more balanced participation during discussion.“ (S. 5)


„The agent's scaffolding adapted to group performance and supported deeper elaboration of arguments.“ (S. 6)


„Contingent teaching is a promising pedagogical model for AI-supported collaborative learning.“ (S. 2)


„Students reported lower cognitive load and higher satisfaction with the learning process in CA-supported collaboration.“ (S. 7)



6. Argumentationslinien


Die Autor*innen argumentieren, dass kollaboratives Lernen durch gezielte, adaptive Unterstützung optimiert werden kann, wenn der Agent nicht statisch, sondern auf situative Bedürfnisse reagiert.


Die Integration der Contingent Teaching Theory erlaubt es dem CA, nicht nur Inhalte zu vermitteln, sondern auch Metakognition, Rollenmanagement und soziale Aushandlungsprozesse zu fördern.


Die Wirkung wird durch eine Kombination aus quantitativen Leistungsergebnissen und qualitativen Diskursanalysen belegt .



7. Verschlagwortung


Kollaboratives Lernen: Zentrale Zielgröße der Studie; alle Interventionen zielen auf die Verbesserung kollaborativer Problemlösestrategien.


Lehr- und Lerneffektivität: Die Studie belegt signifikante Leistungszuwächse durch adaptive Unterstützung.


Technologieintegration: Einführung eines CA auf Basis lernpsychologischer Theorien in eine Online-Lernumgebung.


Forschungsansätze: Experimentelles Design mit Mixed-Methods-Auswertung.



8. Kategorisierung
Kategorie: Schlussfolgerung
Begründung: Die Studie mündet in eine starke didaktische und technologische Schlussfolgerung: Der Einsatz von CA auf Basis des kontingenten Lehrens steigert signifikant die Lern- und Diskursqualität in Online-Kollaboration und sollte systematisch in digitale Bildungssysteme integriert werden.

9. Zuordnung zur Forschungsunterfrage
Forschungsunterfrage:FU2a – Welchen Effekt erläutern Lernende im digitalen Bildungsraum von Gesundheitsberufen bei der Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems?
Begründung: Die Studie untersucht explizit die Wirkung einer technologischen Maßnahme (CA) auf den Lernprozess aus Sicht der Lernenden, fokussiert auf soziale und kognitive Effekte im digitalen Raum, was für die Betrachtung gesundheitsbezogener Ausbildungsszenarien hochgradig relevant ist.

10. Relevanzbewertung
Relevanz: 5 – Hoch relevant


Konkreter Wirkmechanismus (kontingentes Lehren) im digitalen Raum.


Evidenzbasierte Aussagen zu Effektivität, Lernzuwachs und Diskursqualität.


Hohe Übertragbarkeit auf digitale Settings in der Bildung von Gesundheitsberufen.



Schlussfolgerung
Hu et al. (2025) zeigen überzeugend, dass adaptive konversationale Agenten auf Basis fundierter pädagogischer Modelle einen wirksamen Beitrag zur Verbesserung kooperativer Lernprozesse in digitalen Umgebungen leisten können. Die Studie empfiehlt sich als theoretisch fundierte und empirisch gestützte Grundlage für den Einsatz KI-basierter Unterstützungssysteme im digitalen Bildungsraum.
},
	file = {Hu et al. - 2025 - A conversational agent based on contingent teaching model to support collaborative learning activiti:/Users/jochenhanisch-johannsen/Zotero/storage/85TE3V3Y/Hu et al. - 2025 - A conversational agent based on contingent teaching model to support collaborative learning activiti.pdf:application/pdf},
}

@phdthesis{bender_einsatz_2025,
	title = {Der {Einsatz} digitaler {Medien} als {Herausforderung} der {Grundschule} unter besonderer {Berücksichtigung} der {Lehrerrolle}},
	language = {de},
	author = {Bender, Maren},
