	keywords = {Charité:Promotion, Promotion:Literaturanalyse, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, \#1:Zeitschriftenartikel:learning:management:system, Promotion:Ausschluss, Promotion:FU6, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {17071--17096},
	file = {Sharma et al. - 2024 - Identification, quality perceptions, and cultural moderators in learning management system group com:/Users/jochenhanisch-johannsen/Zotero/storage/YES34TLM/Sharma et al. - 2024 - Identification, quality perceptions, and cultural moderators in learning management system group com.pdf:application/pdf},
