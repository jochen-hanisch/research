	pmcid = {PMC10767029},
	keywords = {Charité:Promotion, Promotion:Literaturanalyse, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Bildungstheorien, \#1:Zeitschriftenartikel:learning:management:system, Krisenreaktion im Bildungsbereich, Lernsystemarchitektur, Mixed-method study, MOODLE, Patient-centric e-module, Seminar, Student-led focus group discussion, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
