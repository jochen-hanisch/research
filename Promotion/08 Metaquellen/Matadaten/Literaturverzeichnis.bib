@book{raithelEinfuhrungPadagogikBegriffe2009,
  title = {Einführung Pädagogik: Begriffe - Strömungen - Klassiker - Fachrichtungen},
  author = {Raithel, Jürgen and Dollinger, Bernd and Hörmann, Georg},
  date = {2009},
