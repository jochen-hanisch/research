	year = {2019},
	doi = {10.5771/9783957103406-264},
	keywords = {Charité:Promotion, Promotion:Literaturanalyse, \#9:Buchteil:digital:lernen, Promotion:S:09 Digital Lernen, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
