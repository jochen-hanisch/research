	month = dec,
	year = {2022},
	doi = {10.31244/9783830996224},
	keywords = {Charité:Promotion, Promotion:Literaturanalyse, Bildung, Multimedia, \#9:Buch:digital:lernen, Promotion:S:09 Digital Lernen, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
