	pages = {203--225},
	file = {Blumberg und Kauffeld - 2021 - Kompetenzen und Wege der Kompetenzentwicklung in d.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/7L93RX3X/Blumberg und Kauffeld - 2021 - Kompetenzen und Wege der Kompetenzentwicklung in d.pdf:application/pdf},
