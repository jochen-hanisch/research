@article{sun_beyond_2025,
	title = {Beyond the screen: enhancing ethnic cultural representation and engagement through immersive 360° documentary experiences in museums},
	volume = {12},
	copyright = {https://creativecommons.org/licenses/by/4.0},
	issn = {2662-9992},
	shorttitle = {Beyond the screen},
	url = {https://www.nature.com/articles/s41599-025-05429-z},
	doi = {10.1057/s41599-025-05429-z},
	abstract = {Abstract          In this era of digital heritage, immersive media, such as 360° documentaries, have been proposed to enrich engagement and learning. However, how immersive 360° media formats influence the understanding of ethnic minority cultures remains underexplored. We conducted a controlled laboratory experiment comparing traditional 2D and 360° documentary presentations of the Miao community in Guizhou Province, using the same narration and content, including village scenes, performances, and crafts, to isolate the effect of media format. The results suggest that the 360° documentary may increase viewers’ enjoyment, sense of presence, curiosity, and appreciation of cultural content relative to a comparable 2D film. These exploratory findings indicate a potential for immersive media to deepen cultural understanding. Our study underscores 360° documentaries as a promising tool for engaging audiences with ethnic minority cultures, while noting that these conclusions are provisional given the lab setting and should be tested in real-world museum contexts.},
	language = {en},
	number = {1},
	urldate = {2025-07-12},
	journal = {Humanities and Social Sciences Communications},
	publisher = {Springer Science and Business Media LLC},
	author = {Sun, Xiaolin and Ch’ng, Eugene},
	month = jul,
	year = {2025},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:FU4a, Technologieintegration, Systemanpassung, Promotion:Relevanz:4, \#0:Zeitschriftenartikel:digital:learning, Promotion:Schlussfolgerung, Promotion:S:12 Digital Learning, Promotion:Literaturverzeichnis},
	annote = {Analyse der Studie „Beyond the screen: Enhancing ethnic cultural representation and engagement through immersive 360° documentary experiences“ von Sun \& Ch’ng (2025)

1. Hauptthemen und Ziele der Forschung
Die Studie untersucht, wie 360°-dokumentarische Virtual-Reality-Erfahrungen zur Darstellung und Vermittlung ethnischer Kultur beitragen können. Ziel ist es, zu analysieren, inwiefern immersive Formate das emotionale, kognitive und reflexive Engagement von Rezipient*innen im Vergleich zu klassischen 2D-Videos steigern – am Beispiel der chinesischen Miao-Gemeinschaft.

2. Methoden und Datenquellen


Studiendesign: Mixed-Methods-Ansatz


Quantitative Vergleichsstudie (360° vs. 2D-Dokumentation)


Qualitative Inhaltsanalyse (offene Antworten)




Stichprobe: 104 Personen (gleichmäßig auf beide Gruppen verteilt)


Messinstrumente:


Skalen zu Präsenz, Enjoyment, Flow, Neugier, Kulturelle Wertschätzung


Wilcoxon-Signed-Rank-Test für Vergleich vorher/nachher




Qualitative Daten: 79 beschreibende Kommentare wurden thematisch ausgewertet (S. 11)



3. Zentrale Forschungsergebnisse


Stärkere Präsenz und Flow in 360°-Gruppe: Deutlich höhere Mittelwerte für Immersion (M = 5.86 vs. 3.69), Präsenz, Flow und Enjoyment in der 360°-Gruppe (S. 8–9).


Signifikante Steigerung der Neugier: Nur in der 360°-Gruppe stieg die Neugier nach der Rezeption signifikant an (p {\textless} 0.05), besonders bei Teilnehmenden ohne Vorwissen über die Miao-Kultur (S. 9).


Höhere kulturelle Wertschätzung bei erfahreneren Zuschauer*innen: Personen, die bereits Kontakt zur Miao-Kultur hatten, berichteten nach 360°-Erlebnis mehr Wertschätzung für Handwerkskunst (p {\textless} 0.05) (S. 10).


Tiefere Reflexionen im qualitativen Teil: Nutzer*innen beschrieben die Erfahrung als „authentischer“ und „verbindlicher“ als touristische Besuche, insbesondere durch Nähe zu Personen, Räumen und Alltagsszenen (S. 11).



4. Zusammenfassung
Sun \& Ch’ng (2025) zeigen, dass immersive 360°-Dokumentationen effektiver sind als klassische 2D-Videos, wenn es um kulturelles Lernen, emotionale Verbundenheit und kognitive Aktivierung geht. Die empirische Untersuchung weist signifikante Unterschiede in Präsenz, Flow, Neugier und emotionalem Engagement aus. Besonders bedeutsam sind die qualitativen Hinweise auf eine reflexive und respektvolle Auseinandersetzung mit der dargestellten Kultur.

5. Kernaussagen


„Immersive documentaries can foster greater presence and engagement than conventional formats.“ (S. 12)


„Only the 360° group showed a statistically significant increase in curiosity about the Miao culture.“ (S. 9)


„The sense of being part of the environment and the people’s lives was most pronounced in the 360° condition.“ (S. 10)


„Immersion supports emotional and cognitive empathy with culturally distant communities.“ (S. 12)



6. Argumentationslinien


Problemstellung: Kulturelle Repräsentationen sind häufig stereotypisiert oder distanziert.


Hypothese: Immersive Formate können emotionale, kognitive und reflexive Zugänge verstärken.


Empirie: Vergleich von 2D- und 360°-Formaten mit quantitativen und qualitativen Methoden.


Ergebnisse: 360°-Erfahrungen erzeugen signifikant höhere Werte in allen relevanten Kategorien.


Implikationen: Potenzial für Bildungs- und Museumskontexte sowie für die Förderung interkultureller Verständigung.



7. Verschlagwortung




Schlagwort


Begründung




Lehr- und Lerneffektivität


Die Studie untersucht die Effektivität immersiver Medien im Vergleich zu traditionellen Formaten bezogen auf Lernziele.




Technologieintegration


360°-Videoformate und Virtual-Reality-Technologie werden systematisch in Lernsettings integriert.




Forschungsansätze


Kombination quantitativer und qualitativer Methoden, inklusive inferenzstatistischer Tests und thematischer Inhaltsanalyse.




Systemanpassung


Die Autor*innen diskutieren die Übertragung auf reale Bildungsinstitutionen wie Museen oder Bildungseinrichtungen.





8. Kategorisierung
Kategorie: Schlussfolgerung

Die Studie kommt zum Ergebnis, dass immersive Medien – spezifisch 360°-Dokumentationen – als effektive Werkzeuge zur Förderung von interkultureller Bildung und emotionalem Lernen einzusetzen sind. Diese Schlussfolgerung wird durch multiple Datenquellen trianguliert gestützt (S. 12).


9. Zuordnung zur Forschungsunterfrage
Forschungsunterfrage (FU4a):„Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?“
Begründung:Die Studie belegt, wie technikvermittelte Präsenz und kognitive/emotionale Involviertheit als Wirkfaktoren in digitalen Lernumgebungen fungieren können – Konzepte, die sich auch auf systemisch-konstruktivistische LMS anwenden lassen.

10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 4


Zitierfähigkeit und Einfluss: 5


Aktualität: 5


Gesamtbewertung: 4

11. Schlussfolgerung
Sun \& Ch’ng (2025) leisten einen wichtigen Beitrag zur Diskussion um die lernförderliche Wirkung immersiver Medienformate. Die Studie zeigt auf, dass über die technische Darstellung hinaus auch emotionale und reflexive Lernprozesse gezielt aktiviert werden können – ein Befund, der für digitale Bildungsräume in Gesundheitsberufen von hoher Relevanz ist, etwa im Umgang mit Diversität, Empathie oder kulturellen Kontexten.
},
	file = {PDF:/Users/jochenhanisch-johannsen/Zotero/storage/KSMAVHAI/Sun und Ch’ng - 2025 - Beyond the screen enhancing ethnic cultural representation and engagement through immersive 360° do.pdf:application/pdf},
}

