@misc{openai_neugier_2024,
	title = {Neugier},
	url = {https://chatgpt.com/c/672134a6-c388-800e-8896-3d75b4fbf7df},
	abstract = {Diese Analyse untersucht Neugierde als einen autopoetischen Re-Entry-Prozess, der kontinuierlich neue Unterscheidungen und Lernimpulse erzeugt und sich selbstständig aufrechterhält. Aufbauend auf der Systemtheorie von George Spencer Brown sowie den Motivationstheorien von Deci und Ryan wird Neugierde als eigenständiger Mechanismus beschrieben, der sich von traditionellen Konzepten wie Feedback und Reflexion unterscheidet. Während Feedback als externe Rückkopplung und Reflexion als bewusste Auseinandersetzung mit dieser Rückkopplung fungieren, agiert Neugierde unabhängig von äußeren Anreizen und stärkt intrinsisch motiviertes Lernen.

Durch den Re-Entry-Prozess, bei dem Unterscheidungen immer wieder in das System eingeführt werden, entsteht eine autokatalytische Schleife, die neue Erkenntnisse und kognitive Anpassungen kontinuierlich begünstigt. Diese Perspektive hat weitreichende Implikationen für Bildungssysteme und Lernumgebungen, indem sie zeigt, wie intrinsische Motivation und selbstgesteuertes Lernen effektiv gefördert werden können. Die Analyse berücksichtigt auch mögliche Überlastungsrisiken bei unstrukturierter Neugierde-Förderung und betont die Notwendigkeit einer ausgewogenen pädagogischen Gestaltung.},
	language = {de-DE},
	urldate = {2024-10-29},
	author = {{OpenAI}},
	collaborator = {{Jochen Hanisch-Johannsen}},
	month = oct,
	year = {2024},
	keywords = {Charité:Promotion, Promotion:Literaturverzeichnis},
	file = {OpenAI - 2024 - Neugier:/Users/jochenhanisch-johannsen/Zotero/storage/BCQPNRX2/OpenAI - 2024 - Neugier.pdf:application/pdf},
}

