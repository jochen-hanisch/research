	keywords = {Charité:Promotion, Promotion:Literaturanalyse, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Systemanpassung, Bildungstheorien, \#0:Zeitschriftenartikel:digital:learning, Promotion:FU3, Promotion:S:12 Digital Learning, Promotion:Literaturverzeichnis},
	pages = {92--109},
	file = {Diergarten - 2024 - Bildung in einer postdigitalen Welt Digitale Erfa.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/7TAJFS9A/Diergarten - 2024 - Bildung in einer postdigitalen Welt Digitale Erfa.pdf:application/pdf},
