  publisher = {Springer Nature Switzerland},
  location = {Cham},
  doi = {10.1007/978-3-031-65881-5_6},
  url = {https://link.springer.com/10.1007/978-3-031-65881-5_6},
  urldate = {2024-08-02},
  abstract = {The use of artificial intelligence tools like ChatGPT in education has resulted in academics being unsure of whether student artefacts are their own. This study qualitatively surveyed fifty-three postgraduate students trying to determine how they use ChatGPT to assist them in their assessments. Feedback from the respondents indicated that ChatGPT has pros of being helpful or brainstorming and idea generation, it has cons of providing non-specific responses, unoriginal short responses, non-reputable sources and unable to provide meaningful examples. Based on the responses, the study proposes six guidelines that can assist academics design their assessments to encourage students to use innovative AI technologies. The six guidelines are (1) Design assessments to vary in format, (2) Design summative assessments to critique an AI tool response, (3) Design assessments to provide examples or work with case studies, (4) Design formative assessments to incorporate brainstorm ideas from AI tool, (5) Design assessment to provide proof of legitimate references, (6) Design assessments iteratively.},
  isbn = {978-3-031-65880-8 978-3-031-65881-5},
  langid = {english},
  keywords = {Charité:Promotion,GPT},
  file = {/Users/jochen_hanisch-johannsen/Zotero/storage/HFPQZFDP/Pillay - 2024 - ChatGPT Assessment Design for Postgraduate Student.pdf}
}

