	file = {Sailer et al. - 2023 - Bildungstechnologische Fragen in der Hochschullehr.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/PYMKZM8C/Sailer et al. - 2023 - Bildungstechnologische Fragen in der Hochschullehr.pdf:application/pdf},
