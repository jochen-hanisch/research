	file = {Fink et al. - 2013 - Lern-Service-Engineering - Eine ökonomische Perspektive auf technologieunterstütztes Lernen:/Users/jochenhanisch-johannsen/Zotero/storage/VBNRX4IH/Fink et al. - 2013 - Lern-Service-Engineering - Eine ökonomische Perspektive auf technologieunterstütztes Lernen.pdf:application/pdf},
