}

@article{grobner_ich_2025,
	title = {„{Ich} seh’, ich seh’, was du nicht siehst!“: {Eye}-{Tracking}-{Technologie} in der {Leseforschung}},
	copyright = {https://creativecommons.org/licenses/by-nc-nd/4.0},
	issn = {2791-4046, 2791-4046},
	shorttitle = {„{Ich} seh’, ich seh’, was du nicht siehst!“},
	url = {https://schule-verantworten.education/journal/index.php/sv/article/view/524},
	doi = {10.53349/schuleverantworten.2025.i2.a524},
	abstract = {Lesen ist eine grundlegende Kompetenz, die die Möglichkeit zur Bildung und gesellschaftlicher Partizipation ermöglicht. In den letzten Jahren hat sich Eye-Tracking als eine innovative Methode zur Analyse von Leseprozessen etabliert. Dabei werden die Augenbewegungen der Lesenden verfolgt, um Einblicke in ihre kognitiven Prozesse zu erlangen. Diese Technologie erfasst Fixationen, Sakkaden und Regressionen, die Rückschlüsse auf Textverständnis und Lesestrategien zulassen. Eye-Tracking wird in der Leseforschung verwendet, um individuelles Leseverhalten zu untersuchen und zu verstehen, wie Textstrukturen wahrgenommen und verarbeitet werden. Die Technologie hilft dabei, frühzeitig Lernrückstände oder Beeinträchtigungen, wie Leseschwäche oder ADHS zu erkennen. In der praktischen Leseförderung können Lehrkräfte mit dieser Forschungsmethode gezielt Lesestrategien beobachten und fördern. Insgesamt bietet diese Methode eine wertvolle Unterstützung, um das Leseverständnis zu verbessern und die Lesekompetenz individuell zu fördern.},
	language = {de},
	number = {2},
	urldate = {2025-07-04},
	journal = {\#schuleverantworten},
	author = {Grobner, Marie-Christin and Wittmann, Astrid},
	month = jun,
	year = {2025},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Bewertungsmethoden, Systemanpassung, Promotion:Argumentation, Promotion:Relevanz:4, \#6:Zeitschriftenartikel:Bildung:Technologie, Promotion:FU5, Promotion:S:06 Bildungstechnologie, Promotion:Literaturverzeichnis},
	pages = {40--49},
	annote = {Analyse der Studie „Ich seh’, ich seh’, was du nicht siehst!“ – Eye-Tracking-Technologie in der Leseforschung von Grobner \& Wittmann (2025)

1. Analyse
Hauptthemen und Ziele der Forschung
Die Autorinnen untersuchen den Einsatz von Eye-Tracking-Technologie zur Analyse kognitiver Prozesse beim Lesen. Ziel ist es, aufzuzeigen, wie Eye-Tracking genutzt werden kann, um:


Leseverhalten sichtbar zu machen,


Leseschwächen und ADHS frühzeitig zu diagnostizieren,


und individualisierte Lesefördermaßnahmen zu entwickeln.



Methoden und Datenquellen
Die Arbeit ist theoretisch-konzeptionell, kein empirisches Studiendesign im engeren Sinn. Sie basiert auf:


Synthese existierender Eye-Tracking-Forschung (z. B. De Luca et al., 2002; Kim \& Lombardino, 2016),


Darstellung von Funktionsweisen stationärer vs. mobiler Eye-Tracking-Systeme,


konkreten Beispielen aus der Leseforschung und Diagnostik (z. B. Dyslexie, ADHS),


und praktischen Überlegungen zur Integration in schulische Förderung.


Visualisierungen wie Abbildung 1 auf Seite 43 zeigen beispielhaft stationäre und mobile Geräte, um den praktischen Bezug zu verdeutlichen.

Zentrale Forschungsergebnisse
Die Autorinnen betonen:


Eye-Tracking ermöglicht objektive und stressarme Diagnostik (z. B. Leseschwäche, ADHS),


es liefert Einblicke in Blickmuster, Lesestrategien und kognitive Prozesse,


Unterschiede im Leseverhalten (z. B. Fixationsdauer, Sakkaden, Regressionshäufigkeit) korrelieren mit Lesekompetenz,


es bestehen deutliche Unterschiede zwischen Anfängerinnen und Expertinnen beim Lesen multimodaler Texte (z. B. in Mathematik und Geografie),


Eye-Tracking kann zur Entwicklung adaptiver, individueller Förderpläne beitragen.



2. Zusammenfassung
Grobner \& Wittmann (2025) stellen Eye-Tracking als innovative Methode der Leseforschung vor. Die Technologie erlaubt es, Blickbewegungen zu analysieren und daraus Rückschlüsse auf Lesestrategien, kognitive Prozesse und mögliche Leseschwächen zu ziehen. Stationäre und mobile Systeme bieten unterschiedliche Vorteile für Forschung und schulische Praxis. Insbesondere bei der Diagnostik von Dyslexie oder ADHS zeigt Eye-Tracking hohes Potenzial für objektive, nicht-invasive Diagnosen. Die Autorinnen plädieren für den Transfer dieser Erkenntnisse in Unterricht und Leseförderung, um individuelle Unterstützung gezielt zu gestalten.

3. Kernaussagen


„Eye-Tracking wird in der Leseforschung verwendet, um individuelles Leseverhalten zu untersuchen und zu verstehen, wie Textstrukturen wahrgenommen und verarbeitet werden“ (S. 40).


„Kinder mit geringer Lesekompetenz weisen eine höhere Anzahl sowie eine längere Dauer von Fixationen auf“ (S. 44).


„Eye-Tracking bietet eine objektive Alternative zu herkömmlichen Screening-Tests, die oft stressbelastet und subjektiv bewertet sind“ (S. 44).


„Gezielte Lesetrainings oder visuelle Hilfsmittel können Lernende dabei unterstützen, sich besser auf den Text zu konzentrieren“ (S. 46).


„Zukünftige Forschungen sollten sich darauf konzentrieren, wie Eye-Tracking in den schulischen Alltag integriert werden kann“ (S. 47).



4. Argumentationslinien
Die Autorinnen bauen ihre Argumentation systematisch auf:


Lesen als Schlüsselkompetenz (S. 40–41),


Eye-Tracking als methodische Innovation (S. 41–43),


Diagnostische Anwendung bei Leseschwäche \& ADHS (S. 44–46),


Praktische Relevanz für Leseförderung (S. 46–47),


Ausblick auf Forschung und schulische Integration (S. 47).


Dabei verknüpfen sie medizinisch-diagnostische Perspektiven mit pädagogisch-praktischen Implikationen.

5. Verschlagwortung




Schlagwort


Begründung




Bewertungsmethoden


Eye-Tracking wird als objektives Diagnosetool für Lesefähigkeit diskutiert.




Lehr- und Lerneffektivität


Die Förderung von Lesestrategien und Leseverhalten wird durch gezielte Eye-Tracking-Analysen unterstützt.




Forschungsansätze


Es wird ein Überblick über experimentelle und diagnostische Studien mit Eye-Tracking gegeben.




Systemanpassung


Diskussion über die Integration der Technologie in schulische Settings.





6. Kategorisierung
Kategorie: ArgumentationDie Arbeit nutzt vorhandene wissenschaftliche Studien und Beispiele zur Begründung des Einsatzes von Eye-Tracking in Diagnostik und Leseförderung, und argumentiert für eine stärkere Einbindung in die Praxis.

7. Zuordnung zur Forschungsunterfrage
Passendste FU:FU5 – Welche Möglichkeiten und Grenzen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems durch Akteure im digitalen Bildungsraum von Gesundheitsberufen analysiert?
Begründung:Obwohl kein LMS im engeren Sinn behandelt wird, fokussiert die Studie auf eine spezifische Technologie im digitalen Bildungsraum und diskutiert Möglichkeiten (individualisierte Förderung, objektive Diagnostik) und Grenzen (technischer Aufwand, Messgenauigkeit mobiler Geräte) für pädagogische Settings.

8. Relevanzbewertung
Relevanz: 4 – RelevantDie Studie ist für die Diskussion diagnostischer und technologiegestützter Fördermaßnahmen hoch relevant, auch wenn sie sich nicht auf Gesundheitsberufe oder LMS fokussiert.

[Eingabe]
},
	file = {PDF:/Users/jochenhanisch-johannsen/Zotero/storage/AK9GTYZV/Grobner und Wittmann - 2025 - „Ich seh’, ich seh’, was du nicht siehst!“ Eye-Tracking-Technologie in der Leseforschung.pdf:application/pdf},
}

@article{singh_wearable_2025,
	title = {Wearable {IoT} (w-{IoT}) artificial intelligence ({AI}) solution for sustainable smart-healthcare},
	volume = {5},
