@book{hanisch_agiles_2023,
	address = {München},
	series = {Academic {Plus}},
	title = {Agiles {Lernen} zur {Kompetenzentwicklung} für {High} {Responsibility} {Teams}. {Wie} agiles {Lernen} die {Ausbildung} im {Rettungsdienst} optimieren kann},
	copyright = {All rights reserved},
	isbn = {eBook 9783346936097, Buch 9783346936103},
	url = {https://www.grin.com/document/1387989},
	abstract = {Im Kontext der Kompetenzentwicklung von High Responsibility Teams wurde agiles Lernen bisher noch nicht diskutiert. Diese Arten von Teams übernehmen hohe Verantwortung für das Leben anderer oder hohe Sachwerte und legen hierbei großen Wert auf Fehlervermeidung. Die Eignung des Konstruktes agiles Lernen zur Kompetenzentwicklung in Teams mit hoher Verantwortung wird durch diese handlungsleitende Forschungsfrage beantwortet.

Die vorliegende theoretische Konzeption konstatiert, dass agiles Lernen gute Ergebnisse erzielt und als didaktisches Rahmenwerk verwendet werden kann. Frühere Studien haben die Wirkungsmechanismen des agilen Sprintlernens untersucht und beschrieben, die Ergebnisse dieser Studie bilden die Basis der vorliegenden Arbeit. Um die Forschungsfrage der Kompetenzentwicklung zu beantworten, wurde die Entwicklung der spezifischen Definition von Kompetenz und die Skizzierung des Entwicklungsverlaufs erforderlich. Scrum kann im betrachteten Anwendungsbereich als agile Methode verwendet werden, um High Responsibility Teams zu trainieren und ihre Fähigkeiten zu entwickeln.

Die Möglichkeiten des agilen Lernens werden insbesondere bei einer präzisen, methodisch strukturierten Umsetzung dieser Lernarrangements deutlich, die kognitiven und psychomotorischen Handlungen verknüpfen. Demonstriert und bewertet werden diese in einer staatlichen Prüfung. Grenzen des agilen Lernens werden durch rigide Regeln und entkoppelte Lernorte gesetzt. Das zusammenfassende Ergebnis dieser konzeptionellen Arbeit besagt, dass agiles Lernen einen kontextsituierten Rahmen bietet, der die Entwicklung von Kompetenzen für Teams mit hoher Verantwortung ermöglicht und dadurch positive Ergebnisse bewirkt.},
	language = {de-DE},
	urldate = {2023-09-12},
	publisher = {GRIN Publishing GmbH},
	author = {Hanisch, Jochen},
	month = sep,
	year = {2023},
	keywords = {Promotion:Literaturverzeichnis},
	annote = {Agiles Lernen als Antwort auf didaktische Systementkopplung
Digitale Bildungsräume erzeugen nicht nur neue Lernmöglichkeiten, sondern transformieren auch klassische Steuerungslogiken pädagogischer Systeme. Diese Transformation führt – insbesondere in komplexen Berufsfeldern wie dem Gesundheitswesen – zu einer zunehmenden Entkopplung zwischen Lehrintention und Lernrealität, wie sie auch in systemtheoretischen Modellen der pädagogischen Kommunikation angelegt ist (vgl. Luhmann \& Schorr, 1982). Die zunehmende Heterogenität der Lernenden, die situative Dynamik von Anwendungskontexten und die Unvorhersehbarkeit digitaler Interaktion erzeugen ein Wirkgefüge, das sich nicht mehr durch lineare Instruktion steuern lässt. Es bedarf einer didaktischen Reaktion, die nicht auf Kontrolle, sondern auf Adaptivität, Responsivität und emergente Strukturbildung setzt.
Agiles Lernen stellt in diesem Kontext einen vielversprechenden Antwortversuch dar. Es basiert auf Prinzipien aus der agilen Softwareentwicklung (Scrum, Kanban, Design Thinking), überträgt diese jedoch auf Lernarchitekturen, in denen Autonomie, Iteration, Feedback und Selbststeuerung zentrale Rollen einnehmen (Hanisch, 2023, S. 25–30). Lernprozesse werden dabei nicht entlang vorab definierter Curricula abgearbeitet, sondern in kleinen, zyklischen Schritten geplant, erprobt, reflektiert und angepasst. Lernende übernehmen eine aktive Rolle in der Ko-Konstruktion ihres Lernwegs und entwickeln dabei – in enger Kopplung an reale Handlungsanforderungen – sowohl situative als auch strukturelle Kompetenzen.
Diese didaktische Struktur ermöglicht es, Systementkopplungen nicht zu vermeiden, sondern produktiv zu gestalten. Wo klassische Bildungsformate an Kontingenz scheitern, bietet agiles Lernen eine Struktur zur Kontingenzbewältigung durch kontinuierliche Selbstanpassung. Gerade in digitalen Settings kann dadurch ein Wirkgefüge entstehen, das nicht über Input-Output-Modelle kontrolliert, sondern über Rückkopplungsschleifen reguliert wird – analog zu kybernetischen Steuerungsprinzipien (vgl. Kruse, 2015).
Im Fall der Notfallsanitäter*innen-Ausbildung bedeutet dies konkret: Agiles Lernen kann die hohen Anforderungen an situative Entscheidungsfähigkeit, Teamkoordination und Stressresistenz nicht nur abbilden, sondern in die Lernarchitektur selbst integrieren. Lernende erleben Kompetenzentwicklung als strukturierte Eigenbewegung, eingebettet in ein digitales Setting, das auf schnelle Responsivität und iterative Reflexion ausgelegt ist. Die Systemarchitektur des hier untersuchten LMS greift dieses Prinzip explizit auf, etwa durch Sprints, modulare Aufgabenkomplexe, Echtzeit-Feedback und adaptive Kurspfade.
Insgesamt zeigt sich: Agiles Lernen ist nicht nur ein methodischer Zugang, sondern ein didaktisch-funktionales Modell zur Gestaltung dynamischer, kontingenzsensibler Lernräume. Es operationalisiert die systemische Forderung nach Anschlussfähigkeit unter Bedingungen struktureller Unsicherheit – und wird so zum integralen Bestandteil eines digital erweiterten Bildungswirkgefüges.
},
}

@article{atasever_digital_2025,
	title = {The digital escape room developed for nursing students: {GestDia}},
	volume = {25},
	copyright = {https://creativecommons.org/licenses/by-nc-nd/4.0},
