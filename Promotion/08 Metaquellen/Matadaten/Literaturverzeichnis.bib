	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Bildungstheorien, Promotion:Argumentation, \#6:Zeitschriftenartikel:Bildung:Technologie, Bildung, Digitale Bildung, Technologie, Promotion:FU3, Promotion:Relevanz:3, Adult training, Erwachsenenbildung, Artificial intelligence, Learning Analytics, Erweiterung, Substitution, Promotion:S:06 Bildungstechnologie, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
