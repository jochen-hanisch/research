  doi = {10.1007/978-3-658-42775-7_7},
  url = {https://link.springer.com/10.1007/978-3-658-42775-7_7},
  urldate = {2024-07-14},
  abstract = {Zusammenfassung             Der Einzelhandel ist nicht erst seit der Corona-Pandemie starken Veränderungen unterworfen. Geändertes Konsumverhalten und die Digitalisierung erfordern, dass sich die Anbieter anpassen, um auch künftig noch erfolgreich zu sein. Neben den stationären Absatzkanälen werden Vertriebskanäle über das Internet immer wichtiger. Sind alle Kanäle übergreifend geführt, hoch vernetzt, stark kundenfokussiert und ermöglichen ein kanalübergreifendes Einkaufserlebnis, spricht man von einer Omni-Channel-Strategie. Im Beitrag erfolgt eine Analyse der Situation im Schweizer Non-Food-Detailhandel mit Fokus auf die Fragen, welche Strategien sich bei der Transformation der Vertriebsstrukturen und -aktivitäten etabliert haben, welche für die Zukunft zu erwarten sind, und welche Voraussetzungen für die erfolgreiche Umsetzung von Omni-Channel-Strategien nötig sind. Auf Basis einer empirischen Erhebung wird ein Modell entwickelt, das Unternehmen dabei helfen soll, eine solche Strategie generieren und implementieren zu können.},
  isbn = {978-3-658-42774-0 978-3-658-42775-7},
