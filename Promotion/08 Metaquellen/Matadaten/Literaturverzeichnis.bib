  booktitle = {{{INNOVATIVE TEACHING METHODS}}: {{E-Learning}} in {{Poland}} and {{Belgium}}},
  author = {Descamps,, Sarah and Marchal, Pauline and Temperman, Gaëtan and Lièvre, Bruno De},
