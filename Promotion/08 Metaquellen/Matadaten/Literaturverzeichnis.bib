@article{horst_digital-differenzierte_2023,
	title = {Digital-differenzierte {Lernmodule} im {Schülerlabor}: eine {Pilotstudie}},
	copyright = {all rights reserved},
	shorttitle = {Digital-differenzierte {Lernmodule} im {Schülerlabor}},
