@article{andrade-arenas_moodle_2023,
	title = {Moodle platform and {Zoom} videoconference: learning skills in the virtual modality},
	volume = {31},
	issn = {2502-4760, 2502-4752},
	shorttitle = {Moodle platform and {Zoom} videoconference},
	url = {https://ijeecs.iaescore.com/index.php/IJEECS/article/view/29965},
	doi = {10/gswfrf},
	abstract = {In Peruvian Universities, most of the Moodle platforms and the Zoom videoconference were used in virtual teaching-learning. The teachers and students of the University of Sciences and Humanities, which is the object of study, used these tools in the class session. Moodle and Zoom complement each other for virtual classes during the pandemic time. The objective of the research is the influence of Zoom and Moodle on learning skills. The methodological design of the research has correlational scope, quantitative, non-experimental approach of cross-section. A survey was conducted of 95 students from the first cycles of the university. The instrument was validated by expert judgments with 86.3\% approval. In addition, reliability was performed with Cronbach's Alpha, obtaining the value of 0.875. A p-value of 0000 was obtained as a result and the degree of correlation between Moodle and learning skills was 0.438** and Zoom with learning skills was 0.519**; determining in this way that there is a moderate positive significant correlation. It is concluded that the development of learning skills that correspond to digital skills, the communicative and cognitive part is due to the use of the Moodle platform and the Zoom videoconference in the learning sessions.},
	language = {en-GB},
	number = {1},
	urldate = {2023-10-18},
	journal = {Indonesian Journal of Electrical Engineering and Computer Science},
	author = {Andrade-Arenas, Laberiano and Reyes Perez, William Wilfredo and Yactayo Arias, Cesar Augusto},
	month = jul,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Technologieintegration, Systemanpassung, Promotion:Argumentation, \#0:Zeitschriftenartikel:digital:learning, Promotion:FU5, Datenschutz und IT-Sicherheit, Krisenreaktion im Bildungsbereich, Lernsystemarchitektur, Promotion:S:12 Digital Learning, Promotion:Literaturverzeichnis},
	pages = {337},
	annote = {Analyse des Artikels „Moodle platform and Zoom videoconference: learning skills in the virtual modality“ von Andrade-Arenas et al. (2023)

1. Hauptthemen und Ziele der Forschung
Der Artikel untersucht die Auswirkungen der Nutzung der Moodle-Plattform und Zoom-Videokonferenztools auf die Entwicklung von Lernfähigkeiten im Kontext der virtuellen Lehre an peruanischen Universitäten. Ziel ist es, die Korrelation zwischen der Nutzung dieser Tools und der Förderung digitaler, kommunikativer und kognitiver Kompetenzen zu bewerten.

2. Methoden und Datenquellen


Design:


Quantitative, korrelative Studie mit Querschnittsansatz.


Online-Umfrage mit 95 Studierenden aus den ersten Semestern.




Instrumente:


Fragebogen mit 26 Fragen, validiert durch Expert*innen mit 86,3 \% Zustimmung und einer Cronbach-Alpha-Zuverlässigkeit von 0,875.




Datenanalyse:


Kendall’s Tau-B-Test zur Korrelation.


Multiple lineare Regression zur Analyse der erklärenden Variablen.





3. Zentrale Forschungsergebnisse


Korrelationen:


Moodle korreliert moderat positiv mit Lernfähigkeiten (r = 0,438**).


Zoom korreliert moderat stärker mit Lernfähigkeiten (r = 0,519**).




Lernfähigkeiten:


Die stärkste Korrelation besteht zwischen digitalen Fähigkeiten und Zoom (r = 0,701**).


Moodle unterstützt vor allem kognitive und kommunikative Kompetenzen.




Herausforderungen:


Studierende hatten anfänglich Schwierigkeiten mit Moodle (Dateiuploads, Forennutzung).


Technische Barrieren wie Internetzugang und Plattformkompetenzen beeinflussen die Nutzung.




Skalierbarkeit:


Moodle und Zoom bieten flexible, skalierbare Lösungen für Bildungseinrichtungen, besonders in pandemiebedingten Online-Formaten.





Zusammenfassung
Der Artikel zeigt, dass die Kombination von Moodle und Zoom positive Auswirkungen auf Lernfähigkeiten hat, insbesondere durch die Förderung von digitalen, kommunikativen und kognitiven Kompetenzen. Trotz technischer Barrieren stellt die Studie die Relevanz dieser Tools für die virtuelle Lehre heraus und bietet Ansatzpunkte für zukünftige Verbesserungen.

Kernaussagen


Technologie als Lernförderer:


Die Nutzung von Moodle und Zoom unterstützt den Aufbau von Lernfähigkeiten und digitaler Kompetenz (S. 344).




Moderate Korrelation:


Beide Plattformen zeigen moderate Korrelationen zu Lernfähigkeiten, wobei Zoom etwas stärker wirkt (S. 346).




Barrierefreiheit und Anpassung:


Flexibilität und Benutzerfreundlichkeit sind Schlüssel für die Akzeptanz (S. 348).





Argumentationslinien


Interaktive und kollaborative Elemente:


Moodle und Zoom fördern interaktive und kollaborative Lernumgebungen.




Technologieintegration als Schlüssel:


Der Artikel betont die Notwendigkeit von Schulungen, um technologische Barrieren zu überwinden.




Wissenschaftliche Fundierung:


Die Ergebnisse basieren auf robusten quantitativen Analysen.





Verschlagwortung


Technologieintegration:


Begründung: Fokus auf die Implementierung von Moodle und Zoom als zentrale Tools.




Lehr- und Lerneffektivität:


Begründung: Evaluation der Effizienz von Moodle und Zoom für die Förderung von Lernfähigkeiten.




Systemanpassung:


Begründung: Analyse der technischen und pädagogischen Anpassungen zur Förderung der Akzeptanz.





Kategorisierung
Kategorie: ArgumentationBegründung: Der Artikel argumentiert für die integrative Nutzung von Moodle und Zoom zur Förderung von Lernfähigkeiten und hebt Herausforderungen sowie Optimierungspotenziale hervor.

Zuordnung zur Forschungsunterfrage
Passendste Forschungsunterfrage:FU5:„Welche Möglichkeiten und Grenzen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems durch Akteure im digitalen Bildungsraum von Gesundheitsberufen analysiert?“
Begründung:Die Studie beleuchtet Möglichkeiten und Herausforderungen digitaler Tools und deren Einfluss auf Lernfähigkeiten, was direkt auf systemisch-konstruktivistische Ansätze übertragbar ist.

Relevanzbewertung


Relevanz: 5Die Arbeit liefert fundierte Erkenntnisse zur Wirkung digitaler Tools auf Lernprozesse und bietet wertvolle Hinweise für digitale Bildungssysteme.


},
	file = {Andrade-Arenas et al. - 2023 - Moodle platform and Zoom videoconference learning.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/HTWIJD73/Andrade-Arenas et al. - 2023 - Moodle platform and Zoom videoconference learning.pdf:application/pdf},
}

@article{lutz_hochschulische_2023,
	title = {Hochschulische {Qualifizierung} für die {Praxisanleitung} in der {Pflege}},
	volume = {10},
	abstract = {English The academization of nursing in Germany is progressing with the entry into force of the nursing professions act in 2020. The reform of nursing education and nursing studies requires, among other things, a reorientation of the qualification of teachers for nursing instruction in theory and practice. As a result, there are (further) developments in higher education qualification offerings. This includes the two-semester module Fachpraktische Anleitung in the study program Berufspädagogik Gesundheit at the University of Applied Sciences Fulda. It is presented in this paper with its blended learning conception as well as with results from two accompanying research projects.},
	language = {de-DE},
	number = {2},
	journal = {Pädagogik der Gesundheitsberufe},
	author = {Lutz, Nadine and Dorn, Tobias and Höhl, Roman Gabriel and Trumpa, Silke},
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Technologieintegration, Systemanpassung, Promotion:Argumentation, Promotion:FU5, Bildung, Multimedia, ⛔ No DOI found, \#8:Zeitschriftenartikel:blended:learning, Promotion:S:08 Blended Learning, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU5},
	pages = {90--100},
	annote = {Hier ist die Analyse der Arbeit „Hochschulische Qualifizierung für die Praxisanleitung in der Pflege: Vorstellung eines Seminarkonzeptes und begleitender Forschung“ von Nadine Lutz et al. (2023).
1. Hauptthemen und Ziele der Forschung
Die Arbeit beschreibt ein zweisemestriges Blended-Learning-Modul für angehende Pflegepädagog
im Studiengang „Berufspädagogik Gesundheit“ an der Hochschule Fulda. Ziel ist es, Studierende für die Rolle der Praxisanleitung in der Pflegepraxis zu qualifizieren. Das Seminarkonzept orientiert sich an gesetzlichen Vorgaben und soll theoretisches Wissen mit praxisorientierten Fähigkeiten verknüpfen, um eine fundierte Anleitung von Pflegeauszubildenden und -studierenden zu gewährleisten. Zusätzlich werden Ergebnisse aus begleitenden Forschungsprojekten vorgestellt, die den Lernprozess der Studierenden und die Wirksamkeit des Moduls untersuchen.

2. Methoden und Datenquellen
Die Arbeit basiert auf einer strukturierten Vorstellung des Moduls und dessen didaktischer und methodischer Rahmung durch Blended-Learning-Ansätze. Begleitend wird eine dialogische Evaluation durchgeführt, bei der Studierende Erfahrungen aus selbst erlebten Praxisanleitungen reflektieren. Methoden der qualitativen Inhaltsanalyse (nach Mayring) werden für die Dokumentenanalyse angewendet. Zudem wurden Interviews mit Studierenden über deren Qualifikationsprozess durchgeführt, um Herausforderungen und Orientierungen zu erfassen, die die Transformation zur Lehrperson in der Pflegepraxis beeinflussen.
3. Zentrale Forschungsergebnisse


Effektivität des Blended-Learning-Ansatzes: Die Kombination aus Präsenzveranstaltungen, Online-Übungen und praktischen Hospitationen fördert die Eigenverantwortung und Flexibilität der Studierenden.


Reflexive Praxis: Die systematische Reflexion eigener Praxiserfahrungen unterstützt den Erwerb von Anleitungskompetenzen und die Entwicklung eines professionellen Selbstverständnisses als Lehrperson.


Identifikation von Gelingensfaktoren: Studien zeigen, dass erfolgreiche Praxisanleitung von individueller Anleitungsgestaltung, regelmäßiger Reflexion und einer ausgewogenen Kombination aus theoretischen und praktischen Anteilen abhängt.


Rollentransformation und Perspektivwechsel: Die Qualifikation zur Praxisanleitung erfordert, dass Studierende ihre bisherigen Pflegeidentitäten hinterfragen und neue Rollen als Anleitende entwickeln. Dies wurde durch eine dialogische Evaluation und das gezielte Feedback im Seminar gefördert.


4. Zusammenfassung
Das Blended-Learning-Modul an der Hochschule Fulda ermöglicht eine praxisnahe und wissenschaftlich fundierte Qualifizierung für Praxisanleitende in der Pflege. Es verbindet theoretische Inhalte mit praxisnahen Übungen und der Reflexion persönlicher Praxiserfahrungen. Die begleitende Forschung zeigt, dass Studierende durch den Einsatz digitaler Medien und die dialogische Reflexion ihre pädagogischen Kompetenzen vertiefen und sich auf die berufliche Rolle als Lehrende vorbereiten können.
5. Kernaussagen


Bedeutung reflexiver Prozesse: Die Reflexion selbst erlebter Praxisanleitungen fördert das Verständnis für die Bedeutung von Anleitung und ihre Gelingensfaktoren (S. 95).


Notwendigkeit eines Perspektivwechsels: Der Übergang vom Pflegeberuf zur Rolle als Lehrperson erfordert eine bewusste Distanzierung und Neubewertung der eigenen Identität (S. 96).


Blended Learning zur Unterstützung des Kompetenzerwerbs: Der Einsatz von Online-Ressourcen und Präsenzübungen trägt zur Flexibilität und Praxisnähe der Ausbildung bei (S. 92).


6. Argumentationslinien
Die Autoren argumentieren, dass das Blended-Learning-Modul durch die Kombination von Theorie, Praxis und Reflexion eine umfassende Vorbereitung auf die komplexen Anforderungen in der Praxisanleitung bietet. Sie betonen, dass die dialogische Reflexion und die Auseinandersetzung mit Gelingensfaktoren eine zentrale Rolle spielen, um die soziale, personale und methodische Kompetenz der angehenden Praxisanleitenden zu fördern.
7. Verschlagwortung


Lehr- und Lerneffektivität: Effektivität der Qualifizierung durch eine strukturierte und praxisnahe Ausbildung.


Technologieintegration: Integration digitaler Medien zur Unterstützung der Flexibilität und des eigenständigen Lernens.


Systemanpassung: Anpassung der Pflegeausbildung an neue gesetzliche Anforderungen und die Rolle der akademischen Qualifizierung.


8. Kategorisierung
Argumentation: Die Arbeit legt dar, dass eine gezielte Kombination aus Präsenz- und Online-Lernen in der Pflegeausbildung notwendig ist, um den komplexen Anforderungen der Rolle als Praxisanleitende gerecht zu werden.
9. Zuordnung zu Forschungsfragen
Passendste Forschungsfrage: FU5 – Die Arbeit untersucht die Möglichkeiten und Grenzen eines Blended-Learning-Ansatzes zur Qualifizierung von Praxisanleitenden in der Pflege.
10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 – Die Arbeit liefert wertvolle Erkenntnisse zur Gestaltung und Evaluierung von Blended-Learning-Programmen in der Pflegeausbildung.


Gesamtbewertung: 4.8 – Die Untersuchung bietet fundierte Einblicke in die Qualifikationsanforderungen und die Bedeutung reflexiver Praxis für die Ausbildung von Pflegelehrkräften.


Falls eine tiefere Analyse oder spezifische Abschnitte gewünscht sind, stehe ich zur Verfügung.
},
	file = {Lutz et al. - Hochschulische Qualifizierung für die Praxisanleit.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/TK978CLT/Lutz et al. - Hochschulische Qualifizierung für die Praxisanleit.pdf:application/pdf},
}

@article{podwika_produktion_2022,
