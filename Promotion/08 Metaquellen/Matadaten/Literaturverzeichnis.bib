@article{ninaus_zwischen_2022,
	title = {Zwischen {Mensch} und {Maschine}: {Künstliche} {Intelligenz} zur {Förderung} von {Lernprozessen}},
	volume = {11},
	copyright = {https://creativecommons.org/licenses/by/4.0},
	issn = {2235-0977, 2235-0985},
	shorttitle = {Zwischen {Mensch} und {Maschine}},
	url = {https://econtent.hogrefe.com/doi/10.1024/2235-0977/a000386},
	doi = {10.1024/2235-0977/a000386},
	abstract = {Introduction: Since the recent digitalization offensive, the role and use of artificial intelligence (AI) and machine learning in the learning context has been the subject of discussion. These tools offer promising opportunities to better understand and subsequently optimize learning processes. The increase in data and metrics provided by new sensors and digital learning environments enables the use of AI and machine learning. Such methods are particularly promising, when human information processing is not able to efficiently process the complex and multimodal data just-in-time and draw necessary conclusions from it. Method: For the current article, a selective literature search was conducted in order to shed more light on the different steps in AI-supported learning systems. Discussion: Three central steps in the process of AI-supported learning can be identified: (i) data recording, (ii) pattern recognition, and (iii) adaptivity in digital learning environments. Humans play a crucial role in AI-supported learning systems that cannot be replaced by the “machine”, this role will be elaborated in the current article. In addition, further important aspects for the implementation of AI-supported learning systems such as the need for interdisciplinary collaboration, theory work, and closing of research gaps will be discussed.},
	language = {de-DE},
	number = {4},
	urldate = {2024-07-21},
	journal = {Lernen und Lernstörungen},
	author = {Ninaus, Manuel and Sailer, Michael},
	month = oct,
	year = {2022},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Promotion:Relevanz:4, Promotion:Weiterführung, Datenschutz und IT-Sicherheit, Promotion:FU4b, \#9:Zeitschriftenartikel:digital:lernen, Promotion:S:09 Digital Lernen, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {2235--0977/a000386},
	annote = {Analyse des Artikels „Zwischen Mensch und Maschine: Künstliche Intelligenz zur Förderung von Lernprozessen“ von Ninaus und Sailer (2022)
Hauptthemen und Ziele der Forschung
Der Artikel von Ninaus und Sailer (2022) untersucht die Rolle und den Einsatz von Künstlicher Intelligenz (KI) und Machine Learning (ML) zur Unterstützung und Optimierung von Lernprozessen. Ziel der Arbeit ist es, die verschiedenen Schritte und Anwendungen von KI-gestützten Lernsystemen zu beleuchten und die nicht substituierbare Rolle des Menschen in diesem Kontext zu betonen​​.
Methoden und Datenquellen


Methoden: Der Artikel basiert auf einer selektiven Literaturrecherche, die sich auf die Schritte der Datenaufzeichnung, Mustererkennung und Adaptivität konzentriert. Es werden Anwendungsszenarien beschrieben, die die Rolle des Menschen in KI-gestützten Systemen verdeutlichen​​.


Datenquellen: Die Daten stammen aus bestehenden Forschungsarbeiten und theoretischen Überlegungen zur Implementierung von KI und ML in digitalen Lernumgebungen​​.


Zentrale Forschungsergebnisse


Rolle der Künstlichen Intelligenz: KI bietet vielversprechende Möglichkeiten, Lernprozesse zu optimieren, indem sie die Erfassung und Analyse komplexer Daten unterstützt. KI-gestützte Systeme ermöglichen die Erkennung von Mustern in Lernprozessen und die Personalisierung von Lernumgebungen​​.


Mensch-Maschine-Interaktion: Trotz der fortschreitenden Automatisierung bleibt der Mensch ein entscheidender Faktor in KI-gestützten Lernsystemen. Entscheidungen über die Datenaufzeichnung, Mustererkennung und Adaptation erfordern menschliche Intervention und interdisziplinäre Zusammenarbeit​​.


Potenzial für adaptives Lernen: KI ermöglicht die Anpassung von Lernumgebungen an die individuellen Bedürfnisse der Lernenden, was zu verbesserten Lernergebnissen führen kann. Die Autoren betonen jedoch, dass ethische Überlegungen und Datenschutzaspekte berücksichtigt werden müssen​​.


Zusammenfassung
Der Artikel diskutiert die Integration von KI und ML in Bildungssystemen zur Unterstützung von Lernprozessen. Ninaus und Sailer heben hervor, dass KI die Effizienz und Effektivität von Lernprozessen durch Datenaufzeichnung und -analyse verbessern kann. Die Autoren betonen die notwendige Interaktion zwischen Mensch und Maschine und die Rolle des Menschen als entscheidenden Faktor in KI-gestützten Lernsystemen.
Kernaussagen


Künstliche Intelligenz in Bildungssystemen: KI-gestützte Systeme können Lernprozesse erheblich verbessern, indem sie Muster erkennen und personalisierte Lernumgebungen schaffen (S. 215)​​.


Menschliche Rolle: Der Mensch spielt eine entscheidende Rolle in der Implementierung und Nutzung von KI-Systemen, insbesondere bei der Entscheidungsfindung und der ethischen Bewertung (S. 219)​​.


Argumentationslinien
Die Autoren argumentieren, dass KI eine wertvolle Ressource zur Verbesserung von Bildungsprozessen darstellt, sofern sie verantwortungsvoll implementiert wird. Die Bedeutung der interdisziplinären Zusammenarbeit und der menschlichen Entscheidungsfindung wird hervorgehoben, um die Vorteile von KI in Bildungskontexten vollständig auszuschöpfen​​.
Verschlagwortung


Technologieintegration: Der Artikel behandelt die Integration von KI in Bildungssysteme und deren Auswirkungen auf Lernprozesse.


Lehr- und Lerneffektivität: Die Studie untersucht, wie KI die Effektivität von Lernprozessen durch Datenanalyse und Anpassung verbessern kann.


Datenschutz und IT-Sicherheit: Die Arbeit betont die Bedeutung von Datenschutz und ethischen Überlegungen bei der Implementierung von KI in Bildungssystemen.


Kategorisierung


Weiterführung: Der Artikel bietet neue Perspektiven zur Nutzung von KI in Bildungssystemen und regt zur Weiterentwicklung der Diskussion über Mensch-Maschine-Interaktion und ethische Aspekte an​​.


Zuordnung zu der passendsten Forschungsunterfrage


FU4b: Welche technisch-gestalterische Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?


Begründung: Die Studie untersucht die Rolle von KI in der Gestaltung und Anpassung von Lernsystemen, was direkt auf die technische und gestalterische Mechanismen von LMS anwendbar ist.




Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 4 (Der Artikel liefert relevante Einblicke in die Implementierung von KI zur Unterstützung von Lernprozessen).


Zitierhäufigkeit und Einfluss: 3 (Der Artikel ist relativ neu, und sein Einfluss entwickelt sich noch).


Aktualität: 5 (Der Artikel ist aktuell und behandelt ein wichtiges Thema in der Bildungstechnologie).


Gesamtbewertung: 4.0
Der Artikel von Ninaus und Sailer (2022) bietet wertvolle Einblicke in die Rolle von KI in Bildungssystemen und zeigt auf, wie diese Technologien Lernprozesse unterstützen und verbessern können, während sie gleichzeitig die Notwendigkeit einer verantwortungsvollen und ethisch fundierten Implementierung betonen.
},
	file = {Ninaus und Sailer - 2022 - Zwischen Mensch und Maschine Künstliche Intellige.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/6Q7AQUDA/Ninaus und Sailer - 2022 - Zwischen Mensch und Maschine Künstliche Intellige.pdf:application/pdf},
}

