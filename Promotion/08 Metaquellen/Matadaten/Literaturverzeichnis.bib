@article{munoz_effects_2024,
	title = {The {Effects} of {Blended} {Team}-{Based} {Learning} on the {Cross}-{Cultural} {Readiness} of {Tourism} and {Hospitality} {Students}: {A} {Mediation} {Study}},
	issn = {1096-3758, 2325-6540},
	shorttitle = {The {Effects} of {Blended} {Team}-{Based} {Learning} on the {Cross}-{Cultural} {Readiness} of {Tourism} and {Hospitality} {Students}},
	url = {https://www.tandfonline.com/doi/full/10.1080/10963758.2024.2436590},
	doi = {10.1080/10963758.2024.2436590},
	abstract = {Blended team-based learning (BTBL) has become a popular pedagogical method in tourism and hospitality (T\&H) education. However, its efficacy in developing industry competencies remains underexplored. This study addresses this gap by applying Social Learning Theory to examine how BTBL constructs perceived enjoyment, individual learning, team effectiveness, and knowledge-sharing influence cross-cultural readiness (CR). This study employed correlation and regression analyses using SPSS Process Model 81 on data from 272 T\&H university students enrolled in BTBL-based courses. This study provides novelty by confirming the relationship among the BTBL constructs and extending the model to determine the chain-mediation effects of BTBL in influencing CR. These imply that BTBL enhances learners’ competencies through social learning. As a pedagogical implication, this study recommends that T\&H educators develop CR and related industry skills by implementing BTBL activities, which provide learners exposure to “real-world” scenarios and autonomy to discuss collaboratively and make critical decisions as a team.},
	language = {en-GB},
	urldate = {2024-12-11},
	journal = {Journal of Hospitality \& Tourism Education},
	author = {Muñoz, Kyrie Eleison and Roma, Margie and Forbes, Medelene and Manlapaz, Christopher},
	month = dec,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Promotion:Relevanz:4, Promotion:FU5, \#8:Zeitschriftenartikel:blended:learning, Promotion:S:08 Blended Learning, Promotion:Literaturverzeichnis},
	pages = {1--11},
	annote = {Analyse des Artikels „The Effects of Blended Team-Based Learning on the Cross-Cultural Readiness of Tourism and Hospitality Students: A Mediation Study“ von Muñoz et al. (2024)

1. Hauptthemen und Ziele der Forschung
Der Artikel untersucht die Auswirkungen des Blended Team-Based Learning (BTBL) auf die cross-kulturelle Bereitschaft (Cross-Cultural Readiness, CR) von Studierenden im Bereich Tourismus und Hospitality. Ziel ist es, durch die Anwendung der Sozialen Lerntheorie (SLT) die Wirkungsmechanismen von BTBL zu analysieren und zu validieren, insbesondere in Bezug auf Kompetenzentwicklung und Teamdynamik.

2. Methoden und Datenquellen


Design:


Quantitative Studie basierend auf einem Mediationsmodell.


Datenerhebung mittels Online-Fragebogen mit 29 Items auf einer 5-Punkte-Likert-Skala.




Teilnehmer:


272 Bachelorstudierende der Tourismus- und Hospitality-Ausbildung, davon 73 \% weiblich.




Datenquellen und Analyse:


Einsatz von SPSS PROCESS Model 81 für Regressions- und Mediationsanalysen.


Dimensionen: Perceived Enjoyment (PE), Individual Learning (PI), Team Effectiveness (TE), Knowledge Sharing (KS) und Cross-Cultural Readiness (CR).





3. Zentrale Forschungsergebnisse


Zusammenhänge zwischen BTBL-Komponenten:


PE beeinflusst signifikant PI (β = 0.27, p {\textless} .001), TE (β = 0.16, p {\textless} .001) und KS (β = 0.76, p {\textless} .001).


KS hat wiederum einen positiven Effekt auf PI, TE und CR.




Kulturelle Kompetenzentwicklung:


CR wird durch alle BTBL-Komponenten beeinflusst, wobei KS als wichtiger Mediator zwischen PE und CR fungiert.




Kettenmediationseffekte:


Die Ergebnisse zeigen, dass PI, TE und KS zusammenwirken, um die Effekte von PE auf CR zu verstärken.




Praktische Implikationen:


Realitätsnahe BTBL-Aktivitäten, wie Fallstudien und Feldarbeit, fördern die cross-kulturelle Kompetenz und die Teamarbeit der Studierenden.





Zusammenfassung
Die Studie bestätigt, dass BTBL-Ansätze durch die Förderung von Teamarbeit, Wissensaustausch und individuellem Lernen die cross-kulturelle Bereitschaft der Studierenden im Bereich Tourismus und Hospitality signifikant steigern. Die Ergebnisse unterstreichen die Rolle von KS als Schlüsselfaktor für die Verbindung von intrinsischer Motivation (PE) und kulturellen Kompetenzen.

Kernaussagen


Bedeutung von Wissensaustausch:


KS fungiert als zentraler Mediator zwischen PE und CR (S. 5).




Kulturelle Kompetenzförderung:


Teamorientierte Aktivitäten bereiten Studierende besser auf multikulturelle Arbeitsumgebungen vor (S. 7).




Integration von SLT in BTBL:


Soziale Interaktionen fördern die Nachahmung und den Erwerb kultureller Verhaltensweisen (S. 6).





Argumentationslinien


Verknüpfung von PE und CR:


PE steigert die intrinsische Motivation der Studierenden, was zu einem höheren Engagement in Teamaktivitäten und zur Verbesserung von CR führt (S. 8).




Rolle sozialer Dynamiken:


Soziale Interaktionen fördern Wissensaustausch und Teamkohäsion, was die Kompetenzentwicklung stärkt (S. 9).




Praxisnähe und Realitätsbezug:


BTBL-Aktivitäten wie Feldstudien und Interviews mit Praktikern simulieren reale Arbeitsumgebungen und fördern Problemlösekompetenzen (S. 10).





Verschlagwortung


Kollaboratives Lernen:


Begründung: Der Artikel analysiert teamorientierte Lernprozesse im BTBL-Kontext.




Technologieintegration:


Begründung: Die Studie zeigt, wie digitale und analoge Komponenten in BTBL integriert werden.




Lehr- und Lerneffektivität:


Begründung: Fokus auf die Steigerung der Effektivität durch sozial-interaktive Ansätze.





