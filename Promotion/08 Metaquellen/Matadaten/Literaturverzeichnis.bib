	file = {Kustriyanti et al. - 2023 - The Implementation of Analytic Learning Through Mo.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/XBHLMADS/Kustriyanti et al. - 2023 - The Implementation of Analytic Learning Through Mo.pdf:application/pdf},
}

