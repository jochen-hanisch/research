}

@article{henriquez_impact_2024,
	title = {The impact of an academic counselling learning analytics tool: {Evidence} from 3 years of use},
	issn = {0007-1013, 1467-8535},
	shorttitle = {The impact of an academic counselling learning analytics tool},
	url = {https://bera-journals.onlinelibrary.wiley.com/doi/10.1111/bjet.13474},
	doi = {10.1111/bjet.13474},
	abstract = {Despite the importance of academic counselling for student success, providing timely and personalized guidance can be challenging for higher education institutions. In this study, we investigate the impact of counselling instances supported by a learning analytics (LA) tool, called TrAC, which provides specific data about the curriculum and grades of each student. To evaluate the tool, we measured changes in students' performance ranking position over 3 years and compared the performance of students who received counselling with and without the tool. Our results show that using the tool is related to an improvement in cohort ranking. We further investigated the characteristics of counselled students using cluster analyses. The findings highlight the potential beneficial influence on academic outcomes arising from the provision of guidance to students regarding their course load decisions via TrAC-­mediated counselling. This study contributes to the field of LA by providing evidence of the impact of counselling supported by an LA tool in a real-­world setting over a long period of time. Our results suggest that incorporating LA into academic counselling practices can improve student success.},
	language = {en-GB},
	urldate = {2024-05-01},
	journal = {British Journal of Educational Technology},
	author = {Henríquez, Valeria and Guerra, Julio and Scheihing, Eliana},
	month = apr,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Leraning:Analytics, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {bjet.13474},
	file = {Henríquez et al. - 2024 - The impact of an academic counselling learning ana.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/UFJMDZME/Henríquez et al. - 2024 - The impact of an academic counselling learning ana.pdf:application/pdf},
}

@article{kerman_online_2024,
	title = {Online peer feedback in higher education: {A} synthesis of the literature},
	volume = {29},
	issn = {1360-2357, 1573-7608},
	shorttitle = {Online peer feedback in higher education},
	url = {https://link.springer.com/10.1007/s10639-023-12273-8},
	doi = {10.1007/s10639-023-12273-8},
	abstract = {Online peer feedback is an effective instructional strategy to enhance students’ learning processes and outcomes. However, the literature lacks a comprehensive understanding of the influential factors that play a key role in the effective implementation of online peer feedback. This systematic review provides an overview of the current state of online peer feedback implementation in higher education contexts and explores the role of students’ characteristics and online learning environments in relation to their learning processes and outcomes. To achieve this goal, the PRISMA method was followed, and a coding scheme was developed to create a framework that can guide the implementation of online peer feedback in higher education settings. This framework depicts factors that should be taken into account for effective implementation of online peer feedback in terms of four dimensions: students’ characteristics (demographic characteristics, academic background, and personality and psychological features), environmental conditions (learning platform and setting), learning processes (content, feedback activity design, and technology), and learning outcomes including cognitive outcomes (e.g., acquisition of knowledge, comprehension, application, analysis, synthesis, and evaluation), behavioral outcomes (engagement, communication, and teamwork), and affective outcomes (satisfaction, motivation, attitude, self-efficacy, sense of autonomy, and confidence). We conclude this study by discussing the framework, limitations, and ideas for future research and practice.},
	language = {en-GB},
	number = {1},
	urldate = {2024-01-10},
	journal = {Education and Information Technologies},
	author = {Kerman, Nafiseh Taghizadeh and Banihashem, Seyyed Kazem and Karami, Mortaza and Er, Erkan and Van Ginkel, Stan and Noroozi, Omid},
	month = jan,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Bewertungsmethoden, Promotion:FU2a, Promotion:Relevanz:4, Promotion:01-02, 4.3.1 Literaturanalyse und KI-gestützte Methoden, Promotion:04-04:4.4.4, Promotion:01-02 Methodenquellen, Promotion:S:11 Online Learning, Promotion:4.4.4 Dreidimenionale Clusteranalyse, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU2a, Promotion:sec:P-QIA, Promotion:chap:04-04},
	pages = {763--813},
	annote = {Analyse der Studie „Online Peer Feedback in Higher Education: A Synthesis“ von Kerman et al. (2024)
1. Hauptthemen und Ziele der Forschung
Die Studie von Kerman et al. (2024) ist eine systematische Übersichtsarbeit, die sich mit Online-Peer-Feedback in der Hochschulbildung befasst. Sie synthetisiert die aktuelle Forschung zur Thematik, indem sie empirische Studien analysiert, die zwischen 2000 und 2023 veröffentlicht wurden. Das Hauptziel der Arbeit ist es, die Faktoren zu identifizieren, die die Wirksamkeit von Online-Peer-Feedback beeinflussen, sowie die Auswirkungen auf Lernprozesse und Lernergebnisse zu evaluieren​Kerman et al. - 2024 - ….
2. Methoden und Datenquellen
Methoden:


Systematische Literaturrecherche: Die Autoren analysieren 83 empirische Studien, die in Fachzeitschriften veröffentlicht wurden.


Einschlusskriterien: Nur peer-reviewed Artikel, empirische Studien mit Interventionsdesign und Publikationen im Kontext der Hochschulbildung wurden einbezogen​Kerman et al. - 2024 - ….


Kategorisierung nach dem Biggs-Modell (2003):


Studierendenmerkmale (z. B. demografische Faktoren, Vorwissen, Selbstwirksamkeit).


Lernumgebungen (z. B. genutzte Plattformen wie Moodle, Blackboard, Wiki).


Lernprozesse (z. B. Feedback-Formate, Anzahl der Feedback-Runden, Anonymität).


Lernresultate (z. B. kognitive, affektive und verhaltensbezogene Ergebnisse)​Kerman et al. - 2024 - ….




Datenanalyse mittels ATLAS.ti 9: Die kodierten Daten wurden mithilfe einer deduktiven inhaltsanalytischen Vorgehensweise analysiert. Die Interrater-Reliabilität (Kappa = 0,84) zeigt eine hohe Übereinstimmung zwischen den Kodierern​Kerman et al. - 2024 - ….


Datenquellen:


Datenbanken: Web of Science und Scopus (insgesamt 2.221 identifizierte Studien, nach Ausschluss verbleiben 83 Artikel).


Thematische Schwerpunkte der Studien:


25 \% der Studien stammen aus der Bildungswissenschaft.


59 \% der Studien nutzen experimentelle Designs, 30 \% quasi-experimentelle Designs.


Genutzte Plattformen: Moodle, Blackboard, Wiki, Brightspace, mobile Apps​Kerman et al. - 2024 - ….




3. Zentrale Forschungsergebnisse


Faktoren für effektives Online-Peer-Feedback


Studierendenmerkmale (z. B. Selbstwirksamkeit, Feedback-Erfahrung) beeinflussen die Qualität des Feedbacks.


Anonymes Feedback wird positiver bewertet als identifiziertes Feedback.


Mehrere Feedback-Runden steigern die Reflexion und Schreibkompetenz der Studierenden​Kerman et al. - 2024 - ….




Lernresultate


Kognitive Ergebnisse: Verbesserte Schreib- und Argumentationsfähigkeiten durch strukturierte Peer-Feedback-Prozesse.


Affektive Ergebnisse: Höhere Zufriedenheit und Motivation bei Studierenden mit positiven Feedback-Erfahrungen.


Verhaltensbezogene Ergebnisse: Erhöhte Partizipation und verbesserte Kommunikationsfähigkeiten durch kollaboratives Lernen​Kerman et al. - 2024 - ….




Einfluss der Plattformen und Feedback-Methoden


Video-Feedback steigert die Verständlichkeit von Rückmeldungen.


Kombination aus quantitativen Ratings und qualitativen Kommentaren führt zu besseren Lernergebnissen.


Gamifizierte Peer-Feedback-Ansätze fördern das Engagement​Kerman et al. - 2024 - ….




4. Zusammenfassung
Die systematische Analyse zeigt, dass Online-Peer-Feedback eine effektive Methode zur Verbesserung akademischer Leistungen und sozialer Lernprozesse in der Hochschulbildung ist. Die Studie hebt hervor, dass Anonymität, Mehrfach-Runden und eine klare Strukturierung der Feedback-Prozesse wesentliche Erfolgsfaktoren sind. Darüber hinaus spielt die Wahl der Plattform eine zentrale Rolle für die Qualität und Effektivität des Feedbacks​Kerman et al. - 2024 - ….
5. Kernaussagen


Anonymität im Peer-Feedback steigert die Ehrlichkeit und Akzeptanz der Rückmeldungen (S. 771)​Kerman et al. - 2024 - ….


Technologische Unterstützung durch Video-Feedback oder KI-gestütztes Feedback verbessert die Qualität der Rückmeldungen (S. 783)​Kerman et al. - 2024 - ….


Kombination von quantitativen Ratings und qualitativen Kommentaren führt zu besseren Lernergebnissen(S. 795)​Kerman et al. - 2024 - ….


Strukturiertes Peer-Feedback mit mehreren Runden fördert Reflexion und kritisches Denken (S. 792)​Kerman et al. - 2024 - ….


6. Argumentationslinien
Die Autoren argumentieren, dass die Effektivität von Online-Peer-Feedback stark von der Gestaltung der Feedback-Prozesse abhängt. Besonders wichtig sind:


Die richtige Balance zwischen Anonymität und Identifizierbarkeit.


Der Einsatz innovativer Technologien zur Verbesserung des Feedbacks.


Die Implementierung von strukturierten Feedback-Runden zur Förderung kognitiver und affektiver Lernprozesse​Kerman et al. - 2024 - ….


7. Verschlagwortung


Kollaboratives Lernen: Die Studie analysiert die Effekte von Peer-Feedback als kollaborativen Lernprozess​Kerman et al. - 2024 - ….


Lehr- und Lerneffektivität: Evaluation der Wirksamkeit verschiedener Feedback-Methoden im digitalen Bildungsbereich​Kerman et al. - 2024 - ….


Technologieintegration: Untersuchung des Einflusses digitaler Plattformen wie Moodle, Blackboard und Wiki auf den Feedback-Prozess​Kerman et al. - 2024 - ….


Bewertungsmethoden: Analyse quantitativer und qualitativer Feedback-Formate zur Messung des Lernerfolgs​Kerman et al. - 2024 - ….


8. Kategorisierung
KerngedankeDie zentrale Hypothese der Studie ist, dass Online-Peer-Feedback nicht nur als Bewertungsinstrument, sondern als integrativer Bestandteil des Lernprozesses zu betrachten ist, da es kognitive, affektive und soziale Kompetenzen der Studierenden nachhaltig beeinflusst​Kerman et al. - 2024 - ….
9. Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU2a: Welchen Effekt erläutern Lernende im digitalen Bildungsraum von Gesundheitsberufen bei der Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems?


Begründung: Die Studie untersucht, wie Studierende Online-Peer-Feedback wahrnehmen und welche Effekte es auf ihre Lernprozesse und Leistungen hat​Kerman et al. - 2024 - ….


10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 4 (Die Studie liefert wichtige Erkenntnisse über digitale Feedback-Prozesse in der Hochschulbildung, allerdings mit allgemeinem Fokus und nicht speziell auf Gesundheitsberufe).


Zitierhäufigkeit und Einfluss: 4 (Das Thema ist hochaktuell, und die systematische Synthese umfasst eine Vielzahl relevanter Studien).


Aktualität: 5 (Veröffentlichung 2024, daher maximal relevant für gegenwärtige Diskussionen).


Gesamtbewertung: 4
11. Schlussfolgerung
Die Studie von Kerman et al. (2024) zeigt, dass Online-Peer-Feedback eine wirkungsvolle Methode zur Förderung von Lernprozessen in der Hochschulbildung ist. Die Ergebnisse betonen die Notwendigkeit klarer Strukturierung, technologischer Unterstützung und wiederholter Feedback-Runden, um die Lernwirksamkeit zu maximieren​Kerman et al. - 2024 - ….
},
	annote = {Analysebericht zur Clustervalidierung der Kodierung in Kerman et al. (2024)
1. Einleitung
Die vorliegende Analyse untersucht die methodische Konsistenz der in Kerman et al. (2024) verwendeten Kodierung durch eine statistische Clustervalidierung. Ziel ist es, die Trennschärfe der vier theoretischen Kategorien (basierend auf Biggs‘ Modell 2003) zu prüfen und mögliche methodische Unschärfen aufzudecken. Die Untersuchung basiert auf den numerischen Daten aus den Tabellen 2–9 des Artikels.
2. Methodik
2.1 Datengrundlage
Die Grundlage der Analyse bilden die aus den Tabellen extrahierten kodierten Daten. Folgende Dimensionen wurden berücksichtigt:


Studentencharakteristika (z. B. Motivation, epistemische Überzeugungen)


Lernumgebung (z. B. Plattformtyp, technologische Unterstützung)


Lernprozesse (z. B. Feedback-Typ, Anonymität, Anzahl der Runden)


Lernergebnisse (z. B. kognitive, affektive, behaviorale Outcomes)


Interventionstyp (Tabelle 5)


Plattformtyp (Tabelle 7)


Feedback-Strategie (Tabelle 9)


Die Daten wurden aus den kodierten Tabellenwerten umgewandelt und als numerische Variablen erfasst.
2.2 Durchführung der Clusteranalyse
Die Clusteranalyse wurde mit K-Means-Clustering durchgeführt. Die optimale Clusteranzahl wurde mithilfe des Silhouette-Scores bestimmt, indem verschiedene Clustergrößen (k = 2 bis 6) getestet wurden. Die Visualisierung der Cluster erfolgte mit PCA (Principal Component Analysis) zur Reduktion der Dimensionalität auf zwei Achsen.
3. Ergebnisse der Clustervalidierung
3.1 Optimale Clusteranzahl
Die beste Clusteranzahl wurde bei k = 3 Clustern erreicht. Dies wurde durch den höchsten Silhouette-Score bestätigt.
3.2 Silhouette-Score
Der berechnete Silhouette-Score betrug 0.22, was eine sehr geringe Clustertrennschärfe anzeigt. Dies bedeutet, dass die Cluster stark überlappen und die vier Kategorien methodisch nicht sauber getrennt sind.
3.3 Visualisierung der Cluster
Abbildung 1: PCA-Visualisierung der Clusterstruktur zeigt eine signifikante Überlappung der Cluster.
(Hier die PCA-Scatterplot-Grafik einfügen)
3.4 Clusterverteilung
Visualisierung der Clusterung basierend auf der durchgeführten K-Means-Analyse. Die Punkte repräsentieren Studien, die anhand der vier Hauptdimensionen (Studentencharakteristika, Lernumgebung, Lernprozesse, Lernergebnisse) gruppiert wurden. Die Farbgebung zeigt die verschiedenen Cluster, wobei deutliche Überlappungen zwischen den Clustern zu erkennen sind.

