@article{tibbe_medienunterstutztes_2023,
	title = {Medienunterstütztes {Lernen} in der inklusiven beruflichen {Bildung} für {Auszubildende} mit {Beeinträchtigungen}: {Ein} 10-{Stufen}-{Modell} zur {Einführung} von {Lernplattformen} in der teilhabeorientierten beruflichen {Bildung}},
	issn = {1424-3636},
	shorttitle = {Medienunterstütztes {Lernen} in der inklusiven beruflichen {Bildung} für {Auszubildende} mit {Beeinträchtigungen}},
	url = {https://www.medienpaed.com/article/view/1728},
	doi = {10/gsr7pf},
	abstract = {The Berufsbildungswerk Bethel (BBW) would like to introduce the MoodleWorkplace learning platform in order to anchor digitally supported learning in vocational training. For the management of the BBW, this means that technical, personal and conceptual prerequisites must be created. In order to support the instructors during the launch, conceptual indications will be formulated based on the content-analytical evaluation of qualitative interviews with the instructors. The study examines the question of how Moodle-Workplace can be implemented in vocational training at BBW Bethel – and, in the future, in other institutions of inclusive vocational education – in a meaningful and target group-oriented way. The results show that a structured launch is necessary for both the participants and the instructors, as there is a great deal of uncertainty about the launch and its use. The 10-step-model, which was developed by the authors, offers an orientation framework to implement learning platforms progressively and successively in inclusive vocational education. It serves as an example to illustrate a step-by-step approach, which first focuses on the training of the trainers and then on the participants.},
	language = {de-DE},
	urldate = {2023-09-19},
	journal = {MedienPädagogik: Zeitschrift für Theorie und Praxis der Medienbildung},
	author = {Tibbe, Tim and Kamin, Anna-Maria},
	month = sep,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Systemanpassung, Bildungstheorien, \#1:Zeitschriftenartikel:learning:management:system, Bildung, Multimedia, Lernsystemarchitektur, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {439--460},
	annote = {1. Analyse
Der Artikel von Tibbe und Kamin (2023) beschäftigt sich mit der Einführung von medienunterstütztem Lernen in der inklusiven beruflichen Bildung für Auszubildende mit Beeinträchtigungen, wobei ein spezielles 10-Stufen-Modell zur Implementierung von Lernplattformen präsentiert wird. Dieses Modell zielt darauf ab, sowohl technische als auch pädagogische Aspekte zu integrieren, um eine erfolgreiche Anwendung in einer inklusiven Lernumgebung zu gewährleisten.
2. Zusammenfassung
Der Artikel legt dar, wie das Berufsbildungswerk Bethel plant, die Lernplattform Moodle-Workplace einzuführen, um digital unterstütztes Lernen zu fördern. Durch die Implementierung eines spezifischen 10-Stufen-Modells wird versucht, den speziellen Anforderungen von Auszubildenden mit Beeinträchtigungen gerecht zu werden. Das Modell betont eine schrittweise Einführung, beginnend mit der Schulung der Ausbildenden, gefolgt von der progressiven Einführung für die Auszubildenden.
3. Kernaussagen


Einführung eines 10-Stufen-Modells: Das Modell bietet einen strukturierten Ansatz zur Implementierung von Lernplattformen, der sowohl Ausbildende als auch Auszubildende schrittweise an die Nutzung heranführt (S. 440-442).


Berücksichtigung von Unsicherheiten und Bedürfnissen: Es besteht eine große Unsicherheit bezüglich der Einführung und Nutzung der Technologie, insbesondere bei den Ausbildenden, die eine klare und anhaltende Unterstützung benötigen (S. 442-443).


Zielgruppenspezifische Anpassung: Das Modell nimmt Rücksicht auf die individuellen Bedürfnisse der Auszubildenden mit Beeinträchtigungen, um eine inklusive und barrierefreie Lernumgebung zu schaffen (S. 443-444).


4. Argumentationslinien


Bedeutung der Ausbilder-Schulung: Der Erfolg der Implementierung hängt stark von der vorbereitenden Schulung der Ausbildenden ab, die als Multiplikatoren für die erfolgreiche Adaption und Nutzung der Technologie durch die Auszubildenden fungieren (S. 442-443).


Inklusive Bildung und Technologieintegration: Der Artikel argumentiert, dass die Integration von Technologie in inklusiven Bildungseinrichtungen eine detaillierte Planung und Anpassung an spezifische Lernbedürfnisse erfordert, um effektiv zu sein (S. 444-446).


5. Verschlagwortung


Lernsystemarchitektur: Das 10-Stufen-Modell illustriert eine detaillierte Architektur für die Einführung von Lernplattformen in einer inklusiven Bildungsumgebung.


Bildungstheorien: Der Artikel betont die Anwendung konstruktivistischer und inklusiver Bildungstheorien in der Gestaltung des Lernmodells.


Lehr- und Lerneffektivität: Die schrittweise Einführung und fortlaufende Unterstützung zielen darauf ab, die Effektivität des Lehr- und Lernprozesses zu maximieren.


Technologieintegration: Die Implementierung von Moodle-Workplace zeigt die praktische Anwendung von Technologie in Bildungseinrichtungen.


Systemanpassung: Das Modell passt das Lernsystem an die spezifischen Bedürfnisse und Fähigkeiten von Menschen mit Beeinträchtigungen an.


},
	file = {Tibbe und Kamin - 2023 - Medienunterstütztes Lernen in der inklusiven beruf.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/2JF4WNWN/Tibbe und Kamin - 2023 - Medienunterstütztes Lernen in der inklusiven beruf.pdf:application/pdf},
}

@article{setiadi_e-character_2023,
	title = {E-{Character} {Education} among {Online} {Learning}: {Focusing} on {Performance}, {Collaborative}, and {Spiritual} {Character}},
	volume = {10},
	issn = {2410-1869},
	shorttitle = {E-{Character} {Education} among {Online} {Learning}},
	url = {https://cosmosscholars.com/phms/index.php/ijmst/article/view/1529},
	doi = {10/gskbj3},
	abstract = {Abstracts: Character development is one of the goals of the teaching and learning process. On the other side, teachers are still looking for an effective way to instill good character in the students through online learning. According to the survey, this research focuses on the students' characters of individual performance, collaborative and spiritual character. The transition from conventional to e-learning because of the Covid-19 pandemic significantly affects the readiness of lecturers and students to get involved in learning activities, which affects the development of the students' characters. This is a mixed method case study, conducted in seven university. Seven hundred forty-six students of public and private higher educations in Indonesia were investigated in this research. Data collected through observation, field journals and interviews. Data were analyzed through quantitatively and qualitatively. The result showed that the students' performance and collaboration characteristics were not as good as their spiritual character. The students did assignments without paying too much attention to the quality of the content. The students tended to finish the assignments independently, they were rarely involved in the discussion, felt the changing of the academic climate because of the difficulties in accessing the platform to fulfill the needs of remote interaction among the students. The lecturers' readiness was unfamiliar with the teaching platform, and they needed time for converting teaching material into digital form and gave them many assignments.},
	language = {en-GB},
	number = {3},
	urldate = {2023-07-25},
	journal = {International Journal of Membrane Science and Technology},
	author = {Setiadi, Samsi and Zulharby, Puti and Fahmi, Ari Khairurrijal and Pratama, Aditya},
	month = jul,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Systemanpassung, Datenschutz und IT-Sicherheit, Bildung, Multimedia, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {284--297},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:Die Studie von Setiadi et al. (2023) analysiert die Entwicklung von Charaktereigenschaften im E-Learning, insbesondere im Hinblick auf Leistungs-, Kollaborations- und spirituellen Charakter. Sie betrachten den Einfluss des Online-Lernens auf diese Charakterdimensionen und die Bereitschaft der Dozenten, solche Bildungsmodelle zu unterstützen.
Verwendete Methoden und Datenquellen:Es handelt sich um eine Fallstudie, die mittels einer Kombination aus Beobachtungen, Feldnotizen und Interviews durchgeführt wurde. Teilnehmer waren 746 Studierende aus öffentlichen und privaten Hochschulen in Indonesien.
Zentrale Forschungsergebnisse:Die Ergebnisse zeigen, dass die Bereitschaft der Dozenten und die technologische Infrastruktur wesentliche Faktoren für die erfolgreiche Implementierung von Charakterbildung im Online-Format sind. Es gab Herausforderungen, insbesondere bei der Förderung des Kollaborationscharakters und des spirituellen Charakters, die in traditionellen Lernumgebungen stärker unterstützt werden.
Zusammenfassung
Die Studie unterstreicht die Bedeutung von Charakterbildung im Online-Lernen und hebt hervor, dass technologische, pädagogische und infrastrukturelle Anpassungen notwendig sind, um Charaktereigenschaften effektiv zu entwickeln. Es wird betont, dass die Qualität der Charakterbildung im E-Learning stark von der Lehrbereitschaft und den verfügbaren Technologien abhängt.
Kernaussagen


"Die Dozentenbereitschaft und technologische Unterstützung sind entscheidend für die Entwicklung von Charaktereigenschaften im E-Learning." (S. 290)


"Kollaborations- und spiritueller Charakter sind im Online-Format schwieriger zu fördern als in physischen Lernumgebungen." (S. 293)


Argumentationslinien


Die Studie stellt dar, wie wichtig die Integration von Technologie in Lehrpläne ist, um Charakterbildung zu unterstützen.


Es wird die Notwendigkeit einer angepassten pädagogischen Herangehensweise betont, um die spezifischen Herausforderungen des Online-Lernens zu adressieren.


Verschlagwortung


Lehr- und Lerneffektivität: Die Forschung betont, wie kritisch die effektive Umsetzung von E-Learning-Strategien für die Charakterbildung ist.


Technologieintegration: Die Integration von adäquaten technologischen Tools und Plattformen ist für den Erfolg von Charakterbildung im Online-Lernen entscheidend.


Kollaboratives Lernen: Die Studie zeigt, dass die Förderung von Kollaborationsfähigkeiten im Online-Format spezielle pädagogische Ansätze erfordert.


Forschungsansätze: Der methodische Ansatz kombiniert qualitative und quantitative Forschung, um die Entwicklung von Charaktereigenschaften zu verstehen.


Systemanpassung: Es wird die Notwendigkeit der Anpassung von Bildungssystemen an die Anforderungen des digitalen Lernens hervorgehoben.


Datenschutz und IT-Sicherheit: Die sichere Handhabung von persönlichen und akademischen Daten in E-Learning-Umgebungen wird als kritisch betrachtet.


Kategorie: Kerngedanke
Diese Studie konzentriert sich auf fundamentale Aspekte der Charakterbildung im Online-Lernen und beleuchtet tiefgreifende intrapersonale Prozesse, die für das Bildungsziel essentiell sind. Die Untersuchung der Charakterentwicklung in digitalen Lernumgebungen reflektiert Kernaspekte der pädagogischen Praxis und ihrer Auswirkungen auf die individuelle Entwicklung.
},
	file = {Setiadi et al. - 2023 - E-Character Education among Online Learning Focus.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/U4WZ97PA/Setiadi et al. - 2023 - E-Character Education among Online Learning Focus.pdf:application/pdf},
}

@article{johannsen_hno-wissen_2023,
	title = {{HNO}-{Wissen} bei {HNO}-Ärzten: {Eine} {Analyse} der {Quizfragen} in der {HNO}-{App}},
	issn = {0935-8943, 1438-8685},
	shorttitle = {{HNO}-{Wissen} bei {HNO}-Ärzten},
	url = {http://www.thieme-connect.de/DOI/DOI?10.1055/a-2036-7843},
	doi = {10/gr2xdv},
	abstract = {Background The ORL-App, a smartphone app for further education and training for ORL doctors and those interested in ORL, complements existing offers in medical education and training. The principle of game-based e-learning can open up new perspectives in times of digitalisation and pandemic. The heart of the app is a large ORL quiz, in which app users compete against each other. This paper analyses the performance of app users in the quiz module, taking into account the questions’ categories and the usersʼ level of education.},
	language = {de-DE},
	urldate = {2023-04-01},
	journal = {Laryngo-Rhino-Otologie},
	author = {Johannsen, Jannik and Shabli, Sami and Klußmann, Jens Peter and Guntinas-Lichius, Orlando and Lüers, Jan-Christoffer},
	month = mar,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, Bildung, Multimedia, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {a--2036--7843},
	annote = {1. Analyse
Hauptthemen und -ziele der Forschung: Die Studie von Johannsen et al. untersucht, wie die Nutzung einer speziell entwickelten HNO-Quiz-App das Wissen von HNO-Ärzten beeinflusst. Der Fokus liegt auf der Analyse der Leistung verschiedener Arztgruppen basierend auf ihrem Ausbildungsstand und der Beantwortung von Quizfragen in verschiedenen Kategorien.
Verwendete Methoden und Datenquellen: Die Studie verwendet eine retrospektive Analyse der Quizdaten der App über 24 Monate. Insgesamt 3.593 Fragen in 16 Kategorien wurden ausgewertet, wobei die Nutzer in unterschiedliche Ausbildungsstufen eingeteilt wurden: Ärzte in Weiterbildung, Fachärzte, Oberärzte, Chefärzte und Ordinaria, sowie Studierende und Nichtmediziner.
Zentrale Forschungsergebnisse: Ärzte in Weiterbildung stellten die aktivste Nutzergruppe dar und zeigten überdurchschnittliche Leistungen. Fachärzte und weiter fortgeschrittene Mediziner hatten ebenfalls hohe Erfolgsquoten, wobei interessanterweise die Gruppe der Ärzte in Weiterbildung bessere Ergebnisse erzielte als Fachärzte. Die Analyse ergab auch, dass bestimmte Fachkategorien, wie z.B. "Schlafmedizin", höhere Erfolgsraten aufwiesen, während andere, wie "Innenohr \& Schädelbasis", schwieriger waren.
2. Zusammenfassung
Die Untersuchung von Johannsen et al. zeigt, dass die HNO-Quiz-App eine effektive Methode zur Steigerung des fachspezifischen Wissens unter HNO-Ärzten darstellt. Sie betont die Bedeutung von spielbasiertem Lernen in der medizinischen Weiterbildung und liefert Einblicke in die Wirksamkeit von E-Learning-Tools in der medizinischen Fachausbildung.
3. Kernaussagen


"Ärzte in Weiterbildung nutzen die HNO-App intensiver und erzielen höhere Erfolgsraten im Quiz als Fachärzte." (S. 10)


"Bestimmte Kategorien wie Schlafmedizin und Allergologie zeigen höhere Erfolgsquoten, was auf eine effektivere Vermittlung oder größeres Interesse in diesen Bereichen hindeuten könnte." (S. 12)


"Die Nutzung der App zeigt signifikante Unterschiede im Wissensstand basierend auf dem Ausbildungsgrad der Nutzer, wobei erfahrene Ärzte besser abschneiden als Studierende." (S. 14)


4. Argumentationslinien
Die Argumentation der Studie stützt sich darauf, dass interaktive und gamifizierte Lernansätze, wie die HNO-Quiz-App, das Engagement und den Lernerfolg bei HNO-Ärzten signifikant steigern können. Sie illustriert, dass E-Learning nicht nur für junge Mediziner attraktiv ist, sondern auch für etablierte Fachärzte wertvoll sein kann, insbesondere in Zeiten von Digitalisierung und pandemiebedingten Einschränkungen.
5. Verschlagwortung


Lehr- und Lerneffektivität: Die Studie hebt die Effektivität der Quiz-App in der Verbesserung der medizinischen Kompetenz, insbesondere bei Ärzten in Weiterbildung, hervor.


Technologieintegration: Die erfolgreiche Integration von E-Learning-Tools in die medizinische Weiterbildung wird durch die breite Nutzung der App unterstrichen.


Kollaboratives Lernen: Die Wettbewerbsfunktion der App fördert nicht nur individuelles Lernen, sondern auch den Austausch und Vergleich zwischen Kollegen.


Forschungsansätze: Die Anwendung von datengetriebenen Analysen zur Bewertung der Lerneffekte innerhalb verschiedener medizinischer Subdisziplinen zeigt innovative Forschungsansätze im Bereich der medizinischen Bildung.


Systemanpassung: Die Studie zeigt, wie medizinische Ausbildungsprogramme durch die Integration von Technologie adaptiert und verbessert werden können, um den Bedürfnissen einer sich schnell entwickelnden Bildungslandschaft gerecht zu werden.


},
	file = {Johannsen et al. - 2023 - HNO-Wissen bei HNO-Ärzten Eine Analyse der Quizfr.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/4N3WMD2J/Johannsen et al. - 2023 - HNO-Wissen bei HNO-Ärzten Eine Analyse der Quizfr.pdf:application/pdf},
}

@article{breuer_fur_2017,
	title = {Für die {Facharztweiterbildung} {Lernen} lernen},
	volume = {66},
	issn = {0003-2417, 1432-055X},
	url = {http://link.springer.com/10.1007/s00101-017-0278-4},
	doi = {10/gg5cr7},
	abstract = {The world of medicine is becoming from year to year more complex. This necessitates eﬃcient learning processes, which incorporate the principles of adult education but with unchanged periods of further education. The subject matter must be processed, organized, visualized, networked and comprehended. The learning process should be voluntary and self-driven with the aim of learning the profession and becoming an expert in a specialist ﬁeld. Learning is an individual process. Despite this, the constantly cited learning styles are nowadays more controversial. An important factor is a healthy mixture of blended learning methods, which also use new technical possibilities. These include a multitude of e-learning options and simulations, which partly enable situative learning in a “shielded” environment. An exemplary role model of the teacher and feedback for the person in training also remain core and sustainable aspects in medical further education.},
	language = {de-DE},
	number = {2},
	urldate = {2020-07-31},
	journal = {Der Anaesthesist},
	author = {Breuer, G. and Lütcke, B. and St. Pierre, M. and Hüttl, S.},
	month = feb,
	year = {2017},
	keywords = {Simulation, Promotion:Literaturanalyse, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Systemanpassung, Bildung, Multimedia, Digitale Bildung, Curriculum, Medizin, FernUni-Hagen:MABM:M2, Promotion:FH, \#5:Zeitschriftenartikel:e-learning, Computer-Assisted Instruction, Memory, Promotion:S:05 E-Learning, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {137--150},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:
Die Studie von Breuer et al. (2017) untersucht die Anwendung von Prinzipien der Erwachsenenbildung in der Facharztweiterbildung für Anästhesisten. Ziel ist es, Lernstrategien und -methoden zu identifizieren und zu bewerten, die die Effizienz und Effektivität des Lernprozesses unter den Bedingungen zunehmender Komplexität und gleichbleibender Weiterbildungszeiten verbessern.
Verwendete Methoden und Datenquellen:
	•	Design: Deskriptive Studie und Evaluationsforschung
	•	Datenquellen: Literaturrecherche, Analyse bestehender Weiterbildungsprogramme, Umfragen und Rückmeldungen von Facharztanwärtern
	•	Evaluationsmethoden: Fragebögen, qualitative und quantitative Analyse der Rückmeldungen, Vergleich von Lernmethoden und deren Auswirkungen auf den Lernerfolg
Zentrale Forschungsergebnisse:
	•	Erwachsenenbildung: Effektives Lernen bei Erwachsenen sollte freiwillig und selbstgesteuert sein. Die Lernenden sollen aktiv ihre Lernbedarfe identifizieren, Ziele setzen und ihren Fortschritt evaluieren.
	•	Blended Learning: Die Kombination von Präsenz- und E-Learning-Formaten zeigt sich als besonders effektiv, da sie die Vorteile beider Ansätze vereint und situatives Lernen ermöglicht.
	•	Feedback und Mentoring: Regelmäßiges und konstruktives Feedback sowie Mentoring sind essenziell für den Lernfortschritt und die Entwicklung der Facharztanwärter.
	•	Simulationen und praktische Übungen: Der Einsatz von Simulationen und praktischen Übungen im geschützten Umfeld fördert die Anwendung des Gelernten und erhöht die Patientensicherheit.
Zusammenfassung
Die Studie zeigt, dass die Integration von Prinzipien der Erwachsenenbildung, Blended Learning, Feedback, Mentoring und Simulationen in die Facharztweiterbildung für Anästhesisten zu effektiveren Lernprozessen führt. Die Kombination dieser Methoden ermöglicht es, die steigenden Anforderungen und die zunehmende Komplexität in der medizinischen Ausbildung zu bewältigen.
Kernaussagen
	•	„Effektives Lernen bei Erwachsenen sollte freiwillig und selbstgesteuert sein. Die Lernenden sollen aktiv ihre Lernbedarfe identifizieren, Ziele setzen und ihren Fortschritt evaluieren.“ (S. 139)
	•	„Die Kombination von Präsenz- und E-Learning-Formaten zeigt sich als besonders effektiv, da sie die Vorteile beider Ansätze vereint und situatives Lernen ermöglicht.“ (S. 141)
	•	„Regelmäßiges und konstruktives Feedback sowie Mentoring sind essenziell für den Lernfortschritt und die Entwicklung der Facharztanwärter.“ (S. 146)
Argumentationslinien
	•	Erwachsenenbildung: Die Studie argumentiert, dass Lernen im Erwachsenenalter durch freiwillige und selbstgesteuerte Ansätze effektiver wird. (S. 139)
	•	Blended Learning: Die Kombination von E-Learning und Präsenzlernen wird als optimale Lösung zur Bewältigung der steigenden Komplexität der medizinischen Ausbildung dargestellt. (S. 141)
	•	Feedback und Mentoring: Diese Elemente sind entscheidend für den Lernerfolg und die Entwicklung von Fachkompetenzen in der Anästhesiologie. (S. 146)
	•	Simulationen: Simulationen bieten einen geschützten Raum für praktisches Lernen und erhöhen die Patientensicherheit. (S. 144)
Verschlagwortung
	•	Lehr- und Lerneffektivität: Untersuchung der Effektivität verschiedener Lernmethoden zur Verbesserung des Lernerfolgs in der Facharztweiterbildung.
	•	Technologieintegration: Nutzung von E-Learning und Blended Learning zur Unterstützung der medizinischen Ausbildung.
	•	Kollaboratives Lernen: Förderung von Feedback und Mentoring zur Unterstützung des Lernprozesses.
	•	Systemanpassung: Anpassung der Weiterbildungsprogramme an die Bedürfnisse und Präferenzen der Lernenden.
	•	Forschungsansätze: Deskriptive Studie und Evaluationsforschung zur Bewertung der Wirksamkeit von Lernmethoden.
Kategorisierung: Kerngedanke
Begründung:
Die Studie von Breuer et al. (2017) liefert zentrale theoretische und praktische Grundlagen zur Integration von Prinzipien der Erwachsenenbildung in die Facharztweiterbildung. Der Kerngedanke liegt in der Verbesserung der Effizienz und Effektivität des Lernprozesses durch selbstgesteuerte Ansätze, Blended Learning, Feedback, Mentoring und Simulationen. Diese Kerngedanken sind besonders relevant für die Forschungsfragen des Exposés, da sie die grundlegenden theoretischen und praktischen Rahmenbedingungen für die Implementierung und Optimierung von Lernmethoden im digitalen Bildungsraum beleuchten.
Kategorie: Kerngedanke
