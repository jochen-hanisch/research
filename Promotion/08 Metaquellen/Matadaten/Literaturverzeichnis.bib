@article{altenrath_deutungshoheiten_2020,
	title = {Deutungshoheiten: {Digitalisierung} und {Bildung} in {Programmatiken} und {Förderrichtlinien} {Deutschlands} und der {EU}},
	issn = {1424-3636, 1424-3636},
	shorttitle = {Deutungshoheiten},
	url = {10.21240/mpaed/jb17/2020.05.22.X},
	doi = {10/gksnz2},
	abstract = {This article is concerned with the prerogative of interpretation in relation to digitisation and education in the programmes and funding guidelines of Germany and the EU that has been created by political discourse and power. It is based on the assumption that the research and science system have for some time been closely dependent on funding programmes, which (should) function at different political levels as so-called funding instruments of various educational sectors and of science itself. On empirical observation, this turning towards and simultaneous rejection of terms and concepts makes prerogative of interpretation visible - not only in connection with discourses on digitisation and education. The consequence is the (over-)emphasis on individual concepts and the restrained representation of others, which means qualification narrowness for media education, which must be shown on an empirical basis and against the background of present concepts.},
	language = {de-DE},
	urldate = {2021-06-20},
	journal = {MedienPädagogik: Zeitschrift für Theorie und Praxis der Medienbildung},
	author = {Altenrath, Maike and Helbig, Christian and Hofhues, Sandra},
	month = aug,
	year = {2020},
	note = {ZSCC: 0000007},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Promotion:FU4a, Technologieintegration, Bildungstheorien, Promotion:Argumentation, Promotion:Relevanz:4, \#7:Zeitschriftenartikel:digital:Medien, Promotion:S:07 Digitale Medien, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {565--594},
	annote = {Analyse der Studie "Deutungshoheiten: Digitalisierung und Bildung in Programmatiken und Förderrichtlinien Deutschlands und der EU" von Maike Altenrath, Christian Helbig und Sandra Hofhues (2020)
Hauptthemen und Ziele der Forschung:
Die Studie von Altenrath et al. (2020) untersucht die diskurs- und machtpolitisch hervorgebrachten Deutungshoheiten in Bezug auf Digitalisierung und Bildung in Programmatiken und Förderrichtlinien Deutschlands und der EU. Ziel ist es, die Art und Weise zu analysieren, wie politische Diskurse und Machtstrukturen die Definition und Priorisierung von Konzepten und Begriffen in diesen Dokumenten beeinflussen. Die Autoren zielen darauf ab, die Auswirkungen dieser politischen Einflüsse auf die medienpädagogische Forschung und Praxis aufzuzeigen (S. 565-566).
Methoden und Datenquellen:
Die Studie verwendet eine inhaltlich strukturierende Inhaltsanalyse nach Kuckartz (2016) und eine diskursanalytische Betrachtung politischer Dokumente. Die Dokumente wurden mittels einer systematischen Recherche und einer Schneeball-Samplingstrategie identifiziert. Insgesamt wurden 34 Dokumente aus einem Datenkorpus von 41 Dokumenten analysiert. Diese umfassen Programmatiken und Förderrichtlinien sowohl auf Bundes- als auch auf EU-Ebene (S. 571-572).
Zentrale Forschungsergebnisse:


Technologische Souveränität: Politische Dokumente betonen häufig die Bedeutung technologischer Souveränität, insbesondere im Kontext wirtschaftlicher Wettbewerbsfähigkeit. Diese Souveränität wird als Fähigkeit beschrieben, Schlüsseltechnologien zu beherrschen und technologische Entwicklungen aktiv zu gestalten (S. 573-574).


Funktionale Bedeutungszuschreibungen: Die Dokumente fokussieren stark auf die wirtschaftliche Verwertbarkeit digitaler Kompetenzen. Bildung wird oft im Hinblick auf ihre Funktion für den Arbeitsmarkt und die wirtschaftliche Wettbewerbsfähigkeit betrachtet, wobei Begriffe wie "digitale Kompetenz" und "digitale Bildung" häufig technisch-instrumentell definiert werden (S. 576-578).


Mangelnde Reflexion und kritische Perspektiven: Kritische und gestalterische Aspekte der Medienkompetenz werden in den politischen Diskursen vernachlässigt. Die Analyse zeigt, dass die Begriffsdefinitionen oft stark auf technologische Fähigkeiten und weniger auf reflexive und kreative Kompetenzen fokussieren (S. 585-586).


Zusammenfassung
Die Studie von Altenrath et al. (2020) analysiert die Deutungshoheiten in Bezug auf Digitalisierung und Bildung in politischen Programmatiken und Förderrichtlinien Deutschlands und der EU. Die Ergebnisse zeigen, dass politische Diskurse die Bedeutung und Priorisierung von Begriffen wie "digitale Kompetenz" stark beeinflussen und oft wirtschaftliche Aspekte in den Vordergrund stellen. Kritische und gestalterische Dimensionen der Medienkompetenz werden hingegen vernachlässigt.
Kernaussagen


Technologische Souveränität: Die politische Betonung der technologischen Souveränität als Voraussetzung für wirtschaftliche Wettbewerbsfähigkeit (S. 573-574).


Wirtschaftliche Verwertbarkeit: Bildung wird häufig im Hinblick auf ihre wirtschaftliche Verwertbarkeit und ihre Funktion für den Arbeitsmarkt betrachtet (S. 576-578).


Vernachlässigung kritischer Perspektiven: Kritische und gestalterische Aspekte der Medienkompetenz werden in den politischen Diskursen vernachlässigt (S. 585-586).


Argumentationslinien
Die Autoren argumentieren, dass politische Diskurse und Machtstrukturen die Deutungshoheit über Begriffe und Konzepte im Bereich Digitalisierung und Bildung dominieren. Diese Diskurse betonen technologische und wirtschaftliche Aspekte und vernachlässigen dabei reflexive und kreative Dimensionen der Medienkompetenz. Die Studie zeigt, wie diese politischen Einflüsse die medienpädagogische Forschung und Praxis einschränken können (S. 573-586).
Verschlagwortung
Passendste Schlagworte und Begründungen:


Technologieintegration: Die Untersuchung thematisiert die Integration digitaler Technologien und deren Bedeutung im Kontext von Bildung und wirtschaftlicher Wettbewerbsfähigkeit (S. 573-574).


Forschungsansätze: Die Studie analysiert die Auswirkungen politischer Programmatiken und Förderrichtlinien auf die medienpädagogische Forschung (S. 571-572).


Bildungstheorien: Die Untersuchung beleuchtet die theoretischen und konzeptionellen Rahmenbedingungen, die durch politische Diskurse gesetzt werden (S. 585-586).


Kategorisierung


Argumentation: Die zentrale Argumentation der Studie befasst sich mit der politischen Deutungshoheit über Begriffe und Konzepte im Bereich Digitalisierung und Bildung und deren Auswirkungen auf die medienpädagogische Forschung und Praxis (S. 573-586).


Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU4a: Bildungswissenschaftliche Mechanismen bei Anwendung eines LMS.


Begründung: Die Studie untersucht die politischen und diskursiven Mechanismen, die die Definition und Priorisierung von Bildungsbegriffen und -konzepten beeinflussen, was direkt die Frage nach bildungswissenschaftlichen Mechanismen im digitalen Raum betrifft (S. 573-574).
Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie untersucht zentrale politische und diskursive Mechanismen, die für die Bildungsforschung von hoher Relevanz sind).


Zitierhäufigkeit und Einfluss: 4 (Die Studie bietet eine fundierte Analyse politischer Diskurse, jedoch sind empirische Daten begrenzt).


Aktualität: 4 (Die Studie ist von 2020 und behandelt ein weiterhin aktuelles Thema).


Gesamtbewertung: 4.5
Schlussfolgerung
Die Studie zeigt, dass politische Diskurse und Machtstrukturen die Deutungshoheit über Begriffe und Konzepte im Bereich Digitalisierung und Bildung dominieren. Diese Diskurse betonen technologische und wirtschaftliche Aspekte und vernachlässigen reflexive und kreative Dimensionen der Medienkompetenz. Die Ergebnisse unterstreichen die Notwendigkeit einer kritischen Auseinandersetzung mit diesen politischen Einflüssen, um eine umfassendere und ausgewogenere Perspektive auf Digitalisierung und Bildung zu entwickeln.
},
	file = {Altenrath et al. - 2020 - Deutungshoheiten Digitalisierung und Bildung in P.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/TSZSSK5D/Altenrath et al. - 2020 - Deutungshoheiten Digitalisierung und Bildung in P.pdf:application/pdf},
