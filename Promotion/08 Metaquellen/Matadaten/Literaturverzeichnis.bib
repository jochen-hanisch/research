}

@article{bronnecke_digitale_nodate,
	title = {Digitale, hochimmersive {Medien} in der phasenübergreifenden {Lehrer}:innenbildung des {Fachs} {Kunst}},
	abstract = {Lehr-Lern-Settings mit digitalen, hochimmersiven Medien, stellen (angehende) Lehrkräfte vor umfangreiche Transformationsprozesse von Lehre und Lernen. Dies verstärkt sich im Bereich der Kunstpädagogik v.a. dann, wenn sie über ein die Effizienz steigerndes Medium hinaus als innovatives Tool und Lernarrangement verstanden werden. In kollaborativen Lehrveranstaltungen (2021 – 2024) des Studiengangs »Lehramt Kunst« konnten die künstlerisch-kunstpädagogischen Möglichkeiten und Potentiale miteinander verzahnt, evaluiert und in konkrete Lehr-Lern-Settings überführt werden. Vorgestellt werden die Evaluationsergebnisse hinsichtlich der technischen Vorerfahrungen von Lernenden, deren Kompetenzen zur technologischen Handhabung von Hard- und Software sowie der Fähigkeit zur kreativen Zweckentfremdung im Bereich der Rezeption und Produktion.},
	language = {de},
	author = {Brönnecke, Katharina and Dierich-Hoche, Maja},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:FU4a, Technologieintegration, Systemanpassung, Bildungstheorien, Promotion:Relevanz:4, \#7:Zeitschriftenartikel:digital:Medien, Promotion:Weiterführung, Lernsystemarchitektur, Promotion:S:07 Digitale Medien, Promotion:Literaturverzeichnis},
	annote = {Analyse der Studie „Digitale, hochimmersive Medien in der phasenübergreifenden Lehrer:innenbildung des Fachs Kunst“ von Brönnecke \& Dierich-Hoche (2024)

1. Hauptthemen und Ziele der Forschung
Die Studie untersucht Chancen und Herausforderungen des Einsatzes von Virtual Reality (VR) und Augmented Reality (AR) in der Lehrer:innenbildung im Fach Kunst. Ziel ist es, die künstlerischen und kunstpädagogischen Potenziale dieser Technologien zu identifizieren, deren Integration in Lehr-Lern-Settings zu evaluieren und Gelingensbedingungen für den Transfer in den schulischen Kontext zu bestimmen. Besondere Aufmerksamkeit gilt dabei der professionellen Handlungskompetenz angehender Lehrkräfte sowie der Fähigkeit zur kreativen Zweckentfremdung und Reflexion des eigenen Bildhandelns.

2. Methoden und Datenquellen


Stichprobe:


73 Studierende des Studiengangs Lehramt Kunst (Universität Potsdam, 2021–2024)


111 Schüler:innen aus Grundschule, Sekundarstufe I und II (Brandenburg)




Datenerhebung:


Technische Vorerfahrungen: Online-Fragebögen (Nominal- und Ordinalskalen, Häufigkeitsverteilungen)


Evaluation: Teaching Analysis Poll (TAP) mit qualitativer Inhaltsanalyse nach Mayring (2015)


Transferphase: Gruppendiskussionen mit Schüler:innen, protokollgestützt




Analyse: Kombination aus quantitativen (Tabellen zu Gerätebesitz und Software-Nutzung) und qualitativen (interpretative Kodierung) Verfahren.



3. Zentrale Forschungsergebnisse


Technische Ausstattung \& Nutzung:


Fast alle Studierenden und Schüler:innen besitzen Smartphones; Tablets sind ebenfalls verbreitet, VR-Brillen dagegen selten (nur 4 \% der Studierenden).


Studierende nutzen digitale Geräte häufiger für kreative, künstlerische Anwendungen als Schüler:innen, die vor allem Social Media und Streaming einsetzen (Tab. 2–6, S. 274–276).




Vorerfahrungen mit VR/AR:


Überraschend: 80 \% der Grundschüler:innen hatten bereits Erfahrung mit VR-Brillen, aber keine Gruppe hatte vorher künstlerisch-gestalterisch in VR gearbeitet (Tab. 7–8, S. 276–277).


AR-Erfahrungen (z. B. Pokémon Go, Snapchat-Filter) hatten alle Befragten (Tab. 9, S. 277).




Lernförderliche Aspekte:


Work-Labs mit explorativem, spielerischem Handeln senken Hemmschwellen und fördern kreatives Arbeiten.


Flow-Erleben wird durch auditive Elemente (z. B. Hintergrundmusik) gesteigert.




Herausforderungen:


Orientierungsschwierigkeiten in VR (kein Sichtkontakt zu Mitlernenden)


Fehlende visuelle Referenzen in der künstlerischen Arbeit


Technische Unterstützung vieler Teilnehmender gleichzeitig schwierig




Verbesserungsvorschläge:


Bessere technische Infrastruktur (stabiles WLAN, leichtere HMDs, mobile Endgeräte)


Mehr Zeit in der VR-Umgebung


Ressourcenmanagement im schulischen Kontext klären.





4. Zusammenfassung
Die Integration von VR/AR in die Kunstlehrer:innenbildung bietet vielfältige Potenziale für kreative und motivationale Lernprozesse. Die Evaluation zeigt, dass ein offenes, exploratives Lernformat (Work-Lab/Maker Space) besonders wirksam ist, um technische Barrieren abzubauen und künstlerisches Potenzial zu entfalten. Gleichzeitig erfordert der nachhaltige Einsatz klare strukturelle, technische und didaktische Voraussetzungen.

5. Kernaussagen (mit Seitenangabe)


„Work-Labs […] erleichterten den späteren Umgang innerhalb der Professionalisierung für die Transferphase maßgeblich“ (S. 278).


„Studierende […] stehen dem Einsatz solcher [VR/AR] im Kunstunterricht überwiegend positiv gegenüber“ (S. 279).


„80 \% der Grundschüler:innen hatten bereits im privaten Kontext Vorerfahrungen mit einem HMD“ (S. 277).


„Offene Lehrformate ermöglichen, dass Lehrende und Lernende ihre unterschiedlichen Expertisen produktiv zusammenbringen“ (S. 280).


„Fehlende Infrastruktur kann die Offenheit zur Nutzung beeinträchtigen“ (S. 280).



6. Argumentationslinien (mit Seitenangabe)


Ausgangslage: VR/AR bieten neue kreative und interaktive Potenziale für Kunstpädagogik, werden aber bisher im Schulkontext kaum genutzt (S. 268–270).


Kompetenzentwicklung: Handlungskompetenz entsteht durch eine Kombination aus technischer Schulung, künstlerischer Praxis und Reflexion (S. 269–270).


Evaluation: Empirische Daten zu Vorerfahrungen und Nutzungsmustern belegen Bedarf an gezielter Förderung kreativer Anwendungen (S. 273–277).


Transfer in Schule: Maker-Space-Ansätze ermöglichen nachhaltige Implementierung, wenn Gelingensbedingungen wie Partizipation, Flexibilität und Ressourcen erfüllt sind (S. 280).



7. Verschlagwortung


Lernsystemarchitektur – Einsatz von Work-Labs und Maker Spaces als strukturelle Modelle zur Integration von VR/AR in künstlerische Lehrkonzepte.


Bildungstheorien – Bezug zu postdigitaler Kunstpädagogik und Next Art Education als theoretischer Rahmen (S. 269–270).


Lehr- und Lerneffektivität – Nachweis motivierender und kompetenzfördernder Wirkung durch explorative Lernsettings (S. 278–279).


Technologieintegration – Verknüpfung von Hardware (HMDs, Tablets) und Software (Design Tools, AR-Apps) im Kunstunterricht (S. 274–276).


Systemanpassung – Anpassung der Lehrformate an unterschiedliche Vorerfahrungen und technische Ressourcen.


Forschungsansätze – Kombination aus quantitativer (Fragebogen) und qualitativer (TAP, Gruppendiskussion) Methodik.



8. Kategorisierung
Kerngedanke: Die gezielte Integration von VR/AR in explorative, offene Lernformate (Work-Labs) kann Hemmschwellen abbauen, kreatives Potenzial fördern und nachhaltige Handlungskompetenzen für den Kunstunterricht entwickeln – erfordert aber strukturelle und technische Gelingensbedingungen (S. 278–280).

9. Zuordnung zu Forschungsunterfrage
Passendste FU: FU4a – Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?Begründung: Die Studie beschreibt detailliert, wie explorative, kollaborative Lernsettings mit VR/AR als Mechanismen wirken, um Motivation, Kreativität und Kompetenzentwicklung zu fördern.

10. Relevanzbewertung
Gesamtbewertung: 4 – Die Quelle liefert wertvolle empirische und theoretische Einblicke in Mechanismen digitaler Lernmedien, die auch für die Betrachtung systemisch-konstruktivistischer LMS-Ansätze in anderen Bildungsbereichen übertragbar sind, ist aber nicht primär auf Gesundheitsberufe ausgerichtet.
},
	file = {Brönnecke und Dierich-Hoche - Digitale, hochimmersive Medien in der phasenübergreifenden Lehrerinnenbildung des Fachs Kunst:/Users/jochenhanisch-johannsen/Zotero/storage/YXRLP68F/Brönnecke und Dierich-Hoche - Digitale, hochimmersive Medien in der phasenübergreifenden Lehrerinnenbildung des Fachs Kunst.pdf:application/pdf},
}

@article{wei_enhancing_2025,
	title = {Enhancing nursing education through e-portfolios: evaluating the impact on learning effectiveness, self-efficacy, and job satisfaction of {NPGY} trainees},
	volume = {25},
	issn = {1472-6920},
	shorttitle = {Enhancing nursing education through e-portfolios},
	url = {https://bmcmededuc.biomedcentral.com/articles/10.1186/s12909-025-07497-w},
	doi = {10.1186/s12909-025-07497-w},
	abstract = {Background Traditionally, learning was documented using paper-based systems, leading to challenges in tracking and evaluating progress. Electronic portfolios (e-portfolios), offering digital documentation and real-time feedback, have become increasingly popular in clinical education. This study aims to assess the impact of e-portfolios on the learning effectiveness, self-efficacy, and job satisfaction of nursing postgraduate year (NPGY) trainees.
Methods A cross-sectional questionnaire survey was conducted among 114 NPGY trainees in a medical center in northern Taiwan. The questionnaire collected data on demographics, e-portfolio satisfaction, assessment tool satisfaction, technology acceptance model (TAM), learning effectiveness, self-efficacy, and job satisfaction. Statistical analyses, including t-tests, ANOVA, and Pearson correlation, were performed to evaluate the relationships between variables.
Results Satisfaction with e-portfolios, assessment tools, and TAM significantly impacted learning effectiveness (p {\textless} .001), self-efficacy (p {\textless} .001), and job satisfaction (p {\textless} .001). The self-efficacy of trainees in the 1–2 years stage was higher than those in the 0–3 months stage (p {\textless} .05). Although the job satisfaction score was lowest during the 4–12 months stage, the difference was not statistically significant, indicating a need for targeted interventions during this period.
Conclusions E-portfolios positively influence the learning outcomes and job satisfaction of NPGY trainees. Continuous usage and enhancement of e-portfolios are recommended to meet user needs and provide a supportive learning environment, especially during critical stages of training. Future research should explore strategies to optimize e-portfolio features to further improve professional development and satisfaction.},
	language = {en},
	number = {1},
	urldate = {2025-08-04},
	journal = {BMC Medical Education},
	author = {Wei, Fang-Chun and Kao, Li-Ju and Chang, Chia-Ting and Chung, Jui-Yuan},
	month = jul,
	year = {2025},
	keywords = {Promotion:Literaturanalyse, \#0:Zeitschriftenartikel:digital:learning, Promotion:S:12 Digital Learning, Promotion:S:17 E-Portfolio, Promotion:Literaturverzeichnis},
	pages = {1132},
	file = {Wei et al. - 2025 - Enhancing nursing education through e-portfolios evaluating the impact on learning effectiveness, s:/Users/jochenhanisch-johannsen/Zotero/storage/KQ3MDCHH/Wei et al. - 2025 - Enhancing nursing education through e-portfolios evaluating the impact on learning effectiveness, s.pdf:application/pdf},
}

@article{oshiro_integration_2025,
	title = {Integration of early clinical exposure into curriculum enhances self-assessment of professional competencies in medical practice},
	volume = {25},
	issn = {1472-6920},
	url = {https://bmcmededuc.biomedcentral.com/articles/10.1186/s12909-025-07678-7},
	doi = {10.1186/s12909-025-07678-7},
	abstract = {Background Medical education has predominantly adhered to a process-based education model. Recently, outcome-based education (OBE) has emerged as a dominant pedagogical framework, facilitating simultaneous acquisition of theoretical knowledge, practical skills, and clinical experience. In 2020, our medical school implemented a new curriculum designed to integrate clinical skills training and experiential learning with foundational knowledge from the first year. Herein, we evaluated whether the clinical competencies of New Curriculum Students (NCS) are superior to the clinical competencies of Traditional Curriculum Students (TCS). Specifically, we clarified how selfassessment scores related to competencies in “Professional practice skills” evolved over time, and analyzed the longitudinal trends in self-assessment scores. Methods We included TCS enrolled between 2016 and 2019, and NCS enrolled between 2020 and 2023. Self-assessment of students’ competencies in “Professional practice skills,” a core component of our institution’s competency framework, was conducted by online survey. Competency levels were categorized into Levels A, B, and C. Results The self-assessment scores of NCS were significantly higher than those of TCS across most competency domains of “Professional practice skills.”The “Medical interview and physical examination” competency revealed that first-year NCS achieved scores equivalent to those of fourth-year TCS. These scores were either maintained or improved as students progressed in years. In the “Clinical skills” competency, NCS outperformed TCS at all levels from the first to the third year, and at Level A in the fourth year. In the “Medical record charting” competency, NCS achieved significantly higher scores than TCS across all levels during the first and second years. Discussion The early acquisition of clinical skills and exposure to clinical practice enabled students to consistently maintain high self-assessment scores. A curriculum design aligned with OBE appears to foster a heightened sense of self-efficacy among students. This approach is anticipated to facilitate a seamless transition into clinical responsibilities as future physicians.},
	language = {en},
	number = {1},
	urldate = {2025-08-04},
	journal = {BMC Medical Education},
	author = {Oshiro, Tsuyoshi and Suzuki, Shintaro and Kagawa, Naoki and Ono, Himawari and Goto, Rieko and Furuta, Atsuko and Arima, Makiko and Tsuchiya, Shizuma and Ogata, Hiroaki and Barroga, Edward and Izumi, Miki},
	month = aug,
	year = {2025},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Lehr- und Lerneffektivität, Promotion:FU4a, Promotion:Relevanz:5, Technologieintegration, Bewertungsmethoden, Systemanpassung, Bildungstheorien, Promotion:Argumentation, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {1139},
	annote = {Analyse der Studie „Evaluation von Einflussfaktoren zum nachhaltigen Wissensmanagement durch Kollaborationstools“ von Hanisch (2017)

1. Hauptthemen und Ziele der Forschung
Die Arbeit untersucht, wie die Faktoren Zeit, Struktur und Interaktion die Nachhaltigkeit von Wissensmanagementprozessen in der rettungsdienstlichen Ausbildung beeinflussen, insbesondere bei der Qualifizierung von Notfallsanitäter*innen. Ziel ist, geeignete Bedingungen für die (Wieder-)Einführung eines Kollaborationstools (z. B. Moodle) zu identifizieren, um Ergebnisse aus selbstorganisierten Gruppenarbeiten nachhaltig zu sichern (S. 6–7).

2. Methoden und Datenquellen
Theoretischer Rahmen:


Systemisch-konstruktivistischer Ansatz (Arnold, Reich, Siebert) mit Fokus auf Selbstorganisation, Autopoiesis und handlungsorientierte Kompetenzentwicklung (S. 7–9).


CIPP-Evaluationsmodell (Stufflebeam) als methodisches Grundgerüst, ergänzt durch Kirkpatrick’s Four Levelszur Wirkungsanalyse (S. 13–14).


Forschungsdesign:


Quantitative Evaluation mittels Online-Befragung (Plattform: Umfrage Online).


Zielgruppe: 53 ehemalige Teilnehmende einer sechs­wöchigen Vorbereitungsmaßnahme (EP2/EP3) zur staatlichen Vollprüfung als Notfallsanitäter*in.


Rücklauf: 26 Personen (49 \%).


Messinstrument: Likert-Skalen und Intervallskalen zu den drei Einflussfaktoren sowie zu soziodemografischen Daten (S. 15–16).


Statistische Auswertung: Korrelation, Regression, Varianzanalyse (ANOVA).



3. Zentrale Forschungsergebnisse


Faktor Zeit


Größter Einfluss auf nachhaltiges Wissensmanagement.


Frühzeitige Erfassung und Bereitstellung von Arbeitsergebnissen steigern Nachhaltigkeit signifikant (S. 16–18).




Faktor Struktur


Moderate Effekte: Übersichtlichkeit und Auffindbarkeit sind relevant für Akzeptanz und Nutzung eines Kollaborationstools.




Faktor Interaktion


Ebenfalls moderater Einfluss: Möglichkeit zum Austausch mit Expert*innen und Mitlernenden unterstützt selbstorganisierte Lernprozesse.




Implikation: Kollaborationstools wie Moodle eignen sich gut, um nachhaltiges Sichern von Gruppenarbeitsergebnissen zu gewährleisten – unter Beachtung zeitnaher Bereitstellung, klarer Struktur und Interaktionsmöglichkeiten.

4. Zusammenfassung
Die Studie zeigt, dass zeitliche Faktoren der Schlüssel zur nachhaltigen Sicherung von Lernergebnissen in der NotSan-Qualifizierung sind, während Struktur und Interaktion unterstützende, aber weniger starke Wirkungen entfalten. Sie liefert praxisnahe Handlungsempfehlungen für die Implementierung von LMS-basierten Kollaborationsprozessen in der medizinischen Ausbildung.

5. Kernaussagen


„Der Zeitpunkt, zu dem Ergebnisse der Gruppenarbeitsphasen zur Verfügung stehen, entscheidet wohlmöglich über den Grad der Nachhaltigkeit.“ (S. 9)


„Übersichtlichkeit, Auffindbarkeit und Selbstorganisation sind entscheidend für die Akzeptanz eines Kollaborationstools.“ (S. 10)


„Interaktion mit Expert*innen, Diskussionen und Feedback fördern gelingende selbstorganisierte Lernprozesse.“ (S. 10)


„Kollaborationstools sind geeignete Plattformen, um nachhaltiges Sichern von Ergebnissen aus selbstorganisierten Lernprozessen zu gewährleisten.“ (Abstract, S. 2)



6. Argumentationslinien


Theorie–Praxis–Evaluation:


Ausgangspunkt sind konstruktivistische Lernprinzipien (Selbstorganisation, Autopoiesis).


Überleitung zur praktischen Herausforderung unzureichender Nachhaltigkeit in Prüfungsleistungen.


Daraus Ableitung der zu untersuchenden Faktoren.




Empirie–Schlussfolgerung:


Quantitative Befragung zur Relevanz der Faktoren.


Statistische Belege für dominanten Einfluss des Faktors Zeit.


Empfehlung zur Reaktivierung von Moodle mit Fokus auf schnelle Ergebnissicherung.




(Alle Argumentationsschritte S. 6–14, 16–19)

7. Verschlagwortung


Bildungstheorien – Nutzung des systemisch-konstruktivistischen Ansatzes als theoretische Basis.


Lehr- und Lerneffektivität – Analyse, wie bestimmte Faktoren die Wirksamkeit des Wissensmanagements beeinflussen.


Bewertungsmethoden – Anwendung quantitativer Erhebungs- und Auswertungsverfahren (Korrelation, Regression, ANOVA).


Technologieintegration – Fokus auf LMS (Moodle) als zentrales Kollaborationstool.


Systemanpassung – Untersuchung, wie LMS an spezifische Ausbildungsbedarfe im Rettungsdienst angepasst werden kann.



8. Kategorisierung
Kategorie: ArgumentationBegründung: Die Arbeit stützt ihre Hypothesen und Schlussfolgerungen konsequent auf theoretische Modelle (systemisch-konstruktivistisch, CIPP, Kirkpatrick) und empirische Daten, um die Wirksamkeit von Kollaborationstools zu belegen.

9. Zuordnung zu Forschungsunterfrage
Passendste FU: FU4a – Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?
Begründung: Die Studie analysiert, wie die Faktoren Zeit, Struktur und Interaktion – verstanden als bildungswissenschaftliche Mechanismen – die Wirkung eines LMS (Moodle) auf Lernende im Gesundheitsbereich beeinflussen.

10. Relevanzbewertung
Gesamtbewertung: 5 – Hoch relevant


Direkte empirische Untersuchung zentraler Wirkmechanismen im LMS-Kontext der Gesundheitsberufe.


Theoretische Fundierung und praktische Anwendbarkeit.


Methodisch solide und klar auf die Forschungsfrage bezogen.


},
	file = {Oshiro et al. - 2025 - Integration of early clinical exposure into curriculum enhances self-assessment of professional comp:/Users/jochenhanisch-johannsen/Zotero/storage/KF6XH2KZ/Oshiro et al. - 2025 - Integration of early clinical exposure into curriculum enhances self-assessment of professional comp.pdf:application/pdf},
}

@book{ascherl_digitale_2025,
	address = {Bamberg},
	title = {({Digitale}) {Lehrund} {Lernmedien} im mehrsprachigen {Bildungskontext}},
	url = {https://epub.ub.uni-muenchen.de/id/eprint/127998},
	doi = {10.5282/UBM/EPUB.127998},
	language = {de-DE},
	urldate = {2025-08-05},
	publisher = {Universitätsbibliothek der Ludwig-Maximilians-Universität München},
	author = {Ascherl, Carina},
	year = {2025},
	keywords = {Promotion:Literaturanalyse, \#7:Buch:digital:Medien, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:FU4a, Promotion:Kerngedanke, Technologieintegration, Bewertungsmethoden, Bildungstheorien, Promotion:Relevanz:4, Datenschutz und IT-Sicherheit, Krisenreaktion im Bildungsbereich, Promotion:S:07 Digitale Medien, Promotion:Literaturverzeichnis},
	annote = {Analyse von Ascherl (2025): „(Digitale) Lehr- und Lernmedien im mehrsprachigen Bildungskontext“
Analyse
Hauptthemen und Ziele


Systematisierung von (digitalen) Lehr-/Lernmedien für Deutsch als Zweitsprache (DaZ) und Einordnung ihrer Funktionen im Unterricht zwischen fachlichem Inhalt, didaktischer Aufbereitung und Interaktion (Einführung). Ziel ist die begriffliche und didaktische Orientierung im Spannungsfeld zwischen instrumenteller Mediennutzung und einer „Kultur der Digitalität“. 


Problemaufriss: Digitale Medien wurden durch Migrationsbewegungen und COVID-19 in DaZ besonders sichtbar; Nachfrage nach digitalen Sprachlernangeboten (Apps) stieg, teils als Ersatz für knappe Kursplätze. 


Methoden und Datenquellen


Theoretisch-konzeptionelle Darstellung mit Literatur- und Forschungsüberblick (u. a. Kriterienkataloge, Studien zu ICILS/PISA, DaZ-Didaktik, App-Analysen). Keine eigenständige Primärdatenerhebung; Bezüge auf Vergleichs- und Beobachtungsstudien zu Sprachlern-Apps. 


Zentrale Ergebnisse/Erkenntnisse


Instrumentelle Sicht (Mehrwertlogik): Digitale Medien als Werkzeuge zur Effizienzsteigerung traditioneller Lernziele (Beschleunigen/Erleichtern/Verbessern). 


Grenzen von Sprachlern-Apps: Häufig geschlossene Aufgaben, begrenztes (automatisiertes) Feedback, Reproduktion behavioristischer Muster; Gamification/Sprachförderdidaktik oft schwach. 


Kultur-der-Digitalität-Perspektive: Digitale Medien sind integrale Bestandteile veränderter Kommunikations- und Teilhabekulturen; daraus folgen erweiterte Ziel- und Kompetenzdimensionen jenseits der reinen Werkzeuglogik. 


KI-Integration: Erfordert kritisch-reflexive Bewusstheit (Urheberrecht, Datenschutz, Bias). 


Kollaboration und Teilhabe: Digitale Arrangements können Kooperation, Aufgabenverteilung und Aushandlung fördern; Ausrichtung an individuellen Voraussetzungen und Lebenswelten bleibt leitend. 


Zusammenfassung
Ascherl systematisiert (digitale) Lehr-/Lernmedien für DaZ zwischen einer instrumentellen Perspektive (Mehrwert für etablierte Kompetenzen) und einer kulturtheoretischen Perspektive (Digitalität als Transformation sozial-kultureller Praktiken). Die Autorin arbeitet Defizite gängiger Sprachlern-Apps heraus (geschlossene Formate, standardisiertes Feedback) und plädiert für Lernsettings, die Teilhabe, Kooperation und erweiterte Kompetenzziele in einer Kultur der Digitalität adressieren. KI-gestützte Tools bedürfen datenschutz- und bias-sensibler Einbettung. Fazit: Digitale Medien sind nicht nur Werkzeuge, sondern konstitutive Elemente gegenwärtiger Sprachbildung und daher didaktisch als solche zu planen. 
Kernaussagen (mit Fundstellen)


Lehr-/Lernmedien bilden eine Schnittstelle zwischen Inhalt, Didaktik und Interaktion. 


Die instrumentelle Mehrwertlogik prüft digitale Medien auf Unterstützung traditioneller Kompetenzziele. 


Viele Apps bieten geschlossene Aufgaben und standardisiertes Feedback – begrenzte Tiefenwirkung. 


Digitale Medien sind integraler Teil einer Kultur der Digitalität; Kompetenzziele erweitern sich. 


KI-Nutzung verlangt Beachtung von Urheberrecht, Datenschutz und Bias. 


Unterricht soll an Lebenswelten und individuellen Voraussetzungen anknüpfen; digitale Medien eröffnen dafür vielfältige Möglichkeiten. 


Argumentationslinien (mit Fundstellen)


Vom Inventar zur Bewertung: Breite Medienlandschaft → Einordnung als Lehr-/Lernmedien mit Schnittstellenfunktion → Nachfrage-/Kontextdruck (Migration, Pandemie). 


Instrumentelle Perspektive und Kritik: Mehrwertlogik → Defizite typischer Apps (Aufgaben/Feedback/Behaviorismus). 


Neurahmung durch Digitalität: Schritt von „Werkzeug“ zu kultureller Transformation → erweiterte Ziel- und Kompetenzdimensionen → Konsequenzen für Unterrichtsgestaltung. 


Risiken/Requirements: KI-bezogene Ethik/Datenschutz/Bias als Bedingung verantwortlicher Integration. 


Verschlagwortung (mit kurzer Begründung)


Bildungstheorien: Kultur-der-Digitalität-Perspektive rahmt Sprachbildung konzeptionell. 


Lehr- und Lerneffektivität: Kritische Befunde zu Aufgabenformaten und Feedback begrenzen Wirksamkeit vieler Apps. 


Technologieintegration: Anforderungen und Chancen digitaler Tools inkl. KI-Systemen. 


Bewertungsmethoden: Verweis auf Qualitätskriterien/Kataloge zur Beurteilung digitaler Angebote. 


Kollaboratives Lernen: Digitale Settings unterstützen Kooperation, Aufgabenverteilung und Aushandlung. 


Krisenreaktion im Bildungsbereich: Kontextualisierung durch COVID-19 als Treiber digitaler Sprachlernangebote. 


Datenschutz und IT-Sicherheit: Explizite Nennung von Datenschutz und Urheberrecht bei KI-Einsatz. 



Nur relevante Schlagworte wurden gewählt; „Lernsystemarchitektur“/„Systemanpassung“ sind hier weniger zentral, da kein LMS-Architektur-Fokus vorliegt.

Kategorisiere (nur eine Kategorie)
Kerngedanke.Digitale Medien sind im mehrsprachigen Unterricht nicht bloß Hilfsmittel; sie sind konstitutiver Bestandteil einer Kultur der Digitalität, wodurch sich Ziele und Kompetenzen des Unterrichts erweitern und Unterrichtsgestaltung neu ausgerichtet werden muss. 
Zuordnung zur Forschungsunterfrage (FU)
Passendste FU: FU4a – „Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen LMS im Bezug zur Wirkung auf Akteur*innen beschrieben?“Begründung: Der Beitrag entfaltet Mechanismen der mediendidaktischen Rahmung (Instrumentalität vs. Kultur der Digitalität), Anforderungen an Kompetenzen/Partizipation und kritische Einbettung (KI, Feedback), die für die Wirkung digitaler Arrangements auf Lernende/Lehrende zentral sind – wenn auch ohne spezifische LMS-Architektur. 
Relevanzbewertung (1–5)
4 – Relevant.Hohe inhaltliche Anschlussfähigkeit an didaktische Wirkmechanismen und Qualitätsfragen der Digitalisierung; keine direkte LMS- oder Gesundheitsberufe-Empirie, daher nicht „5“.
Mögliche Forschungslücken/-bedarfe


Offene Aufgabenformate \& Feedbackqualität: Empirische Studien zu offenen, problemorientierten Formaten mit hochwertigem, adaptivem Feedback in DaZ-Settings. 


KI-Didaktik in DaZ: Wirksamkeit, Fairness und Datenschutz in KI-gestützten Schreib-/Sprechlernprozessen unter realen Unterrichtsbedingungen. 


Transfer auf LMS-Ökosysteme: Vergleichsstudien, wie die Kultur-der-Digitalität-Perspektive in konkreten LMS-Kursdesigns (Foren, E-Portfolios, kollaborative Tools) umgesetzt werden kann (Kompetenzzuwächse, Teilhabe, Motivation). 


},
	file = {Ascherl - 2025 - (Digitale) Lehr- und Lernmedien im mehrsprachigen Bildungskontext:/Users/jochenhanisch-johannsen/Zotero/storage/6HT7D95R/Ascherl - 2025 - (Digitale) Lehr- und Lernmedien im mehrsprachigen Bildungskontext.pdf:application/pdf},
}

@article{wirth_medienkompetenzen_2025,
	title = {Medienkompetenzen von {Fachkräften} in der {Frühpädagogik} stärken: {Eine} {Interventionsstudie} zur {Förderung} pädagogischer {Handlungskompetenzen} durch {Fortbildungsangebote}},
	copyright = {https://creativecommons.org/licenses/by/4.0},
	issn = {1424-3636},
	shorttitle = {Medienkompetenzen von {Fachkräften} in der {Frühpädagogik} stärken},
	url = {https://www.medienpaed.com/article/view/1982},
	doi = {10.21240/mpaed/00/2025.08.07.X},
	abstract = {In early childhood education, digital media are more and more used together with children in accordance with current educational plans. A common challenge in the implementation is the perceived lack of media competence among pedagogical professionals, which is mostly attributed to the lack of indicator-specific professionalization in initial and continuing educator education. In the present study, N = 33 educators participated in two professional training sessions, during which relevant knowledge on media use with children was imparted, and a media concept for each institution was developed. Digital resources (tablets and learning applications) were provided, and the institutions were supported across a period of over one year. Pre-post comparisons using written questionnaires across three measurement points showed that the media-related knowledge and activities of pedagogical professionals significantly improved positively, but not the media-related attitudes and perceived media competence. Contrary to common concerns, the use of digital media in the institutions mostly occurred collaboratively with professionals and was limited. The findings underscore the demands for a stronger focus on media-related content in the context of the professionalization of pedagogical professionals and the implementation of these contents in practice.},
	language = {de},
	urldate = {2025-08-12},
	journal = {MedienPädagogik: Zeitschrift für Theorie und Praxis der Medienbildung},
	author = {Wirth, Astrid and Mues, Anna and Schuster, Jana and Schiele, Tina and Niklas, Frank},
	month = aug,
	year = {2025},
	keywords = {Promotion:Literaturanalyse, \#7:Zeitschriftenartikel:digital:Medien, Promotion:S:07 Digitale Medien, Promotion:Literaturverzeichnis},
	pages = {199--214},
	file = {Wirth et al. - 2025 - Medienkompetenzen von Fachkräften in der Frühpädagogik stärken Eine Interventionsstudie zur Förderu:/Users/jochenhanisch-johannsen/Zotero/storage/ETL97CJE/Wirth et al. - 2025 - Medienkompetenzen von Fachkräften in der Frühpädagogik stärken Eine Interventionsstudie zur Förderu.pdf:application/pdf},
}

@article{heimbeck_medienunterstutzte_2025,
	title = {Medienunterstützte {Eltern}-{Lehrer}:innen-{Kooperationen}: {Substitution}, {Ergänzung} oder {Neugestaltung}?},
	copyright = {https://creativecommons.org/licenses/by/4.0},
	issn = {1424-3636},
	shorttitle = {Medienunterstützte {Eltern}-{Lehrer}},
	url = {https://www.medienpaed.com/article/view/1631},
	doi = {10.21240/mpaed/00/2025.08.05.X},
	abstract = {Der vorliegende Beitrag betrachtet die Rolle digitaler Medien in der Eltern-Lehrer:innen-Kooperation systemtheoretisch. Auf Grundlage bestehender Befunde werden Informationsfluss, Verhältnis und Lernprozess als zentrale Indikatoren gelingender Kooperationen zwischen schulischen Akteuren und Akteuren des familiären Umfelds von Schüler:innen identifiziert. Für diese Indikatoren werden Korrelate auf Ebene der Rechtslage (Makro), der Einzelschule (Meso) und der Individuen (Mikro) angenommen. In einem weiteren Schritt werden Potenziale digitaler Medien zur Unterstützung dieser Faktoren mithilfe des SAMR-Modells analysiert. Insbesondere wird hier der Frage nachgegangen, wann ein Medieneinsatz in der Eltern-Lehrer:innen-Kooperation eine substituierende oder ergänzende Rolle spielt oder wann eine Neugestaltung bestehender Prozesse möglich ist. Mit dieser systematischen Analyse leistet der Artikel einen theoretischen Beitrag zur Diskussion über die Rolle digitaler Medien in Eltern-Lehrer:innen-Kooperationen. Abschliessend erfolgt eine kritische Betrachtung des Rahmenmodells in seiner Bedeutung für die Schulpraxis.
          , 
            This article examines the role of digital media in parent-teacher-cooperation from a system-theoretical perspective. Based on existing findings, information flow, relationship, and learning process are identified as central indicators of successful cooperation between school actors and actors in the family environment of students. For these indicators, correlates are assumed at the level of the legal situation (macro), at the individual school level (meso) and at the individual level (micro). In a further step, potentials of digital media to support these factors are analysed using the SAMR model. We investigate when the use of media in parent-teacher cooperation plays a substituting or complementary role, and when a redesign of existing processes is possible. With this analysis, the article makes a theoretical contribution to the discussion about the role of digital media in parent-teacher cooperation. Finally, the framework model is critically examined in terms of its significance for school practice.},
	language = {de},
	urldate = {2025-08-12},
	journal = {MedienPädagogik: Zeitschrift für Theorie und Praxis der Medienbildung},
	author = {Heimbeck, Manuela and Dengel, Andreas},
	month = aug,
	year = {2025},
	keywords = {Promotion:Literaturanalyse, \#7:Zeitschriftenartikel:digital:Medien, Promotion:S:07 Digitale Medien, Promotion:Literaturverzeichnis},
	pages = {171--185},
	file = {Heimbeck und Dengel - 2025 - Medienunterstützte Eltern-Lehrerinnen-Kooperationen Substitution, Ergänzung oder Neugestaltung:/Users/jochenhanisch-johannsen/Zotero/storage/23K8A3DY/Heimbeck und Dengel - 2025 - Medienunterstützte Eltern-Lehrerinnen-Kooperationen Substitution, Ergänzung oder Neugestaltung.pdf:application/pdf},
}

