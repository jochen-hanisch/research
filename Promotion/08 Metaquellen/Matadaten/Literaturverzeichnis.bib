@article{flinspach_rise_2023,
	title = {Rise of public e-learning opportunities in the context of {COVID}-19 pandemic-induced curtailment of face-to-face courses, exemplified by epidural catheterization on {YouTube}},
	volume = {23},
	issn = {1472-6920},
	doi = {10.1186/s12909-023-04409-8},
	abstract = {BACKGROUND: In the context of the coronavirus pandemic, countless face-to-face events as well as medical trainings were cancelled or moved to online courses, which resulted in increased digitalization in many areas. In the context of medical education, videos provide tremendous benefit for visualizing skills before they are practised.
METHODS: Based on a previous investigation of video material addressing epidural catheterization available on the YouTube platform, we aimed to investigate new content produced in the context of the pandemic. Thus, a video search was conducted in May 2022.
RESULTS: We identified twelve new videos since the pandemic with a significant improvement in the new content in terms of procedural items (p = 0.03) compared to the prepandemic video content. Video content released in the course of the COVID-19 pandemic was more often created by private content creators and were significantly shorter in total runtime than those from university and medical societies (p = 0.04).
CONCLUSION: The profound changes in the learning and teaching of health care education in relation to the pandemic are largely unclear. We reveal improved procedural quality of predominantly privately uploaded content despite a shortened runtime compared to the prepandemic period. This might indicate that technical and financial hurdles to producing instructional videos by discipline experts have decreased. In addition to the teaching difficulties caused by the pandemic, this change is likely to be due to validated manuals on how to create such content. The awareness that medical education needs to be improved has grown, so platforms offer specialized sublevels for high-quality medical videos.},
	language = {en-GB},
	number = {1},
	journal = {BMC medical education},
	author = {Flinspach, Armin N. and Sterz, Jasmina and Neef, Vanessa and Flinspach, Mairen H. and Zacharowski, Kai and Ruesseler, Miriam and Janker, Lena and Raimann, Florian J.},
	month = jun,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Technologieintegration, Bewertungsmethoden, Systemanpassung, Promotion:FU5, Krisenreaktion im Bildungsbereich, Promotion:Schlussfolgerung, Teaching, Humans, COVID-19, Education, \#5:Zeitschriftenartikel:e-learning, Computer-Assisted Instruction, Pandemics, Anesthesia, Epidural, Health Education, Instructional film and video, Obstetrics, Social Media, Video Recording, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {406},
	annote = {Analyse der Studie: „Rise of public e-learning opportunities in the context of COVID-19 pandemic-induced curtailment of face-to-face courses, exemplified by epidural catheterization on YouTube“ von Flinspach et al. (2023)

1. Analyse
Hauptthemen und Ziele der Forschung
Ziel der Studie ist es, die Auswirkungen der COVID-19-Pandemie auf öffentlich zugängliche E-Learning-Angeboteam Beispiel von YouTube-Videos zur epiduralen Katheterisierung zu untersuchen. Die Studie analysiert systematisch, inwieweit sich die Qualität der Videos im Vergleich zur Vor-Pandemie-Zeit verändert hat und welche Produzenten (universitär vs. privat) dominieren.

Methoden und Datenquellen


Design: Beobachtungsstudie mit systematischer Videorecherche auf YouTube


Suchzeitraum: Mai–Dezember 2022


Suchbegriffe: „epidural“, „peridural“ kombiniert mit „birth“, „obstetrics“, „delivery“, „catheter“, „anesthesia“


Auswahl: 12 neue pandemiezeitliche Videos vs. 16 aus einer Vorstudie (präpandemisch)


Kriterienkatalog:


20 prozedurale Items (z. B. Händedesinfektion, Punktionstechnik)


21 didaktische Items (z. B. Struktur, Abkürzungserklärung)


Validierte Checkliste mit hoher Interrater-Reliabilität (ICC ≈ 0.975)




Bewertung durch 9 Rater (Fachärztinnen, medizinische Didaktikerinnen, Studierende)


Statistik: Mann-Whitney-U-Test, Spearman-Korrelation, SPSS 29



Zentrale Forschungsergebnisse


Signifikante Verbesserung der prozeduralen Qualität in Pandemie-Videos (Ø 1.01 vs. 0.77; p = 0.033)


Didaktische Qualität zeigt keine signifikante Verbesserung (S. 3–4)


Hauptproduzenten: Privatpersonen häufiger als Universitäten (S. 3)


Videolänge: Kürzer bei privaten Anbietern (Mittelwert 342 s vs. 724 s; p = 0.047)


Lernrelevanz: Kürzere Videos können effektiver sein, wenn gezielt gestaltet


Einzelne signifikante Verbesserungen u. a. bei:


Punktionstechnik (p {\textless} 0.001)


Kathetereinführung (p = 0.009)


Aspirationstest (p = 0.001)




Rückgang bei:


Erklärung von Abkürzungen (p = 0.011)


Quellenangabe (p = 0.029)





2. Zusammenfassung
Die Studie analysiert öffentlich verfügbare YouTube-Videos zur epiduralen Katheterisierung vor und während der COVID-19-Pandemie. Mit einer validierten Checkliste wurden prozedurale und didaktische Qualitäten systematisch bewertet. Die Ergebnisse zeigen eine signifikante Verbesserung der prozeduralen Aspekte, insbesondere in Videos privater Anbieter, obwohl die didaktische Qualität stagnierte. Die zunehmende Beteiligung nicht-akademischer Akteurinnen sowie kürzere, fokussierte Videolängen deuten auf eine neue Dynamik in der Erstellung medizinischen Lehrmaterials hin. Die Autorinnen plädieren für gezielte Review-Mechanismen und institutionelle Qualitätssicherung – etwa durch Plattformen wie „YouTube Health“.

3. Kernaussagen (mit Fundstellen)


„Videos created during the pandemic were improved in terms of procedural quality [...] p = 0.033“ (S. 3)


„Video content was more often created by private content creators“ (S. 3)


„No significant improvement in didactic quality [...] p = 0.837“ (S. 4)


„Abbreviations avoided or explained [...] decreased significantly (p = 0.011)“ (Tabelle 1)


„YouTube Health as curated high-quality subplatform may support future quality development“ (S. 6)



4. Argumentationslinien


Pandemie als Katalysator: Präsenzlehre fiel aus, Videoangebote stiegen rapide (S. 2)


Privatisierung von Bildungsinhalten: Private Creator dominieren zunehmend – mit überraschender Qualität (S. 3–4)


Qualitätsdiskurs: Professionelle Qualität in prozeduralen Inhalten ↑, didaktische Standards ↓ (S. 4–5)


Plattformverantwortung: Neue Strukturen wie „YouTube Health“ und OER-Richtlinien sollen Qualität sichern (S. 6–7)



5. Verschlagwortung




Schlagwort


Begründung




Lehr- und Lerneffektivität


Studie untersucht systematisch Qualitätsverbesserungen im E-Learning mittels Videomaterial




Technologieintegration


Fokus auf YouTube und algorithmische Auffindbarkeit lernrelevanter Inhalte




Systemanpassung


Privatakteure übernehmen verstärkt Bildungsaufgaben → neue Anforderungen an das medizinische System




Bewertungsmethoden


Einsatz validierter Bewertungs-Checkliste für prozedurale und didaktische Qualität




Krisenreaktion im Bildungsbereich


COVID-19 als Auslöser für massive Umstrukturierungen in der medizinischen Lehre





6. Kategorisierung
Kategorie: SchlussfolgerungBegründung: Die Studie reflektiert die pandemiebedingte Umstellung auf digitale Formate und zieht aus der qualitativen Analyse fundierte Schlussfolgerungen für zukünftige Qualitätsentwicklung und Governance im medizinischen E-Learning.

7. Zuordnung zur Forschungsunterfrage
Passende Forschungsunterfrage (FU):FU5 – Welche Möglichkeiten und Grenzen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems durch Akteure im digitalen Bildungsraum von Gesundheitsberufen analysiert?
Begründung:Die Studie thematisiert die Potenziale (z. B. qualitative Verbesserungen) und Herausforderungen (z. B. mangelnde didaktische Standards) der Nutzung öffentlich zugänglicher E-Learning-Angebote und reflektiert die Rolle institutioneller versus privater Akteure.

8. Relevanzbewertung
Relevanz: 5 – Hoch relevantBegründung:Die Studie bietet ein innovatives Beispiel für die qualitative Analyse von E-Learning-Material in einem zentralen medizinischen Anwendungsfeld (Anästhesie) mit unmittelbarer Relevanz für die Gestaltung digitaler Lehrinhalte im Gesundheitsbereich.
},
	file = {Volltext:/Users/jochenhanisch-johannsen/Zotero/storage/DWB4W744/Flinspach et al. - 2023 - Rise of public e-learning opportunities in the context of COVID-19 pandemic-induced curtailment of f.pdf:application/pdf},
}

