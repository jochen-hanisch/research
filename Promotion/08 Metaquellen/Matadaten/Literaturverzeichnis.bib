@article{davis_hands-tasks_2023,
	title = {Hands-on tasks make learning visible: a learning analytics lens on the development of mechanistic problem-solving expertise in makerspaces},
	issn = {1042-1629, 1556-6501},
	shorttitle = {Hands-on tasks make learning visible},
	url = {https://link.springer.com/10.1007/s11423-023-10318-w},
	doi = {10.1007/s11423-023-10318-w},
	abstract = {This study investigated the impact of participating in a year-long digital-fabrication course on high-school seniors’ problem-solving skills, with a focus on problems involving mechanistic systems. The research questions centered on whether working in a makerspace impacted students’ abilities to solve such problems and whether the process data generated during problem-solving activities could be used to identify the different problem-solving approaches taken by the participants. A novel set of hands-on, mechanistic problems were created to answer these questions, and the results showed that after taking part in the course students performed significantly better on these problems, with the post-course students making more progress towards the solutions than the pre-course students. The process data revealed two distinct problem-solving approaches for each problem, one adopted primarily by experts (the expert approach) and one by pre-course students (the novice approach). The post-course students were more likely to adopt the expert approaches, which were strongly associated with better performance on each problem. The study found that participation in the course made the high-school students better able to “see” the various components and their ways of interacting, making them more like expert engineers.},
	language = {en-GB},
	urldate = {2023-12-02},
	journal = {Educational technology research and development},
	author = {Davis, Richard Lee and Schneider, Bertrand and Rosenbaum, Leah F. and Blikstein, Paulo},
	month = nov,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, \#0:Zeitschriftenartikel:digital:learning, Leraning:Analytics, Promotion:S:12 Digital Learning, Promotion:Literaturverzeichnis},
	file = {Davis et al. - 2023 - Hands-on tasks make learning visible a learning a.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/LKMW9HQI/Davis et al. - 2023 - Hands-on tasks make learning visible a learning a.pdf:application/pdf},
}

@inproceedings{choi_meta-lad_2023,
	address = {Cambridge, MA, USA},
	title = {Meta-{LAD}: {Developing} a {Learning} {Analytics} {Dashboard} with a {Theoretically} {Grounded} and {Context}-{Specific} {Approach}},
	isbn = {979-8-3503-1559-2},
	shorttitle = {Meta-{LAD}},
	url = {https://ieeexplore.ieee.org/document/10306139/},
	doi = {10.1109/LWMOOCS58322.2023.10306139},
	abstract = {The use of Learning Analytics Dashboards (LADs) has gained popularity as a means of supporting the self-regulated learning (SRL) skills of learners in large-scale online courses. Despite many studies proposing LAD designs, LADs are often criticized for their weak theoretical foundations, lack of actionable feedback, and tendency to encourage excessive social comparison. Furthermore, many LAD designs have missed context-specific details. Hence, it is not uncommon for some dashboard designs to have negative effects on learners, such as discouragement or anxiety. In this study, we designed the Meta-LAD, a LAD that supports SRL processes using theoretical and contextual foundations. We used data from a credit-bearing Massive Open Online Course (MOOC) on supply chain management to contextually ground the dashboard. We performed usability testing interviews to evaluate the design and confirmed that the Meta-LAD could fulfill learners’ needs for references and actionable feedback. This study contributes to the field of online learning by presenting a theoretically grounded and contextually specific LAD design process. This paper expands the understanding of how to support SRL in MOOCs.},
	language = {en-GB},
	urldate = {2023-11-29},
	booktitle = {2023 {IEEE} {Learning} with {MOOCS} ({LWMOOCS})},
	publisher = {IEEE},
	author = {Choi, Heeryung and Borrella, Inma and Ponce-Cueto, Eva},
	month = oct,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Bewertungsmethoden, Promotion:FU2a, Interviews, Leraning:Analytics, Usability, \#4:Konferenz-Paper:MOOC, Computer aided instruction, Electronic learning, MOOC, Anxiety disorders, Learning Analytics Dashboard, Self-regulated Learning, Supply chain management, Testing, Promotion:S:04 MOOC, Promotion:Literaturverzeichnis},
	pages = {1--6},
	annote = {Analyse der Studie "Meta-LAD: Developing a Learning Analytics Dashboard with a Theoretically Grounded and Context-specific Approach" von Choi et al. (2023)
Hauptthemen und Ziele der Forschung:
Die Studie von Choi et al. (2023) befasst sich mit der Entwicklung eines Learning Analytics Dashboards (LAD), das auf einer theoretisch fundierten und kontextspezifischen Grundlage basiert. Ziel ist es, das Meta-LAD zu entwickeln, um die selbstregulierten Lernfähigkeiten (SRL) der Lernenden in groß angelegten Online-Kursen (MOOCs) zu unterstützen und zu verbessern. Das Dashboard soll auf Daten eines zertifikatstragenden MOOCs im Bereich Supply Chain Management basieren, um den spezifischen Kontext und die Bedürfnisse der Lernenden zu berücksichtigen (S. 1).
Methoden und Datenquellen:
Die Studie umfasst mehrere methodische Ansätze:


Theoretische Grundlage: Verwendung des COPES-Modells, das für Conditions (Bedingungen), Operations (Operationen), Products (Produkte), Evaluations (Bewertungen) und Standards steht, um die Struktur des LAD zu gestalten (S. 2).


Datenanalyse: Anwendung von multiplen linearen Regressionen und elastischen Netzanalysemodellen auf Clickstream-Daten von Januar 2021 bis September 2022, um relevante Indikatoren für das Dashboard zu identifizieren (S. 2-3).


Usability-Tests: Durchführung von Nutzbarkeitstests und halbstrukturierten Interviews mit Teilnehmenden des MOOCs, um die Benutzerfreundlichkeit und die potenziellen Auswirkungen des Dashboards auf den SRL-Prozess zu evaluieren (S. 4).


Zentrale Forschungsergebnisse:


Relevante Indikatoren: Fünf Indikatoren wurden identifiziert, die einen statistisch signifikanten positiven Einfluss auf die Leistung der Lernenden haben: Anzahl abgeschlossener Vorlesungsvideos, Anzahl eingereichter Übungsaufgaben, Anzahl überprüfter Lösungen, Zeitspanne zwischen Abschluss eines Moduls und Beginn des nächsten sowie Zeitspanne zwischen Beginn und Abschluss eines Moduls (S. 3-4).


Usability und Akzeptanz: Die Nutzbarkeit des Meta-LAD wurde positiv bewertet, mit einem Durchschnittswert von 87,81 auf der System Usability Scale (SUS). Die Teilnehmenden schätzten besonders die Kombination aus motivierenden Nachrichten und handlungsorientiertem Feedback (S. 6).


Zusammenfassung
Die Studie von Choi et al. (2023) zeigt, dass das Meta-LAD, ein Learning Analytics Dashboard, basierend auf theoretischen und kontextuellen Grundlagen entwickelt wurde, die selbstregulierten Lernfähigkeiten der Lernenden in MOOCs signifikant unterstützen kann. Die positiven Rückmeldungen aus den Usability-Tests unterstreichen die Wirksamkeit des Dashboards.
Kernaussagen


Theoretische Fundierung: Die Verwendung des COPES-Modells als theoretische Grundlage für das Dashboard-Design (S. 2).


Positive Rückmeldungen: Hohe Benutzerfreundlichkeit und Akzeptanz des Dashboards, wie durch die System Usability Scale (SUS) bestätigt (S. 6).


Argumentationslinien
Die Autoren argumentieren, dass ein auf theoretischen Grundlagen basierendes und kontextspezifisches LAD den SRL-Prozess der Lernenden in MOOCs effektiv unterstützen kann. Die Identifizierung relevanter Indikatoren und die Einbindung handlungsorientierter Feedbackmechanismen tragen wesentlich zur Verbesserung der Lernleistungen bei (S. 3-4).
Verschlagwortung
Passendste Schlagworte und Begründungen:


Lehr- und Lerneffektivität: Die Studie bewertet die Effektivität eines theoretisch fundierten und kontextspezifischen Learning Analytics Dashboards zur Unterstützung des selbstregulierten Lernens in MOOCs (S. 1-2).


Technologieintegration: Die Untersuchung zeigt, wie Learning Analytics Dashboards effektiv in Online-Lernumgebungen integriert werden können, um die Lernerfahrungen zu verbessern (S. 4).


Kategorisierung


Kerngedanke: Die Studie stellt die zentrale Idee der Entwicklung eines theoretisch fundierten und kontextspezifischen Learning Analytics Dashboards zur Unterstützung des selbstregulierten Lernens in MOOCs vor (S. 1).


Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU2a: Effekt-Faktoren für Lernende im digitalen Bildungsraum.


Begründung: Die Studie analysiert, wie ein theoretisch fundiertes und kontextspezifisches Learning Analytics Dashboard die selbstregulierten Lernfähigkeiten der Lernenden in MOOCs verbessert, was direkt die Frage nach den Effekt-Faktoren für Lernende im digitalen Bildungsraum betrifft (S. 3-4).
Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie untersucht umfassend die Nutzung und Wirkung eines Learning Analytics Dashboards auf das selbstregulierte Lernen in MOOCs).


Zitierhäufigkeit und Einfluss: 4 (Die Studie ist methodisch stark und behandelt ein aktuelles und relevantes Thema, das potenziell oft zitiert wird).


Aktualität: 5 (Die Studie ist von 2023 und behandelt ein hochaktuelles Thema).


Gesamtbewertung: 4.75
Schlussfolgerung
Die Studie von Choi et al. (2023) zeigt, dass ein theoretisch fundiertes und kontextspezifisches Learning Analytics Dashboard die selbstregulierten Lernfähigkeiten der Lernenden in MOOCs signifikant unterstützen kann. Die positiven Ergebnisse aus den Usability-Tests und die hohe Akzeptanz des Dashboards unterstreichen die Bedeutung solcher Systeme für die Verbesserung der Lernleistungen und die Förderung des selbstregulierten Lernens in digitalen Bildungsumgebungen.
},
