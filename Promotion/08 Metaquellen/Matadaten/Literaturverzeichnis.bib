@article{lin_digital_2021,
	title = {Digital {Health} and {Digital} {Learning} {Experiences} {Across} {Speech}-{Language} {Pathology}, {Phoniatrics}, and {Otolaryngology}: {Interdisciplinary} {Survey} {Study}},
	volume = {7},
	issn = {2369-3762},
	shorttitle = {Digital {Health} and {Digital} {Learning} {Experiences} {Across} {Speech}-{Language} {Pathology}, {Phoniatrics}, and {Otolaryngology}},
	url = {https://mededu.jmir.org/2021/4/e30873},
	doi = {10.2196/30873},
	abstract = {Background: Advances in digital health and digital learning are transforming the lives of patients, health care providers, and health professional students. In the interdisciplinary field of communication sciences and disorders (CSD), digital uptake and incorporation of digital topics and technologies into clinical training programs has lagged behind other medical fields. There is a need to understand professional and student experiences, opinions, and needs regarding digital health and learning topics so that effective strategies for implementation can be optimized.
Objective: This cross-sectional survey study aims to interdisciplinarily investigate professional and student knowledge, use, attitudes, and preferences toward digital health and learning in the German-speaking population.
Methods: An open-ended, web-based survey was developed and conducted with professionals and students in CSD including phoniatricians and otolaryngologists, speech-language pathologists (German: Logopäd*innen), medical students, and speech-language pathology students. Differences in knowledge, use, attitudes, and preferences across profession, generation, and years of experience were analyzed.
Results: A total of 170 participants completed the survey. Respondents demonstrated greater familiarity with digital learning as opposed to eHealth concepts. Significant differences were noted across profession (P{\textless}.001), generation (P=.001), and years of experience (P{\textless}.001), which demonstrated that students and younger participants were less familiar with digital health terminology. Professional (P{\textless}.001) and generational differences were also found (P=.04) in knowledge of digital therapy tools, though no significant differences were found for digital learning tools. Participants primarily used computers, tablets, and mobile phones; non–eHealth-specific tools (eg, word processing and videoconferencing applications); and digital formats such as videos, web courses, and apps. Many indicated a desire for more interactive platforms, such as virtual reality. Significant differences were found across generations for positive views toward digitalization (P{\textless}.001) and across profession for feelings of preparedness (P=.04). Interestingly, across profession (P=.03), generation (P=.006), and years of experience (P=.01), students and younger participants demonstrated greater support for medical certification. Commonly reported areas of concern included technical difficulties, quality and validity of digital materials, data privacy, and social presence. Respondents tended to prefer blended learning, a limited to moderate level of interactivity, and time and space–flexible learning environments (63/170, 37.1\%), with a notable proportion still preferring traditional time and space–dependent learning (49/170, 28.8\%).
Conclusions: This comprehensive investigation into the current state of CSD student and professional opinions and experiences has shown that incorporation of digital topics and skills into academic and professional development curricula will be crucial for ensuring that the field is prepared for the ever-digitalizing health care environment. Deeper empirical investigation into efficacy},
	language = {en-GB},
	number = {4},
	urldate = {2021-12-12},
	journal = {JMIR Medical Education},
	author = {Lin, Yuchen and Lemos, Martin and Neuschaefer-Rube, Christiane},
	month = nov,
	year = {2021},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Promotion:Argumentation, \#0:Zeitschriftenartikel:digital:learning, Bildung, Multimedia, Digitale Bildung, Promotion:FU3, mobile phone, communication disorders, digital learning, otolaryngology, phoniatrics, speech-language pathology, Promotion:S:12 Digital Learning, Promotion:Literaturverzeichnis},
	pages = {e30873},
	file = {Lin et al. - 2021 - Digital Health and Digital Learning Experiences Ac.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/ZZACGCJX/Lin et al. - 2021 - Digital Health and Digital Learning Experiences Ac.pdf:application/pdf},
}

@article{turner_uber_2022,
	title = {Über physische {Distanz} und emotionale {Nähe} im {Fernunterricht}: {Wie} kann es {Lehrer}*innen gelingen, mit {Schüler}*innen in {Kontakt} zu bleiben?},
	volume = {22},
	issn = {2190-4790},
	shorttitle = {Über physische {Distanz} und emotionale {Nähe} im {Fernunterricht}},
	url = {https://www.medienpaed-ludwigsburg.de/article/view/414},
	doi = {10/gp5vw5},
	abstract = {Die COVID-19 Pandemie hat den Schulalltag schlagartig verändert und war für die meisten Schüler*innen und Lehrer*innen durch Fernunterricht geprägt. Aufgrund der fortgeschrittenen Digitalisierung im Alltag und der Implementierung der Digitalen Grundbildung in Österreich (vgl. BMBWF 2018) sollte ein rascher Wechsel zum online-basierten Unterricht erfolgen. Dennoch waren jene Zeiten durch Herausforderungen, Unsicherheiten sowie physische Distanz für Lehrer*innen und Schüler*innen gekennzeichnet. Eine förderliche Lehr-Lernbeziehung sowie ein emotional positiver Kontakt sind neben technischem Equipment und digitalen Kompetenzen wesentliche Prädiktoren für gelingendes Lernen im digitalisierten (Fern-)Unterricht. In diesem Beitrag wird der Frage nachgegangen, inwiefern es Lehrer*innen in Zeiten des online-basierten Fernunterrichts gelungen ist, mit den Schüler*innen in (emotionalen) Kontakt zu bleiben.},
	language = {de-DE},
	urldate = {2022-05-16},
	journal = {Ludwigsburger Beiträge zur Medienpädagogik},
	author = {Turner, Agnes and Scherde, Tamina-Melanie},
	month = may,
	year = {2022},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:FU2a, Krisenreaktion im Bildungsbereich, \#9:Zeitschriftenartikel:digital:lernen, Promotion:S:09 Digital Lernen, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {1--12},
	annote = {Analyse des Artikels "Über physische Distanz und emotionale Nähe im Fernunterricht – Wie kann es Lehrerinnen gelingen, mit Schülerinnen in Kontakt zu bleiben?" von Agnes Turner und Tamina-Melanie Scherde (2022)
1. Identifizierung und Beschreibung der Hauptthemen und -ziele der Forschung:
Der Artikel untersucht, wie Lehrkräfte während der COVID-19-Pandemie im Fernunterricht trotz physischer Distanz eine emotionale Nähe zu ihren Schüler:innen aufrechterhalten können. Ziel ist es, die Strategien und Methoden zu identifizieren, die erfolgreich zur Aufrechterhaltung der Schüler:innen-Lehrer:innen-Beziehung beitragen, und die Herausforderungen zu analysieren, die im digitalen Unterricht auftreten.
2. Erkennung der verwendeten Methoden und Datenquellen:
Die Studie basiert auf 20 qualitativen Leitfadeninterviews mit Lehrkräften der Sekundarstufe 1 in Österreich, die zwischen Dezember 2020 und Mai 2021 durchgeführt wurden. Die Befragungen konzentrierten sich auf die Erfahrungen der Lehrkräfte hinsichtlich der Beziehungspflege im online-basierten Fernunterricht, der wahrgenommenen emotionalen Nähe und der technischen sowie pädagogischen Herausforderungen.
3. Erklärung der zentralen Forschungsergebnisse:
Die Ergebnisse zeigen, dass Lehrkräfte durch den Einsatz von Videokonferenzen, individueller Feedbackgestaltung und der Etablierung von virtuellen Sprechstunden in der Lage waren, eine emotionale Nähe zu ihren Schüler:innen aufrechtzuerhalten. Technische Herausforderungen und die fehlende physische Präsenz wurden als große Hürden empfunden, die durch gezielte Kommunikationsstrategien und das Verständnis der individuellen Lebensumstände der Schüler:innen teilweise kompensiert werden konnten.
Zusammenfassung
Kernpunkte des Artikels:


Problemstellung: Untersuchung der Aufrechterhaltung emotionaler Nähe zwischen Lehrkräften und Schüler:innen im online-basierten Fernunterricht während der COVID-19-Pandemie.


Methodik: Qualitative Leitfadeninterviews mit 20 Lehrkräften der Sekundarstufe 1.


Hauptergebnisse: Lehrkräfte konnten durch Videokonferenzen, individuelles Feedback und virtuelle Sprechstunden emotionale Nähe aufrechterhalten. Technische Herausforderungen und die fehlende physische Präsenz stellten jedoch erhebliche Hindernisse dar.


Schlussfolgerungen: Die Aufrechterhaltung emotionaler Nähe im Fernunterricht erfordert gezielte Kommunikationsstrategien, technisches Know-how und ein tiefes Verständnis der individuellen Bedürfnisse der Schüler:innen.


Kernaussagen


Videokonferenzen und individuelle Feedbackgestaltung sind entscheidend für die Aufrechterhaltung der emotionalen Nähe im Fernunterricht (S. 7).


Technische Herausforderungen und die fehlende physische Präsenz stellen erhebliche Hürden dar, die durch gezielte Kommunikationsstrategien teilweise kompensiert werden können (S. 6).


Ein tiefes Verständnis der individuellen Lebensumstände der Schüler:innen ist essentiell für eine erfolgreiche Beziehungspflege im digitalen Unterricht (S. 8).


Argumentationslinien


Aufbau der Argumente:


Einleitung: Bedeutung der emotionalen Nähe im Fernunterricht und die Herausforderungen der COVID-19-Pandemie.


Theoretischer Rahmen: Relevanz der Schüler:innen-Lehrer:innen-Beziehung und mentalisierungsbasierte Pädagogik.


Methoden: Beschreibung der qualitativen Leitfadeninterviews und deren Durchführung.


Ergebnisse: Analyse der erfolgreichen Strategien und der Herausforderungen im digitalen Unterricht.


Schlussfolgerungen: Implikationen für die Praxis und Empfehlungen für zukünftige digitale Unterrichtsstrategien.




Logische Verbindungen:


Verknüpfung von Theorie und Praxis: Durch die Anwendung der mentalisierungsbasierten Pädagogik auf die digitale Unterrichtspraxis.


Systematische Unterstützung: Durch die detaillierte Analyse der Interviews und die Ableitung praxisrelevanter Empfehlungen.




Verschlagwortung


Lehr- und Lerneffektivität: Der Artikel zeigt, wie digitale Kommunikationsstrategien die Effektivität der Beziehungspflege zwischen Lehrkräften und Schüler:innen im Fernunterricht verbessern können.


Krisenreaktion im Bildungsbereich: Die Studie untersucht, wie die COVID-19-Pandemie als Katalysator für die Entwicklung neuer Kommunikations- und Unterrichtsstrategien im digitalen Bildungsbereich diente.


Kategorisierung


Kerngedanke: Der zentrale Gedanke des Artikels ist die Bedeutung gezielter Kommunikationsstrategien und individueller Feedbackgestaltung für die Aufrechterhaltung emotionaler Nähe zwischen Lehrkräften und Schüler:innen im online-basierten Fernunterricht während der COVID-19-Pandemie.


Forschungsfragen Zuordnung


FU2a: Welchen Effekt erläutern Lernende im digitalen Bildungsraum von Gesundheitsberufen bei der Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems?


Der Artikel von Turner und Scherde passt zu dieser Forschungsfrage, da er die Auswirkungen gezielter Kommunikationsstrategien und individueller Feedbackgestaltung auf die emotionale Nähe und die Beziehungspflege im digitalen Unterricht analysiert. Insbesondere wird untersucht, wie diese Methoden dazu beitragen können, die Herausforderungen der physischen Distanz zu überwinden und eine effektive Lehr- und Lernbeziehung aufrechtzuerhalten.
},
	file = {Turner und Scherde - 2022 - Über physische Distanz und emotionale Nähe im Fern.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/79EI96SE/Turner und Scherde - 2022 - Über physische Distanz und emotionale Nähe im Fern.pdf:application/pdf},
}

