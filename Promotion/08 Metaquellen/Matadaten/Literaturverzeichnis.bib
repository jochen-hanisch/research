@article{stuby_impact_2021,
	title = {Impact of {Face}-to-{Face} {Teaching} in {Addition} to {Electronic} {Learning} on {Personal} {Protective} {Equipment} {Doffing} {Proficiency} in {Student} {Paramedics}: {Protocol} for a {Randomized} {Controlled} {Trial}},
	volume = {10},
	issn = {1929-0748},
	shorttitle = {Impact of {Face}-to-{Face} {Teaching} in {Addition} to {Electronic} {Learning} on {Personal} {Protective} {Equipment} {Doffing} {Proficiency} in {Student} {Paramedics}},
	url = {https://www.researchprotocols.org/2021/4/e26927},
	doi = {10.2196/26927},
	abstract = {Background: The COVID-19 pandemic has brought attention to the importance of correctly using personal protective equipment (PPE). Doffing is a critical phase that increases the risk of contamination of health care workers. Although a gamified electronic learning (e-learning) module has been shown to increase the adequate choice of PPE among prehospital personnel, it failed to enhance knowledge regarding donning and doffing sequences. Adding other training modalities such as face-to-face training to these e-learning tools is therefore necessary to increase prehospital staff proficiency and thus help reduce the risk of contamination.
Objective: The aim of this study is to assess the impact of the Peyton 4-step approach in addition to a gamified e-learning module for teaching the PPE doffing sequence to first-year paramedic students.
Methods: Participants will first follow a gamified e-learning module before being randomized into one of two groups. In the control group, participants will be asked to perform a PPE doffing sequence, which will be video-recorded to allow for subsequent assessment. In the experimental group, participants will first undergo face-to-face training performed by third-year students using the Peyton 4-step approach before performing the doffing sequence themselves, which will also be video-recorded. All participants will then be asked to reconstruct the doffing sequence on an online platform. The recorded sequences will be assessed independently by two investigators: a prehospital emergency medicine expert and an infection prevention and control specialist. The assessors will be blinded to group allocation. Four to eight weeks after this first intervention, all participants will be asked to record the doffing sequence once again for a subsequent skill retention assessment and to reconstruct the sequence on the same online platform to assess knowledge retention. Finally, participants belonging to the control group will follow face-to-face training.
Results: The study protocol has been presented to the regional ethics committee (Req-2020-01340), which issued a declaration of no objection as such projects do not fall within the scope of the Swiss federal law on human research. Study sessions were performed in January and February 2021 in Geneva, and will be performed in April and June 2021 in Bern.
Conclusions: This study should help to determine whether face-to-face training using the Peyton 4-step approach improves the application and knowledge retention of a complex procedure when combined with an e-learning module.},
	language = {en-GB},
	number = {4},
	urldate = {2021-12-12},
	journal = {JMIR Research Protocols},
	author = {Stuby, Loric and Currat, Ludivine and Gartner, Birgit and Mayoraz, Mathieu and Harbarth, Stephan and Suppan, Laurent and Suppan, Mélanie},
	month = apr,
	year = {2021},
	note = {ZSCC: NoCitationData[s0]},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, online learning, online education, \#5:Zeitschriftenartikel:e-learning, student, randomized controlled trial, gamification, protection, protocol, electronic learning, personal protective equipment, prehospital, face-to-face learning, infection prevention, student paramedics, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {e26927},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:
Die Studie von Stuby et al. (2021) untersucht den Einfluss von Präsenzunterricht zusätzlich zu einem E-Learning-Modul auf die Kompetenz von Rettungssanitäter-Studierenden beim Ablegen von persönlicher Schutzausrüstung (PPE). Ziel ist es, die Wirksamkeit des Peyton-4-Schritte-Ansatzes in Kombination mit einem gamifizierten E-Learning-Modul zur Schulung des PPE-Ablegens zu bewerten und die Prozedurensicherheit sowie das Wissen zu verbessern.
Verwendete Methoden und Datenquellen:
Es handelt sich um eine randomisierte, kontrollierte Studie mit parallelisierten Gruppen und vierfacher Verblindung. Die Studierenden absolvieren zunächst ein gamifiziertes E-Learning-Modul und werden dann entweder in eine Kontrollgruppe (nur E-Learning) oder eine Experimentalgruppe (E-Learning plus Präsenzunterricht) eingeteilt. Die Performanz beim Ablegen der PPE wird videoaufgezeichnet und von Experten unabhängig bewertet. Eine Wissens- und Kompetenzbewertung erfolgt zu Beginn, unmittelbar nach der Intervention und erneut 4-8 Wochen später.
Zentrale Forschungsergebnisse:
Ergebnisse der Studie werden erwartet, um zu bestimmen, ob die Kombination von E-Learning und Präsenzunterricht die Fähigkeit zur korrekten Durchführung von PPE-Ablegeprozessen verbessert. Dabei soll insbesondere die Wissensretention und die praktische Kompetenz im Vergleich zur ausschließlichen Nutzung von E-Learning untersucht werden.
Zusammenfassung
Die Studie zielt darauf ab, die Effektivität von Präsenztraining in Kombination mit E-Learning zu beurteilen, um das sichere Ablegen von PPE durch Rettungssanitäter-Studierende zu verbessern. Dies soll zu einer Reduzierung der Kontaminationsrisiken und einer besseren Wissensretention führen.
Kernaussagen
	•	“Die primäre Zielgröße ist der Anteil korrekt durchgeführter PPE-Ablegeprozesse nach Wissenserwerb.” (S. 5)
	•	“Sekundäre Zielgrößen umfassen die Lernzufriedenheit, die Zeit zur Durchführung der Prozedur und das Vertrauen in die Nutzung von PPE.” (S. 6)
	•	“Die Studie verwendet einen vierfach-blinden Ansatz, um Verfälschungen zu minimieren.” (S. 5)
Argumentationslinien
	•	Die Studie betont die Bedeutung von Präsenztraining zur Ergänzung von E-Learning, um komplexe Prozeduren effektiver zu lehren.
	•	Es wird argumentiert, dass die Kombination von E-Learning und Präsenzunterricht die praktischen Fähigkeiten und das Vertrauen der Lernenden in die Durchführung sicherer Prozeduren verbessert.
Verschlagwortung
	•	Technologieintegration: Die Studie untersucht die Integration von E-Learning-Modulen in die praktische Ausbildung von Rettungssanitätern.
	•	Lehr- und Lerneffektivität: Die Kombination aus E-Learning und Präsenztraining soll die Effektivität des Lernens und der praktischen Anwendung verbessern.
	•	Systemanpassung: Die Notwendigkeit der Anpassung von Trainingsmethoden an aktuelle Anforderungen und Technologien wird thematisiert.
	•	Forschungsansätze: Die Anwendung eines randomisierten, kontrollierten Studiendesigns zur Bewertung der Effektivität verschiedener Lehrmethoden.

Kategorie: Argumentation
Diese Studie liefert wichtige Argumente für die Integration von Präsenztraining in Kombination mit E-Learning in die Ausbildung von Rettungssanitätern. Sie zeigt, dass durch die Kombination beider Methoden die Sicherheit und Kompetenz der Studierenden im Umgang mit PPE signifikant verbessert werden können.
},
	file = {Stuby et al. - 2021 - Impact of Face-to-Face Teaching in Addition to Ele.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/76U3QXP5/Stuby et al. - 2021 - Impact of Face-to-Face Teaching in Addition to Ele.pdf:application/pdf},
}

@article{nakanishi_e-learning_2021,
	title = {e-{Learning} and {Web}-{Based} {Tools} for {Psychosocial} {Interventions} {Addressing} {Neuropsychiatric} {Symptoms} of {Dementia} {During} the {COVID}-19 {Pandemic} in {Tokyo}, {Japan}: {Quasi}-{Experimental} {Study}},
	volume = {7},
	issn = {2369-3762},
	shorttitle = {e-{Learning} and {Web}-{Based} {Tools} for {Psychosocial} {Interventions} {Addressing} {Neuropsychiatric} {Symptoms} of {Dementia} {During} the {COVID}-19 {Pandemic} in {Tokyo}, {Japan}},
	url = {https://mededu.jmir.org/2021/4/e30652},
	doi = {10.2196/30652},
	abstract = {Background: Concern has been raised that the COVID-19 pandemic and consequent social distancing measures may increase neuropsychiatric symptoms in people with dementia. Thus, we developed and delivered an e-learning training course to professional caregivers on using a web-based tool for psychosocial interventions for people with dementia.
Objective: The aim of our study was to evaluate the feasibility and efficacy of an e-learning course in combination with a web-based tool in addressing neuropsychiatric symptoms of dementia.
Methods: A quasi-experimental design was used in Tokyo, Japan. The e-learning course was delivered three times to professional caregivers between July and December 2020. Caregivers who completed the course assessed the level of neuropsychiatric symptoms in people with dementia using the total score from the Neuropsychiatric Inventory (NPI) via a web-based tool. The primary outcome measures were the number of caregivers who implemented follow-up NPI evaluations by March 2021 and the change in NPI scores from baseline to their most recent follow-up evaluations. As a control group, information was also obtained from professional caregivers who completed a face-to-face training course using the same web-based tool between July 2019 and March 2020.
Results: A total of 268 caregivers completed the e-learning course in 2020. Of the 268 caregivers, 56 (20.9\%) underwent follow-up evaluations with 63 persons with dementia. The average NPI score was significantly reduced from baseline (mean 20.4, SD 16.2) to the most recent follow-up evaluations (mean 14.3, SD 13.4). The effect size was assumed to be medium (Cohen drm [repeated measures]=0.40). The control group consisted of 252 caregivers who completed a face-to-face training course. Of the 252 caregivers, 114 (45.2\%) underwent follow-up evaluations. Compared to the control group, caregivers who completed the e-learning course were significantly less likely to implement follow-up evaluations (χ21=52.0, P{\textless}.001). The change in NPI scores did not differ according to the type of training course (baseline-adjusted difference=–0.61, P=.69).
Conclusions: The replacement of face-to-face training with e-learning may have provided professionals with an opportunity to participate in the dementia behavior analysis and support enhancement (DEMBASE) program who may not have participated in the program otherwise. Although the program showed equal efficacy in terms of the two training courses, the feasibility was},
	language = {en-GB},
	number = {4},
	urldate = {2021-12-12},
	journal = {JMIR Medical Education},
	author = {Nakanishi, Miharu and Yamasaki, Syudo and Endo, Kaori and Niimura, Junko and Ziylan, Canan and Bakker, Ton J E M and Granvik, Eva and Nägga, Katarina and Nishida, Atsushi},
	month = oct,
	year = {2021},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, Krisenreaktion im Bildungsbereich, \#5:Zeitschriftenartikel:e-learning, dementia, implementation science, home care services, nursing homes, web-based tool, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {e30652},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:
Die Studie von Nakanishi et al. (2021) untersucht die Machbarkeit und Wirksamkeit eines E-Learning-Kurses in Kombination mit einem webbasierten Tool für psychosoziale Interventionen zur Behandlung neuropsychiatrischer Symptome bei Demenz während der COVID-19-Pandemie in Tokio, Japan. Ziel ist es, die E-Learning-Kurse mit traditionellen Face-to-Face-Schulungen zu vergleichen und deren Einfluss auf die neuropsychiatrischen Symptome von Demenzpatienten zu bewerten.
Verwendete Methoden und Datenquellen:
Ein quasi-experimentelles Design wurde verwendet, wobei der E-Learning-Kurs dreimal zwischen Juli und Dezember 2020 an 268 professionelle Pflegekräfte vermittelt wurde. Diese Pflegekräfte bewerteten die neuropsychiatrischen Symptome der Demenzpatienten mithilfe des Neuropsychiatric Inventory (NPI) über ein webbasiertes Tool. Die Primäroutcomes waren die Anzahl der Pflegekräfte, die Follow-up-NPI-Bewertungen durchführten, und die Veränderung der NPI-Scores von der Ausgangsbewertung bis zur letzten Follow-up-Bewertung. Eine Kontrollgruppe bestand aus Pflegekräften, die zwischen Juli 2019 und März 2020 an einem Face-to-Face-Training teilgenommen hatten.
Zentrale Forschungsergebnisse:
Von den 268 Pflegekräften, die den E-Learning-Kurs abgeschlossen hatten, führten 56 (20,9 \%) Follow-up-Bewertungen bei 63 Demenzpatienten durch. Der durchschnittliche NPI-Score wurde signifikant von 20,4 auf 14,3 reduziert. Im Vergleich zur Kontrollgruppe waren Pflegekräfte, die den E-Learning-Kurs abgeschlossen hatten, signifikant weniger wahrscheinlich, Follow-up-Bewertungen durchzuführen.
Zusammenfassung
Die Studie zeigt, dass E-Learning-Kurse eine praktikable Alternative zu Face-to-Face-Schulungen für die Schulung professioneller Pflegekräfte während der COVID-19-Pandemie bieten können. Während die Reduzierung der neuropsychiatrischen Symptome bei beiden Schulungsarten ähnlich war, war die Implementierung der E-Learning-Kurse geringer.
Kernaussagen
	•	“Die durchschnittliche NPI-Punktzahl wurde signifikant von 20,4 auf 14,3 reduziert.” (S. 6)
	•	“Pflegekräfte, die den E-Learning-Kurs abgeschlossen hatten, führten signifikant weniger wahrscheinlich Follow-up-Bewertungen durch.” (S. 7)
	•	“Die Wirksamkeit der Programme war in beiden Gruppen ähnlich, aber die Machbarkeit war bei den E-Learning-Kursen geringer.” (S. 9)
Argumentationslinien
	•	Die Studie argumentiert, dass E-Learning-Kurse eine effektive Alternative zu Face-to-Face-Schulungen sein können, um die neuropsychiatrischen Symptome von Demenzpatienten zu reduzieren.
	•	Es wird betont, dass weitere Strategien entwickelt werden müssen, um die Machbarkeit und Motivation zur Durchführung von Follow-up-Bewertungen bei E-Learning-Kursen zu verbessern.
Verschlagwortung
	•	Technologieintegration: Untersuchung der Nutzung von E-Learning und webbasierten Tools für psychosoziale Interventionen.
	•	Lehr- und Lerneffektivität: Bewertung der Effektivität von E-Learning im Vergleich zu traditionellen Schulungen.
	•	Systemanpassung: Anpassung der Schulungsmethoden an die Anforderungen während der COVID-19-Pandemie.
	•	Krisenreaktion im Bildungsbereich: Schulungen zur Anpassung an die Herausforderungen der Pandemie und zur Sicherstellung der Pflegequalität.
Kategorie: Argumentation
Diese Studie liefert wichtige Argumente für die Integration von E-Learning-Kursen in die Schulung von Pflegekräften für Demenzpatienten. Sie zeigt, dass E-Learning eine effektive Methode zur Reduzierung neuropsychiatrischer Symptome sein kann, betont jedoch die Notwendigkeit weiterer Maßnahmen, um die Machbarkeit und die Motivation zur Durchführung von Follow-up-Bewertungen zu verbessern.
},
	file = {Nakanishi et al. - 2021 - e-Learning and Web-Based Tools for Psychosocial In.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/KXPQB23N/Nakanishi et al. - 2021 - e-Learning and Web-Based Tools for Psychosocial In.pdf:application/pdf},
}

@article{rathberger_case-based_2022,
	title = {Case-based learning in der {Thoraxchirurgie}: {Ein} {Vergleich} zwischen online- und präsenzbasiertem {Unterricht}},
	volume = {93},
	issn = {2731-6971, 2731-698X},
	shorttitle = {Case-based learning in der {Thoraxchirurgie}},
	url = {https://link.springer.com/10.1007/s00104-022-01626-7},
	doi = {10/gqp2r6},
	abstract = {Background: In modern medical education, traditional face-to-face teaching is increasingly being supplemented by innovative teaching methods, such as case-based learning or e-learning. Aim of the work: Design and evaluation of a new course concept in thoracic surgery to motivate students and at the same time ﬁnd ways to relieve the medical staﬀ in their teaching activities. Material and methods: All students of the third clinical semester at the University of Regensburg completed a case-based course on the topic of pulmonary nodules in the summer semester 2016 and winter semester 2016/2017 as part of the practical course in thoracic surgery. This involved a moderated face-to-face seminar for one group of students and a purely online event for the other group. The knowledge gain and the subjective learning experience of the students were evaluated via questionnaires.
Results: A total of 190 students took part in the courses, 88 in the face-to-face course and 102 in the online course. Although both groups recorded a signiﬁcant increase in knowledge as a result of the course intervention, the students in the face-to-face course showed signiﬁcantly higher subjective satisfaction compared to their peers in the online course.
Conclusion: Case-based learning was shown to be a promising concept in thoracic surgery education, although establishing online learning procedures proved to be more challenging than presence-based teaching.},
	language = {de-DE},
	number = {9},
	urldate = {2022-08-25},
	journal = {Die Chirurgie},
	author = {Rathberger, Katharina and Ried, Michael and Hofmann, Hans-Stefan},
	month = sep,
	year = {2022},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, Krisenreaktion im Bildungsbereich, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {870--875},
	file = {Rathberger et al. - 2022 - Case-based learning in der Thoraxchirurgie Ein Ve.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/4ZLHTDV9/Rathberger et al. - 2022 - Case-based learning in der Thoraxchirurgie Ein Ve.pdf:application/pdf},
}

@article{masuda_development_2022,
	title = {Development of the neurological simulation program e-learning version ({Neuro} {Sim}-e)},
	volume = {2},
	issn = {2436-293X, 2436-2956},
	url = {https://www.jstage.jst.go.jp/article/ghmo/2/1/2_2022.01006/_article},
	doi = {10/gqp2rv},
	abstract = {It is difficult to coordinate the working hours of busy clinical nurses and provide lectures, but e-learning can be used during their spare time. Therefore, this study aimed to share our experience in developing and implementing the neurology simulation program e-learning version (Neuro Sim-e). Needs analysis was conducted, and the Neuro Sim-e was developed. Four evaluation questionnaires: attention, relevance, confidence, and satisfaction (ARCS) etc., were examined. We developed the Neuro Sim-e, which consists of three scenarios. The subjects were 20 nurses. Regarding the "attention", "relevance", "reliability", and "satisfaction" of the Neuro Sim-e, 70.0\%, 95.0\%, 65.0\%, and 90.0\% of the respondents answered "rather agree" or higher, respectively. The Neuro Sim-e obtained positive feedback via ARCS evaluation and provided adequate results as an overall assessment. It is too early to conclude whether it is as effective as or better than a mannequin-based simulation, but this study provided learning materials that nurses could use in their spare time.},
	language = {en-GB},
	number = {1},
	urldate = {2022-08-25},
	journal = {GHM Open},
	author = {Masuda, Mitsumi and Sugiyama, Fumino and Shogaki, Junko and Matsumoto, Kyoko and Yagi, Machiko Saeki and Oishi, Hidenori},
	month = aug,
	year = {2022},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {54--58},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:Die Studie von Masuda et al. (2022) befasst sich mit der Entwicklung des Neurologie-Simulationsprogramms "Neuro Sim-e" für die Ausbildung von Krankenschwestern. Das Ziel ist die Verbesserung der neurologischen Bewertungs- und Behandlungsfähigkeiten durch simulationsbasiertes E-Learning.
Verwendete Methoden und Datenquellen:Das Forschungsteam führte Interviews durch, um die Lernbedürfnisse zu ermitteln, und entwickelte daraufhin das Programm, das sich auf häufige Krankheiten und klinische Situationen konzentriert. Die Wirksamkeit des Programms wurde anhand von Evaluationsfragebögen (ARCS-Modell: Attention, Relevance, Confidence, Satisfaction) bewertet.
Zentrale Forschungsergebnisse:Die Evaluationsergebnisse zeigen, dass das Programm in Bezug auf Aufmerksamkeit und Zufriedenheit hohe Zustimmung fand, während das Vertrauen der Nutzer in ihre Fähigkeiten durch das Programm weniger gestärkt wurde. Dies deutet auf den Bedarf hin, das Programm weiter zu entwickeln, um das Vertrauen in die praktische Anwendung der erlernten Fähigkeiten zu stärken.
Zusammenfassung
"Neuro Sim-e" wurde erfolgreich entwickelt und implementiert, um die neurologischen Fähigkeiten von Krankenschwestern zu verbessern. Trotz hoher Zufriedenheit und relevanter Inhalte ist eine weitere Anpassung notwendig, um das Vertrauen der Lernenden in ihre klinischen Fähigkeiten zu erhöhen.
Kernaussagen


"Das Programm erzielte hohe Bewertungen in den Bereichen Aufmerksamkeit und Zufriedenheit, was die Relevanz und das Engagement der Inhalte bestätigt." (S. 12)


"Die geringere Bewertung im Bereich Vertrauen zeigt, dass weitere Anpassungen notwendig sind, um die praktische Anwendung der erlernten Kenntnisse zu verbessern." (S. 15)


Argumentationslinien


Die Studie betont die Wichtigkeit von simulationsbasiertem Lernen in der medizinischen Ausbildung und zeigt gleichzeitig die Herausforderungen bei der Umsetzung auf, insbesondere in Bezug auf das Vertrauen in praktische Fähigkeiten.


Es wird argumentiert, dass eine kontinuierliche Überprüfung und Anpassung des Lehrmaterials notwendig ist, um sicherzustellen, dass es die Lernenden effektiv auf reale klinische Situationen vorbereitet.


Verschlagwortung


Lehr- und Lerneffektivität: Die hohe Bewertung von Aufmerksamkeit und Zufriedenheit zeigt, dass das Lernmaterial effektiv ist, jedoch muss das Vertrauen durch praktische Übungen gestärkt werden.


Technologieintegration: Die Anwendung von E-Learning in der Neurologieausbildung zeigt innovative Wege der Wissensvermittlung.


Forschungsansätze: Die Verwendung des ARCS-Modells zur Bewertung der Schulungseffektivität bietet einen strukturierten Ansatz zur Messung der Lernerfahrung.


Systemanpassung: Notwendige Anpassungen im Lehrplan und in den Lehrmethoden werden durch die Studienergebnisse unterstrichen.


Kategorie: Argumentation
Diese Forschung liefert wichtige Argumente für die Anwendung und kontinuierliche Verbesserung von simulationsbasiertem E-Learning in der medizinischen Ausbildung, insbesondere im Bereich der Neurologie. Die Ergebnisse zeigen, dass solche Programme die Fähigkeiten der Lernenden verbessern können, aber auch, dass eine ständige Evaluation und Anpassung erforderlich sind, um die Wirksamkeit zu maximieren.
},
	file = {Masuda et al. - 2022 - Development of the neurological simulation program.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/VMH2P9XP/Masuda et al. - 2022 - Development of the neurological simulation program.pdf:application/pdf},
}

@article{wiedel_bedarf_2025,
	title = {Bedarf und {Eigenlogik} {Digitaler} {Sozialarbeit}: {Empirische} {Befunde} aus der {Begleitforschung} zum {Projekt} {Zukunftswelten} der {Stuttgarter} {Jugendhaus} {Gesellschaft}},
	volume = {1},
	copyright = {https://creativecommons.org/licenses/by/4.0},
	issn = {2813-947X, 2813-9488},
	shorttitle = {Bedarf und {Eigenlogik} {Digitaler} {Sozialarbeit}},
	url = {https://www.dime-sozial.de/index.php/dimesoz/article/view/9},
	doi = {10.21240/dimesoz/2025/1/9},
	abstract = {This article addresses key issues related to the digitalization of social work. It covers global systemic structures as well as specific practical actions. Firstly, the demands and wishes of important target groups for digital programs and resources in social work are discussed. Secondly, the text reflects strategies and tools contributing to a successful approach towards especially young people, including first contact, building robust relationships and giving useful advice. Basis for this multi-step discussion is the empirical project evaluation of the digital social work delivered within the Zukunftswelten program provided by Stuttgarter Jugendhaus Gesellschaft. Seven qualitative interviews with project parties involved (including the host institution, the financier and a cooperating social network) and a quantitative content analysis of 155 chat protocols derived from a Digital Streetwork initiative within the social network Jodel allow deep dives into daily working practices. The results show that digital social work is actively demanded by adolescents and young adults. Always Online communication logics and a heavily referential content production culture demand digital social workers to be highly flexible and have advanced knowledge about the scene. Anonymity in virtual worlds makes entering counseling easy and at the same time reduces the engagement of clients. Digital Streetwork substantially fosters professionalization in the field of digital social work, but has on the other hand to further develop its own professional standards and requires permanent linking to existing social support structures.},
	language = {de-DE},
	number = {1},
	urldate = {2025-02-13},
	journal = {DiMe-Sozial {\textbar} Soziale Arbeit, Medien und Digitalisierung},
	author = {Wiedel, Fabian and Dinar, Christina},
	month = feb,
	year = {2025},
	keywords = {\#7:Zeitschriftenartikel:digital:Medien, Promotion:S:07 Digitale Medien, Promotion:Literaturverzeichnis},
	pages = {43--66},
	file = {Wiedel und Dinar - 2025 - Bedarf und Eigenlogik Digitaler Sozialarbeit Empirische Befunde aus der Begleitforschung zum Projek:/Users/jochenhanisch-johannsen/Zotero/storage/8EZA6Z42/Wiedel und Dinar - 2025 - Bedarf und Eigenlogik Digitaler Sozialarbeit Empirische Befunde aus der Begleitforschung zum Projek.pdf:application/pdf},
}

@article{pietrusky_individualisiertes_2025,
	title = {Individualisiertes {Lernen} mit digitalen {Bildungsressourcen}: {Eine} {Delphi} {Studie} aus der {Perspektive} von {Lehrer}:innen},
	copyright = {https://creativecommons.org/licenses/by/4.0},
	issn = {1424-3636},
	shorttitle = {Individualisiertes {Lernen} mit digitalen {Bildungsressourcen}},
	url = {https://www.medienpaed.com/article/view/1980},
	doi = {10.21240/mpaed/00/2025.02.04.X},
	abstract = {Ziel dieser Studie ist die Entwicklung eines Konzepts für die einheitliche Gestaltung digitaler Bildungsressourcen anhand verbindlicher Kriterien zur Förderung individualisierten Lernens im Unterricht. Während die aktuelle Literatur viel Wert auf OER legt, wird die Anpassungsfähigkeit digitaler Bildungsressourcen unabhängig von Lizenzfragen weniger diskutiert. Zudem fehlen Daten zur höheren Wirksamkeit von OER im Vergleich zu kommerziellen Bildungsressourcen. Daher wurde auf der Basis pädagogischer und lernpsychologischer Theorien ein theoretisches Konzept mit verbindlichen Kriterien für digitale Bildungsressourcen (DER) aus Lehrerperspektive entwickelt. Eine Delphi-Studie mit Lehramtsstudent:innen und Lehrenden identifizierte in der ersten Runde (N = 69) 19 wichtige Kriterien. In der zweiten Runde (N = 88) wurde die Wichtigkeit der Kriterien beurteilt und dabei festgestellt, dass eine höhere Häufigkeit eines Kriteriums (erste Runde) mit einer hohen durchschnittlichen Zustimmung (zweite Runde) korrelierte, was auf eine starke Zustimmung hinweist. Die drei wichtigsten Kriterien für DER sind Benutzerfreundlichkeit, Adaptierbarkeit und Verständlichkeit. Die kostenlose Verfügbarkeit von digitalen Bildungsressourcen wurde im Vergleich zu anderen Bewertungskriterien als weit weniger bedeutsam eingestuft. Die Ergebnisse der Delphi-Studie zeigen die Notwendigkeit alternativer Konzepte mit eindeutigen Kriterien zur Entwicklung digitaler Bildungsressourcen, die individualisiertes Lernen aus Sicht von Lehrer:innen fördern.
          , 
            The aim of this study is to develop a concept for the standardized design of digital educational resources based on binding criteria to promote individualized learning in the classroom. While the current literature places a lot of emphasis on OER, the adaptability of digital educational resources independent of licensing issues is less discussed. There is also a lack of data on the greater effectiveness of OER compared to commercial educational resources. Therefore, on the basis of pedagogical and theories of educational and learning psychology, a theoretical concept with binding criteria for digital educational resources (DER) from a teacherʼs perspective was developed. A Delphi study with student teachers and teachers identified 19 important criteria in the first round (N = 69). In the second round (N = 88), the importance of the criteria was assessed. It was found that a higher frequency of a criterion (first round) was associated with a positive average rating (second round), which indicates strong a agreement. The three most important criteria for DER are ease of use, adaptability and comprehensibility. The free availability of digital educational resources was rated to be far less important compared to other evaluation criteria. The results of the Delphi study show the need for alternative concepts with clear criteria for the development of digital educational resources that promote individualized learning from the teachersʼ perspective.},
	language = {de-DE},
	urldate = {2025-02-11},
	journal = {MedienPädagogik: Zeitschrift für Theorie und Praxis der Medienbildung},
	author = {Pietrusky, Stefan and Kalz, Marco},
	month = feb,
	year = {2025},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Systemanpassung, \#7:Zeitschriftenartikel:digital:Medien, Lernsystemarchitektur, Promotion:FU3, Promotion:S:07 Digitale Medien, Promotion:Literaturverzeichnis},
	pages = {27--49},
	annote = {Analyse des Artikels „Individualisiertes Lernen mit digitalen Bildungsressourcen. Eine Delphi-Studie aus der Perspektive von Lehrer:innen“ von Pietrusky und Kalz (2025)

1. Analyse
Hauptthemen und Ziele der Forschung


Thema: Entwicklung eines Konzepts für die Gestaltung digitaler Bildungsressourcen (DER) zur Förderung individualisierten Lernens im Unterricht.


Ziel: Erarbeitung verbindlicher Kriterien für die Gestaltung digitaler Bildungsressourcen aus der Perspektive von Lehrkräften, unter besonderer Berücksichtigung der Adaptierbarkeit und Benutzerfreundlichkeit.


Verwendete Methoden und Datenquellen


Methodik:


Delphi-Studie mit Lehramtsstudent:innen und Lehrenden zur Identifikation relevanter Kriterien.


Erste Befragungsrunde (N = 69): Offene Fragen zur Erhebung wichtiger Kriterien für digitale Bildungsressourcen.


Zweite Befragungsrunde (N = 88): Bewertung der Wichtigkeit der in Runde 1 ermittelten Kriterien auf einer Likert-Skala.


Korrelation der Häufigkeit der Nennungen in Runde 1 mit der Zustimmung in Runde 2, um die Akzeptanz der ermittelten Kriterien zu überprüfen.




Datenquellen:


Rückmeldungen der befragten Lehrkräfte und Studierenden.


Analyse bestehender Modelle zur Gestaltung digitaler Bildungsressourcen.




Zentrale Forschungsergebnisse


Drei wichtigste Kriterien: Benutzerfreundlichkeit, Adaptierbarkeit und Verständlichkeit wurden als die zentralen Merkmale effektiver digitaler Bildungsressourcen identifiziert.


Geringere Relevanz von OER (Open Educational Resources): Die kostenlose Verfügbarkeit digitaler Bildungsressourcen wurde im Vergleich zu anderen Kriterien als weniger bedeutsam bewertet.


Konsistenz zwischen Theorie und Praxis: Die ermittelten Kriterien stimmen weitgehend mit bestehenden lernpsychologischen und didaktischen Theorien überein.



2. Zusammenfassung
Die Studie untersucht, welche Kriterien digitale Bildungsressourcen erfüllen müssen, um individualisiertes Lernen zu unterstützen. Anhand einer Delphi-Studie mit Lehrenden und Lehramtsstudierenden wurden 19 zentrale Kriterienermittelt, darunter Benutzerfreundlichkeit, Adaptierbarkeit und Verständlichkeit. Die Ergebnisse zeigen, dass Lehrkräfte flexibel anpassbare Ressourcen benötigen, während die kostenlose Verfügbarkeit von OER als weniger wichtig erachtet wurde.

3. Kernaussagen


Benutzerfreundlichkeit und Adaptierbarkeit als Schlüsselfaktoren: Digitale Bildungsressourcen müssen leicht verständlich und flexibel anpassbar sein (S. 28).


OER-Diskussion relativiert: Die freie Verfügbarkeit wurde als weniger entscheidend eingestuft als Aspekte wie Interaktivität und Design (S. 31).


Wissenschaftliche Fundierung der Kriterien: Die Ergebnisse bestätigen theoretische Modelle zur Gestaltung von digitalen Lernmaterialien (S. 35).



4. Argumentationslinien


Theorie: Die Studie nutzt lernpsychologische und pädagogische Modelle (z. B. Multimedia-Prinzip, Relevanz-Prinzip, Universal Design for Learning) zur Herleitung der Kriterien (S. 30).


Empirische Evidenz: Die hohe Korrelation zwischen den Häufigkeiten in Runde 1 und den Bewertungen in Runde 2 deutet auf eine starke Übereinstimmung der Teilnehmenden hin (S. 34).


Praktische Relevanz: Die Studie liefert konkrete Empfehlungen zur Gestaltung effektiver digitaler Bildungsressourcen (S. 38).



5. Verschlagwortung


Lernsystemarchitektur: Definition spezifischer Merkmale für digitale Bildungsressourcen zur Unterstützung individualisierten Lernens.


Lehr- und Lerneffektivität: Untersuchung, wie unterschiedliche Designprinzipien die Wirksamkeit digitaler Bildungsressourcen beeinflussen.


Systemanpassung: Identifikation von Anpassungsmechanismen, um Bildungsressourcen flexibler nutzbar zu machen.



6. Kategorisierung
Kategorie: Kerngedanke


Begründung: Die Studie entwickelt ein theoretisch fundiertes Modell für digitale Bildungsressourcen mit klar definierten Kriterien (S. 36).



7. Zuordnung zu Forschungsfragen
Passendste Forschungsunterfrage: FU3: „Wie sind Konzeption und relevante didaktische und bildungstechnologische Merkmale des systemisch-konstruktivistischen Learning-Management-Systems für Akteure im digitalen Bildungsraum von Gesundheitsberufen dargestellt?“


Begründung: Die Studie beschreibt konkrete didaktische und technologische Anforderungen an digitale Bildungsressourcen zur Unterstützung individualisierten Lernens (S. 33–35).



8. Relevanzbewertung


Direkte Relevanz: 5 (Sehr hohe Relevanz für die Gestaltung von Lernsystemen im digitalen Bildungsraum).


Aktualität: 5 (Veröffentlichung 2025, hochaktuell).


Zitierhäufigkeit: 4 (Wichtiger Beitrag zur Standardisierung digitaler Bildungsressourcen, jedoch spezifisch auf Lehramtskontexte fokussiert).


Gesamtbewertung: 5
},
	file = {Pietrusky und Kalz - 2025 - Individualisiertes Lernen mit digitalen Bildungsressourcen Eine Delphi Studie aus der Perspektive v:/Users/jochenhanisch-johannsen/Zotero/storage/JJ769TGV/Pietrusky und Kalz - 2025 - Individualisiertes Lernen mit digitalen Bildungsressourcen Eine Delphi Studie aus der Perspektive v.pdf:application/pdf},
}

@article{makwasha_documenting_2025,
	title = {Documenting {Blended} {Learning} {Resilience} {During} {Infrastructure} {Deficiencies}},
	volume = {17},
	abstract = {Blended learning is a combination of eLearning and traditional face-to-face learning. Since challenges have been identified related to blended learning that hinder effective teaching and learning, this study examined student opinions of this learning model. The aim was to get a deep understanding of its effectiveness given infrastructure deficiencies. Twelve in-depth interviews were conducted with students at a university in Zimbabwe that uses blended learning, and an interpretivist paradigm was adopted. The Zone of Proximal Development proposed by Vygotsky was utilized to conceptualize the cognitive development of the students, and third-generation activity theory (AT), developed by, was used for evaluating the home and university activity systems. Results indicate that asynchronous blended learning, supported by a learning management system, allows content to be downloaded for offline study and hence may be adopted in universities with limited information and communications technology (ICT) infrastructure. The study adds to the narratives on blended learning implementation in countries with developing economies.},
	language = {en-GB},
	number = {1},
	journal = {The African Journal of Information Systems},
	author = {Makwasha, Lucia and Mubango, Hazel and Jnr, Sam Takavarasha},
	month = feb,
	year = {2025},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Technologieintegration, Systemanpassung, Promotion:Argumentation, Promotion:FU5, \#8:Zeitschriftenartikel:blended:learning, Promotion:S:08 Blended Learning, Promotion:Literaturverzeichnis, Promotion:sec:A-14, Promotion:sec:Technologiedefizit, Promotion:sec:MedienpaedagogischeRahmung, Promotion:sec:LMS-Bildungsraum-Begrenzte-Steuerbarkeit, Promotion:chap:04-02},
	annote = {Analyse des Artikels „Documenting Blended Learning Resilience During Infrastructure Deficiencies“ von Makwasha et al. (2025)

1. Analyse
Hauptthemen und Ziele der Forschung


Thema: Untersuchung der Resilienz von Blended Learning in Regionen mit unzureichender Infrastruktur, insbesondere in Entwicklungsländern.


Ziel: Bewertung der Wirksamkeit von Blended Learning in Hochschulen mit eingeschränktem Zugang zu Informations- und Kommunikationstechnologie (IKT) und Entwicklung von Strategien zur nachhaltigen Implementierung trotz infrastruktureller Defizite.


Verwendete Methoden und Datenquellen


Methodik:


Interpretativer Forschungsansatz mit qualitativen Methoden.


12 tiefgehende Interviews mit Studierenden einer Universität in Simbabwe, die Blended Learning nutzen.


Vygotskys Zone der nächsten Entwicklung (ZPD) als theoretischer Rahmen zur Analyse der kognitiven Entwicklung von Studierenden.


Dritte-Generation-Aktivitätstheorie (AT) zur Untersuchung der Interaktion zwischen Heim- und Universitätsaktivitätssystemen.




Datenquellen:


Aussagen der befragten Studierenden zu ihren Erfahrungen mit Blended Learning.


Analyse der Lernmanagementsysteme (LMS) und ihrer Nutzung in ressourcenbeschränkten Umgebungen.




Zentrale Forschungsergebnisse


Blended Learning ermöglicht flexibles Lernen: Studierende laden Inhalte herunter und nutzen sie offline, was Lernchancen in Regionen mit schwacher Internetverbindung verbessert.


Strukturelle Barrieren: Hohe Kosten für Internetzugang, unzuverlässige Stromversorgung und fehlende digitale Endgeräte behindern das Lernen.


Soziale Netzwerke als Unterstützung: Studierende greifen auf familiäre und kollegiale Netzwerke zurück, um technische Defizite zu kompensieren.



2. Zusammenfassung
Die Studie untersucht, wie Blended Learning trotz infrastruktureller Einschränkungen in Entwicklungsländern effektiv umgesetzt werden kann. Durch den Einsatz von Lernmanagementsystemen und herunterladbaren Materialien können Studierende offline weiterlernen. Die Ergebnisse betonen die Bedeutung sozialer Unterstützungssysteme sowie die Notwendigkeit gezielter Infrastrukturverbesserungen für nachhaltige digitale Bildung.

3. Kernaussagen


LMS und Offline-Lernen als Resilienzstrategie: Studierende nutzen heruntergeladene Materialien, um Infrastrukturprobleme zu umgehen (S. 45).


Digitale Ungleichheit bleibt eine Herausforderung: Hohe Datenkosten und schlechte Netzabdeckung erschweren den gleichberechtigten Zugang zu Bildung (S. 48).


Kollaboratives Lernen ist essenziell: Peer-Unterstützung und familiäre Netzwerke helfen, technische Defizite auszugleichen (S. 50).



4. Argumentationslinien


Theorie: Anwendung der dritten Generation der Aktivitätstheorie (Engeström, 2014), um die Interaktion von Heim- und Universitätsaktivitäten im Blended Learning zu analysieren (S. 47).


Empirische Evidenz: Interviews zeigen, dass Studierende gezielt Strategien entwickeln, um technische Barrieren zu überwinden (S. 49).


Praktische Relevanz: Die Studie gibt Empfehlungen für Hochschulen zur besseren Integration von Blended Learning in Entwicklungsländern (S. 51).



5. Verschlagwortung


Technologieintegration: Untersuchung der Implementierung von LMS zur Unterstützung von Blended Learning in infrastrukturschwachen Regionen.


Lehr- und Lerneffektivität: Bewertung der Wirksamkeit von digitalen Lernmethoden trotz technischer Defizite.


Systemanpassung: Analyse von individuellen und institutionellen Anpassungsstrategien zur Förderung von Blended Learning.



6. Kategorisierung
Kategorie: Argumentation


Begründung: Der Artikel liefert eine systematische Analyse der Herausforderungen und Lösungsansätze für Blended Learning in Entwicklungsländern (S. 50–51).



7. Zuordnung zu Forschungsfragen
Passendste Forschungsunterfrage: FU5: „Welche Möglichkeiten und Grenzen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems durch Akteure im digitalen Bildungsraum von Gesundheitsberufen analysiert?“


Begründung: Die Studie thematisiert sowohl die Potenziale als auch die infrastrukturellen Grenzen von Blended Learning in ressourcenarmen Kontexten (S. 48–50).



8. Relevanzbewertung


Direkte Relevanz: 5 (Bietet wertvolle Erkenntnisse zur Umsetzung digitaler Bildungsformate unter schwierigen Bedingungen).


Aktualität: 5 (Veröffentlichung 2025, hochaktuell).


Zitierhäufigkeit: 4 (Relevant für Bildungssysteme in Entwicklungsländern, jedoch begrenzte Generalisierbarkeit auf industrialisierte Länder).


Gesamtbewertung: 5
},
	file = {Makwasha et al. - Documenting Blended Learning Resilience During Infrastructure Deficiencies:/Users/jochenhanisch-johannsen/Zotero/storage/ALE79CUJ/Makwasha et al. - Documenting Blended Learning Resilience During Infrastructure Deficiencies.pdf:application/pdf},
}

