@misc{statista_research_department_anteil_2024,
	type = {Statistik},
	title = {Anteil der {Personen} in ausgewählten {Ländern} in {Europa}, die {Online}-{Lernmaterialien} nutzen},
	url = {https://de.statista.com/statistik/daten/studie/1101169/umfrage/anteil-der-nutzer-von-online-lernmaterialien-in-ausgewaehlten-laendern-in-europa/},
	abstract = {In den Niederlanden nutzten 47,6 Prozent der Bevölkerung im Jahr 2023 Online-Lernmaterialien. In Deutschland belief sich der Anteil der Nutzer von Online-Lernmaterialien laut Eurostat auf 18 Prozent. Im Durchschnitt der EU-Länder lag der Anteil bei 23,3 Prozent.},
	language = {de-DE},
	urldate = {2024-10-23},
	publisher = {Statista Research Department},
	author = {{Statista}},
	month = sep,
	year = {2024},
	note = {@statista research department\_anteil\_2024},
	keywords = {Promotion:1.1.3, Promotion:\# Abbildungen (ohne Quelle), Promotion:1.1.3 Thematische Relevanz, Promotion:Literaturverzeichnis},
	annote = {Diese Abbildung („Anteil der Personen in ausgewählten Ländern in Europa, die Online-Lernmaterialien nutzen, im Jahr 2023“; Quelle: Eurostat, via Statista 2024) kann sinnvoll in Deine Dissertation eingebunden werden, sofern sie kontextualisiert und nicht instrumentell verwendet wird. Im Folgenden eine differenzierte Bewertung:
Begründete Einordnung in Deine Arbeit
1. Thematische Anschlussfähigkeit
Die Grafik fokussiert auf die Nutzungshäufigkeit von Online-Lernmaterialien, also auf ein Kernelement digitaler Bildungsräume. Dieser Bezug ist anschlussfähig an Deine Argumentation über Wirkung, Verbreitung und strukturelle Kopplung digitaler Lernsysteme (insbesondere im Abschnitt zur didaktischen Architektur oder zum gesellschaftlichen Kontext digitaler Bildungsräume).
2. Internationale Vergleichsperspektive
Durch die Darstellung europäischer Vergleichszahlen wird sichtbar, dass Deutschland mit 18,08 \% deutlich unter dem EU-Durchschnitt (23,34 \%) liegt. Das lässt sich analytisch nutzen:
als Indikator für digitale Transformationsdefizite in Deutschland,
als Kontrastfolie zur spezifischen Implementierung Deines LMS,
oder als Ausgangspunkt für eine Kritik an nationalen Förderlogiken, die eher Verwaltung als pädagogisch-didaktische Wirkung fokussieren.
3. Empirische Rückbindung an gesamtgesellschaftliche Verbreitung
Du arbeitest mit einem systemisch-dynamischen Wirkgefüge, das sich im realen Feld nur dann entfalten kann, wenn die Umgebungsbedingungen anschlussfähig sind. Die Grafik kann genutzt werden, um zu zeigen, dass die gegenwärtige gesellschaftliche Systemkopplung mit digitalen Bildungsformen in Deutschland eher schwach ist – was wiederum den besonderen Charakter Deines prototypisch entwickelten Systems unterstreicht.
Didaktisch-rhetorischer Einsatzvorschlag
Kapitelanschluss:
Einbettung in Kapitel 3.1.1 (rechtlich-funktionale Rahmung) oder 3.1.2 (didaktisch-strukturelle Verortung).
Alternativ in einer Einleitungspassage zu Abschnitt 2.3.4 (Gestaltungsprinzipien zur Kopplung), um auf gesellschaftliche Voraussetzungen von Systemkopplung hinzuweisen.
Begleittext (mögliches Framing):
„Die Nutzung digitaler Lernangebote variiert europaweit stark. Während in den Niederlanden knapp die Hälfte der Bevölkerung entsprechende Materialien verwendet, liegt Deutschland deutlich unter dem EU-Durchschnitt. Dies verweist auf eine gesellschaftlich-strukturelle Entkopplung digitaler Bildungsräume, die wiederum zur Besonderheit und Notwendigkeit eigeninitiierter Systemkopplungen im Rahmen dieser Dissertation führt.“
Fazit:
Einbinden möglich und sinnvoll, insbesondere zur Kontrastierung von Makrostruktur (nationale Bildungsdigitalisierung) und Mikrostruktur (konkrete Implementierung des LMS). Die Grafik liefert keine kausalen Belege, aber einen plausiblen kontextuellen Resonanzraum für Deine Analyse.
},
	file = {Statista - 2024 - Anteil der Personen in ausgewählten Ländern in Europa, die Online-Lernmaterialien nutzen:/Users/jochenhanisch-johannsen/Zotero/storage/JP2TQ4NH/Statista - 2024 - Anteil der Personen in ausgewählten Ländern in Europa, die Online-Lernmaterialien nutzen.png:image/png},
}

@misc{statista_research_department_umsatze_2024,
	type = {Statistik},
	title = {Umsätze im {Markt} für {Online}-{Bildung} nach {Segmenten}},
	url = {https://de.statista.com/statistik/daten/studie/1401742/umfrage/umsatz-markt-online-bildung-weltweit-segmente/},
	abstract = {Laut Statista Market Insights wurden in den USA im Jahr 2022 rund 61,3 Milliarden US-Dollar im Markt für Online-Bildung erwirtschaftet. Die Vereinigten Staaten dominieren den Markt damit gemeinsam mit China (46,9 Milliarden US-Dollar) - auf dem dritten Platz folgt mit großem Abstand das Vereinigte Königreich. Hier wurden im Jahr 2022 rund acht Milliarden US-Dollar umgesetzt.},
	language = {de-DE},
	urldate = {2024-10-23},
	publisher = {Statista Research Department},
	author = {{Statista}},
	year = {2024},
	note = {@statista research department\_umstze\_2024},
	keywords = {Promotion:1.1.3 Thematische Relevanz, Promotion:Literaturverzeichnis},
	annote = {Diese Abbildung zur Marktentwicklung im globalen Online-Bildungsmarkt ist mit Einschränkungen gut einsetzbar – allerdings nicht als didaktische oder bildungswissenschaftliche Evidenz, sondern als strategischer Diskursanker im Sinne von Kontextualisierung, Trendbeobachtung und Argumentationsverstärkung.

Einordnung: Strategisch verwendbar, theoriefern
1. Zeigt:


Eine prognostische Umsatzentwicklung bis 2027,


mit klarer Dominanz der Online-Hochschulbildung,


und einem signifikanten Wachstum im Bereich beruflicher Zertifikate und E-Learning-Plattformen.


2. Nutzen für deine Dissertation:




Möglicher Zweck


Einsatz in der Arbeit




Kontextualisierung der ökonomischen Relevanz


Einleitung (Kap. 1), Theorieteil (Kap. 2) oder Diskussion (Kap. 6), um den globalen Bedeutungszuwachs digitaler Bildungsräume zu rahmen.




Abgrenzung


Hinweis, dass deine Arbeit nicht auf monetäre Logiken, sondern auf systemisch-konstruktive Wirkgefüge zielt.




Marktdruck / Externes Umfeld


Diskussion: Wie Marktmechanismen zunehmen auf Bildungsarchitekturen einwirken – und weshalb dem ein theoriefundiertes Modell entgegenstehen sollte.




3. Mögliche Formulierung:

„Während der globale Online-Bildungsmarkt ein massives Umsatzwachstum verzeichnet (vgl. Abb. X), insbesondere im Bereich beruflicher Zertifikate und Plattformangebote, richtet sich diese Arbeit nicht auf ökonomische Marktanalysen, sondern auf die Rekonstruktion der systemischen Wirklogik digitaler Lernräume im Bildungsfeld der Gesundheitsberufe. Der Kontrast markiert eine doppelte Herausforderung: steigende ökonomische Erwartungen bei gleichzeitig unzureichend verstandenen Wirkmechanismen.“


Einschränkungen:


Statista-Prognose: keine Peer-Review-Quelle, methodologisch intransparent – muss also als Marktprognosegekennzeichnet bleiben.


Wirtschaftliche Metrik (Umsatz) ≠ Bildungsqualität, Lernwirkung oder pädagogische Relevanz.


Globale Datenbasis: Für die gesundheitsberufliche Ausbildung in Deutschland nur als Makro-Rahmungeinsetzbar.



Fazit: Verwendbar – mit expliziter Kommentierung
✔ Sinnvoll, wenn du:


das Bild nicht zur Erklärung von Bildungswirkung verwendest,


wirtschaftliche Umfeldbedingungen oder Diskurspfade (EdTech, Zertifikatsmärkte) thematisieren willst,


und deinen erkenntnistheoretischen Fokus abgrenzt („nicht was verkauft wird, sondern wie gewirkt wird“).


✘ Nicht geeignet, wenn:


es als Beleg für didaktische Wirkung, Lernprozessanalyse oder Systemfunktion herangezogen würde.



Empfohlener Ort:


Kapitel 1.1 (Kontext, Relevanz),


Kapitel 2 (Diskursanalyse, Theorierahmung),


oder Kapitel 6 (Diskussion – Rahmenbedingungen, Anschlussfähigkeit an bildungspolitische Realitäten).


},
	file = {Statista - 2024 - Umsätze im Markt für Online-Bildung nach Segmenten:/Users/jochenhanisch-johannsen/Zotero/storage/EELCVPNX/Statista - 2024 - Umsätze im Markt für Online-Bildung nach Segmenten.png:image/png},
}

