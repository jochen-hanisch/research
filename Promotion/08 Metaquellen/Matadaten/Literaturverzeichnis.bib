@phdthesis{plch_exploring_2025,
	type = {Dissertation},
	title = {Exploring {Healthcare} {Students}’ {Perceptions} of {Simulation}-{Based} {Learning}},
	abstract = {This dissertation explores how students in medical and healthcare disciplines perceive simulation-based learning (SBL), an educational approach increasingly used in medical education to enhance experiential learning. The research addresses three overarching questions through four studies that combine integrative and scoping reviews with empirical qualitative research. The first study examines medical students’ perceptions of Technology-Enhanced Learning (TEL), revealing strong preferences for blended formats and high engagement with simulation tools. The second study investigates how students perceive simulation-based first-aid training, identifying key factors such as team communication, emotional responses, fidelity, and the importance of structured debriefing. The third and fourth studies focus on healthcare students’ broader perceptions, beliefs, and attitudes toward SBL, analyzing 126 studies and 6 doctoral theses through the lens of the 4P model (Presage, Perception, Process, Product). Findings demonstrate that student perceptions are shaped not only by instructional design and simulation modality, but also by emotional responses, team dynamics, and hierarchical structures present in clinical training environments. Fidelity and debriefing emerged as critical factors influencing the perceived effectiveness of simulations. This dissertation also contributes methodologically by demonstrating the relevance of secondary research – particularly evidence synthesis – to theory development in educational sciences. An adapted 4P model is proposed, integrating student-centered insights to provide a more comprehensive framework for understanding simulation-based learning. The findings offer a deeper understanding of how healthcare students experience SBL and highlight areas for further investigation and reflection in medical education research.},
	language = {en-GB},
	school = {Masaryk University, Faculty of Arts, Department of Educational Sciences, Programme Educational Sciences},
	author = {Plch, Mgr Lukáš},
	year = {2025},
	keywords = {Simulation, Charité:Promotion, Promotion:Literaturanalyse, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Bewertungsmethoden, Promotion:FU2a, Notfallsanitäter, Promotion:Schlussfolgerung, Rettungsdienst, \#8:Dissertation:blended:learning, Promotion:S:16 Dissertationen, Promotion:Literaturverzeichnis},
	file = {PDF:/Users/jochenhanisch-johannsen/Zotero/storage/NCJJNZ8E/Plch - Exploring Healthcare Students’ Perceptions of Simulation-Based Learning.pdf:application/pdf},
}

@article{tam_implementation_2025,
	title = {Implementation of hybrid simulation training to promote collective and self-efficacy in medical students: a two-pronged approach},
	volume = {57},
	copyright = {http://creativecommons.org/licenses/by-nc/4.0/},
	issn = {0785-3890, 1365-2060},
	shorttitle = {Implementation of hybrid simulation training to promote collective and self-efficacy in medical students},
	url = {https://www.tandfonline.com/doi/full/10.1080/07853890.2025.2527362},
	doi = {10.1080/07853890.2025.2527362},
	abstract = {Introduction: Simulation-based training (SBT) is an integral and indispensable component of medical and healthcare education, especially pertinent in acute care. Conventional forms of SBT in acute care primarily involve manikins or task trainers, which are either costly or too task-specific. Recent innovations in virtual patient simulation software (VPS) invites the opportunity for conjoined use with basic manikins, creating a hybrid model for acute-care teaching. This study aimed to: ① Assess the impact of hybrid simulation teaching on the collective efficacy (CE) and self-efficacy (SE) of medical students, and ② evaluate psychometric measurement scales within the simulation context.
Methods: A prospective cross-sectional cohort study was conducted between 22 September 2023, and 19 December 2023. Fifth year medical students in an undergraduate medicine program underwent hybrid SBT, incorporating VPS and basic manikin within two separate clinical scenarios. Primary outcome of CE and SE was measured using adapted versions of the Perceived Collective Efficacy (PCE) scale and Motivational Strategies for Learning Questionnaire (MSLQ). Both scales were distributed to students before and after undergoing hybrid SBT.
Results: Data from 94 students were available for pairwise testing. Significant improvements were observed in the CE and SE of students after undergoing hybrid SBT [CE: (12.16 ± 3.86 vs 15.42 ± 2.87); p {\textless} 0.001]; [SE: 24(23–32) vs 32(28–34); p {\textless} 0.001]. Scale evaluation of Perceived Collective Efficacy (PCE) and Motivational Strategies for Learning Questionnaire (MSLQ) revealed good scale Cronbach α scores [PCE: pretest α = 0.929; posttest α = 0.914]; [MSLQ: pretest α = 0.971.; posttest α = 0.968].
Conclusion: Hybrid SBT facilitated by virtual patient simulator and basic manikin provides a moderate-cost and adaptable approach which positively impacted the CE and SE of medical students. As software development readily adapts in providing point-of-care learner feedback, hybrid SBT should become more widely implemented to fully harness its potential.},
	language = {en},
	number = {1},
	urldate = {2025-07-12},
	journal = {Annals of Medicine},
	author = {Tam, Calvin Yuk Wang and Dizon, John Ian Wilzon T. and Sin, Simon Wai Ching and Tang, Gloria Kai Yan and Lai, Victor Yuk Wah and Wong, Yvonne Yin and Ganotice, Fraide A. and Yeung Ng, Pauline},
	month = dec,
	year = {2025},
	note = {Publisher: Informa UK Limited},
	keywords = {Charité:Promotion, Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Technologieintegration, Bewertungsmethoden, Promotion:FU2a, Promotion:Schlussfolgerung, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	file = {PDF:/Users/jochenhanisch-johannsen/Zotero/storage/UHAGVYP2/Tam et al. - 2025 - Implementation of hybrid simulation training to promote collective and self-efficacy in medical stud.pdf:application/pdf},
}

