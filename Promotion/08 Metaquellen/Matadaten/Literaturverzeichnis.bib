@article{ngenzi_information_2021,
	title = {Information and communication technology to enhance continuing professional development ({CPD}) and continuing medical education ({CME}) for {Rwanda}: a scoping review of reviews},
	volume = {21},
	issn = {1472-6920},
	shorttitle = {Information and communication technology to enhance continuing professional development ({CPD}) and continuing medical education ({CME}) for {Rwanda}},
	url = {https://bmcmededuc.biomedcentral.com/articles/10.1186/s12909-021-02607-w},
	doi = {10/gs5685},
	abstract = {Background: Access to high quality continuing professional development (CPD) is necessary for healthcare professionals to retain competency within the ever-evolving worlds of medicine and health. Most low- and middleincome countries, including Rwanda, have a critical shortage of healthcare professionals and limited access to CPD opportunities. This study scoped the literature using review articles related to the use of information and communication technology (ICT) and video conferencing for the delivery of CPD to healthcare professionals. The goal was to inform decision-makers of relevant and suitable approaches for a low-income country such as Rwanda.
Methods: PubMed and hand searching was used. Only review articles written in English, published between 2010 and 2019, and reporting the use of ICT for CPD were included.
Results: Six review articles were included in this study. Various delivery modes (face to face, pure elearning and blended learning) and technology approaches (Internet-based and non-Internet based) were reported. All types of technology approach enhanced knowledge, skills and attitudes. Pure elearning is comparable to face-to-face delivery and better than ‘no intervention’, and blended learning showed mixed results compared to traditional faceto-face learning. Participant satisfaction was attributed to ease of use, easy access and interactive content.
Conclusion: The use of technology to enhance CPD delivery is acceptable with most technology approaches improving knowledge, skills and attitude. For the intervention to work effectively, CPD courses must be well designed: needs-based, based on sound educational theories, interactive, easy to access, and affordable. Participants must possess the required devices and technological literacy.},
	language = {en-GB},
	number = {1},
	urldate = {2023-11-18},
	journal = {BMC Medical Education},
	author = {Ngenzi, Joseph Lune and Scott, Richard E. and Mars, Maurice},
	month = dec,
	year = {2021},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Technologieintegration, Systemanpassung, Promotion:Argumentation, Promotion:FU3, \#8:Zeitschriftenartikel:blended:learning, Promotion:S:08 Blended Learning, Promotion:Literaturverzeichnis},
	pages = {245},
	annote = {Analyse der Studie "Information and communication technology to enhance continuing professional development (CPD) and continuing medical education (CME) for Rwanda: a scoping review of reviews" von Joseph Lune Ngenzi et al. (2021)


Hauptthemen und Ziele der Forschung: Die Studie untersucht, wie Informations- und Kommunikationstechnologien (IKT) genutzt werden können, um die berufliche Weiterbildung (CPD) und die medizinische Fortbildung (CME) im Gesundheitssektor Ruandas zu verbessern. Ziel der Forschung ist es, verschiedene technologische Ansätze zu identifizieren, die für die Schulung von Fachkräften in Ländern mit niedrigem Einkommen geeignet sind, wobei ein besonderer Fokus auf Ruanda liegt.


Methoden und Datenquellen: Diese Arbeit basiert auf einer Scoping Review, die sich auf systematische Übersichtsarbeiten stützt, die in wissenschaftlichen Datenbanken wie PubMed zwischen 2010 und 2019 veröffentlicht wurden. In die Analyse wurden sechs systematische Übersichtsarbeiten einbezogen, die den Einsatz von IKT in der beruflichen Weiterbildung von Gesundheitspersonal untersuchten. Dabei wurde insbesondere die Effektivität von Technologien wie E-Learning, Videokonferenzen und Blended Learning analysiert.


Zentrale Forschungsergebnisse:


Die Studie zeigt, dass der Einsatz von IKT in der beruflichen Weiterbildung von Gesundheitspersonal die Wissensvermittlung, Fertigkeiten und Einstellungen der Teilnehmenden verbessern kann. Insbesondere E-Learning erwies sich als genauso effektiv wie traditionelle Präsenzschulungen.


Blended Learning-Ansätze zeigten gemischte Ergebnisse im Vergleich zu reinen Präsenzmethoden.


Teilnehmer schätzten besonders die einfache Zugänglichkeit und die interaktiven Inhalte von E-Learning-Programmen, wobei Videokonferenzen eine hohe Zufriedenheit aufgrund der Interaktivität boten.


Für eine erfolgreiche Implementierung in Ländern wie Ruanda müssen Fortbildungsprogramme gut durchdacht und an die lokalen Bedürfnisse und Infrastrukturen angepasst sein.




Zusammenfassung: Die Studie hebt hervor, dass IKT-basierte Ansätze wie E-Learning und Videokonferenzen eine effektive Möglichkeit darstellen, um CPD-Programme in Ländern mit begrenzter Infrastruktur wie Ruanda anzubieten. Allerdings erfordern diese Programme eine sorgfältige Planung und Anpassung an die lokalen Gegebenheiten, einschließlich der Verfügbarkeit von Technologie und der Schulung der Teilnehmenden im Umgang mit den Systemen.


Kernaussagen:


E-Learning ist ebenso effektiv wie traditionelle Präsenzschulungen für die Weiterbildung von Gesundheitspersonal in Ruanda (S. 3).


Teilnehmer sind besonders zufrieden mit der Benutzerfreundlichkeit und den interaktiven Inhalten von Videokonferenzen und E-Learning-Angeboten (S. 4).


Blended Learning, das sowohl Präsenz- als auch Online-Lernen kombiniert, zeigt unterschiedliche Ergebnisse, abhängig von der spezifischen Umsetzung (S. 6).




Argumentationslinien: Die Autoren argumentieren, dass der Einsatz von IKT ein Schlüssel zur Verbesserung der medizinischen Fortbildung in Entwicklungsländern sein kann, da er kosteneffizient und zugänglich ist. Sie betonen jedoch, dass Programme gut strukturiert und an die spezifischen Bedürfnisse und technischen Fähigkeiten der Teilnehmenden angepasst sein müssen, um effektiv zu sein (S. 5-6).


Verschlagwortung:


Technologieintegration: Die Studie untersucht die Rolle von IKT bei der Implementierung von Weiterbildungsprogrammen für Gesundheitsfachkräfte, insbesondere in der Nutzung von E-Learning und Videokonferenzen.


Lehr- und Lerneffektivität: Der Einsatz von IKT, insbesondere E-Learning, wird als effektive Methode zur Steigerung der Wissensvermittlung und der praktischen Fähigkeiten von Gesundheitspersonal bewertet.


Systemanpassung: Die Studie unterstreicht die Bedeutung der Anpassung von Lernsystemen an die spezifischen technischen und infrastrukturellen Bedingungen in Entwicklungsländern wie Ruanda.




Kategorisierung:


Argumentation: Die Studie stützt ihre Empfehlungen auf eine umfassende Literaturübersicht und betont die Notwendigkeit gut durchdachter, lokalisierter E-Learning-Programme zur beruflichen Weiterbildung im Gesundheitswesen.




Zuordnung zu den Forschungsfragen: Die Studie passt zu der Forschungsfrage FU3: „Wie sind Konzeption und relevante didaktische und bildungstechnologische Merkmale des systemisch-konstruktivistischen Learning-Management-Systems für Akteure im digitalen Bildungsraum von Gesundheitsberufen dargestellt?“


Begründung: Die Studie analysiert die Nutzung und Implementierung von IKT und E-Learning-Systemen in der beruflichen Weiterbildung, was direkte Parallelen zur Gestaltung und Implementierung von Learning-Management-Systemen im Bildungsbereich aufweist.




Relevanzbewertung:




5 - Hoch relevant: Die Studie bietet wertvolle Erkenntnisse zur effektiven Implementierung von IKT-basierten Weiterbildungsprogrammen in Entwicklungsländern und trägt zur Diskussion um die Gestaltung von Lernsystemen in der medizinischen Fortbildung bei.


},
	file = {Ngenzi et al. - 2021 - Information and communication technology to enhanc.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/5LVW43EU/Ngenzi et al. - 2021 - Information and communication technology to enhanc.pdf:application/pdf},
}

@article{cui_effectiveness_2023,
	title = {Effectiveness of flipped classroom in pharmacy education – a meta-analysis},
	volume = {23},
	issn = {1472-6920},
	url = {https://bmcmededuc.biomedcentral.com/articles/10.1186/s12909-023-04865-2},
	doi = {10/gs565t},
	abstract = {Background  Flipped classroom, blended with online and offline learning, was regarded as an effective learning approach in pharmacy education. This meta-analysis was to comprehensively compare the effectiveness of flipped classroom and traditional lecture-based approaches, attempting to generate a unified and firm conclusion of the effectiveness of flipped classroom in pharmacy education.
Methods  Data were collected from 7 databases, involving Cochrane Library, PubMed, Embase, ScienceDirect, Web of Science, China National Knowledge Infrastructure (CNKI), and Chinese Biomedical Literature Service System (SinoMed). The studies were included if they included objective evaluation of students’ performance between groups of flipped classroom and traditional approaches. The standardized mean difference (SMD) with a corresponding 95\% confidence interval (95\% CI) was used as the outcomes for data pooling.
Results  A total of 22 studies (28 comparing groups) with 4379 participants were included in the meta-analysis. The risk of bias was relatively high. Results of the analysis revealed that flipped classroom presented significant advantages over traditional approaches in student performance improvement, with no evidence of publication bias. Through subgroup analysis, it showed better outcomes for flipped classrooms over traditional lectures for the other subgroups, including different performance, degree programs.
Conclusions  Current evidence reveals that the flipped classroom approach in pharmacy education yields a statistical improvement in student learning compared with traditional methods. In the future, instructors should introduce more online technology into classroom and construct an interactive learning environment.},
	language = {en-GB},
	number = {1},
	urldate = {2023-11-18},
	journal = {BMC Medical Education},
	author = {Cui, He and Xie, Xinyu and Wang, Boyang and Zhao, Yuan},
	month = nov,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Technologieintegration, Bewertungsmethoden, Promotion:FU2a, Promotion:Argumentation, \#8:Zeitschriftenartikel:blended:learning, Promotion:S:08 Blended Learning, Promotion:Literaturverzeichnis},
	pages = {881},
	annote = {Analyse der Studie "Effectiveness of Flipped Classroom in Pharmacy Education – A Meta-Analysis" von He Cui et al. (2023)


Hauptthemen und Ziele der Forschung: Die Studie untersucht die Wirksamkeit des „Flipped Classroom“-Ansatzes im Vergleich zu traditionellen Lehrmethoden in der pharmazeutischen Ausbildung. Ziel ist es, durch eine Meta-Analyse die Effekte des Flipped Classroom-Ansatzes auf die Lernleistung von Pharmazie-Studierenden systematisch zu vergleichen. Die Autoren zielen darauf ab, eine endgültige und einheitliche Schlussfolgerung zur Wirksamkeit des Flipped Classroom in der Pharmazieausbildung zu ziehen und Empfehlungen für zukünftige Lehrmethoden zu geben.


Methoden und Datenquellen: Die Meta-Analyse basiert auf einer systematischen Suche in sieben wissenschaftlichen Datenbanken, darunter PubMed, Cochrane Library und Web of Science. Insgesamt wurden 22 Studien mit 4379 Teilnehmern in die Analyse aufgenommen. Bewertet wurde die Leistung der Studierenden, gemessen an Prüfungsnoten und Kursbewertungen. Es wurden randomisierte kontrollierte Studien (RCT), quasi-experimentelle Studien und historische Kontrollstudien berücksichtigt.


Zentrale Forschungsergebnisse:


Der Flipped Classroom-Ansatz zeigt signifikante Verbesserungen in der Lernleistung der Pharmazie-Studierenden im Vergleich zu traditionellen Lehrmethoden (SMD 1.30, 95 \% CI 0.84–1.76, P {\textless} 0.001).


Subgruppenanalysen ergaben, dass der Flipped Classroom insbesondere bei der Verwendung von Multiple-Choice-Prüfungen (MCQs) und kurzen Pre-Class-Videos (unter 18 Minuten) besonders effektiv war.


Die Methodenanalyse zeigte jedoch eine hohe Heterogenität zwischen den Studien, was darauf hinweist, dass die Wirksamkeit je nach Studienaufbau und Implementierung des Flipped Classroom-Ansatzes variiert.




Zusammenfassung: Die Studie zeigt, dass der Flipped Classroom-Ansatz in der Pharmazieausbildung im Vergleich zu traditionellen Methoden zu einer signifikanten Verbesserung der Lernleistung führt. Die Autoren empfehlen die Einführung dieses Ansatzes in der Pharmazieausbildung, betonen jedoch die Notwendigkeit weiterer Forschung zur Optimierung der Implementierung und zur Verringerung der Heterogenität.


Kernaussagen:


Der Flipped Classroom fördert aktives Lernen und verbessert die kritische Denkfähigkeit sowie die Innovationsfähigkeit der Studierenden (S. 2).


Die Lernleistung wird insbesondere durch interaktive Lernaktivitäten im Klassenzimmer und die Kombination von Online- und Offline-Lernen gefördert (S. 8).


Ein signifikanter Vorteil des Flipped Classroom liegt in der Anwendung von MCQs und der Verwendung von kurzen Lernvideos vor dem Unterricht (S. 9).




Argumentationslinien: Die Autoren argumentieren, dass der Flipped Classroom die traditionelle Vorlesungsmethode durch eine aktivere und interaktivere Lernumgebung ersetzt. Sie betonen, dass durch die Vorbereitung der Lerninhalte vor der Klasse die Präsenzzeit effektiver genutzt wird, um tiefergehende Diskussionen und Problemlösungen zu ermöglichen. Die Subgruppenanalysen zeigen, dass die Wirksamkeit je nach Implementierung des Flipped Classroom variiert und die Nutzung interaktiver Technologien entscheidend für den Erfolg ist (S. 7-9).


Verschlagwortung:


Lehr- und Lerneffektivität: Der Flipped Classroom-Ansatz zeigte eine signifikante Verbesserung der Lernleistung der Pharmazie-Studierenden im Vergleich zu traditionellen Lehrmethoden.


Technologieintegration: Die Studie hebt die Bedeutung der Integration von Online-Technologien und kurzen Pre-Class-Videos hervor, um das Lernen der Studierenden zu fördern.


Bewertungsmethoden: Die Studie analysiert die Wirksamkeit verschiedener Prüfungsformate, insbesondere Multiple-Choice-Prüfungen, im Flipped Classroom-Ansatz.




Kategorisierung:


Argumentation: Die Studie nutzt systematische Metaanalysen, um die Vorteile des Flipped Classroom-Ansatzes zu belegen und Empfehlungen für die zukünftige Praxis der Pharmazieausbildung abzuleiten.




Zuordnung zu den Forschungsfragen: Diese Studie passt zu der Forschungsfrage FU2a: "Welchen Effekt erläutern Lernende im digitalen Bildungsraum von Gesundheitsberufen bei der Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems?"


Begründung: Die Untersuchung analysiert den Effekt des Flipped Classroom auf die Lernleistung von Studierenden, was direkt zur Untersuchung der Effekte von digitalen Lehrmethoden auf Lernende im Gesundheitswesen beiträgt.




Relevanzbewertung:




5 - Hoch relevant: Die Studie liefert starke empirische Beweise für die Wirksamkeit des Flipped Classroom-Ansatzes, der in vielen digitalen Bildungsräumen im Gesundheitswesen Anwendung finden könnte.


},
	file = {Cui et al. - 2023 - Effectiveness of flipped classroom in pharmacy edu.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/YIVYCJIR/Cui et al. - 2023 - Effectiveness of flipped classroom in pharmacy edu.pdf:application/pdf},
}

