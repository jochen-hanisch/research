	pages = {1--27},
	file = {Dertinger - 2021 - Medienpädagogische Professionalisierung von Lehrpe.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/BFQ6JGU3/Dertinger - 2021 - Medienpädagogische Professionalisierung von Lehrpe.pdf:application/pdf},
