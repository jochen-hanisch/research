	journal = {Magazin erwachsenenbildung.at},
	publisher = {Bundesministerium für Frauen, Wissenschaft und Forschung : Wien},
	author = {Schindler, Julia},
	collaborator = {{DIPF {\textbar} Leibniz-Institut für Bildungsforschung und Bildungsinformation}},
