@article{wienberg_resonanzstrategien_2020,
	title = {Resonanzstrategien im {Umgang} mit {Beschleunigung} und {Digitalisierung}},
	issn = {1424-3636, 1424-3636},
	url = {10.21240/mpaed/jb17/2020.04.25.X},
	doi = {10/gg5cxc},
	abstract = {The question of the contribution concerns learning and competence development of adults in the context of acceleration and digitization. The paper discusses this phenomenon on a theoretical and empirical level. Against the background of contemporary diagnoses, increasing individualization (Beck 1986), modernization (Field, cited by Hösel et al. 2017), competition/optimization logic (Kessl 2017; Rosa 2016a; 2016b), acceleration (Rosa 2005) and digitization (Aufenanger 2018; Käpplinger 2016; Burchert and Grobe 2017; Schmid, Goetz and Behrens 2017) are emerging, which may lead to increased (self-)optimisation efforts. For example, the increase in importance can be interpreted as a consequence of the increasing complexity of life today (Ribolits 2007), characterized by an increase in information and «informational overload», increased incalculability on the labor markets and, since the 2000s, «increasing uncertainty in (occupational) biographical perspectives» (Arbeitsstab Forum Bildung 2001). At the same time – this is shown by the results of a representative population survey in Germany –various population groups (e.g. formally low-educated, low literate, unemployed, elderly) face digital challenges for which they themselves consider that they have only little competence. This applies both to functional-pragmatic competences (Klieme and Hartig 2008) and to critical-questioning competences (Negt 1993; Zeuner 2009, 268-69; Riekmann and Grotlüschen 2011, 69). Exemplary results are presented in the article.},
	language = {de-DE},
	urldate = {2021-06-20},
	journal = {MedienPädagogik: Zeitschrift für Theorie und Praxis der Medienbildung},
	author = {Wienberg, Jana and Buddeberg, Klaus},
	month = apr,
	year = {2020},
	note = {ZSCC: 0000001},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:FU4a, Bildungstheorien, Promotion:Relevanz:4, \#0:Zeitschriftenartikel:digital:learning, Promotion:Weiterführung, Promotion:S:12 Digital Learning, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {33--58},
	file = {Wienberg und Buddeberg - 2020 - Resonanzstrategien im Umgang mit Beschleunigung un.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/VI69MQ8F/Wienberg und Buddeberg - 2020 - Resonanzstrategien im Umgang mit Beschleunigung un.pdf:application/pdf},
}

@article{esterl_digitaler_2022,
	title = {Digitaler {Unterricht} an {Schulen} vor und während des {Corona}-{Lockdowns}: {Erfahrungen} von {Lehrkräften} bei der {Wahl} ihrer {Lehrstrategien}},
	volume = {22},
	issn = {2190-4790},
	shorttitle = {Digitaler {Unterricht} an {Schulen} vor und während des {Corona}-{Lockdowns}},
	url = {https://www.medienpaed-ludwigsburg.de/article/view/434},
	doi = {10/gp5vw8},
	abstract = {Dieser Beitrag stellt die aktualisierte und gekürzte Fassung der Bachelorarbeit von Nadine Esterl dar, die sie im Rahmen des Studiengangs „Pädagogik / Bildungswissenschaft (B.A.)“ an der Ludwig-Maximilians-Universität München erstellt hat.
Die Corona-Krise hat die Passivität vieler Schüler*innen in den schulischen Lehr- und Lernprozessen verstärkt, weil kein regulärer Präsenzunterricht durchgeführt werden konnte. Um dieser entgegenzuwirken, setzten Lehrkräfte auf aktivierende mit digitalen Medien gestützte Lehrstrategien. Halbstrukturierte Interviews mit acht Münchner Lehrkräften während der Schulschließungen liefern Erkenntnisse über Kriterien, anhand derer Lehrkräfte ihre mit digitalen Medien gestützten Lehrstrategien, wie z. B. den Einsatz von Apps, die Erstellung von Erklärvideos durch Schüler*innen oder Gruppendiskussionen über Videochat, auswählten sowie über (bewährte) Strategien, mit den pandemiebedingten Schwierigkeiten im Unterricht umzugehen. Die Ergebnisse suggerieren, dass eine Kategorisierung von Lernaktivitäten hinsichtlich kognitiver Aktivierung Lehrkräften helfen kann, Entscheidungen für die Art des Einsatzes von Bildungstechnologien zu treffen.},
	language = {de-DE},
	urldate = {2022-05-16},
	journal = {Ludwigsburger Beiträge zur Medienpädagogik},
	author = {Esterl, Nadine and Berger, Sonja and Nistor, Nicolae},
	month = may,
	year = {2022},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Bewertungsmethoden, Promotion:Argumentation, Promotion:Relevanz:4, \#7:Zeitschriftenartikel:digital:Medien, Krisenreaktion im Bildungsbereich, Promotion:FU1, Promotion:S:07 Digitale Medien, Promotion:02-01\_Q2, Promotion:Dissertation {\textbar} FU1 {\textgreater} Argumentation, Promotion:Literaturverzeichnis, Promotion:sec:Ergebnisse-FU1, AVIVA+, Promotion:chap:04-05},
	pages = {1--18},
	annote = {{\textless}div class="zotero-note"{\textgreater}{\textless}pre{\textgreater}**Analyse der Quelle „Digitaler Unterricht an Schulen vor und während des Corona-Lockdowns: Erfahrungen von Lehrkräften bei der Wahl ihrer Lehrstrategien“ (Esterl, Berger \&amp; Nistor, 2022)** **1. Hauptthemen und Ziele der Forschung** Der Beitrag untersucht, wie Lehrkräfte während der pandemiebedingten Schulschließungen digitale Lehrstrategien auswählen und begründen. Ziel ist, Auswahlkriterien, Bedingungen (v. a. technische Voraussetzungen) sowie bewährte Strategien im Umgang mit Lockdown-spezifischen Herausforderungen zu rekonstruieren. (vgl. Zusammenfassung, S. 1) **2. Methoden und Datenquellen** - **Design:** qualitative Studie (Erfahrungsrekonstruktion).- **Datenerhebung:** halbstrukturierte Interviews mit acht Lehrkräften (München). (S. 1)- **Auswertung:** qualitative Inhaltsanalyse (Mayring). (S. 1) **3. Zentrale Forschungsergebnisse** - Digitale Strategien werden u. a. entlang von Aktivierungslogiken begründet; der Beitrag rahmt „guten Unterricht“ über kognitive Aktivierung und ordnet Lernaktivitäten mithilfe des ICAP-Modells (passiv/aktiv/konstruktiv/interaktiv). (S. 2)- Die technische Ausstattung von Lernenden und Lehrenden wirkt als zentrale Randbedingung bzw. Moderator für die Auswahl und Umsetzung digitaler Lehrstrategien. (S. 3) **4. Zusammenfassung** Der Artikel beschreibt Lehrkraftentscheidungen im Lockdown als kontingente Passungsleistung zwischen didaktischem Anspruch (v. a. kognitive Aktivierung), technischen Möglichkeiten und Lernvoraussetzungen. Digitale Medien werden nicht als Selbstzweck, sondern als Mittel zur Aktivierung, Strukturierung und Interaktion im Unterrichtsvollzug diskutiert. **5. Kernaussagen (mit Fundstellen)** - „Kognitive Aktivierung ist neben konstruktiver Unterstützung und Klassenführung eines der zentralen Merkmale für Unterrichtsqualität.“ (S. 2)- „Empirischen Befunden zufolge steigt der Lernerfolg mit der Anwendung einer höher eingestuften Art der Lernaktivität aufsteigend nach passiv, aktiv, konstruktiv und interaktiv.“ (S. 2)- „Die technische Ausstattung der Schüler*innen und der Lehrkräfte kann einen moderierenden Einfluss auf die Nutzung von digitalen Medien im Unterricht haben.“ (S. 3) **6. Argumentationslinien (mit Fundstellen)** Der Beitrag argumentiert, dass digitale Lehrstrategien (1) didaktisch über Aktivierungsqualität (ICAP) und Unterrichtsqualität gerahmt werden müssen (S. 2) und (2) dass die praktische Realisierbarkeit dieser Strategien systematisch von infrastrukturellen/technischen Voraussetzungen abhängt (S. 3). Daraus folgt eine Empfehlung, Auswahlentscheidungen nicht tool-zentriert, sondern lernaktivitäts- und kontextorientiert zu treffen. **7. Verschlagwortung (nur relevante Schlagwörter)** - **Lehr- und Lerneffektivität:** Fokus auf Unterrichtsqualität/kognitive Aktivierung und deren Ermöglichung durch digitale Strategien. (S. 2)- **Technologieintegration:** Auswahl und Einsatz digitaler Medien/Tools als didaktische Implementationsfrage, abhängig von Ausstattung. (S. 3)- **Bewertungsmethoden:** ICAP als kategoriales Raster zur Einordnung von Lernaktivitäten/Strategien. (S. 2)- **Krisenreaktion im Bildungsbereich:** Lockdown als Kontext und Treiber/Stress-Test digitaler Unterrichtspraxis. (S. 1)- **Forschungsansätze:** qualitative Interviewstudie + qualitative Inhaltsanalyse. (S. 1) **8. Kategorisierung** **Kerngedanke:** Digitale Unterrichtsgestaltung ist unter Krisenbedingungen eine Passungsleistung zwischen Aktivierungsanspruch (ICAP) und infrastruktureller Realisierbarkeit; „Digitalität“ erklärt Unterrichtsqualität nicht, sondern muss didaktisch gerahmt werden. (vgl. S. 2–3) **9. Zuordnung zu der passendsten Forschungsunterfrage** - **FU1 (anschlussfähig):** Auswahlkriterien/erlebte Nützlichkeit digitaler Strategien aus Akteursperspektive (Lehrkräfte) werden rekonstruiert; Übertragbarkeit in den Kontext LMS-gestützter Lernräume ist möglich, muss aber kontextsensibel erfolgen. (S. 1–3) **10. Relevanzbewertung** **4** **11. Schlussfolgerung** Der Beitrag ist als empirische Evidenzlinie für die These nutzbar, dass digitale Lernarchitekturen (auch LMS) ihre Wirksamkeit nicht aus „Tools“ beziehen, sondern aus didaktischer Rahmung (Aktivierung/Interaktion) und stabiler Infrastruktur. Für deine Argumentation ist besonders die Kopplung von Aktivierungslogik und Ausstattung als Moderationsbedingung anschlussfähig.{\textless}/pre{\textgreater}{\textless}/div{\textgreater}},
	file = {Esterl et al. - 2022 - Digitaler Unterricht an Schulen vor und während de.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/XVRUH89B/Esterl et al. - 2022 - Digitaler Unterricht an Schulen vor und während de.pdf:application/pdf},
}

@article{dannecker_fachliches_2024,
	title = {Fachliches {Lernen} im inklusiven {Unterricht} – zur {Ausdifferenzierung} von {Spannungsfeldern} in {Forschung} und {Schulpraxis}. {Ergebnisse} aus dem {Forschungsprojekt} {Lernen} mit digitalen {Medien} im inklusiven {Literaturunterricht} ({DigiLi})},
	abstract = {Ausgehend von dem von Hennies \& Ritter (2013) beschriebenen Spannungsfeld Gemeinsamkeit und Individualisierung in Bezug auf das fachliche Lernen im inklusiven Deutschunterricht differenziert der vorliegende Beitrag dieses Spannungsfeld auf der Grundlage empirischer Daten aus. Dazu stellt der Artikel Ergebnisse des vom BMBF geförderten DigiLi-Projekts vor, das sich anschließend an bereits bestehende Forschungsergebnisse (vgl. Dannecker, 2020: S. 82 f.; Ziemen, 2018: S. 42 ff.) der Fragestellung widmet, inwiefern ein mediengestütztes Lernangebot dazu beitragen kann, das Bildungsanliegen der kulturellen Teilhabe aller zu realisieren (vgl. Kerres, 2013: S. 74).},
	language = {de-DE},
	author = {Dannecker, Wiebke and Ambrosini, Caroline and Carell, Leonie and Spieß, Sophie and Ziemen, Kerstin},
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Promotion:Argumentation, \#9:Zeitschriftenartikel:digital:lernen, Promotion:FU1, Promotion:S:09 Digital Lernen, Promotion:Dissertation {\textbar} FU1 {\textgreater} Argumentation, Promotion:Literaturverzeichnis},
	annote = {Analyse des Artikels “Fachliches Lernen im inklusiven Unterricht – zur Ausdifferenzierung von Spannungsfeldern in Forschung und Schulpraxis” von Wiebke Dannecker, Caroline Ambrosini, Leonie Carell, Sophie Spieß und Kerstin Ziemen (2024)
1. Identifizierung und Beschreibung der Hauptthemen und -ziele der Forschung:
Der Artikel untersucht die Spannungsfelder von Gemeinsamkeit und Individualisierung im inklusiven Deutschunterricht und wie digitale Medien genutzt werden können, um diese Spannungsfelder zu adressieren. Ziel des vom BMBF geförderten DigiLi-Projekts ist es, zu erforschen, wie mediengestützte Lernangebote die kulturelle Teilhabe aller Lernenden fördern können.
2. Erkennung der verwendeten Methoden und Datenquellen:
Die Studie verwendet einen Design-Based-Research-Ansatz, der die Entwicklung und empirische Erprobung eines Lernarrangements umfasst. Die Erhebungen beinhalten Bedarfsanalysen, qualitative Inhaltsanalysen und die Entwicklung und Erprobung einer digitalen Lernplattform (DigiLi-App) in mehreren iterativen Zyklen.
3. Erklärung der zentralen Forschungsergebnisse:
Die Ergebnisse zeigen, dass gut gestaltete digitale Lernarrangements sowohl individualisierte als auch gemeinschaftliche Lernprozesse unterstützen können. Spannungsfelder wie “Individualisierung vs. Gemeinsamkeit”, “Strukturiertheit vs. Offenheit” und “Digital vs. Analog” wurden identifiziert und detailliert untersucht. Das Projekt hebt die Bedeutung einer Balance zwischen diesen Polen hervor, um inklusiven Unterricht erfolgreich zu gestalten.
Zusammenfassung
Kernpunkte des Artikels:
	•	Problemstellung: Untersuchung der Spannungsfelder im inklusiven Deutschunterricht und die Rolle digitaler Medien.
	•	Methodik: Design-Based Research mit iterativen Erhebungszyklen und qualitativen Inhaltsanalysen.
	•	Hauptergebnisse: Identifikation und Ausdifferenzierung der Spannungsfelder, positive Auswirkungen digitaler Medien auf inklusiven Unterricht.
	•	Schlussfolgerungen: Empfehlungen zur Gestaltung von Lernarrangements, die sowohl Individualisierung als auch gemeinschaftliches Lernen fördern.
Kernaussagen
	•	Gut gestaltete digitale Lernarrangements unterstützen individualisierte und gemeinschaftliche Lernprozesse (S. 16).
	•	Spannungsfelder wie Individualisierung vs. Gemeinsamkeit und Strukturiertheit vs. Offenheit müssen ausbalanciert werden (S. 22).
	•	Digitale Medien bieten Potenziale für die kulturelle Teilhabe aller Lernenden (S. 30).
Argumentationslinien
	•	Aufbau der Argumente:
	•	Einleitung: Bedeutung der Inklusion und der Spannungsfelder im Deutschunterricht.
	•	Theoretischer Rahmen: Diskussion der Grundlagen inklusiver Didaktik und digitaler Medien.
	•	Methoden: Beschreibung des Design-Based-Research-Ansatzes und der Erhebungszyklen.
	•	Ergebnisse: Darstellung der Spannungsfelder und der Rolle digitaler Medien.
	•	Schlussfolgerungen: Empfehlungen zur Balance von Individualisierung und Gemeinsamkeit im Unterricht.
	•	Logische Verbindungen:
	•	Verknüpfung von Theorie und Praxis: Anwendung theoretischer Konzepte auf die praktische Gestaltung inklusiver Lernarrangements.
	•	Systematische Unterstützung: Durch detaillierte Beschreibung der Spannungsfelder und empirische Ergebnisse.
Verschlagwortung
	•	Lehr- und Lerneffektivität: Der Artikel untersucht die Wirksamkeit digitaler Medien zur Förderung individualisierter und gemeinschaftlicher Lernprozesse im inklusiven Unterricht.
	•	Technologieintegration: Untersuchung der Rolle digitaler Medien bei der Gestaltung inklusiver Lernarrangements.
	•	Forschungsansätze: Anwendung des Design-Based-Research-Ansatzes zur Entwicklung und Evaluierung inklusiver Unterrichtsmodelle.
Kategorisierung
	•	Argumentation: Der Artikel nutzt theoretische Rahmenwerke und bestehende Forschung, um die Spannungsfelder im inklusiven Unterricht zu untersuchen und die Rolle digitaler Medien zu beleuchten. Dies umfasst die Diskussion der Vorteile und Herausforderungen der Digitalisierung im inklusiven Unterricht sowie die Anwendung von Design-Based Research, um die Wirksamkeit der entwickelten Lernarrangements zu evaluieren.
Forschungsfragen Zuordnung
	•	FU1: Welche Akzeptanz und Nützlichkeit (Bedeutung) beschreiben Akteure im digitalen Bildungsraum von Gesundheitsberufen bei Anwendung eines Learning-Management-Systems?
Der Artikel von Dannecker et al. passt zu dieser Forschungsfrage, da er die Akzeptanz und Nützlichkeit digitaler Medien im inklusiven Unterricht untersucht. Die Ergebnisse zur positiven Wirkung digitaler Lernarrangements und die Empfehlungen zur Balance zwischen Individualisierung und Gemeinsamkeit bieten wichtige Erkenntnisse für die Akzeptanz und Nützlichkeit digitaler Lernplattformen im Gesundheitsbereich.
},
	file = {Dannecker et al. - Fachliches Lernen im inklusiven Unterricht – zur A.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/SI4YR7R7/Dannecker et al. - Fachliches Lernen im inklusiven Unterricht – zur A.pdf:application/pdf},
}

