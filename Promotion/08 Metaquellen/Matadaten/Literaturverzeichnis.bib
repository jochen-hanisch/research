@article{martinez_who_2024,
	title = {The {WHO} atlas for female-genital schistosomiasis: {Co}-design of a practicable diagnostic guide, digital support and training},
	volume = {4},
	issn = {2767-3375},
	shorttitle = {The {WHO} atlas for female-genital schistosomiasis},
	doi = {10.1371/journal.pgph.0002249},
	abstract = {Up to 56 million young and adult women of African origin suffer from Female Genital Schistosomiasis (FGS). The transmission of schistosomiasis happens through contact with schistosomiasis infested fresh water in rivers and lakes. The transmission vector is the snail that releases immature worms capable of penetrating the human skin. The worm then matures and mates in the blood vessels and deposits its eggs in tissues, causing urogenital disease. There is currently no gold standard for FGS diagnosis. Reliable diagnostics are challenging due to the lack of appropriate instruments and clinical skills. The World Health Organisation (WHO) recommends "screen-and-treat" cervical cancer management, by means of visual inspection of characteristic lesions on the cervix and point-of-care treatment as per the findings. FGS may be mistaken for cervical cancer or sexually transmitted diseases. Misdiagnosis may lead to the wrong treatment, increased risk of exposure to other infectious diseases (human immunodeficiency virus and human papilloma virus), infertility and stigmatisation. The necessary clinical knowledge is only available to a few experts in the world. For an appropriate diagnosis, this knowledge needs to be transferred to health professionals who have minimal or non-existing laboratory support. Co-design workshops were held with stakeholders (WHO representative, national health authority, FGS experts and researchers, gynaecologists, nurses, medical doctors, public health experts, technical experts, and members of the public) to make prototypes for the WHO Pocket Atlas for FGS, a mobile diagnostic support tool and an e-learning tool for health professionals. The dissemination targeted health facilities, including remote areas across the 51 anglophone, francophone and lusophone African countries. Outcomes were endorsed by the WHO and comprise a practical diagnostic guide for FGS in low-resource environments.},
	language = {en-GB},
	number = {3},
	journal = {PLOS global public health},
	author = {Martinez, Santiago Gil and Mbabazi, Pamela S. and Sebitloane, Motshedisi H. and Vwalika, Bellington and Mocumbi, Sibone and Galaphaththi-Arachchige, Hashini N. and Holmen, Sigve D. and Randrianasolo, Bodo and Roald, Borghild and Olowookorun, Femi and Hyera, Francis and Mabote, Sheila and Nemungadi, Takalani G. and Ngcobo, Thembinkosi V. and Furumele, Tsakani and Ndhlovu, Patricia D. and Gerdes, Martin W. and Gundersen, Svein G. and Mkhize-Kwitshana, Zilungile L. and Taylor, Myra and Mhlanga, Roland E. E. and Kjetland, Eyrun F.},
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Bildungstheorien, \#1:Zeitschriftenartikel:learning:management:system, Lernsystemarchitektur, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {e0002249},
	annote = {1. Analyse
Hauptthemen und -ziele der Forschung: Die Studie von Martinez et al. (2024) zielt darauf ab, ein praktisches Diagnosehandbuch, digitale Unterstützungstools und Schulungsprogramme für die Diagnose von weiblicher Genital-Schistosomiasis (FGS) zu entwickeln. Diese Bemühungen sollen die Diagnosegenauigkeit in Regionen mit geringen Ressourcen verbessern und zur Verringerung von Fehldiagnosen beitragen.
Verwendete Methoden und Datenquellen: Die Forschungsarbeit basiert auf Co-Design-Workshops, die mit verschiedenen Stakeholdern (WHO-Vertretern, nationalen Gesundheitsbehörden, FGS-Experten, Gynäkologen, medizinischem Personal und Mitgliedern der Öffentlichkeit) durchgeführt wurden, um Prototypen für das WHO Pocket Atlas für FGS zu entwickeln.
Zentrale Forschungsergebnisse: Die Workshops führten zur Entwicklung eines mobilen diagnostischen Hilfsmittels und eines E-Learning-Tools, die beide darauf abzielen, die Diagnosefähigkeiten von Gesundheitspersonal zu verbessern und die Verbreitung von FGS genauer zu identifizieren und zu behandeln.
2. Zusammenfassung
Die Studie dokumentiert die Entwicklung eines integrativen Ansatzes zur Verbesserung der Diagnose und Behandlung von FGS. Durch die Kombination von Expertenwissen und praktischer Anwendung in Form eines Atlas und digitaler Tools konnte ein bedeutender Fortschritt in der Bildung und Ressourcenbereitstellung für Gesundheitspersonal in ressourcenarmen Umgebungen erreicht werden.
3. Kernaussagen


"Es gibt derzeit keinen Goldstandard für die Diagnose von FGS, was zu Herausforderungen in der zuverlässigen Diagnose führt." (S. 1)


"Die Co-Design-Workshops führten zur Entwicklung eines praktischen Diagnoseführers, der durch die WHO unterstützt wird und in niedrig ressourcierten Umgebungen eingesetzt werden soll." (S. 1)


4. Argumentationslinien


Die Studie argumentiert, dass die Entwicklung spezifischer diagnostischer Werkzeuge und Schulungsprogramme wesentlich ist, um die Genauigkeit der FGS-Diagnose zu verbessern und Fehldiagnosen zu reduzieren, die zu unnötigen Behandlungen und sozialen Stigmatisierungen führen können.


5. Verschlagwortung


Lernsystemarchitektur: Die Entwicklung des mobilen Diagnosetools und der E-Learning-Module stellt eine innovative Lernsystemarchitektur dar, die speziell auf die Bedürfnisse des Gesundheitspersonals in ressourcenarmen Regionen zugeschnitten ist.


Bildungstheorien: Die Nutzung von Co-Design-Workshops zur Entwicklung der Bildungsressourcen basiert auf partizipativen und benutzerzentrierten Bildungstheorien, die den Praktikern ermöglichen, direkt an der Gestaltung ihrer Lernwerkzeuge mitzuwirken.


Lehr- und Lerneffektivität: Der Einsatz des WHO Pocket Atlas und der digitalen Schulungstools verbessert die Lehr- und Lerneffektivität, indem er das Gesundheitspersonal direkt in die Lage versetzt, FGS präziser zu diagnostizieren und zu behandeln.


Kollaboratives Lernen: Die Integration von Feedback und der aktiven Teilnahme verschiedener Stakeholder im Rahmen der Co-Design-Workshops fördert kollaboratives Lernen und verbessert die Relevanz und Anwendbarkeit der Lehrmaterialien.


Forschungsansätze: Die methodologische Herangehensweise der Studie, die sich auf die Einbeziehung einer Vielzahl von Akteuren und die Entwicklung von Feld-getesteten, anpassbaren Lernwerkzeugen konzentriert, stellt einen fortschrittlichen Forschungsansatz in der medizinischen Bildung dar.


Kategorie: Weiterführung
Basierend auf den Ergebnissen der Studie könnte eine Weiterführung in Ihrem Exposé die Entwicklung zusätzlicher spezialisierter Module umfassen, die das Wissen und die Fähigkeiten des Gesundheitspersonals in der Diagnose und Behandlung von FGS weiter verbessern. Diese Module könnten auf spezielle Aspekte wie die Erkennung früher Anzeichen von FGS und die Differenzierung von ähnlichen Erkrankungen fokussieren, um die Präzision und Effektivität der medizinischen Versorgung in betroffenen Regionen zu erhöhen.
},
	file = {Martinez et al. - 2024 - The WHO atlas for female-genital schistosomiasis .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/YYRDJFFQ/Martinez et al. - 2024 - The WHO atlas for female-genital schistosomiasis .pdf:application/pdf},
}

@article{tetzlaff_developing_2021,
	title = {Developing personalized education. {A} dynamic framework},
	volume = {33},
	issn = {1573-336X},
	url = {http://nbn-resolving.de/urn:nbn:de:0111-pedocs-252373},
	abstract = {Personalized education—the systematic adaptation of instruction to individual learners—has been a long-striven goal. We review research on personalized education that has been conducted in the laboratory, in the classroom, and in digital learning environments. Across all learning environments, we find that personalization is most successful when relevant learner characteristics are measured repeatedly during the learning process and when these data are used to adapt instruction in a systematic way. Building on these observations, we propose a novel, dynamic framework of personalization that conceptualizes learners as dynamic entities that change during and in interaction with the instructional process. As these dynamics manifest on different timescales, so do the opportunities for instructional adaptations—ranging from setting appropriate learning goals at the macroscale to reacting to affective-motivational fluctuations at the microscale. We argue that instructional design needs to take these dynamics into account in order to adapt to a specific learner at a specific point in time. Finally, we provide some examples of successful, dynamic adaptations and discuss future directions that arise from a dynamic conceptualization of personalization. (DIPF/Orig.)},
	language = {en-GB},
	number = {3},
	urldate = {2024-05-14},
	journal = {Educational psychology review},
	publisher = {pedocs},
	author = {Tetzlaff, Leonard and Schmiedek, Florian and Brod, Garvin},
	year = {2021},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Bildungstheorien, Virtual learning, Educational Environment, Learning environment, Learning process, Lernprozess, Datenerhebung, Teaching, Unterricht, Forschungsstand, Lernumgebung, Lehr-Lern-Forschung, Teaching-learning research, \#5:Zeitschriftenartikel:e-learning, Kernstudie, E-learning, E-Learning, Individualisierung, Individualization, Lernforschung, Research on learning, School class, Schulklasse, Unterrichtsgestaltung, Adaptiver Unterricht, Binnendifferenzierung, Interior differentiation, Lernender, Model building, Modellbildung, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {863--882},
	annote = {Kernstudie identifiziert für das Forschungsprojekt "Wirkgefüge im digitalen Bildungsraum":


Titel: Developing personalized education. A dynamic framework


Autoren: Tetzlaff, L., Schmiedek, F., \& Brod, G.


Publiziert in: Educational Psychology Review


Band/Volume: 33


Ausgabe: 3


Seiten: 863–882


Jahr: 2021


Beschreibung der Studie: Die Studie von Tetzlaff, Schmiedek, und Brod entwickelt ein dynamisches Rahmenwerk für personalisierte Bildung, das darauf abzielt, individuelle Lernpfade zu schaffen, die auf den spezifischen Fähigkeiten und Bedürfnissen der Lernenden basieren. Dieser Ansatz berücksichtigt die Variabilität in der Lerngeschwindigkeit und den Methoden, die für unterschiedliche Individuen am effektivsten sind.
Bedeutung für das Forschungsprojekt: Diese Studie ist besonders relevant für das Verständnis und die Implementierung personalisierter Lernansätze in digitalen Bildungsräumen. Sie bietet wissenschaftlich fundierte Einblicke, die für die Gestaltung effektiver, auf den Lerner zugeschnittener Bildungsprogramme genutzt werden können.
},
	file = {Tetzlaff et al. - 2021 - Developing personalized education. A dynamic frame.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/VFWUENXU/Tetzlaff et al. - 2021 - Developing personalized education. A dynamic frame.pdf:application/pdf},
}

@article{venkatesan_impact_2023,
	title = {The {Impact} of {Patient}-{Centric} {Interactive} {E}-{Module} in {Pathology} {Among} {Medical} {Undergraduates}},
	volume = {33},
	issn = {2156-8650},
	doi = {10.1007/s40670-023-01869-x},
	abstract = {INTRODUCTION: COVID pandemic shifted healthcare-related education to digital platforms. With the widespread availability of learning management systems like MOODLE, many opportunities exist to create innovative e-modules. Its success depends on the interactive multimedia resources and structural framework. The present study aims to create two patient-centric e-modules on Diabetes and Alcoholic liver disease in Pathology by a medical undergraduate facilitated by faculty and to assess its impact on learning outcomes and learners' perceptions in relation to student seminars.
METHODOLOGY: This mixed-method intervention study combines quantitative and qualitative research methods to gain deeper insight into learners' experiences. By random allocation, half of the second-year medical undergraduates (n = 60) attended an e-module, and the other half listened to a student seminar on the same topic with the same specific learning objectives. Pre- and post-test scores and feedback questionnaires were quantitatively analysed. Student-led focus group discussions (FGD) for learners' experiences underwent thematic analysis.
RESULTS: Pre- and post-tests for both learning techniques were statistically significant, while the feedback questionnaire's responses favoured e-module. Four focus group discussions yielded six themes for the e-module: Patient-driven holistic learning experience, Inquiry-based learning, Immersive learning, Higher level cognitive skills, Flexibility, repeatability and accessibility, and No human involvement. The five themes for the seminar were: Peer-driven camaraderie learning dynamic, Teacher-centric synchronous learning, Active vs passive listening, Basic learning, and Teacher-student interaction.
CONCLUSION: While both learning techniques had comparable effects on test scores, they have merits and demerits. Hence, blending both techniques where seminars impart basic knowledge and e-module for deeper reinforcement will benefit the students.},
	language = {en-GB},
	number = {6},
	journal = {Medical Science Educator},
	author = {Venkatesan, Jayaprakash and Manickam, Niraimathi and Madasamy, Balamurugan and Rajagopal, Meyyappa Devan and Karthikeyan, Arun Kumar},
	month = dec,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Bildungstheorien, \#1:Zeitschriftenartikel:learning:management:system, Krisenreaktion im Bildungsbereich, Lernsystemarchitektur, Mixed-method study, MOODLE, Patient-centric e-module, Seminar, Student-led focus group discussion, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {1347--1358},
	annote = {1. Analyse
Hauptthemen und -ziele der Forschung: Die Studie von Venkatesan et al. evaluiert die Wirkung eines patientenzentrierten interaktiven E-Moduls in der Pathologie auf das Lernen medizinischer Studierender. Ziel ist es, durch die Integration von klinischen Daten in das Lernmodul ein realitätsnahes Lernerlebnis zu schaffen, das die klinische Entscheidungsfindung und das Verständnis für Pathologie verbessert.
Verwendete Methoden und Datenquellen: Es wurde eine Mixed-Methods-Studie durchgeführt, die quantitative (Pre- und Post-Tests, Feedback-Fragebögen) und qualitative Methoden (Fokusgruppendiskussionen) kombiniert, um ein umfassendes Verständnis der Lernerfahrungen zu gewinnen.
Zentrale Forschungsergebnisse: Die Studie zeigt, dass das E-Modul das klinische Verständnis und die Entscheidungsfindung verbessert hat. Die Studierenden berichteten über eine erhöhte Sicherheit in der klinischen Praxis und ein verbessertes Verständnis der Pathologie durch die Nutzung des Moduls. Die Fokusgruppen identifizierten Vorteile wie Flexibilität, Zugänglichkeit und die Förderung von höheren kognitiven Fähigkeiten.
2. Zusammenfassung
Die Forschung von Venkatesan et al. demonstriert die positive Wirkung eines patientenzentrierten E-Lernmoduls in der medizinischen Ausbildung. Das Modul verbesserte das klinische Verständnis und die Entscheidungsfindung der Studierenden erheblich. Durch die Einbindung echter Patientenfälle und die Förderung einer aktiven Beteiligung konnte ein tieferes, praxisnahes Lernen erreicht werden, das über traditionelle Lehrmethoden hinausgeht.
3. Kernaussagen


"Das patientenzentrierte E-Modul führte zu einer signifikanten Verbesserung des Verständnisses und der Sicherheit in klinischen Entscheidungen unter den Studierenden." (S. 1348)


"Die Studierenden schätzten die Flexibilität und Zugänglichkeit des E-Moduls, was es ihnen ermöglichte, nach eigenem Tempo zu lernen und die Inhalte mehrfach zu durchlaufen." (S. 1351)


"Die interaktive Gestaltung des Moduls, einschließlich Quizzen und multimedialen Inhalten, förderte höhere kognitive Fähigkeiten wie Analyse und Bewertung." (S. 1354)


4. Argumentationslinien
Die Studie argumentiert, dass die Integration von echten Patientenfällen in das Lernmodul das Verständnis der Studierenden für die praktische Anwendung pathologischer Konzepte verbessert. Die Kombination aus multimedialen Inhalten und interaktiven Elementen fördert eine tiefere kognitive Verarbeitung und ein engagiertes Lernen. Die positiven Feedbacks und die statistisch signifikanten Verbesserungen in den Testergebnissen bestätigen die Effektivität des Ansatzes. (S. 1349, S. 1353)
5. Verschlagwortung
Lernsystemarchitektur Begründung: Die Verwendung von MOODLE und die spezifische Anpassung der Lernmodule für das Studium der Pathologie zeigt, wie die Architektur von Lernsystemen angepasst wurde, um die Bedürfnisse in Gesundheitsberufen zu erfüllen.
Bildungstheorien Begründung: Der patientenzentrierte Ansatz in den E-Modulen verdeutlicht, wie theoretische Rahmenwerke in der praktischen Anwendung genutzt werden, um das Lernen in digitalen Umgebungen zu verbessern.
Lehr- und Lerneffektivität Begründung: Die positive Auswirkung der E-Module auf das klinische Verständnis und die Entscheidungsfindung zeigt, wie effektiv digitale Lehrmethoden in der Bildungstechnologie sein können.
Kollaboratives Lernen Begründung: Obwohl das Modul primär auf individuelles Lernen abzielt, fördern die in der Studie beschriebenen interaktiven Elemente und die Einbindung von Diskussionsforen das kollaborative Lernen unter den Studierenden.
Technologieintegration Begründung: Die Integration verschiedener technologischer Tools in das Lernmodul, insbesondere die Verwendung von interaktiven und multimedialen Inhalten, zeigt die Wichtigkeit und Komplexität der Technologieintegration in Lernsysteme.
Krisenreaktion im Bildungsbereich Begründung: Die schnelle Anpassung und Implementierung von digitalen Lehrmethoden als Reaktion auf die COVID-19-Pandemie zeigt, wie flexibel und anpassungsfähig Bildungstechnologien in Krisenzeiten sein müssen.
Forschungsansätze Begründung: Die methodologische Herangehensweise in dieser Studie, insbesondere der Einsatz von Mixed-Methods zur Datenerhebung und -analyse, bietet eine fundierte Basis, um die Forschungsmethoden in der Bildungswissenschaft zu verstehen und anzuwenden.
},
	file = {Venkatesan et al. - 2023 - The Impact of Patient-Centric Interactive E-Module.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/RNNFJHJM/Venkatesan et al. - 2023 - The Impact of Patient-Centric Interactive E-Module.pdf:application/pdf},
}

@article{mojtahedzadeh_students_2024,
	title = {Students' experience of interpersonal interactions quality in e-{Learning}: {A} qualitative research},
	volume = {19},
	issn = {1932-6203},
	shorttitle = {Students' experience of interpersonal interactions quality in e-{Learning}},
	doi = {10.1371/journal.pone.0298079},
	abstract = {BACKGROUND: Online Interaction is a critical characteristic of distance learning, and effective online communication models empower students.
PURPOSE: This research aimed to explain students' experiences on the quality of interpersonal interactions in e-learning.
METHOD: This study was conducted from November 2021 to October 2022. The qualitative descriptive design via conventional content analysis was utilized. Purposeful and maximum variation methods recruited sixteen participants from three medical science universities in Iran. The data were collected through semi-structured, in-depth, face-to-face, or online interviews. Interviews were recorded through a digital recorder, and analysis was achieved simultaneously with data collection using Graneheim and Lundman (2004). The Lincoln and Guba criteria, including credibility, dependability, transferability, and confirmability, were used to improve the trustworthiness of the findings.
RESULTS: The results indicated the importance of different dimensions related to teaching-learning. It seems crucial to develop a comfortable and safe environment to improve interpersonal interactions. Educators should be provided with pedagogical skills to support interactions. In addition, focusing on some learners' soft skills is also vital. In addition to the significance of the teacher's inclusive role, the educational content must have critical standards. Constructive feedback and the proper use of simultaneous and non-simultaneous communication tools and social networks are other important issues in strengthening interpersonal relationships. Ultimately, comprehensive and ongoing support of learners improves the quality of interpersonal interactions.
CONCLUSIONS: The results indicated the significance of different dimensions of teaching-learning as facilitating factors of interpersonal interactions. The proper use of simultaneous and non-simultaneous communication tools and social networks are other important issues in strengthening interpersonal relationships. Ultimately, comprehensive and ongoing support of learners improves the quality of interpersonal interactions.
IMPLICATIONS: The results of this study give teachers the insight to keep essential issues in mind when developing their online courses and students to be aware of their roles in the online learning process. Also, the characteristics of simultaneous and non-synchronous platforms, social messaging networks, and learner support are crucial.},
	language = {en-GB},
	number = {3},
	journal = {PloS One},
	author = {Mojtahedzadeh, Rita and Hasanvand, Shirin and Mohammadi, Aeen and Malmir, Sahar and Vatankhah, Mehdi},
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Kollaboratives Lernen, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, Learning, Humans, Students, \#5:Zeitschriftenartikel:e-learning, Computer-Assisted Instruction, Interpersonal Relations, Qualitative Research, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {e0298079},
	annote = {1. Analyse
Hauptthemen und -ziele der Forschung: Die Studie von Mojtahedzadeh et al. (2024) konzentriert sich auf die Qualität der interpersonalen Interaktionen im E-Learning. Ziel ist es, das Verständnis und die Erfahrungen der Studierenden in Bezug auf die Qualität ihrer Interaktionen in virtuellen Lernumgebungen zu verbessern und damit die Online-Bildungspraxis zu optimieren.
Verwendete Methoden und Datenquellen: Die Forschung nutzte einen qualitativen deskriptiven Ansatz mit konventioneller Inhaltsanalyse. Es wurden tiefgehende Interviews mit 16 Teilnehmenden aus medizinischen Universitäten im Iran durchgeführt, um umfangreiche Daten über ihre Interaktionserfahrungen zu sammeln.
Zentrale Forschungsergebnisse: Die Ergebnisse zeigen, dass effektive kommunikative Interaktionen entscheidend sind, um die Qualität des E-Learnings zu verbessern. Die Studie hebt die Bedeutung einer kompetenten, empathischen Lehrkraft und einer interaktiven Lernplattform hervor, die aktiv zur Verbesserung des Lernerlebnisses beiträgt.
2. Zusammenfassung
Die Forschung von Mojtahedzadeh et al. beleuchtet tiefgehend die Bedeutung von qualitativen interpersonalen Interaktionen im Kontext des E-Learnings. Sie betont, dass sowohl die Rolle der Lehrkräfte als auch die Gestaltung der Lernumgebung wesentlich sind, um eine positive Lernerfahrung zu gewährleisten.
3. Kernaussagen


"Interaktion ist ein kritischer Aspekt des pädagogischen Prozesses, der die Lehr-, Lern- und Inhaltsvermittlung in einer gemeinsamen Lernumgebung umfasst." (S. 2)


"Effektive Online-Kommunikationsmodelle sind entscheidend, um die Lernenden im Fernunterricht zu stärken und negative Erfahrungen wie Isolation und Einsamkeit zu vermeiden." (S. 3)


4. Argumentationslinien
Die Argumentationslinie der Studie stützt sich auf die Annahme, dass qualitativ hochwertige Interaktionen zwischen Lehrkraft und Lernenden sowie unter den Lernenden selbst essentiell für den Erfolg des E-Learnings sind. Sie betont, dass solche Interaktionen nicht nur spontan, sondern auch durch bewusste Gestaltung der Lernumgebung gefördert werden sollten.
5. Verschlagwortung


Lehr- und Lerneffektivität: Die Studie unterstreicht die Effektivität von gut gestalteten Interaktionsprozessen im E-Learning.


Technologieintegration: Die Nutzung von synchronen und asynchronen Plattformen zeigt, wie technologische Tools die Interaktion und damit die Lernerfahrung verbessern können.


Systemanpassung: Die Anpassung der Lernsysteme an die Bedürfnisse der Lernenden durch die Bereitstellung adäquater Unterstützungsstrukturen ist entscheidend.


Kollaboratives Lernen: Die Förderung der Zusammenarbeit und des Austauschs unter den Lernenden wird als Schlüssel zur Verbesserung der Lernerfahrung hervorgehoben.


Forschungsansätze: Die Verwendung qualitativer Methoden zur Erforschung der Tiefenstruktur der Lernerfahrungen bietet wertvolle Einblicke in die Gestaltung von E-Learning-Umgebungen.


Kategorie: Argumentation
Die Studie verwendet Forschungsdaten, um die Bedeutung der Interaktion im E-Learning zu untermauern und betont, wie entscheidend diese für die Qualität der Lernerfahrung und das Erreichen von Lernzielen ist.
},
	file = {Mojtahedzadeh et al. - 2024 - Students' experience of interpersonal interactions.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/Q92BP47D/Mojtahedzadeh et al. - 2024 - Students' experience of interpersonal interactions.pdf:application/pdf},
}

@article{behler_digital_2024,
	title = {Digital {Future} {Skills} in {Nursing}: {Fallbasiertes} {E}-{Learning} zur {Vermittlung} digitaler {Kompetenzen} im {Pflegestudium}},
	volume = {19},
	issn = {1861-6186, 2235-218X},
	shorttitle = {Digital {Future} {Skills} in {Nursing}},
	url = {https://econtent.hogrefe.com/doi/10.1024/1861-6186/a000792},
	doi = {10.1024/1861-6186/a000792},
	abstract = {Zusammenfassung: An der Hochschule Bielefeld wurde ein neues Modul „Digital Future Skills in Nursing (DiFuSiN)“ für den Bachelorstudiengang Pflege entwickelt. Studierende bauen im Rahmen dieses Moduls zentrale digitale Kompetenzen für ihren späteren Berufsalltag auf. Der Artikel gibt einen Überblick über die Entwicklung und den Aufbau des Moduls sowie über das im Projekt entstandene digitale Lehr-/ Lernmaterial (Open Educational Resources).},
	language = {de-DE},
	number = {2},
	urldate = {2024-03-29},
