@article{waschkau2020Ffd,
  title = {[Fit for the Future: Development of a seminar on aspects of digitization of healthcare as a contribution of Medical Sociology]},
  shorttitle = {[Fit for the Future},
  author = {Waschkau, Alexander and Götz, Katja and Steinhäuser, Jost},
  date = {2020-09},
  journaltitle = {Zeitschrift Fur Evidenz, Fortbildung Und Qualitat Im Gesundheitswesen},
  shortjournal = {Z Evid Fortbild Qual Gesundhwes},
  volume = {155},
  eprint = {32798192},
  eprinttype = {pmid},
  pages = {48--53},
  issn = {2212-0289},
  doi = {10.1016/j.zefq.2020.06.006},
  abstract = {INTRODUCTION: Topics regarding the digitization of the healthcare system are hardly being addressed during the undergraduate training of medical students, even though the promotion of skills in this area has been defined as a learning goal in the German National Competence-Based Learning Objectives for Undergraduate Medical Education (NKLM) since 2015. At the same time, telemedicine as one part of digitization is becoming increasingly important in the public perception as a tool supplementing access to care. Therefore, the aim was to give medical students in the fourth pre-clinical semester a first insight into topics of telemedicine and other aspects of digitization in the healthcare sector as part of a seminar. METHODS: On the basis of the existing literature, we developed the content and a didactic concept for the seminar "The doctor-patient relationship in the field of technological developments" in the Medical Sociology course for undergraduate medical students in their second year at the University of Lübeck. Inspired by Kirkpatrick's four-level model, the students were asked for topics they wished to cover regarding the digitization of healthcare and telemedicine at the start and their attitudes towards and experiences with telemedicine at the end of the seminar. RESULTS: A total of 184 students from the fourth pre-clinical semester attended the seminar. The survey response rate was 32\%. The topics most frequently requested by students were "Legal Framework", "Electronic Patient Record" and "Tele-consultation". 85\% of the students rated the topic "digitization of healthcare" as highly relevant for their future profession. Also 85\% of the students wished for easy-to-use telemedicine equipment. A third or more of the students reported considerable uncertainty about their ability to evaluate the benefits of health apps. CONCLUSIONS: The contents of the seminar met the students' demands. In the future, topics relating to the digitization of the health system should be increasingly integrated into undergraduate training; also, the students' feeling uncertain about their ability to assess various telemedical applications should be addressed.},
  langid = {german},
  pmcid = {PMC7832042},
  keywords = {0:Zeitschriftenartikel:digital:learning,Ausbildung,Charité:Promotion,Curriculum,Digitalisierung Telemedizin,Digitization,Education Medical Undergraduate,eHealth,Germany,Humans,Medizinische Soziologie,Physician-Patient Relations,Promotion:Literaturanalyse,Sozialwissenschaft,Students Medical,Telemedicine,Undergraduate training},
  annotation = {ZSCC: 0000003},
  file = {/Users/jochen_hanisch-johannsen/Zotero/storage/5WMTXZ9X/Waschkau et al. - 2020 - Fit for the Future - Entwicklung eines Seminars zu.pdf;/Users/jochen_hanisch-johannsen/Zotero/storage/SISANM8X/waschkau_et_al_2020_[fit_for_the_future.pdf}
}

@article{watanabe2022Tui,
  title = {The tech-savvy university: The implications of AI-supported learning for the traditional education missionDie technologieverliebte Hochschule: Was folgt aus dem KI-gestützten Lernen für den traditionellen Bildungsauftrag},
  shorttitle = {The tech-savvy university},
  author = {Watanabe, Alice and Schmohl, Tobias},
  date = {2022-10},
