@article{carson_development_2020,
	title = {Development and {Implementation} of a {Web}-{Based} {Learning} {Environment} for an {Inpatient} {Internal} {Medicine} {Team}: {Questionnaire} {Study}},
	volume = {6},
	url = {http://mededu.jmir.org/2020/2/e18102/},
	doi = {10.2196/18102},
	abstract = {Background: The notion of anytime, anyplace communication is characteristic of the current generation of learners. Such communications have facilitated the growth and integration of a blended or hybrid learning platform in multiple educational settings. However, there are limited reports on the use of an anytime, anyplace communication platform in clinical inpatient medical education. Objective: The setting of a high-demand inpatient clinical rotation is ideal for the use of collaborative software, and this integration is expected to positively influence medical education. The purpose of this study is to evaluate medical students? and residents? educational experiences with incorporating a simple, web-based content management and file sharing platform into an internal medicine inpatient rotation. Methods: During an inpatient internal medicine rotation, faculty and learners jointly used collaborative software for educational purposes, and a postrotation survey tool was used to measure the educational influence of the software. Results: Based on the results of the postrotation survey, the integration of a collaborative software application during clinical rotations improved the learning experience. Learning climate, the communication of rotation goals, and self-directed learning all scored favorably, but feedback from the survey participants was mixed. The learners enthusiastically accepted the practical use of this tool for both communication and information sharing. Conclusions: This generation of learners is accustomed to frequent electronic communication. Based on our survey, these learners appear to be highly receptive to this web-based intervention design for improving clinical education during active patient care. Adding effective blended learning features to a traditional clinical setting is achievable.},
	number = {2},
	journal = {JMIR Med Educ},
	author = {Carson, Y. Thaddeus and Hatzigeorgiou, Christos and Wyatt, R. Tasha and Egan, Sarah and Beidas, O. Sary},
	month = dec,
	year = {2020},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Systemanpassung, Promotion:FU5, Bildung, Multimedia, Sozialwissenschaft, \#8:Zeitschriftenartikel:blended:learning, medical education, online education, academic hospitalist, inpatient internal medicine, internal medicine education, internal medicine ward, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:S:08 Blended Learning, Promotion:Literaturverzeichnis},
	pages = {e18102},
	annote = {Hier ist die Analyse der Arbeit „Development and Implementation of a Web-Based Learning Environment for an Inpatient Internal Medicine Team: Questionnaire Study“ von Thaddeus Y. Carson et al. (2020).
1. Hauptthemen und Ziele der Forschung
Die Studie untersucht den Einsatz einer web-basierten Lernumgebung (Box) für die Ausbildungsrotationen im Bereich der stationären Inneren Medizin. Ziel ist es, durch diese Plattform die Kommunikation, Lernziele und Selbstständigkeit der Lernenden zu fördern. Insbesondere soll erfasst werden, wie sich die Plattform auf die Lernkultur und die Interaktion zwischen Lernenden und Dozierenden in einem klinischen Umfeld auswirkt.
2. Methoden und Datenquellen
Die Studie basierte auf einer Erhebung unter Studierenden und Assistenzärzten, die während ihrer klinischen Rotation die Plattform Box nutzten. Die Befragung nach der Rotation umfasste eine Kombination aus Likert-Skalen und offenen Fragen, um die Lernendenperspektive auf die Benutzerfreundlichkeit, Feedback-Kultur und das Selbstlernen zu erfassen. Die Stichprobe bestand aus 44 abgeschlossenen Fragebögen von insgesamt 67 verschickten, was einer Rücklaufquote von 66 \% entspricht.
3. Zentrale Forschungsergebnisse


Verbesserte Lernatmosphäre und Kommunikation: Die Mehrheit der Befragten bewertete die Lernumgebung als angenehm und förderlich für das Verständnis der Rotationsziele.


Erhöhte Selbstständigkeit: Die Plattform unterstützte das selbstgesteuerte Lernen, indem die Teilnehmenden ihre Präsentationen und Fallberichte eigenständig hochladen und jederzeit darauf zugreifen konnten.


Gemischtes Feedback zur Feedbackkultur: Während das asynchrone Feedback als praktisch bewertet wurde, bevorzugten einige Teilnehmer persönliches Feedback, um Missverständnisse zu vermeiden.


4. Zusammenfassung
Die Nutzung der Plattform Box zur Unterstützung der klinischen Ausbildung im Bereich Innere Medizin erwies sich als effektiv und wurde von den Lernenden positiv aufgenommen. Die digitale Plattform erleichterte die Kommunikation und das Teilen von Materialien und förderte eine selbstständige Lernkultur. Die Ergebnisse deuten jedoch darauf hin, dass eine hybride Feedbackkultur – bestehend aus sowohl asynchronem als auch persönlichem Feedback – von den Teilnehmenden als optimal angesehen wird.
5. Kernaussagen


Förderung des selbstgesteuerten Lernens: Die Lernenden empfanden die Möglichkeit zur eigenständigen Organisation als motivierend und praxisnah (S. 3).


Effiziente Feedback- und Kommunikationsstruktur: Die Plattform unterstützte die Kommunikation und die Nachverfolgbarkeit von Feedback zwischen den Dozierenden und Lernenden (S. 4).


Bedarf an persönlichem Feedback: Ein gewisser Anteil der Studierenden wünschte sich zusätzlich persönliches Feedback, um die Effektivität der Rückmeldungen zu erhöhen (S. 5).


6. Argumentationslinien
Carson et al. argumentieren, dass eine flexible digitale Plattform wie Box in der medizinischen Ausbildung wertvolle Vorteile bietet, insbesondere in stressigen klinischen Rotationen. Die Möglichkeit, Inhalte orts- und zeitunabhängig zu verwalten, fördert die Selbstständigkeit und Interaktion im Team. Sie betonen jedoch, dass digitale Feedbackformate durch persönlichen Austausch ergänzt werden sollten, um eine umfassende Unterstützung der Lernenden sicherzustellen.
7. Verschlagwortung


Lehr- und Lerneffektivität: Die Studie hebt die Bedeutung digitaler Tools zur Unterstützung und Förderung einer lernförderlichen Umgebung in der klinischen Ausbildung hervor.


Technologieintegration: Integration eines digitalen Lernsystems, um die Lernumgebung und die Kommunikationsstrukturen in der medizinischen Ausbildung zu optimieren.


Systemanpassung: Die Anpassung der klinischen Ausbildung an digitale Lernsysteme zur Verbesserung der Informationsverfügbarkeit und Feedbackprozesse.


8. Kategorisierung
Argumentation: Die Studie entwickelt eine Argumentation für den Nutzen digitaler Lernplattformen in der klinischen Ausbildung und zeigt auf, dass eine hybride Feedbackkultur die Vorteile digitaler und persönlicher Rückmeldungen vereinen kann.
9. Zuordnung zu Forschungsfragen
Passendste Forschungsfrage: FU5 – Die Studie untersucht die Möglichkeiten und Grenzen eines digitalen Lernsystems zur Unterstützung und Strukturierung der klinischen Ausbildung in der Inneren Medizin.
10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 – Die Arbeit bietet wertvolle Erkenntnisse zur Integration und Akzeptanz eines digitalen Lernsystems in der medizinischen Ausbildung.


Gesamtbewertung: 4.7 – Die Analyse liefert wichtige Einblicke in die Möglichkeiten der digitalen Unterstützung klinischer Lernprozesse und die optimale Kombination digitaler und persönlicher Feedbackmethoden.


Falls du spezifische Details zu bestimmten Abschnitten oder weitere Aspekte der Analyse benötigst, stehe ich zur Verfügung.
},
	file = {Carson et al. - 2020 - Development and Implementation of a Web-Based Learning Environment for an Inpatient Internal Medicin:/Users/jochenhanisch-johannsen/Zotero/storage/JXWTB32W/Carson et al. - 2020 - Development and Implementation of a Web-Based Learning Environment for an Inpatient Internal Medicin.pdf:application/pdf},
}

@article{hughes_mpowered_2020,
	title = {The {mPOWERED} {Electronic} {Learning} {System} for {Intimate} {Partner} {Violence} {Education}: {Mixed} {Methods} {Usability} {Study}},
	volume = {3},
	url = {https://nursing.jmir.org/2020/1/e15828},
	doi = {10.2196/15828},
	abstract = {Background: Nurse practitioners are a common resource for victims of intimate partner violence (IPV) presenting to health care settings. However, they often have inadequate knowledge about IPV and lack self-efficacy and confidence to be able to screen for IPV and communicate effectively with patients. Objective: The aim of this study was to develop and test the usability of a blended learning system aimed at educating nurse practitioner students on topics related to IPV (ie, the mPOWERED system [Health Equity Institute]). Methods: Development of the mPOWERED system involved usability testing with 7 nurse educators (NEs) and 18 nurse practitioner students. Users were asked to complete usability testing using a speak-aloud procedure and then complete a satisfaction and usability questionnaire. Results: Overall, the mPOWERED system was deemed to have high usability and was positively evaluated by both NEs and nurse practitioner students. Respondents provided critical feedback that will be used to improve the system. Conclusions: By including target end users in the design and evaluation of the mPOWERED system, we have developed a blended IPV learning system that can easily be integrated into health care education. Larger-scale evaluation of the pedagogical impact of this system is underway.},
	number = {1},
	journal = {JMIR Nursing},
	author = {Hughes, Charmayne and Musselman, A. Elaine and Walsh, Lilia and Mariscal, Tatiana and Warner, Sam and Hintze, Amy and Rashidi, Neela and Gordon-Murer, Chloe and Tanha, Tiana and Licudo, Fahrial and Ng, Rachel and Tran, Jenna},
	month = jan,
	year = {2020},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Bewertungsmethoden, Promotion:FU5, Bildung, Multimedia, \#8:Zeitschriftenartikel:blended:learning, nursing education, learning, domestic violence, intimate partner violence, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:S:08 Blended Learning, Promotion:Literaturverzeichnis},
	pages = {e15828},
	annote = {Hier ist die Analyse der Arbeit „The mPOWERED Electronic Learning System for Intimate Partner Violence Education: Mixed Methods Usability Study“ von Charmayne Hughes et al. (2020).
1. Hauptthemen und Ziele der Forschung
Die Studie zielt darauf ab, das mPOWERED-System – ein Blended-Learning-Tool für die Schulung von Pflegekräften zum Thema „Intimate Partner Violence“ (IPV) – zu entwickeln und dessen Usability zu testen. Das System soll Pflegepersonal in die Lage versetzen, IPV-Betroffene effektiver zu unterstützen und angemessene Interventionen bereitzustellen. Ziel war es, die Benutzerfreundlichkeit, Akzeptanz und die Eignung für den Einsatz in der Ausbildung von Pflegekräften zu bewerten.
2. Methoden und Datenquellen
Die Studie verwendete eine Kombination aus qualitativen und quantitativen Methoden. 25 Teilnehmende (Pflegeausbildende und Pflegestudierende) führten verschiedene Aufgaben im mPOWERED-System durch. Die Usability wurde durch eine „Think-Aloud“-Methode, Einzelinterviews und Fragebögen mit Likert-Skalen evaluiert. Die Analyse umfasste die Nutzerzufriedenheit, Systemnavigation und Ästhetik, unterstützt durch die Nutzung des eLearning-Usability-Fragebogens.
3. Zentrale Forschungsergebnisse


Hohe Benutzerfreundlichkeit und Akzeptanz: Die Teilnehmenden schätzten die modulare Struktur und die benutzerfreundliche Navigation des Systems. Sie lobten insbesondere die sofortige Rückmeldung zu Quizfragen und die didaktische Klarheit der Module.


Bedarf an realistischerem Feedback: Die Teilnehmenden empfanden das vorhandene Feedback als hilfreich, wünschten sich jedoch zusätzliche medizinische und psychologische Informationen zur Unterstützung der ersten Hilfemaßnahmen bei IPV.


Verbesserungsvorschläge für die Ästhetik: Einige Lehrkräfte kritisierten die Verwendung erster Person in bestimmten Anweisungen, da dies als suggestiv empfunden wurde. Auch eine Erweiterung der grafischen Darstellungen wurde empfohlen, um kulturelle Sensibilität besser zu vermitteln.


4. Zusammenfassung
Das mPOWERED-System bietet eine vielversprechende Blended-Learning-Plattform zur IPV-Schulung für Pflegekräfte und erhielt durchweg positives Feedback bezüglich Benutzerfreundlichkeit und Relevanz. Die Studie identifiziert jedoch auch Verbesserungsbedarf, etwa in Bezug auf die Vielfalt der Darstellungen und die Einbeziehung kulturell angemessener Icons und realitätsnaher Bilder. Die Forschenden empfehlen eine iterative Anpassung der Plattform, um die Lücke in der IPV-Ausbildung für Pflegekräfte zu schließen.
5. Kernaussagen


Einsatz von Quizfragen für aktives Lernen: Die Quiz-Module zur Selbstbewertung fördern das aktive Lernen und werden von Studierenden sehr geschätzt (S. 6).


Nutzerfreundlichkeit und intuitive Navigation: Das System ist benutzerfreundlich und ermöglicht eine flexible Anpassung des Lernfortschritts an das Lerntempo der Nutzer (S. 5).


Bedarf an zusätzlichen Schulungsinhalten: Die Erweiterung um praktische Anleitungen für Erstmaßnahmen bei IPV wurde als wertvoller Verbesserungsvorschlag betrachtet (S. 7).


6. Argumentationslinien
Hughes et al. argumentieren, dass ein benutzerfreundliches und interaktives E-Learning-System wie mPOWERED die Schulung von Pflegepersonal optimieren kann, indem es flexibles Lernen unterstützt und relevante Kompetenzen im Umgang mit IPV vermittelt. Sie betonen, dass die Einbeziehung von Feedbackschleifen und kulturell angepasster Inhalte für eine langfristige Akzeptanz entscheidend ist.
7. Verschlagwortung


Lehr- und Lerneffektivität: Das System erhöht die Effektivität der Ausbildung durch interaktive Module und Selbstbewertung.


Technologieintegration: Verwendung digitaler Medien zur Vermittlung sensibler Inhalte in der Pflegeausbildung.


Bewertungsmethoden: Kombination aus qualitativen und quantitativen Methoden zur Bewertung der Benutzerfreundlichkeit und Effektivität.


8. Kategorisierung
Argumentation: Die Studie stellt dar, dass Blended-Learning-Ansätze im Bereich Pflegebildung zur IPV-Schulung hilfreich sind, um Wissen effektiv zu vermitteln und gleichzeitig eine hohe Benutzerzufriedenheit zu gewährleisten.
9. Zuordnung zu Forschungsfragen
Passendste Forschungsfrage: FU5 – Die Studie untersucht die Möglichkeiten und Grenzen digitaler Trainingsmethoden zur Unterstützung und Weiterbildung von Pflegekräften im Bereich IPV.
10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 – Die Studie bietet detaillierte Erkenntnisse zur Wirksamkeit und Akzeptanz eines digitalen Systems zur Ausbildung in sensiblen Themenfeldern wie IPV.


Gesamtbewertung: 4.8 – Die Arbeit liefert wichtige Impulse für die Weiterentwicklung digitaler Lernsysteme im Gesundheitsbereich und trägt zur Verbesserung der Ausbildung von Pflegekräften bei.


Falls du eine vertiefte Analyse oder weitere Details benötigst, stehe ich bereit.
},
	file = {Hughes et al. - 2020 - The mPOWERED Electronic Learning System for Intimate Partner Violence Education Mixed Methods Usabi:/Users/jochenhanisch-johannsen/Zotero/storage/UUWY3V2R/Hughes et al. - 2020 - The mPOWERED Electronic Learning System for Intimate Partner Violence Education Mixed Methods Usabi.pdf:application/pdf},
}

@article{liaw_finding_2019,
	title = {Finding the {Right} {Blend} of {Technologically} {Enhanced} {Learning} {Environments}: {Randomized} {Controlled} {Study} of the {Effect} of {Instructional} {Sequences} on {Interprofessional} {Learning}},
	volume = {21},
	url = {http://www.jmir.org/2019/5/e12537/},
	doi = {10.2196/12537},
	abstract = {Background: With the availability and capabilities of varied technologically enhanced learning activities, the blended learning approach has become increasingly popular in interprofessional education. The combined use of different technologically enhanced learning activities has not been fully examined, particularly to determine the effects of instructional sequences for effective learning outcomes. Objective: The objective of this study was to investigate whether the instructional sequences of a blended learning approach can improve students? learning outcomes on interprofessional competencies. Methods: A randomized controlled study was conducted with 40 interprofessional health care teams. These teams undertook three technologically enhanced learning activities?Web-based instruction (WI), virtual reality (VR), and simulation exercise (SE)?after random assignment to three groups based on three different instructional sequences (WI-VR-SE, WI-SE-VR, and SE-WI-VR). Pretests and posttests were conducted to evaluate the students? learning outcomes on interprofessional competencies. Results: A total of 198 participants from the three groups completed the questionnaires. All three groups reported significant improvement in their levels of self-efficacy (P{\textless}.05) and attitudes (P{\textless}.001) toward interprofessional team care about 1 month after the interprofessional learning activity. Although no significant difference was found (P=.06) between the WI-VR-SE and WI-SE-VR groups in the self-efficacy posttests, participants in the SE-WI-VR group reported significantly lower (P{\textless}.05) posttest scores than those in the WI-SE-VR group. The majority of the participants (137/198, 69.1\%) selected the instructional sequence ?WI-VR-SE? as their top preference. Conclusions: This study shows that the instructional sequence of a blended learning approach can have a significant impact on students? learning outcomes. The learning of concepts from WI followed by problem-solving activity in the SE was found to be a more effective learning sequence than the reverse sequence. We recommend that future studies focus on scaffolding students? learning when planning instructional sequences for technologically enhanced learning activities within blended learning environments.},
	number = {5},
	journal = {J Med Internet Res},
	author = {Liaw, Ying Sok and Tan, Kiat Khoon and Wu, Ting Ling and Tan, Chee Seng and Choo, Hyekyung and Yap, John and Lim, Mui Sok and Wong, Lilian and Ignacio, Jeanette},
	month = may,
	year = {2019},
	keywords = {Simulation, Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Systemanpassung, Promotion:FU5, Bildung, Multimedia, \#8:Zeitschriftenartikel:blended:learning, constructivism, instructional sequence, interprofessional learning, technologically-enhanced learning, virtual reality, web-based instruction, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:S:08 Blended Learning, Promotion:Literaturverzeichnis},
	pages = {e12537},
	file = {Liaw et al. - 2019 - Finding the Right Blend of Technologically Enhanced Learning Environments Randomized Controlled Stu:/Users/jochenhanisch-johannsen/Zotero/storage/D7F7NDJV/Liaw et al. - 2019 - Finding the Right Blend of Technologically Enhanced Learning Environments Randomized Controlled Stu.pdf:application/pdf},
}

@article{stenzel_blended_2020,
	title = {Blended {Learning} zur {Betreuung} der deutschen männlichen {U19} {Handballnationalmannschaft} bei der {WM} 2019},
	volume = {27},
	issn = {1612-5010},
	url = {https://doi.org/10.1026/1612-5010/a000315},
	doi = {2021031609281400853},
	abstract = {Zusammenfassung. Die vorliegende Fallstudie beschreibt detailliert und ganzheitlich das App-basierte mentale Training (MT) der deutschen männlichen U19 Handballnationalmannschaft vor und während der Weltmeisterschaft 2019 in Mazedonien. Die Betreuung folgte einem Blended Learning Ansatz und bestand aus einem dreistündigen psychoedukativen Präsenzworkshop, einer App und einer begleitenden E-Mail-Kampagne. Die Eingangsdiagnostik, das Grundlagen- und Fertigkeitstraining sowie die Krisenintervention fanden über die auf das MT zugeschnittene App statt. Die Fallstudie enthält eine Outcome- und Prozess-Evaluation. Das Team gewann in Mazedonien die Silbermedaille. In anderen Outcome-Variablen zeigten sich keine signifikanten Veränderungen. Die Prozess-Evaluation zeigt, dass die Nutzungszeit mit der App gering war. In der Praxis arbeitende Sportpsychologinnen und Sportpsychologen sollten daher die Nutzung von Apps mit ausreichend persönlichem Kontakt mit Athletinnen und Athleten verbinden, um diese systematisch zu betreuen.},
	number = {4},
	urldate = {2021-04-06},
	journal = {Zeitschrift für Sportpsychologie},
	publisher = {Hogrefe Verlag},
	author = {Stenzel, Lukas and Röcken, Melissa and Thrien, Henning and Stoll, Oliver},
	month = oct,
	year = {2020},
	note = {ZSCC: 0000000},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Technologieintegration, Bewertungsmethoden, Promotion:Argumentation, Promotion:FU5, Bildung, Multimedia, \#8:Zeitschriftenartikel:blended:learning, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:S:08 Blended Learning, Promotion:Trainingsmethoden Sport, Promotion:Literaturverzeichnis},
	pages = {153--163},
	annote = {Hier ist die Analyse der Fallstudie „Blended Learning zur Betreuung der deutschen männlichen U19 Handballnationalmannschaft bei der WM 2019: Eine Fallstudie“ von Lukas Stenzel et al. (2020).
1. Hauptthemen und Ziele der Forschung
Die Fallstudie dokumentiert die Anwendung eines Blended-Learning-Ansatzes zur sportpsychologischen Betreuung der deutschen U19-Handballnationalmannschaft während der Vorbereitung und Teilnahme an der Weltmeisterschaft 2019 in Mazedonien. Ziel des Projekts war es, durch die Kombination eines Präsenzworkshops und einer App-basierten Plattform für mentales Training (MT) die Leistung der Athleten zu optimieren. Der Schwerpunkt lag auf der Vermittlung psychologischer Techniken zur Emotionsregulation, Konzentrationsförderung und Wettkampfvorbereitung.
2. Methoden und Datenquellen
Die Fallstudie nutzte ein praxisorientiertes Design, das auf einem dreistündigen psychoedukativen Präsenzworkshop, einer speziell angepassten App (Mindance) und einer E-Mail-Kampagne basierte. Die App ermöglichte ein kontinuierliches Monitoring und die Durchführung von Übungen im mentalen Bereich, die an das Strukturmodell der sportpsychologischen Betreuung von Beckmann und Elbe (2011) angepasst wurden. Evaluationsmethoden umfassten eine Prä- und Postmessung, die das Wohlbefinden, die Selbstwirksamkeit und die Wettkampfangst der Athleten bewertete, sowie eine Prozess-Evaluation zur Analyse der App-Nutzungszeit und -Akzeptanz.
3. Zentrale Forschungsergebnisse


Leistungsverbesserung und Selbstregulation: Die Nutzung der App trug zur Selbstregulation und zum Kompetenzaufbau bei, jedoch war die allgemeine Nutzungszeit der App gering.


Erhöhte Flexibilität und Eigenverantwortung: Die App ermöglichte es den Athleten, die Techniken zeit- und ortsunabhängig anzuwenden und ihre mentalen Fähigkeiten eigenständig zu trainieren.


Eingeschränkte Effektivität des Monitorings: Die Interaktion der Athleten mit der App blieb hinter den Erwartungen zurück, was die Datenerhebung für ein systematisches Monitoring und die Krisenintervention erschwerte.


4. Zusammenfassung
Die Studie zeigt, dass Blended Learning eine wertvolle Methode für die sportpsychologische Betreuung sein kann, jedoch ist der persönliche Kontakt weiterhin essentiell, um die Nutzung der digitalen Komponenten zu fördern. Die App konnte insbesondere im Bereich der Entspannungs- und Achtsamkeitstechniken zur Förderung der Emotionsregulation erfolgreich eingesetzt werden, doch die erwartete signifikante Verbesserung der Prä-Post-Messungen blieb aus. Die Ergebnisse unterstreichen die Notwendigkeit einer stärkeren Begleitung der Athleten, um die digitalen Werkzeuge effektiv zu integrieren.
5. Kernaussagen


Blended Learning als ergänzender Ansatz: Digitale Komponenten ergänzen den Präsenzkontakt und schaffen flexible Lern- und Trainingsmöglichkeiten (S. 155).


Wichtigkeit des kontinuierlichen Monitorings: Die geringe Nutzung des Monitoring-Tools zeigt, dass ohne ausreichende Interaktion mit den Sportpsychologen die Individualisierung und Anpassung der Übungen eingeschränkt ist (S. 159).


Feedback-gesteuerte Entwicklung: Die Prozess-Evaluation deutet darauf hin, dass Gamification und regelmäßiger persönlicher Kontakt die App-Nutzung fördern könnten (S. 160).


6. Argumentationslinien
Stenzel et al. argumentieren, dass die Einbindung von Blended Learning in die sportpsychologische Betreuung eine vielversprechende Ergänzung sein kann, wenn diese durch regelmäßige persönliche Betreuung ergänzt wird. Die Fallstudie zeigt, dass der Verzicht auf kontinuierlichen Kontakt die Akzeptanz und Nutzungsfrequenz der App reduzieren kann. Die Autoren regen an, dass zur Förderung der App-Nutzung regelmäßige Erinnerungen und Belohnungssysteme implementiert werden könnten, um die Motivation der Athleten zu steigern.
7. Verschlagwortung


Lehr- und Lerneffektivität: Die Bedeutung der kontinuierlichen Unterstützung zur Maximierung der Effektivität digitaler mentaler Trainingsmethoden.


Technologieintegration: Implementierung und Nutzung einer App für flexibles mentales Training im Spitzensport.


Bewertungsmethoden: Prozess- und Outcome-Evaluation zur Messung der Effektivität und Nutzungsintensität digitaler Trainingsmethoden.


8. Kategorisierung
Argumentation: Die Autoren legen dar, dass die Wirksamkeit einer Blended-Learning-Intervention im Spitzensport stark von der Integration persönlicher Kontaktpunkte abhängt und dass digitale Werkzeuge die Leistung fördern können, wenn sie individuell angepasst und regelmäßig unterstützt werden.
9. Zuordnung zu Forschungsfragen
Passendste Forschungsfrage: FU5 – Die Arbeit analysiert die Möglichkeiten und Grenzen digitaler Trainingsmethoden in der sportpsychologischen Betreuung.
10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 – Die Studie bietet detaillierte Einsichten in die Wirksamkeit und Akzeptanz digitaler Methoden für die sportpsychologische Betreuung.


Gesamtbewertung: 4.7 – Die Untersuchung der App-Nutzung und der Einflussfaktoren bietet wertvolle Hinweise für die Entwicklung und Implementierung effektiver Blended-Learning-Ansätze im Sportbereich.


Falls du weitere spezifische Details oder eine Vertiefung zu einzelnen Aspekten benötigst, stehe ich zur Verfügung.
},
	file = {Stenzel et al. - 2020 - Blended Learning zur Betreuung der deutschen männlichen U19 Handballnationalmannschaft bei der WM 20:/Users/jochenhanisch-johannsen/Zotero/storage/QYVTSXAE/Stenzel et al. - 2020 - Blended Learning zur Betreuung der deutschen männlichen U19 Handballnationalmannschaft bei der WM 20.pdf:application/pdf},
}

@article{baecker_agilitat_2017,
	title = {Agilität in der {Hochschule}},
	volume = {26},
	copyright = {Deutsches Urheberrecht},
	url = {https://www.pedocs.de/frontdoor.php?source_opus=16633},
	doi = {10/grstg6},
	abstract = {Hochschulen sind nicht dafür bekannt, den jeweils neuesten Managementmoden zu folgen. Das gilt auch für das Thema der agilen Produktentwicklung. Der Autor widmet sich trotzdem dem Thema, weil er zum einen den Eindruck hat, dass dieses Thema auch Hochschulen dabei helfen kann, sich auf elektronische Medien und digitale Apparate einzustellen, und zum anderen vermutet, dass Hochschulen in gewisser Weise immer schon agil gewesen sind. Agilität lässt sich für Zwecke der Hochschule als ein Managementkonzept verstehen, in dem die Anerkennung, Pflege und Entwicklung des Eigensinns von Fakultäten, Lehrstühlen und Mitarbeiterstellen durch die Einrichtung von Rückkopplungen konditioniert und kontrolliert wird, die diesen Eigensinn mit Aufgabenstellungen kombinieren, die von Außen kommen. Die Definition und Moderation dessen, was unter einem Außen verstanden wird, ist die vornehmste Aufgabe der Hochschulleitung, die unter den verschiedenen Kandidaten für dieses Außen, etwa Studienbewerbern, Stand der Wissenschaft und Anfragen von Aufsichtsbehörden, eine Innen bewältigbare Balance finden muss. (HoF/Text übernommen)},
	language = {de-DE},
	number = {1},
	urldate = {2023-02-17},
	journal = {Die Hochschule: Journal für Wissenschaft und Bildung},
	publisher = {HoF Wittenberg, Institut für Hochschulforschung an der Martin-Luther-Universität Halle-Wittenberg},
	author = {Baecker, Dirk},
	year = {2017},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Technologieintegration, Systemanpassung, Promotion:Argumentation, Promotion:Relevanz:4, \#7:Zeitschriftenartikel:digital:Medien, Bildung, Deutschland, Digitalisierung, Digitalization, Germany, Hochschule, Promotion:FU3, FernUni-Hagen:MABM:Master-Arbeit, Organisationsentwicklung, Organizational development, Bildungsmanagement, Educational management, Organisationsstruktur, Organizational structure, Promotion:S:07 Digitale Medien, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {19--28},
	annote = {Anmerkungen(17.2.2023, 22:37:35)
„Diesem Konzept der Agilität liegt das Verständnis einer alternativen Form von Hierarchie zugrunde, das erstmals von Herbert A. Simon unter der Überschrift einer „Architektur der Komplexität“ formuliert worden ist (Simon 1969/1981). Was Brian J. Robertson „holacracy“ nennt, eine ganzheitliche Herrschaft in der Form von Kreisen in Kreisen (Robertson 2015: 39), beschreibt Simon als Hierarchie von „nearly decomposable systems“, die man sich am besten nach dem Muster von Schachteln-inSchachteln, chinesischen Schachteln oder russischen Matrjoschka-Puppen vorstellt.“ (Baecker, 2017, p. 4) ist im Zulauf
„Simon nennt auch dies eine „Hierarchie“, obwohl der Begriff der Heterarchie besser passt (McCulloch 1965/1989; von Foerster 1993). Die intransitiven Verhältnisse von Oben und Unten, in denen die Führung von Oben durch die Information von Unten gekontert wird, werden durch transitive Verhältnisse von Innen und Außen ersetzt beziehungsweise ergänzt, in denen laufend neu ausgehandelt wird, wer oder was unter welchen Gesichtspunkten und für welche Zeitspannen führt und wer oder was folgt. Wenn A{\textgreater}B und B{\textgreater}C, gilt als Bedingung von Zirkularität auch C{\textgreater}A.“ (Baecker, 2017, p. 5) Hier liegt die Verknüpfung zur Systemtheorie *freu*
},
	annote = {Hier ist die Analyse des Artikels „Agilität in der Hochschule“ von Dirk Baecker (2017).
1. Hauptthemen und Ziele der Forschung
Der Artikel befasst sich mit der Anwendung des Agilitätskonzepts in Hochschulen und analysiert, wie agile Managementprinzipien die organisatorischen Strukturen von Hochschulen beeinflussen können. Baecker diskutiert, dass Hochschulen aufgrund ihrer traditionellen Struktur oft widerstandsfähig gegenüber Managementmoden sind. Er stellt jedoch die These auf, dass Hochschulen von der Agilität profitieren könnten, indem sie vertikale Strukturen durch Netzwerke ersetzen und dynamische Organisationsformen fördern.
2. Methoden und Datenquellen
Baecker führt eine theoretische Analyse durch und bezieht sich auf soziologische und organisationswissenschaftliche Literatur, einschließlich des Agilen Manifests und der Konzepte von Holokratie und Heterarchie. Die Argumentation wird durch historische und aktuelle Managementtheorien gestützt, wobei die Agilität im Kontext von Hochschulen mit deren bestehenden Strukturen kontrastiert wird.
3. Zentrale Forschungsergebnisse


Heterarchie statt Hierarchie: Hochschulen könnten durch heterarchische Strukturen, die auf Prioritätensetzungen und Netzwerken basieren, flexibler und anpassungsfähiger werden.


Selbstorganisation und Rückkopplung: Agilität erfordert eine verstärkte Selbstorganisation auf Fakultätsebene, unterstützt durch kontinuierliche Rückkopplungen mit externen Anforderungen.


Plattformen als Hochschulmodell: Durch digitale Transformation könnten Hochschulen zu Plattformen werden, die technische Infrastruktur mit sozialen Organisationen verbinden und agile Projektarbeit ermöglichen.


4. Zusammenfassung
Baecker beschreibt, wie Hochschulen durch agile Strukturen gestärkt werden könnten, indem sie ihre traditionellen, oft rigiden Strukturen zugunsten flexibler, projektbasierter Organisationsformen öffnen. Er sieht in der Agilität eine Möglichkeit, die Hochschule als Plattform zu begreifen, die kollaborative und dynamische Bildungsprozesse fördert und sich besser auf die Anforderungen der digitalen Transformation einstellen kann.
5. Kernaussagen


Kritik an Hierarchie: Die traditionelle vertikale Hierarchie behindert die Anpassungsfähigkeit und Innovationskraft von Hochschulen (S. 20).


Agilität als Netzwerk: Agilität fördert die Umstellung von Silostrukturen auf Netzwerke, die Selbstorganisation und schnelle Anpassung an externe Anforderungen ermöglichen (S. 22).


Plattformgedanke: Hochschulen als Plattformen könnten flexible und vernetzte Arbeits- und Lehrprozesse fördern, die dem dynamischen Umfeld der Digitalisierung besser gerecht werden (S. 27).


6. Argumentationslinien
Baecker argumentiert, dass Hochschulen in ihrer traditionellen Form als Institutionen agieren, die auf vertikalen Hierarchien basieren und dadurch auf Veränderungen träge reagieren. Er schlägt vor, dass Agilität durch die Einführung heterarchischer Strukturen und Netzwerke eine neue Dynamik in die Hochschulorganisation einbringen könnte. Indem er das Konzept der Hochschule als Plattform entwickelt, stellt er die These auf, dass agile Methoden Hochschulen helfen könnten, die Herausforderungen der digitalen Transformation effektiver zu bewältigen.
7. Verschlagwortung


Systemanpassung: Der Artikel analysiert, wie Hochschulen ihre Strukturen an die Anforderungen agiler und flexibler Organisationsformen anpassen können.


Technologieintegration: Agilität fördert die digitale Transformation, indem Hochschulen als Plattformen gestaltet werden, die technische und soziale Komponenten vereinen.


Forschungsansätze: Der Einsatz von Konzepten wie Heterarchie und Holokratie als Rahmen für agile Strukturen in Hochschulen.


8. Kategorisierung
Argumentation: Baecker entwickelt eine Argumentation für die Anwendung agiler Prinzipien in Hochschulen, um bestehende Hierarchien durch flexiblere und dynamischere Netzwerkstrukturen zu ersetzen und die Hochschule als Plattform zu gestalten.
9. Zuordnung zu Forschungsfragen
Passendste Forschungsfrage: FU3 – Die Arbeit untersucht die organisatorischen und strukturellen Merkmale von Hochschulen im Kontext agiler Transformationen und ihrer Anpassung an die digitale Bildung.
10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 4 – Der Artikel liefert wertvolle theoretische Einsichten in die potenzielle Anwendung agiler Managementprinzipien auf Hochschulstrukturen.


Gesamtbewertung: 4.5 – Die Diskussion über Agilität und die Zukunft der Hochschulorganisation bietet wichtige Impulse für die Weiterentwicklung von Hochschulen im digitalen Zeitalter.


Falls du weitere Vertiefungen oder eine detailliertere Analyse bestimmter Passagen benötigst, stehe ich bereit.
},
	file = {Baecker - 2017 - Agilität in der Hochschule.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/9A245MWD/Baecker - 2017 - Agilität in der Hochschule.pdf:application/pdf},
}

@article{ebner_editorialeditorial_2023,
	title = {{EditorialEditorial}: {Digitalisierung} der {Hochschullehre} – {Projekte} österreichischer {Hochschulen} 2020–2024},
	shorttitle = {{EditorialEditorial}},
	url = {https://zfhe.at/index.php/zfhe/article/view/1801},
	doi = {10/gr65vm},
	abstract = {As part of the Austria-wide call for "Projects for digital and social transformation in higher education" of the Federal Ministry of Education, Science and Research (BMBWF), a total of 50 million euros in funding was awarded in 2020 for in summary 34 projects. Funding is provided for forward-looking cooperative projects that aim to have a structurally transformative effect on Higher Education within their duration until 2024. This edition now offers the projects from the field of Higher Education the opportunity to make their project results and experiences accessible to a broad audience. In addition, it presents the extent to which the respective project contributes to the digital and social transformation of Austrian higher education and thus creates added value for the Austrian higher education landscape.},
	language = {de-DE},
	urldate = {2023-05-02},
	journal = {Sonderheft Hochschullehre},
	publisher = {Verlag der Technischen Universität Graz \& Verein Forum neue Medien in der Lehre Austria},
	author = {Ebner, Martin and Zwiauer, Charlotte},
	month = apr,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, Promotion:Relevanz:4, \#7:Zeitschriftenartikel:digital:Medien, Promotion:FU3, Promotion:S:07 Digitale Medien, Promotion:Literaturverzeichnis},
	pages = {11--16},
	annote = {Hier ist die Analyse des Editorials „Digitalisierung der Hochschullehre – Projekte österreichischer Hochschulen 2020–2024“ von Martin Ebner und Charlotte Zwiauer (2023):
1. Hauptthemen und Ziele der Forschung
Das Editorial gibt einen Überblick über Digitalisierungsprojekte an österreichischen Hochschulen, die im Rahmen des Programms „Digitale und soziale Transformation in der Hochschulbildung“ vom Bundesministerium für Bildung, Wissenschaft und Forschung gefördert wurden. Ziel ist es, die nachhaltige Integration digitaler Lösungen in die Lehre, Forschung und Verwaltung der Hochschulen zu fördern und den Transformationsprozess der Hochschullandschaft voranzutreiben.
2. Methoden und Datenquellen
Ebner und Zwiauer stellen die einzelnen Projekte vor, die im Rahmen eines Peer-Review-Prozesses für ihre wissenschaftliche Qualität bewertet wurden. Die Herausgeberinnen bieten eine kontextuelle Einordnung, die durch Beiträge von internationalen Expertinnen aus Deutschland und der Schweiz ergänzt wird.
3. Zentrale Forschungsergebnisse


Integration digitaler Lehrmethoden: Zahlreiche Projekte setzen auf MOOCs (Massive Open Online Courses) und digitale Plattformen wie iMooX.at, um den Wissenstransfer zu fördern und hochschulübergreifende Synergieeffekte zu nutzen.


Fachkompetenz durch Digitalisierung: Projekte wie eInformatics und CodeAbility Austria nutzen digitale Lehrmethoden zur Förderung von Fachkompetenzen, insbesondere im Bereich der Informatik und Programmierung, um langfristig dem Fachkräftemangel entgegenzuwirken.


Zukunftsfähige Lehrmodelle: Projekte wie „Teaching Digital Thinking“ oder „DigiFit4All“ implementieren neue didaktische Ansätze zur Förderung digitaler Kompetenzen bei Lehrenden und Lernenden.


Lernumgebungen und Analytics: Projekte zu Learning Analytics und Virtual Reality in der Lehre schaffen innovative und datenbasierte Lehr- und Lernmethoden, die durch analytische Tools zur Studienverlaufsvisualisierung unterstützt werden.


Community-Building und digitale Transformation: Begleitende Projekte legen einen starken Fokus auf die Vernetzung und Resilienz von Studierenden sowie auf die Nutzung offener Bildungsressourcen (OER).


4. Zusammenfassung
Das Editorial stellt die Vielseitigkeit der Digitalisierungsprojekte dar, die darauf abzielen, digitale Kompetenzen zu stärken und nachhaltige Lehrmodelle zu entwickeln. Durch einen Mix aus neuen Lernformaten wie MOOCs, Learning Analytics und Virtual-Reality-Anwendungen unterstützt die Initiative die Modernisierung der Hochschullehre und fördert eine Kultur der offenen Bildungsressourcen.
5. Kernaussagen


Digital gestützte Hochschullehre als Transformationsfeld: Digitale Lehrmethoden haben das Potenzial, die Hochschullehre nachhaltig zu verändern und Zugänge zu Wissen zu erleichtern (S. 12).


Synergieeffekte und offene Bildungsressourcen: Die Nutzung von OER und nationalen Plattformen wie iMooX.at ermöglicht eine ressourcenschonende Vernetzung und gemeinschaftliche Wissensvermittlung (S. 14).


Kompetenzentwicklung für die Zukunft: Die Projekte fördern spezifische digitale Kompetenzen und bieten Studierenden Tools zur Selbstorganisation und Resilienzförderung im Studium (S. 15).


6. Argumentationslinien
Die Herausgeber argumentieren, dass die Digitalisierung der Hochschullehre eine integrale Rolle in der Vorbereitung auf die Herausforderungen der modernen Wissensgesellschaft spielt. Digitale Lösungen werden nicht nur als Mittel zur Wissensvermittlung, sondern auch als Werkzeuge zur Förderung von Resilienz und Selbstwirksamkeit bei Studierenden betrachtet. Die langfristige Implementierung digitaler Kompetenzen und offener Bildungsressourcen wird als essenziell für die zukünftige Entwicklung der Hochschulen gesehen.
7. Verschlagwortung


Technologieintegration: Die Einführung digitaler Tools wie MOOCs und Virtual-Reality-Anwendungen in die Hochschullehre.


Lehr- und Lerneffektivität: Der Einsatz von Learning Analytics und anderen digitalen Werkzeugen zur Optimierung der Lehr- und Lernprozesse.


Systemanpassung: Anpassungen im Hochschulsystem zur Integration und Nutzung von offenen Bildungsressourcen und digitalen Plattformen.


8. Kategorisierung
Kerngedanke: Die Digitalisierung der Hochschullehre eröffnet neue Perspektiven für die Wissensvermittlung und stärkt durch offene und digitale Bildungsressourcen die Selbstorganisation und Kompetenzentwicklung von Studierenden.
9. Zuordnung zu Forschungsfragen
Passendste Forschungsfrage: FU3 – Die Arbeit behandelt die didaktische und bildungstechnologische Umsetzung digitaler Lehrmethoden und die Anpassung des Hochschulsystems an die Anforderungen der Digitalisierung.
10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 4 – Das Editorial bietet einen Überblick über die strukturellen und didaktischen Herausforderungen und Chancen der Digitalisierung in der Hochschulbildung.


Gesamtbewertung: 4.6 – Die Darstellung der Projekte zeigt praxisnahe Ansätze zur digitalen Transformation und liefert wertvolle Einblicke in die Zukunft der Hochschullehre in Österreich.


Falls du noch eine vertiefende Analyse bestimmter Abschnitte wünschst, bin ich bereit, weiter zu unterstützen.
},
	file = {Ebner und Zwiauer - EditorialEditorial Digitalisierung der Hochschull.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/9T5WYAS5/Ebner und Zwiauer - EditorialEditorial Digitalisierung der Hochschull.pdf:application/pdf},
}

@article{autenrieth_transformationsprozesse_2023,
	title = {Transformationsprozesse und der {Aufbau} von (medialer) {Gestaltungskompetenz} zur nachhaltigen {Entwicklung} in {Bildungsprozessen}},
	volume = {52},
	doi = {10.21240/mpaed/52/2023.02.06.X},
	abstract = {Der Beitrag präsentiert das Entwicklungsprojekt «Expo Zukunft der Nachhaltigkeit digital und partizipativ» (ExpoNaDig partizipativ) sowie erste qualitativ erhobene projektbegleitende Forschungsergebnisse. Im Zentrum steht ein virtuell-kreativer Raum, mit dem Ziel der gemeinschaftlichen und offenen Gestaltung einer erweiterbaren digitalen Weltausstellung für eine nachhaltige Zukunft. Es geht darum, jungen Menschen (national wie global) eine Plattform zu geben, um prospektiv ihre Ideen und Wünsche visualisieren zu können sowie um aus den Visionen der nachwachsenden Generation (Unterrichts-)Material und Aktivitäten zur Stärkung von Gestaltungskompetenzen zugunsten einer Bildung für nachhaltige Entwicklung abzuleiten. ExpoNaDig möchte für eine zukunftsfähige Entwicklung im Zusammenspiel von Ökologie, Sozialem und Ökonomie die in Grundsatz 21 der Rio-Deklaration angesprochene geistig-schöpferische Dimension stärken, in der es darum geht, «die Kreativität, die Ideale und den Mut der jungen Menschen auf der ganzen Welt» zu mobilisieren. Der Beitrag untersucht anhand des Projektbeispiels die Fragen danach, wie junge Menschen Nachhaltigkeits-Kompetenzen entwickeln können, und untersucht dabei (organisationslogische) Strukturen und deren Auswirkungen auf pädagogisches sowie kreatives und partizipatives Handeln.},
	journal = {MedienPädagogik: Zeitschrift für Theorie und Praxis der Medienbildung},
	author = {Autenrieth, Daniel and Nickel, Stefanie},
	month = feb,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Kollaboratives Lernen, Promotion:Relevanz:5, Technologieintegration, Systemanpassung, Bildungstheorien, \#7:Zeitschriftenartikel:digital:Medien, Promotion:Weiterführung, Promotion:FU5, Bildung, Multimedia, Promotion:S:07 Digitale Medien, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU5},
	pages = {108--128},
	annote = {Hier ist die Analyse des Artikels „Transformationsprozesse und der Aufbau von (medialer) Gestaltungskompetenz zur nachhaltigen Entwicklung in Bildungsprozessen“ von Daniel Autenrieth und Stefanie Nickel (2023):
1. Hauptthemen und Ziele der Forschung
Die Arbeit untersucht das Projekt „Expo Zukunft der Nachhaltigkeit digital und partizipativ“ (ExpoNaDig), das sich auf die Entwicklung einer digitalen Plattform zur Förderung von Gestaltungskompetenzen im Sinne der Bildung für nachhaltige Entwicklung konzentriert. Das Ziel ist, jungen Menschen einen kreativen Raum zur Verfügung zu stellen, um ihre Ideen und Visionen für eine nachhaltige Zukunft zu visualisieren und die dafür nötigen medialen und gestalterischen Kompetenzen zu entwickeln.
2. Methoden und Datenquellen
Die Arbeit basiert auf qualitativen Forschungsergebnissen, die projektbegleitend erhoben wurden. Es werden Interviews und Unterrichtsbeobachtungen durchgeführt und durch projektinterne Journale ergänzt. Die Analyse folgt einem rekonstruktiven Ansatz, um die Einflüsse von organisationslogischen Strukturen auf die pädagogische Arbeit und kreative Partizipation zu verstehen. Dabei wird die Strukturationstheorie von Anthony Giddens als theoretischer Rahmen verwendet.
3. Zentrale Forschungsergebnisse


Virtuelle Räume als Lernräume: Das Projekt zeigt, dass virtuelle Räume als sogenannte Heterotopien fungieren können, in denen Lernende neue Handlungsspielräume erfahren und nachhaltig gestalten können.


Gestaltungskompetenzen fördern durch Game-Design: Der Einsatz von Game-Design-Tools wie Minetest ermöglicht eine handlungsorientierte Auseinandersetzung mit Themen der Nachhaltigkeit und fördert eigenständiges sowie kooperatives Lernen.


Bildung für nachhaltige Entwicklung und Medienbildung: Die Kombination von medienpädagogischen Ansätzen und Bildung für nachhaltige Entwicklung unterstützt das Verständnis komplexer gesellschaftlicher Themen und fördert die kritische Reflexion sowie den Partizipationsgedanken.


4. Zusammenfassung
Autenrieth und Nickel beleuchten in ihrem Beitrag die potenziellen Bildungsansätze zur Förderung einer Kultur der Partizipation und der nachhaltigen Entwicklung. Durch das digitale Projekt ExpoNaDig erhalten Lernende die Möglichkeit, sich aktiv mit Themen der Nachhaltigkeit auseinanderzusetzen, kreative Lösungen zu entwickeln und ihre Gestaltungskompetenz in einer partizipativen Bildungsumgebung zu stärken.
5. Kernaussagen


Virtuelle Lernräume für Partizipation: Virtuelle Räume bieten einzigartige Möglichkeiten für das Erleben und Gestalten von Lernprozessen, die reale Handlungsräume erweitern (S. 109).


Gaming als Mittel zur Förderung nachhaltiger Entwicklung: Spiele wie Minetest fördern kollaborative und kreative Lernansätze, die wichtige Kompetenzen für nachhaltige Entwicklung stärken (S. 118).


Interdisziplinäre Medienbildung: Die Verbindung von Medienbildung und Nachhaltigkeit ermöglicht eine umfassende Bildung, die auf eine demokratische und partizipative Gesellschaft abzielt (S. 121).


6. Argumentationslinien
Die Autoren argumentieren, dass mediale Gestaltungskompetenzen eine Voraussetzung für die Bewältigung zukünftiger gesellschaftlicher Herausforderungen sind. Sie stellen heraus, dass virtuelle Räume als innovative Lernumgebungen fungieren, die durch Partizipation und kreative Freiheit die Handlungsfähigkeit und Gestaltungskompetenz von Lernenden fördern. Die theoretische Verankerung in der Strukturationstheorie zeigt, wie individuelle und strukturelle Komponenten in Bildungsprozessen ineinandergreifen und gemeinsam Lernprozesse gestalten.
7. Verschlagwortung


Technologieintegration: Das Projekt zeigt, wie digitale Tools in die Bildung integriert werden können, um nachhaltige Entwicklung zu fördern.


Systemanpassung: Die Anpassung der Bildung an die Anforderungen der Digitalisierung und Nachhaltigkeit wird durch das Projektmodell unterstützt.


Kollaboratives Lernen: Minetest als kollaboratives Tool fördert das gemeinsame Lernen und das Entwickeln von Lösungen im Team.


Bildungstheorien: Bezug auf die Strukturationstheorie und die Konzepte der politischen Medienbildung.


8. Kategorisierung
Weiterführung: Die Arbeit bietet neue Ansätze und Methoden für die Verbindung von Medienbildung und Nachhaltigkeit, die zukünftige Bildungsansätze prägen und erweitern können.
9. Zuordnung zu Forschungsfragen
Passendste Forschungsfrage: FU5 – Die Arbeit untersucht die Möglichkeiten und Grenzen virtueller Lernumgebungen und der Entwicklung von Gestaltungskompetenzen für nachhaltige Bildung.
10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 – Die Arbeit bietet wertvolle Einblicke in die pädagogische Nutzung virtueller Räume und die Förderung partizipativer Lernprozesse im Rahmen der Bildung für nachhaltige Entwicklung.


Gesamtbewertung: 4.8 – Die theoretisch fundierte und praxisnahe Analyse der Verbindung von Medienbildung und Nachhaltigkeit bietet ein wegweisendes Beispiel für zukunftsorientierte Bildungskonzepte.


Falls du eine vertiefende Analyse eines bestimmten Abschnitts benötigst, stehe ich bereit.
},
	file = {Volltext:/Users/jochenhanisch-johannsen/Zotero/storage/RH7IQHSU/Autenrieth und Nickel - 2023 - Transformationsprozesse und der Aufbau von (medial.pdf:application/pdf},
}

