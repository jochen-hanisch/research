@incollection{frasson_using_2023,
	address = {Cham},
	title = {Using {Feature} {Interaction} for {Mining} {Learners}’ {Hidden} {Information} in {MOOC} {Dropout} {Prediction}},
	volume = {13891},
	isbn = {978-3-031-32882-4 978-3-031-32883-1},
