import numpy as np import plotly.graph\_objects as go \# Parameter x\_res, y\_res = 200, 200 x\_vals = np.linspace(-2.0, 1.0, x\_res) y\_vals = np.linspace(-1.5, 1.5, y\_res) alpha = 0.01 max\_iter = 100 \# Fibonacci-Funktion def fibonacci(n): f = [0, 1] for i in range(2, n): f.append(f[-1] + f[-2]) return f[:n] fib\_seq = fibonacci(max\_iter) fib\_norm = [f / max(fib\_seq) for f in fib\_seq] \# Gitter vorbereiten X, Y = np.meshgrid(x\_vals, y\_vals) Z = np.zeros\_like(X) \# Berechnung for i in range(y\_res): for j in range(x\_res): c = complex(X[i, j], Y[i, j]) z = 0 + 0j for n in range(max\_iter): z = z*z + c + alpha * fib\_norm[n] if abs(z) {\textgreater} 2: break Z[i, j] = n \# 3D-Plot mit Plotly fig = go.Figure(data=[go.Surface(z=Z, x=X, y=Y, colorscale='Plasma')]) fig.update\_layout( title='3D-Oberfläche: Fibonacci-modulierte Mandelbrot-Menge', scene=dict( xaxis\_title='Re(c)', yaxis\_title='Im(c)', zaxis\_title='Iterationsanzahl', ), autosize=False, width=900, height=700, margin=dict(l=65, r=50, b=65, t=90) ) fig.show()

