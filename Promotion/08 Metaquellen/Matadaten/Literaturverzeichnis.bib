@article{kim_online_2022,
	title = {Online learning performance and engagement during the {COVID}-19 pandemic: {Application} of the dual-continua model of mental health},
	volume = {13},
	issn = {1664-1078},
	shorttitle = {Online learning performance and engagement during the {COVID}-19 pandemic},
	url = {https://www.frontiersin.org/articles/10.3389/fpsyg.2022.932777/full},
	doi = {10.3389/fpsyg.2022.932777},
	abstract = {The COVID-19 pandemic has led to an abrupt transition from face-to-face learning to online learning, which has also affected the mental health of college students. In this study, we examined the relationship between students’ adjustment to online learning and their mental health by using the Dual-Continua Model. The model assumes that mental disorder and mental well-being are related yet distinct factors of mental health. For this purpose, 2,933 college students completed an online survey around the beginning of the Fall semester of 2020 (
              N
              = 1,724) and the Spring semester of 2021 (
              N
              = 1,209). We assessed participants’ mental well-being, mental disorders, and academic distress by means of the online survey. In addition, we incorporated grades and log data accumulated in the Learning Management System (LMS) as objective learning indicators of academic achievement and engagement in online learning. Results revealed that two dimensions of mental health (i.e., mental well-being and mental disorder) were independently associated with all objective and subjective online learning indicators. Specifically, languishing (i.e., low levels of mental well-being) was negatively associated with student engagement derived from LMS log data and academic achievement and was positively associated with self-reported academic distress even after we controlled for the effects of mental disorder. In addition, mental disorder was negatively related to student engagement and academic achievement and was positively related to academic distress even after we controlled for the effects of mental well-being. These results remained notable even when we controlled for the effects of sociodemographic variables. Our findings imply that applying the Dual-Continua Model contributes to a better understanding of the relationship between college students’ mental health and their adaptation to online learning. We suggest that it is imperative to implement university-wide interventions that promote mental well-being and alleviate psychological symptoms for students’ successful adjustment to online learning.},
	language = {en-GB},
	urldate = {2024-06-28},
	journal = {Frontiers in Psychology},
	author = {Kim, Jinwon and Moon, Kibum and Lee, Jiye and Jeong, Yaewon and Lee, Seungjin and Ko, Young-gun},
	month = jul,
	year = {2022},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Bewertungsmethoden, Promotion:FU2a, Promotion:Argumentation, \#1:Zeitschriftenartikel:learning:management:system, Promotion:S:01 Learning Management System, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {932777},
	annote = {Analyse des Artikels "Online learning performance and engagement during the COVID-19 pandemic: Application of the Dual-Continua Model of mental health" von Kim et al. (2022)
1. Analyse
Hauptthemen und -ziele der Forschung: Der Artikel untersucht die Auswirkungen der abrupten Umstellung auf Online-Lernen während der COVID-19-Pandemie auf die mentale Gesundheit und das Engagement von College-Studenten. Das Dual-Continua-Modell der mentalen Gesundheit wird angewendet, um die Beziehung zwischen mentalem Wohlbefinden, mentalen Störungen und der Anpassung an Online-Lernumgebungen zu analysieren.
Verwendete Methoden und Datenquellen:


Methodische Ansätze: Quantitative Analyse mittels Online-Umfragen und LMS-Log-Daten.


Werkzeuge und Datenquellen: Online-Umfragen zur mentalen Gesundheit und akademischen Belastung, GPA-Daten und LMS-Log-Daten zur Messung des Engagements und der Leistung der Studierenden.


Zentrale Forschungsergebnisse:


Zwei Dimensionen der mentalen Gesundheit: Sowohl mentales Wohlbefinden als auch mentale Störungen beeinflussen unabhängig voneinander das Engagement und die akademische Leistung der Studierenden.


Einfluss der mentalen Gesundheit: Niedriges mentales Wohlbefinden (Languishing) korreliert negativ mit dem Engagement und der akademischen Leistung und positiv mit akademischer Belastung, auch nach Kontrolle für mentale Störungen.


Nutzung von LMS-Daten: LMS-Log-Daten sind valide Indikatoren für das Engagement und können zur Identifikation von Studierenden mit geringerem Wohlbefinden und höheren Belastungen verwendet werden.


2. Zusammenfassung
Kernpunkte des Artikels:


Problemstellung: Untersuchung der Beziehung zwischen mentaler Gesundheit und Anpassung an Online-Lernumgebungen während der COVID-19-Pandemie.


Methodik: Quantitative Analyse von Online-Umfragen und LMS-Log-Daten.


Hauptergebnisse: Beide Dimensionen der mentalen Gesundheit beeinflussen unabhängig voneinander das Engagement und die akademische Leistung.


Schlussfolgerungen: Universitätsweite Interventionen sind notwendig, um das mentale Wohlbefinden zu fördern und die Anpassung der Studierenden an Online-Lernumgebungen zu verbessern.


3. Kernaussagen


Mentales Wohlbefinden und Engagement: „Participants classified as flourishing and moderately healthy took part in online classes more actively and consistently and obtained higher GPAs than those classified as languishing.“ (S. 8)


Mentale Störungen und akademische Belastung: „Participants with mental illness showed higher levels of academic distress, poorer academic performance, and lower levels of engagement in online learning than those without mental illness.“ (S. 8)


Nutzung von LMS-Daten: „LMS logs can be used to objectively measure students’ actual engagement.“ (S. 10)


4. Argumentationslinien


Bedeutung der mentalen Gesundheit: Der Artikel argumentiert, dass sowohl mentales Wohlbefinden als auch mentale Störungen wesentliche Faktoren für das Engagement und die Leistung in Online-Lernumgebungen sind.


Nutzung von LMS-Daten: Es wird betont, dass LMS-Log-Daten als objektive Maßstäbe für das Engagement der Studierenden verwendet werden können, um gezielte Interventionen zu entwickeln.


Notwendigkeit von Interventionen: Der Artikel hebt hervor, dass universitätsweite Interventionen notwendig sind, um das mentale Wohlbefinden zu fördern und die Anpassung der Studierenden an Online-Lernumgebungen zu unterstützen.


5. Verschlagwortung


Lehr- und Lerneffektivität


Begründung: Der Artikel untersucht die Auswirkungen der mentalen Gesundheit auf das Engagement und die akademische Leistung der Studierenden.


Fundstelle: S. 8




Bewertungsmethoden


Begründung: Die Nutzung von LMS-Log-Daten als objektive Maßstäbe für das Engagement wird untersucht.


Fundstelle: S. 10




Krisenreaktion im Bildungsbereich


Begründung: Der Artikel thematisiert die Anpassung an Online-Lernumgebungen während der COVID-19-Pandemie.


Fundstelle: S. 1




6. Kategorisierung


Kategorie: Argumentation


Kriterium: Der Artikel nutzt empirische Daten, um die These zu stützen, dass mentale Gesundheit einen signifikanten Einfluss auf das Engagement und die Leistung in Online-Lernumgebungen hat.


Beispiel: Der Artikel diskutiert detailliert die unabhängigen Effekte von mentalem Wohlbefinden und mentalen Störungen auf das Engagement und die akademische Leistung der Studierenden.




7. Zuordnung zu Forschungsfragen


FU2a: Welchen Effekt erläutern Lernende im digitalen Bildungsraum von Gesundheitsberufen bei der Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems?


Begründung: Der Artikel untersucht die Auswirkungen der mentalen Gesundheit auf die Anpassung an Online-Lernumgebungen, was für die Effekte auf Lernende im digitalen Bildungsraum relevant ist.


Fundstelle: S. 8




8. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5/5


Der Artikel liefert detaillierte Einblicke in die Auswirkungen der mentalen Gesundheit auf das Engagement und die Leistung in Online-Lernumgebungen, die direkt relevant für die Forschungsfrage sind.




Zitierhäufigkeit und Einfluss des Artikels: 4/5


Basierend auf der detaillierten Untersuchung und der praktischen Anwendung der Ergebnisse ist der Artikel wahrscheinlich in akademischen Kreisen einflussreich.




Aktualität des Artikels: 5/5


Veröffentlicht im Jahr 2022, ist der Artikel aktuell und bezieht sich auf relevante Entwicklungen im Bereich der digitalen Bildung und mentalen Gesundheit.




Gesamtbewertung: 5/5
Diese Analyse zeigt die Relevanz des Artikels für die Untersuchung der Auswirkungen der mentalen Gesundheit auf das Engagement und die Leistung in Online-Lernumgebungen und bietet wertvolle Einblicke für zukünftige Forschungen und Praktiken.
},
	file = {Kim et al. - 2022 - Online learning performance and engagement during .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/Q668HNDR/Kim et al. - 2022 - Online learning performance and engagement during .pdf:application/pdf},
}

@article{chung_self-managed_2022,
	title = {A {Self}-{Managed} {Online} {Mindfulness} {Program} in a {University}-{Wide} {Learning} {Management} {System} {Orientation} {Site}: {A} {Real}-{World} {Ecological} {Validation} {Study}},
	volume = {13},
	issn = {1664-1078},
	shorttitle = {A {Self}-{Managed} {Online} {Mindfulness} {Program} in a {University}-{Wide} {Learning} {Management} {System} {Orientation} {Site}},
	url = {https://www.frontiersin.org/articles/10.3389/fpsyg.2022.869765/full},
	doi = {10.3389/fpsyg.2022.869765},
	abstract = {The efficacy of mindfulness-based interventions in randomised-controlled trials and large experimental studies has been demonstrated in university student populations. Whilst these investigations have provided insight into the nature of the delivery of mindfulness-based practices, there has been little research in the implementation of self-managed online student wellbeing and mindfulness programs at university. This ecological validation study conducted in 2020 evaluated a real-world implementation of a large, university-wide, online mindfulness-based program that was accessible fully online via the tertiary institutions’ Learning Management System (LMS) student orientation site. The total sample included 833 participants from a range of disciplines and faculties at Monash University, Australia. At the end of the study, 236 (28.3\%) participants were retained and completed the follow-up survey. Participants had the option to engage with the fully self-managed online mindfulness program for a 12-week semester. The mindfulness practices were pre-recorded, audio-guided sessions, and 10–15 min in length. Baseline and end of semester questionnaires included the 14-item Warwick-Edinburgh Mental Wellbeing Scale, 10-item Perceived Stress Scale and the 18-item Five Facet Mindfulness Questionnaire. Participants who engaged with the mindfulness program over 3 or more weeks showed significant improvements in all three outcome measures, and all participants showed significant improvements in wellbeing at the end of semester. Learning analytics obtained via the LMS revealed that 58.6\% (
              n
              = 489) had not logged into the mindfulness program at all, almost a third (31.0\%,
              n
              = 259) logged into the program materials once or twice, and 10.2\% (
              n
              = 85) of the whole sample engaged with the program actively, having logged in three or more times. The total number of student logins peaked in week 2, reduced between week 2 and week 7 and thereafter activity remained stable until the end of the semester. We hypothesise that the changes in wellbeing, stress and mindfulness at the end of the semester seen in the low engagement participants may partly be explained by the circumstances of COVID-19 restrictions improving. This study has revealed and discusses the complexities of student behaviour and implications for implementing an online mindfulness program in the real- world setting of a university.},
	language = {en-GB},
	urldate = {2024-06-28},
	journal = {Frontiers in Psychology},
	author = {Chung, Jennifer and Mundy, Matthew E. and McKenzie, Stephen},
	month = may,
	year = {2022},
