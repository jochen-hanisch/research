@article{mejeh_effects_2024,
	title = {Effects of adaptive feedback through a digital tool – a mixed-methods study on the course of self-regulated learning},
	issn = {1360-2357, 1573-7608},
	url = {https://link.springer.com/10.1007/s10639-024-12510-8},
	doi = {10.1007/s10639-024-12510-8},
	abstract = {Lifelong learning is emerging as a key priority for promoting equity and sustainability in societies. Self-regulated learning (SRL) is a fundamental requirement for achieving successful lifelong learning, and digitization is increasingly influential in this regard. This mixed-methods study explores the degree to which adaptive learning technology (ALT) can assist university students in their SRL with timely and personalized support. Additionally, the study examines how students perceive this feedback and incorporate it into their learning behavior. Using hierarchical linear modeling, we investigated the development of SRL over a 9-week period. Semi-structured interviews were conducted with purposively selected learners, based on stimulated recalls. The quantitative results demonstrate positive development in certain components of SRL. Furthermore, the results indicate that metacognitive activity can be partially predicted by motivational and emotional states. The qualitative findings reveal that learners have varying perceptions of feedback received from ALT and integrate it into their learning behaviors based on their individual benefits. The results support the assumption that feedback provided through educational technology must be precisely tailored to the needs of learners, taking into account the dynamics of their individual learning processes. The study contributes to the ongoing discussion on the design of educational technology.},
	language = {en-GB},
	urldate = {2024-03-07},
	journal = {Education and Information Technologies},
	author = {Mejeh, Mathias and Sarbach, Livia and Hascher, Tina},
	month = mar,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Bewertungsmethoden, Promotion:FU2a, Promotion:Argumentation, Promotion:Relevanz:4, \#0:Zeitschriftenartikel:digital:learning, Promotion:S:12 Digital Learning, Promotion:Literaturverzeichnis},
	annote = {nalyse der Studie "Effects of adaptive feedback through a digital tool – a mixed-methods study on the course of self-regulated learning" von Mejeh et al. (2024)
Hauptthemen und Ziele der Forschung:
Die Studie von Mejeh et al. (2024) untersucht, inwieweit adaptive Lerntechnologien (ALT) universitären Studierenden durch zeitnahes und personalisiertes Feedback bei der Selbstregulation ihres Lernprozesses (SRL) unterstützen können. Zusätzlich wird analysiert, wie die Studierenden dieses Feedback wahrnehmen und in ihr Lernverhalten integrieren. Die Forschung zielt darauf ab, die Entwicklung von SRL über einen Zeitraum von neun Wochen zu erforschen und die Rolle von metakognitiven Aktivitäten, motivationalen und emotionalen Zuständen zu bewerten (S. 1).
Methoden und Datenquellen:


Quantitative Methode: Hierarchische lineare Modelle zur Untersuchung der Entwicklung von SRL über neun Wochen.


Qualitative Methode: Halbstrukturierte Interviews mit ausgewählten Lernenden basierend auf stimulierten Erinnerungen (S. 1).


Zentrale Forschungsergebnisse:


Positive Entwicklung von SRL: Die quantitativen Ergebnisse zeigen eine positive Entwicklung bestimmter Komponenten von SRL, wobei metakognitive Aktivitäten teilweise durch motivationale und emotionale Zustände vorhergesagt werden können (S. 1).


Verschiedene Wahrnehmungen von Feedback: Die qualitativen Ergebnisse offenbaren, dass die Lernenden das Feedback unterschiedlich wahrnehmen und es in ihr Lernverhalten je nach individuellem Nutzen integrieren (S. 1).


Zusammenfassung
Die Studie von Mejeh et al. (2024) zeigt, dass adaptive Lerntechnologien (ALT) die selbstregulierten Lernfähigkeiten der Studierenden durch zeitnahes und personalisiertes Feedback signifikant unterstützen können. Die Ergebnisse unterstreichen die Notwendigkeit, dass Feedback durch Bildungstechnologie präzise auf die Bedürfnisse der Lernenden zugeschnitten sein muss, um deren individuelle Lernprozesse optimal zu fördern.
Kernaussagen


Adaptive Lerntechnologien (ALT): Die Studie zeigt, dass ALTs die selbstregulierten Lernfähigkeiten verbessern können, indem sie personalisiertes und zeitnahes Feedback bieten (S. 1).


Metakognitive Aktivitäten: Diese können durch motivationale und emotionale Zustände teilweise vorhergesagt werden (S. 1).


Argumentationslinien
Die Autoren argumentieren, dass Feedback, das durch adaptive Lerntechnologien bereitgestellt wird, genau auf die individuellen Bedürfnisse der Lernenden zugeschnitten sein muss, um deren SRL optimal zu unterstützen. Sie betonen die Bedeutung der dynamischen Natur von SRL und die Notwendigkeit, personalisiertes Feedback in Echtzeit zu bieten, um die Lernprozesse effektiv zu fördern (S. 1).
Verschlagwortung
Passendste Schlagworte und Begründungen:


Lehr- und Lerneffektivität:


Die Untersuchung der Effektivität von personalisiertem Feedback durch adaptive Lerntechnologien zeigt, wie diese Technologien zur Verbesserung des selbstregulierten Lernens beitragen können (S. 1).




Bewertungsmethoden:


Die Analyse der Wirkungen von Feedback auf SRL durch hierarchische lineare Modelle und halbstrukturierte Interviews bietet Einblicke in die Bewertung der Lernprozesse und deren Effektivität (S. 1).




Technologieintegration:


Die Implementierung und Nutzung von adaptiven Lerntechnologien als Mittel zur Unterstützung des Lernprozesses unterstreicht die Bedeutung der Integration technologischer Tools in Bildungsumgebungen (S. 1).




Kategorisierung


Argumentation: Die Studie diskutiert die Notwendigkeit und Effektivität von personalisiertem Feedback durch adaptive Lerntechnologien, um die SRL-Prozesse der Studierenden zu unterstützen und zu verbessern (S. 1).


Zuordnung zu der passendsten Forschungsunterfrage
Passendste Forschungsunterfrage:


FU2a: Welchen Effekt erläutern Lernende im digitalen Bildungsraum von Gesundheitsberufen bei der Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems?


Begründung: Die Studie analysiert, wie adaptive Lerntechnologien das selbstregulierte Lernen der Studierenden unterstützen, was direkt die Frage nach den Effekt-Faktoren für Lernende im digitalen Bildungsraum betrifft (S. 1).
Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 5 (Die Studie untersucht umfassend die Nutzung und Wirkung von adaptive Lerntechnologien zur Unterstützung von SRL).


Zitierhäufigkeit und Einfluss: 4 (Die Studie ist methodisch stark und behandelt ein aktuelles und relevantes Thema, das potenziell oft zitiert wird).


Aktualität: 5 (Die Studie ist von 2024 und behandelt ein hochaktuelles Thema).


Gesamtbewertung: 4.75
Schlussfolgerung
Die Studie von Mejeh et al. (2024) zeigt, dass adaptive Lerntechnologien (ALT) die selbstregulierten Lernfähigkeiten der Studierenden durch personalisiertes und zeitnahes Feedback signifikant unterstützen können. Die Ergebnisse unterstreichen die Notwendigkeit, dass Feedback durch Bildungstechnologie präzise auf die Bedürfnisse der Lernenden zugeschnitten sein muss, um deren individuelle Lernprozesse optimal zu fördern.
},
	file = {Mejeh et al. - 2024 - Effects of adaptive feedback through a digital too.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/F9UP3M2K/Mejeh et al. - 2024 - Effects of adaptive feedback through a digital too.pdf:application/pdf},
}

@incollection{buddeberg_forderung_2023,
	title = {Förderung von didaktischen {Reflexionsprozessen} bei der {Gestaltung} von digital gestütztem {Lernmaterial}},
	abstract = {Wie nicht zuletzt der pandemiebedingte Distanzunterricht deutlich gemacht hat, besteht ein Bedarf an der Förderung von Medienkompetenzen bei (angehenden) Lehrkräften. Diesbezügliche Lerngelegenheiten in der Lehrkräftebildung werden als essenziell angesehen, um eine lernförderliche Anwendung digitaler Medien im Unterricht zu erlernen und dahingehende didaktische Reflexionsprozesse anzustoßen. Hieran anknüpfend wird ein Projekt vorgestellt, in dem ein Selbstlernkurs für Lehramtsstudierende zur digital gestützten Gestaltung von interaktivem Lernmaterial entwickelt und eingesetzt wird. Eingebettet in die uni­versitäre Lehre erhalten Lehramtsstudierende Lerngelegenheiten zum Einüben mediendidaktischer Kompetenzen, indem sie eigenständig Themen als digitale Lerneinheiten aufbereiten und dazu direktes Feedback bekommen. Ziel ist es, dass die Studierenden nicht nur in der technischen Aufbereitung von Lerninhalten unterstützt werden, sondern – verknüpft mit kognitionspsychologischen Lerntheorien und didaktischen Konzepten – interaktive Lernmaterialien derart reflektieren und digital-gestützt aufbereiten können, dass sie adaptiv, motivierend und lernunterstützend eingesetzt werden können.},
