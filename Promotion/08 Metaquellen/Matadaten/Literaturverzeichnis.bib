@article{muller_arbeitsprozessorientierung_2020,
	title = {Arbeitsprozessorientierung in der {Berufsausbildung} von {Notfallsanitäter}/innen: {Planungstool} zur {Erstellung} von {Lernaufgaben} als {Transmissionsriemen} für eine kompetenzorientierte {Lernprozessgestaltung}},
	volume = {23},
	issn = {1434-6222, 1436-0578},
	shorttitle = {Arbeitsprozessorientierung in der {Berufsausbildung} von {Notfallsanitäter}/innen},
	url = {http://link.springer.com/10.1007/s10049-019-0612-2},
	doi = {10/ggtfdx},
	language = {de-DE},
	number = {1},
	urldate = {2022-06-18},
	journal = {Notfall + Rettungsmedizin},
	author = {Müller, H.-J. and König, H. and Prescher, T.},
	month = feb,
	year = {2020},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Promotion:FU4a, Systemanpassung, Bildungstheorien, Promotion:Argumentation, Promotion:Relevanz:3, Promotion:Literaturverzeichnis, Promotion:sec:Ergebnisse-FU4a, AVIVA+, Promotion:chap:04-05},
	pages = {1--15},
	annote = {{\textless}div class="zotero-note"{\textgreater}{\textless}pre{\textgreater}**Analyse der Quelle „Arbeitsprozessorientierung in der Berufsausbildung von Notfallsanitäter/innen: Planungstool zur Erstellung von Lernaufgaben …“ (Müller, König \&amp; Prescher, 2020)** **1. Hauptthemen und Ziele der Forschung** Der Beitrag argumentiert für eine kompetenzorientierte Lernprozessgestaltung in der Notfallsanitäterausbildung über arbeits-/patientenprozessorientierte Lernaufgaben. Ziel ist die Vorstellung eines Planungswerkzeugs, das Lernaufgaben systematisch aus Arbeitsprozessen ableitet und dadurch „Selbsterschließung“ der Lernenden unterstützt. (S. 1) **2. Methoden und Datenquellen** - **Texttyp:** Konzept-/Praxisbeitrag mit curricular-didaktischer Argumentation; Darstellung eines Tools/Planungsrasters.- **Datenbasis:** Literaturbezüge + exemplarische Tabellen/Planungsschritte; keine klar ausgewiesene empirische Studie im Beitrag. (S. 1, Tabellen ab S. 6 ff.) **3. Zentrale Ergebnisse** - Selbststeuerung wird als normativ aufgeladenes Schlagwort kritisiert; entscheidend sei didaktische Kontext- und Zielpassung (Selbststeuerung nicht per se besser). (S. 1)- Eine „Didaktik 2. Ordnung“ wird vorgeschlagen: Unterricht soll von Lernenden/Kompetenzentwicklung her gestaltet werden, mit Gestaltungs- und Entwicklungsaufgaben als Strukturmomente. (S. 1)- Das Planungswerkzeug strukturiert die Konstruktion patientenprozessorientierter Lernaufgaben (Rahmenbedingungen klären, Produkte festlegen, Arbeitsschritte/Lerninhalte bestimmen, Aufgabenstellung formulieren). (S. 6–12) **4. Zusammenfassung** Die Quelle bietet eine stark anschlussfähige berufspädagogische Operationalisierung von Kompetenzorientierung: Lernprozesse werden als selbsterschließende Bearbeitung realer Arbeits-/Patientenprozesse gerahmt und über ein Tool in konkrete Lernaufgaben übersetzt. Für deine Arbeit ist sie besonders relevant als Beispiel dafür, wie Prozesslogiken (Arbeitsprozess/Patientenprozess) in didaktische Orchestrierung (Aufgaben/Produkte/Schritte) überführt werden. **5. Kernaussagen (mit Fundstellen)** - „Im Mittelpunkt stehen die Lernenden!“ (S. 1)- „Doch Selbststeuerung kann nicht per se als vorteilhafter als ein anderes didaktisches Szenario bewertet werden … Es kommt darauf an, den Kontext, das Ziel und eine entsprechende didaktische Aufbereitung mit Lernaufgaben zu gestalten.“ (S. 1)- „Statt … einer … ‚Didaktik 1. Ordnung‘ sollten Lernprozesse eher von einer ‚subjektorientierten‘ Sicht … von den Lernenden und ihrer Kompetenzentwicklung her gestaltet werden.“ (S. 1) **6. Argumentationslinien (mit Fundstellen)** Der Beitrag entfaltet eine Argumentation in drei Schritten: (1) Kritik an verkürzter Selbststeuerungsrhetorik und Forderung nach didaktischer Passung (S. 1), (2) Begründung kompetenzorientierter Lernprozessgestaltung als subjekt-/kompetenzzentrierte Didaktik (S. 1), (3) Operationalisierung über ein Planungswerkzeug zur Erstellung arbeits-/patientenprozessorientierter Lernaufgaben (Tabellen/Schritte; S. 6–12). **7. Verschlagwortung (nur relevante Schlagwörter)** - **Bildungstheorien:** Kompetenzorientierung, konstruktivistische Lernwirksamkeit und subjektorientierte Didaktik. (S. 1)- **Bewertungsmethoden:** indirekt, da Lernaufgaben/Produkte/Schritte als Struktur zur Leistungs-/Kompetenzsichtbarkeit dienen (ohne Messinstrumente). (S. 6–12)- **Forschungsansätze:** Konzept-/Praxisbeitrag (Tooldarstellung, keine ausgewiesene Studie). (S. 1)- **Systemanpassung:** Übertragung von Prozessorientierung (Industrie/Wirtschaft) in den Rettungsdienst und Ausbildungskontext. (S. 3–4) **8. Kategorisierung** **Kerngedanke:** Kompetenzorientierung wird als didaktische Übersetzungsleistung über Lernaufgaben operationalisiert; das Planungstool fungiert als Transmissionsriemen zwischen Arbeitsprozesslogik und Lernprozessgestaltung. (S. 1) **9. Zuordnung zu der passendsten Forschungsunterfrage** - **FU4a (indirekt):** bildungswissenschaftliche Mechanismen (Kompetenzorientierung, Selbsterschließung, Aufgabenstruktur) im Rettungsdienst-Ausbildungskontext; Bezug zu LMS muss zusätzlich hergestellt werden. **10. Relevanzbewertung** **3** **11. Schlussfolgerung** Für die Dissertation gut nutzbar als berufspädagogische Referenz zur Prozess-/Aufgabenlogik und zur Warnung vor pauschaler Selbststeuerungsrhetorik. Nicht primär eine Digital-/LMS-Quelle, aber hilfreich für didaktische Orchestrierungsargumente (Prozesskohärenz, Übergänge, Produkte).{\textless}/pre{\textgreater}{\textless}/div{\textgreater}},
	file = {Müller et al. - 2020 - Arbeitsprozessorientierung in der Berufsausbildung.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/TNYHFYQD/Müller et al. - 2020 - Arbeitsprozessorientierung in der Berufsausbildung.pdf:application/pdf},
}

