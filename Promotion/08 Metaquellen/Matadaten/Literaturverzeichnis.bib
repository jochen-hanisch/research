	keywords = {Promotion:Literaturanalyse, Education, \#4:Konferenz-Paper:MOOC, Computer aided instruction, Electronic learning, Analytical models, competency graphs, Databases, MOOC development, MOOC life cycle model, MOOC reusability, Online services, Promotion:S:04 MOOC, Promotion:Literaturverzeichnis},
	pages = {1--6},
	file = {IEEE Xplore Abstract Record:/Users/jochenhanisch-johannsen/Zotero/storage/45TM6L83/10305944.html:text/html},
