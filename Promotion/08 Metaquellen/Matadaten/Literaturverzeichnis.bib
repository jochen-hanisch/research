@article{gennat_e-sport_2025,
	title = {E-{Sport} im {Sportverein} – {Potenziale} für die außersportliche {Jugendarbeit}? {Eine} (medien-)pädagogische {Perspektive}},
	issn = {2730-7212, 2730-7220},
	shorttitle = {E-{Sport} im {Sportverein} – {Potenziale} für die außersportliche {Jugendarbeit}?},
	url = {https://link.springer.com/10.1007/s43594-025-00174-2},
	doi = {10.1007/s43594-025-00174-2},
	abstract = {Zusammenfassung
            Der vorliegende Beitrag beleuchtet das sozio-kulturelle Phänomen E‑Sport als Angebot der außersportlichen Jugendarbeit im Setting von Sportvereinen. Ausgehend von dem Selbstverständnis der Sportjugend Nordrhein-Westfalen, ein breites Sport- und Spielverständnis zu vertreten und aktuelle Themen der Jugendarbeit zu adressieren, wurde von 2020 bis 2024 das vom Ministerium für Kinder, Jugend, Familie, Gleichstellung, Flucht und Integration des Landes Nordrhein-Westfalen geförderte Projekt „Förderung von E‑Sport als Angebot der außersportlichen Jugendarbeit im Sportverein“ durchgeführt und wissenschaftlich begleitet. Im Fokus des wissenschaftlichen Erkenntnisinteresses standen dabei besonders beobachtbare Effekte der Sozialisation, der Emotionsarbeit und der Arbeit an der eigenen Identität von teilnehmenden Personen. Durch qualitative Methoden wurden die subjektiven Sichtweisen und Bedeutungszuschreibungen sowie soziale Dynamiken innerhalb der Gruppen erhoben. Die Ergebnisse zeigen, dass E‑Sport im Sportverein das Potenzial hat, (junge) Menschen in ihrer zunehmend digitalisierten Lebenswelt authentisch anzusprechen und ihnen einen Ort bereitzustellen, den sie selbstbestimmt mitgestalten und -verantworten können.
          , 
            Abstract
            
              This article examines the socio-cultural phenomenon of e‑sport as an extracurricular youth work offering within the setting of sports clubs. Based on the self-conception of the Sportjugend Nordrhein-Westfalen (North Rhine-Westphalia)—committed to promoting a broad understanding of sport and play while addressing current issues in youth work—the project
              “Promoting E‑Sport as an Extracurricular Youth Work Offering in Sports Clubs”
              , funded by the Ministerium für Kinder, Jugend, Familie, Gleichstellung, Flucht und Integration des Landes Nordrhein-Westfalen (Ministry for children, youth, family, equality, refugees and integration in North Rhine-Westphalia) from 2020 to 2024, was implemented and accompanied by scientific research. The research primarily focused on observable effects related to socialization, emotional experiences, and identity development among participants. Using qualitative methods, the study explored subjective perspectives, personal meaning-making, and group dynamics. The findings indicate that e‑sport in sports clubs has the potential to engage (young) people authentically within their increasingly digitalized lifeworlds, offering them a space they can co-create and take shared responsibility for.},
	language = {de},
	urldate = {2025-10-07},
	journal = {Forum Kinder- und Jugendsport},
	author = {Gennat, Markus and Ehlers, Jan P. and Wortmann, Jens and Tappe, Eik-Henning},
	month = oct,
	year = {2025},
	keywords = {Promotion:Literaturanalyse, \#7:Zeitschriftenartikel:digital:Medien, Promotion:S:07 Digitale Medien, Promotion:Literaturverzeichnis},
	file = {PDF:/Users/jochenhanisch-johannsen/Zotero/storage/SDJEQ624/Gennat et al. - 2025 - E-Sport im Sportverein – Potenziale für die außersportliche Jugendarbeit Eine (medien-)pädagogische.pdf:application/pdf},
}

@article{franziska_digitale_nodate,
	title = {Digitale {Fitness} von {Schulen} aus {Sicht} der {Lehrkräfte}},
	abstract = {Die fortschreitende Digitalisierung stellt Schulen vor die Herausforderung nicht nur technische Voraussetzungen, sondern pädagogische und organisationale Strukturen zu schaffen, von denen Lehrkräfte und Lernende profitieren. Vor diesem Hintergrund rückt das Konzept der digitalen Fitness in den Fokus. Ziel der vorliegenden Diplomarbeit ist es, aus Sicht der Lehrkräfte zu bestimmen, welche Faktoren eine Schule als digital fit kennzeichnen.},
