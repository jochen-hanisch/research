@article{rajagopalan_agile_2024,
	title = {An {Agile} {Approach} to {Student} {Consulting} {Projects}: {Iteration} and {Communication} to {Improve} {Decision} {Making}, {Presentations}, and {Teamwork}},
	issn = {1532-0545, 1532-0545},
	shorttitle = {An {Agile} {Approach} to {Student} {Consulting} {Projects}},
	url = {https://pubsonline.informs.org/doi/10.1287/ited.2023.0057},
	doi = {10.1287/ited.2023.0057},
	abstract = {Embedding consulting projects into the curriculum presents an effective means of providing students with experiential applied learning opportunities. However, creating, planning, and managing such projects can be challenging. This paper introduces a unique approach to managing consulting projects: Agile Project Management with Scrum. By incorporating a commitment to iteration and communication as the core of the project experience, Agile with Scrum fosters an impactful, realistic, and engaging student consulting experience. This approach enhances decision making, presentations, and team dynamics. This article discusses how one supply chain management course embedded Agile with Scrum into a client consulting project to convert a mediocre experiential learning opportunity into a transformative one. After describing Agile with Scrum and explaining its potential in the classroom, this paper discusses the consulting project before and after Agile; the results; the lessons learned; and the value created for students, clients, and faculty.},
	language = {en-GB},
	urldate = {2024-12-18},
	journal = {INFORMS Transactions on Education},
	author = {Rajagopalan, Hari K. and Woodside, Sarah and Belanger, Kay Lawrimore},
	month = dec,
	year = {2024},
	keywords = {BZPG, Promotion:Literaturanalyse, Kollaboratives Lernen, Lehr- und Lerneffektivität, Systemanpassung, Promotion:Relevanz:4, Promotion:Weiterführung, Promotion:FU5, Agilität, Promotion:S:11 Online Learning, Promotion:S:10 Online Lernen, Promotion:S:01 Learning Management System, Promotion:Literaturverzeichnis},
	pages = {ited.2023.0057},
	file = {Rajagopalan et al. - 2024 - An Agile Approach to Student Consulting Projects Iteration and Communication to Improve Decision Ma:/Users/jochenhanisch-johannsen/Zotero/storage/2YPCKA2A/Rajagopalan et al. - 2024 - An Agile Approach to Student Consulting Projects Iteration and Communication to Improve Decision Ma.pdf:application/pdf},
}

@article{krummenacher_mediendidaktische_2024,
	title = {Mediendidaktische {Prinzipien} in der {Praxis}: {Entwicklung} und {Implementierung} der {Lernplattform} {FoResT} zur {Resilienzförderung} bei {Studierenden} der {Lehrer}:innenbildung},
	copyright = {https://creativecommons.org/licenses/by/4.0},
	issn = {1424-3636},
	shorttitle = {Mediendidaktische {Prinzipien} in der {Praxis}},
	url = {https://www.medienpaed.com/article/view/1960},
	doi = {10.21240/mpaed/00/2024.12.09.X},
	abstract = {To navigate the dynamic modern education system, teachers need not only subjectspecific competencies but also cross-disciplinary skills, including important socioemotional abilities such as resilience. Resilience can be understood as a crucial capability for adaptability in the teaching profession. Resilient teachers are better able to overcome adverse situations and adapt to changes. They are also less likely to leave the profession. Although the importance of teacher resilience is widely recognized, there is little knowledge about effective strategies to promote this ability. Digital learning environments designed according to media pedagogical and media didactic principles offer promising approaches here, as they create flexible, personalized, and interactive learning opportunities that allow teachers to test and reflect on resilience strategies in a protected space. The project «Fostering Resilience in Teacher Education (FoResT)», a collaboration between the University of Bern and the Bern University of Teacher Education, addresses this research gap by developing a media-didactically designed online learning platform for teaching resilience strategies.},
	language = {de-DE},
	urldate = {2024-12-14},
	journal = {MedienPädagogik: Zeitschrift für Theorie und Praxis der Medienbildung},
	author = {Krummenacher, Isabelle and Guidon, Irene and Hascher, Tina},
	month = dec,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Systemanpassung, Promotion:Weiterführung, Lernsystemarchitektur, Promotion:FU3, \#2:Zeitschriftenartikel:online:Lernplattform, Promotion:S:02 Online-Lernplattform, Promotion:Literaturverzeichnis},
	pages = {440--472},
	annote = {Analyse des Artikels "Mediendidaktische Prinzipien in der Praxis: Entwicklung und Implementierung der Lernplattform FoResT zur Resilienzförderung bei Studierenden der Lehrer:innenbildung" von Krummenacher et al. (2024)

1. Hauptthemen und Ziele der Forschung
Der Artikel beschreibt die Entwicklung und Implementierung der Lernplattform FoResT zur Resilienzförderung angehender Lehrpersonen. Ziel ist es, durch mediendidaktische Prinzipien digitale Lernumgebungen zu schaffen, die sozial-emotionale Kompetenzen wie Resilienz fördern. Im Rahmen eines designbasierten Forschungsansatzes wird die Plattform iterativ entwickelt und evaluiert.

2. Methoden und Datenquellen


Design-Based Research Ansatz:Iterativer Prozess in drei Phasen:


Konzeptionsphase: Grundlegendes Design und inhaltliche Ausrichtung.


Anpassungsphase: Verfeinerung auf Basis formativer Evaluation.


Implementierungsphase: Summative Evaluation und Integration an der Pädagogischen Hochschule Bern.




Datenquellen:


Mixed-Methods-Ansatz: Kombination aus quantitativen Fragebogendaten und qualitativen Interviews mit 136 Studierenden und 15 Lehrpersonen.


Rückmeldungen zu Inhaltsgestaltung, Usability und Lernerfahrungen.




Evaluationskriterien:


Mediendidaktische Prinzipien (Kerres 2024, Mayer 2024).


Dimensionen wie Interaktivität, Praxisrelevanz und Reflexionsmöglichkeiten.





3. Zentrale Forschungsergebnisse


Resilienzförderung durch mediendidaktische Prinzipien:


Die Plattform fördert Resilienz durch praxisnahe Fallbeispiele, Reflexionsaufgaben und multimediale Inhalte.


Module wie "Resilienz verstehen" und "Emotionen wahrnehmen" stärken spezifische Kompetenzen.




Iterative Verbesserung:


Anpassungen der Inhalte und der Benutzeroberfläche basieren auf Nutzerfeedback, um kognitive Belastung zu minimieren und Interaktivität zu steigern.




Erfolgreiche Implementierung:


Studierende bewerten die Plattform positiv hinsichtlich Design (M = 4,02) und Inhalte (M = 3,50).


Verbesserungsbedarf: Reduktion der Modullänge, stärkere Individualisierung und Einbindung in Seminare.





Zusammenfassung
Der Artikel zeigt, wie digitale Lernplattformen mithilfe mediendidaktischer Prinzipien zur Förderung sozial-emotionaler Kompetenzen wie Resilienz beitragen können. Die iterative Entwicklung der FoResT-Plattform kombiniert theoretische Grundlagen mit praxisnaher Umsetzung und adressiert die spezifischen Bedürfnisse angehender Lehrpersonen.

Kernaussagen


Mediendidaktische Gestaltung:


Praxisnahe und interaktive Elemente fördern Resilienz und Reflexion. (S. 445)




Iterative Entwicklung:


Kontinuierliche Anpassungen basieren auf Nutzerrückmeldungen und fördern die Akzeptanz. (S. 447)




Potenzial digitaler Plattformen:


Kombination aus Multimedialität, Reflexion und praxisrelevanten Inhalten steigert die Lernerfahrung. (S. 453)





Argumentationslinien


Verknüpfung von Theorie und Praxis:


Die Autoren argumentieren, dass mediendidaktische Prinzipien eine Brücke zwischen theoretischen Konzepten und praktischer Resilienzförderung schaffen. (S. 454)




Wichtigkeit der Resilienzförderung:


Resilienz wird als zentrale Kompetenz für den Lehrberuf hervorgehoben, um langfristige Berufszufriedenheit und Erfolg zu sichern. (S. 446)




Bedeutung der digitalen Transformation:


Die Plattform zeigt, wie digitale Technologien effektiv in die Lehrer:innenbildung integriert werden können. (S. 448)





Verschlagwortung


Lernsystemarchitektur:


Begründung: Der Artikel beschreibt detailliert die mediendidaktische Struktur und den iterativen Entwicklungsprozess der Plattform.




Lehr- und Lerneffektivität:


Begründung: Untersuchung, wie digitale Lernplattformen die Entwicklung von Resilienzkompetenzen fördern.




Systemanpassung:


Begründung: Anpassungen der Plattform an die spezifischen Bedürfnisse von Lehramtsstudierenden und deren Kontext.





Kategorisierung
Kategorie: WeiterführungBegründung: Die iterative Verbesserung der Plattform bietet Ansatzpunkte zur Weiterentwicklung mediendidaktischer Prinzipien und ihrer Implementierung in digitale Bildungssysteme.

Zuordnung zur Forschungsunterfrage
Passendste Forschungsunterfrage:FU3:„Wie sind Konzeption und relevante didaktische und bildungstechnologische Merkmale des systemisch-konstruktivistischen Learning-Management-Systems für Akteure im digitalen Bildungsraum dargestellt?“
Begründung:Die detaillierte Beschreibung der mediendidaktischen Prinzipien und der technischen Implementierung steht im Zentrum der Arbeit und unterstützt die Beantwortung von FU3.

Relevanzbewertung


Relevanz: 5Der Artikel liefert fundierte und praxisnahe Erkenntnisse zur mediendidaktischen Gestaltung und deren Bedeutung für digitale Lernsysteme.


},
	file = {Krummenacher et al. - 2024 - Mediendidaktische Prinzipien in der Praxis Entwicklung und Implementierung der Lernplattform FoResT:/Users/jochenhanisch-johannsen/Zotero/storage/F47DK6AW/Krummenacher et al. - 2024 - Mediendidaktische Prinzipien in der Praxis Entwicklung und Implementierung der Lernplattform FoResT.pdf:application/pdf},
}

@article{engels_e-learning_2024,
	title = {E-{Learning} mit {KI}-{Chatbot}: {Arbeits}- und sozialrechtliche {Integration} für {EU}-{Zugewanderte} in den sozialen {Medien}},
	language = {de-DE},
	author = {Engels, Sylvia},
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Datenschutz und IT-Sicherheit, Lernsystemarchitektur, Promotion:FU3, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	annote = {Analyse des Artikels „E-Learning mit KI-Chatbot: Arbeits- und sozialrechtliche Integration für EU-Zugewanderte in den sozialen Medien“
1. Hauptthemen und Ziele der Forschung
Die Studie von Engels et al. analysiert die Möglichkeiten und Herausforderungen des Einsatzes von KI-gestützten Chatbots im E-Learning, insbesondere in sozialen Medien, zur Unterstützung der Integration von EU-Zugewanderten in Deutschland. Dabei werden rechtliche, technische und didaktische Aspekte behandelt, um geeignete Anwendungsszenarien zu entwickeln.
2. Methoden und Datenquellen


Methoden: Systematische Analyse bestehender Social-Media-Nutzungsmuster der Zielgruppe und technischer Anforderungen an KI-Chatbots. Interdisziplinäres Arbeiten mit fünf themenspezifischen Teams.


Datenquellen: Evaluation von Projekten wie „CADS – Community Advisors“, statistische Daten zur Migration und Integration, rechtliche Grundlagen und existierende Anwendungen.


3. Zentrale Forschungsergebnisse


Social Media als Lernplattform: Facebook wird als primäre Plattform für die Zielgruppe identifiziert.


Heterogene Bedarfe: Es bestehen unterschiedliche Sprach- und Bildungshintergründe, die angepasste Lernangebote erfordern.


Potenziale von Chatbots: Personalisierte Lernpfade und Micro-Learning-Elemente fördern den Lernerfolg.


Herausforderungen: Datenschutz und rechtliche Unsicherheiten müssen adressiert werden.


4. Zusammenfassung
Die Arbeit hebt hervor, dass KI-Chatbots in sozialen Medien eine vielversprechende Methode darstellen, um EU-Zugewanderte in ihrer Integration durch E-Learning zu unterstützen. Herausforderungen bestehen in der technischen und rechtlichen Umsetzung, insbesondere in Bezug auf Datenschutz und Anpassungsfähigkeit.
5. Kernaussagen


Chatbots als Unterstützungsinstrument: KI-Chatbots können personalisierte Lerninhalte generieren und so die Integration fördern (S. 109–111).


Datenschutz als kritisches Element: Die Einhaltung der DSGVO ist essenziell für den Erfolg solcher Systeme (S. 98–101).


Heterogene Zielgruppen: Angepasste Ansätze für unterschiedliche Sprach- und Bildungsbedarfe sind notwendig (S. 33–34).


6. Argumentationslinien
Die Argumentation basiert auf der Bedeutung von Social Media für die Integration. Chatbots werden als Erweiterung bestehender Angebote präsentiert, wobei rechtliche und technische Rahmenbedingungen als entscheidende Faktoren diskutiert werden (S. 44–52).
7. Verschlagwortung


Technologieintegration: Einsatz von KI-Chatbots für personalisierte Bildungsangebote.


Datenschutz und IT-Sicherheit: Analyse der DSGVO-konformen Gestaltung von E-Learning-Systemen.


Lernsystemarchitektur: Integration von KI-Tools in Social-Media-Plattformen.


Forschungsansätze: Interdisziplinärer Ansatz zur Entwicklung von Anwendungsszenarien.


8. Kategorisierung
Kerngedanke: Die Studie untersucht den Einsatz von KI-gestützten Chatbots, um E-Learning-Angebote in sozialen Medien für EU-Zugewanderte zu personalisieren und zu erweitern (S. 33–34).
9. Zuordnung zu Forschungsunterfragen (FU)


FU3: Wie sind Konzeption und relevante didaktische und bildungstechnologische Merkmale des systemisch-konstruktivistischen LMS für Akteure im digitalen Bildungsraum dargestellt?


Begründung: Die Arbeit beschreibt umfassend die technischen und didaktischen Grundlagen zur Konzeption und Nutzung von KI-gestützten E-Learning-Tools.




FU4b: Welche technisch-gestalterischen Mechanismen werden bei Anwendung eines LMS im Bezug zur Wirkung auf Akteure beschrieben?


Begründung: Schwerpunkt liegt auf der technischen Realisierbarkeit und Integration der Chatbot-Lösung.




10. Relevanzbewertung


Relevanz: 5 (Die Arbeit ist direkt relevant für die Forschungsfragen zu LMS und KI-Integration im Bildungsbereich.)


Gesamtbewertung: 5 (Umfassende Darstellung, hohe Aktualität und Praxisrelevanz.)


Schlussfolgerung: Engels et al. verdeutlichen die Potenziale und Herausforderungen beim Einsatz von KI-Chatbots in sozialen Medien für E-Learning und Integration. Die Erkenntnisse bieten wertvolle Einblicke für die Gestaltung digitaler Bildungsangebote.
