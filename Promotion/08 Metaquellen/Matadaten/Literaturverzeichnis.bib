@incollection{ebner_vom_2013,
	edition = {Überarbeitete 2. Aufl.},
	title = {Vom {Online}-{Skriptum} zum {E}-{Book} - {Lehr}- und {Lernunterlagen} als elektronische {Bücher}},
	copyright = {CC BY-SA},
	shorttitle = {Vom {Online}-{Skriptum} zum {E}-{Book}},
	url = {https://l3t.tugraz.at/index.php/LehrbuchEbner10/article/view/123},
	language = {de-DE},
	urldate = {2025-10-04},
