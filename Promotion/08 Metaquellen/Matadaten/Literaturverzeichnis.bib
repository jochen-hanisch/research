@article{seeber2024Dba,
  title = {Digitalisierung in der beruflichen Ausbildung: Implikationen für Lehr-Lern- und Diagnostikprozesse},
  author = {Seeber, Susan and Ziegler, Birgit and Weyland, Ulrike},
  date = {2024},
  journaltitle = {Zeitschrift für Pädagogik},
  abstract = {Der Artikel von Seeber, Ziegler und Weyland (2024) untersucht die Implikationen der Digitalisierung für Lehr-Lern- und Diagnostikprozesse in der beruflichen Ausbildung. Hier sind die wichtigsten Punkte zusammengefasst: Veränderungen im Beschäftigungssystem: Durch Digitalisierung ausgelöste Dynamiken führen zu neuen Produkten, Technologien und veränderten Arbeitsprozessen, was wiederum grundsätzliche Veränderungen bei Berufszuschnitten und Kompetenzanforderungen nach sich zieht. Anpassung beruflicher Curricula: In Reaktion auf diese Dynamiken wurden viele Berufsbilder und Curricula überarbeitet, was eine Neuausrichtung der Kompetenzziele erfordert. Wachsende Bedeutung digitaler und berufsübergreifender Kompetenzen: Neben spezifischen beruflichen Fähigkeiten werden allgemeine digitale Kompetenzen und überfachliche Fähigkeiten wie Abstraktionsvermögen, Problemlösekompetenz und kommunikative Fähigkeiten immer wichtiger. Auswirkungen der Digitalisierung auf verschiedene Berufsfelder: Die Autoren unterteilen die Berufsfelder in kaufmännisch-administrative, gegenstandsbezogene und personenbezogene Dienstleistungen, wobei die Digitalisierung je nach Bereich unterschiedliche Auswirkungen hat, von der Flexibilisierung von Geschäftsprozessen bis hin zur Standardisierung von Arbeitsabläufen in personenbezogenen Dienstleistungen. Technologieeinsatz in der Ausbildung: Der Artikel hebt die Notwendigkeit hervor, digitale Medien und Technologien zur Förderung der Ausbildungsqualität zu nutzen, etwa durch simulationsgestütztes Lernen, das die Kompetenzentwicklung unterstützt. Differenzielle Effekte der Digitalisierung: Während in einigen Berufen die Digitalisierung eine komplexere Aufgabenstruktur fördert, könnte sie in anderen Bereichen zu einer Vereinfachung der Tätigkeiten führen. Die Autoren betonen die Notwendigkeit, Ausbildungskonzepte zu entwickeln, die sowohl kurzfristige Qualifikationsbedürfnisse als auch langfristige Bildungsziele berücksichtigen. Diese Zusammenfassung basiert auf der detaillierten Analyse der Veränderungen in beruflichen Ausbildungssystemen und betont die Notwendigkeit einer fortlaufenden Anpassung an die digitalen Transformationsprozesse in der Arbeitswelt. Referenz: Seeber, S., Ziegler, B., \& Weyland, U. (2024). Digitalisierung in der beruflichen Ausbildung: Implikationen für Lehr-Lern- und Diagnostikprozesse. Zeitschrift für Pädagogik, 70(2), 129-141.},
  langid = {ngerman},
  keywords = {6:Zeitschriftenartikel:Bildung:Technologie,9:Zeitschriftenartikel:digital:lernen,Bewertungsmethoden,Charité:Promotion,Forschungsansätze,Kompetenz,Lehr- und Lerneffektivität,Promotion:Argumentation,Promotion:Literaturanalyse,Systemanpassung,Technologieintegration},
  file = {/Users/jochen_hanisch-johannsen/Zotero/storage/RI29I94J/Seeber et al. - 2024 - Digitalisierung in der beruflichen Ausbildung Imp.pdf}
}

