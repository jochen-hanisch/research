@article{huber_covid-19_2020,
	title = {{COVID}-19: {Fernunterricht} aus {Sicht} der {Mitarbeitenden} von {Schulen} in {Deutschland}, Österreich und der {Schweiz}},
	volume = {Vol. 2 No. 6},
	copyright = {Creative Commons Attribution Share Alike 4.0 International},
	shorttitle = {{COVID}-19},
	url = {https://www.pflb-journal.de/index.php/pflb/article/view/3967},
	doi = {10/ghzqbv},
	abstract = {Im Zuge der Corona-Pandemie wurden weltweit temporären Schulschließungen vorgenommen. Wie funktioniert(e) Bildung in dieser Kri­se? Daten des Schul-Barometers von insgesamt 5.167 Mitarbeitenden an Schulen aus Deutschland, Österreich und der Schweiz ermöglichen einen Einblick in die Rahmenbedingungen von Digitalisierung während des Lehrens und Lernens während der Schulschließung. Die Daten bestätigen den „digital divide“ in den Kompetenzen und Erfahrungen der Lehrkräfte. Lehrkräfte in Österreich und der Schweiz schätzen ihre digitalen Kompetenzen höher ein als deutsche Mitarbeitende. Die technische Ausstattung wird von Befragten aus Österreich und der Schweiz ebenfalls besser eingeschätzt als in Deutschland. Die Kooperation zwischen Mitarbeitenden der Schule selbst sowie mit Eltern und ein stärkerer Fokus auf die Beziehungsebene zu Schüler*innen wird in Zeiten der Krise trotz und wegen der Distanz noch bedeutsamer für Lehre und Lernen. Perspektivisch können aus den Daten des Schul-Barometers Empfehlungen für die „Schule von morgen“ abgeleitet werden.},
	language = {de-DE},
	urldate = {2021-02-06},
	journal = {Praxis Forschung Lehrer*innen Bildung. Zeitschrift für Schul- und Professionsentwicklung.},
	publisher = {PraxisForschungLehrer*innenBildung. Zeitschrift für Schul- und Professionsentwicklung.},
	author = {Huber, Stephan Gerhard and Helm, Christoph and Günther, Paula S. and Schneider, Nadine and Schwander, Marius and Pruitt, Jane and Schneider, Julia Alexandra},
	month = dec,
	year = {2020},
	note = {Artwork Size: 27-44},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Bildungstheorien, Promotion:Argumentation, Krisenreaktion im Bildungsbereich, Promotion:04-03:3.2, \#9:Zeitschriftenartikel:digital:lernen, Promotion:FU1, Promotion:3.2 Entwicklung des Forschungsgegenstandes, Promotion:S:09 Digital Lernen, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Dissertation {\textbar} FU1 {\textgreater} Argumentation, Promotion:Literaturverzeichnis, Promotion:sec:Weiterentwicklung-extern, Promotion:chap:04-03},
	pages = {27--44},
	annote = {Analyse des Artikels „COVID-19: Fernunterricht aus Sicht der Mitarbeitenden von Schulen in Deutschland, Österreich und der Schweiz“ von Huber et al. (2020)

1. Analyse
Hauptthemen und Ziele der Forschung


Thema: Untersuchung der Herausforderungen und Erfahrungen von schulischen Mitarbeitenden während der COVID-19-Pandemie, mit einem Fokus auf digitale Lehr-Lern-Formen.


Ziel: Bewertung der digitalen Kompetenz, der technischen Ausstattung sowie der Kooperation und Unterstützung in Schulen während der Schulschließungen.


Verwendete Methoden und Datenquellen


Methodik:


Online-Umfrage (Schul-Barometer) mit quantitativen und qualitativen Items.


Analyse von Daten aus drei deutschsprachigen Ländern (Deutschland, Österreich, Schweiz) mit über 5.000 Befragten.




Datenquellen:


Lehrkräfte, Schulleitungen und andere schulische Mitarbeitende.


Geschlossene und offene Fragen zur Bewertung digitaler Lehr-Lern-Formen, technischer Ausstattung und Zusammenarbeit.




Zentrale Forschungsergebnisse


Digitale Kompetenz: Nur 41 \% der Befragten schätzen die digitale Kompetenz ihres Kollegiums als ausreichend ein. Österreichische und Schweizer Lehrkräfte bewerteten ihre Kompetenz höher als deutsche.


Technische Ausstattung: 37 \% der Mitarbeitenden hielten die technische Ausstattung ihrer Schulen für ausreichend, wobei auch hier Österreich und die Schweiz besser abschnitten.


Kooperation und Unterstützung: Gegenseitige Unterstützung wurde als wichtiger Faktor genannt, jedoch fehlten vielerorts einheitliche Konzepte und klare Kommunikationsstrukturen.



2. Zusammenfassung
Die Studie analysiert die Erfahrungen und Herausforderungen des Fernunterrichts während der COVID-19-Pandemie aus Sicht der schulischen Mitarbeitenden in Deutschland, Österreich und der Schweiz. Die Ergebnisse zeigen Defizite in digitaler Kompetenz und technischer Ausstattung, aber auch Potenziale in der kollegialen Zusammenarbeit und der Nutzung digitaler Medien.

3. Kernaussagen


Digitale Kompetenz und technische Ausstattung: Mängel in der technischen Infrastruktur und in den digitalen Fähigkeiten der Lehrkräfte stellten erhebliche Herausforderungen dar (S. 30–32).


Kooperation als Schlüssel: Kollegiale Unterstützung und Austausch waren entscheidend für die Bewältigung der Pandemie-bedingten Anforderungen (S. 33).


Regionale Unterschiede: Die Ergebnisse weisen auf signifikante Unterschiede zwischen den Ländern hin, mit Vorteilen für Österreich und die Schweiz (S. 34).



4. Argumentationslinien


Theorie: Bezug auf das Homework-Modell von Trautwein et al. (2006), das die Bedeutung von Kontextfaktoren für Lernergebnisse betont (S. 30).


Empirische Evidenz: Daten aus der Umfrage belegen Unterschiede in der Ausstattung und Kompetenz, die sich auf die Qualität des Fernunterrichts auswirken (S. 34–36).


Praktische Relevanz: Die Ergebnisse unterstreichen die Notwendigkeit systematischer Investitionen in digitale Infrastruktur und Lehrerbildung (S. 40).



5. Verschlagwortung


Technologieintegration: Untersuchung der Nutzung und Herausforderungen digitaler Lehr-Lern-Formen während der Pandemie.


Krisenreaktion im Bildungsbereich: Analyse der Reaktionen und Anpassungen des Schulsystems an die COVID-19-Pandemie.


Lehr- und Lerneffektivität: Bewertung der Wirksamkeit digitaler Lehrmethoden und der Zusammenarbeit im Kollegium.



6. Kategorisierung
Kategorie: Argumentation


Begründung: Die Studie liefert fundierte Erkenntnisse über die strukturellen und individuellen Herausforderungen sowie über notwendige Reformen zur Förderung digitaler Bildung (S. 40–42).



7. Zuordnung zu Forschungsfragen
Passendste Forschungsunterfrage: FU1: „Welche Akzeptanz und Nützlichkeit (Bedeutung) beschreiben Akteure im digitalen Bildungsraum von Gesundheitsberufen bei Anwendung eines Learning-Management-Systems?“


Begründung: Die Untersuchung zeigt auf, wie Lehrkräfte digitale Technologien bewerten und wie diese Akzeptanz die Effektivität von Fernunterricht beeinflusst (S. 30–32).



8. Relevanzbewertung


Direkte Relevanz: 5 (Hoch relevante Ergebnisse für die Entwicklung und Bewertung digitaler Bildungssysteme).


Aktualität: 4 (Veröffentlichung 2020, methodisch relevant, jedoch nicht hochaktuell).


Zitierhäufigkeit: 5 (Breite Sichtbarkeit und Relevanz in bildungspolitischen Debatten).


Gesamtbewertung: 5
},
	file = {huber_et_al_2020_covid-19.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/3A2QI7FW/huber_et_al_2020_covid-19.pdf:application/pdf},
}

@article{kostolanyova_adaptation_2011,
	title = {Adaptation of teaching process based on a students individual learning needs},
	volume = {4},
	issn = {1803-1617},
	url = {www.eriesjournal.com/_papers/article_130.pdf},
	abstract = {Development of current society requires integration of information technology to every sector, including education. The idea of adaptive teaching in e-learning environment is based on paying attention and giving support to various learning styles. More effective, user friendly thus better quality education can be achieved through such an environment (Schaik, 2002; Barker, 2009).},
	language = {en-US},
	number = {1},
	urldate = {2011-03-01},
	journal = {Journal on Efficiency and Responsibility in Education and Science},
	author = {Kostolányová, Kateřina and Šarmanová, Jana and Takács, Ondřej},
	month = mar,
	year = {2011},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:FU4a, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, Bewertungsmethoden, Systemanpassung, Bildungstheorien, Lernsystemarchitektur, \#5:Zeitschriftenartikel:e-learning, Promotion:S05, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU4a},
	pages = {3--17},
	annote = {Analyse der Studie „Adaptation of Teaching Process Based on a Student’s Individual Learning Needs“ von Kostolányová et al. (2011)

1. Analyse
Hauptthemen und Ziele der Forschung
Die Studie fokussiert sich auf die Entwicklung und Implementierung eines adaptiven E-Learning-Systems, das individuelle Lernstile und -bedürfnisse von Lernenden berücksichtigt. Ziel ist es, ein intelligentes Lernmanagementsystem (LMS) zu entwickeln, das auf Grundlage statischer und dynamischer Lernenden-Daten personalisierte Lernpfade gestaltet. Die Autorinnen sehen darin eine Möglichkeit, E-Learning effektiver und benutzerfreundlicher zu gestalten – insbesondere durch die Adaption an Persönlichkeit, Motivation und Lernstil der Nutzerinnen.
Verwendete Methoden und Datenquellen


Modulentwicklung: Das adaptive LMS besteht aus drei Hauptmodulen – Student, Autor und virtueller Tutor (vgl. Abbildung auf S. 6).


Datenerhebung:


Initiales Self-Assessment (statische Parameter)


Laufende Tests und Lernverhaltensanalyse (dynamische Parameter)




Lernstilanalyse: Kombination verschiedener etablierter Fragebögen (z. B. VARK, ILS, ASSIST) zur Typisierung.


Statistische Verfahren: Hauptkomponentenanalyse, Entscheidungsbäume, Clusteranalyse.


Zentrale Forschungsergebnisse


Theoretisches Modell: Ein strukturierter adaptiver Lernansatz mit sensorischen, motivationalen, sozialen und kognitiven Lernstilvarianten.


Implementiertes System: Die LMS-Variante Barborka 3 unterstützt die adaptiven Module und wird pilotiert.


Hauptkomponentenanalyse: Reduktion von 28 Lernstilmerkmalen auf 18 Hauptkomponenten.


Entscheidungsbaum-Ergebnisse: Multimodale Lernende zeigen hohe Überschneidungen mit auditiven und kinästhetischen Typen.


Clusteranalyse: Zeigt nur isolierte Punkte, keine signifikanten Cluster – Hinweis auf hohe individuelle Varianz.


Didaktische Aufbereitung: Inhalte (Frames) werden in sensorische und erklärungsbezogene Variationen sowie strukturierte Layer unterteilt (z. B. motivierend, theoretisch, praktisch).



2. Zusammenfassung
Die Studie beschreibt ein adaptives E-Learning-System, das individualisierte Lernpfade durch einen virtuellen Tutor bereitstellt. Basis ist ein theoretisches Modell, das Lernstil, Motivation und Vorwissen berücksichtigt. Die Lernmaterialien werden in modularen, sensorisch und didaktisch differenzierten Einheiten (Frames) bereitgestellt. Mithilfe eines adaptiven Algorithmus passt sich das System an die statischen und dynamischen Eigenschaften der Lernenden an. Erste empirische Auswertungen basierend auf Lernstil-Fragebögen und Datenanalysen legen nahe, dass die individualisierte Adaption didaktisch sinnvoll ist, wenn auch komplex. Die Implementierung erfolgt in einer erweiterten LMS-Version (Barborka 3), die zurzeit pilothaft getestet wird.

3. Kernaussagen (mit Seitenangabe)


„The most important characteristic is the student’s learning style.“ (S. 7)


„The adaptive education system has three basic modules: Student, Author and Virtual Teacher.“ (S. 6)


„Teaching supports must be structured […] to manipulate them based on the student’s needs.“ (S. 6)


„Students differ in sensory perception, learning strategies, and motivational states.“ (S. 7–8)


„Adaptive education system can recommend different learning paths based on static and dynamic learner data.“ (S. 5, S. 7)


„Educational content is divided into layers (e.g., motivational, theoretical, practical), which are reordered depending on the learner’s profile.“ (S. 10)



4. Argumentationslinien (mit Seitenangabe)


Ausgangspunkt: Klassischer Unterricht ignoriert individuelle Lernpräferenzen, was zu Ineffizienz führt (S. 4–5).


These: Ein adaptives System kann durch Berücksichtigung individueller Eigenschaften (Stil, Motivation, Vorwissen) personalisierte und effektivere Lernwege ermöglichen (S. 5–6).


Begründung: Unterschiedliche Lernstile lassen sich durch sensorische, soziale und kognitive Parameter differenzieren und empirisch messen (S. 7–9).


Umsetzung: Inhalte werden in modulierbare „Frames“ aufgeteilt, die in Layer strukturiert und je nach Bedarf neu kombiniert werden (S. 9–10).


Technische Implementierung: Algorithmische Regelwerke steuern die Zuordnung von Lerninhalten über den „virtuellen Tutor“ (S. 10–11).


Empirie: Erste Pilotanalysen zeigen, dass Lernende schwer in Cluster einteilbar sind, was für eine hohe Diversität spricht – und damit für die Notwendigkeit von Adaption (S. 12–13).



5. Verschlagwortung


Lernsystemarchitektur: Es wird ein konkretes LMS (Barborka 3) mit spezifischen Modulen (Autor, Student, Tutor) entwickelt.


Bildungstheorien: Die Lernstiltheorie (u. a. Kolb, Gardner, Felder) bildet die Grundlage des adaptiven Modells.


Lehr- und Lerneffektivität: Ziel ist es, durch individualisierte Lernpfade die Effektivität und Motivation zu erhöhen.


Bewertungsmethoden: Der Einsatz statistischer Verfahren (Hauptkomponentenanalyse, Clusteranalyse) dient der systematischen Bewertung von Lerncharakteristika.


Technologieintegration: Die Nutzung und Erweiterung eines bestehenden LMS (Barborka) belegt die praktische Umsetzbarkeit adaptiver Bildungstechnologien.


Systemanpassung: Die Lernpfade werden sowohl auf statische als auch dynamische Lernendenmerkmale angepasst (adaptive Routenführung).


Forschungsansätze: Nutzung empirischer Methoden (Fragebögen, Data Mining, Entscheidungsbäume) zur fundierten Individualisierung des Lernprozesses.



6. Kategorisierung
KerngedankeDie Studie entwickelt auf Grundlage bestehender Theorien und Lernstilmodelle ein komplexes System zur Individualisierung digitaler Bildungsprozesse. Es werden neue methodische, technische und didaktische Strategien zur Realisierung adaptiver Lernszenarien vorgeschlagen und erste Implementierungen pilotiert. Besonders die algorithmische Umsetzung und das Modellieren von Entscheidungsregeln deuten klar auf eine Erweiterung bisheriger Konzepte.

7. Zuordnung zu Forschungsfrage
Passendste Forschungsunterfrage: FU4a

Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?

Begründung: Die Studie operationalisiert bildungswissenschaftliche Theorien (u. a. Lernstile, Motivation, Selbstregulation) in ein datenbasiertes, personalisiertes Lernsystem und zeigt auf, wie diese Mechanismen zur individualisierten Unterstützung und Effektivitätssteigerung beitragen können.

8. Relevanzbewertung


Direkte Relevanz: 5


Beitrag zur Theorieentwicklung: 5


Praxisrelevanz durch Implementierung: 4


Aktualität: 3 (2011, aber methodisch weiterhin relevant)


Gesamtbewertung: 4


},
	file = {Kostolányová et al. - ADAPTATION OF TEACHING PROCESS BASED ON A STUDENTS INDIVIDUAL LEARNING NEEDS:/Users/jochenhanisch-johannsen/Zotero/storage/VD5M9CDD/Kostolányová et al. - ADAPTATION OF TEACHING PROCESS BASED ON A STUDENTS INDIVIDUAL LEARNING NEEDS.pdf:application/pdf},
}

@article{de_leeuw_9-step_2019,
	title = {A 9-{Step} {Theory}- and {Evidence}-{Based} {Postgraduate} {Medical} {Digital} {Education} {Development} {Model}: {Empirical} {Development} and {Validation}},
	volume = {5},
	url = {http://mededu.jmir.org/2019/2/e13004/},
	doi = {10.2196/13004},
	abstract = {Background: Digital education tools (e-learning, technology-enhanced learning) can be defined as any educational intervention that is electronically mediated. Decveloping and applying such tools and interventions for postgraduate medical professionals who work and learn after graduation can be called postgraduate medical digital education (PGMDE), which is increasingly being used and evaluated. However, evaluation has focused mainly on reaching the learning goals and little on the design. Design models for digital education (instructional design models) help educators create a digital education curriculum, but none have been aimed at PGMDE. Studies show the need for efficient, motivating, useful, and satisfactory digital education. Objective: Our objective was (1) to create an empirical instructional design model for PGMDE founded in evidence and theory, with postgraduate medical professionals who work and learn after graduation as the target audience, and (2) to compare our model with existing models used to evaluate and create PGMDE. Methods: Previously we performed an integrative literature review, focus group discussions, and a Delphi procedure to determine which building blocks for such a model would be relevant according to experts and users. This resulted in 37 relevant items. We then used those 37 items and arranged them into chronological steps. After we created the initial 9-step plan, we compared these steps with other models reported in the literature. Results: The final 9 steps were (1) describe who, why, what, (2) select educational strategies, (3) translate to the real world, (4) choose the technology, (5) complete the team, (6) plan the budget, (7) plan the timing and timeline, (8) implement the project, and (9) evaluate continuously. On comparing this 9-step model with other models, we found that no other was as complete, nor were any of the other models aimed at PGMDE. Conclusions: Our 9-step model is the first, to our knowledge, to be based on evidence and theory building blocks aimed at PGMDE. We have described a complete set of evidence-based steps, expanding a 3-domain model (motivate, learn, and apply) to an instructional design model that can help every educator in creating efficient, motivating, useful, and satisfactory PGMDE. Although certain steps are more robust and have a deeper theoretical background in current research (such as education), others (such as budget) have been barely touched upon and should be investigated more thoroughly in order that proper guidelines may also be provided for them.},
	number = {2},
	journal = {JMIR Med Educ},
	author = {de Leeuw, Robert and Scheele, Fedde and Walsh, Kieran and Westerman, Michiel},
	month = jul,
	year = {2019},
	keywords = {Promotion:Literaturanalyse, Forschungsansätze, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Technologieintegration, Bewertungsmethoden, Systemanpassung, Bildungstheorien, Promotion:Argumentation, Digitale Bildung, Lernsystemarchitektur, Promotion:FU3, distance education, \#5:Zeitschriftenartikel:e-learning, design model, education, distance, education, medical, instructional design, models, educational, Promotion:S:05 E-Learning, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU3},
	pages = {e13004},
	annote = {Analyse der Studie: „A 9-Step Theory- and Evidence-Based Postgraduate Medical Digital Education Development Model: Empirical Development and Validation“ (de Leeuw et al., 2019)

1. Analyse
Hauptthemen und Ziele der Forschung
Die Studie entwickelt und validiert ein evidenzbasiertes neunstufiges Modell zur Gestaltung digitaler Bildungsangebote speziell für die postgraduale medizinische Ausbildung (Postgraduate Medical Digital Education, PGMDE). Ziel ist es, ein systematisch aufgebautes, theoriegestütztes und praxistaugliches Instruktionsdesignmodell zu schaffen, das nicht nur Lernziele, sondern auch Faktoren wie Motivation, Nützlichkeit, Effizienz und Zufriedenheit berücksichtigt.
Methoden und Datenquellen
Die Entwicklung des Modells erfolgte in mehreren empirischen Schritten:


Integrative Literaturrecherche mit 11.093 Artikeln, davon 36 relevante Studien (2016)


Fokusgruppen mit Bildungsexpertinnen, Lernenden und Entwicklerinnen (2017)


Delphi-Studie mit internationalen Expert*innen zur Konsensbildung über Qualitätsindikatoren (2018)


Ableitung und Validierung des Modells durch Vergleich mit bestehenden Instruktionsdesignmodellen (z. B. ADDIE, Gagné, ASSURE, Kern etc.).


Zentrale Forschungsergebnisse
Das finale Modell umfasst 9 aufeinanderfolgende Schritte in drei Phasen:


Vorbereitung (Prepare): Zielgruppenanalyse, didaktische Strategie, Realitätsbezug


Organisation (Organize): Technologiewahl, Teamzusammenstellung, Budgetplanung


Umsetzung (Create): Zeitplanung, Implementierung, Evaluation


Dabei wurden 37 Qualitätsindikatoren berücksichtigt, die aus Theorie und Praxis empirisch abgeleitet wurden.

2. Zusammenfassung
Die Studie beschreibt die Entwicklung eines umfassenden Modells zur Gestaltung digitaler Lernangebote für Ärztinnen in der postgradualen Ausbildung. Auf Basis einer systematischen Literaturrecherche, Fokusgruppeninterviews und einer Delphi-Studie wurde ein neunstufiges Modell konzipiert, das sowohl klassische Instruktionsdesignaspekte (Ziele, Strategien, Technologie) als auch oft vernachlässigte Dimensionen wie Nutzerinnenmotivation, Adaptivität, Realitätsnähe und kontinuierliche Evaluation integriert. Im Vergleich zu etablierten Modellen (ADDIE, Gagné, ASSURE etc.) deckt dieses Modell mehr Dimensionen der digitalen Lehre ab und ist spezifisch auf den medizinischen Kontext zugeschnitten.

3. Kernaussagen (mit Seitenangabe)


„Digital education has to be effective, but also efficient, motivating, useful, and satisfactory.“ (S. 1)


„No existing model covers the full range of steps necessary for postgraduate medical digital education.“ (S. 7)


„Learning strategies must include feedback, interactivity, summaries, and assessments to enhance cognitive processing.“ (S. 8)


„Adaptive learning environments allow personalized paths and enhance engagement.“ (S. 8)


„Design decisions should reflect instructional and technological affordances.” (S. 6)


„Most models ignore key elements such as budgeting, implementation strategies, and team composition.” (S. 7)



4. Argumentationslinien (mit Seitenangabe)


Die Autor*innen beginnen mit der Kritik an bestehenden Evaluationsmodellen, die sich meist nur auf Zielerreichung fokussieren, nicht aber auf Designqualität (S. 1–2).


Daraufhin begründen sie die Notwendigkeit eines spezifischen, evidenzbasierten Modells für PGMDE, gestützt auf Theorien zu Erwachsenenbildung und digitalen Medien (S. 2).


Durch die systematische Ableitung von 37 Qualitätsindikatoren (S. 3–4) und deren logische Ordnung in 9 Schritte wird ein kohärenter Ablaufplan konstruiert (S. 5–6).


Der Vergleich mit anderen Modellen (z. B. ADDIE, Gagné) zeigt die Vollständigkeit und Spezifität des neuen Modells (S. 7).


Abschließend betonen die Autor*innen die Notwendigkeit weiterer Forschung, insbesondere zur Evaluation von Designqualität und Implementierungsstrategien (S. 8–9).



5. Verschlagwortung


Lernsystemarchitektur: Das Modell adressiert explizit die Struktur und den Aufbau von Lernumgebungen inkl. Technologie-, Team- und Budgetplanung (S. 4–6).


Bildungstheorien: Das Modell basiert auf Konzepten wie kognitiver Last, adaptivem Lernen, Feedbackprinzipien und Motivationstheorien (S. 2, 8).


Lehr- und Lerneffektivität: Die Integration von Interaktivität, Feedback und realitätsnaher Anwendbarkeit zielt direkt auf die Optimierung des Lernerfolgs (S. 6, 8).


Technologieintegration: Auswahl und Gestaltung technologischer Tools sind zentrales Element des Modells (S. 6).


Bewertungsmethoden: Schritt 9 fordert eine kontinuierliche Evaluation, kritisiert aber das Fehlen standardisierter Instrumente (S. 7–8).


Systemanpassung: Das Modell ist modular und adaptiv auf verschiedene Zielgruppen anwendbar, auch wenn ursprünglich für PGMDE konzipiert (S. 8).



6. Kategorisierung
