@article{gencer2023Mpn,
  title = {Mini {{Percutaneous Nephrolithotomy}} vs {{Standard Percutaneous Nephrolithotomy}}: {{A Perioperative Decision Support System}} for {{Surgical Success Comparison}}},
  shorttitle = {Mini {{Percutaneous Nephrolithotomy}} vs {{Standard Percutaneous Nephrolithotomy}}},
  author = {Gencer, Kerem},
  date = {2023},
  journaltitle = {Therapeutics and Clinical Risk Management},
  shortjournal = {Ther Clin Risk Manag},
  volume = {19},
  eprint = {38170095},
  eprinttype = {pubmed},
  pages = {1075--1086},
  issn = {1176-6336},
  doi = {10.2147/TCRM.S444519},
  abstract = {PURPOSE: This study aimed to rank the features that are important in terms of safety and effectiveness in choosing the surgical method and providing appropriate care to the patient by using the variables examined before and after the surgery to evaluate the success of mini percutaneous nephrolithotomy and standard percutaneous nephrolithotomy surgeries. PATIENTS AND METHODS: The features evaluated before and after surgery were ranked according to their importance in the features considered, using Multivariate Adaptive Regression Splines (MARS), LASSO, Ridge, Elastic\_net, and Random Forest algorithms as variable selection techniques. There are 278 samples in the relevant data set. RESULTS: Type of surgery (100\%), intercostal access (97.75\%), kidney opening procedure (94.25\%), postoperative creatinine (59.22\%), hydronephrosis (52.23\%), the number of entries (41.61\%), and pre- and post-operative hemoglobin difference (45.13\%) were determined as the most critical variables. The MARS algorithm showed the most successful performance, with the lowest mean absolute error (MAE) value of 0.3622, the lowest root mean square error (RMSE) value of 0.3960, and the highest R2 value of 0.3405. CONCLUSION: Clinical decision support systems can be helpful in eliminating errors and reducing costs. It can also improve the quality of healthcare and aid in the early diagnosis of diseases. Computer-aided decision-making systems can be developed using the results of such products. These systems can provide doctors with better information about their patient's treatment options and improve decision-making. It can contribute to patients being better informed about the surgery results and taking an active role. In conclusion, this study provides essential information that should be included in the surgical decision-making process for patients using medications and with a history of percutaneous nephrolithotomy.},
  langid = {english},
  pmcid = {PMC10759910},
  keywords = {Charité:Promotion,digital decision in healthcare,Forschungsansätze,Krisenreaktion im Bildungsbereich,Lehr- und Lerneffektivität,machine learning,MARS,percutaneous nephrolithotomy,Promotion:Argumentation,Promotion:Ausschluss,Promotion:Literaturanalyse,surgery success,Systemanpassung,Technologieintegration},
  file = {/Users/jochen_hanisch-johannsen/Zotero/storage/YLXEBTV2/Gencer - 2023 - Mini Percutaneous Nephrolithotomy vs Standard Perc.pdf}
}

@article{gennat2025Eis,
  title = {E-Sport im Sportverein – Potenziale für die außersportliche Jugendarbeit? Eine (medien-)pädagogische Perspektive},
  shorttitle = {E-Sport im Sportverein – Potenziale für die außersportliche Jugendarbeit?},
  author = {Gennat, Markus and Ehlers, Jan P. and Wortmann, Jens and Tappe, Eik-Henning},
  date = {2025-10-01},
  journaltitle = {Forum Kinder- und Jugendsport},
  shortjournal = {Forum Kind Jugend Sport},
  issn = {2730-7212, 2730-7220},
  doi = {10.1007/s43594-025-00174-2},
  url = {https://link.springer.com/10.1007/s43594-025-00174-2},
  urldate = {2025-10-07},
  abstract = {Zusammenfassung             Der vorliegende Beitrag beleuchtet das sozio-kulturelle Phänomen E‑Sport als Angebot der außersportlichen Jugendarbeit im Setting von Sportvereinen. Ausgehend von dem Selbstverständnis der Sportjugend Nordrhein-Westfalen, ein breites Sport- und Spielverständnis zu vertreten und aktuelle Themen der Jugendarbeit zu adressieren, wurde von 2020 bis 2024 das vom Ministerium für Kinder, Jugend, Familie, Gleichstellung, Flucht und Integration des Landes Nordrhein-Westfalen geförderte Projekt „Förderung von E‑Sport als Angebot der außersportlichen Jugendarbeit im Sportverein“ durchgeführt und wissenschaftlich begleitet. Im Fokus des wissenschaftlichen Erkenntnisinteresses standen dabei besonders beobachtbare Effekte der Sozialisation, der Emotionsarbeit und der Arbeit an der eigenen Identität von teilnehmenden Personen. Durch qualitative Methoden wurden die subjektiven Sichtweisen und Bedeutungszuschreibungen sowie soziale Dynamiken innerhalb der Gruppen erhoben. Die Ergebnisse zeigen, dass E‑Sport im Sportverein das Potenzial hat, (junge) Menschen in ihrer zunehmend digitalisierten Lebenswelt authentisch anzusprechen und ihnen einen Ort bereitzustellen, den sie selbstbestimmt mitgestalten und -verantworten können.           ,              Abstract                            This article examines the socio-cultural phenomenon of e‑sport as an extracurricular youth work offering within the setting of sports clubs. Based on the self-conception of the Sportjugend Nordrhein-Westfalen (North Rhine-Westphalia)—committed to promoting a~broad understanding of sport and play while addressing current issues in youth work—the project               “Promoting E‑Sport as an Extracurricular Youth Work Offering in Sports Clubs”               , funded by the Ministerium für Kinder, Jugend, Familie, Gleichstellung, Flucht und Integration des Landes Nordrhein-Westfalen (Ministry for children, youth, family, equality, refugees and integration in North Rhine-Westphalia) from 2020 to 2024, was implemented and accompanied by scientific research. The research primarily focused on observable effects related to socialization, emotional experiences, and identity development among participants. Using qualitative methods, the study explored subjective perspectives, personal meaning-making, and group dynamics. The findings indicate that e‑sport in sports clubs has the potential to engage (young) people authentically within their increasingly digitalized lifeworlds, offering them a~space they can co-create and take shared responsibility for.},
  langid = {ngerman},
  keywords = {7:Zeitschriftenartikel:digital:Medien,Charité:Promotion,Promotion:Literaturanalyse,Promotion:S:07 Digitale Medien},
  file = {/Users/jochen_hanisch-johannsen/Zotero/storage/SDJEQ624/Gennat et al. - 2025 - E-Sport im Sportverein – Potenziale für die außersportliche Jugendarbeit Eine (medien-)pädagogische.pdf}
}

