@article{uberall_curriculum_2023,
	title = {Curriculum {Algesiologische} {Fachassistenz} - jetzt online auf der {E}-{Learning}-{Plattform} der {DGS}},
	volume = {39},
	issn = {2194-2536, 2364-1010},
	url = {https://www.springermedizin.de/doi/10.1007/s00940-023-4171-8},
	doi = {10/gr9s7r},
	language = {de-DE},
	number = {3},
	urldate = {2023-05-27},
	journal = {Schmerzmedizin},
	author = {Überall, Michael A. and Horlemann, Johannes},
	month = may,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:Argumentation, Bildung, Multimedia, Krisenreaktion im Bildungsbereich, \#5:Zeitschriftenartikel:e-learning, Promotion:S:05 E-Learning, Promotion:Literaturverzeichnis},
	pages = {45--45},
	annote = {Analyse
Hauptthemen und -ziele der Forschung:
Die Arbeit von Überall und Horlemann (2023) behandelt die Einführung des Curriculums “Algesiologische Fachassistenz” in einem Online-Format. Ziel ist es, Fachkräfte im Bereich der Schmerzmedizin zu qualifizieren und deren Ausbildung flexibler und zugänglicher zu gestalten.
Verwendete Methoden und Datenquellen:
Der Bericht basiert auf einer detaillierten Beschreibung des Curriculums und seiner Implementierung in einem E-Learning-Format. Es werden die strukturellen und inhaltlichen Aspekte des Ausbildungsprogramms sowie die Vorteile der Online-Durchführung erörtert.
Zentrale Forschungsergebnisse:
Das Online-Format des Curriculums ermöglicht eine flexible und ortsunabhängige Weiterbildung. Die Ausbildung umfasst umfassende Kenntnisse über Schmerzbewältigung, interdisziplinäre Zusammenarbeit und den Einsatz spezifischer schmerztherapeutischer Verfahren. Die digitale Plattform bietet zahlreiche Vorteile hinsichtlich der Zugänglichkeit und Anpassungsfähigkeit der Weiterbildung.
Zusammenfassung
Das Curriculum “Algesiologische Fachassistenz” bietet eine flexible und umfassende Weiterbildungsmöglichkeit im Bereich der Schmerzmedizin. Durch die Online-Verfügbarkeit können Teilnehmer ihre Ausbildung selbstständig und im eigenen Tempo absolvieren, ohne Abstriche bei der Qualität hinnehmen zu müssen.
Kernaussagen
	•	“Die Behandlung von Menschen mit akuten oder chronischen Schmerzen erfordert nicht nur qualifizierte medizinische Spezialisten, sondern auch nicht ärztliche Experten.” (S. 45)
	•	“Mit dem seit 2022 im Online-Format verfügbaren DGS-Curriculum zur Algesiologischen Fachassistenz bietet die Deutsche Gesellschaft für Schmerzmedizin allen Interessierten einen neuen und an die aktuellen Herausforderungen der (schmerz-)medizinischen Fort- und Weiterbildung angepassten Zugang zu diesem Berufsbild.” (S. 45)
Argumentationslinien
	•	Die Studie argumentiert, dass die Digitalisierung der Weiterbildungsmöglichkeiten in der Schmerzmedizin den Zugang und die Qualität der Ausbildung verbessert.
	•	Es wird betont, dass die interdisziplinäre Zusammenarbeit und spezialisierte Weiterbildung von nicht ärztlichen Fachkräften entscheidend für die Qualität der schmerzmedizinischen Versorgung sind.
Verschlagwortung
	•	Lehr- und Lerneffektivität: Die Einführung des E-Learning-Curriculums zeigt, dass digitale Bildungsangebote effektiv zur Qualifizierung von Fachkräften beitragen können.
	•	Technologieintegration: Die erfolgreiche Umsetzung des Online-Formats verdeutlicht die Relevanz der Integration moderner Technologien in die medizinische Weiterbildung.
	•	Systemanpassung: Die Anpassung der Weiterbildung an digitale Formate zeigt die Flexibilität und Anpassungsfähigkeit des Bildungssystems im Gesundheitswesen.
	•	Krisenreaktion im Bildungsbereich: Die Einführung des Online-Curriculums während der COVID-19-Pandemie zeigt, wie Bildungseinrichtungen auf globale Gesundheitskrisen reagieren können.
Kategorie: Argumentation
Diese Studie liefert starke Argumente für die Vorteile der Digitalisierung und Flexibilisierung der Weiterbildung in der Schmerzmedizin. Sie zeigt, dass durch den Einsatz von E-Learning die Ausbildung von Fachkräften effektiver gestaltet und an aktuelle Herausforderungen angepasst werden kann.
},
	file = {A. Überall und Horlemann - 2023 - Curriculum Algesiologische Fachassistenz - jetzt o.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/RQQKMT58/A. Überall und Horlemann - 2023 - Curriculum Algesiologische Fachassistenz - jetzt o.pdf:application/pdf},
}

@inproceedings{setiawati_impact_2022,
	title = {Impact of {E}-{Learning} {Quality} on {Student} {Satisfaction} {During} {Covid}-19 and {Continuing} {Intentions} to {Use} {E}-{Learning} {Post} {Covid}-19},
	abstract = {The COVID-19 pandemic has forced all educational institutions to adopt online learning, regardless of how ready they are for transformation. This study aims to investigate student perceptions of e-learning quality, student satisfaction, and intention to continue using online education. It is also found that students in some areas are not ready to adapt from face-to-face offline education to e-learning platforms, examining how the quality of e-learning affects student satisfaction and usage intentions will provide useful findings for policy makers and educators to improve e-learning effectiveness. Utilizing quantitative methods, this study uses an online survey questionnaire to test the suggested research hypotheses and test the proposed model. To analyze and test the data, AMOS 20.0 was used using SEM (structural equation modeling). Based on the results of testing the impact of e-learning quality on student satisfaction and sustainable use intentions among higher education students, several conclusions can be drawn. Increasing student satisfaction by improving the quality of e-learning has resulted in greater efficiency and effectiveness of student online learning performance and outcomes. There is a strong significant relationship between knowledge sharing, communication facilities, motivation and use, and acceptance of e-learning between instructors.},
	language = {en-GB},
	author = {Setiawati, Anindya Prastiwi},
	year = {2022},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Bewertungsmethoden, Systemanpassung, Bildung, Multimedia, Promotion:FU6, \#5:Konferenz-Paper:e-learning, Promotion:S:05 E-Learning, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {422--436},
	annote = {Analyse des Artikels "Impact of E-Learning Quality on Student Satisfaction During COVID-19 and Continuing Intentions to Use E-Learning Post COVID-19" von Setiawati und Bhakti (2022)
1. Analyse
Hauptthemen und -ziele der Forschung: Der Artikel untersucht die Auswirkungen der Qualität von E-Learning auf die Zufriedenheit der Studierenden während der COVID-19-Pandemie und deren Absicht, E-Learning auch nach der Pandemie weiter zu nutzen. Ziel ist es, Erkenntnisse für politische Entscheidungsträger und Pädagogen zu gewinnen, um die Effektivität von E-Learning zu verbessern.
Verwendete Methoden und Datenquellen:


Methodische Ansätze: Quantitative Methoden, Online-Umfragefragebogen.


Werkzeuge und Datenquellen: AMOS 20.0 zur Datenanalyse unter Verwendung von SEM (Structural Equation Modeling). Der Fragebogen umfasst 25 Items zur Messung der E-Learning-Qualität, der Zufriedenheit der Studierenden und der kontinuierlichen Nutzung von E-Learning.


Zentrale Forschungsergebnisse:


Beziehung zwischen E-Learning-Qualität und Zufriedenheit: Es besteht eine starke positive Beziehung zwischen der Qualität des E-Learnings und der Zufriedenheit der Studierenden.


Einfluss auf die kontinuierliche Nutzung: Die Zufriedenheit der Studierenden wirkt sich positiv auf die nachhaltige Nutzung von E-Learning aus.


Bedeutung von Vertrauen: Vertrauen in elektronische Dienstleistungen (ETS) beeinflusst die kontinuierliche Nutzung von E-Learning positiv.


2. Zusammenfassung
Kernpunkte des Artikels:


Problemstellung: Untersuchung der Auswirkungen der E-Learning-Qualität auf die Zufriedenheit der Studierenden und deren nachhaltige Nutzung von E-Learning nach der COVID-19-Pandemie.


Methodik: Quantitative Analyse mittels Online-Umfrage und SEM.


Hauptergebnisse: Starke positive Beziehungen zwischen E-Learning-Qualität, Zufriedenheit der Studierenden und deren kontinuierlicher Nutzung von E-Learning.


Schlussfolgerungen: Verbesserung der E-Learning-Qualität steigert die Effizienz und Effektivität des Online-Lernens und beeinflusst die langfristige Nutzung positiv.


3. Kernaussagen


Einfluss der E-Learning-Qualität: „E-learning Quality (ELQ) has a positive and direct impact on the intention of continuous use (CUI).“ (S. 432)


Zufriedenheit der Studierenden: „Student satisfaction (SAT) will have a positive and direct impact on CUI.“ (S. 431)


Vertrauen in E-Learning: „Electronic services trust (ETS) has a positive and direct impact on CUI.“ (S. 432)


4. Argumentationslinien


Bedeutung der E-Learning-Qualität: Der Artikel argumentiert, dass eine hohe Qualität des E-Learnings entscheidend für die Zufriedenheit der Studierenden und deren kontinuierliche Nutzung ist.


Einfluss von Vertrauen: Es wird betont, dass Vertrauen in die E-Learning-Plattformen die nachhaltige Nutzung fördert.


Empfehlungen für Entscheidungsträger: Verbesserung der E-Learning-Qualität sollte im Fokus stehen, um die langfristige Akzeptanz und Effektivität zu gewährleisten.


5. Verschlagwortung


Lehr- und Lerneffektivität


Begründung: Der Artikel untersucht, wie die Qualität des E-Learnings die Effizienz und Effektivität des Lernens beeinflusst.


Fundstelle: S. 432




Bewertungsmethoden


Begründung: Die Zufriedenheit der Studierenden und die kontinuierliche Nutzung von E-Learning werden als Bewertungsmethoden herangezogen.


Fundstelle: S. 431




Systemanpassung


Begründung: Der Artikel betont die Notwendigkeit, E-Learning-Systeme an die Bedürfnisse der Studierenden anzupassen.


Fundstelle: S. 431




6. Kategorisierung


Kategorie: Argumentation


Kriterium: Nutzung von empirischen Daten zur Unterstützung der These, dass E-Learning-Qualität die Zufriedenheit und Nutzung nachhaltig beeinflusst.


Beispiel: Diskussion der positiven Beziehungen zwischen E-Learning-Qualität, Zufriedenheit und kontinuierlicher Nutzung.




7. Zuordnung zu Forschungsfragen


FU6: Wie wird ein systemisch-konstruktivistisches Learning-Management-System als Kompetenzerwerbssystem bei Akteuren im digitalen Bildungsraum von Gesundheitsberufen beurteilt?


Begründung: Der Artikel untersucht die Qualität von E-Learning-Systemen und deren Auswirkungen auf die Zufriedenheit und Nutzung der Studierenden.


Fundstelle: S. 432




Gesamtbewertung: 3/5
Diese Analyse zeigt die Relevanz des Artikels für die Untersuchung der Qualität von E-Learning und deren Auswirkungen auf die Zufriedenheit und kontinuierliche Nutzung durch die Studierenden.
},
	file = {Setiawati - 1945 - Impact of E-Learning Quality on Student Satisfacti.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/9SMFVVUP/Setiawati - 1945 - Impact of E-Learning Quality on Student Satisfacti.pdf:application/pdf},
}

@inproceedings{trudzinski_erste_2023,
	title = {Erste {Erfahrungen} zum {Einsatz} eines {E}-learning {Angebotes} zur {Verbesserung} der {Weaning}-{Kompetenz} im {Rahmen} der {PRiVENT}-{Intervention}},
	volume = {77},
	copyright = {Georg Thieme Verlag Rüdigerstraße 14, 70469 Stuttgart, Germany},
