	keywords = {Promotion:Literaturanalyse, Training, University, COVID-19, \#4:Konferenz-Paper:MOOC, Computer aided instruction, Electronic learning, MOOC, Collaboration, Licenses, Project management, use case, Promotion:S:04 MOOC, Promotion:Literaturverzeichnis},
