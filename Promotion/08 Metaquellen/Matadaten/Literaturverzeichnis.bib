@misc{statista_research_department_meistbesuchte_2024,
	type = {Statistik},
	title = {Top 10 der meistbesuchten {Websites} im {Bereich} {Bildung} nach {Visits} weltweit im {Juli} 2024},
	url = {https://de.statista.com/statistik/daten/studie/1402079/umfrage/meistbesuchte-websites-bildung-weltweit/},
	abstract = {Die Lernplattform instructure.com war im Juli 2024 mit rund 170,4 Millionen Visits die meistbesuchte Website im Bereich Bildung weltweit. Instructure entwickelte das führende Learning Management System Canvas. Auf dem zweiten Platz des Rankings lag zum Zeitpunkt der Erhebung scribd.com, welches auch als "YouTube für Dokumente" bezeichnet wird. Die Plattform, auf der unter anderem (Hör-)Bücher, Podcasts und Noten abgerufen werden können, kam auf rund 167 Millionen Visits.},
	language = {de-DE},
	urldate = {2024-10-23},
	publisher = {Statista Research Department},
	author = {{Statista}},
	year = {2024},
	note = {@statista research department\_meistbesuchte\_2024},
	keywords = {Promotion:\# Abbildungen (ohne Quelle), Promotion:1.1.3 Thematische Relevanz, Promotion:Literaturverzeichnis},
	annote = {Diese Statista-Grafik („Top 10 der meistbesuchten Websites im Bereich Bildung nach Visits weltweit im Juli 2024“) lässt sich kontextsensitiv und analytisch tragfähig in Deine Dissertation einweben – unter bestimmten Bedingungen und Zielsetzungen. Die Einbindung ist nicht trivial, aber kann methodisch sinnvoll strukturiert werden.
Mögliche Einordnung in Deine Arbeit
1. Anschlussfähigkeit an Deine Theorie- und Forschungsperspektive:
Die Darstellung fokussiert auf Reichweitenmetriken, also rein quantitative Nutzung digitaler Bildungsplattformen (instructure.com, scribd.com, byjus.com etc.).
Dein Dissertationsansatz zielt auf das Wirkgefüge eines konkreten LMS, inklusive Systemkopplung, Interdependenz und epistemischer Rückkopplung.
Damit bietet sich die Grafik nicht als Beleg, aber als strukturierender Kontrast an – insbesondere für eine theoretische Reflexion zum Unterschied zwischen:
oberflächlicher Nutzung (Visit-Zahlen) und
tiefenstruktureller Wirksamkeit (zirkuläre Lernprozesse im HRT-Kontext).
2. Mögliche narrative Verwendung:
Kapitel 1.1 oder 1.3 (Erkenntnisinteresse / Forschungsstand):
Die Grafik könnte dort als Anker für ein strukturelles Missverständnis von Wirksamkeit eingebettet werden: Hohe Zugriffszahlen deuten nicht auf Qualität oder Wirktiefe hin.
Dadurch lässt sich der epistemologische Fokus Deiner Arbeit schärfen: Wirkung entsteht nicht aus Zugriff, sondern aus Rückkopplung, Kontextkopplung und didaktischer Struktur.
3. Potenzial für Reflexion über Marktlogik:
Die Platzierungen zeigen deutlich, dass kommerziell betriebene Plattformen mit massiven Kapitalhintergründen dominieren.
Dies erlaubt einen kritischen Seitenblick auf die Ökonomisierung von Bildung und kann als Kontextfolie dienen, warum systemische Wirkung jenseits von Reichweite analysiert werden muss.
Einschränkungen:
Die Grafik sagt nichts über inhaltliche Qualität, Lerntiefe, didaktische Gestaltung oder Rückkopplungsebenen aus.
Ohne kritische Kontextualisierung besteht die Gefahr einer impliziten Gleichsetzung von Nutzung und Wirkung – dies musst Du konzeptionell abfangen.
Fazit:
Die Abbildung kann nicht direkt zur Beantwortung Deiner Forschungsfrage beitragen, aber sie ist als diskursive Folie sinnvoll einsetzbar, wenn Du Folgendes sicherstellst:
kritische Rahmung im Theorieteil, z. B. als Kontrastfolie für oberflächliche Nutzung vs. systemisch eingebettete Wirkung,
Vermeidung jeder Suggestion, dass Reichweite mit Wirksamkeit gleichgesetzt werden kann,
Explizite Koppelung an Deinen methodisch-theoretischen Ansatz (z. B. in Kapitel 1.3 oder 6.3.1).
Ein geeigneter Übergang wäre etwa:
„Während öffentlich zugängliche Nutzungsmetriken populärer Bildungsplattformen (z. B. Instructure, Byju's, Coursera) auf eine hohe Verbreitung digitaler Bildungsangebote verweisen (vgl. Abb. X), bleibt offen, wie sich diese Nutzung auf die Struktur, Tiefe und Rückkopplung von Lernprozessen auswirkt – insbesondere in kontextgebundenen High-Responsibility-Settings.“
Empfehlung:
Einbindung möglich, wenn kritisch reflektiert und argumentativ eingebettet – nicht als Beleg, sondern als Diskussionsauslöser für Deine Problemstellung.
},
	file = {Statista - 2024 - Top 10 der meistbesuchten Websites im Bereich Bildung nach Visits weltweit im Juli 2024:/Users/jochenhanisch-johannsen/Zotero/storage/E83V6ZLX/Statista - 2024 - Top 10 der meistbesuchten Websites im Bereich Bildung nach Visits weltweit im Juli 2024.png:image/png},
}

@misc{statista_research_department_umfrage_2024,
