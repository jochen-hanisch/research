	year = {2023},
	doi = {10.1007/978-3-031-44198-1_8},
	note = {Series Title: Lecture Notes in Computer Science},
	keywords = {Charité:Promotion, Promotion:Literaturanalyse, \#b:Buchteil:online:learning, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {87--98},
