@inproceedings{hoffmanngerd2020Hiv,
  title = {Hinzulernen im Verlauf des Forschenden Lernens auf Basis von Open Educational Resources. Unterstützung einer flexiblen Wissensvermittlung mit Referatorien},
  author = {Hoffmann, Gerd},
  date = {2020-02-21},
  publisher = {Waxmann},
  doi = {10/grsthv},
  url = {https://www.pedocs.de/frontdoor.php?source_opus=18462},
  urldate = {2023-02-17},
  abstract = {Im Artikel "Hinzulernen im Verlauf des Forschenden Lernens auf Basis von Open Educational Resources. Unterstützung einer flexiblen Wissensvermittlung mit Referatorien“ wird von Gerd Hoffmann der Begriff des "Ad-hoc-Lernens“ als Teilelement des forschenden Lernens ausdefiniert sowie mediendidaktisch konzeptionalisiert. Mit Bezug auf den Ansatz von Personal Learning Environments (PLR) und der zunehmenden Etablierung von Open Educational Resources (OER) wird im Sinne der Lernerzentrierung des forschenden Lernens ein Referatorium-Konzept vorgestellt, welches das Ad-hoc-Lernen unterstützt und zugleich einen geleiteten Zugang zu OERs ermöglicht. Durch ein solches Referatorium kann der/die forschend Lernende selbstbestimmt auf die Wissensbestände des Internets zugreifen. Zugleich ermöglicht die Filterfunktion eines Referatoriums einen zielgerichteten Zugang zu OER-Materialien, so dass die forschend Lernenden nicht durch einen Material-Overload im Zuge der Daten-Recherche in ihren Lernprozessen eingeschränkt werden. (DIPF/Orig.)},
  langid = {ngerman},
  keywords = {6:Konferenz-Paper:Bildung:Technologie,Academic studies,Bildung,Bildungstheorien,Charité:Promotion,Digitale Bildung,Educational Environment,Hochschullehre,Information literacy,Information skills,Informations- und Kommunikationstechnologie,Kompetenz,Learning environment,Lehrender,Lernplattform,Lernumgebung,Promotion:02-01_Q2,Promotion:02-01_Q3,Promotion:FU4a,Promotion:Kerngedanke,Promotion:Literaturanalyse,Promotion:Relevanz:5,Promotion:S:06 Bildungstechnologie,Studierender,Studium,Teacher,Technologieintegration,University lecturing,University teaching,Unterstützungsmanagement,Virtual learning,Wissensvermittlung},
  file = {/Users/jochen_hanisch-johannsen/Zotero/storage/WU5YFJXM/Hoffmann, Gerd - 2020 - Hinzulernen im Verlauf des Forschenden Lernens auf.pdf}
