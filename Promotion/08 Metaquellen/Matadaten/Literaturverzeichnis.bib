@article{yu_using_2024,
	title = {Using hybrid intelligence to enhance peer feedback for promoting teacher reflection in video‐based online learning},
	issn = {0007-1013, 1467-8535},
	url = {https://bera-journals.onlinelibrary.wiley.com/doi/10.1111/bjet.13559},
	doi = {10.1111/bjet.13559},
	abstract = {Video‐based teacher online learning enables teachers to engage in reflective practice by watching others' classroom videos, providing peer feedback (PF) and reviewing others' work. However, the quality and reliability of PF often suffer due to variations in teaching proficiency among providers, which limits its usefulness for reviewers. To improve the quality of PF, hybrid intelligence is a promising approach that enhances human evaluation with AI‐based techniques. Thus, we developed a hybrid intelligence feedback (HIF) system, where PF is categorized and summarized by large language models (LLM), and accompanied with AI multimodal data analysis, all in accordance with a knowledge structure. To investigate the effectiveness of the HIF, we conducted a study involving 58 pre‐service mathematics teachers. After their initial feedback provision on a classroom video, they were divided into two groups. One group received HIF, while the other received traditional PF. Both groups revised their initial feedback based on the same video with PF or HIF report, and were assigned two tasks, namely in‐depth reflection and extensive reflection. We analysed the reflective writings generated in in‐depth reflection using the Structure of Observed Learning Outcomes taxonomy, and examined the diversity of teachers' attentions in extensive reflection using information entropy. Compared to traditional PF, our findings indicated that HIF (a) facilitated more comments added in feedback revision, (b) promoted multi‐structural and extended abstract level thinking in in‐depth reflection, (c) encouraged more diverse attentions in extensive reflection. These results demonstrate the effectiveness of HIF in enhancing PF to promote reviewers' reflection. This efficacy can be attributed to the utilization of LLM to identify common elements within PF, guided by the human knowledge‐based framework, as well as the integration of data‐driven evidence to complement PF.
            
            
              
              
                
                  
                    Practitioner notes
                  
                  
                    What is already known about this topic?
                    
                      
                        Video‐based teacher online learning allows teachers to reflect on their own or others' videos flexibly while providing and reviewing peer feedback using reflection tools.
                      
                      
                        While the benefits of reflecting on one's own videos with peer feedback are widely recognized, there is limited empirical evidence supporting the advantages of reflecting on others' videos with peer feedback. The effectiveness of this process may be affected by the quality and reliability of the peer feedback provided.
                      
                      
                        Using natural language processing techniques to enhance peer feedback can be feasible and effective. However, it is primarily used to address textual‐level issues and is less effective in promoting professionalism.
                      
                      
                        Multimodal data analysis has shown effectiveness in enhancing teaching behaviours and facilitating reflection. However, despite the widespread use of AI‐based analysis on classroom videos, they often lack educational interpretations.
                      
                      
                        Hybrid intelligence is a novel concept in learning science research, aiming to leverage both human and machine intelligence to enhance the overall effectiveness.
                      
                    
                  
                  
                    What this paper adds?
                    
                      
                        This study applied the concept of hybrid intelligence to video‐based teacher learning by proposing a hybrid intelligence feedback (HIF) system, aiming to promote teachers' reflection on others' videos during the peer feedback review process.
                      
                      
                        This study proposed the design of HIF module, where human peer feedback was enhanced by large language models, and machine data analysis was complemented with educational interpretations, all structured according to an expert knowledge structure.
                      
                      
                        The results showed that the HIF was effective to stimulate teachers' higher‐level thinking in in‐depth reflection and enhanced the diversity of their attentions in extensive reflection. However, it may still be challenging for novices to comprehend and integrate newly noticed pedagogical strategies in the HIF with their internal knowledge structures during reflection.
                      
                    
                  
                  
                    Implications for practice and/or policy
                    
                      
                        With the rapid advancement of generative artificial intelligence, the utilization of large language models becomes more flexible and effective, enabling multitasking enhancement for peer feedback in collaboration with human's professional knowledge.
                      
                      
                        Multimodal data analysis effectively collaborates with human observations by managing low‐level observation aspects, allowing humans to concentrate on higher‐level thinking guided by the educational interpretations.
                      
                      
                        The effectiveness of the HIF system is influenced by teachers' pedagogical knowledge, prior feedback provision experience and data literacy. In the future research, these diversities need to be taken into account in the design of video‐based PD incorporating HIF to assess its long‐term efficacy.},
	language = {en-GB},
	urldate = {2025-01-05},
	journal = {British Journal of Educational Technology},
	author = {Yu, Jinglei and Yu, Shengquan and Chen, Ling},
	month = dec,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Lehr- und Lerneffektivität, Promotion:Relevanz:5, Technologieintegration, Bewertungsmethoden, Promotion:Weiterführung, Promotion:FU6, Promotion:01-02, 4.3.1 Literaturanalyse und KI-gestützte Methoden, Promotion:4.3.1 Literaturanalyse und KI-gestützte Methoden, Promotion:01-02 Methodenquellen, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {bjet.13559},
	annote = {Analyse der Studie „Using Hybrid Intelligence to Enhance Peer Feedback for Promoting Teacher Reflection in Video-Based Online Learning“ von Yu et al. (2024)

1. Hauptthemen und Ziele der Forschung
Die Studie untersucht, wie hybride Intelligenz (Kombination von menschlicher und KI-gestützter Analyse) die Qualität von Peer-Feedback (PF) verbessern kann, um die Reflexion von Lehrkräften in video-basierten Online-Lernumgebungen zu fördern. Ein besonderes Augenmerk liegt darauf, wie KI-gestützte Unterstützung die Tiefe und Vielfalt der Reflexionen von Lehrkräften beeinflusst.
Zentrale Forschungsfragen:


Wie wirkt sich hybride Intelligenz auf die Tiefe der Reflexion von Lehrkräften aus?


Inwiefern beeinflusst sie die Vielfalt der pädagogischen Perspektiven in den Reflexionen?


Wie bewerten Lehrkräfte das hybride Intelligenz-Feedback (HIF) im Vergleich zu herkömmlichem Peer-Feedback?



2. Methoden und Datenquellen
Methoden:
Die Studie nutzt ein experimentelles Design, in dem 58 angehende Mathematiklehrkräfte zufällig zwei Gruppen zugewiesen wurden:


Gruppe 1: Erhielt klassisches Peer-Feedback (PF).


Gruppe 2: Erhielt hybrides Intelligenz-Feedback (HIF), das menschliches Feedback mit KI-gestützter Analyse und Strukturierung kombinierte.


Beide Gruppen sollten nach dem Betrachten eines Unterrichtsvideos Reflexionsaufgaben bearbeiten.


Messmethoden:


Tiefenreflexion (Task 1): Bewertet mit der Structure of Observed Learning Outcomes (SOLO) Taxonomie (z. B. von oberflächlichen zu abstrahierten Erkenntnissen).


Vielfältigkeit der Reflexion (Task 2): Gemessen mit Informationsentropie, um zu bewerten, ob HIF zu einer breiteren Betrachtung pädagogischer Konzepte führt.


Befragung zur Akzeptanz von HIF: Vergleich der Zufriedenheit zwischen PF- und HIF-Nutzenden.




Datenquellen:


58 angehende Mathematiklehrkräfte mit Lehrerfahrung.


Analyse von Reflexionstexten nach der SOLO-Taxonomie.


Quantitative Messungen zur Diversität pädagogischer Perspektiven.


Post-Studien-Fragebögen zur Wahrnehmung von HIF im Vergleich zu traditionellem PF.



3. Zentrale Forschungsergebnisse


HIF fördert tiefere Reflexionen als klassisches Peer-Feedback


HIF-Gruppe zeigte signifikant mehr Reflexionen auf „multi-struktureller“ und „abstrakter“ Ebene (p {\textless} 0.05).


HIF unterstützte höhere kognitive Verarbeitungsstufen, indem es differenzierte pädagogische Perspektiven aufzeigte.




HIF steigert die Vielfalt pädagogischer Perspektiven


Die Reflexionen der HIF-Gruppe zeigten eine größere Informationsentropie, was darauf hinweist, dass sie eine breitere Vielfalt an pädagogischen Konzepten berücksichtigten.


Lehrkräfte mit HIF erkannten mehr didaktische Prinzipien, die sie ohne KI-Unterstützung übersehen hätten.




Lehrkräfte bewerten HIF positiver als klassisches Peer-Feedback


Höhere Zufriedenheit in der HIF-Gruppe, insbesondere bei Lehrkräften mit hohem Vorwissen.


Lehrkräfte mit höherer digitaler Kompetenz zogen größeren Nutzen aus der KI-Unterstützung als solche mit geringerer Erfahrung in datenbasierter Analyse.





4. Zusammenfassung
Die Studie zeigt, dass hybride Intelligenz (Kombination von KI und menschlichem Feedback) ein effektives Mittel zur Förderung tiefgehender und diverser Reflexionen in der Lehrerbildung ist. Lehrkräfte, die HIF erhielten, zeigten signifikant höhere kognitive Reflexionsebenen und betrachteten eine breitere Palette pädagogischer Perspektivenals jene, die herkömmliches Peer-Feedback nutzten.
Allerdings hängt die Akzeptanz und Wirksamkeit von HIF stark vom Vorwissen und der digitalen Kompetenz der Lehrkräfte ab.

5. Kernaussagen


„Hybride Intelligenz verbessert die Qualität von Peer-Feedback, indem sie tiefere Reflexionen und diversere Perspektiven ermöglicht.“ (S. 18)


„Lehrkräfte mit HIF reflektieren auf einem höheren kognitiven Niveau als jene mit herkömmlichem Peer-Feedback.“ (S. 19)


„Die Akzeptanz von HIF hängt stark vom Vorwissen und der digitalen Kompetenz der Lehrkräfte ab.“ (S. 22)



6. Argumentationslinien
Die Studie argumentiert, dass die Kombination aus menschlichem Peer-Feedback und KI-gestützter Analyse die Reflexionseffekte in der Lehrerbildung verbessert:


Grundannahme: KI kann die Qualität und Tiefe von Reflexionen verbessern, indem sie systematisches, datenbasiertes Feedback ermöglicht. (S. 5)


Empirischer Beleg: Die HIF-Gruppe zeigte signifikant tiefere Reflexionen als die PF-Gruppe (p {\textless} 0.05). (S. 18)


Didaktische Implikationen: Hochschulen sollten hybride Intelligenz nutzen, um Reflexionsprozesse in der Lehrerbildung gezielt zu fördern. (S. 22)



7. Verschlagwortung




Schlagwort


Begründung




Technologieintegration


Die Studie untersucht, wie KI-gestützte Feedbacksysteme zur Verbesserung der Reflexion eingesetzt werden können.




Bewertungsmethoden


Anwendung der SOLO-Taxonomie und Informationsentropie zur Messung der Reflexionstiefe und -vielfalt.




Lehr- und Lerneffektivität


Die Ergebnisse zeigen, dass KI-gestütztes Peer-Feedback tiefere und diversere Reflexionen ermöglicht.





8. Kategorisierung
Kategorie: Weiterführung


Kriterium: Die Studie zeigt, wie KI-gestützte hybride Intelligenz das bestehende Peer-Feedback- und Reflexionsmodell weiterentwickelt.


Beispiel: HIF ermöglicht eine systematischere und datenbasierte Reflexionsförderung als traditionelle Feedbackmethoden. (S. 22)



9. Zuordnung zu einer Forschungsunterfrage (FU)
Passendste Forschungsunterfrage: FU6„Wie wird ein systemisch-konstruktivistisches Learning-Management-System als Kompetenzerwerbssystem bei Akteuren im digitalen Bildungsraum von Gesundheitsberufen beurteilt?“
Begründung:Die Studie zeigt, dass KI-gestütztes Peer-Feedback ein effektiver Ansatz zur Verbesserung der Reflexion und des Kompetenzerwerbs in digitalen Lernumgebungen ist. Dies ist besonders für die Entwicklung systemisch-konstruktivistischer LMS für Gesundheitsberufe relevant, in denen reflektierte Praxis eine zentrale Rolle spielt.

10. Relevanzbewertung (1–5)
Relevanz: 5


Direkte Anwendbarkeit: Die Forschung bietet wertvolle Erkenntnisse für die Implementierung KI-gestützter Feedbacksysteme in LMS.


Theoretische Relevanz: Die Studie liefert neue Einsichten zur Verbesserung von Peer-Feedback durch hybride Intelligenz.


Innovationspotenzial: KI-gestützte Feedbacksysteme zeigen vielversprechende Potenziale zur Optimierung von Reflexions- und Lernprozessen in der Lehrer- und Gesundheitsbildung.


},
	file = {Yu et al. - 2024 - Using hybrid intelligence to enhance peer feedback for promoting teacher reflection in video‐based o:/Users/jochenhanisch-johannsen/Zotero/storage/BEFHDRGQ/Yu et al. - 2024 - Using hybrid intelligence to enhance peer feedback for promoting teacher reflection in video‐based o.pdf:application/pdf},
}

@incollection{bartimote_collaborative_2024,
	address = {Cham},
	title = {Collaborative {Learning} {Theory} and {Analytics}},
