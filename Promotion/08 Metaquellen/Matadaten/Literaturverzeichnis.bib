	note = {Series Title: Lecture Notes in Computer Science},
	keywords = {Charité:Promotion, Promotion:Literaturanalyse, Bildung, Multimedia, \#6:Buchteil:Bildung:Technologie, Promotion:S:06 Bildungstechnologie, Promotion:Literaturverzeichnis},
