@incollection{smith_synthetic_2025,
	address = {Cham},
	title = {Synthetic {Educators}: {Analyzing} {AI}-{Driven} {Avatars} in {Digital} {Learning} {Environments}},
	volume = {15807},
	isbn = {978-3-031-93566-4 978-3-031-93567-1},
