@article{tudor_car_digital_2019,
	title = {Digital {Problem}-{Based} {Learning} in {Health} {Professions}: {Systematic} {Review} and {Meta}-{Analysis} by the {Digital} {Health} {Education} {Collaboration}},
	volume = {21},
	issn = {1438-8871},
	shorttitle = {Digital {Problem}-{Based} {Learning} in {Health} {Professions}},
	url = {https://www.jmir.org/2019/2/e12945/},
	doi = {10.2196/12945},
	abstract = {Background: The use of digital education in problem-based learning, or digital problem-based learning (DPBL), is increasingly employed in health professions education. DPBL includes purely digitally delivered as well as blended problem-based learning, wherein digital and face-to-face learning are combined.
Objective: The aim of this review is to evaluate the effectiveness of DPBL in improving health professionals’ knowledge, skills, attitudes, and satisfaction.
Methods: We used the gold-standard Cochrane methods to conduct a systematic review of randomized controlled trials (RCTs). We included studies that compared the effectiveness of DPBL with traditional learning methods or other forms of digital education in improving health professionals’ knowledge, skills, attitudes, and satisfaction. Two authors independently screened studies, extracted data, and assessed the risk of bias. We contacted study authors for additional information, if necessary. We used the random-effects model in the meta-analyses.
Results: Nine RCTs involving 890 preregistration health professionals were included. Digital technology was mostly employed for presentation of problems. In three studies, PBL was delivered fully online. Digital technology modalities spanned online learning, offline learning, virtual reality, and virtual patients. The control groups consisted of traditional PBL and traditional learning. The pooled analysis of seven studies comparing the effect of DPBL and traditional PBL reported little or no difference in postintervention knowledge outcomes (standardized mean difference [SMD] 0.19, 95\% CI 0.00-0.38). The pooled analysis of three studies comparing the effect of DPBL to traditional learning on postintervention knowledge outcomes favored DPBL (SMD 0.67, 95\% CI 0.14-1.19). For skill development, the pooled analysis of two studies comparing DPBL to traditional PBL favored DPBL (SMD 0.30, 95\% CI 0.07-0.54). Findings on attitudes and satisfaction outcomes were mixed. The included studies mostly had an unclear risk of bias.
Conclusions: Our findings suggest that DPBL is as effective as traditional PBL and more effective than traditional learning in improving knowledge. DPBL may be more effective than traditional learning or traditional PBL in improving skills. Further studies should evaluate the use of digital technology for the delivery of other PBL components as well as PBL overall.},
	language = {en-GB},
	number = {2},
	urldate = {2021-12-12},
	journal = {Journal of Medical Internet Research},
	author = {Tudor Car, Lorainne and Kyaw, Bhone Myint and Dunleavy, Gerard and Smart, Neil A and Semwal, Monika and Rotgans, Jerome I and Low-Beer, Naomi and Campbell, James},
	month = feb,
	year = {2019},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Technologieintegration, Promotion:Relevanz:4, \#0:Zeitschriftenartikel:digital:learning, Bildung, Multimedia, Promotion:FU2b, effectiveness, medical education, randomized controlled trials, systematic review, problem-based learning, Promotion:S:12 Digital Learning, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU2b},
	pages = {e12945},
	annote = {Analyse des Artikels "Digital Problem-Based Learning in Health Professions: Systematic Review and Meta-Analysis" von Lorainne Tudor Car et al. (2019)
1. Analyse
Hauptthemen und -ziele der Forschung: Der Artikel untersucht die Wirksamkeit des digital unterstützten problemorientierten Lernens (DPBL) in der Ausbildung von Gesundheitsberufen. Ziel ist es, die Auswirkungen von DPBL auf das Wissen, die Fähigkeiten, die Einstellungen und die Zufriedenheit der Lernenden zu bewerten und die wirtschaftlichen Auswirkungen sowie potenzielle unerwünschte Effekte zu analysieren.
Verwendete Methoden und Datenquellen:


Methodische Ansätze: Systematische Überprüfung und Meta-Analyse von randomisierten kontrollierten Studien (RCTs) unter Anwendung der Cochrane-Methodik.


Werkzeuge und Datenquellen: Durchsuchung von sieben elektronischen Datenbanken, einschließlich MEDLINE, Embase, Cochrane Central Register of Controlled Trials, PsycINFO, ERIC, CINAHL und Web of Science. Zusätzlich wurden Referenzlisten relevanter Studien und systematischer Übersichten durchsucht.


Zentrale Forschungsergebnisse:


Wissenserwerb: DPBL erwies sich als ebenso effektiv wie traditionelles PBL und teilweise effektiver als traditionelles Lernen in Bezug auf den Wissenszuwachs.


Fähigkeitsentwicklung: DPBL kann die Entwicklung praktischer Fähigkeiten besser fördern als traditionelles PBL oder traditionelles Lernen.


Zufriedenheit und Einstellungen: Die Ergebnisse hinsichtlich der Zufriedenheit und der Einstellungen der Lernenden waren gemischt. In einigen Studien wurde eine höhere Zufriedenheit bei vollständig digital durchgeführtem DPBL berichtet.


Risiko der Nutzerabwanderung: Es gab keine Hinweise auf signifikante unerwünschte Effekte von DPBL im Vergleich zu traditionellen Lernmethoden.


2. Zusammenfassung
Kernpunkte des Artikels:


Problemstellung: Untersuchung der Wirksamkeit von DPBL in der Gesundheitsberufsausbildung im Vergleich zu traditionellem PBL und traditionellem Lernen.


Methodik: Systematische Überprüfung und Meta-Analyse von RCTs, Daten aus sieben elektronischen Datenbanken.


Hauptergebnisse: DPBL fördert den Wissenszuwachs und die Fähigkeitsentwicklung effektiv, zeigt jedoch gemischte Ergebnisse hinsichtlich der Zufriedenheit und Einstellungen der Lernenden.


Schlussfolgerungen: DPBL ist eine vielversprechende Methode zur Verbesserung des Wissens und der Fähigkeiten von Lernenden in Gesundheitsberufen, bedarf jedoch weiterer Forschung hinsichtlich langfristiger Auswirkungen und optimaler Implementierungsstrategien.


3. Kernaussagen


Wissenserwerb: „DPBL is as effective as traditional PBL and more effective than traditional learning in improving knowledge outcomes.“ (S. 5)


Fähigkeitsentwicklung: „DPBL may be more effective than traditional learning or traditional PBL in improving skills.“ (S. 5)


Zufriedenheit und Einstellungen: „Findings on attitudes and satisfaction outcomes were mixed.“ (S. 5)


4. Argumentationslinien


Wirksamkeit von DPBL: Der Artikel argumentiert, dass DPBL eine effektive Methode ist, um den Wissenszuwachs und die Fähigkeitsentwicklung der Lernenden zu fördern und potenziell besser als traditionelle Methoden abschneidet.


Herausforderungen und Empfehlungen: Es wird betont, dass weitere Forschung erforderlich ist, um die langfristigen Auswirkungen von DPBL zu bewerten und optimale Implementierungsstrategien zu entwickeln.


Nutzerperspektive: Der Artikel hebt hervor, dass die Zufriedenheit und Einstellungen der Lernenden gegenüber DPBL gemischt sind, was auf die Notwendigkeit weiterer Untersuchungen hinweist.


5. Verschlagwortung


Lehr- und Lerneffektivität:


Begründung: Der Artikel untersucht die Effektivität von DPBL zur Verbesserung des Wissens und der Fähigkeiten der Lernenden.


Fundstelle: S. 5




Technologieintegration:


Begründung: Der Artikel behandelt die Integration digitaler Technologien in problemorientierte Lernansätze zur Unterstützung des Lernens.


Fundstelle: S. 5




6. Kategorisierung


Kategorie: Kerngedanke


Kriterium: Der Artikel liefert wesentliche Gedanken zum Einsatz von DPBL und dessen Auswirkungen auf die Lernenden in Gesundheitsberufen.


Beispiel: Diskussion der Hauptbefunde zur Wirksamkeit von DPBL und deren Bedeutung für die pädagogische Praxis. (S. 5)




7. Zuordnung zu Forschungsfragen


FU2b: Welche Effekt-Faktoren erläutern Lehrende im digitalen Bildungsraum von Gesundheitsberufen bei der Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems?


Begründung: Der Artikel untersucht, wie DPBL die Unterstützung und das kritische Denken der Lernenden verbessern kann.


Fundstelle: S. 5




Gesamtbewertung: 4/5
Diese Analyse zeigt die Relevanz des Artikels für die Untersuchung der Wirksamkeit von DPBL in der Gesundheitsberufsausbildung. Die Forschung bietet wertvolle Einblicke in die aktuellen Entwicklungen und Herausforderungen in diesem Bereich und gibt Empfehlungen für zukünftige Forschungen.
},
	file = {Tudor Car et al. - 2019 - Digital Problem-Based Learning in Health Professio.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/2RZDC2BH/Tudor Car et al. - 2019 - Digital Problem-Based Learning in Health Professio.pdf:application/pdf},
}

