@article{park_taking_2024,
	title = {Taking a stance in the process of learning: {Developing} perspectival understandings through knowledge co-construction during synchronous computer-mediated classroom discussion},
	volume = {19},
	issn = {1556-1607, 1556-1615},
	shorttitle = {Taking a stance in the process of learning},
	url = {https://link.springer.com/10.1007/s11412-023-09416-x},
	doi = {10.1007/s11412-023-09416-x},
	abstract = {This study extends research on perspectival understanding (Greeno \& van de Sande, 2007) by using Du Bois’ (2007) discourse work on stancetaking to investigate how students expressed their perspectives on course content through a variety of stances/positions as they negotiated meaning in online discussions. Participants were students in a hybrid graduate-level course with weekly synchronous computer-mediated discussions. Adapting Du Bois’ stancetaking triangle, we coded discussion transcripts for shifts in stance and for evidence of influence on students’ perspective taking as they considered course concepts. Findings were that stances and stance objects (that is, topics) were introduced as students collaborated in discussion, with an epistemic stance indicating students’ primary focus on wanting to learn and understand course concepts. Evaluative and affective stances were less frequent and most often intertwined with an epistemic stance but nevertheless important in supporting the group’s discussion. Synchronous online discussions afforded a venue for iterative discourse interactions of evaluation, positioning, and alignment and for shared knowledge co-construction and perspectival understanding.},
	language = {en-GB},
	number = {1},
	urldate = {2024-04-17},
	journal = {International Journal of Computer-Supported Collaborative Learning},
	author = {Park, Hannah and Schallert, Diane L. and Williams, Kyle M. and Gaines, Rachel E. and Lee, Jeonghyun and Choi, Eunjeong},
	month = mar,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Kollaboratives Lernen, Lehr- und Lerneffektivität, Promotion:FU4a, Promotion:Kerngedanke, Technologieintegration, Bildungstheorien, Promotion:Relevanz:4, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {67--95},
	annote = {Analyse des Artikels von Park et al. (2024) „Taking a stance in the process of learning: Developing perspectival understandings through knowledge co-construction during synchronous computer-mediated classroom discussion“:

1. Hauptthemen und Ziele der Forschung
Die Studie untersucht, wie Studierende in synchronen, computervermittelten Diskussionen (SCMC) Perspektiven entwickeln und Wissen gemeinsam konstruieren. Dabei wird das Konzept des perspektivischen Verständnisses(perspectival understanding) nach Greeno \& van de Sande (2007) mit dem Stancetaking-Ansatz (stance triangle) nach Du Bois (2007) kombiniert. Ziel ist es, zu analysieren, wie Studierende ihre Standpunkte zum Kursinhalt äußern und welche epistemischen, affektiven und evaluativen Haltungen sie dabei einnehmen.
Kernfragen der Forschung:


Wie drücken Studierende ihre Standpunkte in synchronen computervermittelten Diskussionen aus?


Welche Rolle spielt Stancetaking im Prozess der gemeinsamen Wissenskonstruktion?



2. Methoden und Datenquellen
Methodische Ansätze


Diskursanalyse basierend auf Du Bois’ Stancetaking-Ansatz: Analyse von Positionierung, Bewertung und Alignment der Studierenden im Diskurs.


Grounded-Theory-Ansatz zur Identifikation emergenter Muster in den Diskussionen.


Konstante vergleichende Methode (Corbin \& Strauss, 2008) zur Entwicklung einer systematischen Kodierung von Stancetaking-Mustern.


Datenquellen


27 Transkripte von synchronen Online-Diskussionen (3 Gruppen x 9 Sitzungen).


Teilnehmer: 37 Graduiertenstudierende aus verschiedenen bildungswissenschaftlichen Fachbereichen.


Analyse der Stellungnahmen im Diskurs und deren thematische Verschiebungen zur Identifikation von Lernprozessen.



3. Zentrale Forschungsergebnisse


Die epistemische Haltung dominiert die Diskussionen


Studierende äußern sich am häufigsten in Form einer epistemischen Haltung (Wissenserwerb, Hinterfragen von Inhalten).


Evaluative und affektive Haltungen treten seltener auf, jedoch meist in Kombination mit epistemischen Haltungen.




Thematische Verschiebungen als Indikator für perspektivische Verständnisse


Der Wechsel des Diskussionsthemas signalisiert oft eine kognitive Neuausrichtung der Studierenden.


Studierende reagieren auf neue Perspektiven mit einer Anpassung ihrer eigenen Standpunkte.




Die Rolle der Stancetaking-Elemente


Die Elemente Positionierung, Bewertung und Alignment prägen die Art und Weise, wie Studierende ihre Perspektiven entwickeln.


Muster in der Verwendung von epistemischen, affektiven und evaluativen Haltungen wurden identifiziert.





4. Zusammenfassung
Die Studie zeigt, dass synchron computervermittelte Diskussionen eine Plattform für die Entwicklung und den Austausch von Perspektiven bieten. Studierende nehmen dabei verschiedene epistemische, affektive und evaluative Haltungen ein. Besonders relevant sind die Momente, in denen sich das Diskussionsthema verschiebt, da diese oft mit einem kognitiven Perspektivwechsel einhergehen. Die Forschung trägt dazu bei, Diskursprozesse als Indikatoren für gemeinsames Lernen zu identifizieren.

5. Kernaussagen (mit Seitenangaben)


Epistemische Haltungen dominieren synchronen Online-Diskurs (S. 74).


Thematische Verschiebungen markieren kognitive Entwicklungsschritte (S. 80).


Diskursmuster lassen sich in Positionierung, Bewertung und Alignment differenzieren (S. 86).


Affektive und evaluative Haltungen ergänzen epistemische Stancetaking-Prozesse (S. 83).



6. Argumentationslinien
Die Studie entwickelt ihre Argumentation in drei Schritten:


Theoretische Grundlage


Kombination von Stancetaking (Du Bois) und Perspektivischem Verständnis (Greeno \& van de Sande).


Diskussion über die soziale Konstruktion von Wissen im digitalen Raum.




Empirische Analyse


Untersuchung von SCMC-Transkripten mit qualitativen und quantitativen Methoden.


Identifikation dominanter Haltungsformen und deren Entwicklung über den Diskursverlauf.




Diskussion und Interpretation


Nachweis, dass synchrone Online-Diskussionen ein geeignetes Format für kollaborative Wissenskonstruktion sind.


Empfehlung, die Rolle von Stancetaking in der Bildungstechnologie weiter zu erforschen.





7. Verschlagwortung


Kollaboratives Lernen – Die Studie untersucht, wie Studierende gemeinsam Wissen aufbauen.


Diskursanalyse – Detaillierte Analyse von Online-Diskussionen mit Fokus auf sprachliche Muster.


Technologieintegration – Untersuchung der spezifischen Vorteile von SCMC in der Hochschullehre.


Lehr- und Lerneffektivität – Bewertung der Auswirkungen von synchronen Online-Diskussionen auf das Lernen.


Bildungstheorien – Bezug auf konstruktivistische und sozial-interaktionistische Lernansätze.



8. Kategorisierung
Kerngedanke:


Die Studie analysiert, wie Studierende durch Stancetaking und thematische Verschiebungen neue perspektivische Verständnisse entwickeln (S. 87).



9. Zuordnung zur Forschungsunterfrage
Passendste Forschungsunterfrage:FU4a: Welche bildungswissenschaftlichen Mechanismen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems im Bezug zur Wirkung auf Akteure im digitalen Bildungsraum von Gesundheitsberufen beschrieben?


Begründung:Die Studie zeigt, dass Diskursmechanismen (z. B. Alignment, epistemische Haltungen) einen entscheidenden Einfluss auf die Wissenskonstruktion haben.



10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 4(Die Studie untersucht digitale Bildungsprozesse, jedoch nicht spezifisch in Gesundheitsberufen).


Zitierhäufigkeit und Einfluss: 5(Publikation in einem renommierten Journal für computerunterstütztes kollaboratives Lernen).


Aktualität: 5(Veröffentlicht 2024, also hochaktuell für die Forschung zu digitalen Bildungsräumen).


Gesamtbewertung: 4 (hoch relevant)

11. Schlussfolgerung
Die Studie von Park et al. (2024) leistet einen bedeutenden Beitrag zur Analyse synchroner Online-Diskussionen als Mittel zur kollaborativen Wissenskonstruktion. Sie zeigt, dass epistemische Haltungen dominieren, dass thematische Verschiebungen ein Indikator für kognitive Entwicklung sind und dass Stancetaking-Prozesse den Diskursverlauf strukturieren. Diese Erkenntnisse sind wertvoll für die Weiterentwicklung von LMS-gestützten Lehrmethoden und für die Erforschung von Bildungsmechanismen in digitalen Räumen.
},
	file = {Park et al. - 2024 - Taking a stance in the process of learning Develo.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/LGJHB583/Park et al. - 2024 - Taking a stance in the process of learning Develo.pdf:application/pdf},
}

@article{santander-jimenez_offline_2024,
	title = {Offline and online peer assessment in computer engineering: {Insights} from a 5-year experience},
	volume = {29},
	issn = {1360-2357, 1573-7608},
	shorttitle = {Offline and online peer assessment in computer engineering},
	url = {https://link.springer.com/10.1007/s10639-023-11989-x},
	doi = {10.1007/s10639-023-11989-x},
	abstract = {Peer assessment has traditionally represented a key tool to enhance active learning and critical thinking. However, the success of this approach is governed by different factors, which have been accentuated in recent years. The implementation of peer assessment is consequently a challenging task in the current context. This work investigates peer assessment strategies in seven Computer Engineering courses. Students’ performance and assessment accuracy are analyzed throughout five academic years, covering the transition from offline to online methodologies according to the evolution of educational environments. More specifically, peer and lecturer’s grades are examined to identify correlations or deviations in two execution phases. The first phase involves the analysis of in-class offline peer assessments during four academic years, integrated as part of continuous assessment tasks. The second phase deals with the evaluation of online peer assessments in 2021/2022, considering different platforms to manage submissions and reviews. The offline experience denotes statistical correlations between the grades assigned by the peers and the lecturer, while also revealing patterns that affected the performance of students. In addition, the switch to online methodologies does not significantly affect the assessments in courses that adopted peer strategies in the past. Finally, comparable results are obtained under single-blind and double-blind models after careful training.},
	language = {en-GB},
	number = {4},
	urldate = {2024-03-23},
	journal = {Education and Information Technologies},
	author = {Santander-Jiménez, Sergio and Vega-Rodríguez, Miguel A. and Granado-Criado, José M. and Rubio-Largo, Álvaro and Gómez-Pulido, Juan A. and Gómez-Martín, César and Durán-Domínguez, Arturo},
	month = mar,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Bewertungsmethoden, Systemanpassung, Promotion:Argumentation, Promotion:Relevanz:4, Promotion:FU5, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {4591--4610},
	annote = {Analyse der Studie „Offline and online peer assessment in computer engineering: Insights from a 5-year experience“ von Santander-Jiménez et al. (2024)
1. Hauptthemen und Ziele der Forschung
Die Studie von Santander-Jiménez et al. (2024) untersucht die Auswirkungen von Peer Assessment (PA) auf die Leistung und Bewertung von Studierenden im Bereich Computer Engineering über einen Zeitraum von fünf Jahren. Besonders analysiert wird der Übergang von offline zu online durchgeführten Peer Assessments und die damit verbundenen methodischen, technischen und didaktischen Herausforderungen. Die Autoren evaluieren, wie sich PA auf die Genauigkeit der Notengebung, die Studierendenleistung und die Vergleichbarkeit zwischen Peer- und Dozierenden-Bewertungen auswirkt​Santander-Jiménez et al….

2. Methoden und Datenquellen
Methoden:


Phase I: Offline Peer Assessment (2016–2021):


In zwei Kursen (Computer Architecture, Real-Time Systems) wurden in Präsenz durchgeführte Peer-Assessments evaluiert.


Die Bewertungen wurden auf einer fünfstufigen Skala vorgenommen (Korrekt – Fair+ – Fair – Fair- – Falsch).


Vergleich der Noten zwischen Peer-Assessoren und Dozierenden.




Phase II: Online Peer Assessment (2021/2022):


Einführung von Online-Peer-Assessments in sieben Kursen, u. a. mit Moodle-Workshop und anderen Online-Plattformen.


Vergleich zwischen Single-Blind, Double-Blind und No-Blind Peer Review.


Evaluierung von Unterschieden zwischen Offline- und Online-Methoden.




Datenquellen:


Teilnehmer: 520 Studierende über fünf Jahre.


Vergleichsgrößen: Peer-Noten vs. Dozierenden-Noten, unterschiedliche Bewertungsmodelle (Offline vs. Online), unterschiedliche Anonymitätsstufen.


Erhobene Daten: Notendiskrepanzen, Korrelation zwischen Peer- und Dozierenden-Noten, Teilnahmequoten, Feedbackqualität​Santander-Jiménez et al….



3. Zentrale Forschungsergebnisse


Peer Assessment zeigt hohe Korrelation mit Dozierenden-Bewertungen:


In der Offline-Phase stimmten über 90\% der Peer-Bewertungen mit den Noten der Dozierenden überein​Santander-Jiménez et al….


In der Online-Phase blieb diese Übereinstimmung bestehen, insbesondere in Kursen, die bereits Erfahrung mit Peer Assessment hatten​Santander-Jiménez et al….




Unterschiede zwischen Offline- und Online-Assessment:


In Kursen, die erstmals Peer Assessment einführten, gab es größere Diskrepanzen zwischen Peer- und Dozierenden-Bewertungen​Santander-Jiménez et al….


Die Verwendung des Moodle-Workshop-Tools führte zu höheren Notenabweichungen als individuell angepasste Bewertungsplattformen​Santander-Jiménez et al….




Vergleich von Bewertungsmodellen:


Kein signifikanter Unterschied zwischen Single-Blind und Double-Blind Review hinsichtlich der Bewertungsgenauigkeit​Santander-Jiménez et al….


Studierende mit Training im Peer Assessment waren genauer in ihren Bewertungen​Santander-Jiménez et al….




Externe Faktoren beeinflussen Studierendenleistung:


Die COVID-19-Pandemie wirkte sich nachteilig auf die Leistungen aus, insbesondere in der ersten Online-Phase​Santander-Jiménez et al….


Höhere Anwesenheitsquoten in Offline-Kursen korrelierten mit besseren Leistungen​Santander-Jiménez et al….





Zusammenfassung
Die Studie zeigt, dass Peer Assessment eine zuverlässige Bewertungsmethode ist, die sich mit Dozierenden-Bewertungen vergleichen lässt. Besonders erfolgreich sind Peer-Assessments in Kursen, die diese Methode über mehrere Jahre hinweg anwenden. Der Wechsel zu Online-Methoden führt nicht zwangsläufig zu Verzerrungen, solange klare Bewertungsrichtlinien existieren. Unterschiede bestehen jedoch zwischen unterschiedlichen Bewertungsplattformen und Anonymitätsstufen. Training der Studierenden ist entscheidend für die Genauigkeit der Bewertungen​Santander-Jiménez et al….

4. Kernaussagen


Peer Assessment ist eine präzise Bewertungsmethode, wenn Studierende entsprechend trainiert werden​Santander-Jiménez et al….


Der Wechsel zu Online-Peer-Assessment hat wenig Einfluss auf die Bewertungsgenauigkeit in erfahrenen Kursen, führt aber zu Abweichungen in neuen Kursen​Santander-Jiménez et al….


Bewertungsmodelle mit unterschiedlichem Anonymitätsgrad (Single-Blind vs. Double-Blind) sind vergleichbar, wenn Studierende angemessen vorbereitet sind​Santander-Jiménez et al….


Die technische Umsetzung spielt eine große Rolle: Moodle-Workshop führte zu mehr Abweichungen als angepasste Systeme​Santander-Jiménez et al….


Externe Faktoren wie COVID-19 und Anwesenheitsquoten beeinflussen die Studierendenleistung erheblich​Santander-Jiménez et al….



5. Argumentationslinien


Notwendigkeit eines klaren Bewertungsrahmens:


Klare Bewertungsrichtlinien und transparente Bewertungsmaßstäbe sind essenziell für Peer Assessment​Santander-Jiménez et al….




Technologie als kritischer Erfolgsfaktor:


Die Wahl der Plattform hat Auswirkungen auf die Genauigkeit und Effizienz der Bewertungen​Santander-Jiménez et al….




Bedeutung von Training für die Studierenden:


Schulung der Studierenden verbessert die Qualität der Bewertungen und reduziert Verzerrungen​Santander-Jiménez et al….




Keine signifikanten Unterschiede zwischen Single-Blind und Double-Blind Modellen:


Unterschiede in der Anonymität haben keinen signifikanten Einfluss auf die Bewertungsergebnisse​Santander-Jiménez et al….





6. Verschlagwortung


Bewertungsmethoden: Peer Assessment als Alternative zur klassischen Dozierenden-Bewertung.


Technologieintegration: Vergleich zwischen Moodle-Workshop und anderen Plattformen.


Lehr- und Lerneffektivität: Peer Assessment fördert kritisches Denken und Selbstreflexion.


Systemanpassung: Bewertung von Anonymitätsmodellen im Peer Assessment.


Forschungsansätze: Langzeitstudie über fünf Jahre zur Evaluation von Peer Assessment​Santander-Jiménez et al….



7. Kategorisierung
Kategorie: Argumentation


Die Studie argumentiert anhand empirischer Daten, dass Peer Assessment eine zuverlässige Bewertungsmethode ist und analysiert verschiedene Einflussfaktoren (Anonymität, Plattformen, Trainingsgrad der Studierenden)​Santander-Jiménez et al….



8. Zuordnung zur Forschungsfrage
Passendste Forschungsunterfrage:
FU5: Welche Möglichkeiten und Grenzen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems durch Akteure im digitalen Bildungsraum von Gesundheitsberufen analysiert?


Begründung:


Die Studie untersucht Peer Assessment als Bewertungsmodell und dessen Grenzen in Online-Umgebungen.


Sie analysiert technologische Herausforderungen und den Einfluss verschiedener Anonymitätsstufen.


Die Ergebnisse sind übertragbar auf digitale Bildungsräume und Learning-Management-Systeme​Santander-Jiménez et al….





9. Relevanzbewertung
4 – Relevant


Die Studie liefert wertvolle Einblicke in die Bewertung von Peer Assessment, ist aber nicht direkt auf den Gesundheitsbereich fokussiert​Santander-Jiménez et al….



10. Schlussfolgerung
Die Studie von Santander-Jiménez et al. (2024) liefert wichtige Erkenntnisse zur Effektivität von Peer Assessment in der Hochschulbildung. Sie zeigt, dass Peer-Bewertungen in den meisten Fällen mit Dozierenden-Bewertungen übereinstimmen, besonders wenn Studierende darauf vorbereitet werden. Die Wahl der Bewertungsplattform spielt eine Rolle, und der Wechsel zu Online-Methoden beeinflusst die Genauigkeit nicht signifikant. Die Untersuchung unterschiedlicher Anonymitätsmodelle zeigt, dass Single-Blind und Double-Blind Peer Assessments ähnliche Ergebnisse liefern. Insgesamt wird Peer Assessment als praktikable und effektive Bewertungsmethode in digitalen Lernräumen bestätigt​Santander-Jiménez et al….
},
	file = {Santander-Jiménez et al. - 2024 - Offline and online peer assessment in computer eng.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/INYMYEI5/Santander-Jiménez et al. - 2024 - Offline and online peer assessment in computer eng.pdf:application/pdf},
}

@article{goudarzi_impact_2024,
	title = {Impact of the {Covid}-19 pandemic and ensuing online teaching on pre-clinical medical education},
	volume = {24},
	issn = {1472-6920},
	url = {https://bmcmededuc.biomedcentral.com/articles/10.1186/s12909-023-04967-x},
	doi = {10.1186/s12909-023-04967-x},
	abstract = {Background  Major disruptions and changes in education have occurred worldwide as a result of the coronavirus disease (COVID-19) pandemic and the ensuing shift from in-person to online education. However, the effect of such changes on medical education, its magnitude, and the learning domains impacted by such rapid changes have not been adequately addressed, particularly with regard to objective assessment approaches.
Methods  Second-year medical students enrolled in our Medical English Course between 2019 and 2021 were recruited from Hokkaido University, Japan (N = 321) to participate in this study. We evaluated the potential impact of teaching styles on the academic performance of students before (2019; face-to-face) and during (2020; online; 2021; in-person and online) the pandemic. We examined the potential effect of three teaching styles––in-person (2019), online (2020), and a combination of these (2021) on the academic performance of medical students using: (i) subjective assessment of self-reported general English skills, including reading, writing, listening, and speaking; and (ii) objective assessment of medical terminology scores, evidence-based medicine (EBM) skills, and final written exam scores.
Results  In-person education significantly improved listening and speaking skills in 2019 (p {\textless} 0.001). This trend was observed for writing skills in an online course in 2020 (p = 0.001). With the combined teaching method, students reported significant improvements in all four English skills. In our objective assessments, medical terminology improved significantly post-test versus pre-test for all three teaching styles, and we found that the online course did not adversely affect the gain in medical terminology knowledge during the course. Additionally, we did not find any significant differences across the three applied teaching styles regarding EBM skill levels. It is noteworthy that the students taking online courses had a significantly higher final exam score (mean ± SD; 82.8 ± 8.2) than in in-person (78.6 ± 8.8) and combined (79.7 ± 12.1) teaching styles.
Conclusions  In our study, the online/combined courses showed better academic outcomes compared to the faceto-face course in the preclinical clerkship. Although the current results need to be replicated on a larger scale, online/ combined courses can continue and evolve in the post-pandemic education of medical students. Medical schools and institutions should consider incorporating such courses, especially combined courses, into their curricula in the future to improve the effectiveness, accessibility, and flexibility of medical education.},
	language = {en-GB},
	number = {1},
	urldate = {2024-01-23},
	journal = {BMC Medical Education},
	author = {Goudarzi, Houman and Onozawa, Masahiro and Takahashi, Makoto},
	month = jan,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Forschungsansätze, Lehr- und Lerneffektivität, Bewertungsmethoden, Promotion:Argumentation, Promotion:Relevanz:4, Promotion:FU5, Krisenreaktion im Bildungsbereich, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis},
	pages = {66},
	annote = {Analyse der Studie „Impact of the Covid-19 Pandemic and Ensuing Online Teaching on Pre-Clinical Medical Education“ von Goudarzi et al. (2024)
1. Hauptthemen und Ziele der Forschung
Die Studie untersucht die Auswirkungen der Umstellung auf Online-Lehre während der COVID-19-Pandemie auf die Ausbildung von Medizinstudierenden in der präklinischen Phase. Dabei werden verschiedene Lehrmethoden – Präsenzunterricht (2019), reine Online-Lehre (2020) und hybride Lehre (2021) – verglichen, um ihre Auswirkungen auf die akademische Leistung der Studierenden zu bewerten.
Kernfragestellungen der Studie:


Wie beeinflussen Online-, Hybrid- und Präsenzunterricht die subjektiven Einschätzungen der Studierenden zu ihren Englischfertigkeiten (Lesen, Schreiben, Hören, Sprechen)?


Welche Auswirkungen haben die drei Unterrichtsformate auf objektive Leistungsindikatoren, insbesondere:


Fachterminologie-Wissen


Fähigkeiten in evidenzbasierter Medizin (EBM)


Abschließende Prüfungsleistung?




2. Methoden und Datenquellen


Stichprobe: 321 Medizinstudierende an der Hokkaido University, Japan (Jahrgänge 2019–2021).


Kursstruktur: 15-wöchiger medizinischer Englischkurs mit Fokus auf Fachkommunikation, Terminologie und evidenzbasierte Medizin.


Verglichene Lehrformate:


2019: Rein präsenzbasierter Unterricht.


2020: Komplett online aufgrund der COVID-19-Pandemie.


2021: Hybrider Unterricht mit sowohl Online- als auch Präsenzanteilen.




Datenanalyse:


Subjektive Erhebungen: Fragebögen zur Selbsteinschätzung der Englischkompetenzen (Likert-Skala 1–5).


Objektive Messungen:


Wissenstest zur medizinischen Fachterminologie (Pre-/Post-Test).


Bewertung von EBM-Fähigkeiten durch Gruppenarbeiten und Berichte.


Endprüfung mit Multiple-Choice-Fragen (MCQs).




Statistische Verfahren: ANOVA, t-Tests, multiple Regressionsanalysen.




3. Zentrale Forschungsergebnisse


Subjektive Einschätzungen der Sprachfähigkeiten:


2019 (Präsenz): Signifikante Verbesserungen bei Hörverstehen (p = 0,008) und Sprechen (p {\textless} 0,001).


2020 (Online): Verbesserung ausschließlich im Schreiben (p {\textless} 0,001).


2021 (Hybrid): Verbesserungen in allen vier Sprachfertigkeiten (p {\textless} 0,05).




Objektive Testergebnisse:


Medizinische Terminologie: Unabhängig von der Lehrmethode signifikante Wissenszuwächse (p {\textless} 0,001)in allen drei Jahren.


EBM-Fähigkeiten: Keine signifikanten Unterschiede zwischen den Gruppen.


Abschließende Prüfungsleistung:


Online-Gruppe (2020) schnitt besser ab (Ø 82,8 Punkte) als Präsenz (Ø 78,6 Punkte, p = 0,004) und Hybrid (Ø 79,7 Punkte, p = 0,038).






Weitere Beobachtungen:


Höhere Anwesenheitsrate in Online- und Hybridkursen im Vergleich zu Präsenzkursen (p {\textless} 0,001).


Studierende bevorzugen Online-Lernen aufgrund der Flexibilität, jedoch gibt es Bedenken hinsichtlich des sozialen Austauschs und der praktischen Fähigkeiten.




4. Zusammenfassung
Die Studie zeigt, dass Online- und hybride Lehrformate nicht nur gleichwertig, sondern in einigen Aspekten sogar effektiver als Präsenzunterricht in der präklinischen medizinischen Ausbildung sein können. Während Präsenzunterricht Hör- und Sprechfähigkeiten stärkt, fördert Online-Lehre besonders das Schreiben, und hybrider Unterricht unterstützt alle vier Sprachkompetenzen gleichermaßen. Hinsichtlich objektiver Leistungsindikatorenwie medizinischer Terminologie, EBM-Fähigkeiten und Prüfungsnoten zeigt sich, dass Online-Kurse keineswegs schlechter abschneiden – im Gegenteil, Studierende in reinen Online-Kursen erreichten die höchsten Endnoten.
5. Kernaussagen


Online- und hybride Kurse sind in der präklinischen medizinischen Ausbildung mindestens genauso effektiv wie Präsenzunterricht.


Präsenzunterricht verbessert Hör- und Sprechfähigkeiten, Online-Lehre hingegen Schreibfähigkeiten.


Hybrider Unterricht kombiniert die Vorteile beider Formate und bietet den breitesten Kompetenzzuwachs.


Hinsichtlich der medizinischen Fachterminologie und EBM-Fähigkeiten bestehen keine Unterschiede zwischen den Lehrmethoden.


Die abschließenden Prüfungsleistungen waren in Online-Kursen signifikant höher als in Präsenz- oder Hybridkursen.


Die höhere Flexibilität und Anwesenheitsquote in Online-Kursen könnte ein entscheidender Faktor für bessere akademische Ergebnisse sein.


6. Argumentationslinien
Goudarzi et al. (2024) argumentieren, dass die Zukunft der medizinischen Lehre verstärkt auf hybride Lehrmethoden setzen sollte, um die Vorteile von Online- und Präsenzunterricht zu kombinieren. Während frühere Studien heterogene Ergebnisse zur Effektivität von Online-Lernen in der Medizin aufzeigten, bestätigt diese Arbeit, dass Online-Unterricht in der präklinischen Phase gut funktioniert. Allerdings wird betont, dass für klinische Fähigkeitenweiterhin Präsenzunterricht unerlässlich ist.
7. Verschlagwortung


Krisenreaktion im Bildungsbereich: Anpassung medizinischer Lehrmethoden während der COVID-19-Pandemie.


Lehr- und Lerneffektivität: Vergleich der Wirksamkeit von Online-, Hybrid- und Präsenzunterricht in der medizinischen Ausbildung.


Bewertungsmethoden: Nutzung objektiver und subjektiver Leistungsindikatoren zur Messung des Lernerfolgs.


Forschungsansätze: Kombination von Fragebogenerhebungen mit objektiven Tests zur umfassenden Bewertung von Lernprozessen.


8. Kategorisierung
Weiterführung – Die Studie liefert eine fundierte Grundlage für die Weiterentwicklung medizinischer Lehrmethoden, insbesondere durch den gezielten Einsatz hybrider Lernmodelle.
9. Zuordnung zur Forschungsfrage
Passendste Forschungsunterfrage:


FU5: Welche Möglichkeiten und Grenzen werden bei Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems durch Akteure im digitalen Bildungsraum von Gesundheitsberufen analysiert?


Begründung: Die Studie untersucht die Chancen und Herausforderungen verschiedener digitaler Lehrmethoden (Online, Hybrid) und deren Auswirkungen auf den Lernerfolg.


10. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 4 (hoch relevant, aber nicht LMS-spezifisch)


Aktualität: 5 (2024, hochaktuell für digitale Lehrmethoden)


Zitierhäufigkeit und Einfluss: 3 (empirische Basis gegeben, aber begrenzte Stichprobe)


Gesamtbewertung: 4 (hoch relevant, aber nicht explizit LMS-zentriert)
11. Schlussfolgerung
Goudarzi et al. (2024) liefern empirische Belege dafür, dass Online- und hybride Lehre effektive Alternativen zur Präsenzlehre in der präklinischen medizinischen Ausbildung darstellen. Medizinische Fakultäten sollten hybride Lehrmodelle weiterentwickeln, um eine optimale Kombination aus digitaler Flexibilität und praktischer Präsenz zu erreichen. Weitere Forschung sollte sich auf die langfristigen Auswirkungen hybrider Lehre auf die klinische Ausbildung konzentrieren.
},
	file = {Goudarzi et al. - 2024 - Impact of the Covid-19 pandemic and ensuing online.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/HEMCDNG4/Goudarzi et al. - 2024 - Impact of the Covid-19 pandemic and ensuing online.pdf:application/pdf},
}

@article{radovic_analysing_2023,
	title = {Analysing students' self‐assessment practice in a distance education environment: {Student} behaviour, accuracy, and task‐related characteristics},
	issn = {0266-4909, 1365-2729},
	shorttitle = {Analysing students' self‐assessment practice in a distance education environment},
	url = {https://onlinelibrary.wiley.com/doi/10.1111/jcal.12907},
	doi = {10.1111/jcal.12907},
	abstract = {Background: Self-assessment serves to improve learning through timely feedback on one's solution and iterative refinement as a way to improve one's competence. However, the complexity of the self-assessment process is widely recognized, as well as that students can benefit from it only if their assessment is accurate enough.},
	language = {en-GB},
	urldate = {2023-11-22},
	journal = {Journal of Computer Assisted Learning},
	author = {Radović, Slaviša and Seidel, Niels and Haake, Joerg M. and Kasakowskij, Regina},
	month = nov,
	year = {2023},
	keywords = {Promotion:Literaturanalyse, \#b:Zeitschriftenartikel:online:learning, Forschungsansätze, Lehr- und Lerneffektivität, Technologieintegration, Bewertungsmethoden, Systemanpassung, Promotion:Argumentation, Promotion:Relevanz:4, Promotion:FU2b, Promotion:S:11 Online Learning, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU2b},
	pages = {jcal.12907},
	annote = {Analyse der Studie „Offline and online peer assessment in computer engineering: Insights from a 5-year experience“ von Santander-Jiménez et al. (2024)
1. Hauptthemen und Ziele der Forschung
Die Studie von Santander-Jiménez et al. (2024) untersucht die Auswirkungen von Peer Assessment (PA) auf die Leistung und Bewertung von Studierenden im Bereich Computer Engineering über einen Zeitraum von fünf Jahren. Der Fokus liegt auf dem Vergleich von offline und online durchgeführten Peer Assessments, insbesondere im Hinblick auf die Genauigkeit der Bewertungen und das Lernverhalten der Studierenden. Die Forschung zielt darauf ab, den Übergang von herkömmlichen Peer Assessments in Präsenzformaten zu digitalen Online-Formaten zu analysieren und methodische Herausforderungen sowie Leistungsunterschiede zu identifizieren​Santander-Jiménez et al….

2. Methoden und Datenquellen
Methoden:


Quantitative Analyse der Bewertungsgenauigkeit: Vergleich der Noten, die von Peers vergeben wurden, mit den Noten der Dozierenden.


Langzeituntersuchung (5 Jahre): Analyse von sieben Kursen über mehrere akademische Jahre hinweg.


Untersuchung verschiedener Peer-Assessment-Modelle:


Single-Blind-Modell (die Prüfer kennen die Identität des Autors, aber umgekehrt nicht).


Double-Blind-Modell (beide Seiten bleiben anonym).


No-Blind-Modell (offene Bewertung ohne Anonymität).




Vergleich zwischen Offline- und Online-Peer Assessment:


Phase I (Offline, 2016–2021): Integrierte Peer Assessments im Unterricht.


Phase II (Online, 2021–2022): Nutzung von Moodle®-basierten Plattformen zur Unterstützung der Online-Peer Assessments​Santander-Jiménez et al….




Datenquellen:


Studierende: Analyse von über 500 Studierenden in Computer Engineering Kursen.


Bewertungsdaten: Peer-Noten, Dozenten-Noten und Abweichungen zwischen beiden.


Plattformen: Moodle® Workshop-Tool und eigens entwickelte Cloud-Plattformen für Online-Peer Assessments​Santander-Jiménez et al….



3. Zentrale Forschungsergebnisse


Genauigkeit der Peer Assessments:


Hohe Korrelation zwischen Peer- und Dozenten-Bewertungen (über 90 \% Übereinstimmung bei erfahrenen Studierenden).


Leichte Unterschiede zwischen Offline- und Online-Bewertungen, aber keine signifikanten Verzerrungen​Santander-Jiménez et al….




Einfluss der Online-Umstellung:


Kurse mit früherer Peer-Assessment-Erfahrung passten sich leicht an Online-Methoden an.


Höhere Abweichungen zwischen Peer- und Dozenten-Bewertungen bei Kursen, die erstmals Peer Assessment durchführten​Santander-Jiménez et al….




Vergleich der Peer Assessment Modelle:


Single-Blind und Double-Blind-Modelle führten zu ähnlicher Bewertungsgenauigkeit.


No-Blind-Modelle wiesen die größten Abweichungen auf, insbesondere durch soziale Verzerrungen (Freundschaftsbonus)​Santander-Jiménez et al….




Leistungsentwicklung der Studierenden:


Studierende mit regelmäßiger Peer-Assessment-Erfahrung verbesserten ihre Bewertungsgenauigkeit.


Klassen mit hoher Präsenzbeteiligung zeigten bessere Ergebnisse als weniger aktive Studierende​Santander-Jiménez et al….





Zusammenfassung
Die Studie untersucht die Anwendung von Peer Assessment in Computer Engineering Kursen und analysiert den Übergang von offline zu online Methoden. Die Ergebnisse zeigen, dass die Bewertungsgenauigkeit in beiden Formaten vergleichbar ist, sofern klare Bewertungsrichtlinien und Trainingsmaßnahmen vorhanden sind. Online-Peer Assessments können genauso zuverlässig sein wie traditionelle Offline-Ansätze, sofern die Plattformen benutzerfreundlich gestaltet sind und Studierende entsprechend geschult werden​Santander-Jiménez et al….

4. Kernaussagen


Peer Assessment ist eine präzise Bewertungsmethode:


Hohe Korrelation zwischen Peer- und Dozenten-Bewertungen, insbesondere in erfahrenen Gruppen​Santander-Jiménez et al….




Der Wechsel zu Online-Methoden beeinflusst die Genauigkeit kaum:


Kurse mit Peer-Assessment-Erfahrung zeigten keine signifikanten Leistungsänderungen durch die Online-Umstellung​Santander-Jiménez et al….




Single- und Double-Blind-Bewertungen führen zu besseren Ergebnissen als No-Blind-Verfahren:


Verzerrungen durch soziale Einflüsse (z. B. Freundschaftsbonus) treten bei offenen Bewertungen häufiger auf​Santander-Jiménez et al….




Längere Erfahrung mit Peer Assessment verbessert die Bewertungskompetenz der Studierenden:


Regelmäßige Beteiligung führt zu präziseren Einschätzungen und verbessertem kritischem Denken​Santander-Jiménez et al….





5. Argumentationslinien


Theoretischer Rahmen:


Peer Assessment als Werkzeug zur Förderung kritischen Denkens und aktiven Lernens​Santander-Jiménez et al….




Vergleichende Analyse:


Bewertung von Offline- und Online-Ansätzen zur Identifikation von Stärken und Schwächen​Santander-Jiménez et al….




Statistische Evidenz:


Verwendung von Korrelationstests zur Validierung der Bewertungsgenauigkeit​Santander-Jiménez et al….




Didaktische und technologische Empfehlungen:


Bedeutung einer benutzerfreundlichen Plattformgestaltung für Online-Peer Assessments​Santander-Jiménez et al….





6. Verschlagwortung


Bewertungsmethoden:


Untersuchung von Single-, Double- und No-Blind-Peer Assessment.




Lehr- und Lerneffektivität:


Verbesserung der kritischen Reflexion und Selbsteinschätzung durch Peer Assessment.




Technologieintegration:


Nutzung von Moodle® und cloudbasierten Plattformen für Online-Peer Assessment.




Systemanpassung:


Vergleich zwischen Offline- und Online-Umstellungen zur Identifikation von Optimierungspotenzialen.




Forschungsansätze:


Kombination qualitativer und quantitativer Methoden zur Evaluierung von Peer Assessments​Santander-Jiménez et al….





7. Kategorisierung
Kategorie: Argumentation


Die Studie begründet anhand von empirischen Daten die Vergleichbarkeit von Online- und Offline-Peer Assessments und identifiziert Bedingungen, unter denen Peer Assessment effektiv eingesetzt werden kann​Santander-Jiménez et al….



8. Zuordnung zur Forschungsfrage
Passendste Forschungsunterfrage:
FU2b: Welche Effekt-Faktoren erläutern Lehrende im digitalen Bildungsraum von Gesundheitsberufen bei der Anwendung eines systemisch-konstruktivistischen Learning-Management-Systems?


Begründung:


Die Studie analysiert Faktoren, die die Genauigkeit und Akzeptanz von Peer Assessment beeinflussen.


Es werden methodische und technische Herausforderungen bei der Implementierung von Peer Assessment untersucht.


Die Erkenntnisse sind auf digitale Bildungsräume übertragbar, insbesondere für kollaboratives Lernen und Bewertungssysteme​Santander-Jiménez et al….





9. Relevanzbewertung
4 – Relevant


Die Studie bietet wichtige Erkenntnisse zu Peer Assessment und dessen Anwendung in digitalen Lernumgebungen.


Sie untersucht nicht spezifisch Learning-Management-Systeme, liefert aber übertragbare Ergebnisse zur Bewertungspraxis in digitalen Bildungsräumen​Santander-Jiménez et al….



10. Schlussfolgerung
Die Studie von Santander-Jiménez et al. (2024) liefert eine detaillierte Analyse zur Umsetzung von Peer Assessment in Computer Engineering Kursen. Sie zeigt, dass Online-Peer Assessments genauso zuverlässig sein können wie traditionelle Methoden, sofern technische und didaktische Voraussetzungen erfüllt sind. Die Ergebnisse sind relevant für die Gestaltung digitaler Lernumgebungen und liefern wertvolle Erkenntnisse für die Entwicklung zukünftiger Bewertungsstrategien​Santander-Jiménez et al….
},
	file = {Radović et al. - 2023 - Analysing students' self‐assessment practice in a .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/MC8LL5QB/Radović et al. - 2023 - Analysing students' self‐assessment practice in a .pdf:application/pdf},
}

