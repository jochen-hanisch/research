  keywords = {0:Zeitschriftenartikel:digital:learning,Charité:Promotion,Kollaboratives Lernen,Lehr- und Lerneffektivität,Promotion:FU2a,Promotion:Literaturanalyse,Promotion:Relevanz:4,Promotion:Weiterführung,Technologieintegration},
