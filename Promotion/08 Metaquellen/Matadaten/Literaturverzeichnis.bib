	pages = {19--33},
	file = {Thompson und Ferraro - 2021 - Zur datengestützten Selbstoptimierung aus bildungs.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/AYCRXLSQ/Thompson und Ferraro - 2021 - Zur datengestützten Selbstoptimierung aus bildungs.pdf:application/pdf},
}

@article{bricker_mechanisms_2021,
	title = {Mechanisms of {Smartphone} {Apps} for {Cigarette} {Smoking} {Cessation}: {Results} of a {Serial} {Mediation} {Model} {From} the {iCanQuit} {Randomized} {Trial}},
	volume = {9},
	issn = {2291-5222},
	shorttitle = {Mechanisms of {Smartphone} {Apps} for {Cigarette} {Smoking} {Cessation}},
	url = {https://mhealth.jmir.org/2021/11/e32847},
	doi = {10.2196/32847},
	abstract = {Background: Engagement with digital interventions is a well-known predictor of treatment outcomes, but this knowledge has had limited actionable value. Instead, learning why engagement with digital interventions impact treatment outcomes can lead to targeted improvements in their efficacy.
Objective: This study aimed to test a serial mediation model of an Acceptance and Commitment Therapy (ACT) smartphone intervention for smoking cessation.
Methods: In this randomized controlled trial, participants (N=2415) from 50 US states were assigned to the ACT-based smartphone intervention (iCanQuit) or comparison smartphone intervention (QuitGuide). Their engagement with the apps (primary measure: number of logins) was measured during the first 3 months, ACT processes were measured at baseline and 3 months (acceptance of internal cues to smoke, valued living), and smoking cessation was measured at 12 months with 87\% follow-up retention.
Results: There was a significant serial mediation effect of iCanQuit on smoking cessation through multiple indicators of intervention engagement (ie, total number of logins, total number of minutes used, and total number of unique days of use) and in turn through increases in mean acceptance of internal cues to smoke from baseline to 3 months. Analyses of the acceptance subscales showed that the mediation was through acceptance of physical sensations and emotions, but not acceptance of thoughts. There was no evidence that the effect of the iCanQuit intervention was mediated through changes in valued living.
Conclusions: In this first study of serial mediators underlying the efficacy of smartphone apps for smoking cessation, our results suggest the effect of the iCanQuit ACT-based smartphone app on smoking cessation was mediated through multiple indicators of engagement and in turn through increases in the acceptance of physical sensations and emotions that cue smoking.},
	language = {en-GB},
	number = {11},
	urldate = {2021-11-12},
	journal = {JMIR mHealth and uHealth},
	author = {Bricker, Jonathan B and Levin, Michael and Lappalainen, Raimo and Mull, Kristin and Sullivan, Brianna and Santiago-Torres, Margarita},
	month = nov,
	year = {2021},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Technologieintegration, Bewertungsmethoden, Promotion:Argumentation, \#0:Zeitschriftenartikel:digital:learning, Promotion:Relevanz:3, Promotion:FU1, Promotion:S:12 Digital Learning, Promotion:Dissertation {\textbar} FU1 {\textgreater} Argumentation, Promotion:Literaturverzeichnis},
	pages = {e32847},
	annote = {Analyse des Artikels "Mechanisms of Smartphone Apps for Cigarette Smoking Cessation" von Bricker et al. (2021)
1. Analyse
Hauptthemen und -ziele der Forschung: Der Artikel untersucht die Mechanismen, durch die Smartphone-Apps das Aufhören mit dem Rauchen unterstützen, indem er einen mediationsanalytischen Ansatz verwendet. Das Hauptziel ist es, die Wirksamkeit der Akzeptanz- und Commitment-Therapie (ACT) basierten App "iCanQuit" im Vergleich zur US Clinical Practice Guidelines (USCPG) basierten App "QuitGuide" zu analysieren.
Verwendete Methoden und Datenquellen:


Methodische Ansätze: Randomisierte kontrollierte Studie (RCT) mit 2.415 Teilnehmern, die entweder der ACT-basierten Intervention "iCanQuit" oder der USCPG-basierten Intervention "QuitGuide" zugewiesen wurden.


Werkzeuge und Datenquellen: Nutzung von Smartphone-Apps zur Erhebung von Nutzungsdaten, Fragebögen zur Erfassung der Akzeptanz interner Rauchsymptome und des Wertes leben sowie statistische Analyse der Mediationspfade.


Zentrale Forschungsergebnisse:


Engagement als Mediator: Die Wirksamkeit der "iCanQuit" App auf die Raucherentwöhnung wurde durch das Engagement der Nutzer (z.B. Anzahl der Logins) und die Akzeptanz von Rauchsymptomen mediiert.


Keine Mediation durch Werte leben: Veränderungen im Wertesystem der Teilnehmer mediierten die Beziehung zwischen der Intervention und der Raucherentwöhnung nicht signifikant.


2. Zusammenfassung
Kernpunkte des Artikels:


Problemstellung: Untersuchung der Wirkmechanismen von Smartphone-Apps zur Raucherentwöhnung.


Methodik: Randomisierte kontrollierte Studie mit mediationsanalytischem Ansatz.


Hauptergebnisse: Engagement der Nutzer und Akzeptanz von Rauchsymptomen sind entscheidende Mediatoren der Wirksamkeit von "iCanQuit".


Schlussfolgerungen: Interventionen sollten sich auf die Förderung des Engagements und die Akzeptanz von Rauchsymptomen konzentrieren.


3. Kernaussagen


Engagement als Schlüssel: „Participants randomized to iCanQuit logged into their assigned app for a significantly greater number of times than those randomized to QuitGuide (25.7 vs 7.5 times; P{\textless}.001).“ (S. 5)


Akzeptanz von Symptomen: „For every 1-point increase from baseline to 3 months in acceptance of cues to smoke, there was a 6.07-fold higher odds of 12-month smoking cessation (OR 6.07, 95\% CI 4.76-7.76, P{\textless}.001).“ (S. 5)


Keine Mediation durch Werte leben: „There was no evidence that the effect of the iCanQuit intervention (vs QuitGuide) was mediated by changes in valued living.“ (S. 6)


4. Argumentationslinien


Mechanismen der ACT: Der Artikel argumentiert, dass die Akzeptanz von Rauchsymptomen und das Engagement mit der App zentrale Mechanismen der ACT sind, die zur Raucherentwöhnung führen.


Bedeutung des Engagements: Es wird betont, dass ein höheres Engagement der Nutzer die Wirksamkeit der Intervention verbessert, was auf eine stärkere Nutzung der therapeutischen Inhalte zurückzuführen ist.


Begrenzte Rolle der Werte: Die Ergebnisse deuten darauf hin, dass die Veränderung der persönlichen Werte der Teilnehmer keine signifikante Rolle bei der Mediation der Interventionseffekte spielt.


5. Verschlagwortung


Lehr- und Lerneffektivität:


Begründung: Der Artikel untersucht die Effektivität der digitalen Interventionen durch die Mediationsanalyse von Engagement und Akzeptanz.


Fundstelle: S. 6




Bewertungsmethoden:


Begründung: Die Nutzung von Mediationsmodellen zur Bewertung der Wirksamkeit von Raucherentwöhnungs-Apps zeigt die Relevanz zuverlässiger Bewertungsmethoden.


Fundstelle: S. 5




Technologieintegration:


Begründung: Der Artikel behandelt die Integration von Smartphone-Apps in die Verhaltensänderungstherapie und deren Effektivität.


Fundstelle: S. 3




6. Kategorisierung


Kategorie: Argumentation


Kriterium: Nutzung von Quellen oder Theorien zur Unterstützung oder Widerlegung einer These oder Fragestellung.


Beispiel: Der Artikel stützt sich auf die Akzeptanz- und Commitment-Therapie (ACT) und empirische Daten, um die Wirksamkeit von Smartphone-Apps zur Raucherentwöhnung zu erklären.




7. Zuordnung zu Forschungsfragen


FU1: Welche Akzeptanz und Nützlichkeit (Bedeutung) beschreiben Akteure im digitalen Bildungsraum von Gesundheitsberufen bei Anwendung eines Learning-Management-Systems?


Begründung: Der Artikel untersucht die Akzeptanz und das Engagement der Nutzer von digitalen Gesundheitsinterventionen, was Parallelen zur Akzeptanz und Nutzung von LMS im Bildungsbereich aufweist.


Fundstelle: S. 4




8. Relevanzbewertung


Direkte Relevanz für die Forschungsfrage: 4/5


Der Artikel bietet relevante Erkenntnisse zur Akzeptanz und Nutzung digitaler Interventionen, was auf ähnliche Mechanismen in LMS übertragen werden kann.




Zitierhäufigkeit und Einfluss des Artikels: 3/5


Der Artikel ist methodisch fundiert und trägt zu einem wichtigen Bereich der Gesundheitsinterventionen bei.




Aktualität des Artikels: 3/5


Veröffentlicht im Jahr 2021, bietet der Artikel relativ aktuelle Perspektiven auf digitale Interventionen.




Gesamtbewertung: 3/5 (abgerundet)
Diese Analyse zeigt, dass der Artikel wichtige Einblicke in die Mechanismen der Nutzung und Akzeptanz digitaler Gesundheitsinterventionen bietet, die für die Untersuchung der Akzeptanz und Nützlichkeit von LMS im digitalen Bildungsraum relevant sind.
},
	file = {Bricker et al. - 2021 - Mechanisms of Smartphone Apps for Cigarette Smokin.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/CCQNWCLN/Bricker et al. - 2021 - Mechanisms of Smartphone Apps for Cigarette Smokin.pdf:application/pdf},
}

@article{gerthofer_fallkonstellationen_2021,
	title = {Fallkonstellationen zum {Einsatz} digitaler {Medien} im {Unterricht}: {Eine} qualitative, lehrendenzentrierte {Betrachtung}},
	issn = {1424-3636, 1424-3636},
	shorttitle = {Fallkonstellationen zum {Einsatz} digitaler {Medien} im {Unterricht}},
	url = {10.21240/mpaed/jb16/2021.04.29.X},
	doi = {10/gksnxr},
	abstract = {This contribution is based on the idea that the dominance of digital media in pupils‘ everyday life is not sufficiently reflected in educational institutions in Germany. It is investigated which patterns of personal causes and factors of teachers lead to (neglecting) the use of digital media in class. To answer the central question an adapted form of the «Unified theory of acceptance and use of technology» (UTAUT) is used as a framework. The UTAUT is widely used in educational contexts and empirically reviewed. Six influencing aspects are identified: The additional value for teachers when using digital media in class, the estimated effort for integrating digital media in lessons, the self-conviction and certitude of using media in class, the attitude of teachers concerning digital media and social influence. A qualitative content analysis of eleven interviews with teachers teaching at secondary schools was conducted. The insights gained from the interviews were traced back to the UTAUT model. The resulting pattern of personal factors influencing the use of media in class was described in a casestudy like setup and the usage of digital media in class illustrated. The qualitative design allows a better understanding in which constellations teachers use media in class.},
	language = {de-DE},
	urldate = {2021-06-20},
	journal = {MedienPädagogik: Zeitschrift für Theorie und Praxis der Medienbildung},
	author = {Gerthofer, Lukas and Schneider, Jennifer},
	month = apr,
	year = {2021},
	note = {ZSCC: 0000001},
	keywords = {Promotion:Literaturanalyse, Lehr- und Lerneffektivität, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, \#7:Zeitschriftenartikel:digital:Medien, Bildung, Multimedia, Krisenreaktion im Bildungsbereich, Promotion:FU3, FernUni-Hagen:MABM:M6, UTAUT-Modell, Promotion:S:07 Digitale Medien, Promotion:2.4 Exkurs: Technologiedefizit, Promotion:Literaturverzeichnis},
	pages = {281--315},
	file = {Gerthofer und Schneider - 2021 - Fallkonstellationen zum Einsatz digitaler Medien i.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/EBPL8AEZ/Gerthofer und Schneider - 2021 - Fallkonstellationen zum Einsatz digitaler Medien i.pdf:application/pdf},
}

