@incollection{kurosu_incorporating_2023,
	address = {Cham},
	title = {Incorporating {Eye} {Tracking} into an {EEG}-{Based} {Brainwave} {Visualization} {System}},
	volume = {14011},
	isbn = {978-3-031-35595-0 978-3-031-35596-7},
	url = {https://link.springer.com/10.1007/978-3-031-35596-7_25},
	doi = {10.1007/978-3-031-35596-7_25},
	abstract = {This article describes the incorporation of eye tracking into a brainwaves visualization and analysis system, based on electroencephalography (EEG), to map attention during fruition of audiovisual content. The visualization system was developed in Python, using an Emotiv Insight headset. During the tests, there was a need to identify whether the reactions mapped by the EEG were in fact related to the fruition of the content or whether they originated from elements external to the screen, with the individual looking away and, consequently, losing attention. Based on the Design Science Research methodology, eye tracking was incorporated into the system architecture. For validation, tests were performed with 10 users. Analyzing the generated data, it was possible to identify the correlation between the information presented by the EEG and the gaze of the individuals. In this way, it is possible to increase conﬁdence about the origin of user’s emotions during the fruition of audiovisual content.},
	language = {en-US},
	urldate = {2023-09-22},
	booktitle = {Human-{Computer} {Interaction}},
	publisher = {Springer Nature Switzerland},
	author = {Cavalcanti, Matheus and Melo, Felipe and Silva, Thiago and Falcão, Matheus and De Queiroz Cavalcanti, Daniel and Becker, Valdecir},
	editor = {Kurosu, Masaaki and Hashizume, Ayako},
	year = {2023},
	note = {Series Title: Lecture Notes in Computer Science},
	keywords = {Promotion:Literaturanalyse, Promotion:01-02, Promotion:Eye-Tracking, Promotion:01-02 Methodenquellen, Promotion:Literaturverzeichnis},
	pages = {392--403},
	file = {Cavalcanti et al. - 2023 - Incorporating Eye Tracking into an EEG-Based Brain.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/2QFFDQDB/Cavalcanti et al. - 2023 - Incorporating Eye Tracking into an EEG-Based Brain.pdf:application/pdf},
