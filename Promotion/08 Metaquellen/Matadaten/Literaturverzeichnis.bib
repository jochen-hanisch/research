@article{schmolz_conditio_2020,
	title = {Die {Conditio} {Humana} im digitalen {Zeitalter}: {Zur} {Grundlegung} des {Digitalen} {Humanismus} und des {Wiener} {Manifests}},
	issn = {1424-3636, 1424-3636},
	shorttitle = {Die {Conditio} {Humana} im digitalen {Zeitalter}},
	url = {10.21240/mpaed/00/2020.11.13.X},
	doi = {10/gksnxv},
	abstract = {In den bestehenden Debatten und dem Wiener Manifest des digitalen Humanismus bleibt trotz der klaren und zukunftsweisenden Normativität vielfach offen, in welcher Denkrichtung der digitale Humanismus verortet ist und ob sich hinter diesem Begriff eine ein Paradigma und eine bestimmte Lehre vom Menschen verbirgt? Daraus folgen gegebenenfalls divergierende Grundorientierungen zum digitalen Humanismus und es ist offen, ob ein gemeinsames Narrativ des digitalen Humanismus notwendig ist oder gerade die Pluralität einen postmodernen digitalen Humanismus konstituiert? Diesen Fragen geht der hier vorgelegte Artikel nach, versucht eine Zuwendung zu zentralen Studien zum Humanismus und sucht damit eine Grundlegung und Verortung des digitalen Humanismus und dessen Wiener Manifest zu schaffen. Dazu werden in einem ersten Schritt die inneren Grundlagen des Humanismus dargelegt. Die grundlegende Frage nach der Conditio Humana und die grundlegende Methodologie des Humanismus werden in Abgrenzung zu anti-humanistischen Strömungen herausgearbeitet. In einem zweiten Schritt werden bestehende Grundlagen des digitalen Humanismus benannt. Zentrales Ergebnis ist, dass die Erfindung der Conditio Humana als rationales Denken und logisches Operieren zur Entmythologisierung der Natur eine Errungenschaft der Aufklärung war. Die Conditio Humana im digitalen Humanismus jedoch in Relation zur Maschine verändert wird, denn das Rationale am Denken und das logische Operieren wird der Maschine zugeschrieben. Kreativität und individuelles Sprechvermögen im digitalen Raum sind zwei neue Conditio Humana im digitalen Humanismus. Der postmoderne Mensch wird damit von der berechenbaren Rationalität entlastet ohne in die Mythologie zurückzufallen. Im Fazit werden Konsequenzen der Neuerfindung der Conditio Humana angedeutet und zentrale Problem- und Fragestellungen für eine wünschenswerte Zukunft des digitalen Humanismus identifiziert.},
	language = {de-DE},
	urldate = {2021-06-20},
	journal = {MedienPädagogik: Zeitschrift für Theorie und Praxis der Medienbildung},
	author = {Schmölz, Alexander},
	month = nov,
	year = {2020},
	note = {ZSCC: 0000000},
	keywords = {Promotion:Literaturanalyse, \#7:Zeitschriftenartikel:digital:Medien, Promotion:S:07 Digitale Medien, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {208--234},
	file = {Schmölz - 2020 - Die Conditio Humana im digitalen Zeitalter Zur Gr.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/5XM8KEBK/Schmölz - 2020 - Die Conditio Humana im digitalen Zeitalter Zur Gr.pdf:application/pdf},
}

@article{sauerbrey_mediale_2021,
	title = {Mediale {Optimierung} der {Kindheit}?: {An} {Kinder} adressierte {Ratgebermedien} im {Spiegel} einer explorativen {Inhaltsanalyse}},
	volume = {42},
	issn = {1424-3636, 1424-3636},
	shorttitle = {Mediale {Optimierung} der {Kindheit}?},
	url = {10.21240/mpaed/42/2021.05.09.X},
	doi = {10/gksnx4},
	abstract = {Neben Ratgebern für Eltern und Lehrpersonen existieren ebenso Ratgebermedien, die sich an Kinder richten und die diesen zu verschiedenen Themen Ratschläge bezüglich einer Verhaltungsoptimierung darbieten. Da hierzu bislang kaum Forschungsliteratur existiert, stellt der Beitrag eine Untersuchung vor, in der an Kinder in der mittleren Kindheit adressierte mediale Ratgeberangebote auf dem Buchmarkt und im Internet erhoben und mit Blick auf die angebotenen Themen inhaltsanalytisch ausgewertet wurden. Diese zeigen sich heterogen: Auf dem Buchmarkt wird vor allem Rat zu den Themen Aufklärung/Sexualität, Selbstbewusstsein/Selbstbestimmung, Soziales Verhalten/Streit/Konfliktlösung sowie Umwelt/Nachhaltigkeit gegeben. Im Internet hingegen finden sich zum Teil Themen, die auf dem Buchmarkt nicht vorkommen. Von den entsprechenden Themenüberblicken ausgehend wird anhand eines dokumentenanalytisch ausgewerteten Samples zudem eine erste Charakteristik der kommunikativen Elemente medialer Kinderratgeber herausgearbeitet. Hierbei zeigen sich Blogs im Vergleich zu Büchern überraschenderweise weniger vielfältig. Allerdings ist zu vermuten, dass sich digitale Ratgeberangebote in Bezug auf die gewählten Themen näher an der medialen Lebensrealität von Kindern in Deutschland bewegen. Basierend auf diesen ersten Ergebnissen werden Strategien für die künftige Erforschung von Ratgebermedien für Kinder auf der Angebotsseite vorgeschlagen.},
	language = {de-DE},
	urldate = {2021-06-20},
	journal = {MedienPädagogik: Zeitschrift für Theorie und Praxis der Medienbildung},
	author = {Sauerbrey, Ulf and Schick, Claudia},
	month = may,
	year = {2021},
	note = {ZSCC: 0000000},
	keywords = {Promotion:Literaturanalyse, \#7:Zeitschriftenartikel:digital:Medien, Promotion:S:07 Digitale Medien, Promotion:Literaturverzeichnis},
	pages = {199--216},
	file = {Sauerbrey und Schick - 2021 - Mediale Optimierung der Kindheit An Kinder adres.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/67N5T9BQ/Sauerbrey und Schick - 2021 - Mediale Optimierung der Kindheit An Kinder adres.pdf:application/pdf},
}

@article{grunberger_postkolonial_2021,
	title = {Postkolonial post-digital: {Forschungsfelder} und {Anschlussstellen} für die {Medienpädagogik} durch eine postkoloniale {Perspektive} auf eine {Post}-{Digitalität}},
	issn = {1424-3636, 1424-3636},
	shorttitle = {Postkolonial post-digital},
	url = {10.21240/mpaed/jb16/2021.02.25},
	doi = {10/gksnx8},
	abstract = {Talking about digitization, mediatization, medialization or post-/digitality we are limited in a perspective of the Global North, mostly dealing with the implementation of (digital) media in educational institutions. Educators, educational researchers as well as politicians are often requiring more technological features, better technical conditions and the taxonomisation of digital skills for countries in the Global North. But this perspective inhibits us to consider a wide-ranging term of digitality which includes e.g. environmental implications of an ubiquitous use of digital media or taxonomies of digital competences for the Global South. To that extant an postcolonial and media archaeological approach is proposed to think digitality consequently wide and far-reaching. This opens up responsibilities and tasks for media-pedagogy in research, as well as for the development of concepts and educational practices.},
	language = {de-DE},
	urldate = {2021-06-20},
	journal = {MedienPädagogik: Zeitschrift für Theorie und Praxis der Medienbildung},
	author = {Grünberger, Nina},
	month = feb,
	year = {2021},
	note = {ZSCC: 0000001},
	keywords = {Promotion:Literaturanalyse, \#7:Zeitschriftenartikel:digital:Medien, Promotion:S:07 Digitale Medien, Promotion:Literaturverzeichnis},
	pages = {211--229},
	annote = {Analyse: Postkolonial post-digital: Forschungsfelder und Anschlussstellen für die Medienpädagogik durch eine postkoloniale Perspektive auf eine Post-Digitalität von Grünberger\# Analyse: *Postkolonial post-digital: Forschungsfelder und Anschlussstellen für die Medienpädagogik durch eine postkoloniale Perspektive auf eine Post-Digitalität* von Grünberger

\#\# 1. Hauptthemen und Ziele der Forschung
Der Artikel untersucht, wie eine postkoloniale Perspektive auf die Post-Digitalität eine Erweiterung der Medienpädagogik ermöglichen kann. Im Zentrum steht die Kritik an der vorherrschenden Perspektive des Globalen Nordens auf die Digitalisierung im Bildungswesen, die oft Umweltaspekte und die Bedürfnisse des Globalen Südens vernachlässigt. Die Forschung zielt darauf ab, Medienpädagogik durch eine breite und inklusive Betrachtung der Digitalität zu bereichern.

\#\# 2. Methoden und Datenquellen
Der Artikel scheint konzeptionell-theoretischer Natur zu sein, wobei eine postkoloniale und medienarchäologische Herangehensweise zur Diskussion und Analyse des Themas genutzt wird. Konkrete empirische Methoden oder Datenerhebungen werden nicht angegeben.

\#\# 3. Zentrale Forschungsergebnisse
Die zentrale Erkenntnis ist, dass ein rein auf den Globalen Norden ausgerichteter Fokus nicht ausreicht, um die vielfältigen Aspekte der Digitalität zu erfassen. Die Einführung eines postkolonialen Ansatzes ermöglicht es, eine umfassendere Sichtweise zu entwickeln, die unter anderem ökologische Auswirkungen und die spezifischen digitalen Kompetenzen des Globalen Südens einbezieht.

\#\# 4. Zusammenfassung des Artikels
- **Problemstellung**: Die vorherrschende Perspektive der Digitalisierung im Bildungssektor ist auf den Globalen Norden beschränkt und vernachlässigt tiefere und breitere Implikationen der Digitalität.
 - Methodik: Theoretische Analyse unter Anwendung postkolonialer und medienarchäologischer Ansätze.
 - Hauptergebnisse: Eine breitere Berücksichtigung der digitalen Implikationen fördert die Medienpädagogik, indem sie ökologische und globale Kompetenzperspektiven einbezieht.
 - Schlussfolgerungen: Medienpädagogik muss ihren Fokus erweitern, um die Verantwortung für globale und ökologische Aspekte der Digitalität zu übernehmen.
- **Methodik**: Theoretische Analyse unter Anwendung postkolonialer und medienarchäologischer Ansätze.
 - Hauptergebnisse: Eine breitere Berücksichtigung der digitalen Implikationen fördert die Medienpädagogik, indem sie ökologische und globale Kompetenzperspektiven einbezieht.
 - Schlussfolgerungen: Medienpädagogik muss ihren Fokus erweitern, um die Verantwortung für globale und ökologische Aspekte der Digitalität zu übernehmen.
- **Hauptergebnisse**: Eine breitere Berücksichtigung der digitalen Implikationen fördert die Medienpädagogik, indem sie ökologische und globale Kompetenzperspektiven einbezieht.
 - Schlussfolgerungen: Medienpädagogik muss ihren Fokus erweitern, um die Verantwortung für globale und ökologische Aspekte der Digitalität zu übernehmen.
- **Schlussfolgerungen**: Medienpädagogik muss ihren Fokus erweitern, um die Verantwortung für globale und ökologische Aspekte der Digitalität zu übernehmen.

\#\# 5. Wichtige Aussagen und Befunde
Der Artikel argumentiert, dass eine postkoloniale Betrachtungsweise wichtig ist, um die Einschränkungen der aktuellen Perspektiven auf die Digitalität aufzudecken und zu überwinden.

\#\# 6. Logische Struktur und Argumentation
Der Artikel folgt einer klaren Argumentationsstruktur, die mit der Kritik an der aktuellen Sichtweise beginnt und dann mögliche Erweiterungen durch den postkolonialen Ansatz beschreibt. Dies wird durch konzeptionell-theoretische Überlegungen gestützt.

\#\# 7. Relevante Schlagwörter
- Post-Digitalität: Verdeutlicht den Kontext der digitalen Transformationen.
 - Postkolonial: Kern der vorgeschlagenen Perspektivenerweiterung.
 - Medienpädagogik: Hauptbereich, der durch die neuen Perspektiven beeinflusst wird.
 - Globaler Norden/Süden: Zentral für die Diskussion um unterschiedliche Perspektiven auf Digitalität.

\#\# 8. Kategorie
Theorie- und Konzeptentwicklung, da der Artikel konzeptionelle Ansätze zur Erweiterung der Medienpädagogik durch postkoloniale Perspektiven diskutiert.

\#\# 9. Zugeordnete Forschungsfrage
Wie kann eine postkoloniale Perspektive die Medienpädagogik hinsichtlich ihrer Ansichten auf Digitalität erweitern und bereichern? Die Forschungsfrage ergibt sich aus dem Bemühen, existierende betriebswirtschaftliche Grenzen zu überwinden und eine inklusivere Perspektive zu entwickeln.

\#\# 10. Relevanz für die Forschungsfrage
Keine Informationen verfügbar
},
	file = {Grünberger - 2021 - Postkolonial post-digital Forschungsfelder und An.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/N8X65LHA/Grünberger - 2021 - Postkolonial post-digital Forschungsfelder und An.pdf:application/pdf},
}

@article{philipp_leseforderung_2020,
	title = {Leseförderung 4.0?: {Gibt} es {Unterschiede} in den {Merkmalen} effektiver {Lesefördermassnahmen} mit multiplen {Dokumenten}, wenn digitale {Medien} genutzt werden?},
	issn = {1424-3636, 1424-3636},
	shorttitle = {Leseförderung 4.0?},
	url = {10.21240/mpaed/jb17/2020.04.29.X},
	doi = {10/gksnzn},
	abstract = {Reading becomes increasingly a digital activity, which additionally is based on multiple, partly multimodal documents. An appropriate reading instruction must take these current changes into account, since digital reading gives rise to new challenges for readers. This is the reason for this quantitative reanalysis of 24 intervention studies, which were selected after a thorough application of criteria. Almost half of the studies used digital media, while the other half did not. The guiding research question was, whether there were any differences between these groups regarding a) informational processes, b) general instructional features and c) document types being used. For this purpose, 46 variables were coded and compared. The number of statistically significant differences was modest (six instances) and only evident within strategy instruction with human instructors and collaborators on the one side and the quantity and partly the quality of documents on the other side.},
	language = {de-DE},
	urldate = {2021-06-20},
	journal = {MedienPädagogik: Zeitschrift für Theorie und Praxis der Medienbildung},
	author = {Philipp, Maik},
	month = apr,
	year = {2020},
	note = {ZSCC: 0000002},
	keywords = {Promotion:Literaturanalyse, \#7:Zeitschriftenartikel:digital:Medien, Promotion:S:07 Digitale Medien, Promotion:02-01\_Q3, Promotion:02-01\_Q2, Promotion:Literaturverzeichnis},
	pages = {141--168},
	annote = {Analyse: Leseförderung 4.0?: Gibt es Unterschiede in den Merkmalen effektiver Lesefördermassnahmen mit multiplen Dokumenten, wenn digitale Medien genutzt werden? von Philipp\# Analyse: *Leseförderung 4.0?: Gibt es Unterschiede in den Merkmalen effektiver Lesefördermassnahmen mit multiplen Dokumenten, wenn digitale Medien genutzt werden?* von Philipp

\#\# 1. Hauptthemen und Ziele der Forschung
- Das Hauptthema der Forschung ist die Untersuchung von Unterschieden in den Merkmalen effektiver Leseförderungsmaßnahmen beim Umgang mit multiplen Dokumenten, insbesondere hinsichtlich des Einsatzes digitaler Medien. Die Ziele umfassen die Analyse von Unterschieden in Informationsprozessen, allgemeinen didaktischen Merkmalen und den verwendeten Dokumenttypen bei digitalen und nicht-digitalen Leseförderungen.

\#\# 2. Methoden und Datenquellen
- Die Studie ist eine quantitative Reanalyse von 24 Interventionsstudien, die aufgrund strenger Kriterien ausgewählt wurden. Fast die Hälfte der Studien verwendeten digitale Medien, während die andere Hälfte dies nicht tat. Es wurden 46 Variablen codiert und miteinander verglichen, um Unterschiede festzustellen.

\#\# 3. Zentrale Forschungsergebnisse
- Die Untersuchung ergab nur eine geringe Anzahl statistisch signifikanter Unterschiede (sechs Fälle). Diese Unterschiede waren hauptsächlich in der Strategieanweisung mit menschlichen Lehrern und Mitwirkenden sowie in der Menge und teilweise der Qualität der Dokumente zu finden.

\#\# 4. Zusammenfassung des Artikels
- **Problemstellung**: Mit der Zunahme des digitalen Lesens und der Verwendung multipler, multimodaler Dokumente stellt sich die Frage nach der Effektivität der Leseförderung unter Einsatz digitaler Medien.
 - Methodik: Quantitative Reanalyse von 24 Interventionsstudien, Vergleiche von 46 codierten Variablen zwischen Studien mit und ohne digitale Medien.
 - Hauptergebnisse: Nur wenige signifikante Unterschiede, hauptsächlich im Bereich der Strategieanweisung und der Qualität und Quantität der Dokumente.
 - Schlussfolgerungen: Digitale Medien beeinflussen die Leseförderung nicht signifikant auf breiter Basis, Unterschiede zeigen sich vor allem bei bestimmten didaktischen Ansätzen und Dokumenteneigenschaften.
- **Methodik**: Quantitative Reanalyse von 24 Interventionsstudien, Vergleiche von 46 codierten Variablen zwischen Studien mit und ohne digitale Medien.
 - Hauptergebnisse: Nur wenige signifikante Unterschiede, hauptsächlich im Bereich der Strategieanweisung und der Qualität und Quantität der Dokumente.
 - Schlussfolgerungen: Digitale Medien beeinflussen die Leseförderung nicht signifikant auf breiter Basis, Unterschiede zeigen sich vor allem bei bestimmten didaktischen Ansätzen und Dokumenteneigenschaften.
- **Hauptergebnisse**: Nur wenige signifikante Unterschiede, hauptsächlich im Bereich der Strategieanweisung und der Qualität und Quantität der Dokumente.
 - Schlussfolgerungen: Digitale Medien beeinflussen die Leseförderung nicht signifikant auf breiter Basis, Unterschiede zeigen sich vor allem bei bestimmten didaktischen Ansätzen und Dokumenteneigenschaften.
- **Schlussfolgerungen**: Digitale Medien beeinflussen die Leseförderung nicht signifikant auf breiter Basis, Unterschiede zeigen sich vor allem bei bestimmten didaktischen Ansätzen und Dokumenteneigenschaften.

\#\# 5. Wichtige Aussagen und Befunde
- Digitale Medien verändern nicht grundlegend die Effektivität der Leseförderung, es gibt jedoch spezifische Bereiche, in denen Unterschiede bemerkbar sind, wie etwa bei der Qualität und Anzahl der verwendeten Dokumente.

\#\# 6. Logische Struktur und Argumentation
- Der Artikel ist klar strukturiert und methodisch fundiert. Die Argumentation basiert auf einer soliden Datenbasis aus mehreren Interventionsstudien, die systematisch analysiert wurden.

\#\# 7. Relevante Schlagwörter
- Digitale Medien, Leseförderung, Multiple Dokumente, Interventionsstudien, Strategieanweisung, Quantitative Analyse
