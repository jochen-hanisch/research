@article{vagt_virtuelle_2024,
	title = {Virtuelle {Affekte} – ein quantitativer {Vergleich} der erlebten {Affekte} von {Teilnehmenden} in digitalen und analogen {Trainingsgruppen}},
	issn = {2366-6145, 2366-6218},
	url = {https://link.springer.com/10.1007/s11612-024-00780-2},
	doi = {10.1007/s11612-024-00780-2},
	abstract = {The following article in the journal Gruppe. Interaktion. Organisation. (GIO) answers the question, if affects differ between training group participants in digital and analogue training groups. To this end, positive and negative affects in digital and analogue training groups were collected, evaluated and compared using the PANASg (Lackner 2018). The research hypothesis that affects in analogue and digital training groups differ signiﬁcantly can be conﬁrmed, but only for negative affects. Based on these results, the possibilities and limitations of digital learning formats are discussed.},
	language = {de-DE},
	urldate = {2024-11-12},
	journal = {Gruppe. Interaktion. Organisation. Zeitschrift für Angewandte Organisationspsychologie (GIO)},
	author = {Vagt, Anika and Kreter, Tim},
	month = nov,
	year = {2024},
	keywords = {Promotion:Literaturanalyse, Kollaboratives Lernen, Promotion:FU4a, Promotion:Kerngedanke, Promotion:Relevanz:5, Technologieintegration, \#0:Zeitschriftenartikel:digital:learning, ehr- und Lerneffektivität, Promotion:S:12 Digital Learning, Promotion:Literaturverzeichnis, Promotion:sec:A-9-FU4a},
	annote = {Hier ist die strukturierte Analyse und Zusammenfassung des Artikels „Virtuelle Affekte – ein quantitativer Vergleich der erlebten Affekte von Teilnehmenden in digitalen und analogen Trainingsgruppen“ von Vagt und Kreter (2024):

Analyse
1. Hauptthemen und Ziele der Forschung


Hauptthemen:


Analyse der Unterschiede in den erlebten Affekten zwischen digitalen und analogen Trainingsgruppen (T-Gruppen).


Bedeutung negativer Affekte als Motor für Gruppenentwicklung.




Ziele:


Quantitative Untersuchung affektiver Erlebnisse in virtuellen T-Gruppen.


Überprüfung, ob negative Affekte in virtuellen Gruppen weniger intensiv erlebt werden und welche Auswirkungen dies auf die Gruppenentwicklung hat.




2. Methoden und Datenquellen


Methoden:


Vergleichsstudie mit Messungen in digitalen und analogen T-Gruppen.


Einsatz des PANASg-Instruments zur Erhebung positiver und negativer Affekte sowie spezifischer Gruppenaffekte.


Datenanalyse mittels t-Test und deskriptiver Statistik.




Datenquellen:


Virtuelle Gruppen: 14 Teilnehmende in zwei Gruppen.


Analoge Gruppen: 73 Teilnehmende in sechs Gruppen.




3. Zentrale Forschungsergebnisse


Unterschiede in negativen Affekten:


Virtuelle Gruppen zeigen signifikant weniger intensive negative Affekte (M = 1.48) im Vergleich zu analogen Gruppen (M = 1.82, p {\textless} 0.001).


Keine signifikanten Unterschiede bei positiven Affekten und Gruppenaffekten.




Gruppenentwicklung:


Negativ-affektive Erlebnisse in analogen Gruppen förderten Konfliktbearbeitung und Entwicklung stärker als in virtuellen Gruppen.




Virtuelle Vorteile:


Geringere negative Affekte können die Arbeitsfähigkeit in sachorientierten Kontexten unterstützen.





Zusammenfassung
Die Studie untersucht affektive Erlebnisse in analogen und virtuellen Trainingsgruppen und zeigt, dass negative Affekte in virtuellen T-Gruppen weniger intensiv wahrgenommen werden. Während analoge Gruppen von intensiven negativen Affekten und deren Konfliktbearbeitung profitieren, bieten virtuelle Gruppen eine ruhigere Atmosphäre, die in sachorientierten Kontexten vorteilhaft sein kann. Für die Gruppenentwicklung in virtuellen Formaten könnten spezifische Interventionen erforderlich sein, um die Rolle negativer Affekte zu simulieren.

Kernaussagen


Weniger negative Affekte in virtuellen Gruppen: Negative Affekte sind weniger intensiv, was Konfliktbearbeitungsprozesse schwächt (S. 4-5).


Potenziale für sachorientierte Kontexte: Weniger negative Affekte fördern die Arbeitsfähigkeit in zeitlich begrenzten Projekten (S. 6-7).


Herausforderungen für Gruppenentwicklung: Fehlen intensiver negativer Affekte kann Gruppenentwicklung in virtuellen T-Gruppen behindern (S. 9-10).



Argumentationslinien


Hauptthese: Negative Affekte sind ein zentraler Motor für Gruppenentwicklung in analogen Formaten, fehlen jedoch in virtuellen Gruppen.


Unterstützende Evidenz: Signifikante Unterschiede in der Intensität negativer Affekte zwischen analogen und virtuellen Gruppen (S. 8-9).


Implikationen: Virtuelle T-Gruppen erfordern angepasste didaktische Interventionen, um vergleichbare Entwicklungsprozesse zu ermöglichen (S. 10-11).



