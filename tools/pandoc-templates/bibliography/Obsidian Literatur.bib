	keywords = {Multimedia, Lehr- und Lerneffektivität, Technologieintegration, Forschungsansätze, Systemanpassung, Promotion:{FU}4b, Promotion:Argumentation, \#5:Zeitschriftenartikel:e-learning, Promotion:Literaturanalyse, Charité:Promotion},
	file = {Platen et al. - 2003 - Neue Medien in der Bildung – Neue Chancen in der S.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/E3DTLZXE/Platen et al. - 2003 - Neue Medien in der Bildung – Neue Chancen in der S.pdf:application/pdf},
