	langid = {german},
	note = {Publisher: Zeitschrift Hochschule und Weiterbildung ({ZHWB})},
	keywords = {Lehr- und Lerneffektivität, Krisenreaktion im Bildungsbereich, Promotion:{FU}3, Promotion:Kerngedanke, \#9:Zeitschriftenartikel:digital:lernen, Promotion:Literaturanalyse, Charité:Promotion},
