@article{kruppke_kompetenzatelier_2022,
	title = {Das Kompetenzatelier als agiles Lehrformat: Biomechanik-Projektarbeit bis zum Prototyp},
	volume = {2},
	issn = {2749-1307, 2749-1293},
	url = {https://journals.qucosa.de/ll/article/view/56},
	doi = {10/grq6bj},
	shorttitle = {Das Kompetenzatelier als agiles Lehrformat},
	abstract = {Um den Campus im Zeitalter von digitalen und hybriden Lehrveranstaltungen wieder attraktiv zu machen, wird ein agiles Lehrformat vorgestellt, das die kooperative Problembewältigung durch projektbasiertes Lernen und agiles Projektmanagement ins Zentrum stellt. Hierzu werden zunächst allgemein die Elemente agilen Projektmanagements vorgestellt und anschließend die Übertragung auf den Lehrkontext erläutert. Zur weiteren Verdeutlichung des Ablaufs und des Zusammenspiels der Gruppenmitglieder wird am konkreten Beispiel des Moduls Kompetenzatelier: Biomechanik agil mit Scrum die Durchführung beschrieben und das schrittweise Erstellen eines Demonstrators durch die Studierenden gezeigt. Abschließend wird die Evaluation des Kompetenzateliers zur Identifizierung von allgemeinen Stärken und Schwächen genutzt. Dabei wird besonders auf die agile Reaktion der Studierenden auf geplante und ungeplante „Störelemente“ eingegangen. Das Kompetenzatelier bietet für Lehrende kleiner Studiengänge und Gruppen eine Anregung zur innovativen und kreativen Auseinandersetzung mit einem agilen Projektmanagement und fördert die Selbstmotivation zum Lernen durch eine unmittelbare praktische Anwendung.},
	number = {2},
	journaltitle = {Lessons Learned},
	shortjournal = {{LL}},
	author = {Kruppke, Benjamin and Apelt, Sabine and Hartwig, Carl Eric and Koch, Adrian and Mai, Julian and Schumann, Anna Lorena and Ulbricht, Tim Johannes and Ullmann, Moritz and Wiesmann, Hans-Peter},
	urldate = {2023-02-07},
	date = {2022-12-28},
	langid = {german},
	keywords = {Agilität, Lehr- und Lerneffektivität, Kollaboratives Lernen, Projektmanagement, Promotion:{FU}4b, Promotion:Kerngedanke, \#9:Zeitschriftenartikel:digital:lernen, Promotion:Literaturanalyse, Charité:Promotion},
