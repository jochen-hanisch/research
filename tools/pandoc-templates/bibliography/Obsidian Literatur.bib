	keywords = {Kompetenz, Lehrerbildung, Teachers' training, Hochschule, Virtual learning, {COVID}-19, Digitalisierung, Digitalization, Pandemie, Methode, Partizipation, Media competence, Media skills, Further education, Weiterbildung, Bildung, Digitale Bildung, Further education for teachers, Further training for teachers, Lehrerfortbildung, Qualität, Quality, Älterer Erwachsener, Bildungsbiografie, Correspondence studies, Correspondence university, Distance study, Fernunterricht, Hochschulbildung, Interactive learning, Kollaboration, Learning by playing, Lernangebot, Öffentliche Verwaltung, Older Adults, Online service, Online-Angebot, School career, Teaching method, Virtuelle Hochschule, Berufliche Bildung, \#0:Zeitschriftenartikel:digital:learning, Promotion:Literaturanalyse, Charité:Promotion, Promotion:Literaturanalyse:Berichte},
