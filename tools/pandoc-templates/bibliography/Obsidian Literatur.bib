@article{bossle_wissensorganisation_2017,
	title = {Wissensorganisation},
	volume = {12},
	abstract = {Wissensorganisation – eine Aufgabe für Schulleitungen und Manager / innen im Unterrichts- und Pflegealltag
Begriffe wie Wissen, Wissensgenerierung, Wissensma- nagement, Wissensgesellschaft und Wissensarten sind in aller Munde und werden tagtäglich benutzt. Alle glauben zu wissen, worüber sie sprechen. Jeder verwendet diese Begriffe und außerdem ist es üblich, derartige Begriffe im alltäglichen Leben zu benutzen. Sei es in Diskussionen, im Unterricht, im Hochschulbereich, in der Lehrerausbil- dung – es gehört einfach dazu, die Fülle der synonymen Begriffe der Wissensgesellschaft anzuwenden. Die Boule- vardpresse, aber auch die einschlägige Fachliteratur leis- ten ebenfalls ihren Beitrag.
Doch beim näheren Hinsehen stellt sich die Frage, was macht Wissen eigentlich aus!
Stellt es die erste Stufe von Information dar? Ist es durch Erfahrung entstanden? Kann darüber der Kompetenz- stand eines Menschen erfasst werden? Ist es die geheime Regel eines Unternehmens? Müssen zukünftige Lehrende über ein bestimmtes Repertoire an fachdidaktischem Wis- sen verfügen? Helfen Wissensstrukturen den Lehrenden, ihren Unterricht strukturierter und teilnehmerorientierter zu gestalten?
Fragen über Fragen. Wir haben versucht, in diesem Schwerpunktheft „Wissensorganisation“ all diesen Fragen nachzugehen, um Ihnen – als Leser und Leserinnen – ein wenig Klarheit zu verschaffen.
Wir haben vier Perspektiven ausgewählt, um sich den oben aufgeführten vielfältigen Fragen zu stellen.
Der Kollege Roth geht der spannenden Frage nach, wie hirngerechtes Lehren und Lernen eigentlich aussehen muss, damit Lernende einen Lernerfolg verbuchen kön- nen und damit einhergehend gleichzeitig ein Kompetenz- zuwachs zu verzeichnen ist.
Detlef Behrmann widmet sich der spannenden Frage, wie Wissen entwickelt werden kann und ob es möglich ist, Wissen zu managen. Die Wissensaneignung ist nicht nur für das lernende Subjekt von Bedeutung, sondern auch für eine „lernende Organisation“.
Im Kontext der Lehrerausbildung geht Frau Kuckeland der Frage nach, was das Professionswissen von jetzigen und zukünftigen Lehrenden kennzeichnet. Was genau speziell gehört zum fachdidaktischen Wissen von Lehren- den im Bereich von Gesundheit und Pflege.
Mein eigener Aufsatz mit dem Kollegen Roth wendet sich dem konkreten Unterricht zu. Hier geht es um die Aufbereitung von wissenschaftlichen Inhalten für den Pflege- und Gesundheitsunterricht. Die Fülle der vorhan- denen Wissensstrukturen wird theoretisch dargelegt und mit entsprechenden Beispielen verdeutlicht.
Wir hoffen, dass wir eine geeignete Auswahl getroffen ha- ben, um Sie bei der Aufbereitung, der Vermittlung und der Verteilung von Wissen zu unterstützen, sodass Sie als Multi- plikator der Wissensgenerierung tätig werden können.},
	number = {3},
	journaltitle = {{PADUA}: Fachzeitschrift für Pflegepädagogik, Patientenedukation und -bildung},
	author = {Bossle, Michael and Eberhardt, Doris and Rohde, Katrin S. and Schewior-Popp, Susanne and Schneider, Kordula and Zegelin, Angelika},
	date = {2017},
	keywords = {Promotion:Literaturanalyse, Charité:Promotion},
	file = {2017_wissensorganisation.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/RVTAYGLQ/2017_wissensorganisation.pdf:application/pdf},
}

@thesis{schuh_forschendes_nodate,
	title = {Forschendes Lernen in der Hochschullehre - Chancen und Hindernisse},
	abstract = {Since the Bologna reform inquiry-based learning is a widely discussed concept to better interlock higher education with research again so that education quality improves. Using expert interviews as a qualitative method, this thesis analyses factors with fostering or hindering effects on the implementation of inquirybased learning from the viewpoint of university instructors. This shall be done by the analysis of research literature as a basis for the identiﬁcation of appropriate factors, which are subsequently veriﬁed and complemented with the help of the interviews. The results acquired in this way are inputted into a conception of an online seminar, where the use of digital media is geared to the needs of inquiry-based learning.},
