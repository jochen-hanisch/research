	keywords = {Kompetenzentwicklung, Lehr- und Lerneffektivität, Bildungstheorien, Technologieintegration, Systemanpassung, Krisenreaktion im Bildungsbereich, Promotion:Argumentation, \#1:Zeitschriftenartikel:learning:management:system, Promotion:Literaturanalyse, Charité:Promotion},
	file = {Kalaitzoglou et al. - 2020 - Multilingual Global E-Learning Pediatric Endocrino.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/JFI3FNQE/Kalaitzoglou et al. - 2020 - Multilingual Global E-Learning Pediatric Endocrino.pdf:application/pdf},
