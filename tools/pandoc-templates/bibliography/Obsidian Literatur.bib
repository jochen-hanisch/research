	title = {{DIE} {BEDEUTUNG} {DER} {ORGANISATION} {SELBSTÄNDIGER} {AUSILDUNG} {MITHILFE} {DIGITALER} {TECHNOLOGIEN}},
	abstract = {In this article, we will discuss the organization of independent learning with the help of digital technologies, the purpose of independent learning, the tasks of the student and teacher in self-study. In addition, we will focus separately on the elements of organizing independent work of students in the credit module system, forms of independent work and other topics.},
	author = {Soliyevich, Xolmatov Shokirjon},
