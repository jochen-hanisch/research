@article{waldmann_abwerten_nodate,
	title = {Abwerten, Aussortieren, Separieren: Algorithmische Ungleichheit als neuartiges Gegenstandsfeld soziologischer, neomaterialistischer und medienbildungstheoretischer Positionen},
