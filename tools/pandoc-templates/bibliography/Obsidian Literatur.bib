@article{swertz_big_2020,
	title = {Big Data als datenbasierte Programmierung: Eine medienpädagogische Analyse künstlicher neuronaler Netzwerke},
	issn = {1424-3636, 1424-3636},
	url = {10.21240/mpaed/jb17/2020.04.27.X},
	doi = {10/gksnzk},
	shorttitle = {Big Data als datenbasierte Programmierung},
	abstract = {In medienpädagogischen Theorien wird oft auf Analysen medieninduzierter gesellschaftlicher Entwicklungen oder auf Analysen der Inhalte von Medien und ihre Struktur zurückgegriffen. Diese Perspektiven werden in der relationalen Medienpädagogik um die Analyse der Technologie von Medien ergänzt. Im Beitrag wird aus dieser Sicht eine Analyse der datenbasierten Programmierung als Technologie in der Absicht vorgenommen, die medienpädagogische Relevanz der Technologie zu untersuchen.},
	pages = {93--119},
