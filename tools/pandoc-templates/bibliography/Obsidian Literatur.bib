@article{heldt_inken_digitalisierung_2022,
	title = {Digitalisierung, Mediatisierung, Demokratie. Politische Medienbildung als Anliegen und Auftrag der Erwachsenenbildung},
	rights = {Creative Commons Namensnennung 4.0 International},
	url = {https://www.pedocs.de/frontdoor.php?source_opus=24479},
	doi = {10/gp5kbb},
	abstract = {The author's basic thesis is that the digital transformation is "political" in a much more encompassing sense than generally considered. For the political aspect of the digital transformation is not exhausted in politics-related intentions by people acting in the digital public sphere but is a fundamental component of the functional logic and conditions of digital spaces. The interests of a variety of actors pervade their configuration and infrastructure. This has far-reaching consequences for the content and goals of political media education, which have hardly found their way into educational practice. One main task is to make people aware of the mostly inaccessible techno-social structures that inevitably leave a mark on them and how they live together and lead to a critical questioning of these structures by (not) allocating opportunities and ordering knowledge and relevance. These mostly invisible mechanisms must enter into view so that people are able to take a good look at the power relations inherent to the digital transformation. Thus, educational subjects should be encouraged to organize digital change actively and democratically. ({DIPF}/Orig.)},
	author = {Heldt, Inken},
	urldate = {2022-05-14},
	date = {2022-05-05},
	langid = {german},
	note = {Publisher: Bundesministerium für Bildung, Wissenschaft und Forschung},
	keywords = {Kompetenz, Digitalisierung, Digitalization, Adult training, Erwachsenenbildung, Media pedagogics, Medienpädagogik, Algorithm, Algorithms, Algorithmus, Critical thinking, Information literacy, Information skills, Kritisches Denken, Mediatisierung, Mündigkeit, Partizipation, Politische Erwachsenenbildung, Bildung, Digitale Bildung, Bildungstheorien, Technologieintegration, Forschungsansätze, Datenschutz und {IT}-Sicherheit, Promotion:{FU}1, Promotion:Relevanz:5, Promotion:Kerngedanke, \#7:Zeitschriftenartikel:digital:Medien, Promotion:Literaturanalyse, Charité:Promotion},
	file = {Heldt, Inken - 2022 - Digitalisierung, Mediatisierung, Demokratie. Polit.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/LNI8QRBW/Heldt, Inken - 2022 - Digitalisierung, Mediatisierung, Demokratie. Polit.pdf:application/pdf},
}

@article{peissl_helmut_kritische_2022,
	title = {Kritische Medienkompetenz vor dem Hintergrund der Digitalisierung. Media and Information Literacy ({MIL}) und Critical Media Literacy ({CML}) im Vergleich},
	rights = {Creative Commons Namensnennung 4.0 International},
	url = {https://www.pedocs.de/frontdoor.php?source_opus=24474},
	doi = {10/gp5j99},
	abstract = {Competent and critical media practice is a societal challenge that is also facing adult (political) education. The article discusses two media literacy concepts that stress the political dimension of media use as social action and offer useful starting points for adult education: the {UNESCO} media and information literacy ({MIL}) concept and the critical media literacy ({CML}) concept developed by Douglas Kellner and Jeff Share. Both concepts rest upon the common assumption that media literacy cannot be reduced to a purely technical, functional perspective but that a holistic, intersectional and interdisciplinary orientation is required to meet multiple societal challenges in times of digital transformation. One of the authors conclusions is that it is necessary to provide adult educators with critical media literacy and to establish it as an interdisciplinary topic in adult education offerings. Since adult educators function as multipliers, they can contribute to the promotion of assessment, reflection and action competencies in all of society in the age of digital transformation and mediatization. ({DIPF}/Orig.)},
	author = {Peissl, Helmut and Sedlaczek, Andrea},
	urldate = {2022-05-14},
	date = {2022-05-05},
	langid = {german},
	note = {Publisher: Bundesministerium für Bildung, Wissenschaft und Forschung},
	keywords = {Kompetenz, Digitalisierung, Digitalization, Adult training, Erwachsenenbildung, Media pedagogics, Medienpädagogik, Critical thinking, Information literacy, Information skills, Kritisches Denken, Politische Erwachsenenbildung, Interdisciplinarity, Interdisziplinarität, Media competence, Media skills, {UNESCO}, Bildung, Lehr- und Lerneffektivität, Bildungstheorien, Promotion:{FU}4a, Promotion:Relevanz:5, Promotion:Argumentation, \#7:Zeitschriftenartikel:digital:Medien, Promotion:Literaturanalyse, Charité:Promotion},
	file = {Peissl, Helmut und Sedlaczek, Andrea - 2022 - Kritische Medienkompetenz vor dem Hintergrund der .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/UKJRNRZE/Peissl, Helmut und Sedlaczek, Andrea - 2022 - Kritische Medienkompetenz vor dem Hintergrund der .pdf:application/pdf},
}

@article{assinger_philipp_digitalisierung_2022,
	title = {Digitalisierung und betriebliche Bildung. Verflechtung sozio-technischer Prozesse als Referenz für erwachsenenpädagogisches Handeln},
	rights = {Creative Commons Namensnennung 4.0 International},
	url = {https://www.pedocs.de/frontdoor.php?source_opus=24468},
	doi = {10/gp5j98},
	abstract = {The use of digital technologies increases the relevance of company training even without postulating revolutionary consequences. In their functions as work tools, learning tools and universal tools, digital technologies require and enable in-company training. The topic of this article is how these functions appear in companies and what implications this has for in-company training. An outline of problems is followed by a theoretical framework and its exploratory application to data from wood processing companies. The goal is to make visible starting points for science and practice. The findings suggest that adult education should support company staff trainers in acquiring the ability to reflect on education and act in its interest. For science in particular, it is necessary to improve ones focus on the interconnection of technical and social processes. ({DIPF}/Orig.)},
	author = {Assinger, Philipp and Webersink, Philip},
	urldate = {2022-05-14},
	date = {2022-05-05},
	langid = {german},
	note = {Publisher: Bundesministerium für Bildung, Wissenschaft und Forschung},
	keywords = {Learning, Digitalisierung, Digitalization, Adult training, Erwachsenenbildung, Arbeitsorganisation, Arbeitsprozess, Austria, Betriebliche Bildungsarbeit, Educational Environment, Executive, Führungskraft, Holzwirtschaft, In-service training, Learning conditions, Learning environment, Lernumgebung, Österreich, Schulung, Vocational pedagogics, Work organization, Working process, Workshops, Bildung, Sozialwissenschaft, Berufliche Bildung, Lernsystemarchitektur, Lehr- und Lerneffektivität, Bildungstheorien, Technologieintegration, Promotion:{FU}6, Promotion:Argumentation, \#6:Zeitschriftenartikel:Bildung:Technologie, Promotion:Literaturanalyse, Charité:Promotion},
	file = {Assinger, Philipp und Webersink, Philip - 2022 - Digitalisierung und betriebliche Bildung. Verflech.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/9CV2LWSW/Assinger, Philipp und Webersink, Philip - 2022 - Digitalisierung und betriebliche Bildung. Verflech.pdf:application/pdf},
