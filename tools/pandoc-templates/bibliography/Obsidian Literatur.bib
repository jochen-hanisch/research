	urldate = {2024-03-11},
	date = {2023},
	langid = {german},
	note = {Publisher: [object Object]},
	keywords = {370, 540, digitale Selbstlernbücher, digitalisierungsbezogene Kompetenzen, selbststrukturiertes Lernen, Lehr- und Lerneffektivität, Technologieintegration, Kollaboratives Lernen, Promotion:{FH}, Promotion:{FU}3, Promotion:{FU}1, Promotion:Kerngedanke, \#9:Zeitschriftenartikel:digital:lernen, Promotion:Literaturanalyse, Charité:Promotion},
	file = {Cornelius und Bohrmann-Linde - 2023 - Mit einem interaktiven und digitalen Selbstlernbuc.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/88DYMSK6/Cornelius und Bohrmann-Linde - 2023 - Mit einem interaktiven und digitalen Selbstlernbuc.pdf:application/pdf},
