@article{turner_uber_2022,
	title = {Über physische Distanz und emotionale Nähe im Fernunterricht: Wie kann es Lehrer*innen gelingen, mit Schüler*innen in Kontakt zu bleiben?},
	volume = {22},
	issn = {2190-4790},
	url = {https://www.medienpaed-ludwigsburg.de/article/view/414},
	doi = {10/gp5vw5},
	shorttitle = {Über physische Distanz und emotionale Nähe im Fernunterricht},
	abstract = {Die {COVID}-19 Pandemie hat den Schulalltag schlagartig verändert und war für die meisten Schüler*innen und Lehrer*innen durch Fernunterricht geprägt. Aufgrund der fortgeschrittenen Digitalisierung im Alltag und der Implementierung der Digitalen Grundbildung in Österreich (vgl. {BMBWF} 2018) sollte ein rascher Wechsel zum online-basierten Unterricht erfolgen. Dennoch waren jene Zeiten durch Herausforderungen, Unsicherheiten sowie physische Distanz für Lehrer*innen und Schüler*innen gekennzeichnet. Eine förderliche Lehr-Lernbeziehung sowie ein emotional positiver Kontakt sind neben technischem Equipment und digitalen Kompetenzen wesentliche Prädiktoren für gelingendes Lernen im digitalisierten (Fern-)Unterricht. In diesem Beitrag wird der Frage nachgegangen, inwiefern es Lehrer*innen in Zeiten des online-basierten Fernunterrichts gelungen ist, mit den Schüler*innen in (emotionalen) Kontakt zu bleiben.},
	pages = {1--12},
	journaltitle = {Ludwigsburger Beiträge zur Medienpädagogik},
	shortjournal = {{LBzM}},
	author = {Turner, Agnes and Scherde, Tamina-Melanie},
	urldate = {2022-05-16},
	date = {2022-05-02},
	langid = {german},
	keywords = {Lehr- und Lerneffektivität, Krisenreaktion im Bildungsbereich, {FU}2a, Promotion:Kerngedanke, \#9:Zeitschriftenartikel:digital:lernen, Promotion:Literaturanalyse, Charité:Promotion},
