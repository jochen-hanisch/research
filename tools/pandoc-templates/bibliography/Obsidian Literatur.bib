@book{arnold_systemische_2010,
	location = {Baltmannsweiler},
	title = {Systemische Berufsbildung: Kompetenzentwicklung neu denken - mit einem Methoden {ABC}},
	volume = {4},
	isbn = {978-3-8340-0799-5},
	series = {systhemia - Systemische Pädagogik},
	abstract = {Das systemische Denken ist ein "frisches Denken" (Peter Senge). Es hilft, Vertrautes anders und neu zu sehen und ermöglicht deshalb auch vielfach Lösungen in Bereichen, in denen unser bisheriges Denken und Fühlen uns immer und immer wieder scheitern lässt. Das systemische Paradigma, welches in vielen Bereichen, in denen es um die erfolgreiche Gestaltung menschlicher Kooperation und Interaktion geht, zunehmend an Bedeutung gewinnt, basiert u.a. auf der Einsicht, dass jede erfolgreiche Veränderung letztlich eine Selbstveränderung ist. Denn nur, indem ich meine bevorzugte Weise, die Welt zu verstehen und zu interpretieren, wahrnehme und verändere, kann die Wirklichkeit sich mir anders - und mit ihren bislang übersehenen Potenzialen - zeigen. Dies ist die Kernaussage der systemischen Veränderungsund Gestaltungskonzepte.
In dem vorliegenden Buch werden die Potenziale dieses "frischen Denkens" für den Bereich der Berufsbildung aufgegriffen und am Beispiel konkreter Situationen betrieblicher Ausbildungspraxis diskutiert. Insofern ist diese Buch durch und durch praxisorientiert. Dies gilt auch und im Besonderen für die 24 Tools, mit deren Hilfe Ausbildungsverantwortliche sowie Führungskräfte des Bereiches Kompetenzentwicklung ihre Praxis neu erfinden und gestalten können. Die hierfür entwickelten Vorschläge wurden im engen Kontakt mit der betrieblichen und schulischen Ausbildungspraxis entwickelt und erprobt - mit durchschlagenden und oft bewegenden Erfahrungen. Indem wir uns neu erfinden, d.h. unseren vertrauten Blick auf die Dinge aufgeben und weiterentwickeln, können wir auch die {KornpetenzentWicklung} neu denken und gestalten! - so die Quintessenz des vorliegenden Buches.},
	publisher = {Schneider Verlag Hohengehren {GmbH}},
	author = {Arnold, Rolf},
	editorb = {Arnold, Rolf},
	editorbtype = {redactor},
	date = {2010},
	keywords = {Kompetenz, Training, Kommunikation, Systemtheorie, Multimedia, Vortrag 2023-06-17, Praxisanleitung, Bildung:Beruf, {FernUni}-Hagen:{MABM}:Master-Arbeit, Promotion:Literaturanalyse, Charité:Promotion},
}

