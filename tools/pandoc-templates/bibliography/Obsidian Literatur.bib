	keywords = {Bewertungsmethoden, Technologieintegration, Promotion:{FU}3, Promotion:Relevanz:5, Promotion:Kerngedanke, \#1:Zeitschriftenartikel:learning:management:system, Promotion:Literaturanalyse, Charité:Promotion},
