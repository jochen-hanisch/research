@incollection{frasson_estimation_2023,
	location = {Cham},
	title = {Estimation of Piloting Attention Level Based on the Correlation of Pupil Dilation and {EEG}},
	volume = {13891},
	isbn = {978-3-031-32882-4 978-3-031-32883-1},
	url = {https://link.springer.com/10.1007/978-3-031-32883-1_35},
	abstract = {An aircrew’s behaviour greatly affects aviation safety and efﬁciency, especially in emergency situations. Considering vision is the primary method by which pilots acquire information, the way in which they distribute their attention greatly inﬂuences the amount of information they acquire. The purpose of this study was to examine pilots’ attention levels during a simulated takeoff procedure. In our study, we collected time series data on 136 takeoffs from 13 pilots over nine hours. In this study, we aimed to identify if pupil dilation measured by eye tracking correlates with engagement measured by {EEG}, especially during critical periods such as engine failures. According to the results, pupil dilation is correlated with {EEG} activity, suggesting that changes in pupil size indicate changes in engagement. Based on these ﬁndings, pupil dilation and {EEG} can be used together to examine pilot behaviour more comprehensively, since both measures are valid measures of engagement and cognitive workload.},
	pages = {381--390},
	booktitle = {Augmented Intelligence and Intelligent Tutoring Systems},
	publisher = {Springer Nature Switzerland},
	author = {Ghaderi, Maryam and Ben Abdessalem, Hamdi and Antoine, Maxime and Frasson, Claude},
	editor = {Frasson, Claude and Mylonas, Phivos and Troussas, Christos},
	urldate = {2023-05-27},
	date = {2023},
	langid = {english},
