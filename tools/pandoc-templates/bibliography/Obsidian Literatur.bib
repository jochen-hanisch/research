	location = {Cham},
	title = {{PlaySAFe}: Results from a Virtual Reality Study Using Digital Game-Based Learning for {SAFe} Agile Software Development},
	volume = {1442},
	isbn = {978-3-030-85520-8 978-3-030-85521-5},
	url = {https://link.springer.com/10.1007/978-3-030-85521-5_47},
	shorttitle = {{PlaySAFe}},
	abstract = {A common strategy to train software practitioners in agile frameworks is to have employees undertake classroom-based training. However, due to its nature, participants are lectured for a scheduled time-line with little necessity to interact. In particular, classroom-based training often might not provide substantial trainee interaction, which could result in apathy. To tackle this issue, we conducted empirical research to investigate the role of digital game-based learning ({GBL}) in employees’ training on the Scaled Agile Framework ({SAFe}). To ﬁgure out whether gameplay was a preferable training method, {PlaySAFe} (i.e., a 3D game) was developed within the study’s scope and tested with nine active {SAFe} practitioners from an industrial setting. Restrictions imposed by the {COVID}-19 pandemic have forced many to seek alternative means of teaching and learning. In particular, the ﬁndings obtained from the tests illustrate that {PlaySAFe} can be eﬀectively used as a complementary tool that supports {SAFe} classroom-based training. This study has highlighted numerous beneﬁts of {GBL}, such as allowing newcomers a quick and eﬃcient means to learn and understand the practical groundwork of {SAFe} in advance of learning more theoretical concepts in conventional training.},
	pages = {695--707},
	booktitle = {Systems, Software and Services Process Improvement},
	publisher = {Springer International Publishing},
	author = {O’Farrell, Emer and Yilmaz, Murat and Gulec, Ulas and Clarke, Paul},
	editor = {Yilmaz, Murat and Clarke, Paul and Messnarz, Richard and Reiner, Michael},
	urldate = {2023-11-18},
	date = {2021},
	langid = {english},
	doi = {10.1007/978-3-030-85521-5_47},
	note = {Series Title: Communications in Computer and Information Science},
	keywords = {\#0:Buchteil:digital:learning, Promotion:Literaturanalyse, Charité:Promotion},
