	editor = {Hasselkuß, Marco and Heinemann, Anna and Endberg, Manuela and Gageik, Lisa},
	date = {2022-07-15},
	langid = {german},
	keywords = {Lernsystemarchitektur, Technologieintegration, Systemanpassung, Promotion:{FU}4b, Promotion:Relevanz:4, Promotion:Argumentation, \#0:Zeitschriftenartikel:digital:learning, Promotion:Literaturanalyse, Charité:Promotion},
