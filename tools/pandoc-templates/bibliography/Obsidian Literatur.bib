	pmcid = {PMC10879404},
	keywords = {Teaching, Learning, Curriculum, Humans, Students, Medical, Computer-Assisted Instruction, Lernsystemarchitektur, Lehr- und Lerneffektivität, Bildungstheorien, Technologieintegration, Forschungsansätze, Datenschutz und {IT}-Sicherheit, Educational Measurement, Medical students, Simulation training, Otorhinolaryngology, Problem-based learning, Promotion:Argumentation, \#5:Zeitschriftenartikel:e-learning, Promotion:Literaturanalyse, Charité:Promotion},
	file = {Engert et al. - 2024 - Repetitio est mater studiorum – Implementierung vo.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/Y9AI6APR/Engert et al. - 2024 - Repetitio est mater studiorum – Implementierung vo.pdf:application/pdf},
