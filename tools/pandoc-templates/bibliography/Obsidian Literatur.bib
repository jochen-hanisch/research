	keywords = {\#0:Buchteil:digital:learning, Promotion:Literaturanalyse, Charité:Promotion},
	file = {Link et al. - 2023 - Towards Defining Digital Writing Quality.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/4SUGCV6T/Link et al. - 2023 - Towards Defining Digital Writing Quality.pdf:application/pdf;Link et al. - 2023 - Towards Defining Digital Writing Quality.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/FLRRSHR3/Link et al. - 2023 - Towards Defining Digital Writing Quality.pdf:application/pdf},
