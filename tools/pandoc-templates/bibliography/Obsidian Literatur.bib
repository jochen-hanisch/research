@article{feigl_elisabeth_homo_2022,
	title = {Homo Hapticus ade? Ein Nachdenken über die Bedeutung von Haptik, Körperlichkeit und Wahrnehmung in Zeiten zunehmend digitalisierten Lernens und Lehrens},
	rights = {Creative Commons Namensnennung 4.0 International},
	url = {https://www.pedocs.de/frontdoor.php?source_opus=24484},
	doi = {10/gp5j97},
	shorttitle = {Homo Hapticus ade?},
	abstract = {Before the {COVID}-19 pandemic, teaching and learning were primarily analog. Educational offerings were designed as diverse combinations of knowledge transfer, physical activities and social cooperation. The learner's body and its sensory perceptions in a social setting played a central role. In the online space, however, there is a danger of "disembodiment" because of a loss of physical proximity and direct social contact. Furthermore, sensory impressions are often missing from the learning process. Haptics especially is easily lost during online learning because pressing buttons, clicking a mouse and swiping a screen do not replace the experience of feeling a (learning) object in one's hands. This article examines the role that physicality and sensory perception - especially haptics - play in the learning process. It concludes by reflecting on how to better reach people as physical beings in online education.  ({DIPF}/Orig.)},
	author = {Feigl, Elisabeth},
	urldate = {2022-05-14},
	date = {2022-05-05},
	langid = {german},
	note = {Publisher: Bundesministerium für Bildung, Wissenschaft und Forschung},
	keywords = {Learning process, Lernprozess, Virtual learning, Digitalisierung, Digitalization, Adult training, Erwachsenenbildung, Corporeality, Haptik, Körperlichkeit, Leib, On line, Online, Sinneseindruck, Wissensvermittlung, Bildung, Digitale Bildung, Lehr- und Lerneffektivität, Krisenreaktion im Bildungsbereich, Promotion:{FU}4a, Promotion:Argumentation, \#9:Zeitschriftenartikel:digital:lernen, Promotion:Literaturanalyse, Charité:Promotion},
	file = {Feigl, Elisabeth - 2022 - Homo Hapticus ade Ein Nachdenken über die Bedeutu.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/LKABBVCF/Feigl, Elisabeth - 2022 - Homo Hapticus ade Ein Nachdenken über die Bedeutu.pdf:application/pdf},
}

@article{susman_krista_psychologie_2022,
	title = {Die Psychologie des virtuellen Raums. Begegnungsförderung und horizontale Kommunikation},
	rights = {Creative Commons Namensnennung 4.0 International},
	url = {https://www.pedocs.de/frontdoor.php?source_opus=24470},
	doi = {10/gp5j95},
	abstract = {How do encounters, relationships and authentic contact succeed in video meetings? Taking this question as the point of departure, the author reflects on intrapersonal experience, the experience of relationships and psychological online phenomena based on observations, personal experience and conversations with colleagues, clients and participants in video meetings. She considers paradoxes and tensions of video meetings and derives starting points for their practical organization. Her plea is for an inclusive learning- and encounter-promoting online culture with as much horizontal communication as possible. Given that video platforms are not neutral but instead preset communicative structures through their technical functionalities and determine the possibilities for relationship building during the video conference, the author argues for an explicit and mindful organization of online communication. This requires more than tools, namely the continuous social negotiation of how digital spaces can be used to promote relationships. ({DIPF}/Orig.)},
	author = {Susman, Krista},
	urldate = {2022-05-14},
	date = {2022-05-05},
	langid = {german},
	note = {Publisher: Bundesministerium für Bildung, Wissenschaft und Forschung},
	keywords = {{COVID}-19, Pandemie, On line, Online, Gestaltung, Online-Kommunikation, Videokonferenz, Virtuelle Arbeitswelt, Bildung, Sozialwissenschaft, \#0:Zeitschriftenartikel:digital:learning, Promotion:Literaturanalyse, Charité:Promotion},
