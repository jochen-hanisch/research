	langid = {english},
	keywords = {Lernsystemarchitektur, Lehr- und Lerneffektivität, Technologieintegration, Datenschutz und {IT}-Sicherheit, Krisenreaktion im Bildungsbereich, Promotion:{FU}2a, Promotion:Relevanz:5, Promotion:Kerngedanke, \#0:Zeitschriftenartikel:digital:learning, Promotion:Literaturanalyse, Charité:Promotion},
