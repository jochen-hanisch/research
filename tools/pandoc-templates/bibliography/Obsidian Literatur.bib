	doi = {10.31244/9783830996675},
	keywords = {\#9:Buch:digital:lernen, Promotion:Literaturanalyse, Charité:Promotion},
	file = {Fischer et al. - 2024 - Potenziale erkennen – Talente entwickeln – Bildung.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/X2Y7MUGU/Fischer et al. - 2024 - Potenziale erkennen – Talente entwickeln – Bildung.pdf:application/pdf},
