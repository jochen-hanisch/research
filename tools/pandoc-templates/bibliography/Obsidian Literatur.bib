	keywords = {Training, Risk management, skills, Sociology, Surveys, Project management, Construction industry, construction project management competencies, domain-specific knowledge areas, Health and safety, personality characteristics, Productivity, Recruitment, Refining, universal knowledge areas, \#4:Konferenz-Paper:{MOOC}, Promotion:Literaturanalyse, Charité:Promotion},
