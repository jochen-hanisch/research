	note = {Series Title: Lecture Notes in Networks and Systems},
	keywords = {Bildung, Multimedia, \#5:Buchteil:e-learning, Promotion:Literaturanalyse, Charité:Promotion},
	file = {van der Merwe et al. - 2022 - A Conceptual Framework for the Development of Argu.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/JGFQLAEU/van der Merwe et al. - 2022 - A Conceptual Framework for the Development of Argu.pdf:application/pdf},
