	langid = {german},
	note = {Artwork Size: 42 Seiten Seiten
Publisher: Medienimpulse},
	keywords = {Lehr- und Lerneffektivität, Technologieintegration, Promotion:{FU}3, Promotion:Weiterführung, \#9:Zeitschriftenartikel:digital:lernen, Promotion:Literaturanalyse, Charité:Promotion},
