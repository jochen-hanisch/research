	langid = {english},
	doi = {10.1007/978-3-031-36033-6_9},
	keywords = {\#0:Buchteil:digital:learning, Promotion:Literaturanalyse, Charité:Promotion},
	file = {Hodgson et al. - 2023 - Social Annotation Promising Technologies and Prac.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/WQ39BFM3/Hodgson et al. - 2023 - Social Annotation Promising Technologies and Prac.pdf:application/pdf;Hodgson et al. - 2023 - Social Annotation Promising Technologies and Prac.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/DTGRZYRM/Hodgson et al. - 2023 - Social Annotation Promising Technologies and Prac.pdf:application/pdf},
