	urldate = {2023-11-29},
	date = {2023-10-11},
	langid = {english},
	keywords = {Usability, {MOOC}, Interviews, Lehr- und Lerneffektivität, Bewertungsmethoden, Technologieintegration, Promotion:{FU}2a, Promotion:Relevanz:5, Promotion:Kerngedanke, Computer aided instruction, Electronic learning, Anxiety disorders, Learning Analytics Dashboard, Self-regulated Learning, Supply chain management, Testing, \#4:Konferenz-Paper:{MOOC}, Promotion:Literaturanalyse, Charité:Promotion},
