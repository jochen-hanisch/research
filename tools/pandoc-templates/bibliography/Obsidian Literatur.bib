	langid = {german},
	keywords = {Lernsystemarchitektur, Lehr- und Lerneffektivität, Technologieintegration, Promotion:{FU}3, Promotion:Relevanz:4, Promotion:Kerngedanke, Promotion:todo, \#2:Zeitschriftenartikel:online:Lernplattform, Promotion:Literaturanalyse, Charité:Promotion},
	file = {Heiser et al. - 2021 - Seamless Learning in einem bildungswissenschaftlic.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/NPEK53S3/Heiser et al. - 2021 - Seamless Learning in einem bildungswissenschaftlic.pdf:application/pdf},
