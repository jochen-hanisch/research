	keywords = {{UTAUT}-Modell, Lehr- und Lerneffektivität, Technologieintegration, Kollaboratives Lernen, Promotion:{FU}4a, Promotion:Relevanz:3, Promotion:Argumentation, \#6:Zeitschriftenartikel:Bildung:Technologie, Promotion:Literaturanalyse, Charité:Promotion},
