	langid = {german},
	note = {Publisher: Bundesministerium für Bildung, Wissenschaft und Forschung},
	keywords = {Adult training, Erwachsenenbildung, Artificial intelligence, Erweiterung, Learning Analytics, Substitution, Bildung, Technologie, Digitale Bildung, Lehr- und Lerneffektivität, Bildungstheorien, Technologieintegration, Forschungsansätze, Promotion:{FU}3, Promotion:Relevanz:3, Promotion:Argumentation, \#6:Zeitschriftenartikel:Bildung:Technologie, Promotion:Literaturanalyse, Charité:Promotion},
	file = {Dreisiebner und Lipp - 2022 - Künstliche Intelligenz und ihr Potenzial in der Er.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/M8JSI8TV/Dreisiebner und Lipp - 2022 - Künstliche Intelligenz und ihr Potenzial in der Er.pdf:application/pdf},
