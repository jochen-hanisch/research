	file = {Setiawati - 1945 - Impact of E-Learning Quality on Student Satisfacti.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/9SMFVVUP/Setiawati - 1945 - Impact of E-Learning Quality on Student Satisfacti.pdf:application/pdf},
}

@book{vogelpohl_fortbildung_2023,
