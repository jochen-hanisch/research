	langid = {german},
	note = {{ZSCC}: 0000000},
	keywords = {Bildung, Multimedia, Lehr- und Lerneffektivität, Technologieintegration, Forschungsansätze, Kollaboratives Lernen, Systemanpassung, Promotion:{FU}3, Promotion:Argumentation, \#1:Zeitschriftenartikel:learning:management:system, Promotion:Literaturanalyse, Charité:Promotion},
