	keywords = {Lernsystemarchitektur, Lehr- und Lerneffektivität, Bildungstheorien, Technologieintegration, Forschungsansätze, Kollaboratives Lernen, Krisenreaktion im Bildungsbereich, Mixed-method study, {MOODLE}, Patient-centric e-module, Seminar, Student-led focus group discussion, Promotion:Kerngedanke, \#1:Zeitschriftenartikel:learning:management:system, Promotion:Literaturanalyse, Charité:Promotion},
