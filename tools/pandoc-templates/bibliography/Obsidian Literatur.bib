	editoratype = {collaborator},
	urldate = {2024-02-10},
	date = {2023},
	langid = {german},
	note = {Publisher: Pädagogische Hochschule Schwäbisch Gmünd : Schwäbisch Gmünd},
	keywords = {Education, Deutschland, Germany, Artificial intelligence, Interdisciplinarity, Interdisziplinarität, Educational Environment, Learning environment, Lernumgebung, On line, Modell, Gesellschaft, Society, Male student, Student, Handlung, Online courses, Beispiel, Baden-Württemberg, Kurzfilm, Erziehung, Schul- und Bildungswesen, Schwäbisch Gmünd, Schwaebisch Gmuend, Diaries, Künstliche Intelligenz, Online-Kurs, Tagebuch, Technologieintegration, Forschungsansätze, Datenschutz und {IT}-Sicherheit, Promotion:{FU}4b, Promotion:Relevanz:5, Promotion:Weiterführung, \#3:Zeitschriftenartikel:online:Lernumgebung, Promotion:Literaturanalyse, Charité:Promotion},
