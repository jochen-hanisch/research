	langid = {german},
	keywords = {Technologieintegration, Systemanpassung, Krisenreaktion im Bildungsbereich, Promotion:{FU}5, Promotion:Relevanz:5, Promotion:Kerngedanke, \#7:Zeitschriftenartikel:digital:Medien, Promotion:Literaturanalyse, Charité:Promotion},
