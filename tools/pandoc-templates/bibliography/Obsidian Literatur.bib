@incollection{frasson_attention_2023,
	location = {Cham},
	title = {Attention Assessment of Aircraft Pilots Using Eye Tracking},
	volume = {13891},
	isbn = {978-3-031-32882-4 978-3-031-32883-1},
	url = {https://link.springer.com/10.1007/978-3-031-32883-1_18},
	abstract = {Today, airplane transportation plays a signiﬁcant role in the widespread movement of people and in the commercial activity of nations. Modern air travel can make remarkable progress by enhancing cultural and social services, growing economic activities, enhancing regional employment levels, and expanding tourism. The aviation industry has developed advanced planes and provided pilots with numerous control systems and instruments. In order to operate a modern high-speed aircraft, pilots must exchange instructions and information with air trafﬁc controllers ({ATC}). In spite of many efforts and investigations in the ﬁeld of aviation, tragic air accidents still occur worldwide. During the ﬂight, pilots are subject to a variety of emotional, mental, and physical conditions, which affect their performance and attention. In this study, several pilots with diverse skills and experiences took part in different ﬂights with different scenarios. Based on eye-tracking features, and as well as the amount of visual attention they paid to each window and tool within the simulation of an A320 aircraft, the amount of their visual attention is calculated.},
