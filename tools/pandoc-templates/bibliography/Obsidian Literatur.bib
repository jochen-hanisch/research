	urldate = {2023-11-18},
	date = {2023},
	langid = {english},
	doi = {10.1007/978-3-031-34738-2_10},
	keywords = {Promotion:Literaturanalyse, Promotion:Eye-Tracking, Charité:Promotion},
	file = {Koch et al. - 2023 - Visualization Psychology for Eye Tracking Evaluati.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/L5Y37NNH/Koch et al. - 2023 - Visualization Psychology for Eye Tracking Evaluati.pdf:application/pdf},
}

@incollection{albers_szafir_visualization_2023-1,
	location = {Cham},
	title = {Visualization Onboarding Grounded in Educational Theories},
	isbn = {978-3-031-34737-5 978-3-031-34738-2},
	url = {https://link.springer.com/10.1007/978-3-031-34738-2_6},
	abstract = {The aim of visualization is to support people in dealing with large and complex information structures, to make these structures more comprehensible, facilitate exploration, and enable knowledge discovery. However, users often have problems reading and interpreting data from visualizations, in particular when they experience them for the ﬁrst time. A lack of visualization literacy, i.e., knowledge in terms of domain, data, visual encoding, interaction, and also analytical methods can be observed. To support users in learning how to use new digital technologies, the concept of onboarding has been successfully applied in other domains. However, it has not received much attention from the visualization community so far. This chapter aims to ﬁll this gap by deﬁning the concept and systematically laying out the design space of onboarding in the context of visualization as a descriptive design space. On this basis, we present a survey of approaches from the academic community as well as from commercial products, especially surveying educational theories that inform the onboarding strategies. Additionally, we derived design considerations based on previous publications and present some guidelines for the design of visualization onboarding concepts.},
	pages = {139--164},
	booktitle = {Visualization Psychology},
	publisher = {Springer International Publishing},
	author = {Stoiber, Christina and Wagner, Markus and Grassinger, Florian and Pohl, Margit and Stitz, Holger and Streit, Marc and Potzmann, Benjamin and Aigner, Wolfgang},
	editor = {Albers Szafir, Danielle and Borgo, Rita and Chen, Min and Edwards, Darren J. and Fisher, Brian and Padilla, Lace},
	urldate = {2023-11-18},
	date = {2023},
	langid = {english},
	doi = {10.1007/978-3-031-34738-2_6},
	keywords = {\#0:Buchteil:digital:learning, Promotion:Literaturanalyse, Charité:Promotion},
	file = {Stoiber et al. - 2023 - Visualization Onboarding Grounded in Educational T.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/B3RHEKPV/Stoiber et al. - 2023 - Visualization Onboarding Grounded in Educational T.pdf:application/pdf},
