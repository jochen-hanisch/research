	keywords = {Learning Analytics, Bildung, Clientseitiges Logging, Moodle, {xAPI}, Multimedia, Lernsystemarchitektur, Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Datenschutz und {IT}-Sicherheit, Promotion:{FU}3, Promotion:Relevanz:5, Promotion:Kerngedanke, \#1:Konferenz-Paper:learning:management:system, Promotion:Literaturanalyse, Charité:Promotion},
