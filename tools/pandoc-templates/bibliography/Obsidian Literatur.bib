	langid = {german},
	note = {{ZSCC}: {NoCitationData}[s0]},
	keywords = {Lehr- und Lerneffektivität, Bildungstheorien, Technologieintegration, Forschungsansätze, Promotion:{FU}3, Promotion:Argumentation, \#9:Zeitschriftenartikel:digital:lernen, Promotion:Literaturanalyse, Charité:Promotion},
	file = {Moser - 2021 - Überlegungen zum Lernen mit und über Medien im Zei.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/BKB77PXA/Moser - 2021 - Überlegungen zum Lernen mit und über Medien im Zei.pdf:application/pdf},
}

@article{altenrath_deutungshoheiten_2020,
	title = {Deutungshoheiten: Digitalisierung und Bildung in Programmatiken und Förderrichtlinien Deutschlands und der {EU}},
	issn = {1424-3636, 1424-3636},
	url = {10.21240/mpaed/jb17/2020.05.22.X},
	doi = {10/gksnz2},
	shorttitle = {Deutungshoheiten},
	abstract = {This article is concerned with the prerogative of interpretation in relation to digitisation and education in the programmes and funding guidelines of Germany and the {EU} that has been created by political discourse and power. It is based on the assumption that the research and science system have for some time been closely dependent on funding programmes, which (should) function at different political levels as so-called funding instruments of various educational sectors and of science itself. On empirical observation, this turning towards and simultaneous rejection of terms and concepts makes prerogative of interpretation visible - not only in connection with discourses on digitisation and education. The consequence is the (over-)emphasis on individual concepts and the restrained representation of others, which means qualification narrowness for media education, which must be shown on an empirical basis and against the background of present concepts.},
	pages = {565--594},
	journaltitle = {{MedienPädagogik}: Zeitschrift für Theorie und Praxis der Medienbildung},
	shortjournal = {{MedienPädagogik}},
	author = {Altenrath, Maike and Helbig, Christian and Hofhues, Sandra},
	urldate = {2021-06-20},
	date = {2020-08-14},
	langid = {german},
	note = {{ZSCC}: 0000007},
	keywords = {Bildungstheorien, Technologieintegration, Forschungsansätze, Promotion:{FU}4a, Promotion:Relevanz:4, Promotion:Argumentation, \#7:Zeitschriftenartikel:digital:Medien, Promotion:Literaturanalyse, Charité:Promotion},
	file = {Altenrath et al. - 2020 - Deutungshoheiten Digitalisierung und Bildung in P.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/TSZSSK5D/Altenrath et al. - 2020 - Deutungshoheiten Digitalisierung und Bildung in P.pdf:application/pdf},
}

@article{kunkel_lernen_2020,
	title = {Lernen mit und über digitale Medien im Sachunterricht: Entwicklung eines vielperspektivischen Konzepts zur Erschliessung digitaler Medien},
	issn = {1424-3636, 1424-3636},
	url = {10.21240/mpaed/jb17/2020.05.18.X},
	doi = {10/gksnzw},
	shorttitle = {Lernen mit und über digitale Medien im Sachunterricht},
	abstract = {Learning with and about {ICT} must be accessed to children on from primary education in order to allow them to establish a critical-constructive examination of {ICT} in an educational understanding. As it is the core task of primary social and science education to enable students to self-construct and self-explore their environment in a multiperspective manner, primary social and science education functions as an essential subject in primary school to address learning with and about {ICT} in accordance to media literacy. Originating from the students’ living environment, they must be given the possibility to open up {ICT}/digital media as a complex matter of primary social and science education. Therefore, concepts on learning with and about {ICT} in multiperspective social and science primary education must be developed and then be examined regarding the conditions that allow for a learning with and about {ICT} by reasonable deployment of digital techniques. In summer 2019, several university students in teacher education encountered this challenge. The presented article outlines the development stages and outcomes of such concepts that were designed during an educational seminar. It then offers an outlook towards possible further advancements.},
	pages = {455--476},
	journaltitle = {{MedienPädagogik}: Zeitschrift für Theorie und Praxis der Medienbildung},
	shortjournal = {{MedienPädagogik}},
	author = {Kunkel, Carmen and Peschel, Markus},
	urldate = {2021-06-20},
	date = {2020-08-13},
	langid = {german},
	note = {{ZSCC}: 0000002},
	keywords = {Lehr- und Lerneffektivität, Technologieintegration, Forschungsansätze, Promotion:{FU}3, Promotion:Argumentation, \#9:Zeitschriftenartikel:digital:lernen, Promotion:Literaturanalyse, Charité:Promotion},
	file = {Kunkel und Peschel - 2020 - Lernen mit und über digitale Medien im Sachunterri.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/R3UWVGV5/Kunkel und Peschel - 2020 - Lernen mit und über digitale Medien im Sachunterri.pdf:application/pdf},
}

@article{kiesler_medienkompetenzforderung_2020,
	title = {Medienkompetenzförderung im Lehramtsstudium der Goethe-Universität: Ein Projektbericht zur erfolgreichen Medienproduktion am Beispiel studentischer Erklärvideos},
	issn = {1424-3636, 1424-3636},
	url = {10.21240/mpaed/jb17/2020.05.19.X},
	doi = {10/gg84h4},
	shorttitle = {Medienkompetenzförderung im Lehramtsstudium der Goethe-Universität},
	abstract = {In today’s connected and digital world, teachers face numerous challenges regarding the use of media in class. Children’s and teenager’s media consumption comprises social networks, messenger services, and most of all videos, movies and series. Goethe University addresses current policy-driven educational and social demands for media literacy by integrating the use of media into teacher education, particularly into educational sciences classes. It is, therefore, the goal of the seminar «Media Didactics in School» to instruct teacher students how to create explanatory videos using the «learning by teaching» ({LdL}) approach. While students elaborate content in groups and become content experts, they gain experience in the video production process and develop further mediarelated skills. With the integration of feedback loops and reflective tasks, students are prepared for a conscious use of videos in their later professional practice. The course was evaluated continuously, and conclusively by means of an online questionnaire. The results reveal the ongoing demand for instruction and support during media production, but above all student’s interest and motivation regarding digital media. Teachers can benefit from practical experience. They should receive further training regarding the use of digital technologies during their studies, as well as in the second and third phase of teacher training.},
	pages = {477--506},
	journaltitle = {{MedienPädagogik}: Zeitschrift für Theorie und Praxis der Medienbildung},
	shortjournal = {{MedienPädagogik}},
	author = {Kiesler, Natalie},
	urldate = {2021-06-20},
	date = {2020-08-14},
	langid = {german},
	note = {{ZSCC}: 0000002},
	keywords = {Lehr- und Lerneffektivität, Bildungstheorien, Technologieintegration, Promotion:{FU}3, Promotion:Relevanz:5, Promotion:Kerngedanke, \#6:Zeitschriftenartikel:Bildung:Technologie, Promotion:Literaturanalyse, Charité:Promotion},
	file = {Kiesler - 2020 - Medienkompetenzförderung im Lehramtsstudium der Go.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/3QS3CSS5/Kiesler - 2020 - Medienkompetenzförderung im Lehramtsstudium der Go.pdf:application/pdf},
