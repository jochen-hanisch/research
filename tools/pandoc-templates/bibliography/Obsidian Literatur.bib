	keywords = {\#0:Buchteil:digital:learning, Promotion:Literaturanalyse, Charité:Promotion},
	file = {Bobbert et al. - 2022 - Perspectives from 50+ Years’ Practical Zero Trust .pdf:/Users/jochenhanisch-johannsen/Zotero/storage/ZGCEJZTA/Bobbert et al. - 2022 - Perspectives from 50+ Years’ Practical Zero Trust .pdf:application/pdf},
