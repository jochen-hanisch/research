@article{blank_online-lerncoaching_2021,
	title = {Online-Lerncoaching als Instrument der Lernbegleitung},
	volume = {8},
	doi = {10293.000/30000-12012},
	abstract = {Die Corona-Pandemie trifft besonders lernunterstützende Settings, wie das direkte Lerncoaching. Eine unmittelbare Coach-Coachee-Arbeit ist aktuell nur erschwert bis gar nicht möglich. Dabei bedarf es gerade in diesen schwierigen Zeiten einer lernbegleitenden Unterstützung, da Lernende durch Homeschooling und digitale Lernformen oft auf sich allein gestellt sind.
Es geht es um die zentrale Fragestellung, inwieweit der bestehende Lerncoachingprozess für ein Onlineverfahren angepasst und als Lernbegleitungsinstrument weiterhin genutzt werden kann. Lernende bewältigen ihren Lernprozess während der Corona-Pandemie selbstständig und fühlen sich häufig nicht in der Lage, die Fülle des Lernstoffs eigenverantwortlich lern- bar zu machen. Während der aktuellen Coronalage ist das persönliche Gespräch leider schwer möglich, doch um den Ler- nenden trotzdem in seinem Lernprozess zu flankieren, wird im Verlauf des Artikels ein mögliches digitales Vorgehen be- schrieben. Der Lerncoachingsprozess nach Hardeland bildet hier die Basis und wird mit eigenen Gedanken und Ideen auf ein Onlineformat übertragen.},
	pages = {76--80},
	number = {1},
	journaltitle = {Pädagogik der Gesundheitsberufe},
	author = {Blank, Andreas},
	date = {2021-02-11},
	langid = {german},
	keywords = {Lehr- und Lerneffektivität, Technologieintegration, Kollaboratives Lernen, Systemanpassung, Krisenreaktion im Bildungsbereich, Promotion:{FU}1, Promotion:Argumentation, \#9:Zeitschriftenartikel:digital:lernen, Promotion:Literaturanalyse, Charité:Promotion},
	file = {Blank - Online-Lerncoaching als Instrument der Lernbegleit.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/K6PYBXN2/Blank - Online-Lerncoaching als Instrument der Lernbegleit.pdf:application/pdf},
}

