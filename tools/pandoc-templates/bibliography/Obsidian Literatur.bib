@article{awaghade_scope_2024,
	title = {Scope of distance legal education in digital age-futuristic approach in india},
	volume = {12},
	abstract = {Legal education is one of the most dynamic fields as it deals with diverse interest groups and provides various undergraduate, graduate, postgraduate, and doctoral programs and multiple courses. The objectives of the article are to identify the scope of distance education through the digital mode of communication and problems of digitalisation of legal education, as well as formulate directions for introducing a distance legal education framework. Further, the present article will analyse the scope of distance learning in professional and non-professional legal education. The present article will discuss issues in the adoption of distance legal education approach by law schools in India in the context of the post-{COVID} pandemic.},
