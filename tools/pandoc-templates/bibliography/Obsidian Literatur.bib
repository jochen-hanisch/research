	langid = {english},
	keywords = {Lehr- und Lerneffektivität, Technologieintegration, Kollaboratives Lernen, Promotion:Argumentation, \#5:Zeitschriftenartikel:e-learning, Promotion:Literaturanalyse, Charité:Promotion},
