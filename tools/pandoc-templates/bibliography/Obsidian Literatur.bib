@book{krawinkel_hybrides_2021,
	location = {Dornstadt},
	edition = {1. Aufl.},
	title = {Hybrides Lernen mit Moodle: Ein Leitfaden für den zeitgemäßen Unterricht},
	isbn = {978-3-96784-011-7},
	url = {https://lehrerfortbildung-bw.de/st_digital/elearning/methodensammlung/01-hybrides-lernen-mit-moodle-v08.pdf},
	shorttitle = {Hybrides Lernen mit Moodle},
	abstract = {Das Buch "Hybrides Lernen mit Moodle: Ein Leitfaden für den Unterricht" von Tanja Kräwinkel, veröffentlicht im Februar 2021 bei Visual Ink Publishing, bietet Lehrkräften praktische Anleitungen und Ideen, wie sie Moodle™ für hybrides und selbstgesteuertes Lernen effektiv nutzen können. Die Autorin, selbst Lehrerin und Moderatorin für Moodle™, teilt ihre umfangreichen Erfahrungen und möchte Lehrkräften Mut machen, die vielfältigen Möglichkeiten von Moodle™ im Unterricht einzusetzen. Das Buch ist mit {CC}-{BY}-{SA} 4.0 lizenziert und legt einen starken Fokus auf praktische Anwendbarkeit ohne theoretische Abhandlungen über Lernmethoden. Es bietet eine strukturierte Anleitung für die Erstellung und Organisation von Moodle™-Kursen, Kommunikationstools, die Steuerung des Lernprozesses sowie die Reflexion des Lernfortschritts. Zusätzlich enthält das Buch {QR}-Codes zu Videotutorials und zahlreiche Beispiele für die Kursgestaltung und Aktivitäten in Moodle™.

Zusammenfassend adressiert Kräwinkels Leitfaden folgende Kernpunkte:

Einleitung und Motivation: Die Autorin erläutert ihre persönlichen Beweggründe für das Schreiben des Buches und betont die Relevanz von Moodle™ für den Fernunterricht während der Corona-Pandemie.
Vorbereitungen für hybrides Lernen: Hier werden Lehrkräfte auf die Nutzung von Moodle™ und anderen digitalen Tools vorbereitet. Dies schließt die Einarbeitung in Tools, die methodische Hinführung der Schüler*innen und die technische Ausstattung ein.
Hybride Lernszenarien: Verschiedene Modelle des hybriden Lernens werden vorgestellt, mit einem Schwerpunkt auf selbstgesteuertem Lernen.
Selbstgesteuertes Lernen mit Moodle™: Detaillierte Anleitungen zur Kursstruktur, Kommunikation, Lernprozesssteuerung und -begleitung, individuell freigeschalteten Inhalten, Lernpfaden und der Reflexion des Lernprozesses.
Präsenz- und Distanzphasen: Strategien zur Kombination von Präsenz- und Distanzunterricht, einschließlich der Gestaltung von Lernprozessen und der Nutzung von Moodle™ zur Unterstützung des Lernens.
Kompetenzen für das 21. Jahrhundert: Diskussion über die Bedeutung von Schlüsselkompetenzen wie Kreativität, Kritisches Denken, Kommunikation und Kollaboration im Kontext von hybriden Lernumgebungen.
Praktische Unterrichtsbeispiele: Vorschläge zur Umsetzung des Gelernten in konkrete Unterrichtsszenarien, einschließlich der Nutzung von Moodle™ für verschiedene Lehr- und Lernaktivitäten.

Kräwinkel legt einen starken Fokus auf die praktische Umsetzung von hybriden Lernkonzepten und bietet Lehrkräften zahlreiche Werkzeuge, Strategien und Inspirationen, um ihren Unterricht innovativ und effektiv zu gestalten.},
	pagetotal = {128},
