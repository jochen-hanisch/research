	urldate = {2023-06-26},
	date = {2023},
	langid = {english},
	doi = {10.1007/978-3-658-40705-6_5},
	note = {Series Title: Europäische Kulturen in der Wirtschaftskommunikation},
	keywords = {\#7:Buchteil:digital:Medien, Promotion:Literaturanalyse, Charité:Promotion},
	file = {Hallin und Ivory - 2023 - Social Issues or the Social as an Issue—Rethinking.pdf:/Users/jochenhanisch-johannsen/Zotero/storage/ZWD85WSX/Hallin und Ivory - 2023 - Social Issues or the Social as an Issue—Rethinking.pdf:application/pdf},
