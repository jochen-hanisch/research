@article{ngenzi_information_2021,
	title = {Information and communication technology to enhance continuing professional development ({CPD}) and continuing medical education ({CME}) for Rwanda: a scoping review of reviews},
	volume = {21},
	issn = {1472-6920},
	url = {https://bmcmededuc.biomedcentral.com/articles/10.1186/s12909-021-02607-w},
	doi = {10/gs5685},
	shorttitle = {Information and communication technology to enhance continuing professional development ({CPD}) and continuing medical education ({CME}) for Rwanda},
	abstract = {Background: Access to high quality continuing professional development ({CPD}) is necessary for healthcare professionals to retain competency within the ever-evolving worlds of medicine and health. Most low- and middleincome countries, including Rwanda, have a critical shortage of healthcare professionals and limited access to {CPD} opportunities. This study scoped the literature using review articles related to the use of information and communication technology ({ICT}) and video conferencing for the delivery of {CPD} to healthcare professionals. The goal was to inform decision-makers of relevant and suitable approaches for a low-income country such as Rwanda.
Methods: {PubMed} and hand searching was used. Only review articles written in English, published between 2010 and 2019, and reporting the use of {ICT} for {CPD} were included.
Results: Six review articles were included in this study. Various delivery modes (face to face, pure elearning and blended learning) and technology approaches (Internet-based and non-Internet based) were reported. All types of technology approach enhanced knowledge, skills and attitudes. Pure elearning is comparable to face-to-face delivery and better than ‘no intervention’, and blended learning showed mixed results compared to traditional faceto-face learning. Participant satisfaction was attributed to ease of use, easy access and interactive content.
Conclusion: The use of technology to enhance {CPD} delivery is acceptable with most technology approaches improving knowledge, skills and attitude. For the intervention to work effectively, {CPD} courses must be well designed: needs-based, based on sound educational theories, interactive, easy to access, and affordable. Participants must possess the required devices and technological literacy.},
	pages = {245},
	number = {1},
	journaltitle = {{BMC} Medical Education},
	shortjournal = {{BMC} Med Educ},
	author = {Ngenzi, Joseph Lune and Scott, Richard E. and Mars, Maurice},
	urldate = {2023-11-18},
	date = {2021-12},
	langid = {english},
	keywords = {Lehr- und Lerneffektivität, Technologieintegration, Systemanpassung, Promotion:{FU}3, Promotion:Relevanz:5, Promotion:Argumentation, \#8:Zeitschriftenartikel:blended:learning, Promotion:Literaturanalyse, Charité:Promotion},
