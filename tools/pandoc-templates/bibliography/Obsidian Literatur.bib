	keywords = {Lehrerausbildung, Teacher training, Kompetenz, Lehrerbildung, Teachers' training, Competence for action, Competence to act, Specialized didactics, Subject didactics, Methode, Bildung, Digitale Bildung, notsanumfrage, Multimedia, Learning method, Learning techniques, Lehramtsstudent, Occupational practice, Student teachers, {DRK}-Bildungszentrum Düsseldorf, Berufliche Bildung, Lehr- und Lerneffektivität, Bewertungsmethoden, Systemanpassung, E-Portfolio, Promotion:{FU}4b, Promotion:Relevanz:4, Promotion:Argumentation, \#0:Zeitschriftenartikel:digital:learning, Promotion:Literaturanalyse, Charité:Promotion},
