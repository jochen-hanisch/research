	keywords = {Lehr- und Lerneffektivität, Technologieintegration, Forschungsansätze, Systemanpassung, Promotion:{FU}3, Promotion:Argumentation, \#5:Zeitschriftenartikel:e-learning, Promotion:Literaturanalyse, Charité:Promotion},
